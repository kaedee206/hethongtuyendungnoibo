# ==============================================================================
# BIẾN MÔI TRƯỜNG TRIỂN KHAI NOVERATECH ATS & AUTHELIA SSO (VPS / DOCKER COMPOSE)
# ==============================================================================
# Hướng dẫn tạo secret an toàn (tối thiểu 32 ký tự / 32 bytes cryptographically secure):
#   openssl rand -hex 32
#   openssl rand -base64 32
# ==============================================================================

# 1. Cơ sở dữ liệu PostgreSQL
POSTGRES_DB=ats_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_super_secure_postgres_password_2026

# 2. Cấu hình bảo mật Authelia SSO (BẮT BUỘC >= 32 ký tự, KHÔNG để trống)
# Secret ký và mã hóa phiên làm việc (Session Cookie)
AUTHELIA_SESSION_SECRET=novera_authelia_session_secret_32_characters_long_2026!

# Secret mã hóa JWT định danh danh tính
AUTHELIA_JWT_SECRET=novera_jwt_secret_token_super_random_32_characters!

# Khóa mã hóa cơ sở dữ liệu lưu trữ Authelia (AES-GCM-256)
AUTHELIA_STORAGE_ENCRYPTION_KEY=novera_storage_key_random_32_characters_long_2026!

# HMAC Secret cho OIDC Provider
AUTHELIA_IDENTITY_PROVIDERS_OIDC_HMAC_SECRET=novera_hmac_secret_key_change_me_32chars_long!

# 3. Kết nối OIDC Client giữa Ats.Web và Authelia SSO
OIDC_AUTHORITY=https://sso.noveratech.digital
OIDC_CLIENT_ID=ats_portal
OIDC_CLIENT_SECRET=novera_ats_secret_2026
INTERNAL_EMAIL_DOMAIN=@noveratech.digital

# 4. Cấu hình Email gửi thông báo (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=hiring.noveratech@gmail.com
SMTP_PASSWORD=your_gmail_app_password
