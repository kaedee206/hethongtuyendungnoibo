# CSDL PostgreSQL nội bộ trong Docker (Môi trường Test / Dev riêng biệt, cô lập)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ats_db_dev
DB_USER=postgres
DB_PASSWORD=postgres_dev_pass

# Cổng truy cập trực tiếp ứng dụng khi debug (tránh trùng port 8080 trên Windows)
APP_PORT=8085

# (Tuỳ chọn) Kết nối CSDL bên ngoài khi cần:
# DB_HOST=db.your-dev-project.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your_dev_supabase_password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=hiring.yourcompany@gmail.com
SMTP_PASSWORD=your_gmail_app_password

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

SESSION_IDLE_TIMEOUT_MINUTES=30
