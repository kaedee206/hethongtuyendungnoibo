@model Ats.Web.Models.ViewModels.Users.UserCreateViewModel
@{
    ViewData["Title"] = "Thêm tài khoản mới";
}

<div class="container py-4" style="max-width: 750px;">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Quản trị người dùng</a></li>
            <li class="breadcrumb-item active" aria-current="page">Tạo tài khoản mới</li>
        </ol>
    </nav>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex align-items-center">
                <div class="bg-primary-subtle text-primary p-2 rounded-circle me-3">
                    <i class="bi bi-person-plus-fill fs-5"></i>
                </div>
                <div>
                    <h5 class="card-title mb-0 fw-bold text-dark">Thêm tài khoản nhân sự nội bộ</h5>
                    <small class="text-muted">Cấp quyền truy cập hệ thống tuyển dụng cho nhân viên NoveraTech</small>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <form asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" placeholder="Ví dụ: Nguyễn Văn A" autofocus />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="ten.nguoi@noveratech.digital" />
                        <div class="form-text small text-muted">Bắt buộc sử dụng đuôi <strong>@@noveratech.digital</strong>.</div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Department" class="form-label fw-semibold"></label>
                    <input asp-for="Department" class="form-control" placeholder="Ví dụ: Phòng Kỹ thuật & Công nghệ, Phòng Nhân sự..." />
                    <span asp-validation-for="Department" class="text-danger small"></span>
                </div>

                <!-- Phân quyền đa vai trò (S1-09) -->
                <div class="mb-4">
                    <label class="form-label fw-semibold d-block mb-1">
                        Vai trò trong hệ thống <span class="text-danger">*</span>
                    </label>
                    <p class="text-muted small mb-3">Một người dùng có thể đảm nhận nhiều vai trò cùng lúc (ví dụ vừa là Quản lý tuyển dụng, vừa là Người phỏng vấn).</p>

                    <div class="row g-2">
                        @for (int i = 0; i < Model.AvailableRoles.Count; i++)
                        {
                            <div class="col-12 col-md-6">
                                <div class="card h-100 border rounded-3 p-3">
                                    <div class="form-check">
                                        <input type="hidden" asp-for="AvailableRoles[i].RoleId" />
                                        <input type="hidden" asp-for="AvailableRoles[i].RoleName" />
                                        <input type="hidden" asp-for="AvailableRoles[i].DisplayName" />
                                        <input class="form-check-input" type="checkbox" asp-for="AvailableRoles[i].IsSelected" id="role_@i" />
                                        <label class="form-check-label w-100 cursor-pointer" for="role_@i">
                                            <span class="fw-bold text-dark d-block">@Model.AvailableRoles[i].DisplayName</span>
                                            <span class="badge bg-light text-secondary border font-monospace mt-1">@Model.AvailableRoles[i].RoleName</span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="alert alert-info border-0 bg-info-subtle text-info-emphasis rounded-3 p-3 mb-4">
                    <div class="d-flex align-items-start">
                        <i class="bi bi-info-circle-fill me-2 fs-5 mt-1"></i>
                        <div class="small">
                            <strong>Chính sách khởi tạo mật khẩu:</strong>
                            Hệ thống sẽ tự động tạo một mật khẩu tạm thời phức tạp, kích hoạt trạng thái tài khoản và gửi email thông báo kèm liên kết truy cập tới nhân viên. Nhân viên sẽ được yêu cầu đổi mật khẩu ở lần đăng nhập tiếp theo.
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light px-4">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        <i class="bi bi-check2-circle me-1"></i> Hoàn tất tạo tài khoản
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
