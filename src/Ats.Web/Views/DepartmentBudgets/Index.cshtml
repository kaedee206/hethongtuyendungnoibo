@model Ats.Web.Models.ViewModels.DepartmentBudgets.DepartmentBudgetListViewModel
@{
    ViewData["Title"] = "Quản lý Ngân sách Headcount theo Phòng ban";
    var currentYear = DateTime.UtcNow.Year;
}

<div class="container-fluid px-3 px-md-4 py-4">
    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0" style="font-size: 0.85rem;">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
            <li class="breadcrumb-item"><span class="text-muted">Cơ cấu &amp; Tiêu chuẩn</span></li>
            <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">Ngân sách Headcount</li>
        </ol>
    </nav>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm mb-4" role="alert" style="border-radius: 10px;">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm mb-4" role="alert" style="border-radius: 10px;">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Top Action Bar -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 fw-bold" style="font-size: 0.75rem;">
                    <i class="bi bi-wallet2 me-1"></i>SCRUM-24
                </span>
                <h1 class="h3 fw-bold text-dark mb-0">Quản lý Ngân sách Headcount theo Phòng Ban</h1>
            </div>
            <p class="text-muted small mb-0">
                Khai báo định biên nhân sự và ngân sách lương theo năm, kiểm soát chặt chẽ để không phê duyệt vượt chỉ tiêu được duyệt đầu năm.
            </p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <!-- Year Selector Form -->
            <form method="get" action="/ngan-sach-headcount" class="d-flex align-items-center gap-2">
                <label for="yearFilterSelect" class="text-secondary small fw-semibold text-nowrap mb-0">Năm tài chính:</label>
                <select name="year" id="yearFilterSelect" class="form-select form-select-sm shadow-sm" style="border-radius: 8px; width: 110px;" onchange="this.form.submit()">
                    @for (int y = currentYear - 1; y <= currentYear + 2; y++)
                    {
                        if (y == Model.SelectedYear)
                        {
                            <option value="@y" selected="selected">@y</option>
                        }
                        else
                        {
                            <option value="@y">@y</option>
                        }
                    }
                </select>
            </form>

            <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-2 shadow-sm" id="btnOpenCreateBudgetModal" style="border-radius: 8px;">
                <i class="bi bi-plus-circle-fill"></i>
                <span class="fw-semibold">Khai báo chỉ tiêu</span>
            </button>
        </div>
    </div>

    <!-- 4 KPI Summary Cards -->
    <div class="row g-3 mb-4">
        <!-- Tổng chỉ tiêu định biên -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; background: #FFFFFF; border-left: 4px solid #3B82F6 !important;">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.05em;">Tổng chỉ tiêu năm @Model.SelectedYear</span>
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; background: rgba(59, 130, 246, 0.1); color: #3B82F6;">
                            <i class="bi bi-people-fill"></i>
                        </div>
                    </div>
                    <div class="h3 fw-bold text-dark mb-0">@Model.TotalTargetHeadcount <span class="fs-6 fw-normal text-muted">người</span></div>
                    <div class="text-muted small mt-1">Định biên đã phê duyệt</div>
                </div>
            </div>
        </div>

        <!-- Đã sử dụng -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; background: #FFFFFF; border-left: 4px solid #F59E0B !important;">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.05em;">Đã sử dụng</span>
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; background: rgba(245, 158, 11, 0.1); color: #F59E0B;">
                            <i class="bi bi-person-check-fill"></i>
                        </div>
                    </div>
                    <div class="h3 fw-bold text-dark mb-0">@Model.TotalUsedHeadcount <span class="fs-6 fw-normal text-muted">người</span></div>
                    <div class="text-muted small mt-1">Nhân sự thực tế + Đang tuyển</div>
                </div>
            </div>
        </div>

        <!-- Còn lại khả dụng -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; background: #FFFFFF; border-left: 4px solid @(Model.TotalRemainingHeadcount > 0 ? "#10B981" : "#EF4444") !important;">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.05em;">Còn lại khả dụng</span>
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; background: @(Model.TotalRemainingHeadcount > 0 ? "rgba(16, 185, 129, 0.1)" : "rgba(239, 68, 68, 0.1)"); color: @(Model.TotalRemainingHeadcount > 0 ? "#10B981" : "#EF4444");">
                            <i class="bi bi-person-plus-fill"></i>
                        </div>
                    </div>
                    <div class="h3 fw-bold @(Model.TotalRemainingHeadcount > 0 ? "text-success" : "text-danger") mb-0">
                        @Model.TotalRemainingHeadcount <span class="fs-6 fw-normal text-muted">người</span>
                    </div>
                    <div class="text-muted small mt-1">Chỉ tiêu có thể mở thêm</div>
                </div>
            </div>
        </div>

        <!-- Tổng ngân sách lương -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; background: #FFFFFF; border-left: 4px solid #8B5CF6 !important;">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.05em;">Tổng ngân sách lương</span>
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; background: rgba(139, 92, 246, 0.1); color: #8B5CF6;">
                            <i class="bi bi-cash-stack"></i>
                        </div>
                    </div>
                    <div class="h4 fw-bold text-dark mb-0">
                        @(Model.TotalSalaryBudget >= 1_000_000_000 ? (Model.TotalSalaryBudget / 1_000_000_000m).ToString("N2") + " tỷ" : Model.TotalSalaryBudget.ToString("N0")) 
                        <span class="fs-6 fw-normal text-muted">VND</span>
                    </div>
                    <div class="text-muted small mt-1">Quỹ lương phê duyệt năm @Model.SelectedYear</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Table Card -->
    <div class="card border-0 shadow-sm" style="border-radius: 12px; background: #FFFFFF; border: 1px solid #E2E8F0; overflow: hidden;">
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold mb-0 text-dark">Bảng chỉ tiêu và tiến độ định biên theo phòng ban</h5>
                <span class="text-muted small">Dữ liệu ngân sách năm tài chính <strong>@Model.SelectedYear</strong></span>
            </div>
            <span class="badge bg-light text-dark border px-3 py-2">
                Tổng cộng: <strong>@Model.Items.Count</strong> phòng ban
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="budgetTable">
                <thead style="background: #F8FAFC; border-bottom: 1px solid #E2E8F0;">
                    <tr>
                        <th class="ps-4 py-3 text-secondary text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">Phòng ban</th>
                        <th class="py-3 text-secondary text-uppercase text-center" style="font-size: 0.75rem; letter-spacing: 0.05em;">Chỉ tiêu (Định biên)</th>
                        <th class="py-3 text-secondary text-uppercase text-center" style="font-size: 0.75rem; letter-spacing: 0.05em;">Đã dùng</th>
                        <th class="py-3 text-secondary text-uppercase text-center" style="font-size: 0.75rem; letter-spacing: 0.05em;">Còn lại</th>
                        <th class="py-3 text-secondary text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em; min-width: 170px;">Tiến độ sử dụng</th>
                        <th class="py-3 text-secondary text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">Ngân sách lương</th>
                        <th class="py-3 text-secondary text-uppercase text-center" style="font-size: 0.75rem; letter-spacing: 0.05em;">Trạng thái</th>
                        <th class="pe-4 py-3 text-secondary text-uppercase text-end" style="font-size: 0.75rem; letter-spacing: 0.05em;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                Chưa có phòng ban nào trong hệ thống.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            var usagePercent = item.UsagePercentage;
                            var progressBarColor = usagePercent > 100 ? "bg-danger" :
                                                   usagePercent >= 80 ? "bg-warning" : "bg-success";

                            <tr>
                                <!-- Phòng ban -->
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-3 d-flex align-items-center justify-content-center text-primary fw-bold" style="width: 36px; height: 36px; background: rgba(59, 130, 246, 0.1); font-size: 0.8rem;">
                                            @item.DepartmentCode
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@item.DepartmentName</div>
                                            <div class="text-muted small">
                                                @(string.IsNullOrWhiteSpace(item.ManagerName) ? "Chưa có trưởng phòng" : $"Trưởng phòng: {item.ManagerName}")
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Chỉ tiêu -->
                                <td class="text-center py-3">
                                    @if (item.HasBudgetPlan)
                                    {
                                        <span class="fs-5 fw-bold text-dark">@item.TargetHeadcount</span>
                                        <span class="text-muted small d-block">người</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border">Chưa khai báo</span>
                                    }
                                </td>

                                <!-- Đã dùng -->
                                <td class="text-center py-3">
                                    <span class="fw-semibold text-dark">@item.UsedHeadcount</span>
                                    <div class="text-muted" style="font-size: 0.75rem;" title="Nhân sự hiện tại: @item.CurrentStaffCount | Yêu cầu đang tuyển: @item.InFlightRequisitionQuantity">
                                        (@item.CurrentStaffCount chính thức + @item.InFlightRequisitionQuantity đang tuyển)
                                    </div>
                                </td>

                                <!-- Còn lại -->
                                <td class="text-center py-3">
                                    @if (!item.HasBudgetPlan)
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                            <i class="bi bi-exclamation-circle me-1"></i>0 (Chưa cấp)
                                        </span>
                                    }
                                    else if (item.RemainingHeadcount <= 0)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 fw-bold fs-6">
                                            <i class="bi bi-x-circle-fill me-1"></i>@item.RemainingHeadcount
                                        </span>
                                        <span class="d-block text-danger small mt-1">Đã hết chỉ tiêu</span>
                                    }
                                    else if (item.RemainingHeadcount <= 2)
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1 fw-bold fs-6">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i>+@item.RemainingHeadcount
                                        </span>
                                        <span class="d-block text-warning small mt-1">Sắp hết chỉ tiêu</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fw-bold fs-6">
                                            <i class="bi bi-check-circle-fill me-1"></i>+@item.RemainingHeadcount
                                        </span>
                                        <span class="d-block text-success small mt-1">Khả dụng</span>
                                    }
                                </td>

                                <!-- Tiến độ sử dụng -->
                                <td class="py-3">
                                    @if (item.HasBudgetPlan && item.TargetHeadcount > 0)
                                    {
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="small text-muted">Tỉ lệ sử dụng</span>
                                            <span class="small fw-bold @(usagePercent > 100 ? "text-danger" : usagePercent >= 80 ? "text-warning" : "text-success")">
                                                @usagePercent.ToString("F1")%
                                            </span>
                                        </div>
                                        <div class="progress" style="height: 7px; border-radius: 4px; background-color: #E2E8F0;">
                                            <div class="progress-bar @progressBarColor" role="progressbar" 
                                                 style="width: @Math.Min(usagePercent, 100)%; border-radius: 4px;" 
                                                 aria-valuenow="@usagePercent" aria-valuemin="0" aria-valuemax="100">
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">--</span>
                                    }
                                </td>

                                <!-- Ngân sách lương -->
                                <td class="py-3">
                                    @if (item.HasBudgetPlan && item.SalaryBudget > 0)
                                    {
                                        <div class="fw-bold text-dark">@item.SalaryBudget.ToString("N0") <span class="small text-muted">@item.Currency</span></div>
                                        @if (item.SalaryBudget >= 1_000_000_000)
                                        {
                                            <div class="text-muted small">≈ @((item.SalaryBudget / 1_000_000_000m).ToString("N2")) tỷ VND</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Chưa thiết lập</span>
                                    }
                                </td>

                                <!-- Trạng thái -->
                                <td class="text-center py-3">
                                    @if (item.HasBudgetPlan)
                                    {
                                        if (item.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                <i class="bi bi-check2 me-1"></i>Đang áp dụng
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border">Tạm dừng</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">Chưa có chỉ tiêu</span>
                                    }
                                </td>

                                <!-- Thao tác -->
                                <td class="pe-4 py-3 text-end">
                                    <button type="button" 
                                            class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1 btn-edit-budget"
                                            data-dept-id="@item.DepartmentId"
                                            data-dept-name="@item.DepartmentName"
                                            data-dept-code="@item.DepartmentCode"
                                            data-year="@Model.SelectedYear"
                                            data-target="@item.TargetHeadcount"
                                            data-budget="@item.SalaryBudget"
                                            data-note="@item.Note"
                                            data-active="@item.IsActive.ToString().ToLower()"
                                            data-has-plan="@item.HasBudgetPlan.ToString().ToLower()"
                                            style="border-radius: 6px;">
                                        <i class="bi bi-pencil-square"></i>
                                        <span>@(item.HasBudgetPlan ? "Cập nhật" : "Khai báo")</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Khai báo / Cập nhật chỉ tiêu Headcount & Ngân sách -->
<div class="modal fade" id="budgetModal" tabindex="-1" aria-labelledby="budgetModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 12px; overflow: hidden;">
            <div class="modal-header bg-primary text-white py-3 px-4">
                <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="budgetModalLabel">
                    <i class="bi bi-wallet2"></i>
                    <span id="modalTitleText">Khai báo chỉ tiêu Headcount &amp; Ngân sách</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form id="budgetForm" method="post" action="/ngan-sach-headcount/save">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <!-- Phòng ban -->
                    <div class="mb-3">
                        <label for="modalDepartmentId" class="form-label fw-semibold text-dark">
                            Phòng ban <span class="text-danger">*</span>
                        </label>
                        <select class="form-select" id="modalDepartmentId" name="DepartmentId" required style="border-radius: 8px;">
                            <option value="">-- Chọn phòng ban --</option>
                            @foreach (var dept in Model.Items)
                            {
                                <option value="@dept.DepartmentId">@dept.DepartmentName (@dept.DepartmentCode)</option>
                            }
                        </select>
                    </div>

                    <!-- Năm tài chính -->
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label for="modalYear" class="form-label fw-semibold text-dark">
                                Năm tài chính <span class="text-danger">*</span>
                            </label>
                            <input type="number" class="form-control" id="modalYear" name="Year" value="@Model.SelectedYear" min="2020" max="2050" required style="border-radius: 8px;" />
                        </div>
                        <div class="col-6">
                            <label for="modalTargetHeadcount" class="form-label fw-semibold text-dark">
                                Chỉ tiêu Headcount <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input type="number" class="form-control" id="modalTargetHeadcount" name="TargetHeadcount" min="0" placeholder="VD: 25" required style="border-top-left-radius: 8px; border-bottom-left-radius: 8px;" />
                                <span class="input-group-text bg-light text-muted" style="border-top-right-radius: 8px; border-bottom-right-radius: 8px;">Người</span>
                            </div>
                        </div>
                    </div>

                    <!-- Ngân sách lương phê duyệt -->
                    <div class="mb-3">
                        <label for="modalSalaryBudgetDisplay" class="form-label fw-semibold text-dark">
                            Ngân sách lương phê duyệt (VND) <span class="text-danger">*</span>
                        </label>
                        <input type="text" class="form-control" id="modalSalaryBudgetDisplay" placeholder="VD: 5,000,000,000" required style="border-radius: 8px;" />
                        <input type="hidden" id="modalSalaryBudget" name="SalaryBudget" value="0" />
                        <div class="form-text text-muted" id="salaryBudgetWordsHelp">Nhập tổng quỹ lương dự kiến cho phòng ban trong năm tài chính.</div>
                    </div>

                    <!-- Ghi chú / Căn cứ phê duyệt -->
                    <div class="mb-3">
                        <label for="modalNote" class="form-label fw-semibold text-dark">
                            Căn cứ / Ghi chú phê duyệt
                        </label>
                        <textarea class="form-control" id="modalNote" name="Note" rows="3" placeholder="VD: Phê duyệt theo Quyết định số 05/QĐ-BOD ngày 15/01/2026 của Ban Giám Đốc." style="border-radius: 8px;"></textarea>
                    </div>

                    <!-- Checkbox áp dụng -->
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" role="switch" id="modalIsActive" name="IsActive" value="true" checked />
                        <label class="form-check-label fw-semibold text-dark" for="modalIsActive">Kích hoạt áp dụng định biên này</label>
                    </div>
                </div>

                <div class="modal-footer bg-light px-4 py-3">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal" style="border-radius: 8px;">Đóng</button>
                    <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2 px-4 shadow-sm" id="btnSubmitBudgetForm" style="border-radius: 8px;">
                        <i class="bi bi-save"></i>
                        <span>Lưu chỉ tiêu định biên</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const budgetModalElement = document.getElementById('budgetModal');
            if (!budgetModalElement) return;

            const budgetModal = new bootstrap.Modal(budgetModalElement);
            const modalTitleText = document.getElementById('modalTitleText');
            const modalDepartmentId = document.getElementById('modalDepartmentId');
            const modalYear = document.getElementById('modalYear');
            const modalTargetHeadcount = document.getElementById('modalTargetHeadcount');
            const modalSalaryBudgetDisplay = document.getElementById('modalSalaryBudgetDisplay');
            const modalSalaryBudget = document.getElementById('modalSalaryBudget');
            const modalNote = document.getElementById('modalNote');
            const modalIsActive = document.getElementById('modalIsActive');
            const salaryWordsHelp = document.getElementById('salaryBudgetWordsHelp');

            // Format number to currency display
            function formatVnd(val) {
                if (!val) return '0';
                const num = parseInt(val.toString().replace(/\D/g, ''), 10);
                if (isNaN(num)) return '0';
                return num.toLocaleString('vi-VN');
            }

            // Sync display to hidden numeric
            modalSalaryBudgetDisplay.addEventListener('input', function () {
                const rawVal = this.value.replace(/\D/g, '');
                const num = parseInt(rawVal, 10) || 0;
                modalSalaryBudget.value = num;
                this.value = num > 0 ? num.toLocaleString('vi-VN') : '';

                if (num >= 1000000000) {
                    const ty = (num / 1000000000).toFixed(2);
                    salaryWordsHelp.textContent = `Tương đương: ${ty} tỷ VND`;
                } else if (num >= 1000000) {
                    const tr = (num / 1000000).toFixed(1);
                    salaryWordsHelp.textContent = `Tương đương: ${tr} triệu VND`;
                } else {
                    salaryWordsHelp.textContent = 'Nhập tổng quỹ lương dự kiến cho phòng ban trong năm tài chính.';
                }
            });

            // Button Open Create Modal
            const btnCreate = document.getElementById('btnOpenCreateBudgetModal');
            if (btnCreate) {
                btnCreate.addEventListener('click', function () {
                    modalTitleText.textContent = 'Khai báo chỉ tiêu Headcount & Ngân sách';
                    modalDepartmentId.value = '';
                    modalDepartmentId.disabled = false;
                    modalYear.value = '@Model.SelectedYear';
                    modalTargetHeadcount.value = '';
                    modalSalaryBudgetDisplay.value = '';
                    modalSalaryBudget.value = '0';
                    modalNote.value = '';
                    modalIsActive.checked = true;
                    salaryWordsHelp.textContent = 'Nhập tổng quỹ lương dự kiến cho phòng ban trong năm tài chính.';
                    budgetModal.show();
                });
            }

            // Buttons Edit Budget in table
            document.querySelectorAll('.btn-edit-budget').forEach(btn => {
                btn.addEventListener('click', function () {
                    const deptId = this.dataset.deptId;
                    const deptName = this.dataset.deptName;
                    const year = this.dataset.year;
                    const target = this.dataset.target;
                    const budget = this.dataset.budget;
                    const note = this.dataset.note || '';
                    const active = this.dataset.active === 'true';
                    const hasPlan = this.dataset.hasPlan === 'true';

                    modalTitleText.textContent = hasPlan 
                        ? `Cập nhật chỉ tiêu định biên: ${deptName}` 
                        : `Khai báo chỉ tiêu định biên: ${deptName}`;

                    modalDepartmentId.value = deptId;
                    modalYear.value = year;
                    modalTargetHeadcount.value = target || '';
                    
                    const numBudget = parseFloat(budget) || 0;
                    modalSalaryBudget.value = numBudget;
                    modalSalaryBudgetDisplay.value = numBudget > 0 ? numBudget.toLocaleString('vi-VN') : '';
                    if (numBudget >= 1000000000) {
                        salaryWordsHelp.textContent = `Tương đương: ${(numBudget / 1000000000).toFixed(2)} tỷ VND`;
                    }

                    modalNote.value = note;
                    modalIsActive.checked = active;

                    budgetModal.show();
                });
            });
        });
    </script>
}
