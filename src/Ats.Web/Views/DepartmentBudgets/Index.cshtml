@model Ats.Web.Models.ViewModels.DepartmentBudgets.DepartmentBudgetListViewModel
@{
    ViewData["Title"] = "Quản lý Định biên & Ngân sách Headcount";
    var currentYear = DateTime.UtcNow.Year;
}

<style>
    /* ─── NoveraTech Headcount Management Custom Styling (RULE.MD Compliant) ─── */
    .headcount-container {
        max-width: 1600px;
        margin: 0 auto;
    }

    /* Executive Metric Cards */
    .kpi-metric-card {
        background: #FFFFFF;
        border: 1px solid var(--border-default, #E2E8F0);
        border-radius: 12px;
        padding: 1.25rem 1.25rem 1rem;
        transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
        position: relative;
        overflow: hidden;
    }
    .kpi-metric-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px -2px rgba(15, 23, 42, 0.08);
        border-color: #CBD5E1;
    }
    .kpi-metric-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        flex-shrink: 0;
    }
    .kpi-metric-value {
        font-family: var(--font-mono, 'JetBrains Mono', 'SF Mono', Consolas, monospace);
        font-size: 1.85rem;
        font-weight: 700;
        line-height: 1.2;
        color: #0F172A;
        letter-spacing: -0.02em;
    }
    .kpi-metric-unit {
        font-family: 'Inter', -apple-system, sans-serif;
        font-size: 0.85rem;
        font-weight: 500;
        color: #64748B;
        margin-left: 0.25rem;
    }

    /* Table Container & Filter Toolbar */
    .budget-table-card {
        background: #FFFFFF;
        border: 1px solid var(--border-default, #E2E8F0);
        border-radius: 12px;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
        overflow: hidden;
    }
    .budget-toolbar {
        padding: 1rem 1.25rem;
        background: #FFFFFF;
        border-bottom: 1px solid #E2E8F0;
    }
    .filter-chip-btn {
        border: 1px solid #E2E8F0;
        background: #FFFFFF;
        color: #475569;
        font-size: 0.8125rem;
        font-weight: 500;
        padding: 0.375rem 0.75rem;
        border-radius: 6px;
        transition: all 0.15s ease;
        cursor: pointer;
    }
    .filter-chip-btn:hover {
        background: #F8FAFC;
        border-color: #CBD5E1;
        color: #0F172A;
    }
    .filter-chip-btn.active {
        background: #ECFDF5;
        border-color: #A7F3D0;
        color: #065F46;
        font-weight: 600;
    }

    /* Table Styling */
    .ats-mobile-table-wrapper {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }
    .budget-data-table {
        min-width: 960px;
        width: 100%;
        margin-bottom: 0;
        border-collapse: separate;
        border-spacing: 0;
    }
    .budget-data-table th {
        background-color: #F8FAFC;
        color: #64748B;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.875rem 1rem;
        border-bottom: 1px solid #E2E8F0;
        border-top: none;
        white-space: nowrap;
    }
    .budget-data-table td {
        padding: 1rem 1rem;
        vertical-align: middle;
        border-bottom: 1px solid #F1F5F9;
        color: #334155;
        font-size: 0.875rem;
    }
    .budget-data-table tbody tr:hover td {
        background-color: #F8FAFC;
    }
    .budget-data-table tbody tr:last-child td {
        border-bottom: none;
    }

    /* Department Badge & Meta */
    .dept-avatar-badge {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.75rem;
        letter-spacing: 0.02em;
        flex-shrink: 0;
        background: #F1F5F9;
        color: #0F172A;
        border: 1px solid #E2E8F0;
    }

    /* Number & Progress styling */
    .mono-num {
        font-family: var(--font-mono, 'JetBrains Mono', 'SF Mono', Consolas, monospace);
        font-weight: 600;
    }
    .utilization-track {
        height: 7px;
        background: #F1F5F9;
        border-radius: 9999px;
        overflow: hidden;
        width: 100%;
        margin-top: 5px;
    }
    .utilization-fill {
        height: 100%;
        border-radius: 9999px;
        transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Action Buttons */
    .btn-action-edit {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        color: #334155;
        padding: 0.4rem 0.75rem;
        border-radius: 6px;
        font-size: 0.8125rem;
        font-weight: 500;
        transition: all 0.15s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
    }
    .btn-action-edit:hover {
        background: #F8FAFC;
        border-color: #059669;
        color: #059669;
        box-shadow: 0 1px 3px rgba(5, 150, 105, 0.1);
    }

    /* Primary CTA Button */
    .btn-novera-primary {
        background: #059669;
        border: 1px solid #059669;
        color: #FFFFFF;
        font-weight: 600;
        font-size: 0.875rem;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        box-shadow: 0 1px 2px rgba(5, 150, 105, 0.15);
        transition: all 0.15s ease;
    }
    .btn-novera-primary:hover {
        background: #047857;
        border-color: #047857;
        color: #FFFFFF;
        box-shadow: 0 4px 10px rgba(5, 150, 105, 0.25);
        transform: translateY(-1px);
    }
</style>

<div class="container-fluid px-3 px-md-4 py-4 headcount-container">
    <!-- Breadcrumb & Single-Tier Command Header (RULE.MD 1.1 & 3.4) -->
    <nav aria-label="breadcrumb" class="mb-2">
        <ol class="breadcrumb mb-0" style="font-size: 0.8125rem;">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted"><i class="bi bi-house me-1"></i>Trang chủ</a></li>
            <li class="breadcrumb-item"><span class="text-muted">Cơ cấu &amp; Tiêu chuẩn</span></li>
            <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Ngân sách Headcount</li>
        </ol>
    </nav>

    <!-- Page Title & Primary Controls -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3 pb-2">
        <div>
            <h1 class="h3 fw-bold text-slate-900 mb-1" style="color: #0F172A; letter-spacing: -0.02em;">
                Định biên Nhân sự &amp; Ngân sách Tuyển dụng
            </h1>
            <p class="text-muted small mb-0">
                Khai báo chỉ tiêu nhân sự, quỹ lương phê duyệt và kiểm soát tiến độ định biên theo khối/phòng ban năm tài chính <strong>@Model.SelectedYear</strong>.
            </p>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <!-- Year Selector Form -->
            <form method="get" action="/ngan-sach-headcount" class="d-flex align-items-center gap-2 bg-white border border-slate-200 px-3 py-1 rounded-3 shadow-2xs" style="border-radius: 8px;">
                <i class="bi bi-calendar3 text-muted small"></i>
                <label for="yearFilterSelect" class="text-secondary small fw-semibold text-nowrap mb-0">Năm tài chính:</label>
                <select name="year" id="yearFilterSelect" class="form-select form-select-sm border-0 shadow-none fw-bold text-dark px-1 py-1" style="width: 80px; background-color: transparent; cursor: pointer;" onchange="this.form.submit()">
                    @for (int y = currentYear - 1; y <= currentYear + 2; y++)
                    {
                        if (y == Model.SelectedYear)
                        {
                            <option value="@y" selected="selected">@y</option>
                        }
                        else
                        {
                            <option value="@y">@y</option>
                        }
                    }
                </select>
            </form>

            @if (Model.CanManageBudget)
            {
                <button type="button" class="btn-novera-primary" id="btnOpenCreateBudgetModal">
                    <i class="bi bi-plus-lg"></i>
                    <span>Khai báo chỉ tiêu</span>
                </button>
            }
        </div>
    </div>



    <!-- 4 Executive KPI Stat Cards (RULE.MD 4 & 5) -->
    <div class="row g-3 mb-4">
        <!-- 1. Tổng định biên -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="kpi-metric-card h-100">
                <div class="d-flex align-items-start justify-content-between mb-2">
                    <div>
                        <span class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.04em;">Tổng định biên năm @Model.SelectedYear</span>
                        <div class="kpi-metric-value mt-1">
                            @Model.TotalTargetHeadcount <span class="kpi-metric-unit">nhân sự</span>
                        </div>
                    </div>
                    <div class="kpi-metric-icon" style="background: #EFF6FF; color: #2563EB;">
                        <i class="bi bi-people"></i>
                    </div>
                </div>
                <div class="d-flex align-items-center justify-content-between text-muted small pt-2 border-top border-slate-100 mt-2">
                    <span>Đã phân bổ định biên</span>
                    <span class="fw-semibold text-slate-700">@Model.Items.Count(i => i.HasBudgetPlan) / @Model.Items.Count phòng ban</span>
                </div>
            </div>
        </div>

        <!-- 2. Đã sử dụng -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="kpi-metric-card h-100">
                <div class="d-flex align-items-start justify-content-between mb-2">
                    <div>
                        <span class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.04em;">Nhân sự đã sử dụng</span>
                        <div class="kpi-metric-value mt-1">
                            @Model.TotalUsedHeadcount <span class="kpi-metric-unit">người</span>
                        </div>
                    </div>
                    <div class="kpi-metric-icon" style="background: #FFFBEB; color: #D97706;">
                        <i class="bi bi-person-check"></i>
                    </div>
                </div>
                <div class="d-flex align-items-center justify-content-between text-muted small pt-2 border-top border-slate-100 mt-2">
                    <span>Phân bổ thực tế</span>
                    <span class="fw-semibold text-slate-700">@Model.TotalCurrentStaff chính thức · @Model.TotalRecruiting đang tuyển</span>
                </div>
            </div>
        </div>

        <!-- 3. Còn lại khả dụng -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="kpi-metric-card h-100">
                <div class="d-flex align-items-start justify-content-between mb-2">
                    <div>
                        <span class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.04em;">Chỉ tiêu còn lại khả dụng</span>
                        <div class="kpi-metric-value mt-1 @(Model.TotalRemainingHeadcount > 0 ? "text-emerald-700" : "text-rose-600")" style="color: @(Model.TotalRemainingHeadcount > 0 ? "#059669" : "#DC2626");">
                            @(Model.TotalRemainingHeadcount >= 0 ? "+" + Model.TotalRemainingHeadcount : Model.TotalRemainingHeadcount.ToString()) 
                            <span class="kpi-metric-unit">vị trí</span>
                        </div>
                    </div>
                    <div class="kpi-metric-icon" style="background: @(Model.TotalRemainingHeadcount > 0 ? "#ECFDF5" : "#FEF2F2"); color: @(Model.TotalRemainingHeadcount > 0 ? "#059669" : "#DC2626");">
                        <i class="bi @(Model.TotalRemainingHeadcount > 0 ? "bi-person-plus" : "bi-exclamation-octagon")"></i>
                    </div>
                </div>
                <div class="d-flex align-items-center justify-content-between text-muted small pt-2 border-top border-slate-100 mt-2">
                    <span>Tỉ lệ lấp đầy toàn cty</span>
                    <span class="fw-semibold mono-num @(Model.OverallUsagePercentage >= 100 ? "text-danger" : Model.OverallUsagePercentage >= 80 ? "text-warning" : "text-emerald-600")">
                        @Model.OverallUsagePercentage.ToString("F1")%
                    </span>
                </div>
            </div>
        </div>

        <!-- 4. Tổng quỹ lương -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="kpi-metric-card h-100">
                <div class="d-flex align-items-start justify-content-between mb-2">
                    <div>
                        <span class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.04em;">Tổng ngân sách lương</span>
                        <div class="kpi-metric-value mt-1" style="color: #6D28D9;">
                            @(Model.TotalSalaryBudget >= 1_000_000_000 ? (Model.TotalSalaryBudget / 1_000_000_000m).ToString("N2") + " tỷ" : Model.TotalSalaryBudget.ToString("N0")) 
                            <span class="kpi-metric-unit">VND</span>
                        </div>
                    </div>
                    <div class="kpi-metric-icon" style="background: #F5F3FF; color: #7C3AED;">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                </div>
                <div class="d-flex align-items-center justify-content-between text-muted small pt-2 border-top border-slate-100 mt-2">
                    <span>Quỹ lương phê duyệt</span>
                    <span class="fw-semibold text-slate-700">Năm @Model.SelectedYear</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Table Card with Integrated Search & Filter (Clean Enterprise Design) -->
    <div class="budget-table-card">
        <!-- Card Header & Filter Toolbar -->
        <div class="budget-toolbar">
            <div class="row g-3 align-items-center">
                <!-- Search Box -->
                <div class="col-12 col-md-5 col-lg-4">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0 text-muted" style="border-radius: 8px 0 0 8px;">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="tableSearchInput" class="form-control border-start-0" placeholder="Tìm theo tên phòng ban, mã khối, trưởng phòng..." style="border-radius: 0 8px 8px 0; font-size: 0.875rem;" />
                    </div>
                </div>

                <!-- Filter Chips -->
                <div class="col-12 col-md-7 col-lg-8 d-flex justify-content-start justify-content-md-end align-items-center gap-2 flex-wrap">
                    <button type="button" class="filter-chip-btn active" data-filter="all">
                        Tất cả (@Model.Items.Count)
                    </button>
                    <button type="button" class="filter-chip-btn" data-filter="available">
                        <i class="bi bi-check-circle me-1 text-emerald-600"></i>Còn chỉ tiêu (@Model.Items.Count(x => x.HasBudgetPlan && x.RemainingHeadcount > 0))
                    </button>
                    <button type="button" class="filter-chip-btn" data-filter="warning">
                        <i class="bi bi-exclamation-triangle me-1 text-amber-500"></i>Hết / Vượt định biên (@Model.Items.Count(x => x.HasBudgetPlan && x.RemainingHeadcount <= 0))
                    </button>
                    <button type="button" class="filter-chip-btn" data-filter="noplan">
                        <i class="bi bi-dash-circle me-1 text-secondary"></i>Chưa khai báo (@Model.Items.Count(x => !x.HasBudgetPlan))
                    </button>
                </div>
            </div>
        </div>

        <!-- Responsive Table Container -->
        <div class="ats-mobile-table-wrapper">
            <table class="budget-data-table" id="budgetTable">
                <thead>
                    <tr>
                        <th class="ps-4">Phòng ban &amp; Trưởng bộ phận</th>
                        <th class="text-center">Chỉ tiêu (Định biên)</th>
                        <th class="text-center">Đã sử dụng</th>
                        <th class="text-center">Còn lại</th>
                        <th style="min-width: 180px;">Tiến độ sử dụng</th>
                        <th>Ngân sách lương</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="pe-4 text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="budgetTableBody">
                    @if (!Model.Items.Any())
                    {
                        <tr id="emptyTableRow">
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-building fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                Chưa có phòng ban nào được thiết lập trong hệ thống.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            var usagePercent = item.UsagePercentage;
                            var statusCategory = !item.HasBudgetPlan ? "noplan" :
                                                 item.RemainingHeadcount <= 0 ? "warning" : "available";

                            var progressColor = usagePercent > 100 ? "#EF4444" :
                                                usagePercent >= 80 ? "#F59E0B" : "#10B981";

                            <tr class="budget-row" 
                                data-status-category="@statusCategory"
                                data-dept-name="@item.DepartmentName.ToLower()"
                                data-dept-code="@item.DepartmentCode.ToLower()"
                                data-manager-name="@(item.ManagerName?.ToLower() ?? "")">
                                
                                <!-- Cột 1: Phòng ban & Trưởng bộ phận -->
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="dept-avatar-badge" title="Mã khối: @item.DepartmentCode">
                                            @item.DepartmentCode
                                        </div>
                                        <div>
                                            <div class="fw-bold text-slate-900" style="color: #0F172A; font-size: 0.9375rem;">
                                                @item.DepartmentName
                                            </div>
                                            <div class="text-muted small d-flex align-items-center gap-1 mt-0.5" style="font-size: 0.8125rem;">
                                                <i class="bi bi-person-badge text-secondary opacity-75"></i>
                                                @(string.IsNullOrWhiteSpace(item.ManagerName) ? "Chưa chỉ định trưởng phòng" : item.ManagerName)
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Cột 2: Chỉ tiêu định biên -->
                                <td class="text-center">
                                    @if (item.HasBudgetPlan)
                                    {
                                        <div class="mono-num fs-5 fw-bold text-dark mb-0">@item.TargetHeadcount</div>
                                        <span class="text-muted" style="font-size: 0.75rem;">chỉ tiêu</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-slate-100 text-secondary border border-slate-200 px-2 py-1 fw-normal" style="font-size: 0.75rem;">
                                            Chưa khai báo
                                        </span>
                                    }
                                </td>

                                <!-- Cột 3: Đã sử dụng -->
                                <td class="text-center">
                                    <div class="mono-num fs-6 fw-bold text-dark">@item.UsedHeadcount</div>
                                    <div class="d-flex align-items-center justify-content-center gap-1 mt-1" style="font-size: 0.75rem;">
                                        <span class="badge bg-slate-100 text-slate-600 border border-slate-200 px-1.5 py-0.5" title="Nhân viên chính thức đang làm việc">
                                            @item.CurrentStaffCount chính thức
                                        </span>
                                        @if (item.InFlightRequisitionQuantity > 0)
                                        {
                                            <span class="badge bg-amber-50 text-amber-700 border border-amber-200 px-1.5 py-0.5" title="Yêu cầu tuyển dụng đang mở">
                                                @item.InFlightRequisitionQuantity đang tuyển
                                            </span>
                                        }
                                    </div>
                                </td>

                                <!-- Cột 4: Còn lại khả dụng -->
                                <td class="text-center">
                                    @if (!item.HasBudgetPlan)
                                    {
                                        <span class="badge bg-slate-100 text-slate-500 border border-slate-200 px-2 py-1">
                                            --
                                        </span>
                                    }
                                    else if (item.RemainingHeadcount < 0)
                                    {
                                        <span class="badge border px-2.5 py-1.5 mono-num fw-bold d-inline-flex align-items-center gap-1" style="background: #FEF2F2; color: #DC2626; border-color: #FECACA; font-size: 0.8125rem;">
                                            <i class="bi bi-exclamation-triangle-fill"></i> Vượt @Math.Abs(item.RemainingHeadcount)
                                        </span>
                                    }
                                    else if (item.RemainingHeadcount == 0)
                                    {
                                        <span class="badge border px-2.5 py-1.5 mono-num fw-bold d-inline-flex align-items-center gap-1" style="background: #FFFBEB; color: #D97706; border-color: #FDE68A; font-size: 0.8125rem;">
                                            <i class="bi bi-dash-circle-fill"></i> Hết chỉ tiêu (0)
                                        </span>
                                    }
                                    else if (item.RemainingHeadcount <= 2)
                                    {
                                        <span class="badge border px-2.5 py-1.5 mono-num fw-bold d-inline-flex align-items-center gap-1" style="background: #FFFBEB; color: #D97706; border-color: #FDE68A; font-size: 0.8125rem;">
                                            <i class="bi bi-clock-history"></i> Còn +@item.RemainingHeadcount
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge border px-2.5 py-1.5 mono-num fw-bold d-inline-flex align-items-center gap-1" style="background: #ECFDF5; color: #059669; border-color: #A7F3D0; font-size: 0.8125rem;">
                                            <i class="bi bi-check-circle-fill"></i> Còn +@item.RemainingHeadcount
                                        </span>
                                    }
                                </td>

                                <!-- Cột 5: Tiến độ sử dụng -->
                                <td>
                                    @if (item.HasBudgetPlan && item.TargetHeadcount > 0)
                                    {
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="small text-muted" style="font-size: 0.75rem;">Tỉ lệ sử dụng</span>
                                            <span class="small mono-num fw-bold @(usagePercent > 100 ? "text-danger" : usagePercent >= 80 ? "text-warning" : "text-emerald-600")">
                                                @usagePercent.ToString("F1")%
                                            </span>
                                        </div>
                                        <div class="utilization-track">
                                            <div class="utilization-fill" style="width: @Math.Min(usagePercent, 100)%; background-color: @progressColor;"></div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">--</span>
                                    }
                                </td>

                                <!-- Cột 6: Ngân sách lương -->
                                <td>
                                    @if (item.HasBudgetPlan && item.SalaryBudget > 0)
                                    {
                                        <div class="mono-num fw-bold text-dark" style="font-size: 0.875rem;">
                                            @(item.SalaryBudget >= 1_000_000_000 ? (item.SalaryBudget / 1_000_000_000m).ToString("N2") + " tỷ" : (item.SalaryBudget / 1_000_000m).ToString("N0") + " tr")
                                            <span class="text-muted fw-normal" style="font-size: 0.75rem;">₫</span>
                                        </div>
                                        <div class="text-muted mono-num" style="font-size: 0.75rem;" title="Tổng ngân sách lương chi tiết">
                                            @item.SalaryBudget.ToString("N0") VND
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Chưa thiết lập</span>
                                    }
                                </td>

                                <!-- Cột 7: Trạng thái -->
                                <td class="text-center">
                                    @if (item.HasBudgetPlan)
                                    {
                                        if (item.IsActive)
                                        {
                                            <span class="d-inline-flex align-items-center gap-1.5 px-2.5 py-1 rounded-pill" style="background: #ECFDF5; color: #065F46; font-size: 0.75rem; font-weight: 500;">
                                                <span class="rounded-circle" style="width: 6px; height: 6px; background: #10B981;"></span>
                                                Áp dụng
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="d-inline-flex align-items-center gap-1.5 px-2.5 py-1 rounded-pill" style="background: #F1F5F9; color: #64748B; font-size: 0.75rem; font-weight: 500;">
                                                <span class="rounded-circle" style="width: 6px; height: 6px; background: #94A3B8;"></span>
                                                Tạm dừng
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border border-slate-200 font-normal" style="font-size: 0.75rem;">
                                            Chưa cấp
                                        </span>
                                    }
                                </td>

                                <!-- Cột 8: Thao tác -->
                                <td class="pe-4 text-end">
                                    @if (Model.CanManageBudget)
                                    {
                                        <button type="button" 
                                                class="btn-action-edit btn-edit-budget"
                                                data-dept-id="@item.DepartmentId"
                                                data-dept-name="@item.DepartmentName"
                                                data-dept-code="@item.DepartmentCode"
                                                data-year="@Model.SelectedYear"
                                                data-target="@item.TargetHeadcount"
                                                data-budget="@item.SalaryBudget"
                                                data-note="@item.Note"
                                                data-active="@item.IsActive.ToString().ToLower()"
                                                data-has-plan="@item.HasBudgetPlan.ToString().ToLower()">
                                            <i class="bi @(item.HasBudgetPlan ? "bi-pencil" : "bi-plus-circle")"></i>
                                            <span>@(item.HasBudgetPlan ? "Cập nhật" : "Khai báo")</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">--</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Table Footer Summary -->
        <div class="px-4 py-3 bg-white border-top border-slate-100 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <span class="text-muted small" id="tableFilterSummary">
                Hiển thị <strong id="visibleRowCount">@Model.Items.Count</strong> / @Model.Items.Count phòng ban
            </span>
            <div class="text-muted small" style="font-size: 0.8125rem;">
                <i class="bi bi-info-circle me-1"></i> Định biên được dùng để kiểm soát tự động khi Trưởng bộ phận gửi Yêu cầu tuyển dụng.
            </div>
        </div>
    </div>
</div>

<!-- Modal Khai báo / Cập nhật chỉ tiêu Headcount & Ngân sách (RULE.MD Compliant) -->
<div class="modal fade" id="budgetModal" tabindex="-1" aria-labelledby="budgetModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
            <!-- Modal Header: Sạch sẽ, tinh tế với icon xanh ngọc -->
            <div class="modal-header bg-white py-3 px-4 border-bottom border-slate-100 d-flex align-items-center">
                <div class="d-flex align-items-center gap-2.5">
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; background: #ECFDF5; color: #059669;">
                        <i class="bi bi-sliders2-vertical fs-6"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-slate-900 mb-0" id="budgetModalLabel" style="font-size: 1.05rem; color: #0F172A;">
                            <span id="modalTitleText">Khai báo chỉ tiêu Headcount &amp; Ngân sách</span>
                        </h5>
                        <p class="text-muted small mb-0" style="font-size: 0.75rem;">Thiết lập định biên số lượng và trần quỹ lương theo năm</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form id="budgetForm" method="post" action="/ngan-sach-headcount/save">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <!-- Phòng ban -->
                    <div class="mb-3">
                        <label for="modalDepartmentId" class="form-label fw-semibold text-slate-800" style="font-size: 0.875rem;">
                            Phòng ban <span class="text-danger">*</span>
                        </label>
                        <select class="form-select" id="modalDepartmentId" name="DepartmentId" required style="border-radius: 8px; font-size: 0.875rem;">
                            <option value="">-- Chọn phòng ban --</option>
                            @foreach (var dept in Model.Items)
                            {
                                <option value="@dept.DepartmentId">@dept.DepartmentName (@dept.DepartmentCode)</option>
                            }
                        </select>
                    </div>

                    <!-- Năm tài chính & Định biên headcount -->
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label for="modalYear" class="form-label fw-semibold text-slate-800" style="font-size: 0.875rem;">
                                Năm tài chính <span class="text-danger">*</span>
                            </label>
                            <input type="number" class="form-control mono-num" id="modalYear" name="Year" value="@Model.SelectedYear" min="2020" max="2050" required style="border-radius: 8px; font-size: 0.875rem;" />
                        </div>
                        <div class="col-6">
                            <label for="modalTargetHeadcount" class="form-label fw-semibold text-slate-800" style="font-size: 0.875rem;">
                                Chỉ tiêu Headcount <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input type="number" class="form-control mono-num" id="modalTargetHeadcount" name="TargetHeadcount" min="0" placeholder="VD: 25" required style="border-top-left-radius: 8px; border-bottom-left-radius: 8px; font-size: 0.875rem;" />
                                <span class="input-group-text bg-light text-muted small" style="border-top-right-radius: 8px; border-bottom-right-radius: 8px;">Nhân sự</span>
                            </div>
                        </div>
                    </div>

                    <!-- Ngân sách lương phê duyệt -->
                    <div class="mb-3">
                        <label for="modalSalaryBudgetDisplay" class="form-label fw-semibold text-slate-800" style="font-size: 0.875rem;">
                            Ngân sách lương phê duyệt (VND) <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted" style="border-top-left-radius: 8px; border-bottom-left-radius: 8px;">₫</span>
                            <input type="text" class="form-control mono-num" id="modalSalaryBudgetDisplay" placeholder="VD: 5,000,000,000" required style="border-top-right-radius: 8px; border-bottom-right-radius: 8px; font-size: 0.875rem;" />
                        </div>
                        <input type="hidden" id="modalSalaryBudget" name="SalaryBudget" value="0" />
                        <div class="form-text text-muted mt-1" id="salaryBudgetWordsHelp" style="font-size: 0.75rem;">
                            Nhập tổng quỹ lương dự kiến cho phòng ban trong năm tài chính.
                        </div>
                    </div>

                    <!-- Ghi chú / Căn cứ phê duyệt -->
                    <div class="mb-3">
                        <label for="modalNote" class="form-label fw-semibold text-slate-800" style="font-size: 0.875rem;">
                            Căn cứ / Ghi chú phê duyệt
                        </label>
                        <textarea class="form-control" id="modalNote" name="Note" rows="3" placeholder="VD: Phê duyệt theo Quyết định số 05/QĐ-BOD ngày 15/01/2026 của Ban Giám Đốc." style="border-radius: 8px; font-size: 0.875rem;"></textarea>
                    </div>

                    <!-- Switch kích hoạt áp dụng -->
                    <div class="form-check form-switch mb-0 pt-1">
                        <input class="form-check-input" type="checkbox" role="switch" id="modalIsActive" name="IsActive" value="true" checked style="cursor: pointer;" />
                        <label class="form-check-label fw-semibold text-slate-800" for="modalIsActive" style="font-size: 0.875rem; cursor: pointer;">
                            Kích hoạt áp dụng định biên này ngay lập tức
                        </label>
                    </div>
                </div>

                <div class="modal-footer bg-slate-50 px-4 py-3 border-top border-slate-100 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-light px-3" data-bs-dismiss="modal" style="border-radius: 8px; font-size: 0.875rem; border: 1px solid #E2E8F0;">
                        Hủy bỏ
                    </button>
                    <button type="submit" class="btn-novera-primary px-4" id="btnSubmitBudgetForm">
                        <i class="bi bi-check2"></i>
                        <span>Lưu chỉ tiêu định biên</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Elements
            const budgetModalElement = document.getElementById('budgetModal');
            if (!budgetModalElement) return;

            const budgetModal = new bootstrap.Modal(budgetModalElement);
            const modalTitleText = document.getElementById('modalTitleText');
            const modalDepartmentId = document.getElementById('modalDepartmentId');
            const modalYear = document.getElementById('modalYear');
            const modalTargetHeadcount = document.getElementById('modalTargetHeadcount');
            const modalSalaryBudgetDisplay = document.getElementById('modalSalaryBudgetDisplay');
            const modalSalaryBudget = document.getElementById('modalSalaryBudget');
            const modalNote = document.getElementById('modalNote');
            const modalIsActive = document.getElementById('modalIsActive');
            const salaryWordsHelp = document.getElementById('salaryBudgetWordsHelp');
            const searchInput = document.getElementById('tableSearchInput');
            const filterChips = document.querySelectorAll('.filter-chip-btn');
            const tableRows = document.querySelectorAll('#budgetTableBody .budget-row');
            const visibleRowCount = document.getElementById('visibleRowCount');
            const emptyTableRow = document.getElementById('emptyTableRow');

            let currentFilter = 'all';

            // Filter & Search Logic
            function applyFilters() {
                const query = (searchInput ? searchInput.value : '').toLowerCase().trim();
                let visibleCount = 0;

                tableRows.forEach(row => {
                    const status = row.dataset.statusCategory;
                    const deptName = row.dataset.deptName || '';
                    const deptCode = row.dataset.deptCode || '';
                    const manager = row.dataset.managerName || '';

                    const matchesStatus = (currentFilter === 'all') || (status === currentFilter);
                    const matchesQuery = !query || 
                                         deptName.includes(query) || 
                                         deptCode.includes(query) || 
                                         manager.includes(query);

                    if (matchesStatus && matchesQuery) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                if (visibleRowCount) {
                    visibleRowCount.textContent = visibleCount;
                }
            }

            // Search input listener
            if (searchInput) {
                searchInput.addEventListener('input', applyFilters);
            }

            // Filter chips listener
            filterChips.forEach(chip => {
                chip.addEventListener('click', function () {
                    filterChips.forEach(c => c.classList.remove('active'));
                    this.classList.add('active');
                    currentFilter = this.dataset.filter;
                    applyFilters();
                });
            });

            // Live Thousand Separator Formatting for Salary Budget
            modalSalaryBudgetDisplay.addEventListener('input', function () {
                const rawVal = this.value.replace(/\D/g, '');
                const num = parseInt(rawVal, 10) || 0;
                modalSalaryBudget.value = num;
                this.value = num > 0 ? num.toLocaleString('vi-VN') : '';

                if (num >= 1000000000) {
                    const ty = (num / 1000000000).toFixed(2);
                    salaryWordsHelp.innerHTML = `<span class="text-success fw-semibold"><i class="bi bi-info-circle me-1"></i>Tương đương: ${ty} tỷ VND</span>`;
                } else if (num >= 1000000) {
                    const tr = (num / 1000000).toFixed(1);
                    salaryWordsHelp.innerHTML = `<span class="text-success fw-semibold"><i class="bi bi-info-circle me-1"></i>Tương đương: ${tr} triệu VND</span>`;
                } else if (num > 0) {
                    salaryWordsHelp.innerHTML = `<span class="text-muted"><i class="bi bi-info-circle me-1"></i>${num.toLocaleString('vi-VN')} VND</span>`;
                } else {
                    salaryWordsHelp.textContent = 'Nhập tổng quỹ lương dự kiến cho phòng ban trong năm tài chính.';
                }
            });

            // Button Open Create Modal
            const btnCreate = document.getElementById('btnOpenCreateBudgetModal');
            if (btnCreate) {
                btnCreate.addEventListener('click', function () {
                    modalTitleText.textContent = 'Khai báo chỉ tiêu Headcount & Ngân sách';
                    modalDepartmentId.value = '';
                    modalDepartmentId.disabled = false;
                    modalYear.value = '@Model.SelectedYear';
                    modalTargetHeadcount.value = '';
                    modalSalaryBudgetDisplay.value = '';
                    modalSalaryBudget.value = '0';
                    modalNote.value = '';
                    modalIsActive.checked = true;
                    salaryWordsHelp.textContent = 'Nhập tổng quỹ lương dự kiến cho phòng ban trong năm tài chính.';
                    budgetModal.show();
                });
            }

            // Buttons Edit Budget in Table
            document.querySelectorAll('.btn-edit-budget').forEach(btn => {
                btn.addEventListener('click', function () {
                    const deptId = this.dataset.deptId;
                    const deptName = this.dataset.deptName;
                    const year = this.dataset.year;
                    const target = this.dataset.target;
                    const budget = this.dataset.budget;
                    const note = this.dataset.note || '';
                    const active = this.dataset.active === 'true';
                    const hasPlan = this.dataset.hasPlan === 'true';

                    modalTitleText.textContent = hasPlan 
                        ? `Cập nhật định biên: ${deptName}` 
                        : `Khai báo định biên: ${deptName}`;

                    modalDepartmentId.value = deptId;
                    modalYear.value = year;
                    modalTargetHeadcount.value = target || '';
                    
                    const numBudget = parseFloat(budget) || 0;
                    modalSalaryBudget.value = numBudget;
                    modalSalaryBudgetDisplay.value = numBudget > 0 ? numBudget.toLocaleString('vi-VN') : '';
                    if (numBudget >= 1000000000) {
                        salaryWordsHelp.innerHTML = `<span class="text-success fw-semibold"><i class="bi bi-info-circle me-1"></i>Tương đương: ${(numBudget / 1000000000).toFixed(2)} tỷ VND</span>`;
                    } else if (numBudget >= 1000000) {
                        salaryWordsHelp.innerHTML = `<span class="text-success fw-semibold"><i class="bi bi-info-circle me-1"></i>Tương đương: ${(numBudget / 1000000).toFixed(1)} triệu VND</span>`;
                    } else {
                        salaryWordsHelp.textContent = 'Nhập tổng quỹ lương dự kiến cho phòng ban trong năm tài chính.';
                    }

                    modalNote.value = note;
                    modalIsActive.checked = active;

                    budgetModal.show();
                });
            });
        });
    </script>
}
