@model Ats.Web.Models.ViewModels.Evaluations.EvaluationFormGenerateViewModel
@{
    var isSubmitted = Model.IsReadOnly || Model.Status == "SUBMITTED";
}

<div class="evaluation-container p-1">
    <!-- ── Container cảnh báo thông báo ── -->
    <div id="eval-alert-container"></div>

    @if (isSubmitted)
    {
        <div class="alert alert-info border-0 shadow-sm rounded-3 py-2.5 px-3 mb-4 d-flex align-items-center" style="background: #EFF6FF; color: #1E40AF; border-left: 4px solid #3B82F6 !important;">
            <i class="bi bi-shield-lock-fill me-2 fs-5 text-primary"></i>
            <div>
                <span class="fw-bold">Phiếu đánh giá đã được nộp chính thức!</span>
                <span class="small d-block text-muted">Toàn bộ tiêu chí và điểm số đã được snapshot bảo đảm tính bất biến và khóa chỉnh sửa.</span>
            </div>
        </div>
    }

    <!-- ── Header: Thông tin Ứng viên & Khung năng lực ── -->
    <div class="card border-0 shadow-sm rounded-3 mb-4" style="background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%); color: #F8FAFC;">
        <div class="card-body p-3 p-md-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <div>
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 rounded-2 fw-medium">
                            <i class="bi bi-calendar2-event me-1"></i>Vòng phỏng vấn @Model.InterviewRound
                        </span>
                        <span class="badge bg-light text-dark px-2.5 py-1 rounded-2 fw-medium">
                            <i class="bi bi-camera-video me-1"></i>@Model.JobTitle
                        </span>
                        @if (isSubmitted)
                        {
                            <span class="badge bg-success px-2.5 py-1 rounded-2">
                                <i class="bi bi-check-circle-fill me-1"></i>ĐÃ NỘP CHÍNH THỨC
                            </span>
                        }
                        else if (Model.Status == "DRAFT")
                        {
                            <span class="badge bg-warning text-dark px-2.5 py-1 rounded-2">
                                <i class="bi bi-pencil-fill me-1"></i>BẢN NHÁP
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-info text-dark px-2.5 py-1 rounded-2">
                                <i class="bi bi-sparkles me-1"></i>CHƯA CHẤM ĐIỂM
                            </span>
                        }
                    </div>
                    <h4 class="fw-bold mb-1 text-white">@Model.CandidateName</h4>
                    <div class="d-flex flex-wrap align-items-center gap-3 small text-slate-300" style="color: #94A3B8;">
                        <span><i class="bi bi-envelope me-1"></i>@Model.CandidateEmail</span>
                        @if (!string.IsNullOrEmpty(Model.DepartmentName))
                        {
                            <span>•</span>
                            <span><i class="bi bi-building me-1"></i>@Model.DepartmentName</span>
                        }
                    </div>
                </div>

                <!-- Snapshot Badge -->
                <div class="text-md-end bg-slate-800 p-2.5 rounded-3 border border-secondary border-opacity-25" style="background: rgba(30, 41, 59, 0.7);">
                    <div class="small text-uppercase fw-semibold" style="color: #38BDF8; font-size: 0.72rem; letter-spacing: 0.5px;">
                        <i class="bi bi-layers-fill me-1"></i>Khung năng lực áp dụng
                    </div>
                    <div class="fw-bold text-white small mt-0.5">@Model.FrameworkName</div>
                    <div class="badge bg-dark text-muted border border-secondary mt-1" style="font-family: monospace; font-size: 0.68rem;">
                        SNAPSHOT v1.0
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Score Dashboard Card: Real-time Calculation Display ── -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 sticky-top" style="top: 10px; z-index: 1020; background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
        <div class="card-body p-3 p-md-3.5">
            <div class="row align-items-center g-3">
                <div class="col-12 col-md-4 text-center text-md-start">
                    <span class="text-muted small fw-semibold text-uppercase d-block" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                        ĐIỂM TỔNG BÌNH QUÂN GIA QUYỀN
                    </span>
                    <div class="d-flex align-items-baseline justify-content-center justify-content-md-start gap-1">
                        <span class="display-6 fw-bold text-dark" id="eval-total-score-display">@(Model.TotalScore > 0 ? Model.TotalScore.ToString("F2") : "0.00")</span>
                        <span class="text-muted fs-5 fw-semibold">/ 5.0</span>
                    </div>
                </div>

                <div class="col-12 col-md-5">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small text-muted" style="font-size: 0.76rem;">Thang đo chuẩn hóa</span>
                        <span class="small fw-semibold" id="eval-completion-counter" style="font-size: 0.76rem;">0/@Model.Items.Count tiêu chí</span>
                    </div>
                    <div class="progress" style="height: 10px; border-radius: 6px; background-color: #E2E8F0;">
                        <div id="eval-score-progress-bar" class="progress-bar progress-bar-striped progress-bar-animated bg-secondary" role="progressbar"
                             style="width: @((Model.TotalScore / 5.0m) * 100)%;" aria-valuenow="@Model.TotalScore" aria-valuemin="0" aria-valuemax="5"></div>
                    </div>
                </div>

                <div class="col-12 col-md-3 text-center text-md-end">
                    <span id="eval-score-rating-badge" class="badge bg-secondary text-white px-3 py-2 rounded-2 fw-semibold fs-6">
                        <i class="bi bi-clock me-1"></i>Chưa chấm điểm
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Form Chấm điểm tiêu chí ── -->
    <form id="evaluation-form" asp-controller="Evaluations" asp-action="Submit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="EvaluationFormId" value="@Model.EvaluationFormId" />
        <input type="hidden" name="ApplicationId" value="@Model.ApplicationId" />
        <input type="hidden" name="InterviewId" value="@Model.InterviewId" />
        <input type="hidden" id="eval-is-draft" name="IsDraft" value="false" />

        <div class="d-flex flex-column gap-3 mb-4">
            @for (int idx = 0; idx < Model.Items.Count; idx++)
            {
                var item = Model.Items[idx];
                <div class="card border-0 shadow-sm rounded-3 criterion-card" data-weight="@item.Weight" style="border: 1px solid #E2E8F0 !important;">
                    <input type="hidden" name="Items[@idx].CriteriaId" value="@item.CriteriaId" />
                    <input type="hidden" name="Items[@idx].CriteriaName" value="@item.CriteriaName" />
                    <input type="hidden" name="Items[@idx].CriteriaDescription" value="@item.CriteriaDescription" />
                    <input type="hidden" name="Items[@idx].Weight" value="@item.Weight" />

                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-2 mb-2">
                            <div>
                                <h5 class="fw-bold text-dark mb-1 criterion-title">
                                    <span class="badge bg-light text-secondary border me-1">#@(idx + 1)</span>
                                    @item.CriteriaName
                                </h5>
                                @if (!string.IsNullOrWhiteSpace(item.CriteriaDescription))
                                {
                                    <p class="text-muted small mb-0">@item.CriteriaDescription</p>
                                }
                            </div>
                            <span class="badge px-2.5 py-1.5 rounded-2 bg-light text-primary border border-primary-subtle flex-shrink-0" style="font-size: 0.78rem;">
                                <i class="bi bi-pie-chart-fill me-1"></i>Trọng số: <b>@item.Weight.ToString("G29")%</b>
                            </span>
                        </div>

                        <!-- ── Bộ chọn điểm trực quan 1-5 ── -->
                        <div class="mt-3">
                            <label class="form-label fw-semibold text-muted small text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                                Điểm đánh giá (1 - 5) <span class="text-danger">*</span>
                            </label>

                            <div class="row g-2">
                                @{
                                    var levels = new[]
                                    {
                                        (1, "1: Kém", "danger", item.Rubric1 ?? "Không đáp ứng yêu cầu cơ bản."),
                                        (2, "2: Dưới kỳ vọng", "warning", item.Rubric2 ?? "Cần đào tạo thêm, có lỗ hổng kiến thức."),
                                        (3, "3: Đạt kỳ vọng", "primary", item.Rubric3 ?? "Đáp ứng tốt yêu cầu công việc."),
                                        (4, "4: Vượt kỳ vọng", "info", item.Rubric4 ?? "Thành thạo, xử lý tốt tình huống khó."),
                                        (5, "5: Xuất sắc", "success", item.Rubric5 ?? "Chuyên gia, dẫn dắt và có tầm ảnh hưởng.")
                                    };
                                }

                                @foreach (var (scoreVal, labelText, colorClass, rubricText) in levels)
                                {
                                    var isChecked = item.Score == scoreVal;
                                    var radioId = $"score_{idx}_{scoreVal}";

                                    <div class="col-6 col-md">
                                        <input type="radio" class="btn-check" name="Items[@idx].Score" id="@radioId" value="@scoreVal"
                                               data-score="@scoreVal" @(isChecked ? "checked" : "") @(isSubmitted ? "disabled" : "") />
                                        <label class="btn btn-outline-secondary w-100 py-2.5 px-1 score-choice-label rounded-2 d-flex flex-column align-items-center justify-content-center text-center"
                                               for="@radioId" title="@rubricText" style="min-height: 52px; font-size: 0.78rem;">
                                            <span class="fw-bold fs-6">@scoreVal</span>
                                            <span class="small text-truncate" style="font-size: 0.7rem;">@labelText.Split(':')[1].Trim()</span>
                                        </label>
                                    </div>
                                }
                            </div>

                            <!-- Rubric Mô tả chi tiết khi hover hoặc click xem -->
                            @if (!string.IsNullOrWhiteSpace(item.Rubric1) || !string.IsNullOrWhiteSpace(item.Rubric5))
                            {
                                <div class="mt-2">
                                    <a class="text-decoration-none text-muted small" data-bs-toggle="collapse" href="#rubric-collapse-@idx" role="button" aria-expanded="false" style="font-size: 0.74rem;">
                                        <i class="bi bi-info-circle me-1"></i>Xem mô tả chi tiết thang Rubric của tiêu chí
                                    </a>
                                    <div class="collapse mt-2" id="rubric-collapse-@idx">
                                        <div class="p-2.5 bg-light rounded-2 border" style="font-size: 0.76rem;">
                                            <div class="row g-1">
                                                <div class="col-12"><b>Mức 1:</b> @(item.Rubric1 ?? "Cơ bản")</div>
                                                <div class="col-12"><b>Mức 3:</b> @(item.Rubric3 ?? "Thành thạo")</div>
                                                <div class="col-12"><b>Mức 5:</b> @(item.Rubric5 ?? "Chuyên gia dẫn dắt")</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- ── Ô Nhập Nhận xét & Minh chứng ── -->
                        <div class="mt-3">
                            <label class="form-label text-muted small fw-semibold" style="font-size: 0.74rem;">
                                <i class="bi bi-chat-left-text me-1"></i>Nhận xét & Minh chứng cụ thể
                            </label>
                            <textarea name="Items[@idx].Comment" class="form-control" rows="2" placeholder="Ghi chú điểm mạnh, điểm yếu hoặc dẫn chứng cụ thể cho tiêu chí này..."
                                      style="border-radius: 8px; font-size: 0.82rem;" @(isSubmitted ? "readonly" : "")>@item.Comment</textarea>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- ── Card Đề xuất & Tổng kết ── -->
        <div class="card border-0 shadow-sm rounded-3 mb-4" style="border: 1px solid #E2E8F0 !important;">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold text-dark mb-0">
                    <i class="bi bi-check2-all text-primary me-2"></i>Tổng kết & Kết luận Đánh giá
                </h5>
            </div>
            <div class="card-body p-3 p-md-4">
                <div class="row g-3">
                    <div class="col-12 col-md-5">
                        <label class="form-label fw-bold text-dark">
                            Đề xuất tuyển dụng <span class="text-danger">*</span>
                        </label>
                        <select name="OverallRecommendation" class="form-select form-select-lg rounded-2 fw-semibold" @(isSubmitted ? "disabled" : "") required>
                            <option value="">-- Chọn kết luận phỏng vấn --</option>
                            <option value="STRONG_HIRE" selected="@(Model.OverallRecommendation == "STRONG_HIRE")">🟢 KHUYẾN NGHỊ TUYỂN DỤNG CAO (Strong Hire)</option>
                            <option value="HIRE" selected="@(Model.OverallRecommendation == "HIRE")">🟢 ĐẠT YÊU CẦU - NÊN TUYỂN (Hire)</option>
                            <option value="CONSIDER" selected="@(Model.OverallRecommendation == "CONSIDER")">🟡 CẦN CÂN NHẮC / PHỎNG VẤN THÊM (Consider)</option>
                            <option value="STRONG_NO_HIRE" selected="@(Model.OverallRecommendation == "STRONG_NO_HIRE")">🔴 KHÔNG PHÙ HỢP - LOẠI (Strong No Hire)</option>
                        </select>
                        <div class="form-text small">Kết luận này làm căn cứ chính cho Hội đồng tuyển dụng và HR Manager ra quyết định.</div>
                    </div>

                    <div class="col-12 col-md-7">
                        <label class="form-label fw-bold text-dark">
                            Nhận xét tổng thể & Gợi ý lộ trình
                        </label>
                        <textarea name="GeneralNotes" class="form-control" rows="3" placeholder="Nhận xét chung về tác phong, mức độ phù hợp văn hóa, tiềm năng phát triển hoặc điều kiện đãi ngộ..."
                                  style="border-radius: 8px; font-size: 0.85rem;" @(isSubmitted ? "readonly" : "")>@Model.GeneralNotes</textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Thanh Nút Thao Tác (Action Bar) ── -->
        @if (!isSubmitted)
        {
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 pt-2 pb-4">
                <a href="/ung-vien/@Model.ApplicationId" class="btn btn-outline-secondary rounded-2 px-3">
                    <i class="bi bi-arrow-left me-1"></i>Quay lại hồ sơ
                </a>
                <div class="d-flex align-items-center gap-2 w-100 w-sm-auto justify-content-end">
                    <button type="button" id="btn-save-draft" class="btn btn-outline-primary rounded-2 px-3 flex-grow-1 flex-sm-grow-0">
                        <i class="bi bi-save me-1"></i>Lưu bản nháp
                    </button>
                    <button type="button" id="btn-submit-final" class="btn btn-success rounded-2 px-4 flex-grow-1 flex-sm-grow-0 fw-semibold text-white shadow-sm">
                        <i class="bi bi-send-check-fill me-1"></i>Nộp chính thức & Khóa phiếu
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex justify-content-between align-items-center pt-2 pb-4">
                <a href="/ung-vien/@Model.ApplicationId" class="btn btn-outline-secondary rounded-2 px-3">
                    <i class="bi bi-arrow-left me-1"></i>Quay lại hồ sơ
                </a>
                <span class="badge bg-light text-muted border px-3 py-2 rounded-2">
                    <i class="bi bi-lock-fill me-1 text-danger"></i>Phiếu đã khóa bất biến
                </span>
            </div>
        }
    </form>
</div>
