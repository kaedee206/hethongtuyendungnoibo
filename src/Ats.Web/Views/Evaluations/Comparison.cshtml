@model Ats.Web.Models.ViewModels.Evaluations.EvaluationSummaryComparisonViewModel
@{
    ViewData["Title"] = $"Bảng So Sánh Ứng Viên — {Model.JobTitle}";
    Layout = "_Layout";
}

<div class="container-fluid px-3 px-lg-4 py-3">

    <!-- ── Breadcrumb & Controls ── -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0" style="font-size: 0.85rem;">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted"><i class="bi bi-house-door me-1"></i>Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Jobs/Manage" class="text-decoration-none text-muted">Quản lý tin tuyển dụng</a></li>
                <li class="breadcrumb-item active fw-semibold text-dark" aria-current="page">Bảng so sánh ứng viên</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center gap-2">
            <a href="/Jobs/Manage" class="btn btn-sm btn-outline-secondary rounded-2">
                <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách tin
            </a>
            <button type="button" class="btn btn-sm btn-outline-primary rounded-2" onclick="window.print()">
                <i class="bi bi-printer me-1"></i>In bảng so sánh
            </button>
        </div>
    </div>

    <!-- ── Header Banner ── -->
    <div class="card border-0 shadow-sm rounded-3 mb-4" style="background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%); color: #F8FAFC;">
        <div class="card-body p-3 p-md-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <div>
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 rounded-2 fw-medium">
                            <i class="bi bi-briefcase-fill me-1"></i>Vị trí tuyển dụng
                        </span>
                        @if (!string.IsNullOrEmpty(Model.DepartmentName))
                        {
                            <span class="badge bg-light text-dark px-2.5 py-1 rounded-2 fw-medium">
                                <i class="bi bi-building me-1"></i>@Model.DepartmentName
                            </span>
                        }
                    </div>
                    <h3 class="fw-bold mb-1 text-white">@Model.JobTitle</h3>
                    <div class="text-slate-300 small" style="color: #94A3B8;">
                        <i class="bi bi-layers me-1 text-info"></i>Thước đo chuẩn hóa: <span class="fw-semibold text-white">@Model.FrameworkName</span> (Snapshot bất biến)
                    </div>
                </div>

                <div class="text-md-end">
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-2 fs-6">
                        <i class="bi bi-people-fill me-1"></i>Đã đánh giá: <b>@Model.Candidates.Count</b> ứng viên
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Thống kê nhanh (Quick KPI Cards) ── -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white" style="border: 1px solid #E2E8F0 !important; border-left: 4px solid #059669 !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase" style="font-size: 0.72rem;">ĐIỂM CAO NHẤT</div>
                        <div class="h2 fw-bold text-success mb-0 mt-1">@Model.HighestScore.ToString("F2") <span class="fs-6 text-muted">/ 5.0</span></div>
                    </div>
                    <div class="p-2.5 rounded-3 bg-success-subtle text-success">
                        <i class="bi bi-trophy-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white" style="border: 1px solid #E2E8F0 !important; border-left: 4px solid #2563EB !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase" style="font-size: 0.72rem;">ĐIỂM TRUNG BÌNH</div>
                        <div class="h2 fw-bold text-primary mb-0 mt-1">@Model.AverageScore.ToString("F2") <span class="fs-6 text-muted">/ 5.0</span></div>
                    </div>
                    <div class="p-2.5 rounded-3 bg-primary-subtle text-primary">
                        <i class="bi bi-bar-chart-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white" style="border: 1px solid #E2E8F0 !important; border-left: 4px solid #D97706 !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase" style="font-size: 0.72rem;">ĐIỂM THẤP NHẤT</div>
                        <div class="h2 fw-bold text-warning mb-0 mt-1">@Model.LowestScore.ToString("F2") <span class="fs-6 text-muted">/ 5.0</span></div>
                    </div>
                    <div class="p-2.5 rounded-3 bg-warning-subtle text-warning">
                        <i class="bi bi-graph-down fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Candidates.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-3 p-5 text-center bg-white" style="border: 1px solid #E2E8F0 !important;">
            <div class="py-4">
                <i class="bi bi-clipboard2-x text-muted" style="font-size: 3.5rem;"></i>
                <h5 class="fw-bold text-dark mt-3">Chưa có phiếu đánh giá nào được nộp cho vị trí này</h5>
                <p class="text-muted small mb-3">Khi Hội đồng phỏng vấn hoàn tất chấm điểm và nộp phiếu chính thức, bảng so sánh năng lực sẽ tự động hiển thị tại đây.</p>
                <a href="/Jobs/Manage" class="btn btn-outline-primary rounded-2 px-3">
                    <i class="bi bi-arrow-left me-1"></i>Quay lại Quản lý tuyển dụng
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- ── BẢNG MA TRẬN SO SÁNH (COMPARISON MATRIX) ── -->
        <div class="card border-0 shadow-sm rounded-3 bg-white overflow-hidden" style="border: 1px solid #E2E8F0 !important;">
            <div class="card-header bg-white py-3 px-3 px-md-4 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold text-dark mb-0">
                    <i class="bi bi-grid-3x3-gap-fill text-primary me-2"></i>Ma trận Đánh giá & Xếp hạng Ứng viên
                </h5>
                <span class="badge bg-light text-muted border px-2.5 py-1.5" style="font-size: 0.75rem;">
                    Sắp xếp theo Điểm tổng giảm dần
                </span>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0" style="min-width: 800px; font-size: 0.85rem;">
                    <thead class="table-light text-center" style="background-color: #F8FAFC;">
                        <tr>
                            <th class="text-start py-3 ps-3" style="width: 280px; min-width: 250px;">
                                <span class="fw-bold text-dark">Tiêu chí Năng lực & Trọng số</span>
                            </th>
                            @for (int cIdx = 0; cIdx < Model.Candidates.Count; cIdx++)
                            {
                                var cand = Model.Candidates[cIdx];
                                <th class="py-3 px-3 text-center" style="min-width: 200px;">
                                    <div class="d-flex flex-column align-items-center">
                                        <!-- Ranking Badge -->
                                        <div class="mb-1">
                                            @if (cIdx == 0)
                                            {
                                                <span class="badge bg-warning text-dark px-2 py-1 rounded-2 shadow-sm" style="font-size: 0.72rem;">
                                                    <i class="bi bi-trophy-fill me-1 text-warning"></i>HẠNG 1
                                                </span>
                                            }
                                            else if (cIdx == 1)
                                            {
                                                <span class="badge bg-secondary text-white px-2 py-1 rounded-2" style="font-size: 0.72rem;">
                                                    <i class="bi bi-award-fill me-1"></i>HẠNG 2
                                                </span>
                                            }
                                            else if (cIdx == 2)
                                            {
                                                <span class="badge bg-dark text-white px-2 py-1 rounded-2" style="font-size: 0.72rem;">
                                                    <i class="bi bi-award me-1"></i>HẠNG 3
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border px-2 py-1 rounded-2" style="font-size: 0.72rem;">
                                                    HẠNG @(cIdx + 1)
                                                </span>
                                            }
                                        </div>

                                        <a href="/ung-vien/@cand.ApplicationId" class="fw-bold text-dark text-decoration-none fs-6 mb-0 text-truncate" style="max-width: 180px;">
                                            @cand.CandidateName
                                        </a>
                                        <div class="text-muted small text-truncate" style="font-size: 0.72rem; max-width: 180px;">
                                            @cand.CandidateEmail
                                        </div>

                                        <div class="d-flex align-items-center gap-1 mt-1 text-muted small" style="font-size: 0.72rem;">
                                            <i class="bi bi-person-check text-secondary"></i>Người chấm: @cand.EvaluatorName
                                        </div>
                                    </div>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        <!-- ── DÒNG TỔNG KẾT: ĐIỂM TỔNG BÌNH QUÂN GIA QUYỀN ── -->
                        <tr class="table-primary border-bottom-2" style="background-color: #EFF6FF !important;">
                            <td class="ps-3 py-3 fw-bold text-primary">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-star-fill text-warning me-2 fs-5"></i>
                                    <div>
                                        <div class="fs-6">ĐIỂM TỔNG BÌNH QUÂN GIA QUYỀN</div>
                                        <div class="small text-muted fw-normal">Công thức chuẩn hóa: $\sum (Score \times Weight) / \sum Weight$</div>
                                    </div>
                                </div>
                            </td>
                            @foreach (var cand in Model.Candidates)
                            {
                                var badgeClass = cand.TotalScore >= 4.0m ? "bg-success" : (cand.TotalScore >= 3.0m ? "bg-primary" : "bg-danger");
                                <td class="text-center py-3">
                                    <div class="d-flex flex-column align-items-center">
                                        <span class="badge @badgeClass fs-5 px-3 py-2 rounded-2 text-white shadow-sm mb-1">
                                            @cand.TotalScore.ToString("F2") <span class="fs-6 fw-normal">/ 5.0</span>
                                        </span>
                                        <!-- Recommendation Badge -->
                                        @if (cand.Recommendation == "STRONG_HIRE")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-2" style="font-size: 0.72rem;">
                                                TUYỂN DỤNG CAO
                                            </span>
                                        }
                                        else if (cand.Recommendation == "HIRE")
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-2" style="font-size: 0.72rem;">
                                                ĐỀ XUẤT TUYỂN
                                            </span>
                                        }
                                        else if (cand.Recommendation == "CONSIDER")
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1 rounded-2" style="font-size: 0.72rem;">
                                                CẦN CÂN NHẮC
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 rounded-2" style="font-size: 0.72rem;">
                                                KHÔNG PHÙ HỢP
                                            </span>
                                        }
                                    </div>
                                </td>
                            }
                        </tr>

                        <!-- ── CÁC DÒNG TIÊU CHÍ NĂNG LỰC CHI TIẾT ── -->
                        @foreach (var header in Model.CriteriaHeaders)
                        {
                            <tr>
                                <td class="ps-3 py-2.5">
                                    <div class="fw-semibold text-dark">@header.CriteriaName</div>
                                    <div class="small text-muted" style="font-size: 0.75rem;">
                                        Trọng số đóng góp: <b>@header.Weight.ToString("G29")%</b>
                                    </div>
                                </td>
                                @foreach (var cand in Model.Candidates)
                                {
                                    var scoreItem = cand.CriteriaScores.FirstOrDefault(s => s.CriteriaName == header.CriteriaName);
                                    <td class="text-center py-2.5">
                                        @if (scoreItem != null)
                                        {
                                            var scoreColor = scoreItem.Score >= 4 ? "text-success" : (scoreItem.Score == 3 ? "text-primary" : "text-danger");
                                            <div class="fw-bold fs-6 @scoreColor">
                                                @scoreItem.Score <span class="small text-muted fw-normal">/ 5</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(scoreItem.Comment))
                                            {
                                                <div class="small text-muted text-truncate mt-0.5 fst-italic" style="font-size: 0.72rem; max-width: 170px;" title="@scoreItem.Comment">
                                                    "@scoreItem.Comment"
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }

                        <!-- ── DÒNG THAO TÁC / XEM CHI TIẾT ── -->
                        <tr class="table-light">
                            <td class="ps-3 py-3 fw-semibold text-muted">
                                Thao tác hồ sơ
                            </td>
                            @foreach (var cand in Model.Candidates)
                            {
                                <td class="text-center py-3">
                                    <div class="d-flex flex-column gap-1.5 align-items-center">
                                        <a href="/danh-gia/@cand.EvaluationFormId" class="btn btn-sm btn-outline-primary rounded-2 px-2.5 py-1" style="font-size: 0.76rem;" target="_blank">
                                            <i class="bi bi-file-earmark-text me-1"></i>Xem phiếu
                                        </a>
                                        <a href="/ung-vien/@cand.ApplicationId" class="btn btn-sm btn-light border rounded-2 px-2.5 py-1 text-muted" style="font-size: 0.74rem;">
                                            <i class="bi bi-person me-1"></i>Xem hồ sơ
                                        </a>
                                    </div>
                                </td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Footer ghi chú múi giờ và chuẩn hóa -->
            <div class="card-footer bg-light py-2 px-3 px-md-4 text-muted small d-flex flex-column flex-sm-row justify-content-between align-items-center" style="font-size: 0.75rem;">
                <div>
                    <i class="bi bi-clock-history me-1"></i>Dữ liệu cập nhật theo múi giờ: <b>Asia/Ho_Chi_Minh (UTC+7)</b>
                </div>
                <div>
                    <i class="bi bi-check-all text-success me-1"></i>Bảo đảm tính so sánh công bằng trên cùng một thang đo năng lực
                </div>
            </div>
        </div>
    }
</div>
