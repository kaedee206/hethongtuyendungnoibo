@model Ats.Web.Models.ViewModels.CandidateMerge.CandidateComparisonViewModel
@{
    ViewData["Title"] = "So sánh cạnh nhau & Gộp hồ sơ ứng viên - NoveraTech ATS";
    Layout = "_Layout";
}

<div class="container-fluid py-4 px-3 px-md-4" style="background-color: var(--bg-canvas, #F8FAFC); min-height: 100vh;">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1" style="font-size: 0.8rem;">
                    <li class="breadcrumb-item"><a href="/dashboard" class="text-decoration-none text-muted">Bàn làm việc</a></li>
                    <li class="breadcrumb-item"><a href="/dashboard/trung-lap" class="text-decoration-none text-muted">Trùng lặp hồ sơ</a></li>
                    <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">So sánh &amp; Gộp hồ sơ</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold text-dark mb-1" style="letter-spacing: -0.02em;">
                <i class="bi bi-layout-split text-emerald me-2" style="color: #059669;"></i>So sánh cạnh nhau trước khi gộp
            </h1>
            <p class="text-muted small mb-0">
                Đối chiếu chi tiết lý lịch, đợt ứng tuyển và lịch phỏng vấn giữa hai hồ sơ để quyết định phương án gộp tối ưu.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="/dashboard/trung-lap" class="btn btn-outline-secondary btn-sm fw-semibold" style="border-radius: 8px;">
                <i class="bi bi-arrow-left me-1"></i>Hủy &amp; Quay lại
            </a>
            <button type="button" class="btn btn-outline-primary btn-sm fw-semibold" style="border-radius: 8px;" onclick="swapPrimarySecondary()">
                <i class="bi bi-arrow-left-right me-1"></i>Đổi vị trí hồ sơ chính
            </button>
        </div>
    </div>

    <!-- Alert Cảnh báo lý do trùng & xung đột nếu có -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; background: #FFFFFF; border: 1px solid #E2E8F0;">
        <div class="card-body p-3.5 d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px; background: #FEF3C7; color: #D97706;">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark" style="font-size: 0.95rem;">Lý do phát hiện trùng: @Model.DuplicateReason</div>
                    @if (Model.HasConflictingActiveApplications)
                    {
                        <div class="text-warning-emphasis small mt-0.5">
                            <i class="bi bi-info-circle me-1"></i>@Model.ConflictWarningMessage
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small mt-0.5">Hai hồ sơ có thông tin định danh tương đồng cao. Khi gộp, toàn bộ đơn ứng tuyển và CV sẽ được gom về một hồ sơ duy nhất.</div>
                    }
                </div>
            </div>
            <div class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2" style="border-radius: 8px; font-size: 0.8rem;">
                <i class="bi bi-clock-history me-1"></i>Cho phép hoàn tác trong 24 giờ
            </div>
        </div>
    </div>

    <!-- BẢNG SO SÁNH CẠNH NHAU 2 CỘT -->
    <form id="mergeCandidateForm" onsubmit="handleMergeSubmit(event)">
        @Html.AntiForgeryToken()
        <input type="hidden" id="inputPrimaryId" name="PrimaryCandidateId" value="@Model.PrimaryCandidate.CandidateId" />
        <input type="hidden" id="inputSecondaryId" name="SecondaryCandidateId" value="@Model.SecondaryCandidate.CandidateId" />

        <div class="row g-4 mb-4">
            <!-- CỘT 1: HỒ SƠ A (MẶC ĐỊNH LÀ PRIMARY) -->
            <div class="col-lg-6" id="cardCandidate1">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; background: #FFFFFF; border: 2px solid #059669 !important;">
                    <div class="card-header bg-emerald-subtle py-3 px-3.5 border-bottom d-flex justify-content-between align-items-center" style="border-top-left-radius: 10px; border-top-right-radius: 10px;">
                        <div class="d-flex align-items-center gap-2">
                            <input class="form-check-input mt-0" type="radio" name="choosePrimaryRadio" id="radioChoose1" checked onchange="setPrimary(1)" style="cursor: pointer;">
                            <label class="form-check-label fw-bold text-success mb-0" for="radioChoose1" style="font-size: 0.9rem; cursor: pointer;">
                                <i class="bi bi-check-circle-fill me-1"></i>HỒ SƠ CHÍNH (GIỮ LẠI)
                            </label>
                        </div>
                        <span class="badge bg-white text-muted border" style="font-size: 0.72rem;">Tạo ngày: @Model.PrimaryCandidate.CreatedAtDisplay</span>
                    </div>

                    <div class="card-body p-3.5">
                        <!-- Thông tin định danh -->
                        <div class="d-flex align-items-center gap-3 mb-3.5 pb-3 border-bottom">
                            <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold"
                                 style="width: 48px; height: 48px; background: #0F172A; font-size: 1.1rem;">
                                @(string.IsNullOrEmpty(Model.PrimaryCandidate.FullName) ? "?" : Model.PrimaryCandidate.FullName[..1].ToUpper())
                            </div>
                            <div>
                                <h5 class="fw-bold text-dark mb-0.5">@Model.PrimaryCandidate.FullName</h5>
                                <div class="text-muted small">@(!string.IsNullOrWhiteSpace(Model.PrimaryCandidate.CurrentTitle) ? Model.PrimaryCandidate.CurrentTitle : "Chưa cập nhật chức danh")</div>
                            </div>
                        </div>

                        <!-- Chi tiết liên lạc & lý lịch -->
                        <div class="d-flex flex-column gap-2.5 mb-4 pb-3 border-bottom" style="font-size: 0.85rem;">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted"><i class="bi bi-envelope me-1.5"></i>Email:</span>
                                <span class="fw-semibold text-dark" style="font-family:'JetBrains Mono',monospace;">@Model.PrimaryCandidate.Email</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted"><i class="bi bi-telephone me-1.5"></i>Số điện thoại:</span>
                                <span class="fw-semibold text-dark" style="font-family:'JetBrains Mono',monospace;">@(string.IsNullOrWhiteSpace(Model.PrimaryCandidate.Phone) ? "Chưa có SĐT" : Model.PrimaryCandidate.Phone)</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted"><i class="bi bi-building me-1.5"></i>Công ty:</span>
                                <span class="text-dark">@(string.IsNullOrWhiteSpace(Model.PrimaryCandidate.CurrentCompany) ? "Chưa cập nhật" : Model.PrimaryCandidate.CurrentCompany)</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted"><i class="bi bi-geo-alt me-1.5"></i>Địa chỉ:</span>
                                <span class="text-dark">@(string.IsNullOrWhiteSpace(Model.PrimaryCandidate.Address) ? "Chưa cập nhật" : Model.PrimaryCandidate.Address)</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted"><i class="bi bi-share me-1.5"></i>Nguồn hồ sơ:</span>
                                <span class="badge bg-light text-muted border">@Model.PrimaryCandidate.SourceName</span>
                            </div>
                        </div>

                        <!-- Danh sách CV đính kèm -->
                        <div class="mb-4 pb-3 border-bottom">
                            <h6 class="fw-bold text-dark mb-2.5" style="font-size: 0.85rem;">
                                <i class="bi bi-file-earmark-pdf me-1.5 text-danger"></i>Danh sách CV đính kèm (@Model.PrimaryCandidate.Resumes.Count)
                            </h6>
                            @if (!Model.PrimaryCandidate.Resumes.Any())
                            {
                                <div class="text-muted small fst-italic">Chưa có CV nào được tải lên.</div>
                            }
                            else
                            {
                                <div class="d-flex flex-column gap-1.5">
                                    @foreach (var cv in Model.PrimaryCandidate.Resumes)
                                    {
                                        <div class="d-flex justify-content-between align-items-center p-2 rounded" style="background: #F8FAFC; border: 1px solid #E2E8F0; font-size: 0.8rem;">
                                            <div class="text-truncate me-2">
                                                <i class="bi bi-file-text me-1 text-primary"></i><strong>@cv.FileName</strong>
                                                <span class="text-muted ms-1" style="font-size: 0.72rem;">(@cv.CreatedAtDisplay)</span>
                                            </div>
                                            <div class="flex-shrink-0">
                                                @if (cv.IsPrimary) { <span class="badge bg-success-subtle text-success me-1">Chính</span> }
                                                <a href="@cv.FilePath" target="_blank" class="btn btn-link btn-sm p-0 text-decoration-none" title="Tải/Xem CV">
                                                    <i class="bi bi-box-arrow-up-right"></i>
                                                </a>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Lịch sử các đợt ứng tuyển & phỏng vấn -->
                        <div>
                            <h6 class="fw-bold text-dark mb-2.5" style="font-size: 0.85rem;">
                                <i class="bi bi-clock-history me-1.5 text-primary"></i>Lịch sử ứng tuyển &amp; Phỏng vấn (@Model.PrimaryCandidate.Applications.Count)
                            </h6>
                            @if (!Model.PrimaryCandidate.Applications.Any())
                            {
                                <div class="text-muted small fst-italic">Chưa có đơn ứng tuyển nào.</div>
                            }
                            else
                            {
                                <div class="d-flex flex-column gap-2">
                                    @foreach (var app in Model.PrimaryCandidate.Applications)
                                    {
                                        <div class="p-2.5 rounded" style="background: #F8FAFC; border: 1px solid #E2E8F0; font-size: 0.82rem;">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <div class="fw-bold text-dark">@app.JobTitle</div>
                                                <span class="badge @app.StatusBadgeClass">@app.StageName</span>
                                            </div>
                                            <div class="text-muted small mb-1.5">
                                                <span>@app.DepartmentName</span> • <span>Mã: <code class="text-dark">@app.TrackingCode</code></span> • <span>Ngày nộp: @app.AppliedAtDisplay</span>
                                            </div>
                                            @if (app.Interviews.Any())
                                            {
                                                <div class="pt-1.5 border-top d-flex flex-column gap-1" style="font-size: 0.76rem;">
                                                    @foreach (var iv in app.Interviews)
                                                    {
                                                        <div class="d-flex justify-content-between text-muted">
                                                            <span><i class="bi bi-calendar2-check me-1"></i>@iv.RoundTitle: @iv.Title</span>
                                                            <span class="badge bg-light text-muted border">@iv.StatusDisplay</span>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- CỘT 2: HỒ SƠ B (MẶC ĐỊNH LÀ SECONDARY - BỊ GỘP) -->
            <div class="col-lg-6" id="cardCandidate2">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; background: #FFFFFF; border: 1px solid #E2E8F0;">
                    <div class="card-header bg-light py-3 px-3.5 border-bottom d-flex justify-content-between align-items-center" style="border-top-left-radius: 10px; border-top-right-radius: 10px;">
                        <div class="d-flex align-items-center gap-2">
                            <input class="form-check-input mt-0" type="radio" name="choosePrimaryRadio" id="radioChoose2" onchange="setPrimary(2)" style="cursor: pointer;">
                            <label class="form-check-label fw-bold text-muted mb-0" for="radioChoose2" style="font-size: 0.9rem; cursor: pointer;">
                                HỒ SƠ PHỤ (SẼ GỘP VÀO HỒ SƠ CHÍNH)
                            </label>
                        </div>
                        <span class="badge bg-white text-muted border" style="font-size: 0.72rem;">Tạo ngày: @Model.SecondaryCandidate.CreatedAtDisplay</span>
                    </div>

                    <div class="card-body p-3.5">
                        <!-- Thông tin định danh -->
                        <div class="d-flex align-items-center gap-3 mb-3.5 pb-3 border-bottom">
                            <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold"
                                 style="width: 48px; height: 48px; background: #475569; font-size: 1.1rem;">
                                @(string.IsNullOrEmpty(Model.SecondaryCandidate.FullName) ? "?" : Model.SecondaryCandidate.FullName[..1].ToUpper())
                            </div>
                            <div>
                                <h5 class="fw-bold text-dark mb-0.5">@Model.SecondaryCandidate.FullName</h5>
                                <div class="text-muted small">@(!string.IsNullOrWhiteSpace(Model.SecondaryCandidate.CurrentTitle) ? Model.SecondaryCandidate.CurrentTitle : "Chưa cập nhật chức danh")</div>
                            </div>
                        </div>

                        <!-- Chi tiết liên lạc & lý lịch -->
                        <div class="d-flex flex-column gap-2.5 mb-4 pb-3 border-bottom" style="font-size: 0.85rem;">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted"><i class="bi bi-envelope me-1.5"></i>Email:</span>
                                <span class="fw-semibold text-dark" style="font-family:'JetBrains Mono',monospace;">@Model.SecondaryCandidate.Email</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted"><i class="bi bi-telephone me-1.5"></i>Số điện thoại:</span>
                                <span class="fw-semibold text-dark" style="font-family:'JetBrains Mono',monospace;">@(string.IsNullOrWhiteSpace(Model.SecondaryCandidate.Phone) ? "Chưa có SĐT" : Model.SecondaryCandidate.Phone)</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted"><i class="bi bi-building me-1.5"></i>Công ty:</span>
                                <span class="text-dark">@(string.IsNullOrWhiteSpace(Model.SecondaryCandidate.CurrentCompany) ? "Chưa cập nhật" : Model.SecondaryCandidate.CurrentCompany)</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted"><i class="bi bi-geo-alt me-1.5"></i>Địa chỉ:</span>
                                <span class="text-dark">@(string.IsNullOrWhiteSpace(Model.SecondaryCandidate.Address) ? "Chưa cập nhật" : Model.SecondaryCandidate.Address)</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted"><i class="bi bi-share me-1.5"></i>Nguồn hồ sơ:</span>
                                <span class="badge bg-light text-muted border">@Model.SecondaryCandidate.SourceName</span>
                            </div>
                        </div>

                        <!-- Danh sách CV đính kèm -->
                        <div class="mb-4 pb-3 border-bottom">
                            <h6 class="fw-bold text-dark mb-2.5" style="font-size: 0.85rem;">
                                <i class="bi bi-file-earmark-pdf me-1.5 text-danger"></i>Danh sách CV đính kèm (@Model.SecondaryCandidate.Resumes.Count)
                            </h6>
                            @if (!Model.SecondaryCandidate.Resumes.Any())
                            {
                                <div class="text-muted small fst-italic">Chưa có CV nào được tải lên.</div>
                            }
                            else
                            {
                                <div class="d-flex flex-column gap-1.5">
                                    @foreach (var cv in Model.SecondaryCandidate.Resumes)
                                    {
                                        <div class="d-flex justify-content-between align-items-center p-2 rounded" style="background: #F8FAFC; border: 1px solid #E2E8F0; font-size: 0.8rem;">
                                            <div class="text-truncate me-2">
                                                <i class="bi bi-file-text me-1 text-primary"></i><strong>@cv.FileName</strong>
                                                <span class="text-muted ms-1" style="font-size: 0.72rem;">(@cv.CreatedAtDisplay)</span>
                                            </div>
                                            <div class="flex-shrink-0">
                                                <span class="badge bg-warning-subtle text-warning-emphasis me-1">Sẽ chuyển sang hồ sơ chính</span>
                                                <a href="@cv.FilePath" target="_blank" class="btn btn-link btn-sm p-0 text-decoration-none" title="Tải/Xem CV">
                                                    <i class="bi bi-box-arrow-up-right"></i>
                                                </a>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Lịch sử các đợt ứng tuyển & phỏng vấn -->
                        <div>
                            <h6 class="fw-bold text-dark mb-2.5" style="font-size: 0.85rem;">
                                <i class="bi bi-clock-history me-1.5 text-primary"></i>Lịch sử ứng tuyển &amp; Phỏng vấn (@Model.SecondaryCandidate.Applications.Count)
                            </h6>
                            @if (!Model.SecondaryCandidate.Applications.Any())
                            {
                                <div class="text-muted small fst-italic">Chưa có đơn ứng tuyển nào.</div>
                            }
                            else
                            {
                                <div class="d-flex flex-column gap-2">
                                    @foreach (var app in Model.SecondaryCandidate.Applications)
                                    {
                                        <div class="p-2.5 rounded" style="background: #F8FAFC; border: 1px solid #E2E8F0; font-size: 0.82rem;">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <div class="fw-bold text-dark">@app.JobTitle</div>
                                                <span class="badge @app.StatusBadgeClass">@app.StageName</span>
                                            </div>
                                            <div class="text-muted small mb-1.5">
                                                <span>@app.DepartmentName</span> • <span>Mã: <code class="text-dark">@app.TrackingCode</code></span> • <span>Ngày nộp: @app.AppliedAtDisplay</span>
                                            </div>
                                            @if (app.Interviews.Any())
                                            {
                                                <div class="pt-1.5 border-top d-flex flex-column gap-1" style="font-size: 0.76rem;">
                                                    @foreach (var iv in app.Interviews)
                                                    {
                                                        <div class="d-flex justify-content-between text-muted">
                                                            <span><i class="bi bi-calendar2-check me-1"></i>@iv.RoundTitle: @iv.Title</span>
                                                            <span class="badge bg-light text-muted border">@iv.StatusDisplay</span>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Khối cấu hình tùy chọn giữ lại thông tin & cam kết an toàn -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; background: #FFFFFF; border: 1px solid #E2E8F0;">
            <div class="card-header bg-white py-3 px-3.5 border-bottom">
                <h6 class="fw-bold text-dark mb-0" style="font-size: 0.95rem;">
                    <i class="bi bi-sliders me-1.5 text-primary"></i>Tùy chọn trường thông tin ưu tiên giữ lại cho Hồ sơ chính
                </h6>
            </div>
            <div class="card-body p-3.5">
                <div class="row g-3 mb-3" style="font-size: 0.85rem;">
                    <div class="col-md-4">
                        <label class="form-label text-muted small fw-semibold">Ưu tiên Số điện thoại:</label>
                        <select class="form-select form-select-sm" name="KeepPhone" style="border-radius: 8px;">
                            <option value="primary" selected>Giữ SĐT của Hồ sơ chính (@Model.PrimaryCandidate.Phone)</option>
                            <option value="secondary">Lấy SĐT của Hồ sơ phụ (@Model.SecondaryCandidate.Phone)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted small fw-semibold">Ưu tiên Họ &amp; Tên:</label>
                        <select class="form-select form-select-sm" name="KeepName" style="border-radius: 8px;">
                            <option value="primary" selected>Giữ Họ tên Hồ sơ chính (@Model.PrimaryCandidate.FullName)</option>
                            <option value="secondary">Lấy Họ tên Hồ sơ phụ (@Model.SecondaryCandidate.FullName)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted small fw-semibold">Ghi chú lý do gộp:</label>
                        <input type="text" class="form-control form-control-sm" name="Reason" placeholder="Ví dụ: Trùng SĐT 0912..., cùng một ứng viên" style="border-radius: 8px;" />
                    </div>
                </div>

                <div class="alert alert-light border py-2.5 px-3 small mb-0 d-flex align-items-center gap-2" style="border-radius: 8px; color: #475569;">
                    <i class="bi bi-shield-lock-fill text-success fs-5"></i>
                    <div>
                        <strong>Cam kết bảo toàn dữ liệu:</strong> Toàn bộ @(Model.PrimaryCandidate.Applications.Count + Model.SecondaryCandidate.Applications.Count) đợt ứng tuyển và @(Model.PrimaryCandidate.Resumes.Count + Model.SecondaryCandidate.Resumes.Count) CV sẽ được gộp nguyên vẹn vào hồ sơ chính. Bạn có quyền hoàn tác trong 24 giờ kể từ lúc xác nhận.
                    </div>
                </div>
            </div>
            <div class="card-footer bg-white border-top py-3 px-3.5 d-flex justify-content-between align-items-center">
                <a href="/dashboard/trung-lap" class="btn btn-outline-secondary btn-sm fw-semibold" style="border-radius: 8px;">
                    Hủy bỏ
                </a>
                <button type="submit" id="btnSubmitMerge" class="btn btn-primary btn-sm fw-bold px-4" style="border-radius: 8px; background: #059669; border-color: #059669; padding: 0.45rem 1.25rem;">
                    <i class="bi bi-check2-circle me-1.5"></i>Xác nhận Gộp 2 Hồ sơ
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
<script>
    let isReversed = false;
    const cand1Id = '@Model.PrimaryCandidate.CandidateId';
    const cand2Id = '@Model.SecondaryCandidate.CandidateId';

    function setPrimary(choice) {
        if (choice === 1) {
            document.getElementById('inputPrimaryId').value = cand1Id;
            document.getElementById('inputSecondaryId').value = cand2Id;
            updateCardHighlight(1);
        } else {
            document.getElementById('inputPrimaryId').value = cand2Id;
            document.getElementById('inputSecondaryId').value = cand1Id;
            updateCardHighlight(2);
        }
    }

    function swapPrimarySecondary() {
        isReversed = !isReversed;
        if (isReversed) {
            document.getElementById('radioChoose2').checked = true;
            setPrimary(2);
        } else {
            document.getElementById('radioChoose1').checked = true;
            setPrimary(1);
        }
    }

    function updateCardHighlight(primaryIndex) {
        const c1 = document.getElementById('cardCandidate1').firstElementChild;
        const c2 = document.getElementById('cardCandidate2').firstElementChild;
        if (primaryIndex === 1) {
            c1.style.border = '2px solid #059669';
            c2.style.border = '1px solid #E2E8F0';
        } else {
            c2.style.border = '2px solid #059669';
            c1.style.border = '1px solid #E2E8F0';
        }
    }

    async function handleMergeSubmit(e) {
        e.preventDefault();
        const form = document.getElementById('mergeCandidateForm');
        const btn = document.getElementById('btnSubmitMerge');

        if (!confirm('Bạn có chắc chắn muốn gộp 2 hồ sơ này? Toàn bộ lịch sử ứng tuyển sẽ được gom về hồ sơ chính và có thể hoàn tác trong vòng 24 giờ.')) {
            return;
        }

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1.5"></span>Đang gộp hồ sơ...';

        const formData = new FormData(form);

        try {
            const res = await fetch('/Workspace/GopHoSo', {
                method: 'POST',
                body: formData
            });
            const data = await res.json();

            if (data.success) {
                alert(data.message || 'Gộp hồ sơ thành công!');
                window.location.href = data.redirectUrl || '/dashboard/trung-lap';
            } else {
                alert(data.message || 'Có lỗi xảy ra khi gộp hồ sơ.');
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check2-circle me-1.5"></i>Xác nhận Gộp 2 Hồ sơ';
            }
        } catch (err) {
            console.error(err);
            alert('Không thể kết nối đến máy chủ. Vui lòng thử lại sau.');
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-check2-circle me-1.5"></i>Xác nhận Gộp 2 Hồ sơ';
        }
    }
</script>
}
