@model Ats.Web.Models.ViewModels.CompetencyFrameworks.CompetencyFrameworkListViewModel
@{
    ViewData["Title"] = "Danh mục Khung năng lực chuẩn";
    var isFiltered = !string.IsNullOrWhiteSpace(Model.Keyword) || (!string.IsNullOrWhiteSpace(Model.StatusFilter) && Model.StatusFilter != "ALL");
    var canManage = (bool)(ViewBag.CanManage ?? false);
}

<div class="container-fluid px-3 px-md-4 py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0" style="font-size: 0.85rem;">
            <li class="breadcrumb-item"><a href="/dashboard" class="text-decoration-none text-muted">Bàn làm việc</a></li>
            <li class="breadcrumb-item"><span class="text-muted">Cơ cấu &amp; Tiêu chuẩn</span></li>
            <li class="breadcrumb-item active text-emerald-700 fw-semibold" aria-current="page">Khung năng lực</li>
        </ol>
    </nav>

    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge px-2.5 py-1 fw-semibold text-uppercase" 
                      style="font-size: 0.72rem; letter-spacing: 0.05em; background: #ECFDF5; color: #047857; border: 1px solid #A7F3D0; border-radius: 6px;">
                    <i class="bi bi-diagram-3-fill me-1"></i>Định chuẩn Nhân sự
                </span>
                <h1 class="h3 fw-bold text-slate-900 mb-0" style="color: #0F172A;">Khung Năng lực Chuẩn</h1>
            </div>
            <p class="text-muted small mb-0">
                Hệ thống tiêu chuẩn năng lực, kỹ năng chuyên môn và các chức danh vị trí áp dụng.
            </p>
        </div>

        <div class="mobile-action-bar align-items-center gap-2">
            <a href="/job-positions" class="btn btn-outline-secondary btn-sm px-3 py-2 d-inline-flex align-items-center gap-1.5 shadow-xs" style="border-radius: 8px;">
                <i class="bi bi-person-badge"></i>
                <span class="fw-semibold">Danh mục Chức danh</span>
            </a>
            @if (canManage)
            {
                <a asp-action="Create" class="btn btn-success btn-sm d-inline-flex align-items-center gap-1.5 px-3.5 py-2 shadow-sm fw-semibold" style="border-radius: 8px; background-color: #059669; border-color: #059669;">
                    <i class="bi bi-plus-lg"></i>
                    <span>Tạo mới Khung năng lực</span>
                </a>
            }
        </div>
    </div>



    <!-- 4 Summary KPI cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm p-3 bg-white h-100" style="border-radius: 12px; border: 1px solid #E2E8F0 !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-medium" style="font-size: 0.78rem;">Tổng số khung năng lực</span>
                        <h3 class="fw-bold font-monospace text-slate-900 mb-0 mt-1" style="font-family: 'JetBrains Mono', monospace; color: #0F172A;">@Model.TotalRecords</h3>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background-color: #F1F5F9; color: #475569; font-size: 1.25rem;">
                        <i class="bi bi-collection-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm p-3 bg-white h-100" style="border-radius: 12px; border: 1px solid #E2E8F0 !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-medium" style="font-size: 0.78rem;">Đang sử dụng</span>
                        <h3 class="fw-bold font-monospace text-emerald-600 mb-0 mt-1" style="font-family: 'JetBrains Mono', monospace;">@Model.TotalActiveFrameworks</h3>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background-color: #ECFDF5; color: #059669; font-size: 1.25rem;">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm p-3 bg-white h-100" style="border-radius: 12px; border: 1px solid #E2E8F0 !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-medium" style="font-size: 0.78rem;">Ngừng sử dụng</span>
                        <h3 class="fw-bold font-monospace text-secondary mb-0 mt-1" style="font-family: 'JetBrains Mono', monospace;">@Model.TotalInactiveFrameworks</h3>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center bg-light text-muted" style="width: 44px; height: 44px; font-size: 1.25rem;">
                        <i class="bi bi-slash-circle"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm p-3 bg-white h-100" style="border-radius: 12px; border: 1px solid #E2E8F0 !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-medium" style="font-size: 0.78rem;">Chức danh đang áp dụng</span>
                        <h3 class="fw-bold font-monospace text-primary mb-0 mt-1" style="font-family: 'JetBrains Mono', monospace; color: #2563EB;">@Model.TotalPositionsMapped</h3>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center bg-primary-subtle text-primary" style="width: 44px; height: 44px; font-size: 1.25rem;">
                        <i class="bi bi-briefcase-fill"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Form -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; border: 1px solid #E2E8F0 !important;">
        <div class="card-body p-3 p-md-3">
            <form id="frameworkFilterForm" method="get" asp-action="Index" class="row g-2.5 align-items-end">
                <div class="col-12 col-md-5">
                    <label class="form-label small fw-semibold text-muted mb-1" style="font-size: 0.8rem;">Tìm kiếm khung năng lực</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0 text-muted" style="border-radius: 6px 0 0 6px;">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" name="keyword" value="@Model.Keyword" class="form-control bg-light border-start-0" placeholder="Nhập mã hoặc tên khung năng lực..." style="border-radius: 0 6px 6px 0; font-size: 0.85rem;">
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1" style="font-size: 0.8rem;">Trạng thái</label>
                    <select name="status" class="form-select form-select-sm bg-light" style="border-radius: 6px; font-size: 0.85rem;">
                        <option value="ALL" selected="@(Model.StatusFilter == "ALL" || string.IsNullOrEmpty(Model.StatusFilter))">Tất cả trạng thái</option>
                        <option value="ACTIVE" selected="@(Model.StatusFilter == "ACTIVE")">Đang sử dụng</option>
                        <option value="INACTIVE" selected="@(Model.StatusFilter == "INACTIVE")">Ngừng sử dụng</option>
                    </select>
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold text-muted mb-1" style="font-size: 0.8rem;">Hiển thị</label>
                    <select name="pageSize" class="form-select form-select-sm bg-light" style="border-radius: 6px; font-size: 0.85rem;">
                        <option value="15" selected="@(Model.PageSize == 15)">15 bản ghi</option>
                        <option value="25" selected="@(Model.PageSize == 25)">25 bản ghi</option>
                        <option value="50" selected="@(Model.PageSize == 50)">50 bản ghi</option>
                        <option value="100" selected="@(Model.PageSize == 100)">100 bản ghi</option>
                    </select>
                </div>

                <div class="col-12 col-md-2 d-flex gap-2">
                    <button id="filterSubmitBtn" type="submit" class="btn btn-dark btn-sm w-100 fw-semibold" style="border-radius: 6px;">
                        <i class="bi bi-funnel me-1"></i> Lọc
                    </button>
                    <a id="filterResetBtn" asp-action="Index" class="btn btn-outline-secondary btn-sm" style="border-radius: 6px;" title="Đặt lại bộ lọc">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm position-relative overflow-hidden mb-4" style="border-radius: 12px; border: 1px solid #E2E8F0 !important;">
        <div id="tableLoadingState" class="position-absolute top-0 start-0 w-100 h-100 d-none flex-column align-items-center justify-content-center" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(2px); z-index: 15; min-height: 220px;" role="status" aria-live="polite">
            <div class="spinner-border text-success mb-2" role="status" style="width: 2.2rem; height: 2.2rem; color: #059669 !important;"></div>
            <div class="fw-semibold text-dark small">Đang tải dữ liệu khung năng lực...</div>
            <div class="text-muted small" style="font-size: 0.75rem;">Vui lòng đợi trong giây lát</div>
        </div>

        <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
            <span class="fw-semibold text-slate-900" style="color: #0F172A; font-size: 0.95rem;">
                Danh sách khung năng lực 
                <span class="badge ms-1 font-monospace" style="border-radius: 6px; background-color: #F1F5F9; color: #475569; border: 1px solid #E2E8F0; font-family: 'JetBrains Mono', monospace;">
                    @Model.TotalRecords bản ghi
                </span>
            </span>
            <span class="small text-muted">Bộ tiêu chuẩn định ngạch &amp; đánh giá kỹ thuật</span>
        </div>

        <div class="ats-mobile-table-hint px-3 pt-2"><i class="bi bi-arrow-left-right"></i> Vuốt ngang để xem đủ tiêu chí, chức danh & thao tác</div>
        <div class="ats-mobile-table-wrapper table-responsive mb-0">
            <table class="table table-hover align-middle mb-0" style="min-width: 820px;">
                <thead style="background: #F8FAFC; border-bottom: 1px solid #E2E8F0; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #64748B;">
                    <tr>
                        <th class="ps-4 py-3 text-nowrap" style="width: 130px;">Mã khung</th>
                        <th class="py-3 text-nowrap" style="min-width: 320px;">Tên khung năng lực</th>
                        <th class="py-3 text-center text-nowrap" style="width: 130px;">Tiêu chí</th>
                        <th class="py-3 text-center text-nowrap" style="width: 170px;">Chức danh áp dụng</th>
                        <th class="py-3 text-center text-nowrap" style="width: 140px;">Trạng thái</th>
                        <th class="text-end pe-4 py-3 text-nowrap" style="width: 110px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Frameworks == null || !Model.Frameworks.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                @if (isFiltered)
                                {
                                    <div class="py-4 px-3 text-center">
                                        <div class="d-inline-flex align-items-center justify-content-center p-3 rounded-circle bg-light mb-3 text-muted" style="width: 60px; height: 60px;">
                                            <i class="bi bi-search fs-4"></i>
                                        </div>
                                        <h6 class="fw-bold text-dark mb-1">Không tìm thấy kết quả phù hợp</h6>
                                        <p class="text-muted small mb-3">Không có khung năng lực nào khớp với tiêu chí tìm kiếm hiện tại.</p>
                                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary px-3" style="border-radius: 8px;">
                                            <i class="bi bi-arrow-counterclockwise me-1"></i> Đặt lại bộ lọc
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <div class="py-4 px-3 text-center">
                                        <div class="d-inline-flex align-items-center justify-content-center p-3 rounded-circle bg-light mb-3 text-muted" style="width: 60px; height: 60px;">
                                            <i class="bi bi-diagram-3 fs-4"></i>
                                        </div>
                                        <h6 class="fw-bold text-dark mb-1">Chưa có khung năng lực</h6>
                                        <p class="text-muted small mb-0">Hệ thống chưa ghi nhận dữ liệu khung năng lực nào.</p>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var fw in Model.Frameworks)
                        {
                            var serializedPositions = System.Text.Json.JsonSerializer.Serialize(fw.AssociatedJobPositions);
                            <tr>
                                <td class="ps-4">
                                    <a asp-action="Details" asp-route-id="@fw.Id" 
                                       class="badge bg-light text-slate-800 border font-monospace px-2.5 py-1.5 text-decoration-none" 
                                       style="border-radius: 6px; font-size: 0.82rem; font-family: 'JetBrains Mono', monospace;" 
                                       title="Xem chi tiết khung @fw.Code">
                                        @fw.Code
                                    </a>
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@fw.Id" 
                                       class="fw-semibold text-slate-900 text-decoration-none d-block hover-emerald" 
                                       style="color: #0F172A; font-size: 0.92rem;">
                                        @fw.Name
                                    </a>
                                </td>
                                <td class="text-center font-monospace">
                                    <span class="badge bg-light text-slate-700 border px-2.5 py-1" style="border-radius: 6px; font-family: 'JetBrains Mono', monospace; font-size: 0.8rem;">
                                        @fw.CompetenciesCount tiêu chí
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (fw.AssociatedJobPositionsCount > 0)
                                    {
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-1.5 view-positions-btn px-2.5 py-1" 
                                                style="border-radius: 6px; font-size: 0.8rem;"
                                                data-bs-toggle="modal" 
                                                data-bs-target="#frameworkPositionsModal"
                                                data-framework-code="@fw.Code"
                                                data-framework-name="@fw.Name"
                                                data-positions='@serializedPositions'>
                                            <i class="bi bi-briefcase-fill"></i>
                                            <span class="fw-semibold">@fw.AssociatedJobPositionsCount chức danh</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border px-2 py-1" style="border-radius: 6px; font-size: 0.78rem;">
                                            Chưa áp dụng
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (fw.IsActive)
                                    {
                                        <span class="badge bg-emerald-50 text-emerald-700 border border-emerald-200 px-2 py-1" style="border-radius: 6px; font-size: 0.78rem;">
                                            <i class="bi bi-check-circle-fill me-1"></i>Đang sử dụng
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-slate-100 text-slate-500 border border-slate-200 px-2 py-1" style="border-radius: 6px; font-size: 0.78rem;">
                                            Ngừng sử dụng
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <!-- Compact Action Group -->
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <a asp-action="Details" asp-route-id="@fw.Id"
                                           class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center px-2 py-1"
                                           style="border-radius: 6px; font-size: 0.8rem;" title="Xem chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @if (canManage)
                                        {
                                            <div class="dropdown d-inline-block">
                                                <button class="btn btn-sm btn-light border py-1 px-1.5 text-muted shadow-xs" 
                                                        type="button" 
                                                        data-bs-toggle="dropdown" 
                                                        aria-expanded="false" 
                                                        style="border-radius: 6px; font-size: 0.8rem;" 
                                                        title="Thao tác khác">
                                                    <i class="bi bi-three-dots-vertical"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border py-1" style="border-radius: 8px; font-size: 0.84rem; min-width: 160px;">
                                                    <li>
                                                        <a class="dropdown-item py-1.5 px-3 d-flex align-items-center gap-2" asp-action="Edit" asp-route-id="@fw.Id">
                                                            <i class="bi bi-pencil text-primary"></i>
                                                            <span>Chỉnh sửa</span>
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <form asp-action="Clone" asp-route-id="@fw.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn nhân bản khung năng lực [@fw.Code] @fw.Name không?');">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="dropdown-item py-1.5 px-3 d-flex align-items-center gap-2">
                                                                <i class="bi bi-copy text-secondary"></i>
                                                                <span>Nhân bản</span>
                                                            </button>
                                                        </form>
                                                    </li>
                                                    <li><hr class="dropdown-divider my-1"></li>
                                                    <li>
                                                        <button type="button" 
                                                                class="dropdown-item py-1.5 px-3 d-flex align-items-center gap-2 text-danger btn-delete-fw"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#deleteFrameworkModal"
                                                                data-fw-id="@fw.Id"
                                                                data-fw-code="@fw.Code"
                                                                data-fw-name="@fw.Name">
                                                            <i class="bi bi-trash"></i>
                                                            <span>Xóa khung</span>
                                                        </button>
                                                    </li>
                                                </ul>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalRecords > 0)
        {
            <div class="card-footer bg-white border-top py-3 px-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div class="small text-muted">
                    Hiển thị từ <strong class="text-dark">@((Model.CurrentPage - 1) * Model.PageSize + 1)</strong> đến <strong class="text-dark">@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRecords)</strong> trong tổng số <strong class="text-dark">@Model.TotalRecords</strong> khung năng lực
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Phân trang khung năng lực">
                        <ul class="pagination pagination-sm pagination-ats mb-0">
                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@(Model.CurrentPage - 1)"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-keyword="@Model.Keyword"
                                   asp-route-status="@Model.StatusFilter"
                                   aria-label="Trang trước">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>

                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                if (Model.TotalPages <= 7 || p == 1 || p == Model.TotalPages || Math.Abs(p - Model.CurrentPage) <= 1)
                                {
                                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" asp-action="Index"
                                           asp-route-page="@p"
                                           asp-route-pageSize="@Model.PageSize"
                                           asp-route-keyword="@Model.Keyword"
                                           asp-route-status="@Model.StatusFilter">@p</a>
                                    </li>
                                }
                                else if ((p == 2 && Model.CurrentPage > 3) || (p == Model.TotalPages - 1 && Model.CurrentPage < Model.TotalPages - 2))
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                            }

                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@(Model.CurrentPage + 1)"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-keyword="@Model.Keyword"
                                   asp-route-status="@Model.StatusFilter"
                                   aria-label="Trang sau">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        }
    </div>
</div>

<!-- Modal xem danh sách chức danh -->
<div class="modal fade" id="frameworkPositionsModal" tabindex="-1" aria-labelledby="frameworkPositionsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow" style="border-radius: 12px; overflow: hidden;">
            <div class="modal-header border-bottom py-3 px-4" style="background-color: #F8FAFC;">
                <div>
                    <span class="badge bg-light text-dark border font-monospace px-2 py-1 mb-1" id="modalFrameworkCode" style="border-radius: 6px; font-size: 0.82rem; font-family: 'JetBrains Mono', monospace;">CF-001</span>
                    <h5 class="modal-title fw-bold text-slate-900" id="modalFrameworkName" style="color: #0F172A;">Khung năng lực</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-briefcase text-success"></i>
                        <span>Danh sách chức danh công việc đang áp dụng</span>
                    </h6>
                    <span class="badge bg-light text-muted border font-monospace" id="modalPositionsCount">0 chức danh</span>
                </div>

                <div class="table-responsive border rounded-3" style="border-radius: 8px !important;">
                    <table class="table table-hover align-middle mb-0" id="modalPositionsTable">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3" style="min-width: 110px;">Mã chức danh</th>
                                <th style="min-width: 200px;">Tên vị trí</th>
                                <th style="min-width: 140px;">Phòng ban</th>
                                <th style="min-width: 100px;">Cấp bậc</th>
                                <th class="text-end pe-3" style="min-width: 100px;">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody id="modalPositionsBody">
                        </tbody>
                    </table>
                </div>

                <div id="modalPositionsEmptyState" class="text-center py-5 d-none">
                    <div class="d-inline-flex align-items-center justify-content-center p-3 rounded-circle bg-light mb-3 text-muted" style="width: 54px; height: 54px;">
                        <i class="bi bi-briefcase fs-4"></i>
                    </div>
                    <h6 class="fw-semibold text-dark mb-1">Chưa có chức danh áp dụng</h6>
                    <p class="text-muted small mb-0">Khung năng lực này hiện tại chưa được gán cho vị trí chức danh nào trong hệ thống.</p>
                </div>
            </div>
            <div class="modal-footer bg-light py-2 px-4 border-top">
                <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal" style="border-radius: 8px;">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal xác nhận xóa khung năng lực -->
@if (canManage)
{
    <div class="modal fade" id="deleteFrameworkModal" tabindex="-1" aria-labelledby="deleteFrameworkModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow" style="border-radius: 12px; overflow: hidden;">
                <div class="modal-header border-bottom py-3 px-4 bg-danger-subtle text-danger">
                    <h6 class="modal-title fw-bold d-flex align-items-center gap-2" id="deleteFrameworkModalLabel">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span>Xác nhận xóa Khung năng lực</span>
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="deleteFrameworkForm" method="post" asp-action="Delete">
                    @Html.AntiForgeryToken()
                    <div class="modal-body p-4">
                        <p class="mb-2 text-dark">
                            Bạn có chắc chắn muốn xóa khung năng lực: <strong id="deleteFrameworkTitle" class="text-danger"></strong>?
                        </p>
                        <p class="text-muted small mb-0">
                            Các chức danh công việc đang liên kết với khung năng lực này sẽ được tự động gỡ bỏ liên kết. Thao tác này có thể ảnh hưởng đến các phiếu đánh giá chưa hoàn thành.
                        </p>
                    </div>
                    <div class="modal-footer border-top py-2 px-4 bg-light">
                        <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal" style="border-radius: 8px;">Hủy bỏ</button>
                        <button type="submit" class="btn btn-danger px-3 d-inline-flex align-items-center gap-1 fw-semibold" style="border-radius: 8px;">
                            <i class="bi bi-trash"></i>
                            <span>Xác nhận xóa</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<style>
    .hover-emerald:hover {
        color: #059669 !important;
    }
    .pagination-ats .page-link {
        color: #334155;
        border-color: #E2E8F0;
        border-radius: 6px !important;
        margin: 0 2px;
        font-weight: 500;
        min-width: 32px;
        text-align: center;
        background-color: #FFFFFF;
    }
    .pagination-ats .page-item.active .page-link {
        background-color: #059669 !important;
        border-color: #059669 !important;
        color: #FFFFFF !important;
    }
    .pagination-ats .page-item.disabled .page-link {
        color: #94A3B8;
        background-color: #F8FAFC;
        border-color: #E2E8F0;
    }
    .pagination-ats .page-link:hover:not(.active) {
        background-color: #F1F5F9;
        color: #0F172A;
    }
</style>

@section Scripts {
    <script src="~/js/competency-framework-list.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const deleteModal = document.getElementById('deleteFrameworkModal');
            if (deleteModal) {
                deleteModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const fwId = button.getAttribute('data-fw-id');
                    const fwCode = button.getAttribute('data-fw-code');
                    const fwName = button.getAttribute('data-fw-name');

                    const titleSpan = deleteModal.querySelector('#deleteFrameworkTitle');
                    if (titleSpan) {
                        titleSpan.textContent = `${fwCode} - ${fwName}`;
                    }

                    const form = deleteModal.querySelector('#deleteFrameworkForm');
                    if (form && fwId) {
                        form.action = `/competency-frameworks/delete/${fwId}`;
                    }
                });
            }
        });
    </script>
}
