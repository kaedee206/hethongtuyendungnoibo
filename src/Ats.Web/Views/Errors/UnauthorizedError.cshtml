@{
    ViewData["Title"] = "Chưa xác thực - 401";
    Layout = "_LoginLayout";
}

<div class="login-wrapper">
    <div class="login-card shadow-sm text-center">
        <div class="mb-4">
            <span class="display-3 fw-bold text-warning d-block">401</span>
            <div class="badge bg-warning-subtle text-warning-emphasis px-3 py-2 rounded-pill mt-2">
                <i class="bi bi-shield-lock-fill me-1"></i> Yêu cầu xác thực
            </div>
        </div>

        <h3 class="fw-bold text-dark mb-2">Chưa đăng nhập hệ thống</h3>
        <p class="text-muted mb-4">
            Phiên làm việc của bạn đã hết hạn hoặc bạn chưa đăng nhập để truy cập tài nguyên này.
        </p>

        <div class="d-grid gap-2">
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary py-2 fw-semibold">
                <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập ngay
            </a>
        </div>
    </div>
</div>
