@{
    ViewData["Title"] = "Không tìm thấy trang - 404";
}

<div class="container py-5 text-center" style="max-width: 600px;">
    <div class="card border-0 shadow-sm p-4 p-md-5" style="border: 1px solid #E2E8F0 !important; border-radius: 12px;">
        <div class="mb-4">
            <span class="display-3 fw-bold text-secondary d-block">404</span>
            <div class="badge bg-secondary-subtle text-secondary px-3 py-1.5 mt-2" style="border-radius: 6px;">
                <i class="bi bi-question-circle me-1"></i> Trang không tồn tại
            </div>
        </div>

        <h3 class="fw-bold text-dark mb-2">Không tìm thấy trang yêu cầu</h3>
        <p class="text-muted mb-4">
            Đường dẫn bạn vừa truy cập có thể đã bị di chuyển, xóa bỏ hoặc không tồn tại trên hệ thống ATS NoveraTech.
        </p>

        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2" style="border-radius: 8px;">
                <i class="bi bi-house-door me-1"></i> Về trang chủ
            </a>
            <button onclick="window.history.back()" class="btn btn-outline-secondary px-4 py-2" style="border-radius: 8px;">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </button>
        </div>
    </div>
</div>
