@{
    ViewData["Title"] = "Lỗi hệ thống - 500";
}

<div class="container py-5 text-center" style="max-width: 600px;">
    <div class="card border-0 shadow-sm p-4 p-md-5" style="border: 1px solid #E2E8F0 !important; border-radius: 12px;">
        <div class="mb-4">
            <span class="display-3 fw-bold text-danger d-block">500</span>
            <div class="badge bg-danger-subtle text-danger px-3 py-1.5 mt-2" style="border-radius: 6px;">
                <i class="bi bi-exclamation-octagon me-1"></i> Sự cố máy chủ
            </div>
        </div>

        <h3 class="fw-bold text-dark mb-2">Hệ thống đang gặp sự cố</h3>
        <p class="text-muted mb-4">
            Đã xảy ra lỗi ngoài dự kiến trong quá trình xử lý yêu cầu của bạn. Quản trị viên hệ thống đã được ghi nhận nhật ký lỗi để khắc phục.
        </p>

        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2" style="border-radius: 8px;">
                <i class="bi bi-house-door me-1"></i> Về trang chủ
            </a>
            <button onclick="location.reload()" class="btn btn-outline-secondary px-4 py-2" style="border-radius: 8px;">
                <i class="bi bi-arrow-clockwise me-1"></i> Tải lại trang
            </button>
        </div>
    </div>
</div>
