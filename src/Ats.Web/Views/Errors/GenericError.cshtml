@{
    ViewData["Title"] = "Đã xảy ra lỗi";
}

<div class="container py-5 text-center" style="max-width: 600px;">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
        <div class="mb-4">
            <span class="display-3 fw-bold text-muted d-block">@(ViewData["StatusCode"] ?? "Lỗi")</span>
            <div class="badge bg-secondary-subtle text-secondary px-3 py-2 rounded-pill mt-2">
                <i class="bi bi-info-circle me-1"></i> Thông báo lỗi
            </div>
        </div>

        <h3 class="fw-bold text-dark mb-2">Đã xảy ra lỗi không xác định</h3>
        <p class="text-muted mb-4">
            Yêu cầu không thể hoàn tất. Vui lòng quay lại trang chủ hoặc thử lại sau ít phút.
        </p>

        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2">
                <i class="bi bi-house-door me-1"></i> Về trang chủ
            </a>
        </div>
    </div>
</div>
