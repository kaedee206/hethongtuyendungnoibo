@{
    ViewData["Title"] = "Đã xảy ra lỗi";
}

<div class="container py-5 text-center" style="max-width: 600px;">
    <div class="card bg-white shadow-sm p-4 p-md-5" style="border: 1px solid #E2E8F0; border-radius: 12px;">
        <div class="mb-4">
            <span class="display-3 fw-bold text-muted d-block font-monospace">@(ViewData["StatusCode"] ?? "Lỗi")</span>
            <div class="badge bg-secondary-subtle text-secondary px-3 py-1 mt-2" style="border-radius: 6px; font-weight: 500;">
                <i class="bi bi-info-circle me-1"></i> Thông báo lỗi
            </div>
        </div>

        <h3 class="fw-bold text-dark mb-2">Đã xảy ra lỗi không xác định</h3>
        <p class="text-muted mb-4">
            Yêu cầu không thể hoàn tất. Vui lòng quay lại trang chủ hoặc thử lại sau ít phút.
        </p>

        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2" style="border-radius: 8px; font-weight: 600;">
                <i class="bi bi-house-door me-1"></i> Về trang chủ
            </a>
        </div>
    </div>
</div>
