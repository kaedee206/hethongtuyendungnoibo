@{
    ViewData["Title"] = "Đã xảy ra lỗi";
}

<div class="container py-5 d-flex justify-content-center align-items-center" style="min-height: 65vh; max-width: 640px;">
    <div class="card bg-white border-0 shadow-sm p-4 p-md-5 d-flex flex-column align-items-center text-center w-100" 
         style="border: 1px solid #E2E8F0 !important; border-radius: 12px; gap: 1.25rem;">
        
        <!-- Node 1: Mã lỗi & Badge -->
        <div class="d-flex flex-column align-items-center gap-2">
            <span class="display-3 fw-bold text-muted font-monospace m-0" style="line-height: 1;">@(ViewData["StatusCode"] ?? "Lỗi")</span>
            <div class="d-flex flex-wrap justify-content-center gap-2">
                <span class="badge bg-secondary-subtle text-secondary px-3 py-1.5" 
                      style="border-radius: 6px; font-weight: 600; white-space: nowrap; font-size: 0.82rem;">
                    <i class="bi bi-info-circle me-1"></i> Thông báo trạng thái
                </span>
            </div>
        </div>

        <!-- Node 2: Tiêu đề & Thông báo -->
        <div class="d-flex flex-column align-items-center gap-2">
            <h3 class="fw-bold text-dark mb-0">Đã xảy ra lỗi không xác định</h3>
            <p class="text-muted mb-0 small" style="line-height: 1.6; max-width: 460px;">
                Yêu cầu không thể hoàn tất vào lúc này. Vui lòng quay lại trang chủ hoặc thử lại sau ít phút.
            </p>
        </div>

        <!-- Node 3: Nút hành động -->
        <div class="d-flex flex-wrap justify-content-center align-items-center gap-2 w-100 pt-3 border-top">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2" style="border-radius: 8px; font-weight: 500; white-space: nowrap;">
                <i class="bi bi-house-door me-1"></i> Về trang chủ
            </a>
        </div>
    </div>
</div>
