@{
    var isUnauthorized = (ViewBag.IsUnauthorizedUser as bool?) == true;
    ViewData["Title"] = isUnauthorized ? "Từ chối quyền truy cập (403 Forbidden) - NoveraTech Careers" : "Không thể xử lý yêu cầu - NoveraTech Careers";
    Layout = "_Layout";
    var errorMsg = ViewBag.ErrorMessage as string ?? "Liên kết rút hồ sơ không hợp lệ hoặc đã hết hạn.";
    var loggedInEmail = ViewBag.LoggedInUserEmail as string ?? "";
    var candidateMaskedEmail = ViewBag.CandidateMaskedEmail as string ?? "";
    var returnUrl = ViewBag.ReturnUrl as string ?? "";
}

<div class="container py-4 py-md-5" style="max-width: 600px;">
    <!-- Breadcrumb link -->
    <div class="mb-3">
        <a href="/gioi-thieu" class="text-decoration-none text-muted small d-inline-flex align-items-center" style="transition: color 0.15s ease;">
            <i class="bi bi-arrow-left me-1.5"></i> Quay lại Cổng thông tin Tuyển dụng
        </a>
    </div>

    <div class="card border-0 bg-white p-4 p-md-5 text-center" style="border: 1px solid #E2E8F0 !important; border-radius: 12px; box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.04), 0 1px 2px -1px rgba(0, 0, 0, 0.04);">
        <!-- Error / Security Warning Icon -->
        <div class="d-inline-flex align-items-center justify-content-center mx-auto mb-3"
             style="width: 56px; height: 56px; border-radius: 12px; background: @(isUnauthorized ? "#FEF2F2" : "#FFFBEB"); color: @(isUnauthorized ? "#DC2626" : "#D97706"); border: 1px solid @(isUnauthorized ? "#FEE2E2" : "#FEF3C7");">
            <i class="bi @(isUnauthorized ? "bi-shield-slash-fill" : "bi-exclamation-triangle-fill")" style="font-size: 1.6rem;"></i>
        </div>

        <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
            <img src="/img/logo-dark-transparent.png" alt="NoveraTech" style="height: 22px; width: auto; max-width: 120px; object-fit: contain;" />
            <span class="text-muted small">·</span>
            <span class="text-muted small fw-medium">Careers Security</span>
        </div>

        <h1 class="fw-bold text-dark mb-2" style="font-size: 1.3rem; letter-spacing: -0.01em;">
            @(isUnauthorized ? "Từ chối quyền truy cập hồ sơ" : "Không thể xử lý yêu cầu rút hồ sơ")
        </h1>
        <p class="text-muted small mb-4" style="line-height: 1.55;">
            @errorMsg
        </p>

        @if (isUnauthorized)
        {
            <!-- Bảng đối soát thông tin tài khoản để minh bạch và an toàn -->
            <div class="p-3 mb-4 text-start small" style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px;">
                <div class="fw-semibold text-dark mb-2 d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-shield-check text-success me-1.5"></i> Thông tin kiểm tra danh tính:</span>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 font-mono" style="font-size: 0.72rem;">HTTP 403</span>
                </div>
                <div class="d-flex flex-column gap-2 pt-1">
                    <div class="d-flex align-items-center justify-content-between p-2 rounded bg-white border border-slate-200">
                        <span class="text-muted">Tài khoản đang đăng nhập:</span>
                        <span class="fw-semibold font-mono text-dark">@(string.IsNullOrEmpty(loggedInEmail) ? "Chưa xác định" : loggedInEmail)</span>
                    </div>
                    <div class="d-flex align-items-center justify-content-between p-2 rounded bg-white border border-slate-200">
                        <span class="text-muted">Chủ sở hữu hồ sơ ứng tuyển:</span>
                        <span class="fw-semibold font-mono text-primary">@candidateMaskedEmail</span>
                    </div>
                </div>
                <div class="mt-2.5 text-muted" style="font-size: 0.78rem; line-height: 1.45;">
                    <i class="bi bi-info-circle me-1 text-primary"></i> 
                    Để đảm bảo an toàn thông tin cá nhân và tính toàn vẹn của quy trình tuyển dụng, chỉ tài khoản trùng khớp với email của hồ sơ mới có quyền thao tác rút đơn.
                </div>
            </div>

            <!-- Actions -->
            <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                <a href="/Account/SwitchCandidateAccount?returnUrl=@Uri.EscapeDataString(returnUrl)" class="btn text-white fw-semibold px-4 py-2" style="background: #059669; border-radius: 8px; font-size: 0.85rem;">
                    <i class="bi bi-box-arrow-in-right me-1.5"></i> Đăng nhập tài khoản ứng viên đúng
                </a>
                <a href="/gioi-thieu" class="btn btn-light border px-4 py-2 text-muted" style="border-color: #CBD5E1 !important; border-radius: 8px; font-size: 0.85rem;">
                    Trang chủ Tuyển dụng
                </a>
            </div>
        }
        else
        {
            <!-- Information / Guidance Box cho lỗi token / link hết hạn -->
            <div class="p-3 mb-4 text-start small" style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px;">
                <div class="fw-semibold text-dark mb-2 d-flex align-items-center">
                    <i class="bi bi-info-circle text-primary me-1.5"></i> Gợi ý xử lý:
                </div>
                <ul class="mb-0 ps-3 text-muted" style="line-height: 1.6;">
                    <li>Kiểm tra lại xem đường dẫn đã được sao chép đầy đủ từ email xác nhận ứng tuyển chưa.</li>
                    <li>Liên kết rút hồ sơ có thời hạn bảo mật hoặc có thể hồ sơ này đã được cập nhật trước đó.</li>
                    <li>Nếu cần hỗ trợ trực tiếp, vui lòng liên hệ Ban Tuyển dụng qua email <span class="text-dark font-mono fw-medium">tuyendung@noveratech.digital</span>.</li>
                </ul>
            </div>

            <!-- Actions -->
            <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                <a href="/Jobs" class="btn text-white fw-semibold px-4 py-2" style="background: #059669; border-radius: 8px; font-size: 0.85rem;">
                    <i class="bi bi-briefcase me-1.5"></i> Vị trí đang tuyển dụng
                </a>
                <a href="/gioi-thieu" class="btn btn-light border px-4 py-2 text-muted" style="border-color: #CBD5E1 !important; border-radius: 8px; font-size: 0.85rem;">
                    Trang chủ Tuyển dụng
                </a>
            </div>
        }
    </div>
</div>
