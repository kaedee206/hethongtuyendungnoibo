@model Ats.Web.Models.ViewModels.Applications.WithdrawApplicationViewModel
@{
    ViewData["Title"] = "Xác nhận Rút hồ sơ ứng tuyển";
    Layout = "_Layout";
}

<div class="container py-5" style="max-width: 760px;">
    <!-- Breadcrumb & Back Link -->
    <div class="mb-3">
        <a href="/gioi-thieu" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1.5 hover-text-primary">
            <i class="bi bi-arrow-left"></i> Quay lại Trang chủ Tuyển dụng
        </a>
    </div>

    <!-- Main Confirmation Card -->
    <div class="card border-0 shadow-sm bg-white overflow-hidden" style="border: 1px solid #E2E8F0 !important; border-radius: 16px;">
        <!-- Card Header Banner -->
        <div class="p-4 p-md-4" style="background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%); color: #F8FAFC;">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge" style="background: rgba(239, 68, 68, 0.2); color: #FCA5A5; border: 1px solid rgba(239, 68, 68, 0.3); font-size: 0.72rem; letter-spacing: 0.05em; text-transform: uppercase;">
                    <i class="bi bi-shield-exclamation me-1"></i> Xác nhận hành động
                </span>
                <span class="text-white-50 small">·</span>
                <span class="text-white-50 font-mono small">@Model.ApplicationCode</span>
            </div>
            <h3 class="fw-bold text-white mb-1" style="font-size: 1.45rem;">
                Rút hồ sơ ứng tuyển vị trí @Model.JobTitle
            </h3>
            <p class="text-white-50 mb-0 small">
                Hệ thống Tuyển dụng &amp; Thu hút Nhân tài NoveraTech Enterprise
            </p>
        </div>

        <div class="p-4 p-md-5">
            @if (Model.IsAlreadyWithdrawn)
            {
                <!-- Thông báo nếu hồ sơ đã được rút trước đó -->
                <div class="alert alert-secondary border-0 d-flex align-items-start gap-3 p-3.5 mb-4" style="background: #F1F5F9; border-radius: 10px;">
                    <i class="bi bi-info-circle-fill text-muted fs-4 flex-shrink-0 mt-0.5"></i>
                    <div>
                        <h6 class="fw-bold text-dark mb-1">Hồ sơ đã được rút thành công trước đó</h6>
                        <p class="text-muted small mb-1">
                            Hồ sơ ứng tuyển của bạn đã được ghi nhận rút khỏi hệ thống vào ngày 
                            <strong class="text-dark font-mono">@(Model.WithdrawnAt?.ToString("dd/MM/yyyy HH:mm") ?? "Gần đây")</strong>.
                        </p>
                        @if (!string.IsNullOrWhiteSpace(Model.ExistingReason))
                        {
                            <div class="small text-muted mt-2 p-2 bg-white rounded border border-light">
                                <strong>Lý do ghi nhận:</strong> @Model.ExistingReason
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <a href="/Jobs" class="btn btn-success fw-semibold px-4" style="border-radius: 8px; font-size: 0.85rem; background: #059669;">
                        Khám phá việc làm khác
                    </a>
                    <a href="/gioi-thieu" class="btn btn-light border px-4" style="border-radius: 8px; font-size: 0.85rem;">
                        Về trang chủ
                    </a>
                </div>
            }
            else
            {
                <!-- Tóm tắt thông tin hồ sơ ứng tuyển -->
                <div class="p-3.5 mb-4" style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 10px;">
                    <div class="row g-3">
                        <div class="col-12 col-sm-6">
                            <div class="text-muted text-xs text-uppercase fw-semibold" style="letter-spacing: 0.04em;">Họ tên ứng viên</div>
                            <div class="fw-bold text-dark" style="font-size: 0.95rem;">@Model.CandidateName</div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="text-muted text-xs text-uppercase fw-semibold" style="letter-spacing: 0.04em;">Email liên hệ</div>
                            <div class="font-mono text-dark small">@Model.CandidateEmail</div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="text-muted text-xs text-uppercase fw-semibold" style="letter-spacing: 0.04em;">Vị trí ứng tuyển</div>
                            <div class="fw-bold text-dark small">@Model.JobTitle</div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="text-muted text-xs text-uppercase fw-semibold" style="letter-spacing: 0.04em;">Giai đoạn tuyển dụng hiện tại</div>
                            <div class="d-flex align-items-center gap-1.5 mt-0.5">
                                <span class="badge" style="background: #ECFDF5; color: #047857; border: 1px solid #A7F3D0; border-radius: 6px; font-size: 0.75rem; font-weight: 600;">
                                    <i class="bi bi-record-circle-fill me-1" style="font-size: 0.5rem; vertical-align: middle;"></i>@Model.CurrentStageName
                                </span>
                                <span class="text-muted small" style="font-size: 0.72rem;">(Nộp lúc: @Model.AppliedDateDisplay)</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Cảnh báo hậu quả trước khi xác nhận -->
                <div class="alert alert-warning border-0 d-flex align-items-start gap-3 p-3.5 mb-4" style="background: #FFFBEB; border: 1px solid #FDE68A !important; border-radius: 10px;">
                    <i class="bi bi-exclamation-triangle-fill text-warning fs-4 flex-shrink-0 mt-0.5"></i>
                    <div>
                        <h6 class="fw-bold text-dark mb-1" style="font-size: 0.9rem;">Lưu ý trước khi thực hiện:</h6>
                        <ul class="text-muted small mb-0 ps-3" style="line-height: 1.6;">
                            <li>Hồ sơ của bạn sẽ chuyển sang trạng thái <strong>Ứng viên rút (WITHDRAWN)</strong>.</li>
                            <li>Toàn bộ các vòng phỏng vấn hoặc xét duyệt còn lại cho vị trí này sẽ lập tức dừng lại.</li>
                            <li>Chuyên viên tuyển dụng (Recruiter) phụ trách sẽ nhận được thông báo để cập nhật kế hoạch tuyển dụng.</li>
                            <li>Hành động này <strong>không thể hoàn tác</strong>. Bạn có thể ứng tuyển lại vị trí này trong các đợt tuyển dụng sau.</li>
                        </ul>
                    </div>
                </div>

                <!-- Form Xác nhận Rút Hồ sơ -->
                <form asp-controller="Applications" asp-action="ConfirmWithdraw" method="post" id="withdrawForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="token" value="@Model.Token" />

                    <!-- Nhóm lý do chính -->
                    <div class="mb-3.5">
                        <label for="reasonCategory" class="form-label fw-bold text-dark" style="font-size: 0.85rem;">
                            Vui lòng chọn lý do rút hồ sơ <span class="text-danger">*</span>
                        </label>
                        <select class="form-select" id="reasonCategory" name="reasonCategory" required style="border-color: #CBD5E1; border-radius: 8px; font-size: 0.88rem; padding: 0.55rem 0.85rem;">
                            <option value="Đã nhận việc nơi khác" selected>🎉 Tôi đã nhận lời mời làm việc (Offer) từ công ty khác</option>
                            <option value="Thay đổi kế hoạch cá nhân">📅 Kế hoạch cá nhân / Gia đình có sự thay đổi đột xuất</option>
                            <option value="Không còn phù hợp định hướng nghề nghiệp">🎯 Định hướng nghề nghiệp hiện tại chưa hoàn toàn trùng khớp</option>
                            <option value="Lý do mức lương / Đãi ngộ">💼 Mức đãi ngộ chưa đạt kỳ vọng mong muốn</option>
                            <option value="Địa điểm / Thời gian làm việc không thuận tiện">📍 Địa điểm làm việc hoặc thời gian chưa phù hợp</option>
                            <option value="Lý do khác">📝 Lý do cá nhân khác</option>
                        </select>
                    </div>

                    <!-- Ghi chú chi tiết (Tùy chọn) -->
                    <div class="mb-4">
                        <label for="reasonDetail" class="form-label fw-semibold text-muted small">
                            Chia sẻ thêm chi tiết với bộ phận Tuyển dụng (tùy chọn)
                        </label>
                        <textarea class="form-control" id="reasonDetail" name="reasonDetail" rows="3"
                                  placeholder="Nếu bạn có thêm góp ý hoặc chia sẻ về trải nghiệm ứng tuyển vừa qua, hãy cho chúng tôi biết..."
                                  style="border-color: #CBD5E1; border-radius: 8px; font-size: 0.85rem;"></textarea>
                    </div>

                    <!-- Nút thao tác -->
                    <div class="d-flex flex-column flex-sm-row align-items-center justify-content-between gap-3 pt-2 border-top" style="border-color: #F1F5F9 !important;">
                        <a href="/gioi-thieu" class="btn btn-light border w-100 w-sm-auto px-4 order-2 order-sm-1" style="border-radius: 8px; font-size: 0.85rem;">
                            <i class="bi bi-x-circle me-1 text-muted"></i> Giữ lại hồ sơ &amp; Quay về
                        </a>
                        <button type="submit" id="btnConfirmWithdraw" class="btn btn-danger fw-semibold w-100 w-sm-auto px-4 order-1 order-sm-2 d-inline-flex align-items-center justify-content-center gap-2"
                                style="border-radius: 8px; font-size: 0.85rem; background: #DC2626; border-color: #DC2626;">
                            <i class="bi bi-trash3"></i> Xác nhận rút hồ sơ ứng tuyển
                        </button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('withdrawForm')?.addEventListener('submit', function (e) {
            var btn = document.getElementById('btnConfirmWithdraw');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Đang xử lý rút hồ sơ...';
            }
        });
    </script>
}
