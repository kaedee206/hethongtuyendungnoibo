@using Ats.Web.Models.Enums
@model Ats.Web.Models.ViewModels.Onboarding.PrepareCreateOnboardingChecklistModalViewModel

<div class="modal fade" id="initOnboardingModal" tabindex="-1" aria-labelledby="initOnboardingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow" style="border-radius: 12px; overflow: hidden;">
            
            <!-- Modal Header -->
            <div class="modal-header py-3 px-4" style="background: linear-gradient(135deg, #064E3B 0%, #059669 100%); color: #FFFFFF;">
                <div class="d-flex align-items-center gap-2">
                    <div class="p-2 rounded-2" style="background: rgba(255,255,255,0.2);">
                        <i class="bi bi-person-badge fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold font-outfit mb-0" id="initOnboardingModalLabel" style="color: #FFFFFF;">
                            Khởi Tạo Checklist Onboarding
                        </h5>
                        <small class="opacity-90" style="font-size: 0.78rem;">
                            Mẫu phòng ban: @Model.DepartmentName (4 nhóm: Tài khoản, Thiết bị, Chỗ ngồi, Hồ sơ)
                        </small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Form -->
            <form id="initOnboardingForm" asp-action="InitializeChecklist" asp-controller="Candidates" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ApplicationId" value="@Model.ApplicationId" />
                <input type="hidden" name="DepartmentId" value="@Model.DepartmentId" />
                <input type="hidden" name="CandidateId" value="@Model.CandidateId" />

                <div class="modal-body p-4" style="background-color: #F8FAFC;">
                    
                    <!-- Khung Thông Tin Ứng Viên -->
                    <div class="p-3 mb-3 bg-white border rounded-2" style="border-color: #E2E8F0 !important;">
                        <div class="row g-2" style="font-size: 0.85rem;">
                            <div class="col-12 col-md-6">
                                <span class="text-muted">Ứng viên:</span> 
                                <strong class="text-dark ms-1">@Model.CandidateName</strong>
                            </div>
                            <div class="col-12 col-md-6">
                                <span class="text-muted">Vị trí nhận việc:</span> 
                                <strong class="text-dark ms-1">@Model.JobTitle</strong>
                            </div>
                            <div class="col-12 col-md-6">
                                <span class="text-muted">Phòng ban tiếp nhận:</span> 
                                <span class="badge rounded-2 bg-light text-dark border ms-1">@Model.DepartmentName</span>
                            </div>
                            <div class="col-12 col-md-6">
                                <span class="text-muted">Email liên hệ:</span> 
                                <span class="text-muted font-mono ms-1">@Model.CandidateEmail</span>
                            </div>
                        </div>
                    </div>

                    <!-- Ngày Đi Làm Đầu Tiên -->
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark small mb-1">
                                <i class="bi bi-file-earmark-check me-1 text-primary"></i>Mẫu Checklist Áp Dụng
                            </label>
                            <input type="text" 
                                   class="form-control form-control-sm rounded-2 bg-light text-dark" 
                                   value="@Model.Template.TemplateName (@Model.Template.DepartmentName)" 
                                   readonly />
                            <div class="form-text text-muted" style="font-size: 0.72rem;">
                                Tự động nạp mẫu theo phòng ban hoặc mẫu chuẩn toàn công ty.
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark small mb-1">
                                <i class="bi bi-calendar-event me-1 text-primary"></i>Ngày Đi Làm Đầu Tiên <span class="text-danger">*</span>
                            </label>
                            <input type="date" 
                                   class="form-control form-control-sm rounded-2 font-mono border-secondary-subtle" 
                                   id="firstWorkingDateInput" 
                                   name="FirstWorkingDate" 
                                   value="@Model.FirstWorkingDate.ToString("yyyy-MM-dd")" 
                                   required />
                            <div class="form-text text-muted" style="font-size: 0.72rem;">
                                Hạn hoàn thành từng mục không được sau ngày đi làm đầu tiên.
                            </div>
                        </div>
                    </div>

                    <!-- Danh Sách Hạng Mục Sẽ Khởi Tạo (4 Nhóm) -->
                    <div class="card border-0 shadow-none bg-white rounded-2 mb-2" style="border: 1px solid #E2E8F0 !important;">
                        <div class="card-header bg-light py-2 px-3 d-flex justify-content-between align-items-center" style="border-bottom: 1px solid #E2E8F0;">
                            <span class="fw-semibold text-dark small">
                                <i class="bi bi-list-check me-1 text-primary"></i>Danh sách các hạng mục bàn giao theo 4 nhóm
                            </span>
                            <span class="badge rounded-2 bg-white text-dark border font-mono small" id="totalItemsBadge">
                                @Model.Template.Items.Count mục bàn giao
                            </span>
                        </div>
                        <div class="card-body p-3" style="max-height: 380px; overflow-y: auto;" id="templateItemsContainer">
                            <div id="templateItemsList" class="d-flex flex-column gap-3">
                                @{
                                    var items = Model.Template.Items;
                                    var groups = items.GroupBy(i => i.Category).OrderBy(g => (int)g.Key).ToList();
                                    int globalIndex = 0;
                                }

                                @foreach (var grp in groups)
                                {
                                    <div class="border rounded-2 p-2.5 bg-light bg-opacity-50" style="border-color: #E2E8F0;">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <span class="badge rounded-2 @grp.Key.GetBadgeClass()" style="font-size: 0.75rem;">
                                                <i class="bi @grp.Key.GetIcon() me-1"></i>@grp.Key.GetDisplayName()
                                            </span>
                                            <span class="small text-muted font-mono" style="font-size: 0.72rem;">@grp.Count() mục</span>
                                        </div>

                                        <div class="d-flex flex-column gap-2">
                                            @foreach (var itm in grp.OrderBy(x => x.DisplayOrder))
                                            {
                                                var idx = globalIndex++;
                                                var calculatedDue = Model.FirstWorkingDate.AddDays(-itm.DaysBeforeJoinDateOffset);
                                                if (calculatedDue > Model.FirstWorkingDate) calculatedDue = Model.FirstWorkingDate;

                                                <div class="p-2 bg-white rounded-2 border" style="border-color: #E2E8F0 !important;">
                                                    <input type="hidden" name="Items[@idx].Category" value="@((int)itm.Category)" />
                                                    <input type="hidden" name="Items[@idx].Title" value="@itm.Title" />

                                                    <div class="fw-semibold text-dark small mb-1.5">
                                                        <i class="bi bi-dot text-secondary"></i>@itm.Title
                                                    </div>

                                                    <div class="row g-2">
                                                        <div class="col-12 col-md-7">
                                                            <label class="form-label text-muted mb-0" style="font-size: 0.7rem;">Người phụ trách:</label>
                                                            <select class="form-select form-select-sm rounded-2 text-dark font-sans" 
                                                                    name="Items[@idx].AssignedToUserId" 
                                                                    required 
                                                                    style="font-size: 0.78rem;">
                                                                <option value="">-- Chọn người phụ trách --</option>
                                                                @foreach (var u in Model.AvailableUsers)
                                                                {
                                                                    var isSel = (itm.DefaultAssignedUserId.HasValue && itm.DefaultAssignedUserId.Value == u.UserId);
                                                                    <option value="@u.UserId" selected="@isSel">
                                                                        @u.FullName (@u.RoleName)
                                                                    </option>
                                                                }
                                                            </select>
                                                        </div>

                                                        <div class="col-12 col-md-5">
                                                            <label class="form-label text-muted mb-0" style="font-size: 0.7rem;">Hạn hoàn thành (≤ ngày đi làm):</label>
                                                            <input type="date" 
                                                                   class="form-control form-control-sm rounded-2 font-mono item-due-date-input" 
                                                                   name="Items[@idx].DueDate" 
                                                                   value="@calculatedDue.ToString("yyyy-MM-dd")" 
                                                                   max="@Model.FirstWorkingDate.ToString("yyyy-MM-dd")"
                                                                   data-offset="@itm.DaysBeforeJoinDateOffset"
                                                                   required 
                                                                   style="font-size: 0.78rem;" />
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Alert Cảnh Báo Phân Quyền & Ràng Buộc -->
                    <div class="alert alert-info py-2 px-3 mt-3 mb-0 d-flex align-items-center gap-2 rounded-2" style="font-size: 0.78rem;">
                        <i class="bi bi-info-circle-fill text-primary fs-5"></i>
                        <div>
                            Checklist được sao chép độc lập cho ứng viên. Khi đạt <b>100% hoàn tất</b>, ứng viên sẽ tự động chuyển sang trạng thái <b>"Đã onboard"</b>.
                        </div>
                    </div>

                </div>

                <!-- Modal Footer -->
                <div class="modal-footer py-2 px-4 bg-white border-top">
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-2 px-3" data-bs-dismiss="modal">
                        Hủy
                    </button>
                    <button type="submit" class="btn btn-sm text-white rounded-2 px-4 fw-semibold" id="btnSubmitInitChecklist" style="background-color: #059669;">
                        <i class="bi bi-check-lg me-1"></i>Khởi Tạo Checklist
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<script>
    (function () {
        const firstWorkingDateInput = document.getElementById('firstWorkingDateInput');
        const initForm = document.getElementById('initOnboardingForm');
        const btnSubmit = document.getElementById('btnSubmitInitChecklist');

        // Tự động tính lại hạn hoàn thành khi thay đổi Ngày đi làm đầu tiên
        firstWorkingDateInput.addEventListener('change', function () {
            const newDateStr = this.value;
            if (!newDateStr) return;

            const baseDate = new Date(newDateStr);
            const dueInputs = document.querySelectorAll('.item-due-date-input');

            dueInputs.forEach(input => {
                input.max = newDateStr;
                const offset = parseInt(input.getAttribute('data-offset') || '0', 10);
                const targetDate = new Date(baseDate);
                targetDate.setDate(targetDate.getDate() - offset);

                const yyyy = targetDate.getFullYear();
                const mm = String(targetDate.getMonth() + 1).padStart(2, '0');
                const dd = String(targetDate.getDate()).padStart(2, '0');
                const formatted = `${yyyy}-${mm}-${dd}`;

                input.value = formatted <= newDateStr ? formatted : newDateStr;
            });
        });

        // Submit form xử lý AJAX
        initForm.addEventListener('submit', async function (e) {
            e.preventDefault();
            btnSubmit.disabled = true;
            btnSubmit.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>Đang khởi tạo...';

            const formData = new FormData(initForm);
            try {
                const response = await fetch(initForm.action, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: formData
                });
                const res = await response.json();
                if (res && res.success) {
                    const modalEl = document.getElementById('initOnboardingModal');
                    const modalInstance = bootstrap.Modal.getInstance(modalEl);
                    if (modalInstance) modalInstance.hide();

                    if (window.NoveraToast) {
                        window.NoveraToast.success(res.message);
                    } else {
                        alert(res.message);
                    }

                    setTimeout(() => {
                        window.location.reload();
                    }, 800);
                } else {
                    if (window.NoveraToast) {
                        window.NoveraToast.error(res ? res.message : 'Khởi tạo checklist thất bại.');
                    } else {
                        alert(res ? res.message : 'Khởi tạo checklist thất bại.');
                    }
                }
            } catch (err) {
                console.error(err);
                if (window.NoveraToast) {
                    window.NoveraToast.error('Lỗi khi gửi yêu cầu khởi tạo checklist.');
                }
            } finally {
                btnSubmit.disabled = false;
                btnSubmit.innerHTML = '<i class="bi bi-check-lg me-1"></i>Khởi Tạo Checklist';
            }
        });
    })();
</script>
