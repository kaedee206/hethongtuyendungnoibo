@model Ats.Web.Models.ViewModels.Onboarding.CandidateOnboardingChecklistViewModel

<div class="onboarding-checklist-wrapper" id="checklistWrapper_@Model.Id" data-checklist-id="@Model.Id" data-application-id="@Model.ApplicationId">
    <!-- Header Thống Kê & Tiến Độ -->
    <div class="card border-0 shadow-sm mb-4" style="background: linear-gradient(135deg, #064E3B 0%, #059669 100%); border-radius: 12px; color: #FFFFFF;">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge rounded-2" style="background: rgba(255,255,255,0.2); font-size: 0.75rem;">
                            <i class="bi bi-person-check-fill me-1"></i>Hồ sơ Onboarding
                        </span>
                        <span class="badge rounded-2 @Model.StatusBadgeClass" id="checklistStatusBadge_@Model.Id" style="font-size: 0.75rem;">
                            @Model.StatusDisplayName
                        </span>
                    </div>
                    <h4 class="fw-bold mb-1 font-outfit" style="color: #FFFFFF;">@Model.CandidateName</h4>
                    <div class="small opacity-90 d-flex flex-wrap align-items-center gap-3">
                        <span><i class="bi bi-briefcase me-1"></i>@Model.JobTitle</span>
                        <span>•</span>
                        <span><i class="bi bi-building me-1"></i>@Model.DepartmentName</span>
                        <span>•</span>
                        <span><i class="bi bi-calendar-event me-1"></i>Ngày đi làm đầu tiên: <strong class="font-mono">@Model.FormattedFirstWorkingDate</strong></span>
                    </div>
                </div>

                <!-- Cột Phần Trăm Tiến Độ Lớn -->
                <div class="text-end bg-white text-dark p-3 rounded-3 shadow-sm" style="min-width: 170px; border-radius: 10px;">
                    <div class="small text-muted fw-semibold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Tiến độ hoàn thành</div>
                    <div class="d-flex align-items-baseline justify-content-end gap-1 mt-0.5">
                        <span class="fs-2 fw-bolder font-mono" id="progressPercentDisplay_@Model.Id" style="color: #059669;">
                            @Model.ProgressPercentage%
                        </span>
                    </div>
                    <div class="small text-muted font-mono" id="itemsCountDisplay_@Model.Id" style="font-size: 0.75rem;">
                        Đã xong <b class="text-dark" id="completedCountNum_@Model.Id">@Model.CompletedCount</b> / @Model.TotalCount mục
                    </div>
                </div>
            </div>

            <!-- Thanh Progress Bar -->
            <div class="mt-3">
                <div class="progress" style="height: 10px; background-color: rgba(255,255,255,0.25); border-radius: 6px; overflow: hidden;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-white" 
                         role="progressbar" 
                         id="progressBar_@Model.Id"
                         style="width: @Model.ProgressPercentage%; transition: width 0.4s ease;" 
                         aria-valuenow="@Model.ProgressPercentage" 
                         aria-valuemin="0" 
                         aria-valuemax="100">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Thanh Thống kê 4 Nhóm -->
    <div class="row g-2 mb-3">
        @foreach (var g in Model.CategoryGroups)
        {
            <div class="col-6 col-md-3">
                <div class="p-2.5 rounded-2 border bg-white d-flex align-items-center gap-2 shadow-xs" style="border-color: #E2E8F0 !important;">
                    <div class="p-2 rounded-2 @g.CategoryBadgeClass">
                        <i class="bi @g.CategoryIcon fs-5"></i>
                    </div>
                    <div>
                        <div class="small text-muted" style="font-size: 0.72rem;">@g.CategoryName</div>
                        <div class="fw-bold font-mono text-dark" style="font-size: 0.85rem;">@g.CompletedCount / @g.TotalCount mục</div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Danh Sách 4 Nhóm Hạng Mục Bàn Giao -->
    <div class="d-flex flex-column gap-3">
        @foreach (var group in Model.CategoryGroups)
        {
            <div class="card border-0 shadow-sm bg-white" style="border: 1px solid #E2E8F0 !important; border-radius: 12px; overflow: hidden;">
                <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center" style="border-bottom: 1px solid #F1F5F9;">
                    <div class="d-flex align-items-center gap-2.5">
                        <div class="p-1.5 rounded-2 @group.CategoryBadgeClass">
                            <i class="bi @group.CategoryIcon fs-5"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold text-dark mb-0 font-outfit" style="font-size: 0.95rem;">@group.CategoryName</h6>
                            <small class="text-muted" style="font-size: 0.75rem;">Nhóm hạng mục chuẩn bị bàn giao</small>
                        </div>
                    </div>
                    <span class="badge rounded-2 font-mono px-2.5 py-1.5" style="background: #F1F5F9; color: #334155; font-size: 0.75rem;">
                        @group.CompletedCount / @group.TotalCount hoàn thành
                    </span>
                </div>

                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @foreach (var item in group.Items)
                        {
                            var rowId = $"onboardingItemRow_{item.Id}";
                            var checkboxId = $"checkItem_{item.Id}";

                            <div class="list-group-item p-3 px-4 d-flex align-items-start gap-3 transition-all @(item.IsCompleted ? "bg-light bg-opacity-40" : "")" 
                                 id="@rowId" 
                                 style="border-color: #F1F5F9;">
                                
                                <!-- Checkbox Toggle -->
                                <div class="pt-0.5">
                                    <div class="form-check m-0">
                                        <input class="form-check-input onboarding-item-checkbox shadow-none" 
                                               type="checkbox" 
                                               id="@checkboxId" 
                                               data-item-id="@item.Id" 
                                               data-checklist-id="@Model.Id"
                                               @(item.IsCompleted ? "checked" : "") 
                                               @(!item.CanToggle ? "disabled" : "") 
                                               style="width: 1.25rem; height: 1.25rem; cursor: @(item.CanToggle ? "pointer" : "not-allowed"); border-color: #CBD5E1;"
                                               title="@(item.CanToggle ? "Click để đánh dấu hoàn thành" : "Chỉ HR Manager hoặc người phụ trách mục này mới có quyền đánh dấu")">
                                    </div>
                                </div>

                                <!-- Nội Dung Mục -->
                                <div class="flex-grow-1">
                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                        <label for="@checkboxId" class="fw-semibold text-dark mb-0 @(item.IsCompleted ? "text-decoration-line-through text-muted" : "")" 
                                               id="labelTitle_@item.Id"
                                               style="cursor: @(item.CanToggle ? "pointer" : "default"); font-size: 0.88rem;">
                                            @item.Title
                                        </label>

                                        <!-- Hạn Hoàn Thành -->
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge rounded-2 font-mono @(item.IsCompleted ? "bg-light text-muted border" : "bg-light text-dark border")" style="font-size: 0.72rem;">
                                                <i class="bi bi-clock me-1 text-secondary"></i>Hạn: @item.FormattedDueDate
                                            </span>
                                        </div>
                                    </div>

                                    <!-- Meta: Người Phụ Trách & Lịch Sử Hoàn Thành -->
                                    <div class="d-flex flex-wrap align-items-center gap-3 mt-1.5" style="font-size: 0.75rem;">
                                        <span class="text-secondary">
                                            <i class="bi bi-person me-1"></i>Phụ trách: 
                                            <strong class="text-dark">@(string.IsNullOrWhiteSpace(item.AssignedToUserName) ? "Chưa chỉ định" : item.AssignedToUserName)</strong>
                                            @if (!string.IsNullOrWhiteSpace(item.AssignedToUserEmail))
                                            {
                                                <span class="text-muted font-mono">(@item.AssignedToUserEmail)</span>
                                            }
                                        </span>

                                        <span id="completeInfo_@item.Id" class="@(item.IsCompleted ? "text-success fw-medium" : "d-none")">
                                            <i class="bi bi-check-circle-fill me-1"></i>Hoàn thành ngày 
                                            <span class="font-mono">@item.FormattedCompletedAt</span>
                                            @if (!string.IsNullOrWhiteSpace(item.CompletedByUserName))
                                            {
                                                <span> bởi <strong>@item.CompletedByUserName</strong></span>
                                            }
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script>
    (function () {
        const wrapper = document.getElementById('checklistWrapper_@Model.Id');
        if (!wrapper) return;

        const checkboxes = wrapper.querySelectorAll('.onboarding-item-checkbox');
        checkboxes.forEach(chk => {
            chk.addEventListener('change', async function () {
                const itemId = this.getAttribute('data-item-id');
                const checklistId = this.getAttribute('data-checklist-id');
                const isCompleted = this.checked;

                this.disabled = true;

                try {
                    const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
                    const token = tokenEl ? tokenEl.value : '';

                    const response = await fetch('/ung-vien/onboarding/cap-nhat-muc', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token,
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({
                            ItemId: itemId,
                            IsCompleted: isCompleted
                        })
                    });

                    const res = await response.json();
                    if (res && res.success) {
                        const data = res.data;

                        // Cập nhật giao diện thanh tiến độ %
                        const progressDisplay = document.getElementById('progressPercentDisplay_' + checklistId);
                        if (progressDisplay) {
                            progressDisplay.textContent = data.progressPercentage + '%';
                        }

                        const progressBar = document.getElementById('progressBar_' + checklistId);
                        if (progressBar) {
                            progressBar.style.width = data.progressPercentage + '%';
                            progressBar.setAttribute('aria-valuenow', data.progressPercentage);
                        }

                        const completedCountNum = document.getElementById('completedCountNum_' + checklistId);
                        if (completedCountNum) {
                            completedCountNum.textContent = data.completedItemsCount;
                        }

                        // Cập nhật row và nhãn mục
                        const rowEl = document.getElementById('onboardingItemRow_' + itemId);
                        const labelTitle = document.getElementById('labelTitle_' + itemId);
                        const completeInfo = document.getElementById('completeInfo_' + itemId);

                        if (isCompleted) {
                            if (rowEl) rowEl.classList.add('bg-light', 'bg-opacity-40');
                            if (labelTitle) labelTitle.classList.add('text-decoration-line-through', 'text-muted');
                            if (completeInfo) {
                                completeInfo.classList.remove('d-none');
                                completeInfo.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>Vừa đánh dấu hoàn thành';
                            }
                        } else {
                            if (rowEl) rowEl.classList.remove('bg-light', 'bg-opacity-40');
                            if (labelTitle) labelTitle.classList.remove('text-decoration-line-through', 'text-muted');
                            if (completeInfo) {
                                completeInfo.classList.add('d-none');
                            }
                        }

                        // Cập nhật status badge
                        const statusBadge = document.getElementById('checklistStatusBadge_' + checklistId);
                        if (statusBadge) {
                            statusBadge.className = 'badge rounded-2 ' + data.statusBadgeClass;
                            statusBadge.textContent = data.statusDisplayName;
                        }

                        if (window.NoveraToast) {
                            if (data.isAllCompleted) {
                                window.NoveraToast.success('Checklist hoàn tất 100%! Ứng viên đã tự động chuyển sang trạng thái "Đã onboard".');
                            } else {
                                window.NoveraToast.success(res.message || 'Cập nhật mục thành công.');
                            }
                        }
                    } else {
                        this.checked = !isCompleted;
                        if (window.NoveraToast) {
                            window.NoveraToast.error(res ? res.message : 'Không thể cập nhật mục này.');
                        } else {
                            alert(res ? res.message : 'Không thể cập nhật.');
                        }
                    }
                } catch (err) {
                    console.error('Lỗi khi cập nhật mục onboarding:', err);
                    this.checked = !isCompleted;
                    if (window.NoveraToast) {
                        window.NoveraToast.error('Lỗi kết nối khi cập nhật mục onboarding.');
                    }
                } finally {
                    this.disabled = false;
                }
            });
        });
    })();
</script>
