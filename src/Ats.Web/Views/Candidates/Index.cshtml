@* ══════════════════════════════════════════════════════════
   CLIENT SCRIPTS & CLEAN FORM SUBMISSION
   ══════════════════════════════════════════════════════════ *@
@section Scripts {
    <script>
        // Lấy AntiForgeryToken từ form ẩn
        function getCsrfToken() {
            return document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]')?.value || '';
        }

        // Tự động xóa rỗng input và chỉ submit các tham số có giá trị
        function handleCleanFormSubmit(e) {
            if (e) e.preventDefault();
            const form = document.getElementById('filterForm');
            const formData = new FormData(form);
            const params = new URLSearchParams();

            for (const [key, value] of formData.entries()) {
                const trimmed = typeof value === 'string' ? value.trim() : value;
                // Bỏ qua giá trị rỗng hoặc giá trị mặc định
                if (!trimmed) continue;
                if (key === 'DatePreset' && trimmed === 'all') continue;
                params.append(key, trimmed);
            }

            const queryString = params.toString();
            window.location.href = '/ung-vien' + (queryString ? '?' + queryString : '');
        }

        // Xóa nhanh ô tìm kiếm
        function clearSearchInput() {
            const input = document.getElementById('omniboxSearchInput');
            if (input) {
                input.value = '';
                handleCleanFormSubmit();
            }
        }

        // Xử lý khi đổi Preset thời gian
        function onDatePresetChange(val) {
            const fromCol = document.getElementById('fromDateCol');
            const toCol = document.getElementById('toDateCol');
            const advCollapse = document.getElementById('advancedFiltersCollapse');

            if (val === 'custom') {
                fromCol.style.display = 'block';
                toCol.style.display = 'block';
                const bsCollapse = bootstrap.Collapse.getOrCreateInstance(advCollapse);
                bsCollapse.show();
            } else {
                fromCol.style.display = 'none';
                toCol.style.display = 'none';
                handleCleanFormSubmit();
            }
        }

        // Lưu bộ lọc hiện tại qua AJAX POST /ung-vien/bo-loc/luu
        async function saveCurrentFilter() {
            const nameInput = document.getElementById('savedFilterName');
            const name = nameInput.value.trim();
            if (!name) {
                nameInput.classList.add('is-invalid');
                return;
            }
            nameInput.classList.remove('is-invalid');

            const desc = document.getElementById('savedFilterDesc').value.trim();
            const isDefault = document.getElementById('savedFilterIsDefault').checked;

            const criteria = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
                search = c.Search ?? "",
                coverLetterKeyword = c.CoverLetterKeyword ?? "",
                jobPostingId = c.JobPostingId,
                stage = (int?)c.Stage,
                source = (int?)c.Source,
                tag = c.Tag ?? "",
                datePreset = c.DatePreset ?? "",
                fromDate = c.FromDate?.ToString("yyyy-MM-dd"),
                toDate = c.ToDate?.ToString("yyyy-MM-dd"),
                minRating = c.MinRating
            }));

            const payload = {
                name: name,
                description: desc,
                isDefault: isDefault,
                criteria: criteria
            };

            const submitBtn = document.getElementById('btnSaveFilterSubmit');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>Đang lưu...';

            try {
                const response = await fetch('/ung-vien/bo-loc/luu', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getCsrfToken()
                    },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                if (result.success) {
                    if (window.NoveraToast) {
                        window.NoveraToast.success(result.message || 'Lưu bộ lọc thành công!');
                    }
                    setTimeout(() => location.reload(), 600);
                } else {
                    if (window.NoveraToast) {
                        window.NoveraToast.error(result.message || 'Không thể lưu bộ lọc.');
                    }
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="bi bi-check2 me-1"></i>Lưu bộ lọc';
                }
            } catch (err) {
                console.error(err);
                if (window.NoveraToast) {
                    window.NoveraToast.error('Có lỗi xảy ra khi lưu bộ lọc. Vui lòng thử lại.');
                }
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="bi bi-check2 me-1"></i>Lưu bộ lọc';
            }
        }

        let pendingFilterToDelete = null;

        // Mở modal xác nhận xóa thay vì confirm()
        function confirmDeleteSavedFilter(filterId, filterName) {
            pendingFilterToDelete = filterId;
            document.getElementById('deleteFilterConfirmText').textContent = `Bạn có chắc muốn xóa bộ lọc "${filterName}" không?`;
            const modalEl = document.getElementById('deleteFilterConfirmModal');
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }

        // Xử lý xóa bộ lọc
        document.getElementById('btnConfirmDeleteFilter')?.addEventListener('click', async function () {
            if (!pendingFilterToDelete) return;
            const filterId = pendingFilterToDelete;
            const modalEl = document.getElementById('deleteFilterConfirmModal');
            const modal = bootstrap.Modal.getInstance(modalEl);

            const formData = new FormData();
            formData.append('filterId', filterId);
            formData.append('__RequestVerificationToken', getCsrfToken());

            try {
                const response = await fetch('/ung-vien/bo-loc/xoa', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': getCsrfToken()
                    },
                    body: formData
                });

                const result = await response.json();
                if (result.success) {
                    if (modal) modal.hide();
                    const el = document.getElementById('savedFilter_' + filterId);
                    if (el) el.remove();
                    if (window.NoveraToast) {
                        window.NoveraToast.info('Đã xóa bộ lọc đã lưu.');
                    }
                } else {
                    if (window.NoveraToast) {
                        window.NoveraToast.error(result.message || 'Không thể xóa bộ lọc.');
                    }
                }
            } catch (err) {
                console.error(err);
                if (window.NoveraToast) {
                    window.NoveraToast.error('Có lỗi xảy ra khi xóa bộ lọc.');
                }
            }
        });
    </script>
}

@* ══════════════════════════════════════════════════════════
   HÀM BỔ TRỢ TẠO URL TRUY VẤN SẠCH (ZERO EMPTY PARAMS)
   ══════════════════════════════════════════════════════════ *@
@functions {
    public string BuildPageUrl(int pageNumber)
    {
        var q = new List<string> { $"Page={pageNumber}" };
        var c = Model.Criteria;
        if (!string.IsNullOrWhiteSpace(c.Search)) q.Add($"Search={Uri.EscapeDataString(c.Search)}");
        if (!string.IsNullOrWhiteSpace(c.CoverLetterKeyword)) q.Add($"CoverLetterKeyword={Uri.EscapeDataString(c.CoverLetterKeyword)}");
        if (c.JobPostingId.HasValue) q.Add($"JobPostingId={c.JobPostingId.Value}");
        if (c.Stage.HasValue) q.Add($"Stage={c.Stage.Value}");
        if (c.Source.HasValue) q.Add($"Source={c.Source.Value}");
        if (!string.IsNullOrWhiteSpace(c.Tag)) q.Add($"Tag={Uri.EscapeDataString(c.Tag)}");
        if (!string.IsNullOrWhiteSpace(c.DatePreset) && c.DatePreset != "all") q.Add($"DatePreset={c.DatePreset}");
        if (c.FromDate.HasValue) q.Add($"FromDate={c.FromDate.Value:yyyy-MM-dd}");
        if (c.ToDate.HasValue) q.Add($"ToDate={c.ToDate.Value:yyyy-MM-dd}");
        if (c.MinRating.HasValue) q.Add($"MinRating={c.MinRating.Value}");
        return "/ung-vien?" + string.Join("&", q);
    }

    public string RemoveQueryParam(params string[] keysToRemove)
    {
        var dict = new Dictionary<string, string>();
        var c = Model.Criteria;
        if (!string.IsNullOrWhiteSpace(c.Search)) dict["Search"] = c.Search;
        if (!string.IsNullOrWhiteSpace(c.CoverLetterKeyword)) dict["CoverLetterKeyword"] = c.CoverLetterKeyword;
        if (c.JobPostingId.HasValue) dict["JobPostingId"] = c.JobPostingId.Value.ToString();
        if (c.Stage.HasValue) dict["Stage"] = c.Stage.Value.ToString();
        if (c.Source.HasValue) dict["Source"] = c.Source.Value.ToString();
        if (!string.IsNullOrWhiteSpace(c.Tag)) dict["Tag"] = c.Tag;
        if (!string.IsNullOrWhiteSpace(c.DatePreset) && c.DatePreset != "all") dict["DatePreset"] = c.DatePreset;
        if (c.FromDate.HasValue) dict["FromDate"] = c.FromDate.Value.ToString("yyyy-MM-dd");
        if (c.ToDate.HasValue) dict["ToDate"] = c.ToDate.Value.ToString("yyyy-MM-dd");
        if (c.MinRating.HasValue) dict["MinRating"] = c.MinRating.Value.ToString();

        foreach (var k in keysToRemove)
        {
            dict.Remove(k);
        }

        if (dict.Count == 0) return "/ung-vien";
        return "/ung-vien?" + string.Join("&", dict.Select(kv => $"{kv.Key}={Uri.EscapeDataString(kv.Value)}"));
    }
}
