@model IReadOnlyList<Ats.Web.Models.ViewModels.Candidates.CandidateListViewModel>
@{
    ViewData["Title"] = "Hồ Sơ Ứng Viên Hợp Nhất — NoveraTech ATS";
    Layout = "_Layout";
    var searchQuery = ViewBag.SearchQuery as string ?? string.Empty;
    var totalCandidates = Model.Count;
    var multiAppCandidates = Model.Count(c => c.ApplicationCount > 1);
    var taggedCandidates = Model.Count(c => c.Tags.Any());
}

@* ══════════════════════════════════════════════════════════
   NOVERATECH ATS — MÀN HÌNH DANH SÁCH ỨNG VIÊN HỢP NHẤT (SCRUM-39)
   Quy chuẩn thiết kế: Coding Convention | Bootstrap 5 | 8px Radius | Cấm rounded-pill
   ══════════════════════════════════════════════════════════ *@

<div class="container-fluid px-3 px-lg-4 py-4">

    <!-- ── Breadcrumb & Top Controls ── -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1" style="font-size: 0.85rem;">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted"><i class="bi bi-house-door me-1"></i>Bàn làm việc</a></li>
                    <li class="breadcrumb-item active fw-semibold text-dark" aria-current="page">Danh sách ứng viên</li>
                </ol>
            </nav>
            <h3 class="fw-bold text-dark mb-0" style="letter-spacing: -0.5px;">
                <i class="bi bi-person-lines-fill me-2" style="color: #059669;"></i>Hồ Sơ Ứng Viên Hợp Nhất
            </h3>
            <p class="text-muted small mb-0 mt-1">
                Quản lý thông tin tập trung, tra cứu nhanh lịch sử ứng tuyển nhiều vị trí, nhãn phân loại và CV của từng ứng viên.
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/" class="btn btn-sm btn-outline-secondary rounded-2">
                <i class="bi bi-arrow-left me-1"></i>Về Trang chủ
            </a>
            <a href="/Jobs" class="btn btn-sm btn-outline-success rounded-2">
                <i class="bi bi-briefcase me-1"></i>Tin tuyển dụng
            </a>
        </div>
    </div>

    <!-- ── KPI / Metric Cards ── -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm bg-white p-3.5 h-100" style="border: 1px solid #E2E8F0 !important; border-radius: 12px;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.72rem;">Tổng số ứng viên</div>
                        <h3 class="fw-bold text-dark mb-0 mt-1" style="font-family: 'JetBrains Mono', monospace;">@totalCandidates</h3>
                    </div>
                    <div class="d-flex align-items-center justify-content-center text-primary" style="width: 44px; height: 44px; background: #EFF6FF; border-radius: 10px;">
                        <i class="bi bi-people-fill fs-5"></i>
                    </div>
                </div>
                <div class="mt-2 text-muted small" style="font-size: 0.78rem;">
                    Dữ liệu ứng viên đã lưu trữ trong cơ sở dữ liệu
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm bg-white p-3.5 h-100" style="border: 1px solid #E2E8F0 !important; border-radius: 12px;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.72rem;">Ứng tuyển nhiều đợt (>= 2)</div>
                        <h3 class="fw-bold text-dark mb-0 mt-1" style="font-family: 'JetBrains Mono', monospace; color: #059669;">@multiAppCandidates</h3>
                    </div>
                    <div class="d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: #ECFDF5; color: #059669; border-radius: 10px;">
                        <i class="bi bi-clock-history fs-5"></i>
                    </div>
                </div>
                <div class="mt-2 text-muted small" style="font-size: 0.78rem;">
                    Ứng viên có lịch sử nộp hồ sơ nhiều vị trí
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm bg-white p-3.5 h-100" style="border: 1px solid #E2E8F0 !important; border-radius: 12px;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.72rem;">Đã gắn nhãn đánh giá</div>
                        <h3 class="fw-bold text-dark mb-0 mt-1" style="font-family: 'JetBrains Mono', monospace; color: #D97706;">@taggedCandidates</h3>
                    </div>
                    <div class="d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: #FFFBEB; color: #D97706; border-radius: 10px;">
                        <i class="bi bi-tags-fill fs-5"></i>
                    </div>
                </div>
                <div class="mt-2 text-muted small" style="font-size: 0.78rem;">
                    Hồ sơ đã được Recruiter phân loại chuyên môn
                </div>
            </div>
        </div>
    </div>

    <!-- ── Search & Filter Section ── -->
    <div class="card border-0 shadow-sm bg-white mb-4" style="border: 1px solid #E2E8F0 !important; border-radius: 12px;">
        <div class="card-body p-3 p-lg-4">
            <form method="get" action="/ung-vien" class="row g-2 align-items-center">
                <div class="col-12 col-md-8 col-lg-9">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0" style="border-color: #E2E8F0; border-radius: 8px 0 0 8px;">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" name="search" class="form-control border-start-0" 
                               placeholder="Tìm theo họ tên, email, số điện thoại hoặc chức danh..." 
                               value="@searchQuery"
                               style="border-color: #E2E8F0; border-radius: 0 8px 8px 0; font-size: 0.9rem;" />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-lg-3 d-flex gap-2">
                    <button type="submit" class="btn btn-success flex-grow-1 fw-semibold rounded-2 py-2" style="font-size: 0.88rem;">
                        <i class="bi bi-funnel me-1"></i>Tìm kiếm
                    </button>
                    @if (!string.IsNullOrWhiteSpace(searchQuery))
                    {
                        <a href="/ung-vien" class="btn btn-outline-secondary rounded-2 py-2" title="Xóa bộ lọc">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- ── Candidates Table List ── -->
    <div class="card border-0 shadow-sm bg-white" style="border: 1px solid #E2E8F0 !important; border-radius: 12px; overflow: hidden;">
        <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center" style="border-bottom: 1px solid #F1F5F9;">
            <div class="d-flex align-items-center gap-2">
                <h6 class="fw-bold text-dark mb-0" style="font-size: 0.95rem;">
                    Danh Sách Ứng Viên (@Model.Count)
                </h6>
                @if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                    <span class="badge bg-light text-secondary border rounded-2 small">
                        Từ khóa: "@searchQuery"
                    </span>
                }
            </div>
            <div class="text-muted small">
                Hiển thị dữ liệu hồ sơ hợp nhất
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5 px-3">
                <div class="d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 64px; height: 64px; background: #F8FAFC; border-radius: 16px; border: 1px solid #E2E8F0;">
                    <i class="bi bi-person-x fs-2 text-muted"></i>
                </div>
                <h6 class="fw-bold text-dark mb-1">Không tìm thấy ứng viên nào</h6>
                <p class="text-muted small mb-3">
                    @(string.IsNullOrWhiteSpace(searchQuery) ? "Chưa có ứng viên nào trong hệ thống." : $"Không có kết quả nào khớp với từ khóa \"{searchQuery}\".")
                </p>
                @if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                    <a href="/ung-vien" class="btn btn-sm btn-outline-secondary rounded-2">
                        <i class="bi bi-arrow-clockwise me-1"></i>Xóa tìm kiếm
                    </a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0" style="min-width: 950px; font-size: 0.85rem;">
                    <thead style="background: #F8FAFC; border-bottom: 1px solid #E2E8F0; color: #64748B; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;">
                        <tr>
                            <th class="py-3 px-4 fw-semibold">Ứng viên</th>
                            <th class="py-3 px-3 fw-semibold">Vị trí gần nhất</th>
                            <th class="py-3 px-3 fw-semibold text-center">Số lần nộp đơn</th>
                            <th class="py-3 px-3 fw-semibold">Nhãn chuyên môn</th>
                            <th class="py-3 px-3 fw-semibold">Ngày nộp gần nhất</th>
                            <th class="py-3 px-4 fw-semibold text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cand in Model)
                        {
                            var initial = string.IsNullOrWhiteSpace(cand.FullName) ? "?" : cand.FullName[..1].ToUpper();
                            <tr style="border-bottom: 1px solid #F1F5F9; transition: background .15s;"
                                onmouseover="this.style.background='#F8FAFC';" onmouseout="this.style.background='#FFFFFF';">
                                
                                <!-- Cột 1: Thông tin ứng viên -->
                                <td class="py-3 px-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="d-flex align-items-center justify-content-center text-white fw-bold shadow-sm flex-shrink-0"
                                             style="width: 42px; height: 42px; border-radius: 10px; background: linear-gradient(135deg, #0F172A 0%, #334155 100%); font-size: 1rem;">
                                            @initial
                                        </div>
                                        <div>
                                            <div class="d-flex align-items-center gap-2">
                                                <a href="/ung-vien/@cand.Id" class="fw-bold text-dark text-decoration-none" style="font-size: 0.92rem;">
                                                    @cand.FullName
                                                </a>
                                                @if (cand.IsBlacklisted)
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-2" style="font-size: 0.68rem;">
                                                        <i class="bi bi-slash-circle me-0.5"></i>Blacklist
                                                    </span>
                                                }
                                            </div>
                                            <div class="d-flex align-items-center gap-2 mt-0.5 text-muted small" style="font-size: 0.75rem;">
                                                <span style="font-family: 'JetBrains Mono', monospace;">@cand.Email</span>
                                                @if (!string.IsNullOrEmpty(cand.Phone))
                                                {
                                                    <span>•</span>
                                                    <span>@cand.Phone</span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrEmpty(cand.CurrentTitle))
                                            {
                                                <div class="text-secondary small mt-0.5" style="font-size: 0.72rem;">
                                                    <i class="bi bi-briefcase me-1"></i>@cand.CurrentTitle @(string.IsNullOrEmpty(cand.CurrentCompany) ? "" : $"tại {cand.CurrentCompany}")
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <!-- Cột 2: Vị trí gần nhất -->
                                <td class="py-3 px-3">
                                    @if (!string.IsNullOrEmpty(cand.LatestJobTitle))
                                    {
                                        <div class="fw-semibold text-dark" style="font-size: 0.88rem;">@cand.LatestJobTitle</div>
                                        @if (!string.IsNullOrEmpty(cand.LatestStageName))
                                        {
                                            <span class="badge mt-1 rounded-2 fw-semibold" 
                                                  style="background: @(cand.LatestStageColor ?? "#2563EB")15; color: @(cand.LatestStageColor ?? "#2563EB"); border: 1px solid @(cand.LatestStageColor ?? "#2563EB")40; font-size: 0.72rem;">
                                                <i class="bi bi-circle-fill me-1" style="font-size: 0.45rem; vertical-align: middle;"></i>@cand.LatestStageName
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Chưa nộp đơn</span>
                                    }
                                </td>

                                <!-- Cột 3: Số lần nộp đơn -->
                                <td class="py-3 px-3 text-center">
                                    @if (cand.ApplicationCount > 1)
                                    {
                                        <span class="badge rounded-2 px-2.5 py-1.5 fw-bold" style="background: #ECFDF5; color: #047857; border: 1px solid #A7F3D0; font-size: 0.75rem;" title="Ứng viên đã nộp nhiều vị trí khác nhau">
                                            <i class="bi bi-layers-fill me-1"></i>@cand.ApplicationCount lần nộp
                                        </span>
                                    }
                                    else if (cand.ApplicationCount == 1)
                                    {
                                        <span class="badge bg-light text-secondary border rounded-2 px-2.5 py-1.5" style="font-size: 0.75rem;">
                                            1 lần nộp
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">0</span>
                                    }
                                </td>

                                <!-- Cột 4: Nhãn (Tags) -->
                                <td class="py-3 px-3">
                                    <div class="d-flex flex-wrap gap-1" style="max-width: 250px;">
                                        @if (cand.Tags.Any())
                                        {
                                            @foreach (var tag in cand.Tags.Take(3))
                                            {
                                                <span class="badge rounded-2" 
                                                      style="background: @(tag.ColorCode)15; color: @tag.ColorCode; border: 1px solid @(tag.ColorCode)40; font-size: 0.72rem; font-weight: 600;">
                                                    @tag.TagName
                                                </span>
                                            }
                                            @if (cand.Tags.Count > 3)
                                            {
                                                <span class="badge bg-light text-muted border rounded-2" style="font-size: 0.68rem;">
                                                    +@(cand.Tags.Count - 3)
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small" style="font-size: 0.72rem;">Chưa có nhãn</span>
                                        }
                                    </div>
                                </td>

                                <!-- Cột 5: Ngày nộp gần nhất -->
                                <td class="py-3 px-3 text-muted" style="font-family: 'JetBrains Mono', monospace; font-size: 0.78rem;">
                                    @cand.FormattedLatestAppliedAt
                                </td>

                                <!-- Cột 6: Hành động -->
                                <td class="py-3 px-4 text-end">
                                    <a href="/ung-vien/@cand.Id" 
                                       class="btn btn-sm btn-outline-success fw-semibold rounded-2 px-3 py-1.5" 
                                       style="font-size: 0.8rem;"
                                       title="Mở hồ sơ hợp nhất và lịch sử ứng tuyển">
                                        <i class="bi bi-person-lines-fill me-1"></i>Hồ sơ hợp nhất
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
