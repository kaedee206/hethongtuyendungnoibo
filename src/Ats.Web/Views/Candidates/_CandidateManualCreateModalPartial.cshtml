@using Ats.Web.Models.Enums

@* ══════════════════════════════════════════════════════════
   NOVERATECH ATS — MODAL THÊM ỨNG VIÊN THỦ CÔNG / LINKEDIN (SCRUM-47)
   Hỗ trợ AJAX Submit, Realtime Duplicate Check, 8px Radius, CSRF Protected
   ══════════════════════════════════════════════════════════ *@

<div class="modal fade" id="manualCandidateCreateModal" tabindex="-1" aria-labelledby="manualCandidateCreateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
            <div class="modal-header py-3 px-4 bg-white" style="border-bottom: 1px solid #F1F5F9;">
                <div class="d-flex align-items-center gap-2.5">
                    <span class="d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px; border-radius: 8px; background: #0A66C2; color: #FFFFFF;">
                        <i class="bi bi-linkedin"></i>
                    </span>
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="manualCandidateCreateModalLabel" style="font-size: 1.05rem;">
                            Thêm Ứng Viên Vào Vị Trí Tuyển Dụng
                        </h5>
                        <div class="text-muted small" style="font-size: 0.75rem;">
                            Thêm nhanh ứng viên từ LinkedIn, Headhunt hoặc nộp trực tiếp vào pipeline
                        </div>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <form id="manualCandidateModalForm" enctype="multipart/form-data" novalidate>
                    @Html.AntiForgeryToken()

                    <div id="modalFormAlert" class="alert alert-danger d-none mb-3 p-3 small shadow-sm" style="border-radius: 8px;"></div>

                    <!-- Vị trí tuyển dụng mục tiêu -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark small mb-1">
                            Vị trí tuyển dụng mục tiêu <span class="text-danger">*</span>
                        </label>
                        <select name="JobPostingId" id="modalJobPostingSelect" class="form-select form-select-sm" style="border-color: #CBD5E1; border-radius: 8px;" required>
                            <option value="">-- Đang tải danh sách vị trí... --</option>
                        </select>
                    </div>

                    <!-- Hộp cảnh báo kiểm tra trùng lặp realtime -->
                    <div id="modalDuplicateAlert" class="mb-3 d-none">
                        <div class="alert p-3 shadow-sm d-flex align-items-start gap-2.5" id="modalDuplicateAlertContent" style="border-radius: 8px; border-left: 4px solid;">
                            <div id="modalDuplicateAlertIcon" class="fs-5 mt-0.5"></div>
                            <div class="flex-grow-1 small">
                                <div class="fw-bold mb-0.5" id="modalDuplicateAlertTitle"></div>
                                <div id="modalDuplicateAlertMessage"></div>
                                <div class="mt-1.5 d-none" id="modalDuplicateAlertAction">
                                    <a id="btnModalViewExisting" href="#" target="_blank" class="btn btn-xs btn-outline-dark rounded-2 py-0.5 px-2" style="font-size: 0.75rem;">
                                        <i class="bi bi-box-arrow-up-right me-1"></i>Xem hồ sơ cũ
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-2.5 mb-3">
                        <!-- Họ và tên -->
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark small mb-1">
                                Họ và tên ứng viên <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white" style="border-color: #CBD5E1; border-radius: 8px 0 0 8px;">
                                    <i class="bi bi-person text-muted"></i>
                                </span>
                                <input name="FullName" id="modalFullName" type="text" class="form-control form-control-sm" placeholder="Nguyễn Văn A" style="border-color: #CBD5E1; border-radius: 0 8px 8px 0;" required />
                            </div>
                        </div>

                        <!-- Nguồn ứng viên -->
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark small mb-1">
                                Nguồn ứng viên <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white" style="border-color: #CBD5E1; border-radius: 8px 0 0 8px;">
                                    <i class="bi bi-diagram-3 text-muted"></i>
                                </span>
                                <select name="Source" id="modalSource" class="form-select form-select-sm" style="border-color: #CBD5E1; border-radius: 0 8px 8px 0;">
                                    <option value="@CandidateSource.LINKEDIN" selected>LinkedIn (Sourcing)</option>
                                    <option value="@CandidateSource.HEADHUNTER">Headhunter</option>
                                    <option value="@CandidateSource.REFERRAL">Giới thiệu nội bộ</option>
                                    <option value="@CandidateSource.DIRECT">Nộp trực tiếp</option>
                                    <option value="@CandidateSource.OTHER">Khác</option>
                                </select>
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark small mb-1 d-flex align-items-center justify-content-between">
                                <span>Email <span class="text-danger">*</span></span>
                                <span id="modalEmailSpinner" class="spinner-border spinner-border-sm text-primary d-none" role="status"></span>
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white" style="border-color: #CBD5E1; border-radius: 8px 0 0 8px;">
                                    <i class="bi bi-envelope text-muted"></i>
                                </span>
                                <input name="Email" id="modalEmail" type="email" class="form-control form-control-sm" placeholder="email@example.com" style="border-color: #CBD5E1; border-radius: 0 8px 8px 0;" required />
                            </div>
                        </div>

                        <!-- Số điện thoại -->
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-dark small mb-1 d-flex align-items-center justify-content-between">
                                <span>Số điện thoại (VN 10 số)</span>
                                <span id="modalPhoneSpinner" class="spinner-border spinner-border-sm text-primary d-none" role="status"></span>
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white" style="border-color: #CBD5E1; border-radius: 8px 0 0 8px;">
                                    <i class="bi bi-telephone text-muted"></i>
                                </span>
                                <input name="PhoneNumber" id="modalPhone" type="tel" class="form-control form-control-sm" placeholder="0912345678" style="border-color: #CBD5E1; border-radius: 0 8px 8px 0;" />
                            </div>
                        </div>

                        <!-- LinkedIn URL -->
                        <div class="col-12">
                            <label class="form-label fw-semibold text-dark small mb-1">
                                Đường dẫn LinkedIn
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white" style="border-color: #CBD5E1; border-radius: 8px 0 0 8px; color: #0A66C2;">
                                    <i class="bi bi-linkedin"></i>
                                </span>
                                <input name="LinkedInUrl" id="modalLinkedInUrl" type="url" class="form-control form-control-sm" placeholder="https://www.linkedin.com/in/..." style="border-color: #CBD5E1; border-radius: 0 8px 8px 0;" />
                            </div>
                        </div>
                    </div>

                    <!-- Tệp đính kèm CV -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark small mb-1">
                            Tệp CV đính kèm (.PDF, .DOC, .DOCX - Tối đa 10MB)
                        </label>
                        <input type="file" name="CvFile" id="modalCvFile" class="form-control form-control-sm" accept=".pdf,.doc,.docx" style="border-color: #CBD5E1; border-radius: 8px;" />
                    </div>

                    <!-- Ghi chú ban đầu -->
                    <div class="mb-1">
                        <label class="form-label fw-semibold text-dark small mb-1">
                            Ghi chú / Nhận xét sơ bộ của Recruiter
                        </label>
                        <textarea name="Note" id="modalNote" class="form-control form-control-sm" rows="3" placeholder="Nhận xét ban đầu, lý do tìm kiếm từ LinkedIn..." style="border-color: #CBD5E1; border-radius: 8px;"></textarea>
                    </div>
                </form>
            </div>

            <div class="modal-footer py-2.5 px-4 bg-light" style="border-top: 1px solid #E2E8F0;">
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-2 px-3" data-bs-dismiss="modal">
                    Hủy bỏ
                </button>
                <button type="button" class="btn btn-sm btn-success rounded-2 px-4 shadow-sm d-flex align-items-center gap-1.5" id="btnModalSubmitCandidate" style="background: #059669; border-color: #059669;">
                    <i class="bi bi-check2-circle"></i>
                    <span id="modalBtnText">Lưu &amp; Thêm vào Pipeline</span>
                    <span id="modalBtnSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        const modal = document.getElementById('manualCandidateCreateModal');
        if (!modal) return;

        const form = document.getElementById('manualCandidateModalForm');
        const jobSelect = document.getElementById('modalJobPostingSelect');
        const emailInput = document.getElementById('modalEmail');
        const phoneInput = document.getElementById('modalPhone');
        const btnSubmit = document.getElementById('btnModalSubmitCandidate');
        const btnText = document.getElementById('modalBtnText');
        const btnSpinner = document.getElementById('modalBtnSpinner');
        const formAlert = document.getElementById('modalFormAlert');
        const duplicateAlert = document.getElementById('modalDuplicateAlert');
        const duplicateContent = document.getElementById('modalDuplicateAlertContent');
        const duplicateIcon = document.getElementById('modalDuplicateAlertIcon');
        const duplicateTitle = document.getElementById('modalDuplicateAlertTitle');
        const duplicateMessage = document.getElementById('modalDuplicateAlertMessage');
        const duplicateAction = document.getElementById('modalDuplicateAlertAction');
        const btnViewExisting = document.getElementById('btnModalViewExisting');
        const emailSpinner = document.getElementById('modalEmailSpinner');
        const phoneSpinner = document.getElementById('modalPhoneSpinner');

        let debounceTimer = null;
        let jobListLoaded = false;

        // Khi mở modal, nạp danh sách tin tuyển dụng nếu chưa có
        modal.addEventListener('show.bs.modal', async function (event) {
            formAlert.classList.add('d-none');
            duplicateAlert.classList.add('d-none');
            btnSubmit.disabled = false;

            const button = event.relatedTarget;
            const preselectedJobId = button ? button.getAttribute('data-job-id') : null;

            if (!jobListLoaded || preselectedJobId) {
                await loadPublishedJobs(preselectedJobId);
            }
        });

        async function loadPublishedJobs(selectedId) {
            try {
                // Tạo request lấy danh sách tin tuyển dụng từ trang them-thu-cong
                const res = await fetch('/ung-vien/them-thu-cong', {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                // Nếu gọi view, ta có thể lấy options từ API hoặc fetch
            } catch (e) {
                console.error(e);
            }
        }

        function triggerModalDuplicateCheck() {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(checkDuplicateInModal, 500);
        }

        emailInput.addEventListener('input', triggerModalDuplicateCheck);
        phoneInput.addEventListener('input', triggerModalDuplicateCheck);
        jobSelect.addEventListener('change', triggerModalDuplicateCheck);

        async function checkDuplicateInModal() {
            const email = emailInput.value.trim();
            const phone = phoneInput.value.trim();
            const jobId = jobSelect.value.trim();

            if (!email && !phone) {
                duplicateAlert.classList.add('d-none');
                btnSubmit.disabled = false;
                return;
            }

            if (email) emailSpinner.classList.remove('d-none');
            if (phone) phoneSpinner.classList.remove('d-none');

            try {
                const res = await fetch(`/ung-vien/kiem-tra-trung?email=${encodeURIComponent(email)}&phoneNumber=${encodeURIComponent(phone)}&jobPostingId=${encodeURIComponent(jobId)}`, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (!res.ok) return;
                const data = await res.json();

                if (!data.isDuplicate) {
                    duplicateAlert.classList.add('d-none');
                    btnSubmit.disabled = false;
                    return;
                }

                duplicateAlert.classList.remove('d-none');

                if (data.hasActiveApplicationInSameJob) {
                    duplicateContent.className = 'alert alert-danger p-3 shadow-sm d-flex align-items-start gap-2.5';
                    duplicateContent.style.borderLeft = '4px solid #DC2626';
                    duplicateContent.style.background = '#FEF2F2';
                    duplicateIcon.innerHTML = '<i class="bi bi-x-circle-fill text-danger"></i>';
                    duplicateTitle.className = 'fw-bold mb-0.5 text-danger';
                    duplicateTitle.innerText = 'Trùng lặp: Đã có đơn ứng tuyển cho vị trí này!';
                    duplicateMessage.innerText = data.message || 'Không thể thêm trùng lặp hồ sơ vào cùng một vị trí.';
                    
                    if (data.existingCandidateId) {
                        btnViewExisting.href = `/ung-vien/${data.existingCandidateId}`;
                        duplicateAction.classList.remove('d-none');
                    } else {
                        duplicateAction.classList.add('d-none');
                    }

                    btnSubmit.disabled = true;
                } else {
                    duplicateContent.className = 'alert alert-warning p-3 shadow-sm d-flex align-items-start gap-2.5';
                    duplicateContent.style.borderLeft = '4px solid #F59E0B';
                    duplicateContent.style.background = '#FFFBEB';
                    duplicateIcon.innerHTML = '<i class="bi bi-exclamation-triangle-fill text-warning"></i>';
                    duplicateTitle.className = 'fw-bold mb-0.5 text-dark';
                    duplicateTitle.innerText = `Ứng viên đã có hồ sơ trong hệ thống (${data.matchedBy})`;
                    duplicateMessage.innerText = data.message || 'Hồ sơ sẽ được tự động liên kết vào vị trí tuyển dụng này.';
                    
                    if (data.existingCandidateId) {
                        btnViewExisting.href = `/ung-vien/${data.existingCandidateId}`;
                        duplicateAction.classList.remove('d-none');
                    } else {
                        duplicateAction.classList.add('d-none');
                    }

                    btnSubmit.disabled = false;
                }
            } catch (err) {
                console.error(err);
            } finally {
                emailSpinner.classList.add('d-none');
                phoneSpinner.classList.add('d-none');
            }
        }

        // Xử lý Submit AJAX từ Modal
        btnSubmit.addEventListener('click', async function (e) {
            e.preventDefault();
            formAlert.classList.add('d-none');

            const jobId = jobSelect.value;
            const fullName = document.getElementById('modalFullName').value.trim();
            const email = emailInput.value.trim();

            if (!jobId) {
                showModalError('Vui lòng chọn vị trí tuyển dụng cho ứng viên.');
                jobSelect.focus();
                return;
            }
            if (!fullName) {
                showModalError('Họ và tên ứng viên không được để trống.');
                document.getElementById('modalFullName').focus();
                return;
            }
            if (!email) {
                showModalError('Địa chỉ email không được để trống.');
                emailInput.focus();
                return;
            }

            const formData = new FormData(form);
            btnSubmit.disabled = true;
            btnText.innerText = 'Đang lưu hồ sơ...';
            btnSpinner.classList.remove('d-none');

            try {
                const response = await fetch('/ung-vien/them-thu-cong', {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: formData
                });

                const result = await response.json();

                if (result.success) {
                    // Thành công: chuyển trang chi tiết ứng viên
                    window.location.href = result.redirectUrl || `/ung-vien/${result.candidateId}`;
                } else {
                    showModalError(result.message || 'Không thể lưu hồ sơ ứng viên.');
                    btnSubmit.disabled = false;
                    btnText.innerText = 'Lưu & Thêm vào Pipeline';
                    btnSpinner.classList.add('d-none');
                }
            } catch (error) {
                console.error(error);
                showModalError('Đã có lỗi hệ thống xảy ra khi gửi biểu mẫu.');
                btnSubmit.disabled = false;
                btnText.innerText = 'Lưu & Thêm vào Pipeline';
                btnSpinner.classList.add('d-none');
            }
        });

        function showModalError(msg) {
            formAlert.innerText = msg;
            formAlert.classList.remove('d-none');
        }
    })();
</script>
