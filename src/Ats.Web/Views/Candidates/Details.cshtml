<!-- MODAL XEM CHI TIẾT CV KHỔ LỚN SẮC NÉT (A4 Full-Size Reader) -->
<!-- ══════════════════════════════════════════════════════════════ -->
<div class="modal fade" id="cvDetailModal" tabindex="-1" aria-labelledby="cvDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" style="max-width: 92vw;">
        <div class="modal-content shadow-lg border-0 rounded-3 overflow-hidden">
            <div class="modal-header bg-white text-dark py-2.5 px-3 border-bottom d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <div class="p-1.5 rounded-2" style="background:#ECFDF5; color: #047857;">
                        <i class="bi bi-file-earmark-pdf fs-6"></i>
                    </div>
                    <div>
                        <h6 class="modal-title fw-bold mb-0 text-dark" id="cvDetailModalLabel" style="font-size: 0.95rem;">
                            Chi Tiết Hồ Sơ CV: <span class="text-success">@Model.FullName</span>
                        </h6>
                        <div class="d-flex align-items-center gap-2 text-muted" style="font-size: 0.74rem;">
                            <span id="modalCvFileNameText"><i class="bi bi-file-text me-1"></i>@(Model.ActiveResume?.FileName ?? "CV.pdf")</span>
                            <span>•</span>
                            <span>Khổ A4 Dọc (1 trang)</span>
                            <span>•</span>
                            <span>Bảo mật theo Nghị định 13/2023/NĐ-CP</span>
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    @if (Model.ActiveResume != null)
                    {
                        <a id="btnModalDownloadCv" href="@Url.Action("DownloadCv", "Candidates", new { resumeId = Model.ActiveResume.ResumeId })" 
                           target="_blank" class="btn btn-sm btn-outline-success rounded-2 px-3 py-1 fw-medium" style="font-size: 0.8rem;">
                            <i class="bi bi-download me-1"></i>Tải file PDF gốc
                        </a>
                        <a id="btnModalOpenTabCv" href="@Url.Action("PreviewCv", "Candidates", new { resumeId = Model.ActiveResume.ResumeId })" 
                           target="_blank" class="btn btn-sm btn-outline-secondary rounded-2 px-2.5 py-1" title="Mở tab riêng trong trình duyệt" style="font-size: 0.8rem;">
                            <i class="bi bi-box-arrow-up-right me-1"></i>Tab riêng
                        </a>
                    }
                    <button type="button" class="btn-close ms-2" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
