            <div class="modal-body p-0 position-relative" style="background: #F1F5F9; height: 85vh;">
                @if (Model.ActiveResume != null)
                {
                    <iframe id="cvModalIframe"
                            src="@Url.Action("PreviewCv", "Candidates", new { resumeId = Model.ActiveResume.ResumeId })#toolbar=1&navpanes=0&view=FitH"
                            style="width: 100%; height: 100%; border: none; display: block;"
                            title="Bản xem chi tiết CV khổ lớn của ứng viên">
                    </iframe>
                }
                else
                {
                    <div class="text-center py-5 px-3 text-muted d-flex flex-column align-items-center justify-content-center h-100">
                        <i class="bi bi-file-earmark-x display-4 text-secondary mb-2"></i>
                        <p class="fw-semibold mb-1">Ứng viên chưa tải lên tệp CV đính kèm.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/interview-conflict.js"></script>
<script>
    const candidateId = '@Model.CandidateId';

    // 0. Mở Modal xem chi tiết CV khổ lớn sắc nét
    function openCvDetailModal() {
        const modalEl = document.getElementById('cvDetailModal');
        if (modalEl) {
            const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
            bsModal.show();
        }
    }

    // 1. Hàm tương thích autoResizeCvIframe (khung nhìn PDF A4 cố định theo viewport)
    function autoResizeCvIframe(iframe) {
        // Cố định chiều cao iframe theo CSS fit-to-frame, không kéo dãn trang
    }

    // 2. Chuyển đổi xem trước CV khi có nhiều bản CV
    function switchCvPreview(previewUrl) {
        const iframe = document.getElementById('cvPreviewIframe');
        const modalIframe = document.getElementById('cvModalIframe');
        const openBtn = document.getElementById('btnOpenCvNewTab');
        const modalOpenBtn = document.getElementById('btnModalOpenTabCv');
        const dlBtn = document.getElementById('btnDownloadCvFile');
        const modalDlBtn = document.getElementById('btnModalDownloadCv');
        const select = document.getElementById('cvSelectDropdown');
        
        const cleanUrl = previewUrl ? previewUrl.split('#')[0] : '';
        if (iframe && cleanUrl) {
            iframe.src = cleanUrl + '#toolbar=0&navpanes=0&view=Fit';
        }
        if (modalIframe && cleanUrl) {
            modalIframe.src = cleanUrl + '#toolbar=1&navpanes=0&view=FitH';
        }
        if (openBtn && cleanUrl) {
            openBtn.href = cleanUrl;
        }
        if (modalOpenBtn && cleanUrl) {
            modalOpenBtn.href = cleanUrl;
        }
        if (select) {
            const selectedOpt = select.options[select.selectedIndex];
            const fileName = selectedOpt.getAttribute('data-filename') || 'CV.pdf';
            const size = selectedOpt.getAttribute('data-size') || '';
            const val = selectedOpt.value || '';
            const resumeId = val.split('/').pop().split('?')[0] || '';
            if (resumeId) {
                const downloadUrl = `/ung-vien/DownloadCv/${resumeId}`;
                if (dlBtn) dlBtn.href = downloadUrl;
                if (modalDlBtn) modalDlBtn.href = downloadUrl;
            }
            const infoText = document.getElementById('cvFileInfoText');
            if (infoText) {
                infoText.innerHTML = `<i class="bi bi-check2-circle text-success me-1"></i>Tệp đính kèm: <b>${fileName}</b> (${size})`;
            }
            const modalFileNameText = document.getElementById('modalCvFileNameText');
            if (modalFileNameText) {
                modalFileNameText.innerHTML = `<i class="bi bi-file-text me-1"></i>${fileName}`;
            }
        }
    }

    // 2. Thêm nhãn nhanh từ danh mục gợi ý
    function addQuickTag(tagName) {
        const input = document.getElementById('customTagNameInput');
        if (input) {
            input.value = tagName;
            document.getElementById('addTagForm').requestSubmit();
        }
    }

    // 3. Xử lý Thêm Nhãn qua AJAX
    async function handleTagFormSubmit(e) {
        e.preventDefault();
        const input = document.getElementById('customTagNameInput');
        const tagName = input.value.trim();
        if (!tagName) return;

        const form = document.getElementById('addTagForm');
        const formData = new FormData(form);
        const submitBtn = document.getElementById('btnAddTagSubmit');
        submitBtn.disabled = true;

        try {
            const response = await fetch(form.action, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData
            });

            const result = await response.json();
            if (result.success && result.data) {
                const tag = result.data;
                const container = document.getElementById('candidateTagsContainer');
                const noTags = document.getElementById('noTagsText');
                if (noTags) noTags.remove();

                // Tạo chip nhãn mới
                const span = document.createElement('span');
                span.id = `tag-pill-${tag.id}`;
                span.className = 'candidate-tag-chip rounded-2 px-2.5 py-1 text-white d-inline-flex align-items-center gap-1.5 shadow-xs';
                span.style.background = tag.colorCode || '#047857';
                span.style.fontSize = '0.78rem';
                span.style.fontWeight = '500';
                span.innerHTML = `
                    <i class="bi bi-tag-fill" style="font-size:0.65rem;"></i>
                    <span>${tag.tagName}</span>
                    <button type="button" class="btn btn-link text-white p-0 ms-1" style="line-height:1; opacity:0.85;" onclick="removeCandidateTag('${tag.id}')" title="Gỡ nhãn này">
                        <i class="bi bi-x-circle-fill" style="font-size:0.75rem;"></i>
                    </button>
                `;
                container.appendChild(span);
                input.value = '';

                // Cập nhật đếm
                updateTagsCount(1);
            } else {
                alert(result.message || 'Lỗi khi gắn nhãn.');
            }
        } catch (err) {
            alert('Lỗi kết nối: ' + err.message);
        } finally {
            submitBtn.disabled = false;
        }
    }

    // 4. Xóa Nhãn qua AJAX
    async function removeCandidateTag(tagId) {
        if (!confirm('Bạn có chắc chắn muốn gỡ nhãn này?')) return;

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const formData = new FormData();
        formData.append('tagId', tagId);
        formData.append('candidateId', candidateId);
        if (token) formData.append('__RequestVerificationToken', token);

        try {
            const response = await fetch('/ung-vien/RemoveTag', {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: formData
            });
            const result = await response.json();
            if (result.success) {
                const el = document.getElementById(`tag-pill-${tagId}`);
                if (el) el.remove();
                updateTagsCount(-1);
            } else {
                alert(result.message || 'Không thể xóa nhãn.');
            }
        } catch (err) {
            alert('Lỗi kết nối: ' + err.message);
        }
    }

    function updateTagsCount(delta) {
        const badge = document.getElementById('tagsCountBadge');
        if (badge) {
            const cur = parseInt(badge.innerText, 10) || 0;
            const next = Math.max(0, cur + delta);
            badge.innerText = `${next} nhãn`;
        }
    }

    // 5. Xử lý Thêm Ghi Chú qua AJAX
    async function handleNoteFormSubmit(e) {
        e.preventDefault();
        const textarea = document.getElementById('noteContentInput');
        const content = textarea.value.trim();
        if (!content) return;

        const form = document.getElementById('addNoteForm');
        const formData = new FormData(form);
        const submitBtn = document.getElementById('btnAddNoteSubmit');
        submitBtn.disabled = true;

        try {
            const response = await fetch(form.action, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: formData
            });
            const result = await response.json();
            if (result.success && result.data) {
                const note = result.data;
                const container = document.getElementById('candidateNotesContainer');
                const noNotes = document.getElementById('noNotesText');
                if (noNotes) noNotes.remove();

                const noteDiv = document.createElement('div');
                noteDiv.id = `note-item-${note.id}`;
                noteDiv.className = 'py-2.5 border-bottom';
                noteDiv.style.borderColor = '#F1F5F9';
                noteDiv.innerHTML = `
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <div class="d-flex align-items-center gap-1.5">
                            <span class="fw-bold text-dark" style="font-size: 0.82rem;">${note.authorName}</span>
                            <span class="badge ${note.noteTypeClass} rounded-pill" style="font-size: 0.65rem;">${note.noteTypeBadge}</span>
                        </div>
                        <div class="d-flex align-items-center gap-1.5">
                            <span class="text-muted font-monospace" style="font-size: 0.7rem;">${note.formattedCreatedAt}</span>
                            <button type="button" class="btn btn-link p-0 text-danger ms-1" onclick="deleteCandidateNote('${note.id}')" title="Xóa ghi chú này">
                                <i class="bi bi-trash" style="font-size: 0.75rem;"></i>
                            </button>
                        </div>
                    </div>
                    <p class="mb-0 text-secondary" style="font-size: 0.82rem; line-height: 1.45; white-space: pre-line;">${escapeHtml(note.content)}</p>
                `;
                container.prepend(noteDiv);
                textarea.value = '';
                updateNotesCount(1);
            } else {
                alert(result.message || 'Lỗi khi lưu ghi chú.');
            }
        } catch (err) {
            alert('Lỗi kết nối: ' + err.message);
        } finally {
            submitBtn.disabled = false;
        }
    }

    // 6. Xóa Ghi Chú qua AJAX
    async function deleteCandidateNote(noteId) {
        if (!confirm('Bạn có chắc chắn muốn xóa ghi chú này?')) return;

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const formData = new FormData();
        formData.append('noteId', noteId);
        formData.append('candidateId', candidateId);
        if (token) formData.append('__RequestVerificationToken', token);

        try {
            const response = await fetch('/ung-vien/DeleteNote', {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: formData
            });
            const result = await response.json();
            if (result.success) {
                const el = document.getElementById(`note-item-${noteId}`);
                if (el) el.remove();
                updateNotesCount(-1);
            } else {
                alert(result.message || 'Không thể xóa ghi chú.');
            }
        } catch (err) {
            alert('Lỗi kết nối: ' + err.message);
        }
    }

    function updateNotesCount(delta) {
        const badge = document.getElementById('notesCountBadge');
        if (badge) {
            const cur = parseInt(badge.innerText, 10) || 0;
            const next = Math.max(0, cur + delta);
            badge.innerText = `${next} ghi chú`;
        }
    }

    function escapeHtml(text) {
        const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return text.replace(/[&<>"']/g, m => map[m]);
    }

    // 7. SCRUM - SỐ 51: ĐẶT LỊCH PHỎNG VẤN ỨNG VIÊN
    let cachedInterviewersList = null;

    async function loadCandidateInterviewers() {
        const container = document.getElementById('candSchedPanelistsContainer');
        if (!container) return;

        if (cachedInterviewersList && cachedInterviewersList.length > 0) {
            renderCandidateInterviewers(cachedInterviewersList);
            return;
        }

        try {
            const res = await fetch('/Workspace/GetInterviewers', {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            const result = await res.json();
            const list = result.interviewers || result.data || [];
            cachedInterviewersList = list;
            renderCandidateInterviewers(list);
        } catch (e) {
            container.innerHTML = '<div class="text-danger small py-1">Không thể tải danh sách người phỏng vấn. Vui lòng thử lại sau.</div>';
        }
    }

    function renderCandidateInterviewers(list) {
        const container = document.getElementById('candSchedPanelistsContainer');
        if (!container) return;

        if (!list || list.length === 0) {
            container.innerHTML = '<div class="text-muted small py-1">Chưa có tài khoản người phỏng vấn nào khả dụng trong hệ thống.</div>';
            return;
        }

        container.innerHTML = list.map((u, idx) => {
            const uId = u.id || u.Id;
            const uName = u.fullName || u.name || u.FullName || 'Nhân sự';
            const uEmail = u.email || u.Email || '';
            const uRole = u.role || u.Role || 'Interviewer';
            const initial = (uName.trim()[0] || 'U').toUpperCase();

            return `
                <div class="form-check d-flex align-items-center justify-content-between py-1 px-1 border-bottom last-border-0" style="font-size: 0.8rem;">
                    <div class="d-flex align-items-center gap-2">
                        <input class="form-check-input mt-0 cand-interviewer-checkbox" type="checkbox" value="${uId}" id="cand_iv_${uId}" ${idx === 0 ? 'checked' : ''} onchange="validateCandidatePanelists()">
                        <label class="form-check-label d-flex align-items-center gap-2 cursor-pointer mb-0" for="cand_iv_${uId}">
                            <div class="d-flex align-items-center justify-content-center text-white fw-bold rounded-circle" style="width:24px; height:24px; background:#047857; font-size:0.7rem;">
                                ${initial}
                            </div>
                            <div>
                                <span class="fw-semibold text-dark">${escapeHtml(uName)}</span>
                                <span class="text-muted" style="font-size:0.72rem;">(${escapeHtml(uEmail)})</span>
                            </div>
                        </label>
                    </div>
                    <span class="badge rounded-2 bg-light text-secondary border px-2 py-0.5" style="font-size:0.68rem;">${escapeHtml(uRole)}</span>
                </div>
            `;
        }).join('');
    }

    function onCandidateRoundChange(roundVal) {
        const titleInput = document.getElementById('candSchedRoundTitle');
        if (!titleInput) return;
        const titles = {
            '1': 'Phỏng vấn sơ loại (HR Screening)',
            '2': 'Phỏng vấn chuyên môn kỹ thuật (Technical)',
            '3': 'Phỏng vấn Văn hóa & Ban Giám đốc',
            '4': 'Đánh giá thực chiến / Bài tập tình huống',
            '5': 'Thương thảo chế độ đãi ngộ (Offer Negotiation)'
        };
        titleInput.value = titles[roundVal] || `Phỏng vấn Vòng ${roundVal}`;
    }

    function onCandidateInterviewTypeChange(typeVal) {
        const label = document.getElementById('candSchedLocationLabel');
        const icon = document.getElementById('candSchedLocationIcon');
        const input = document.getElementById('candSchedLocationOrLink');
        const roomGroup = document.getElementById('candSchedMeetingRoomGroup');
        if (!label || !input) return;

        if (typeVal === 'ONLINE_MEET') {
            if (roomGroup) roomGroup.style.display = 'none';
            label.innerHTML = 'Liên kết họp trực tuyến (Google Meet / MS Teams / Zoom) <span class="text-danger">*</span>';
            icon.innerHTML = '<i class="bi bi-link-45deg text-primary"></i>';
            input.placeholder = 'https://meet.google.com/nov-interview-room';
            if (!input.value || input.value.startsWith('Phòng')) {
                input.value = 'https://meet.google.com/nov-' + Math.random().toString(36).substring(2, 6) + '-' + Math.random().toString(36).substring(2, 5);
            }
        } else {
            if (roomGroup) {
                roomGroup.style.display = 'block';
                loadCandidateMeetingRooms();
            }
            label.innerHTML = 'Phòng họp & Địa điểm phỏng vấn trực tiếp <span class="text-danger">*</span>';
            icon.innerHTML = '<i class="bi bi-building text-info"></i>';
            input.placeholder = 'Phòng Họp Tầng 12 - Tòa nhà NoveraTech, Cầu Giấy, Hà Nội';
            if (!input.value || input.value.startsWith('https://')) {
                input.value = 'Phòng Hội nghị Tầng 12 - Trụ sở NoveraTech';
            }
        }

        triggerCandConflictCheck();
    }

    let candMeetingRoomsLoaded = false;
    async function loadCandidateMeetingRooms() {
        if (candMeetingRoomsLoaded) return;
        const select = document.getElementById('candSchedMeetingRoomId');
        if (!select) return;

        try {
            const res = await fetch('/interviews/danh-sach-phong-hop', {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            const json = await res.json();
            const list = json.data || json;
            if (Array.isArray(list) && list.length > 0) {
                select.innerHTML = '<option value="">-- Chọn phòng họp khả dụng --</option>' +
                    list.map(r => `<option value="${r.id}">${escapeHtml(r.name)}</option>`).join('');
                candMeetingRoomsLoaded = true;
            }
        } catch (e) {
            console.warn('Lỗi khi tải danh sách phòng họp:', e);
        }
    }

    function onCandidateMeetingRoomChange(selectEl) {
        if (!selectEl) return;
        const selectedText = selectEl.options[selectEl.selectedIndex]?.text;
        const locInput = document.getElementById('candSchedLocationOrLink');
        if (locInput && selectEl.value && selectedText && !selectedText.startsWith('--')) {
            locInput.value = selectedText;
        }
        triggerCandConflictCheck();
    }

    function triggerCandConflictCheck() {
        if (!window.interviewConflict) return;
        const timeVal = document.getElementById('candSchedStartTime')?.value;
        const durationVal = document.getElementById('candSchedDuration')?.value || 60;
        const locVal = document.getElementById('candSchedLocationOrLink')?.value;
        const roomIdVal = document.getElementById('candSchedMeetingRoomId')?.value;
        const checkboxes = document.querySelectorAll('.cand-interviewer-checkbox:checked');
        const interviewerIds = Array.from(checkboxes).map(c => c.value);

        window.interviewConflict.scheduleCheck({
            startTime: timeVal,
            durationMinutes: durationVal,
            interviewerIds: interviewerIds,
            meetingRoomId: roomIdVal,
            locationOrLink: locVal,
            submitBtnId: 'btnCandidateSchedSubmit'
        });
    }

    function validateCandidateScheduleDateTime() {
        const timeInput = document.getElementById('candSchedStartTime');
        const errEl = document.getElementById('candSchedPastError');
        const submitBtn = document.getElementById('btnCandidateSchedSubmit');
        if (!timeInput) return true;

        const val = timeInput.value;
        if (!val) return false;

        const selectedDate = new Date(val);
        const now = new Date();

        if (selectedDate <= now) {
            if (errEl) errEl.classList.remove('d-none');
            timeInput.classList.add('is-invalid');
            if (submitBtn) submitBtn.disabled = true;
            return false;
        } else {
            if (errEl) errEl.classList.add('d-none');
            timeInput.classList.remove('is-invalid');
            if (submitBtn) submitBtn.disabled = false;
            triggerCandConflictCheck();
            return true;
        }
    }

    function validateCandidatePanelists() {
        const checkboxes = document.querySelectorAll('.cand-interviewer-checkbox:checked');
        const errEl = document.getElementById('candSchedPanelistError');
        const submitBtn = document.getElementById('btnCandidateSchedSubmit');

        if (checkboxes.length === 0) {
            if (errEl) errEl.classList.remove('d-none');
            if (submitBtn) submitBtn.disabled = true;
            return false;
        } else {
            if (errEl) errEl.classList.add('d-none');
            const isDateValid = validateCandidateScheduleDateTime();
            if (submitBtn) submitBtn.disabled = !isDateValid;
            triggerCandConflictCheck();
            return true;
        }
    }

    function openCandidateScheduleInterviewModal(applicationId, candidateName, jobTitle, nextRound) {
        document.getElementById('candSchedAppId').value = applicationId;
        document.getElementById('candSchedCandidateName').textContent = candidateName || 'Ứng viên';
        document.getElementById('candSchedJobTitle').textContent = jobTitle || 'Vị trí ứng tuyển';

        const roundSelect = document.getElementById('candSchedRoundNumber');
        const round = nextRound && nextRound <= 5 ? nextRound : 1;
        if (roundSelect) {
            roundSelect.value = round.toString();
            onCandidateRoundChange(round.toString());
        }

        // Set min to current ISO datetime (local timezone)
        const now = new Date();
        const localNowIso = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
        const timeInput = document.getElementById('candSchedStartTime');
        if (timeInput) {
            timeInput.min = localNowIso;

            // Default to tomorrow 09:00 AM
            const tomorrow = new Date(now);
            tomorrow.setDate(tomorrow.getDate() + 1);
            tomorrow.setHours(9, 0, 0, 0);
            const defaultIso = new Date(tomorrow.getTime() - tomorrow.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
            timeInput.value = defaultIso;
        }

        // Default location
        onCandidateInterviewTypeChange('ONLINE_MEET');

        // Reset conflict alert state
        if (window.interviewConflict) {
            window.interviewConflict.resetAlert();
        }

        // Clear errors
        document.getElementById('candSchedPastError')?.classList.add('d-none');
        document.getElementById('candSchedPanelistError')?.classList.add('d-none');
        timeInput?.classList.remove('is-invalid');

        // Load interviewers
        loadCandidateInterviewers();

        // Gắn lắng nghe sự kiện thay đổi để kiểm tra xung đột theo thời gian thực (SCRUM-53)
        const durationSelect = document.getElementById('candSchedDuration');
        if (durationSelect && !durationSelect.dataset.conflictBound) {
            durationSelect.addEventListener('change', triggerCandConflictCheck);
            durationSelect.dataset.conflictBound = 'true';
        }
        const locInput = document.getElementById('candSchedLocationOrLink');
        if (locInput && !locInput.dataset.conflictBound) {
            locInput.addEventListener('input', triggerCandConflictCheck);
            locInput.dataset.conflictBound = 'true';
        }

        const modalEl = document.getElementById('candidateScheduleInterviewModal');
        const modal = new bootstrap.Modal(modalEl);
        modal.show();
    }

    async function handleCandidateScheduleInterviewSubmit(e) {
        e.preventDefault();

        if (!validateCandidateScheduleDateTime()) {
            return;
        }

        if (!validateCandidatePanelists()) {
            return;
        }

        const submitBtn = document.getElementById('btnCandidateSchedSubmit');
        const spinner = document.getElementById('candSchedSpinner');
        submitBtn.disabled = true;
        spinner.classList.remove('d-none');

        const checkboxes = document.querySelectorAll('.cand-interviewer-checkbox:checked');
        const interviewerIds = Array.from(checkboxes).map(cb => cb.value);

        const appId = document.getElementById('candSchedAppId').value;
        const roundNum = parseInt(document.getElementById('candSchedRoundNumber').value, 10) || 1;
        const roundTitle = document.getElementById('candSchedRoundTitle').value.trim();
        const startTime = document.getElementById('candSchedStartTime').value;
        const durationMin = parseInt(document.getElementById('candSchedDuration').value, 10) || 60;
        const interviewType = document.getElementById('candSchedInterviewType').value;
        const locationOrLink = document.getElementById('candSchedLocationOrLink').value.trim();
        const meetingRoomId = document.getElementById('candSchedMeetingRoomId')?.value || null;
        const isOverridden = document.getElementById('chkIsOverridden')?.checked || false;
        const overrideReason = document.getElementById('txtOverrideReason')?.value?.trim() || '';
        const notes = document.getElementById('candSchedNotes').value.trim();

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        const payload = {
            applicationId: appId,
            roundNumber: roundNum,
            roundTitle: roundTitle,
            startTime: startTime,
            scheduledDate: startTime,
            durationMinutes: durationMin,
            interviewType: interviewType,
            locationOrLink: locationOrLink,
            meetingRoomId: (meetingRoomId && meetingRoomId !== '') ? meetingRoomId : null,
            isOverridden: isOverridden,
            overrideReason: overrideReason,
            interviewerIds: interviewerIds,
            panelistIds: interviewerIds,
            notes: notes,
            note: notes
        };

        try {
            const res = await fetch('/Workspace/ScheduleInterview', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token,
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify(payload)
            });

            const data = await res.json();

            if (data.success) {
                bootstrap.Modal.getInstance(document.getElementById('candidateScheduleInterviewModal')).hide();

                // Dynamic UI insertion
                const container = document.getElementById(`interviews-list-${appId}`);
                const emptyState = document.getElementById(`no-interviews-${appId}`);
                if (emptyState) emptyState.remove();

                if (container) {
                    const card = document.createElement('div');
                    card.className = 'p-2.5 bg-white border rounded-2 shadow-xs';
                    card.style.borderColor = '#047857';
                    const typeText = interviewType === 'ONLINE_MEET' ? 'Trực tuyến' : 'Trực tiếp';
                    const panelistsText = interviewerIds.length + ' người phỏng vấn';

                    card.innerHTML = `
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold text-dark">
                                Vòng ${roundNum}: ${escapeHtml(roundTitle)}
                            </span>
                            <span class="badge bg-primary rounded-2" style="font-size: 0.68rem;">
                                Đã lên lịch mới
                            </span>
                        </div>
                        <div class="text-muted small">
                            <span>Thời gian: <b>${new Date(startTime).toLocaleString('vi-VN')} (${durationMin} phút)</b></span>
                            <span class="mx-1">•</span>
                            <span>Hình thức: <b>${typeText}</b> (${escapeHtml(locationOrLink)})</span>
                        </div>
                        <div class="text-secondary small mt-1" style="font-size: 0.74rem;">
                            <i class="bi bi-people me-1 text-muted"></i>Người phỏng vấn: <b>${panelistsText}</b>
                        </div>
                    `;
                    container.appendChild(card);
                }

                alert(data.message || 'Lên lịch phỏng vấn thành công!');
                // Auto reload after brief moment to refresh server-side badges
                setTimeout(() => window.location.reload(), 1000);
            } else {
                if (data.isConflict) {
                    if (window.interviewConflict) {
                        window.interviewConflict.renderResult(data.data || data);
                    }
                    alert(data.message || 'Phát hiện xung đột lịch phỏng vấn! Vui lòng kiểm tra các ca trùng hoặc xác nhận ghi đè.');
                } else {
                    alert(data.message || 'Lỗi khi lên lịch phỏng vấn.');
                }
            }
        } catch (err) {
            alert('Lỗi kết nối: ' + err.message);
        } finally {
            submitBtn.disabled = false;
            spinner.classList.add('d-none');
        }
    }
</script>
}
