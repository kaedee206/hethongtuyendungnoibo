@model Ats.Web.Models.ViewModels.Offers.JobOfferPreviewViewModel

<div class="offer-letter-document p-4 p-md-5 bg-white shadow-sm" style="border: 1px solid #E2E8F0; border-radius: 12px; font-family: 'Inter', system-ui, -apple-system, sans-serif; color: #0F172A; max-width: 850px; margin: 0 auto; line-height: 1.6;">
    <!-- Letterhead Header -->
    <div class="d-flex justify-content-between align-items-start pb-4 mb-4" style="border-bottom: 2px solid #059669;">
        <div>
            <img src="~/img/logo/logo-dark-transparent.png" alt="NoveraTech Logo" style="height: 34px; max-width: 160px; object-fit: contain;" onerror="this.style.display='none'; document.getElementById('logoFallback').style.display='block';" />
            <div id="logoFallback" style="display:none;" class="fw-bold fs-5 text-dark">
                <span style="color:#059669;">Novera</span><span style="color:#0F172A;">Tech</span>
            </div>
            <div class="text-muted small mt-1" style="font-size: 0.82rem;">Tập đoàn Công nghệ NoveraTech · Khối Nhân sự & Tuyển dụng</div>
        </div>
        <div class="text-end text-muted small" style="font-size: 0.8rem; line-height: 1.4;">
            <div><i class="bi bi-geo-alt me-1 text-emerald-600"></i>Tòa nhà Novera Tower, Cầu Giấy, Hà Nội</div>
            <div><i class="bi bi-envelope me-1 text-emerald-600"></i>careers@noveratech.digital</div>
            <div><i class="bi bi-globe me-1 text-emerald-600"></i>www.noveratech.digital</div>
            <div class="mt-1 text-dark fw-semibold">Số văn bản: NV-OFFER/@(Model.OfferId.HasValue ? Model.OfferId.Value.ToString("N")[..8].ToUpper() : "DRAFT")</div>
        </div>
    </div>

    <!-- Letter Title -->
    <div class="text-center my-4">
        <h3 class="fw-bold text-dark text-uppercase tracking-tight mb-1" style="font-size: 1.35rem; letter-spacing: 0.5px;">Thư Mời Nhận Việc (Job Offer)</h3>
        <p class="text-muted small mb-0">Hà Nội, ngày @Model.GeneratedDateFormatted</p>
    </div>

    <!-- Salutation -->
    <div class="mb-4">
        <p class="mb-2"><strong>Kính gửi Ông/Bà:</strong> <span class="fw-bold text-dark fs-6">@Model.CandidateName</span></p>
        <p class="mb-2 text-muted small">
            Email: <span class="text-dark font-monospace">@Model.CandidateEmail</span> 
            @if (!string.IsNullOrWhiteSpace(Model.CandidatePhone))
            {
                <span class="ms-3">Điện thoại: <span class="text-dark font-monospace">@Model.CandidatePhone</span></span>
            }
        </p>
        <p class="mt-3 text-secondary" style="font-size: 0.92rem;">
            Đại diện Tập đoàn Công nghệ NoveraTech, chúng tôi xin chúc mừng Ông/Bà đã hoàn thành xuất sắc các vòng phỏng vấn và đánh giá chuyên môn. Chúng tôi rất hân hạnh gửi đến Ông/Bà lời mời làm việc chính thức với các điều khoản đãi ngộ chi tiết như sau:
        </p>
    </div>

    <!-- Offer Terms Table -->
    <div class="card border-0 mb-4" style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px; overflow: hidden;">
        <div class="card-header bg-white py-2.5 px-3 border-bottom" style="border-color: #E2E8F0;">
            <span class="fw-bold text-dark" style="font-size: 0.9rem;"><i class="bi bi-briefcase text-emerald-600 me-2"></i>1. Thông Tin Vị Trí & Chế Độ Đãi Ngộ</span>
        </div>
        <div class="card-body p-3">
            <div class="row g-3" style="font-size: 0.88rem;">
                <div class="col-sm-6">
                    <span class="text-muted d-block small">Chức danh công việc:</span>
                    <strong class="text-dark fs-6">@Model.JobTitle</strong>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted d-block small">Bộ phận / Khối phòng ban:</span>
                    <strong class="text-dark">@Model.DepartmentName</strong>
                </div>

                <div class="col-sm-6">
                    <span class="text-muted d-block small">Lương cơ bản hàng tháng (Gross):</span>
                    <span class="fw-bold font-monospace text-dark fs-6" style="font-family: 'JetBrains Mono', monospace;">@Model.FormattedBaseSalary</span>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted d-block small">Phụ cấp & Thưởng dự án:</span>
                    <span class="fw-semibold font-monospace text-dark" style="font-family: 'JetBrains Mono', monospace;">@Model.FormattedBonusAllowance</span>
                </div>

                <div class="col-12 p-2.5 my-1" style="background: #ECFDF5; border-radius: 6px; border: 1px solid #A7F3D0;">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-emerald-900 fw-bold small"><i class="bi bi-cash-coin me-1"></i>Tổng gói thu nhập hàng tháng:</span>
                        <span class="fw-bold fs-5 text-emerald-700" style="font-family: 'JetBrains Mono', monospace;">@Model.FormattedTotalPackage</span>
                    </div>
                </div>

                <div class="col-sm-6">
                    <span class="text-muted d-block small">Thời gian thử việc:</span>
                    <span class="text-dark">@Model.ProbationPeriodMonths tháng (Hưởng <strong>@Model.ProbationSalaryPercentage%</strong> lương: <span class="font-monospace fw-semibold" style="font-family: 'JetBrains Mono', monospace;">@Model.FormattedProbationBaseSalary</span>)</span>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted d-block small">Loại hợp đồng:</span>
                    <span class="text-dark">@Model.ContractType</span>
                </div>
                <div class="col-12">
                    <span class="text-muted d-block small">Địa điểm làm việc:</span>
                    <span class="text-dark"><i class="bi bi-geo-alt me-1 text-secondary"></i>@Model.WorkLocation</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Work Schedule & Deadlines -->
    <div class="card border-0 mb-4" style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px; overflow: hidden;">
        <div class="card-header bg-white py-2.5 px-3 border-bottom" style="border-color: #E2E8F0;">
            <span class="fw-bold text-dark" style="font-size: 0.9rem;"><i class="bi bi-calendar-check text-emerald-600 me-2"></i>2. Thời Gian Gia Nhập & Hạn Phản Hồi</span>
        </div>
        <div class="card-body p-3" style="font-size: 0.88rem;">
            <div class="row g-3">
                <div class="col-sm-6">
                    <div class="p-2.5 bg-white rounded border" style="border-color: #E2E8F0;">
                        <span class="text-muted small d-block">Ngày dự kiến nhận việc (Onboarding):</span>
                        <div class="fw-bold text-dark fs-6 mt-1"><i class="bi bi-box-arrow-in-right text-emerald-600 me-1"></i>@Model.FormattedProposedJoinDate</div>
                        <span class="small text-muted" style="font-size:0.75rem;">Có mặt lúc 08:30 sáng tại Tầng 18, Tòa nhà Novera Tower</span>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-2.5 bg-white rounded border" style="border-color: #FCD34D;">
                        <span class="text-muted small d-block">Thời hạn phản hồi Thư mời (Deadline):</span>
                        <div class="fw-bold text-warning-emphasis fs-6 mt-1"><i class="bi bi-clock-history text-warning me-1"></i>Trước 23:59 ngày @Model.FormattedExpirationDate</div>
                        <span class="small text-muted" style="font-size:0.75rem;">Offer tự động hết hiệu lực sau thời điểm này nếu chưa xác nhận</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Company Perks & Commitments -->
    <div class="mb-4" style="font-size: 0.86rem;">
        <h6 class="fw-bold text-dark mb-2" style="font-size: 0.9rem;"><i class="bi bi-shield-check text-emerald-600 me-2"></i>3. Chính Sách Phúc Lợi Nổi Bật Tại NoveraTech</h6>
        <div class="row g-2">
            <div class="col-sm-6">
                <div class="d-flex align-items-center gap-2 p-2 rounded bg-light" style="border: 1px solid #F1F5F9;">
                    <i class="bi bi-laptop text-emerald-600 fs-5"></i>
                    <span>Trang bị <strong>MacBook Pro M3/M4</strong> + Màn hình rời 4K</span>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="d-flex align-items-center gap-2 p-2 rounded bg-light" style="border: 1px solid #F1F5F9;">
                    <i class="bi bi-heart-pulse text-emerald-600 fs-5"></i>
                    <span>Bảo hiểm sức khỏe cao cấp <strong>NoveraCare Diamond</strong></span>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="d-flex align-items-center gap-2 p-2 rounded bg-light" style="border: 1px solid #F1F5F9;">
                    <i class="bi bi-house-door text-emerald-600 fs-5"></i>
                    <span>Chế độ làm việc linh hoạt <strong>Hybrid 2 ngày WFH/tuần</strong></span>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="d-flex align-items-center gap-2 p-2 rounded bg-light" style="border: 1px solid #F1F5F9;">
                    <i class="bi bi-mortarboard text-emerald-600 fs-5"></i>
                    <span>Ngân sách học tập & thi chứng chỉ <strong>1.000 USD/năm</strong></span>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <div class="p-3 mb-4 rounded" style="background: #FFFBEB; border: 1px solid #FDE68A; font-size: 0.85rem;">
            <div class="fw-bold text-warning-emphasis mb-1"><i class="bi bi-info-circle me-1"></i>Điều kiện bổ sung & Ghi chú riêng:</div>
            <div class="text-dark" style="white-space: pre-line;">@Model.Notes</div>
        </div>
    }

    <!-- Signatures -->
    <div class="row pt-4 mt-4" style="border-top: 1px dashed #CBD5E1;">
        <div class="col-6 text-center">
            <div class="fw-bold text-dark small text-uppercase">Xác nhận của Ứng viên</div>
            <div class="text-muted small" style="font-size: 0.75rem;">(Ký, ghi rõ họ tên và ngày xác nhận)</div>
            <div style="height: 65px;"></div>
            <div class="fw-bold text-dark" style="font-size: 0.88rem;">@Model.CandidateName</div>
        </div>
        <div class="col-6 text-center">
            <div class="fw-bold text-dark small text-uppercase">Đại diện NoveraTech</div>
            <div class="text-muted small" style="font-size: 0.75rem;">(Đã ký điện tử & đóng dấu xác thực)</div>
            <div class="d-flex align-items-center justify-content-center" style="height: 65px;">
                <span class="badge bg-emerald-50 text-emerald-700 border border-emerald-200 px-3 py-1.5" style="border-radius: 6px; font-size: 0.78rem;">
                    <i class="bi bi-patch-check-fill text-emerald-600 me-1"></i>Xác thực số nội bộ
                </span>
            </div>
            <div class="fw-bold text-dark" style="font-size: 0.88rem;">@Model.RecruiterName</div>
            <div class="text-muted small" style="font-size: 0.78rem;">@Model.RecruiterTitle</div>
        </div>
    </div>
</div>
