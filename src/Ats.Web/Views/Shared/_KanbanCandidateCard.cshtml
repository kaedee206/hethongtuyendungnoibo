@model Ats.Web.Models.ViewModels.Workspace.CandidatePipelineItemDto

<div id="kanban-card-@Model.ApplicationId" class="kanban-candidate-card @(Model.IsOverdueSla ? "border-danger-subtle shadow-sm" : "")"
     draggable="true"
     data-application-id="@Model.ApplicationId"
     data-candidate-name="@Model.CandidateName"
     data-job-id="@Model.JobPostingId"
     data-stage-order="@Model.CurrentStageOrder"
     data-status="@Model.Status"
     data-is-overdue="@(Model.IsOverdueSla ? "true" : "false")"
     data-name="@Model.CandidateName.ToLower()"
     data-email="@Model.CandidateEmail.ToLower()"
     data-job="@Model.JobTitle.ToLower()"
     title="Ứng viên: @Model.CandidateName&#10;Email: @Model.CandidateEmail&#10;SĐT: @(string.IsNullOrEmpty(Model.CandidatePhone) ? "Chưa có" : Model.CandidatePhone)@(Model.IsOverdueSla ? $"\n⚠️ Quá hạn SLA {Model.OverdueDays} ngày (Đã ở giai đoạn này {Model.DaysInCurrentStage}/{Model.SlaDays} ngày)" : "")&#10;Nhấp để xem chi tiết & thao tác hồ sơ"
     ondragstart="onKanbanCardDragStart(event)"
     ondragend="onKanbanCardDragEnd(event)"
     onclick="openCandidateDetailModal('@Model.ApplicationId')"
     style="@(Model.IsOverdueSla ? "border-left: 3.5px solid #DC2626 !important;" : "")">

    <!-- Header thẻ: Avatar, Tên ứng viên & Tag vị trí -->
    <div class="d-flex align-items-center gap-2 mb-1" style="min-width: 0; max-width: 100%;">
        @if (!string.IsNullOrEmpty(Model.AvatarUrl))
        {
            <div class="position-relative flex-shrink-0" style="width: 28px; height: 28px;">
                <img src="@Model.AvatarUrl" alt="@Model.CandidateName" 
                     class="rounded-circle object-fit-cover shadow-xs border"
                     style="width: 28px; height: 28px; display: block;"
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                <div class="kanban-card-avatar flex-shrink-0" style="display: none; @(Model.IsOverdueSla ? "background: #FEE2E2; color: #DC2626; border: 1px solid #FECACA;" : "")">
                    @(string.IsNullOrEmpty(Model.CandidateName) ? "?" : Model.CandidateName.Substring(0, 1).ToUpper())
                </div>
            </div>
        }
        else
        {
            <div class="kanban-card-avatar flex-shrink-0" style="@(Model.IsOverdueSla ? "background: #FEE2E2; color: #DC2626; border: 1px solid #FECACA;" : "")">
                @(string.IsNullOrEmpty(Model.CandidateName) ? "?" : Model.CandidateName.Substring(0, 1).ToUpper())
            </div>
        }
        <div style="min-width: 0; flex: 1; overflow: hidden;">
            <div class="kanban-card-title text-truncate" title="@Model.CandidateName">
                @Model.CandidateName
            </div>
            <div class="kanban-job-badge" title="@Model.JobTitle">
                <i class="bi bi-briefcase me-1 flex-shrink-0"></i><span class="text-truncate">@Model.JobTitle</span>
            </div>
        </div>
    </div>

    <!-- Thông tin liên hệ (Email & Phone): Ẩn ở chế độ Thu gọn, hiển thị ở chế độ Chi tiết -->
    <div class="kanban-card-contact-info">
        <div class="text-truncate" style="font-family:'JetBrains Mono',monospace;" title="@Model.CandidateEmail">
            <i class="bi bi-envelope me-1 text-muted"></i>@Model.CandidateEmail
        </div>
        @if (!string.IsNullOrEmpty(Model.CandidatePhone) && Model.CandidatePhone != "Chưa có")
        {
            <div class="text-truncate" title="@Model.CandidatePhone"><i class="bi bi-telephone me-1 text-muted"></i>@Model.CandidatePhone</div>
        }
    </div>

    <!-- Footer: Ngày nộp/cập nhật & Badges -->
    <div class="kanban-card-footer" onclick="event.stopPropagation();">
        <span class="badge kanban-card-date-badge" title="Ngày nộp: @Model.AppliedDateDisplay">
            <i class="bi bi-clock me-1"></i>@Model.AppliedDateDisplay
        </span>
        <div class="kanban-card-badges-group">
            @if (Model.IsOverdueSla)
            {
                <span class="badge kanban-card-sla-badge" title="Quá hạn SLA: Đã ở giai đoạn này @Model.DaysInCurrentStage ngày (ngưỡng: @Model.SlaDays ngày)">
                    <i class="bi bi-flag-fill me-0.5"></i>SLA +@Model.OverdueDays d
                </span>
            }
            @if (!string.IsNullOrEmpty(Model.ResumeFilePath))
            {
                <a href="@Model.ResumeFilePath" target="_blank" class="candidate-cv-pill kanban-card-cv-pill" title="Xem CV đính kèm">
                    <i class="bi bi-file-earmark-pdf"></i> CV
                </a>
            }
            @if (Model.CurrentStageOrder == 3)
            {
                <span class="badge kanban-card-stage-badge" style="background:#FEF3C7; color:#B45309;" title="Vòng Sơ loại">Sơ loại</span>
            }
            else if (Model.CurrentStageOrder == 4)
            {
                <span class="badge kanban-card-stage-badge" style="background:#FDE68A; color:#92400E;" title="Vòng Chuyên môn">Chuyên môn</span>
            }
        </div>
    </div>
</div>
