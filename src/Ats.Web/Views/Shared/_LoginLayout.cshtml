<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ATS | Hệ thống Tuyển dụng Nội bộ</title>
    <!-- Google Fonts: Inter + JetBrains Mono (RULE.md Style Guide Compliant) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="account-body position-relative">
    <a href="/gioi-thieu" class="btn btn-sm btn-outline-secondary position-fixed top-0 start-0 m-3 shadow-sm bg-white border-slate-200" style="z-index: 1050; border-radius: 9999px;">
        <i class="bi bi-arrow-left me-1"></i> Về trang chủ
    </a>
    <main role="main">
        @RenderBody()
    </main>

    <footer class="account-footer text-center text-muted small">
        &copy; @DateTime.Now.Year - ATS - Hệ thống Tuyển dụng Nội bộ
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
