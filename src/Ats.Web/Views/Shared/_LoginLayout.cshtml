<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Đăng nhập vào Hệ thống Tuyển dụng Nội bộ ATS" />
    <title>@ViewData["Title"] - ATS | Hệ thống Tuyển dụng Nội bộ</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="account-body">
    <a href="#login-form" class="visually-hidden-focusable skip-link">Chuyển đến form đăng nhập</a>

    <main role="main" id="main-content">
        @RenderBody()
    </main>

    <footer class="account-footer text-center">
        &copy; @DateTime.Now.Year &mdash; Hệ Thống Tuyển Dụng Nội Bộ (ATS)
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
