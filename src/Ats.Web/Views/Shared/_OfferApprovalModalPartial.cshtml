@* Modal Phê duyệt Offer theo hạn mức lương (SCRUM-341) *@
<div class="modal fade" id="offerApprovalModal" tabindex="-1" aria-labelledby="offerApprovalModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
            @* Modal Header *@
            <div class="modal-header bg-slate-900 text-white px-4 py-3" style="background: #0F172A;">
                <div class="d-flex align-items-center">
                    <div class="d-flex align-items-center justify-content-center me-3" style="width: 38px; height: 38px; border-radius: 8px; background: rgba(255,255,255,0.1);">
                        <i class="bi bi-shield-check text-emerald-400 fs-5" style="color: #34D399;"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-white mb-0" id="offerApprovalModalLabel" style="font-size: 1.1rem; letter-spacing: -0.01em;">
                            Xem xét & Phê duyệt Thư mời nhận việc
                        </h5>
                        <div class="text-slate-300 small" style="color: #94A3B8; font-size: 0.8rem;">
                            Kiểm soát hạn mức lương & Quỹ ngân sách tuyển dụng NoveraTech
                        </div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            @* Modal Body *@
            <div class="modal-body p-4" style="background: #F8FAFC; max-height: 80vh; overflow-y: auto;">
                @* Loading State *@
                <div id="offerApprovalLoading" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status" style="width: 2.5rem; height: 2.5rem;">
                        <span class="visually-hidden">Đang tải dữ liệu...</span>
                    </div>
                    <div class="text-muted small mt-2">Đang tải chi tiết đề xuất và lịch sử phê duyệt...</div>
                </div>

                @* Content Container (Ẩn khi đang load) *@
                <div id="offerApprovalContent" class="d-none">
                    @* Candidate & Position Summary Card *@
                    <div class="card border-0 shadow-sm mb-3" style="border-radius: 10px; background: #FFFFFF; border-left: 4px solid #2563EB !important;">
                        <div class="card-body p-3">
                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <h6 class="fw-bold text-dark mb-0" id="approvalCandidateName" style="font-size: 1.05rem;">-</h6>
                                        <span class="badge" id="approvalOfferStatusBadge" style="border-radius: 6px; font-size: 0.75rem;">-</span>
                                    </div>
                                    <div class="text-muted small mt-1">
                                        <i class="bi bi-briefcase me-1"></i><span id="approvalJobTitle" class="fw-semibold text-slate-700">-</span>
                                        <span class="mx-2">•</span>
                                        <i class="bi bi-building me-1"></i><span id="approvalDepartment">-</span>
                                    </div>
                                    <div class="text-muted small mt-1">
                                        <i class="bi bi-envelope me-1"></i><span id="approvalCandidateEmail">-</span>
                                        <span class="mx-2">•</span>
                                        <i class="bi bi-person-badge me-1"></i>Recruiter: <span id="approvalRecruiterName" class="fw-medium text-dark">-</span>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="badge px-3 py-2" id="approvalLevelBadge" style="border-radius: 8px; font-size: 0.82rem; font-weight: 600;">
                                        -
                                    </div>
                                    <div class="text-muted small mt-1" id="approvalCreatedDate" style="font-size: 0.75rem;">-</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Salary Band Status Alert Banner *@
                    <div id="salaryBandAlertContainer" class="mb-3">
                        @* Render động qua JS: Trong dải chuẩn hoặc Vượt dải chuẩn *@
                    </div>

                    @* Salary Details Comparison Matrix *@
                    <div class="card border-0 shadow-sm mb-3" style="border-radius: 10px; background: #FFFFFF;">
                        <div class="card-header bg-white border-bottom py-2.5 px-3">
                            <h6 class="fw-bold text-dark mb-0 d-flex align-items-center" style="font-size: 0.9rem;">
                                <i class="bi bi-cash-stack text-primary me-2"></i>Chi tiết Đề xuất & Hạn mức Lương
                            </h6>
                        </div>
                        <div class="card-body p-3">
                            <div class="row g-3">
                                @* Lương cơ bản đề xuất *@
                                <div class="col-md-4">
                                    <div class="p-3 border rounded-3 h-100" style="background: #F1F5F9; border-color: #CBD5E1 !important; border-radius: 8px;">
                                        <div class="text-muted small fw-medium text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Lương cơ bản đề xuất</div>
                                        <div class="fw-bold text-dark mt-1" id="approvalProposedSalary" style="font-family: 'JetBrains Mono', monospace; font-size: 1.25rem;">
                                            -
                                        </div>
                                        <div class="small text-muted mt-1" style="font-size: 0.75rem;">Hàng tháng (Gross)</div>
                                    </div>
                                </div>

                                @* Dải lương chuẩn vị trí *@
                                <div class="col-md-4">
                                    <div class="p-3 border rounded-3 h-100" style="background: #F8FAFC; border-color: #E2E8F0 !important; border-radius: 8px;">
                                        <div class="text-muted small fw-medium text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Dải lương chuẩn (Vị trí)</div>
                                        <div class="fw-bold text-slate-800 mt-1" id="approvalStandardBand" style="font-family: 'JetBrains Mono', monospace; font-size: 1.1rem;">
                                            -
                                        </div>
                                        <div class="small text-muted mt-1" id="approvalBandLimitNote" style="font-size: 0.75rem;">Trần ngân sách tuyển dụng</div>
                                    </div>
                                </div>

                                @* Tổng thu nhập đề xuất *@
                                <div class="col-md-4">
                                    <div class="p-3 border rounded-3 h-100" style="background: #EFF6FF; border-color: #BFDBFE !important; border-radius: 8px;">
                                        <div class="text-primary small fw-medium text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Tổng gói đãi ngộ (Package)</div>
                                        <div class="fw-bold text-primary mt-1" id="approvalTotalPackage" style="font-family: 'JetBrains Mono', monospace; font-size: 1.25rem;">
                                            -
                                        </div>
                                        <div class="small text-muted mt-1" style="font-size: 0.75rem;">Đã gồm phụ cấp & thưởng</div>
                                    </div>
                                </div>
                            </div>

                            @* Thêm thông tin điều khoản *@
                            <div class="row g-2 mt-2 pt-2 border-top">
                                <div class="col-sm-4 text-muted small">
                                    <i class="bi bi-calendar-event me-1 text-secondary"></i>Ngày nhận việc: <span class="fw-semibold text-dark" id="approvalJoinDate">-</span>
                                </div>
                                <div class="col-sm-4 text-muted small">
                                    <i class="bi bi-clock-history me-1 text-secondary"></i>Thử việc: <span class="fw-semibold text-dark" id="approvalProbationMonths">-</span>
                                </div>
                                <div class="col-sm-4 text-muted small">
                                    <i class="bi bi-hourglass-split me-1 text-secondary"></i>Hạn phản hồi: <span class="fw-semibold text-dark" id="approvalExpirationDate">-</span>
                                </div>
                            </div>

                            @* Khối Căn cứ giải trình vượt khung (Chỉ hiện khi vượt khung) *@
                            <div id="salaryJustificationBox" class="mt-3 p-3 border rounded-3 d-none" style="background: #FFFBEB; border-color: #FDE68A !important; border-radius: 8px;">
                                <div class="fw-bold text-amber-900 small d-flex align-items-center mb-1" style="color: #78350F;">
                                    <i class="bi bi-file-earmark-text-fill me-1.5 text-warning"></i>Căn cứ / Giải trình đề xuất lương vượt dải chuẩn từ Recruiter:
                                </div>
                                <div class="small text-dark fst-italic" id="approvalSalaryJustification" style="font-size: 0.85rem; line-height: 1.5;">
                                    -
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Immutable Approval History Timeline *@
                    <div class="card border-0 shadow-sm mb-3" style="border-radius: 10px; background: #FFFFFF;">
                        <div class="card-header bg-white border-bottom py-2.5 px-3 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold text-dark mb-0 d-flex align-items-center" style="font-size: 0.9rem;">
                                <i class="bi bi-diagram-3 text-primary me-2"></i>Tiến trình & Lịch sử Phê duyệt Phân cấp
                            </h6>
                            <span class="badge bg-slate-100 text-slate-600 border" style="border-radius: 6px; font-size: 0.7rem; font-weight: normal;">
                                <i class="bi bi-lock-fill me-1"></i>Bất biến (Không sửa / Không xoá)
                            </span>
                        </div>
                        <div class="card-body p-3">
                            <div id="approvalHistoryTimeline">
                                @* Timeline items render động qua JS *@
                            </div>
                        </div>
                    </div>

                    @* Decision Action Form (Chỉ hiển thị khi người dùng có quyền duyệt bước hiện tại) *@
                    <div id="approvalDecisionFormContainer">
                        <form id="offerApprovalDecisionForm" onsubmit="handleOfferDecisionSubmit(event)">
                            @Html.AntiForgeryToken()
                            <input type="hidden" id="decisionOfferId" name="OfferId" />
                            <input type="hidden" id="decisionAction" name="Decision" />

                            <div class="card border-0 shadow-sm" style="border-radius: 10px; background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
                                <div class="card-body p-3">
                                    <div class="mb-2.5">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <label for="approvalDecisionComment" class="form-label small fw-semibold text-dark mb-0">
                                                Ý kiến phê duyệt <span id="commentRequiredAsterisk" class="text-danger d-none">* (Bắt buộc khi Từ chối hoặc Yêu cầu sửa)</span>
                                            </label>
                                            <span class="text-muted small" style="font-size: 0.75rem;">Tối đa 1000 ký tự</span>
                                        </div>
                                        <textarea class="form-control" id="approvalDecisionComment" name="Comment" rows="3" 
                                                  placeholder="Nhập ý kiến đánh giá, căn cứ phê duyệt hoặc hướng dẫn điều chỉnh cụ thể cho Recruiter..." 
                                                  style="border-radius: 8px; font-size: 0.88rem;"></textarea>
                                        <div id="commentValidationError" class="text-danger small mt-1 d-none" style="font-size: 0.78rem;">
                                            <i class="bi bi-exclamation-circle-fill me-1"></i>Vui lòng nhập ý kiến giải thích rõ lý do khi Từ chối hoặc Yêu cầu sửa đổi Offer.
                                        </div>
                                    </div>

                                    @* Gợi ý ý kiến nhanh *@
                                    <div class="d-flex flex-wrap gap-1.5 mb-3 align-items-center">
                                        <span class="text-muted small me-1" style="font-size: 0.75rem;">Gợi ý nhanh:</span>
                                        <button type="button" class="btn btn-sm btn-light border py-0 px-2" style="font-size: 0.75rem; border-radius: 6px;" onclick="setQuickApprovalComment('Đồng ý mức lương đề xuất. Chuyển hồ sơ sang giai đoạn gửi thư mời ứng viên.')">
                                            Đồng ý mức đề xuất
                                        </button>
                                        <button type="button" class="btn btn-sm btn-light border py-0 px-2" style="font-size: 0.75rem; border-radius: 6px;" onclick="setQuickApprovalComment('Phù hợp với năng lực xuất sắc của ứng viên và nhu cầu cấp thiết của dự án.')">
                                            Phù hợp năng lực
                                        </button>
                                        <button type="button" class="btn btn-sm btn-light border py-0 px-2" style="font-size: 0.75rem; border-radius: 6px;" onclick="setQuickApprovalComment('Mức lương vượt trần ngân sách cho phép. Yêu cầu thương lượng lại trong dải chuẩn.')">
                                            Yêu cầu đàm phán lại
                                        </button>
                                        <button type="button" class="btn btn-sm btn-light border py-0 px-2" style="font-size: 0.75rem; border-radius: 6px;" onclick="setQuickApprovalComment('Từ chối đề xuất do không cân đối được ngân sách quý này.')">
                                            Không cân đối được ngân sách
                                        </button>
                                    </div>

                                    @* Action Buttons Group (RULE.md: Border-radius 8px, không pill) *@
                                    <div class="d-flex flex-wrap justify-content-between align-items-center pt-2 border-top gap-2">
                                        <button type="button" class="btn btn-light border text-muted px-3" data-bs-dismiss="modal" style="border-radius: 8px; font-size: 0.88rem;">
                                            <i class="bi bi-x-lg me-1"></i>Đóng
                                        </button>

                                        <div class="d-flex flex-wrap gap-2" id="approvalActionButtonsGroup">
                                            @* Nút Yêu cầu sửa (CHANGES_REQUESTED) *@
                                            <button type="button" class="btn btn-warning text-dark fw-semibold px-3" id="btnRequestChangesOffer" 
                                                    style="border-radius: 8px; font-size: 0.88rem; background: #F59E0B; border-color: #D97706;"
                                                    onclick="triggerDecisionAction('CHANGES_REQUESTED')">
                                                <i class="bi bi-arrow-counterclockwise me-1.5"></i>Yêu cầu sửa
                                            </button>

                                            @* Nút Từ chối (REJECT) *@
                                            <button type="button" class="btn btn-danger fw-semibold px-3" id="btnRejectOffer" 
                                                    style="border-radius: 8px; font-size: 0.88rem; background: #E11D48; border-color: #BE123C;"
                                                    onclick="triggerDecisionAction('REJECT')">
                                                <i class="bi bi-x-circle me-1.5"></i>Từ chối
                                            </button>

                                            @* Nút Duyệt (APPROVE) *@
                                            <button type="button" class="btn btn-success fw-semibold px-3" id="btnApproveOffer" 
                                                    style="border-radius: 8px; font-size: 0.88rem; background: #0D9488; border-color: #0F766E;"
                                                    onclick="triggerDecisionAction('APPROVE')">
                                                <i class="bi bi-check2-circle me-1.5"></i>Phê duyệt Offer
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>

                    @* Hộp thông báo người xem chỉ có quyền xem (Read-only notice) *@
                    <div id="approvalReadOnlyNotice" class="alert alert-info py-2 px-3 mt-3 d-none" style="border-radius: 8px; font-size: 0.83rem;">
                        <i class="bi bi-info-circle-fill me-2 text-info"></i>
                        <span id="approvalReadOnlyMessage">Bạn đang xem chi tiết đề xuất Offer. Hiện tại bước này đang chờ người có thẩm quyền tương ứng xử lý.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
