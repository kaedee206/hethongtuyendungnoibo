@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi hệ thống";
}

<div class="container py-5 d-flex justify-content-center align-items-center" style="min-height: 60vh; max-width: 640px;">
    <div class="card bg-white border-0 shadow-sm p-4 p-md-5 d-flex flex-column align-items-center text-center w-100" 
         style="border: 1px solid #E2E8F0 !important; border-radius: 12px; gap: 1.25rem;">
        
        <!-- Icon & Status -->
        <div class="d-flex flex-column align-items-center gap-2">
            <div class="d-flex align-items-center justify-content-center" style="width: 64px; height: 64px; border-radius: 50%; background: #FEF2F2; color: #DC2626; font-size: 1.75rem;">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <span class="badge bg-danger-subtle text-danger px-3 py-1.5 mt-2" style="border-radius: 6px; font-weight: 600; font-size: 0.82rem;">
                Sự cố xử lý yêu cầu
            </span>
        </div>

        <!-- Title & Message -->
        <div class="d-flex flex-column align-items-center gap-2">
            <h1 class="h4 fw-bold text-dark mb-0">Đã xảy ra lỗi ngoài ý muốn</h1>
            <p class="text-muted mb-0 small" style="line-height: 1.6; max-width: 460px;">
                Hệ thống gặp sự cố trong quá trình xử lý yêu cầu của bạn. Quản trị viên hệ thống đã ghi nhận mã theo dõi để kiểm tra và khắc phục.
            </p>
        </div>

        @if (Model.ShowRequestId)
        {
            <div class="p-2.5 px-3 rounded text-muted small w-100" style="background: #F8FAFC; border: 1px solid #E2E8F0; font-size: 0.8rem;">
                <span class="fw-semibold text-secondary">Mã truy vấn (Request ID):</span> 
                <code class="text-dark fw-bold ms-1" style="font-family: 'JetBrains Mono', monospace;">@Model.RequestId</code>
            </div>
        }

        <!-- Actions -->
        <div class="d-flex flex-wrap justify-content-center align-items-center gap-2 w-100 pt-3 border-top" style="border-color: #E2E8F0;">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2" style="background: #047857; border-color: #047857; border-radius: 8px; font-weight: 500;">
                <i class="bi bi-house-door me-1"></i> Về trang chủ
            </a>
            <button type="button" onclick="window.history.back()" class="btn btn-outline-secondary px-4 py-2" style="border-radius: 8px; font-weight: 500;">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </button>
        </div>
    </div>
</div>
