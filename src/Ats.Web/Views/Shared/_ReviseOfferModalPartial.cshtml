<!-- ============================================================== -->
<!-- MODAL: TẠO OFFER SỬA ĐỔI / THƯƠNG LƯỢNG LẠI (USER STORY SP-7) -->
<!-- ============================================================== -->
<div class="modal fade" id="reviseOfferModal" tabindex="-1" aria-labelledby="reviseOfferModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
            <div class="modal-header border-0 pb-0" style="background: #F8FAFC;">
                <div class="d-flex align-items-center gap-2.5">
                    <div class="d-flex align-items-center justify-content-center rounded-3" style="width: 42px; height: 42px; background: #FEF3C7; color: #D97706;">
                        <i class="bi bi-arrow-repeat fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="reviseOfferModalLabel" style="font-size: 1.05rem;">
                            Tạo Thư mời sửa đổi (Thương lượng lại)
                        </h5>
                        <small class="text-muted" style="font-size: 0.76rem;">Khởi tạo phiên bản Offer mới thay thế phiên bản trước đó (SP-7)</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formReviseOffer" onsubmit="OfferManager.submitRevise(event); return false;">
                @Html.AntiForgeryToken()
                <input type="hidden" id="reviseOriginalOfferId" name="OriginalOfferId" />

                <div class="modal-body py-3">
                    <!-- Thông báo chuyển trạng thái Superseded/Replaced -->
                    <div class="alert alert-warning border-warning-subtle py-2 px-3 rounded-2 mb-3 d-flex align-items-start gap-2" style="font-size: 0.8rem;">
                        <i class="bi bi-exclamation-triangle-fill text-warning fs-6 mt-0.5 flex-shrink-0"></i>
                        <div>
                            <strong>Quy tắc phiên bản:</strong> Thư mời hiện tại (<span id="reviseOldVersionBadge" class="fw-bold">v1</span>) sẽ tự động chuyển sang trạng thái <span class="badge bg-secondary">Đã thay thế (Replaced)</span>. Hệ thống sẽ tạo phiên bản mới (<span id="reviseNewVersionBadge" class="fw-bold text-success">v2</span>) để tiếp tục luồng phê duyệt và gửi ứng viên.
                        </div>
                    </div>

                    <!-- Tóm tắt ứng viên -->
                    <div class="p-2.5 mb-3 rounded-2" style="background: #F8FAFC; border: 1px solid #E2E8F0;">
                        <div class="fw-bold text-dark" id="reviseCandidateName" style="font-size: 0.9rem;">-</div>
                        <div class="text-muted small" id="reviseJobTitle">-</div>
                    </div>

                    <!-- Mức lương thỏa thuận mới -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-dark mb-1">
                                Lương cơ bản mới (Gross/tháng) <span class="text-danger">*</span>
                            </label>
                            <input type="number" class="form-control form-control-sm rounded-2 font-mono" id="reviseBaseSalary" name="BaseSalary" required min="1000000" step="500000" oninput="OfferManager.calcReviseTotal()" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-dark mb-1">
                                Phụ cấp &amp; Thưởng dự án
                            </label>
                            <input type="number" class="form-control form-control-sm rounded-2 font-mono" id="reviseBonusAllowance" name="BonusAllowance" value="0" min="0" step="500000" oninput="OfferManager.calcReviseTotal()" />
                        </div>
                        <div class="col-12">
                            <div class="p-2 rounded-2 d-flex justify-content-between align-items-center" style="background:#ECFDF5; border:1px solid #A7F3D0;">
                                <span class="small fw-semibold text-dark">Tổng thu nhập đề xuất mới:</span>
                                <span class="fw-bold text-success font-mono" id="reviseTotalPackageDisplay">0 VNĐ</span>
                            </div>
                        </div>
                    </div>

                    <!-- Ngày gia nhập & thử việc -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-dark mb-1">Ngày gia nhập thỏa thuận mới</label>
                            <input type="date" class="form-control form-control-sm rounded-2" id="reviseProposedJoinDate" name="ProposedJoinDate" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-dark mb-1">Thời gian thử việc</label>
                            <select class="form-select form-select-sm rounded-2" id="reviseProbationPeriodMonths" name="ProbationPeriodMonths">
                                <option value="1">1 tháng</option>
                                <option value="2" selected>2 tháng (Tiêu chuẩn)</option>
                                <option value="3">3 tháng</option>
                                <option value="0">Không thử việc (Chính thức ngay)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Loại hợp đồng -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark mb-1">Loại hợp đồng lao động</label>
                        <select class="form-select form-select-sm rounded-2" id="reviseContractType" name="ContractType">
                            <option value="Chính thức (Toàn thời gian)">Chính thức (Toàn thời gian)</option>
                            <option value="Hợp đồng xác định thời hạn 1 năm">Hợp đồng xác định thời hạn 1 năm</option>
                            <option value="Hợp đồng xác định thời hạn 2 năm">Hợp đồng xác định thời hạn 2 năm</option>
                            <option value="Cộng tác viên / Bán thời gian">Cộng tác viên / Bán thời gian</option>
                        </select>
                    </div>

                    <!-- Ghi chú thương lượng -->
                    <div class="mb-2">
                        <label class="form-label small fw-semibold text-dark mb-1">Nội dung thương lượng / Lý do điều chỉnh</label>
                        <textarea class="form-control form-control-sm rounded-2" id="reviseNotes" name="RevisionNotes" rows="2" placeholder="Ghi nhận căn cứ tăng lương / thỏa thuận lại phúc lợi với ứng viên..."></textarea>
                    </div>
                </div>

                <div class="modal-footer border-0 pt-0 px-3 pb-3">
                    <button type="button" class="btn btn-sm btn-light px-3 rounded-2" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-sm btn-warning px-4 rounded-2 fw-semibold text-dark d-inline-flex align-items-center gap-1.5" id="btnSubmitReviseOffer">
                        <span class="spinner-border spinner-border-sm d-none" id="spinnerReviseOffer"></span>
                        <i class="bi bi-check2-circle"></i>
                        <span>Lưu &amp; Tạo Offer Sửa Đổi</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
