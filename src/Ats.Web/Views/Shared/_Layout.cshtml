@using System.Security.Claims
@using Ats.Web.Constants
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="NoveraTech Careers - Cổng thông tin Tuyển dụng & Cơ hội Nghề nghiệp NoveraTech" />
    <title>@ViewData["Title"] - NoveraTech Careers</title>
    <!-- Favicon từ bộ logo chính thức -->
    <link rel="icon" type="image/png" href="~/img/favicon.png" asp-append-version="true" />
    <link rel="shortcut icon" type="image/png" href="~/img/favicon.png" asp-append-version="true" />
    <!-- Google Fonts: Inter + Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg ats-navbar sticky-top">
            <div class="container-fluid px-3 px-md-4">
                <!-- Brand with Official Logo -->
                <a class="navbar-brand d-flex align-items-center gap-2 py-1 ats-brand-logo" asp-controller="Home" asp-action="Landing">
                    <img src="~/img/logo-dark-transparent.png" 
                         alt="NoveraTech" 
                         style="height: 30px; width: auto; max-width: 140px; object-fit: contain;" 
                         asp-append-version="true" />
                    <span class="badge fw-semibold px-2 py-0.5" style="font-size: 0.72rem; border-radius: 6px; background: #ECFDF5; color: #059669; border: 1px solid #A7F3D0; letter-spacing: 0.02em;">Careers</span>
                </a>

                <!-- Mobile Toggle Button -->
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#atsNavbarContent" aria-controls="atsNavbarContent" aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="atsNavbarContent">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <!-- Navigation Links based on Roles -->
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 mt-2 mt-lg-0 gap-1">
                            <li class="nav-item">
                                <a class="nav-link ats-nav-link" href="/dashboard">
                                    <i class="bi bi-speedometer2 me-1"></i> Bàn làm việc
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link ats-nav-link text-primary fw-medium" href="/landing" title="Xem Cổng thông tin Tuyển dụng NoveraTech">
                                    <i class="bi bi-globe2 me-1"></i> Landing Page
                                </a>
                            </li>

                            @* Menu dành cho Ứng viên *@
                            @if (User.IsInRole(UserRoles.Candidate))
                            {
                                <li class="nav-item">
                                    <a class="nav-link ats-nav-link" asp-controller="Jobs" asp-action="Index">
                                        <i class="bi bi-briefcase me-1"></i> Việc làm NoveraTech
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link ats-nav-link text-success fw-medium" href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#updateCvModal">
                                        <i class="bi bi-file-earmark-person me-1"></i> Cập nhật CV
                                    </a>
                                </li>
                            }

                            @* Menu dành cho Admin *@
                            @if (User.IsInRole(UserRoles.Admin))
                            {
                                <li class="nav-item">
                                    <a class="nav-link ats-nav-link" asp-controller="Users" asp-action="Index">
                                        <i class="bi bi-people-fill me-1"></i> Quản lý tài khoản
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole(UserRoles.Admin) || User.IsInRole(UserRoles.HRManager))
                            {
                                <li class="nav-item">
                                    <a class="nav-link ats-nav-link" asp-controller="JobPositions" asp-action="Index">
                                        <i class="bi bi-person-badge-fill me-1"></i> Chức danh
                                    </a>
                                </li>
                            }

                            @* Menu dành cho HR Manager & Recruiter *@
                            @if (User.IsInRole(UserRoles.HRManager) || User.IsInRole(UserRoles.Recruiter))
                            {
                                <li class="nav-item">
                                    <a class="nav-link ats-nav-link" href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#createJobModal">
                                        <i class="bi bi-megaphone me-1"></i> + Đăng tin tuyển dụng
                                    </a>
                                </li>
                            }

                            @* Menu dành cho Hiring Manager *@
                            @if (User.IsInRole(UserRoles.HiringManager))
                            {
                                <li class="nav-item">
                                    <a class="nav-link ats-nav-link" href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#createRequisitionModal">
                                        <i class="bi bi-file-earmark-plus me-1"></i> + Đề xuất nhân sự
                                    </a>
                                </li>
                            }

                            @* Menu dành cho Interviewer *@
                            @if (User.IsInRole(UserRoles.Interviewer))
                            {
                                <li class="nav-item">
                                    <a class="nav-link ats-nav-link" href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#interviewEvaluationModal">
                                        <i class="bi bi-clipboard2-check me-1"></i> Đánh giá phỏng vấn
                                    </a>
                                </li>
                            }

                            @* Menu dành cho Approver *@
                            @if (User.IsInRole(UserRoles.Approver))
                            {
                                <li class="nav-item">
                                    <a class="nav-link ats-nav-link" href="/#staff-workspace">
                                        <i class="bi bi-check2-square me-1"></i> Duyệt Offer
                                    </a>
                                </li>
                            }
                        </ul>


                        <!-- User Profile & Action Dropdown (S1-04, S1-09) -->
                        <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center gap-2 mt-3 mt-lg-0">
                            <!-- Role Badges for Multi-role representation -->
                            <div class="d-flex flex-wrap gap-1 me-lg-2">
                                @{
                                    var distinctRoles = User.FindAll(ClaimTypes.Role)
                                        .Select(c => UserRoles.NormalizeRole(c.Value))
                                        .Distinct()
                                        .ToList();
                                }
                                @foreach (var rName in distinctRoles)
                                {
                                    var badgeStyle = rName switch
                                    {
                                        UserRoles.Admin => "badge-admin",
                                        UserRoles.HRManager => "badge-hrmanager",
                                        UserRoles.Recruiter => "badge-recruiter",
                                        UserRoles.HiringManager => "badge-hiringmanager",
                                        UserRoles.Interviewer => "badge-interviewer",
                                        UserRoles.Approver => "badge-approver",
                                        _ => "bg-light text-secondary border"
                                    };
                                    <span class="badge @badgeStyle px-2 py-1 text-xs" style="border-radius:6px;">
                                        @UserRoles.GetDisplayName(rName)
                                    </span>
                                }
                            </div>

                            <!-- Dropdown User (RULE.MD: 8px radius, clean neutral) -->
                            <div class="dropdown w-100 w-lg-auto">
                                <button class="btn-user-toggle d-flex align-items-center gap-2 px-3 py-1.5 w-100 w-lg-auto" style="border-radius: 8px; cursor: pointer; border: 1px solid #E2E8F0; background: #F8FAFC;" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="d-flex align-items-center justify-content-center fw-bold rounded-lg" style="width: 26px; height: 26px; font-size: 11px; background: #ECFDF5; color: #059669; border-radius: 6px;">
                                        @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                                    </div>
                                    <span class="fw-semibold text-truncate" style="max-width: 140px; color: #0F172A; font-size: 0.85rem;">
                                        @(User.Identity.Name ?? "Nhân viên")
                                    </span>
                                    <i class="bi bi-chevron-down small" style="color: #64748B;"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end mt-2 shadow-sm border" style="border-color: #E2E8F0; border-radius: 10px;">
                                    <li class="px-3 py-2" style="border-bottom: 1px solid #E2E8F0;">
                                        <div class="small fw-bold" style="color: #0F172A;">@User.Identity.Name</div>
                                        <div class="small text-truncate font-mono" style="color: #64748B; font-size: 0.75rem;">@User.FindFirstValue(ClaimTypes.Email)</div>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Account" asp-action="ChangePassword">
                                            <i class="bi bi-key me-2 text-success"></i> Đổi mật khẩu
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item py-2" style="color: #EF4444;">
                                                <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto align-items-center gap-1 gap-lg-2 mt-2 mt-lg-0">
                            <li class="nav-item">
                                <a class="nav-link ats-nav-link" href="/landing#about">
                                    Về NoveraTech
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link ats-nav-link" href="/landing#benefits">
                                    Đãi ngộ & Văn hóa
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link ats-nav-link fw-semibold" asp-controller="Jobs" asp-action="Index" style="color: #059669;">
                                    <i class="bi bi-briefcase me-1"></i> Cơ hội việc làm (12+)
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link ats-nav-link" href="/landing#process">
                                    Quy trình tuyển dụng
                                </a>
                            </li>
                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-sm px-3 fw-semibold text-white" style="background: #059669; border-radius: 8px;" asp-controller="Account" asp-action="CandidateAuth">
                                    <i class="bi bi-send me-1"></i> Nộp hồ sơ
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-light border btn-sm px-2 text-muted" style="border-radius: 8px; font-size: 0.8rem;" asp-controller="Account" asp-action="StaffLogin" title="Dành riêng cho nhân sự NoveraTech">
                                    <i class="bi bi-shield-lock me-1"></i> Nội bộ
                                </a>
                            </li>
                        </ul>
                    }

                </div>
            </div>
        </nav>
    </header>

    <!-- Global Alert Banners -->
    <div class="container-fluid px-3 px-md-4 pt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                <div class="flex-grow-1">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["WarningMessage"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                <div class="flex-grow-1">@TempData["WarningMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center" role="alert">
                <i class="bi bi-x-circle-fill me-2 fs-5"></i>
                <div class="flex-grow-1">@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="py-3 mt-auto" style="background: #FFFFFF; border-top: 1px solid #E2E8F0;">
        <div class="container-fluid px-3 px-md-4 d-flex flex-column flex-sm-row align-items-center justify-content-between gap-2 small text-muted">
            <div class="d-flex align-items-center gap-2">
                <span style="font-weight: 600; color: #0F172A;"><i class="bi bi-hexagon-fill text-success me-1"></i>NoveraTech</span>
                <span>&copy; @DateTime.UtcNow.Year</span>
                <span>&middot;</span>
                <span>Tham gia và làm việc với chúng mình ngay hôm nay!</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <a href="/landing" class="text-decoration-none text-muted" style="font-size: 0.8rem;">Cổng Tuyển Dụng</a>
                <a asp-controller="Account" asp-action="StaffLogin" class="text-decoration-none text-muted" style="font-size: 0.8rem;">Nhân sự</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
