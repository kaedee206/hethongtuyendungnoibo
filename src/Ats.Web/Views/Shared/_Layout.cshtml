<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hệ Thống Tuyển Dụng Nội Bộ</title>
    <meta name="description" content="Hệ thống Tuyển dụng Nội bộ (ATS) — Quản lý toàn bộ quy trình tuyển dụng nội bộ doanh nghiệp." />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Ats.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        @await Component.InvokeAsync("NavMenu")
    </header>
    <div class="container-fluid px-4">
        <main role="main" id="main-content" class="py-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer mt-auto">
        <div class="container-fluid px-4 py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <small>&copy; @DateTime.Now.Year — Hệ Thống Tuyển Dụng Nội Bộ (ATS)</small>
            <small class="text-muted">v1.0.0</small>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
