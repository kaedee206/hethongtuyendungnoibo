@using Ats.Web.Models.ViewModels.TalentPool
@model TalentPoolSuggestionListViewModel
@{
    ViewData["Title"] = $"Gợi ý ứng viên tiềm năng — {Model.JobTitle}";
    Layout = "_Layout";
    var highMatchCount = Model.Suggestions.Count(s => s.MatchScore >= 75);
    var medMatchCount = Model.Suggestions.Count(s => s.MatchScore >= 50 && s.MatchScore < 75);
    var lowMatchCount = Model.Suggestions.Count(s => s.MatchScore < 50);
    var notAppliedCount = Model.Suggestions.Count(s => !s.HasAppliedToThisJob);
}

<style>
    /* Bố cục trang Gợi ý ứng viên */
    .suggestion-header-card {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
        position: relative;
        overflow: hidden;
    }
    .suggestion-header-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, #059669 0%, #10B981 50%, #3B82F6 100%);
    }

    .kpi-chip {
        padding: 0.5rem 0.85rem;
        border-radius: 10px;
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
    }

    .candidate-card {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        padding: 1.25rem;
        transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03);
    }
    .candidate-card:hover {
        transform: translateY(-2px);
        border-color: #CBD5E1;
        box-shadow: 0 6px 16px -2px rgba(15, 23, 42, 0.08);
    }

    /* Huy hiệu độ khớp */
    .match-badge {
        font-family: 'JetBrains Mono', monospace;
        font-weight: 700;
        font-size: 0.85rem;
        padding: 0.3rem 0.65rem;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        white-space: nowrap;
    }
    .match-badge-high {
        background: #ECFDF5;
        color: #047857;
        border: 1px solid #A7F3D0;
    }
    .match-badge-medium {
        background: #EFF6FF;
        color: #1D4ED8;
        border: 1px solid #BFDBFE;
    }
    .match-badge-low {
        background: #F8FAFC;
        color: #475569;
        border: 1px solid #E2E8F0;
    }

    /* Thẻ ghi nhận vòng trước */
    .candidate-note-quote {
        padding: 0.5rem 0.75rem;
        border-left: 3px solid #10B981;
        background: #F8FAFC;
        border-radius: 0 8px 8px 0;
        font-size: 0.8rem;
        line-height: 1.45;
    }

    /* Tag kỹ năng */
    .skill-tag {
        background: #F1F5F9;
        color: #334155;
        border-radius: 6px;
        font-size: 0.74rem;
        font-weight: 500;
        padding: 0.2rem 0.5rem;
        display: inline-flex;
        align-items: center;
    }
    .skill-tag-match {
        background: #ECFDF5;
        color: #065F46;
        border: 1px solid #A7F3D0;
    }

    /* Nút lọc */
    .filter-btn {
        font-size: 0.82rem;
        font-weight: 500;
        padding: 0.35rem 0.75rem;
        border-radius: 8px;
        border: 1px solid #E2E8F0;
        background: #FFFFFF;
        color: #64748B;
        transition: all 0.15s ease;
        cursor: pointer;
    }
    .filter-btn:hover {
        background: #F8FAFC;
        color: #0F172A;
    }
    .filter-btn.active {
        background: #0F172A;
        color: #FFFFFF;
        border-color: #0F172A;
    }

    /* Nút đổi dạng xem Grid / List */
    .view-btn {
        width: 32px;
        height: 32px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        border: 1px solid #E2E8F0;
        background: #FFFFFF;
        color: #64748B;
    }
    .view-btn.active {
        background: #059669;
        border-color: #059669;
        color: #FFFFFF;
    }

    /* Chế độ danh sách (List View) */
    .suggestion-list-mode .candidate-col {
        width: 100% !important;
        max-width: 100% !important;
    }
    .suggestion-list-mode .candidate-card {
        padding: 1rem 1.25rem;
    }
</style>

<div class="container-fluid px-3 px-lg-4 py-3">

    <!-- Thanh điều hướng và tác vụ nhanh -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0" style="font-size: 0.82rem;">
                <li class="breadcrumb-item">
                    <a href="/dashboard" class="text-decoration-none text-muted">
                        <i class="bi bi-house-door me-1"></i>Bàn làm việc
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="/kho-tiem-nang" class="text-decoration-none text-muted">Kho tiềm năng</a>
                </li>
                <li class="breadcrumb-item active fw-semibold text-dark" aria-current="page">
                    Gợi ý ứng viên: @Model.JobCode
                </li>
            </ol>
        </nav>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            @if (Model.AvailableOpenJobs.Any())
            {
                <div class="dropdown">
                    <button class="btn btn-sm btn-white border rounded-3 dropdown-toggle shadow-none d-inline-flex align-items-center gap-1.5"
                            type="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.82rem; border-color: #CBD5E1; height: 32px;">
                        <i class="bi bi-arrow-repeat text-muted"></i>
                        <span>Đổi vị trí khác (@Model.AvailableOpenJobs.Count)</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border mt-1 py-1" style="border-radius: 10px; min-width: 300px; max-height: 380px; overflow-y: auto; font-size: 0.82rem;">
                        <li class="dropdown-header text-uppercase text-muted fw-bold" style="font-size: 0.7rem;">Chọn vị trí tuyển dụng:</li>
                        @foreach (var j in Model.AvailableOpenJobs)
                        {
                            <li>
                                <a class="dropdown-item py-2 px-3 @(j.Id == Model.JobId ? "active bg-light text-dark fw-bold" : "")" href="/kho-tiem-nang/goi-y/@j.Id">
                                    <div class="text-truncate">@j.Title</div>
                                    <div class="text-muted" style="font-size: 0.72rem;">@j.Department • @j.Code</div>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }

            <a href="/Jobs/@Model.JobId" class="btn btn-sm btn-white border rounded-3 d-inline-flex align-items-center gap-1.5 text-secondary shadow-none" style="font-size: 0.82rem; border-color: #CBD5E1; height: 32px;" title="Xem mô tả công việc">
                <i class="bi bi-file-earmark-text text-primary"></i>
                <span class="d-none d-sm-inline">Xem JD tin tuyển dụng</span>
            </a>
            <a href="/kho-tiem-nang" class="btn btn-sm btn-outline-secondary rounded-3 d-inline-flex align-items-center gap-1.5 shadow-none" style="font-size: 0.82rem; height: 32px;">
                <i class="bi bi-arrow-left"></i>
                <span>Quay lại Kho</span>
            </a>
        </div>
    </div>

    <!-- Khối thông tin vị trí tuyển dụng & chỉ số đề xuất -->
    <div class="suggestion-header-card p-3 p-md-4 mb-3.5">
        <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-3">
            <div class="flex-grow-1">
                <!-- Nhãn phòng ban & mã tin -->
                <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                    <span class="badge font-monospace px-2.5 py-1 text-white fw-bold" style="background: #0F172A; border-radius: 6px; font-size: 0.75rem;">
                        @Model.JobCode
                    </span>
                    <span class="badge px-2.5 py-1 fw-semibold text-secondary" style="background: #F1F5F9; border-radius: 6px; font-size: 0.75rem; border: 1px solid #E2E8F0;">
                        <i class="bi bi-building me-1"></i>@Model.DepartmentName
                    </span>
                    <span class="badge px-2.5 py-1 fw-semibold" style="background: #EEF2FF; color: #4F46E5; border: 1px solid #C7D2FE; border-radius: 6px; font-size: 0.75rem;">
                        <i class="bi bi-stars me-1"></i>Gợi ý tự động
                    </span>
                </div>

                <!-- Tên vị trí tuyển dụng -->
                <h4 class="fw-bold text-dark mb-1" style="letter-spacing: -0.01em;">
                    @Model.JobTitle
                </h4>

                <p class="text-muted mb-0 small" style="line-height: 1.45; max-width: 720px;">
                    Hệ thống rà soát từ kho ứng viên dựa trên chức danh chuyên môn, từ khóa kỹ năng và lịch sử đánh giá phỏng vấn.
                </p>

                <!-- Kỹ năng yêu cầu -->
                @if (Model.SkillsRequired != null && Model.SkillsRequired.Any())
                {
                    <div class="d-flex align-items-center gap-1.5 flex-wrap mt-2.5">
                        <span class="text-muted small fw-medium me-1">Kỹ năng trọng tâm:</span>
                        @foreach (var sk in Model.SkillsRequired)
                        {
                            <span class="skill-tag skill-tag-match">@sk</span>
                        }
                    </div>
                }
            </div>

            <!-- Chỉ số nhanh -->
            <div class="d-flex align-items-center gap-2.5 flex-shrink-0">
                <div class="kpi-chip">
                    <span class="h4 fw-bold text-success mb-0 font-monospace">@Model.Suggestions.Count</span>
                    <span class="small text-muted fw-semibold">Ứng viên đề xuất</span>
                </div>
                <div class="kpi-chip">
                    <span class="h4 fw-bold text-primary mb-0 font-monospace">@highMatchCount</span>
                    <span class="small text-muted fw-semibold">Khớp cao (≥75%)</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sách ứng viên đề xuất -->
    @if (!Model.Suggestions.Any())
    {
        <div class="card border-0 shadow-sm bg-white text-center py-5" style="border: 1px solid #E2E8F0 !important; border-radius: 12px;">
            <div class="py-4">
                <div class="d-inline-flex p-3 rounded-circle mb-3" style="background:#F1F5F9; color:#64748B;">
                    <i class="bi bi-person-x fs-1"></i>
                </div>
                <h5 class="fw-bold text-dark mb-1">Chưa có ứng viên tiềm năng phù hợp với vị trí này</h5>
                <p class="text-muted small mb-3" style="max-width: 460px; margin: 0 auto;">
                    Hiện trong Kho chưa có hồ sơ có kỹ năng hoặc chức danh tương thích với <strong>@Model.JobTitle</strong>.
                </p>
                <a href="/kho-tiem-nang" class="btn btn-sm btn-primary rounded-3 px-3.5 py-2 shadow-sm fw-semibold" style="background: #059669; border-color: #059669; font-size: 0.84rem;">
                    <i class="bi bi-collection me-1.5"></i>Xem tất cả ứng viên trong Kho
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Thanh bộ lọc & tìm kiếm nhanh -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-3 p-2 rounded-3 bg-white border" style="border-color: #E2E8F0 !important;">
            <div class="d-flex align-items-center gap-1.5 flex-wrap">
                <button type="button" class="filter-btn active" onclick="applyCandidateFilter('ALL', this)">
                    Tất cả <span class="badge rounded-pill bg-light text-dark ms-1">@Model.Suggestions.Count</span>
                </button>
                @if (highMatchCount > 0)
                {
                    <button type="button" class="filter-btn" onclick="applyCandidateFilter('HIGH', this)">
                        <i class="bi bi-shield-check text-success me-1"></i>Khớp cao ≥75% <span class="badge rounded-pill bg-light text-dark ms-1">@highMatchCount</span>
                    </button>
                }
                @if (medMatchCount > 0)
                {
                    <button type="button" class="filter-btn" onclick="applyCandidateFilter('MEDIUM', this)">
                        <i class="bi bi-check-circle text-primary me-1"></i>Khớp khá 50-74% <span class="badge rounded-pill bg-light text-dark ms-1">@medMatchCount</span>
                    </button>
                }
                @if (lowMatchCount > 0)
                {
                    <button type="button" class="filter-btn" onclick="applyCandidateFilter('LOW', this)">
                        Tiềm năng <span class="badge rounded-pill bg-light text-dark ms-1">@lowMatchCount</span>
                    </button>
                }
                @if (notAppliedCount > 0)
                {
                    <button type="button" class="filter-btn" onclick="applyCandidateFilter('NOT_APPLIED', this)">
                        <i class="bi bi-send text-secondary me-1"></i>Chưa mời <span class="badge rounded-pill bg-light text-dark ms-1">@notAppliedCount</span>
                    </button>
                }
            </div>

            <div class="d-flex align-items-center gap-2 w-100 w-md-auto justify-content-between justify-content-md-end">
                <div class="input-group input-group-sm" style="max-width: 240px;">
                    <span class="input-group-text bg-light border-end-0" style="border-color: #E2E8F0;"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="candidateSearchInput" class="form-control border-start-0" placeholder="Lọc tên, kỹ năng..." style="border-color: #E2E8F0; font-size: 0.8rem;" oninput="onSearchCandidates(this.value)" autocomplete="off" />
                </div>

                <!-- Chuyển chế độ Lưới / Danh sách -->
                <div class="btn-group btn-group-sm" role="group" aria-label="Chế độ xem">
                    <button type="button" class="view-btn active" id="btnViewGrid" onclick="setSuggestionViewMode('grid')" title="Dạng lưới 2 cột">
                        <i class="bi bi-grid-fill"></i>
                    </button>
                    <button type="button" class="view-btn" id="btnViewList" onclick="setSuggestionViewMode('list')" title="Dạng danh sách 1 cột">
                        <i class="bi bi-view-stacked"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Khung danh sách thẻ ứng viên -->
        <div class="row g-3" id="suggestionCardsContainer">
            @foreach (var s in Model.Suggestions)
            {
                var isHigh = s.MatchScore >= 75;
                var isMedium = s.MatchScore >= 50 && s.MatchScore < 75;
                var badgeClass = isHigh ? "match-badge-high" : (isMedium ? "match-badge-medium" : "match-badge-low");
                var scoreCategory = isHigh ? "HIGH" : (isMedium ? "MEDIUM" : "LOW");
                var ratingVal = s.Rating ?? 0;

                <div class="col-12 col-lg-6 candidate-col candidate-item-card"
                     data-score="@s.MatchScore"
                     data-category="@scoreCategory"
                     data-applied="@(s.HasAppliedToThisJob ? "true" : "false")"
                     data-name="@s.CandidateFullName.ToLower()"
                     data-title="@s.TargetJobTitle.ToLower()"
                     data-skills="@string.Join(" ", s.MatchingSkills).ToLower()">
                    <div class="candidate-card h-100 d-flex flex-column justify-content-between">
                        <div>
                            <!-- Đầu thẻ: Avatar, Tên, Đánh giá & Điểm khớp -->
                            <div class="d-flex align-items-start justify-content-between gap-2.5 mb-2.5">
                                <div class="d-flex align-items-start gap-2.5">
                                    <div class="d-flex align-items-center justify-content-center text-white fw-bold flex-shrink-0"
                                         style="width: 42px; height: 42px; border-radius: 10px; background: #0F172A; font-size: 1.1rem;">
                                        @(s.CandidateFullName.Length > 0 ? s.CandidateFullName.Substring(0, 1).ToUpper() : "?")
                                    </div>
                                    <div>
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <a href="/ung-vien/@s.CandidateId" class="fw-bold text-dark text-decoration-none hover-primary mb-0" style="font-size: 0.98rem;">
                                                @s.CandidateFullName
                                            </a>
                                            @if (ratingVal > 0)
                                            {
                                                <div class="d-inline-flex align-items-center text-warning" title="Đánh giá: @ratingVal/5 sao">
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        <i class="bi @(i <= ratingVal ? "bi-star-fill text-warning" : "bi-star text-muted opacity-25")" style="font-size: 0.72rem;"></i>
                                                    }
                                                </div>
                                            }
                                        </div>

                                        <div class="text-muted small mt-0.5">
                                            <span>Chức danh quan tâm:</span> <strong class="text-dark">@s.TargetJobTitle</strong>
                                        </div>

                                        <!-- Thông tin liên hệ -->
                                        <div class="d-flex align-items-center gap-3 text-muted mt-1.5 font-monospace flex-wrap" style="font-size: 0.78rem;">
                                            <span>
                                                <i class="bi bi-envelope me-1 text-slate-400"></i><!--email_off-->@s.CandidateEmail<!--/email_off-->
                                            </span>
                                            @if (!string.IsNullOrWhiteSpace(s.CandidatePhone))
                                            {
                                                <span><i class="bi bi-telephone me-1 text-slate-400"></i>@s.CandidatePhone</span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <!-- Huy hiệu độ khớp & thanh tiến độ -->
                                <div class="text-end flex-shrink-0" style="min-width: 90px;">
                                    <div class="match-badge @badgeClass">
                                        <i class="bi @(isHigh ? "bi-shield-check" : (isMedium ? "bi-check-circle" : "bi-stars"))"></i>
                                        <span>@s.MatchScore%</span>
                                    </div>
                                    <div class="progress mt-1.5" style="height: 5px; background: #E2E8F0; border-radius: 4px;">
                                        <div class="progress-bar @(isHigh ? "bg-success" : (isMedium ? "bg-primary" : "bg-secondary"))"
                                             role="progressbar" style="width: @s.MatchScore%; border-radius: 4px;"></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Điểm nổi bật & Kỹ năng khớp -->
                            <div class="mt-2.5 pt-2 border-top">
                                <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap mb-1.5">
                                    <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                        @if (!string.IsNullOrWhiteSpace(s.LastStageReached))
                                        {
                                            <span class="badge bg-light text-secondary border fw-normal" style="font-size: 0.72rem; border-radius: 6px;">
                                                Vòng trước: @s.LastStageReached
                                            </span>
                                        }
                                        @foreach (var msk in s.MatchingSkills)
                                        {
                                            <span class="skill-tag skill-tag-match">
                                                <i class="bi bi-check me-0.5"></i>@msk
                                            </span>
                                        }
                                    </div>
                                </div>

                                <!-- Ghi nhận từ đợt tuyển dụng trước -->
                                @if (!string.IsNullOrWhiteSpace(s.Reason))
                                {
                                    <div class="candidate-note-quote mt-2">
                                        <i class="bi bi-chat-quote text-success me-1"></i>
                                        <span class="fst-italic text-secondary">"@s.Reason"</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Chân thẻ: Nút tác vụ -->
                        <div class="pt-2.5 mt-3 d-flex align-items-center justify-content-between gap-2 border-top">
                            <a href="/ung-vien/@s.CandidateId" class="btn btn-sm btn-outline-secondary rounded-2 d-inline-flex align-items-center gap-1.5" style="font-size: 0.78rem; padding: 0.35rem 0.75rem;">
                                <i class="bi bi-file-earmark-person"></i>
                                <span>Xem hồ sơ</span>
                            </a>

                            @if (s.HasAppliedToThisJob)
                            {
                                <span class="badge d-inline-flex align-items-center gap-1.5" style="background:#F1F5F9; color:#475569; border:1px solid #CBD5E1; border-radius: 6px; padding: 0.4rem 0.75rem; font-size: 0.76rem; font-weight: 600;">
                                    <i class="bi bi-check2-circle text-success"></i>Đã nộp vị trí này
                                </span>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-success rounded-2 d-inline-flex align-items-center gap-1.5 shadow-sm text-white fw-semibold"
                                        style="background: #059669; border-color: #059669; font-size: 0.8rem; padding: 0.35rem 0.85rem;"
                                        onclick="openQuickInviteModal('@s.TalentPoolId', '@s.CandidateFullName', '@Model.JobId', '@Model.JobTitle')">
                                    <i class="bi bi-send-fill"></i>
                                    <span>Mời ứng tuyển</span>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Trạng thái không tìm thấy theo bộ lọc -->
        <div id="noMatchFilterState" class="card border-0 shadow-sm bg-white text-center py-5 d-none mt-3" style="border: 1px solid #E2E8F0 !important; border-radius: 12px;">
            <div class="py-3">
                <i class="bi bi-funnel text-muted fs-2 mb-2 d-block"></i>
                <h6 class="fw-bold text-dark mb-1">Không tìm thấy ứng viên phù hợp</h6>
                <p class="text-muted small mb-2">Thử điều chỉnh lại từ khóa hoặc chọn bộ lọc "Tất cả".</p>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-2" onclick="resetCandidateFilters()">
                    Đặt lại bộ lọc
                </button>
            </div>
        </div>
    }

</div>

<!-- Modal xác nhận mời ứng tuyển -->
<div class="modal fade" id="quickInviteModal" tabindex="-1" aria-labelledby="quickInviteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
            <div class="modal-header border-0 pb-0 pt-3 px-4">
                <div class="d-flex align-items-center gap-2.5">
                    <div class="d-flex align-items-center justify-content-center text-success rounded-2" style="width: 36px; height: 36px; background: #ECFDF5; border: 1px solid #A7F3D0;">
                        <i class="bi bi-send-fill fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="quickInviteModalLabel" style="font-size: 1.05rem;">
                            Mời Ứng Viên Vào Vị Trí Tuyển Dụng
                        </h5>
                        <small class="text-muted" style="font-size: 0.78rem;">Tự động tạo hồ sơ ứng tuyển từ kho tiềm năng</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form action="/kho-tiem-nang/moi-ung-tuyen" method="post" id="quickInviteForm" onsubmit="handleQuickInviteSubmit(event)">
                @Html.AntiForgeryToken()
                <input type="hidden" name="TalentPoolId" id="quickInviteTalentPoolId" />
                <input type="hidden" name="JobPostingId" id="quickInviteJobPostingId" />

                <div class="modal-body py-3 px-4">
                    <div class="p-3 mb-3 rounded-2" style="background:#F8FAFC; border:1px solid #E2E8F0;">
                        <div class="d-flex justify-content-between mb-1.5">
                            <span class="text-muted small">Ứng viên:</span>
                            <span class="fw-bold text-dark small" id="quickInviteCandidateName">-</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted small">Vị trí mời tham gia:</span>
                            <span class="fw-bold text-primary small" id="quickInviteJobTitle">-</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Ghi chú tiếp cận / trao đổi</label>
                        <textarea name="Note" class="form-control form-control-sm rounded-2" rows="3" placeholder="Ghi chú về việc liên hệ, ứng viên đã được hệ thống gợi ý từ kho tiềm năng..."></textarea>
                    </div>

                    <div class="form-check form-switch p-0 d-flex align-items-center gap-2">
                        <input class="form-check-input ms-0 me-2" type="checkbox" name="SendEmail" value="true" id="quickInviteSendEmail" checked style="cursor: pointer;">
                        <label class="form-check-label small text-dark fw-medium" for="quickInviteSendEmail" style="cursor: pointer;">
                            Gửi email thư mời ứng tuyển vị trí mới cho ứng viên
                        </label>
                    </div>
                </div>

                <div class="modal-footer border-0 pt-0 px-4 pb-3">
                    <button type="button" class="btn btn-sm btn-light border rounded-2 px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" id="btnSubmitQuickInvite" class="btn btn-sm btn-success rounded-2 px-4 text-white fw-semibold shadow-sm" style="background: #059669; border-color: #059669;">
                        <i class="bi bi-send-fill me-1"></i>Xác nhận & Mời
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var currentFilterCategory = window.currentFilterCategory || 'ALL';
    var currentSearchText = window.currentSearchText || '';

    window.openQuickInviteModal = function (talentPoolId, candidateName, jobId, jobTitle) {
        var poolIdEl = document.getElementById('quickInviteTalentPoolId');
        var jobIdEl = document.getElementById('quickInviteJobPostingId');
        var nameEl = document.getElementById('quickInviteCandidateName');
        var titleEl = document.getElementById('quickInviteJobTitle');
        var modalEl = document.getElementById('quickInviteModal');

        if (poolIdEl) poolIdEl.value = talentPoolId;
        if (jobIdEl) jobIdEl.value = jobId;
        if (nameEl) nameEl.textContent = candidateName;
        if (titleEl) titleEl.textContent = jobTitle;

        if (modalEl && typeof bootstrap !== 'undefined') {
            bootstrap.Modal.getOrCreateInstance(modalEl).show();
        }
    };

    window.handleQuickInviteSubmit = function (e) {
        if (window.atsInstant && typeof window.atsInstant.clearCache === 'function') {
            window.atsInstant.clearCache();
        }
    };

    window.applyCandidateFilter = function (category, btnElement) {
        currentFilterCategory = category || 'ALL';
        var buttons = document.querySelectorAll('.filter-btn');
        buttons.forEach(function (b) { b.classList.remove('active'); });
        if (btnElement) btnElement.classList.add('active');
        renderFilteredCards();
    };

    window.onSearchCandidates = function (query) {
        currentSearchText = (query || '').trim().toLowerCase();
        renderFilteredCards();
    };

    function renderFilteredCards() {
        var cards = document.querySelectorAll('.candidate-item-card');
        var visibleCount = 0;

        cards.forEach(function (card) {
            var category = card.getAttribute('data-category');
            var isApplied = card.getAttribute('data-applied') === 'true';
            var name = card.getAttribute('data-name') || '';
            var title = card.getAttribute('data-title') || '';
            var skills = card.getAttribute('data-skills') || '';

            var categoryMatch = false;
            if (currentFilterCategory === 'ALL') {
                categoryMatch = true;
            } else if (currentFilterCategory === 'HIGH') {
                categoryMatch = (category === 'HIGH');
            } else if (currentFilterCategory === 'MEDIUM') {
                categoryMatch = (category === 'MEDIUM');
            } else if (currentFilterCategory === 'LOW') {
                categoryMatch = (category === 'LOW');
            } else if (currentFilterCategory === 'NOT_APPLIED') {
                categoryMatch = (!isApplied);
            }

            var searchMatch = true;
            if (currentSearchText.length > 0) {
                var combined = name + ' ' + title + ' ' + skills;
                searchMatch = combined.includes(currentSearchText);
            }

            if (categoryMatch && searchMatch) {
                card.classList.remove('d-none');
                visibleCount++;
            } else {
                card.classList.add('d-none');
            }
        });

        var noMatchEl = document.getElementById('noMatchFilterState');
        if (noMatchEl) {
            if (visibleCount === 0) {
                noMatchEl.classList.remove('d-none');
            } else {
                noMatchEl.classList.add('d-none');
            }
        }
    }

    window.resetCandidateFilters = function () {
        currentFilterCategory = 'ALL';
        currentSearchText = '';
        var searchInput = document.getElementById('candidateSearchInput');
        if (searchInput) searchInput.value = '';
        var allBtn = document.querySelector('.filter-btn');
        if (allBtn) {
            document.querySelectorAll('.filter-btn').forEach(function (b) { b.classList.remove('active'); });
            allBtn.classList.add('active');
        }
        renderFilteredCards();
    };

    window.setSuggestionViewMode = function (mode) {
        var container = document.getElementById('suggestionCardsContainer');
        var btnGrid = document.getElementById('btnViewGrid');
        var btnList = document.getElementById('btnViewList');
        if (!container) return;

        if (mode === 'list') {
            container.classList.add('suggestion-list-mode');
            if (btnList) btnList.classList.add('active');
            if (btnGrid) btnGrid.classList.remove('active');
        } else {
            container.classList.remove('suggestion-list-mode');
            if (btnGrid) btnGrid.classList.add('active');
            if (btnList) btnList.classList.remove('active');
        }
    };
</script>
}
