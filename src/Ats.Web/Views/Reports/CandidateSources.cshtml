@model Ats.Web.Models.DTOs.CandidateSourceReportSummaryDto
@{
    ViewData["Title"] = "Báo cáo Hiệu quả Nguồn Ứng viên";
    Layout = "_Layout";

    var positions = ViewBag.Positions as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var requisitions = ViewBag.Requisitions as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();

    var fromDateVal = Model.Filter.FromDate?.ToString("yyyy-MM-dd") ?? "";
    var toDateVal = Model.Filter.ToDate?.ToString("yyyy-MM-dd") ?? "";
    var selectedPositionId = Model.Filter.JobPositionId?.ToString() ?? "";
    var selectedRequisitionId = Model.Filter.JobRequisitionId?.ToString() ?? "";

    var exportUrl = Url.Action("ExportCandidateSources", "Reports", new {
        FromDate = fromDateVal,
        ToDate = toDateVal,
        JobPositionId = Model.Filter.JobPositionId,
        JobRequisitionId = Model.Filter.JobRequisitionId,
        JobPostingId = Model.Filter.JobPostingId
    });
}

<div class="container-fluid px-3 px-md-4 py-4" style="max-width: 1400px;">
    <!-- Breadcrumb -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0" style="font-size: 0.85rem;">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
                <li class="breadcrumb-item"><span class="text-muted">Báo cáo &amp; Phân tích</span></li>
                <li class="breadcrumb-item active text-success fw-semibold" aria-current="page">Hiệu quả Nguồn Ứng viên</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center gap-2">
            <a href="@exportUrl" class="btn btn-sm btn-success d-inline-flex align-items-center gap-1.5 shadow-sm fw-semibold px-3 py-1.5" style="border-radius: 8px; background: #059669; border-color: #059669;">
                <i class="bi bi-file-earmark-excel"></i> Xuất Excel (.xlsx)
            </a>
            <a href="/reports/candidate-sources" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1.5" style="border-radius: 8px;" title="Đặt lại bộ lọc mặc định">
                <i class="bi bi-arrow-clockwise"></i> Tải lại
            </a>
        </div>
    </div>

    <!-- Page Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge px-2.5 py-1 fw-semibold text-uppercase" 
                      style="font-size: 0.72rem; letter-spacing: 0.05em; background: #ECFDF5; color: #047857; border: 1px solid #A7F3D0; border-radius: 6px;">
                    <i class="bi bi-pie-chart me-1"></i>Báo cáo Tuyển dụng
                </span>
                <h1 class="h3 fw-bold mb-0" style="color: #0F172A;">Báo cáo Hiệu quả Nguồn Ứng viên &amp; Đánh giá Chất lượng Kênh</h1>
            </div>
            <p class="text-muted small mb-0">
                Thống kê đa chiều tỷ lệ chuyển đổi từng kênh tuyển dụng: Tổng CV, Tỷ lệ qua sàng lọc, Số lượng phỏng vấn và Tỷ lệ nhận việc để tối ưu ngân sách tuyển dụng.
            </p>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; border: 1px solid #E2E8F0 !important;">
        <div class="card-body p-3 p-md-4">
            <form method="get" asp-controller="Reports" asp-action="CandidateSources" id="filterForm">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-sm-6 col-lg-3">
                        <label class="form-label small fw-semibold text-secondary mb-1">
                            <i class="bi bi-calendar3 me-1 text-success"></i> Từ ngày
                        </label>
                        <input type="date" name="FromDate" id="filterFromDate" class="form-control form-control-sm" value="@fromDateVal" style="border-radius: 8px; border-color: #CBD5E1;" />
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3">
                        <label class="form-label small fw-semibold text-secondary mb-1">
                            <i class="bi bi-calendar3 me-1 text-success"></i> Đến ngày
                        </label>
                        <input type="date" name="ToDate" id="filterToDate" class="form-control form-control-sm" value="@toDateVal" style="border-radius: 8px; border-color: #CBD5E1;" />
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3">
                        <label class="form-label small fw-semibold text-secondary mb-1">
                            <i class="bi bi-person-badge me-1 text-muted"></i> Vị trí / Chức danh
                        </label>
                        <select name="JobPositionId" class="form-select form-select-sm" style="border-radius: 8px; border-color: #CBD5E1;">
                            <option value="">-- Tất cả vị trí tuyển dụng --</option>
                            @foreach (var pos in positions)
                            {
                                <option value="@pos.Value" selected="@(selectedPositionId == pos.Value)">@pos.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-sm btn-primary flex-grow-1 fw-semibold d-flex align-items-center justify-content-center gap-1.5" style="border-radius: 8px; background: #0D5C4D; border-color: #0D5C4D;">
                                <i class="bi bi-funnel"></i> Lọc dữ liệu
                            </button>
                            <a href="/reports/candidate-sources" class="btn btn-sm btn-light border text-muted" style="border-radius: 8px;" title="Xóa bộ lọc">
                                <i class="bi bi-x-circle"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Quick Date Presets -->
                <div class="d-flex align-items-center gap-2 mt-3 pt-2 border-top flex-wrap" style="border-color: #F1F5F9 !important;">
                    <span class="text-muted small fw-medium" style="font-size: 0.78rem;">Khoảng nhanh:</span>
                    <button type="button" class="btn btn-xs btn-outline-secondary py-0.5 px-2" style="font-size: 0.75rem; border-radius: 6px;" onclick="setDatePreset(30)">30 ngày gần nhất</button>
                    <button type="button" class="btn btn-xs btn-outline-secondary py-0.5 px-2" style="font-size: 0.75rem; border-radius: 6px;" onclick="setDatePreset(90)">90 ngày gần nhất</button>
                    <button type="button" class="btn btn-xs btn-outline-secondary py-0.5 px-2" style="font-size: 0.75rem; border-radius: 6px;" onclick="setDatePreset(180)">6 tháng gần đây</button>
                    <button type="button" class="btn btn-xs btn-outline-secondary py-0.5 px-2" style="font-size: 0.75rem; border-radius: 6px;" onclick="setDatePreset(365)">1 năm qua</button>
                    <button type="button" class="btn btn-xs btn-outline-secondary py-0.5 px-2" style="font-size: 0.75rem; border-radius: 6px;" onclick="clearDatePreset()">Toàn bộ thời gian</button>
                </div>
            </form>
        </div>
    </div>

    <!-- 3 Executive KPI Cards (AC2) -->
    <div class="row g-3 mb-4">
        <!-- Card 1: Nguồn chất lượng cao nhất -->
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; border: 1px solid #A7F3D0 !important; background: linear-gradient(145deg, #FFFFFF 0%, #F0FDF4 100%);">
                <div class="card-body p-3.5">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <div class="d-flex align-items-center justify-content-center rounded-3" style="width: 42px; height: 42px; background: #ECFDF5; color: #059669; border: 1px solid #A7F3D0;">
                                <i class="bi bi-trophy-fill fs-5"></i>
                            </div>
                            <div>
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-0.5 small fw-semibold" style="border-radius: 4px; font-size: 0.7rem;">
                                    🏆 TOP QUALITY
                                </span>
                                <div class="text-muted small fw-medium" style="font-size: 0.78rem;">Nguồn chất lượng cao nhất</div>
                            </div>
                        </div>
                    </div>
                    <div class="mt-2">
                        @if (!string.IsNullOrEmpty(Model.TopQualitySource))
                        {
                            <h4 class="fw-bold mb-1 text-truncate" style="color: #064E3B;" title="@Model.TopQualitySource">
                                @Model.TopQualitySource
                            </h4>
                            <div class="d-flex align-items-baseline gap-2">
                                <span class="display-6 fw-bold text-success" style="font-size: 1.85rem;">@Model.TopQualityHireRate.ToString("F1")%</span>
                                <span class="text-muted small">tỷ lệ trúng tuyển nhận việc</span>
                            </div>
                            <div class="text-secondary small mt-1" style="font-size: 0.78rem;">
                                <i class="bi bi-shield-check text-success me-1"></i>Đạt hiệu quả chuyển đổi và tỷ lệ qua sàng lọc tối ưu
                            </div>
                        }
                        else
                        {
                            <div class="text-muted py-2 small">
                                <i class="bi bi-info-circle me-1"></i>Chưa đủ dữ liệu ứng viên để xếp hạng kênh chất lượng cao.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Nguồn nhiều hồ sơ nhất -->
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; border: 1px solid #BFDBFE !important; background: linear-gradient(145deg, #FFFFFF 0%, #EFF6FF 100%);">
                <div class="card-body p-3.5">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <div class="d-flex align-items-center justify-content-center rounded-3" style="width: 42px; height: 42px; background: #DBEAFE; color: #2563EB; border: 1px solid #BFDBFE;">
                                <i class="bi bi-bar-chart-fill fs-5"></i>
                            </div>
                            <div>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-0.5 small fw-semibold" style="border-radius: 4px; font-size: 0.7rem;">
                                    📈 TOP VOLUME
                                </span>
                                <div class="text-muted small fw-medium" style="font-size: 0.78rem;">Nguồn nhiều hồ sơ nhất</div>
                            </div>
                        </div>
                    </div>
                    <div class="mt-2">
                        @if (!string.IsNullOrEmpty(Model.TopVolumeSource))
                        {
                            <h4 class="fw-bold mb-1 text-truncate" style="color: #1E3A8A;" title="@Model.TopVolumeSource">
                                @Model.TopVolumeSource
                            </h4>
                            <div class="d-flex align-items-baseline gap-2">
                                <span class="display-6 fw-bold text-primary" style="font-size: 1.85rem;">@Model.TopVolumeApplications.ToString("N0")</span>
                                <span class="text-muted small">hồ sơ tiếp nhận</span>
                            </div>
                            <div class="text-secondary small mt-1" style="font-size: 0.78rem;">
                                <i class="bi bi-inboxes text-primary me-1"></i>Kênh thu hút sự quan tâm và số lượng CV đầu vào lớn nhất
                            </div>
                        }
                        else
                        {
                            <div class="text-muted py-2 small">
                                <i class="bi bi-info-circle me-1"></i>Chưa có hồ sơ nào trong khoảng thời gian đã chọn.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3: Tổng nhận việc & Tỷ lệ chung -->
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; border: 1px solid #E2E8F0 !important; background: #FFFFFF;">
                <div class="card-body p-3.5">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <div class="d-flex align-items-center justify-content-center rounded-3" style="width: 42px; height: 42px; background: #F1F5F9; color: #475569; border: 1px solid #CBD5E1;">
                                <i class="bi bi-person-check-fill fs-5"></i>
                            </div>
                            <div>
                                <span class="badge bg-light text-dark border px-2 py-0.5 small fw-semibold" style="border-radius: 4px; font-size: 0.7rem;">
                                    👥 KẾT QUẢ TỔNG THỂ
                                </span>
                                <div class="text-muted small fw-medium" style="font-size: 0.78rem;">Tổng tuyển dụng thành công</div>
                            </div>
                        </div>
                    </div>
                    <div class="mt-2">
                        <div class="d-flex align-items-baseline justify-content-between">
                            <div>
                                <span class="display-6 fw-bold text-dark" style="font-size: 1.85rem;">@Model.TotalHiredAllSources.ToString("N0")</span>
                                <span class="text-muted small">/ @Model.TotalApplicationsAllSources.ToString("N0") CV</span>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold text-success" style="font-size: 1.1rem;">@Model.AverageHireRate.ToString("F1")%</div>
                                <div class="text-muted" style="font-size: 0.72rem;">Tỷ lệ trúng tuyển</div>
                            </div>
                        </div>
                        <div class="progress mt-2" style="height: 6px; border-radius: 3px; background: #F1F5F9;">
                            <div class="progress-bar bg-success" role="progressbar" style="width: @(Math.Min(100, Model.AverageHireRate))%;" aria-valuenow="@Model.AverageHireRate" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <div class="d-flex justify-content-between text-muted small mt-1.5" style="font-size: 0.75rem;">
                            <span>Qua sàng lọc: <strong>@Model.TotalPassedScreeningAllSources</strong> (@Model.AverageScreeningPassRate.ToString("F1")%)</span>
                            <span>Phỏng vấn: <strong>@Model.TotalInterviewedAllSources</strong></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Smart Budget Allocation Advice Callout (AC2) -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; background: #F8FAFC; border: 1px solid #E2E8F0 !important; border-left: 5px solid #059669 !important;">
        <div class="card-body p-3 p-md-3.5 d-flex align-items-start gap-3">
            <div class="d-flex align-items-center justify-content-center flex-shrink-0 rounded-circle" style="width: 36px; height: 36px; background: #ECFDF5; color: #059669;">
                <i class="bi bi-lightbulb-fill fs-5"></i>
            </div>
            <div class="flex-grow-1">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h6 class="fw-bold mb-0 text-dark">Gợi ý Phân bổ Ngân sách Tuyển dụng Thông minh</h6>
                    <span class="badge bg-success-subtle text-success small" style="font-size: 0.68rem;">Khuyến nghị AI</span>
                </div>
                <p class="text-secondary small mb-0" style="line-height: 1.55;">
                    @Model.BudgetAllocationRecommendation
                </p>
            </div>
        </div>
    </div>

    <!-- Detailed Metrics Table Card (AC1 & AC4) -->
    <div class="card border-0 shadow-sm" style="border-radius: 12px; border: 1px solid #E2E8F0 !important;">
        <div class="card-header bg-white py-3 px-3 px-md-4 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2" style="border-top-left-radius: 12px; border-top-right-radius: 12px;">
            <div>
                <h5 class="fw-bold text-dark mb-0" style="font-size: 1.05rem;">
                    <i class="bi bi-table text-success me-1.5"></i>Bảng Thống kê Chi tiết Hiệu quả Từng Nguồn Tuyển dụng
                </h5>
                <span class="text-muted small" style="font-size: 0.8rem;">Click vào tiêu đề cột để sắp xếp dữ liệu tăng / giảm dần</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="input-group input-group-sm" style="max-width: 220px;">
                    <span class="input-group-text bg-white border-end-0" style="border-color: #CBD5E1; border-radius: 8px 0 0 8px;">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" id="tableSearchInput" class="form-control form-control-sm border-start-0" placeholder="Tìm kênh nguồn..." style="border-color: #CBD5E1; border-radius: 0 8px 8px 0;" onkeyup="filterTableRows()" />
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="sourceMetricsTable" style="font-size: 0.875rem;">
                    <thead style="background: #F8FAFC; color: #475569; border-bottom: 2px solid #E2E8F0;">
                        <tr>
                            <th class="text-center py-3 ps-3 cursor-pointer" onclick="sortTable(0, 'number')" style="width: 50px;">
                                #
                            </th>
                            <th class="py-3 cursor-pointer" onclick="sortTable(1, 'text')" style="min-width: 200px;">
                                Kênh / Nguồn tuyển dụng <i class="bi bi-arrow-down-up small text-muted ms-1"></i>
                            </th>
                            <th class="text-end py-3 cursor-pointer" onclick="sortTable(2, 'number')" style="min-width: 120px;">
                                Tổng hồ sơ <i class="bi bi-arrow-down-up small text-muted ms-1"></i>
                            </th>
                            <th class="text-end py-3 cursor-pointer" onclick="sortTable(3, 'number')" style="min-width: 120px;">
                                Qua sàng lọc <i class="bi bi-arrow-down-up small text-muted ms-1"></i>
                            </th>
                            <th class="text-end py-3 cursor-pointer" onclick="sortTable(4, 'number')" style="min-width: 140px;">
                                Tỷ lệ sàng lọc <i class="bi bi-arrow-down-up small text-muted ms-1"></i>
                            </th>
                            <th class="text-end py-3 cursor-pointer" onclick="sortTable(5, 'number')" style="min-width: 110px;">
                                Phỏng vấn <i class="bi bi-arrow-down-up small text-muted ms-1"></i>
                            </th>
                            <th class="text-end py-3 cursor-pointer" onclick="sortTable(6, 'number')" style="min-width: 110px;">
                                Đề xuất Offer <i class="bi bi-arrow-down-up small text-muted ms-1"></i>
                            </th>
                            <th class="text-end py-3 cursor-pointer" onclick="sortTable(7, 'number')" style="min-width: 130px;">
                                Nhận việc (Hired) <i class="bi bi-arrow-down-up small text-muted ms-1"></i>
                            </th>
                            <th class="text-end py-3 cursor-pointer" onclick="sortTable(8, 'number')" style="min-width: 150px;">
                                Tỷ lệ trúng tuyển <i class="bi bi-arrow-down-up small text-muted ms-1"></i>
                            </th>
                            <th class="text-end py-3 cursor-pointer" onclick="sortTable(9, 'number')" style="min-width: 120px;">
                                Điểm chất lượng <i class="bi bi-arrow-down-up small text-muted ms-1"></i>
                            </th>
                            <th class="text-center py-3 pe-3 cursor-pointer" onclick="sortTable(10, 'text')" style="min-width: 170px;">
                                Đánh giá chất lượng
                            </th>
                        </tr>
                    </thead>
                    <tbody id="metricsTableBody">
                        @if (Model.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="11" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                    Không có dữ liệu nguồn ứng viên nào thỏa mãn tiêu chí lọc.
                                </td>
                            </tr>
                        }
                        else
                        {
                            var index = 1;
                            foreach (var item in Model.Items)
                            {
                                var rowBg = item.IsTopQuality ? "background-color: #F0FDF4;" : (item.IsTopVolume ? "background-color: #F8FAFC;" : "");
                                <tr style="@rowBg">
                                    <td class="text-center text-muted fw-semibold ps-3">@(index++)</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (item.IsTopQuality)
                                            {
                                                <span class="badge bg-success-subtle text-success p-1 rounded-circle" title="Kênh chất lượng nhất">
                                                    <i class="bi bi-trophy-fill" style="font-size: 0.85rem;"></i>
                                                </span>
                                            }
                                            else if (item.IsTopVolume)
                                            {
                                                <span class="badge bg-primary-subtle text-primary p-1 rounded-circle" title="Kênh nhiều hồ sơ nhất">
                                                    <i class="bi bi-bar-chart-fill" style="font-size: 0.85rem;"></i>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-secondary border p-1 rounded-circle">
                                                    <i class="bi bi-diagram-3" style="font-size: 0.85rem;"></i>
                                                </span>
                                            }
                                            <div>
                                                <div class="fw-semibold text-dark">
                                                    @item.SourceName
                                                </div>
                                                @if (item.IsTopQuality)
                                                {
                                                    <span class="badge bg-success text-white" style="font-size: 0.65rem;">Top Quality</span>
                                                }
                                                @if (item.IsTopVolume)
                                                {
                                                    <span class="badge bg-primary text-white" style="font-size: 0.65rem;">Top Volume</span>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-end fw-semibold text-dark font-mono" data-val="@item.TotalApplications">
                                        @item.TotalApplications.ToString("N0")
                                    </td>
                                    <td class="text-end font-mono" data-val="@item.PassedScreeningCount">
                                        @item.PassedScreeningCount.ToString("N0")
                                    </td>
                                    <td class="text-end" data-val="@item.ScreeningPassRate">
                                        <div class="d-inline-flex align-items-center gap-1.5 font-mono">
                                            <span class="fw-semibold @(item.ScreeningPassRate >= 50.0 ? "text-success" : (item.ScreeningPassRate >= 25.0 ? "text-primary" : "text-secondary"))">
                                                @item.ScreeningPassRate.ToString("F1")%
                                            </span>
                                        </div>
                                        <div class="progress mt-1 ms-auto" style="height: 4px; width: 60px; background: #E2E8F0;">
                                            <div class="progress-bar @(item.ScreeningPassRate >= 50.0 ? "bg-success" : "bg-primary")" style="width: @item.ScreeningPassRate%;"></div>
                                        </div>
                                    </td>
                                    <td class="text-end font-mono" data-val="@item.InterviewCount">
                                        @item.InterviewCount.ToString("N0")
                                    </td>
                                    <td class="text-end font-mono" data-val="@item.OfferCount">
                                        @item.OfferCount.ToString("N0")
                                    </td>
                                    <td class="text-end font-mono" data-val="@item.HiredCount">
                                        @if (item.HiredCount > 0)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fw-bold" style="font-size: 0.85rem;">
                                                @item.HiredCount.ToString("N0")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">0</span>
                                        }
                                    </td>
                                    <td class="text-end" data-val="@item.HireRate">
                                        <div class="d-inline-flex align-items-center gap-1 font-mono">
                                            <span class="fw-bold @(item.HireRate >= 20.0 ? "text-success" : (item.HireRate >= 5.0 ? "text-dark" : "text-muted"))" style="font-size: 0.92rem;">
                                                @item.HireRate.ToString("F1")%
                                            </span>
                                        </div>
                                        <div class="progress mt-1 ms-auto" style="height: 4px; width: 70px; background: #E2E8F0;">
                                            <div class="progress-bar @(item.HireRate >= 20.0 ? "bg-success" : (item.HireRate >= 10.0 ? "bg-info" : "bg-secondary"))" style="width: @(Math.Min(100, item.HireRate * 2))%;"></div>
                                        </div>
                                    </td>
                                    <td class="text-end font-mono fw-semibold" data-val="@item.QualityScore">
                                        <span class="px-2 py-0.5 rounded-2 @(item.QualityScore >= 30.0 ? "bg-success-subtle text-success" : (item.QualityScore >= 15.0 ? "bg-light text-dark border" : "text-muted"))">
                                            @item.QualityScore.ToString("F1")
                                        </span>
                                    </td>
                                    <td class="text-center pe-3">
                                        @if (item.IsTopQuality)
                                        {
                                            <span class="badge bg-success text-white px-2.5 py-1" style="font-size: 0.76rem; border-radius: 6px;">
                                                🏆 @item.QualityBadge
                                            </span>
                                        }
                                        else if (item.QualityBadgeCssClass == "badge-success")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1" style="font-size: 0.76rem; border-radius: 6px;">
                                                @item.QualityBadge
                                            </span>
                                        }
                                        else if (item.QualityBadgeCssClass == "badge-warning")
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2.5 py-1" style="font-size: 0.76rem; border-radius: 6px;" title="Nhiều hồ sơ nhưng tỷ lệ trúng tuyển thấp">
                                                ⚠️ @item.QualityBadge
                                            </span>
                                        }
                                        else if (item.QualityBadgeCssClass == "badge-secondary")
                                        {
                                            <span class="badge bg-light text-secondary border px-2.5 py-1" style="font-size: 0.76rem; border-radius: 6px;">
                                                @item.QualityBadge
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border px-2 py-0.5" style="font-size: 0.72rem; border-radius: 6px;">
                                                Chưa có dữ liệu
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    <!-- Summary Row (AC1 & AC3) -->
                    <tfoot style="background: #F1F5F9; border-top: 2px solid #CBD5E1;">
                        <tr class="fw-bold text-dark">
                            <td colspan="2" class="py-3 ps-3 text-center">
                                <i class="bi bi-calculator me-1"></i> TỔNG CỘNG HỆ THỐNG
                            </td>
                            <td class="text-end py-3 font-mono">@Model.TotalApplicationsAllSources.ToString("N0")</td>
                            <td class="text-end py-3 font-mono">@Model.TotalPassedScreeningAllSources.ToString("N0")</td>
                            <td class="text-end py-3 font-mono text-primary">@Model.AverageScreeningPassRate.ToString("F1")%</td>
                            <td class="text-end py-3 font-mono">@Model.TotalInterviewedAllSources.ToString("N0")</td>
                            <td class="text-end py-3 font-mono">@Model.TotalOfferedAllSources.ToString("N0")</td>
                            <td class="text-end py-3 font-mono text-success fs-6">@Model.TotalHiredAllSources.ToString("N0")</td>
                            <td class="text-end py-3 font-mono text-success fs-6">@Model.AverageHireRate.ToString("F1")%</td>
                            <td class="text-end py-3 font-mono">—</td>
                            <td class="text-center py-3 pe-3 text-muted small fw-normal">Tổng hợp các kênh</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Preset ngày lọc nhanh
        function setDatePreset(days) {
            var toDate = new Date();
            var fromDate = new Date();
            fromDate.setDate(toDate.getDate() - days);

            document.getElementById('filterFromDate').value = formatDate(fromDate);
            document.getElementById('filterToDate').value = formatDate(toDate);
            document.getElementById('filterForm').submit();
        }

        function clearDatePreset() {
            document.getElementById('filterFromDate').value = '';
            document.getElementById('filterToDate').value = '';
            document.getElementById('filterForm').submit();
        }

        function formatDate(d) {
            var month = '' + (d.getMonth() + 1),
                day = '' + d.getDate(),
                year = d.getFullYear();

            if (month.length < 2) month = '0' + month;
            if (day.length < 2) day = '0' + day;

            return [year, month, day].join('-');
        }

        // Tìm kiếm nhanh trong bảng
        function filterTableRows() {
            var input = document.getElementById("tableSearchInput");
            var filter = input.value.toLowerCase();
            var table = document.getElementById("sourceMetricsTable");
            var trs = table.getElementsByTagName("tbody")[0].getElementsByTagName("tr");

            for (var i = 0; i < trs.length; i++) {
                var td = trs[i].getElementsByTagName("td")[1];
                if (td) {
                    var txtValue = td.textContent || td.innerText;
                    if (txtValue.toLowerCase().indexOf(filter) > -1) {
                        trs[i].style.display = "";
                    } else {
                        trs[i].style.display = "none";
                    }
                }
            }
        }

        // Sắp xếp cột bảng (Client-side Sorting)
        var sortOrder = {};
        function sortTable(columnIndex, type) {
            var table = document.getElementById("sourceMetricsTable");
            var tbody = table.getElementsByTagName("tbody")[0];
            var rows = Array.from(tbody.getElementsByTagName("tr"));

            if (rows.length <= 1) return;

            sortOrder[columnIndex] = !sortOrder[columnIndex];
            var ascending = sortOrder[columnIndex];

            rows.sort(function(rowA, rowB) {
                var cellA = rowA.getElementsByTagName("td")[columnIndex];
                var cellB = rowB.getElementsByTagName("td")[columnIndex];

                if (!cellA || !cellB) return 0;

                var valA = cellA.getAttribute("data-val") || cellA.innerText.trim();
                var valB = cellB.getAttribute("data-val") || cellB.innerText.trim();

                if (type === 'number') {
                    var numA = parseFloat(valA.replace(/[^0-9.-]+/g, "")) || 0;
                    var numB = parseFloat(valB.replace(/[^0-9.-]+/g, "")) || 0;
                    return ascending ? numA - numB : numB - numA;
                } else {
                    return ascending ? valA.localeCompare(valB) : valB.localeCompare(valA);
                }
            });

            // Gắn lại hàng theo thứ tự đã sort
            rows.forEach(function(row) {
                tbody.appendChild(row);
            });
        }
    </script>
}
