@model Ats.Web.Models.ViewModels.JobPositions.JobPositionListViewModel
@{
    ViewData["Title"] = "Danh mục Chức danh & Vị trí công việc";
    var totalCols = 5 + (Model.CanViewSalary ? 2 : 0) + (Model.CanManage ? 1 : 0);
    var isFiltered = !string.IsNullOrWhiteSpace(Model.Keyword) || !string.IsNullOrWhiteSpace(Model.LevelFilter) || Model.DepartmentFilter.HasValue;
}

<div class="container-fluid px-3 px-md-4 py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="/dashboard" class="text-decoration-none text-muted">Bàn làm việc</a></li>
            <li class="breadcrumb-item active fw-medium text-dark" aria-current="page">Danh mục chức danh</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <div class="p-2 bg-white rounded-3 shadow-xs border d-inline-flex align-items-center justify-content-center text-primary" style="border-radius: 8px !important; width: 42px; height: 42px;">
                    <i class="bi bi-briefcase-fill fs-5" style="color: #059669;"></i>
                </div>
                <h1 class="h3 fw-bold text-dark mb-0">Danh mục Chức danh & Khung lương chuẩn</h1>
            </div>
            <p class="text-muted small mb-0 ms-md-5">Quản lý định danh vị trí công việc, tiêu chuẩn cấp bậc và khung dải lương trong tổ chức.</p>
        </div>

        @if (Model.CanManage)
        {
            <div class="d-flex align-items-center gap-2">
                <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-2 shadow-sm" style="border-radius: 8px; background-color: #059669; border-color: #059669;">
                    <i class="bi bi-plus-circle-fill"></i>
                    <span class="fw-semibold">Thêm chức danh mới</span>
                </a>
            </div>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4 p-3 d-flex align-items-center" role="alert" style="background-color: #ECFDF5; border: 1px solid #A7F3D0 !important; color: #065F46;">
            <i class="bi bi-check-circle-fill fs-5 me-2 flex-shrink-0" style="color: #059669;"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 p-3 d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-2 flex-shrink-0 text-danger"></i>
            <div>@TempData["ErrorMessage"]</div>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3 p-md-4">
            <form id="filterForm" method="get" asp-action="Index" class="row g-3 align-items-end">
                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                <div class="col-12 col-md-5">
                    <label class="form-label small fw-semibold text-muted">Tìm kiếm chức danh</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted" style="border-radius: 8px 0 0 8px;">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" 
                               name="keyword" 
                               value="@Model.Keyword" 
                               class="form-control bg-light border-start-0" 
                               style="border-radius: 0 8px 8px 0;"
                               placeholder="Tìm theo mã (SWE-SR) hoặc tên vị trí..." />
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <label class="form-label small fw-semibold text-muted">Cấp bậc chuyên môn</label>
                    <select name="level" class="form-select bg-light" style="border-radius: 8px;">
                        <option value="">-- Tất cả cấp bậc --</option>
                        @foreach (var lvl in (List<SelectListItem>)ViewBag.JobLevels)
                        {
                            <option value="@lvl.Value" selected="@(lvl.Value.Equals(Model.LevelFilter, StringComparison.OrdinalIgnoreCase))">@lvl.Text</option>
                        }
                    </select>
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold text-muted">Phòng ban</label>
                    <select name="departmentId" class="form-select bg-light" style="border-radius: 8px;">
                        <option value="">-- Tất cả phòng ban --</option>
                        @foreach (var dept in (List<SelectListItem>)ViewBag.Departments)
                        {
                            <option value="@dept.Value" selected="@(dept.Value == Model.DepartmentFilter?.ToString())">@dept.Text</option>
                        }
                    </select>
                </div>

                <div class="col-12 col-md-2 d-flex gap-2">
                    <button id="filterSubmitBtn" type="submit" class="btn btn-dark w-100 fw-semibold" style="border-radius: 8px;">
                        <i class="bi bi-funnel me-1"></i> Lọc
                    </button>
                    <a id="filterResetBtn" asp-action="Index" class="btn btn-outline-secondary" style="border-radius: 8px;" title="Đặt lại bộ lọc">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3 position-relative overflow-hidden">
        <div id="tableLoadingState" class="position-absolute top-0 start-0 w-100 h-100 d-none flex-column align-items-center justify-content-center" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(2px); z-index: 15; min-height: 220px;" role="status" aria-live="polite">
            <div class="spinner-border text-success mb-2" role="status" style="width: 2.2rem; height: 2.2rem; color: #059669 !important;"></div>
            <div class="fw-semibold text-dark small">Đang tải dữ liệu danh sách...</div>
            <div class="text-muted small" style="font-size: 0.75rem;">Vui lòng đợi trong giây lát</div>
        </div>

        <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
            <span class="fw-semibold text-dark">
                Danh sách chức danh vị trí 
                <span class="badge ms-1 font-monospace" style="border-radius: 6px; background-color: #F1F5F9; color: #475569; border: 1px solid #E2E8F0;">
                    @Model.TotalRecords bản ghi
                </span>
            </span>
            <span class="small text-muted">Phân loại & Định ngạch chuẩn NoveraTech</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="min-width: 130px;">Mã chức danh</th>
                        <th style="min-width: 200px;">Tên chức danh vị trí</th>
                        <th style="min-width: 150px;">Phòng ban</th>
                        <th style="min-width: 120px;">Cấp bậc</th>
                        @if (Model.CanViewSalary)
                        {
                            <th class="text-end" style="min-width: 160px;">Dải lương tối thiểu</th>
                            <th class="text-end" style="min-width: 160px;">Dải lương tối đa</th>
                        }
                        <th style="min-width: 120px;">Trạng thái</th>
                        @if (Model.CanManage)
                        {
                            <th class="text-end pe-4" style="min-width: 120px;">Thao tác</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Positions == null || !Model.Positions.Any())
                    {
                        <tr>
                            <td colspan="@totalCols" class="text-center py-5 text-muted">
                                @if (isFiltered)
                                {
                                    <div class="py-4 px-3 text-center">
                                        <div class="d-inline-flex align-items-center justify-content-center p-3 rounded-circle bg-light mb-3 text-muted" style="width: 60px; height: 60px;">
                                            <i class="bi bi-search fs-4"></i>
                                        </div>
                                        <h6 class="fw-bold text-dark mb-1">Không tìm thấy kết quả phù hợp</h6>
                                        <p class="text-muted small mb-3">Không có chức danh nào khớp với tiêu chí tìm kiếm hiện tại.</p>
                                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary px-3" style="border-radius: 8px;">
                                            <i class="bi bi-arrow-counterclockwise me-1"></i> Đặt lại bộ lọc
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <div class="py-4 px-3 text-center">
                                        <div class="d-inline-flex align-items-center justify-content-center p-3 rounded-circle bg-light mb-3 text-muted" style="width: 60px; height: 60px;">
                                            <i class="bi bi-briefcase fs-4"></i>
                                        </div>
                                        <h6 class="fw-bold text-dark mb-1">Chưa có chức danh công việc</h6>
                                        <p class="text-muted small mb-3">Hệ thống chưa ghi nhận danh mục vị trí nào.</p>
                                        @if (Model.CanManage)
                                        {
                                            <a asp-action="Create" class="btn btn-sm btn-primary px-3 shadow-sm" style="border-radius: 8px; background-color: #059669; border-color: #059669;">
                                                <i class="bi bi-plus-circle-fill me-1"></i> Tạo chức danh đầu tiên
                                            </a>
                                        }
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var pos in Model.Positions)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-light text-dark border font-monospace px-2 py-1" style="border-radius: 6px; font-size: 0.82rem;">
                                        @pos.Code
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@pos.Title</div>
                                </td>
                                <td>
                                    <span class="text-muted small">
                                        <i class="bi bi-building me-1"></i>@pos.DepartmentName
                                    </span>
                                </td>
                                <td>
                                    @{
                                        var badgeClass = pos.JobLevel switch
                                        {
                                            "LEAD" or "MANAGER" or "DIRECTOR" => "bg-primary-subtle text-primary border border-primary-subtle",
                                            "SENIOR" or "PRINCIPAL" => "bg-success-subtle text-success border border-success-subtle",
                                            "MIDDLE" => "bg-info-subtle text-info border border-info-subtle",
                                            _ => "bg-secondary-subtle text-secondary border border-secondary-subtle"
                                        };
                                    }
                                    <span class="badge @badgeClass font-monospace px-2 py-1" style="border-radius: 6px;">
                                        @pos.JobLevel
                                    </span>
                                </td>
                                @if (Model.CanViewSalary)
                                {
                                    <td class="text-end font-monospace">
                                        <span class="fw-semibold" style="color: #059669; font-size: 0.88rem;">
                                            @pos.MinSalaryFormatted
                                        </span>
                                    </td>
                                    <td class="text-end font-monospace">
                                        <span class="fw-semibold" style="color: #059669; font-size: 0.88rem;">
                                            @pos.MaxSalaryFormatted
                                        </span>
                                    </td>
                                }
                                <td>
                                    @if (pos.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="border-radius: 6px;">
                                            <i class="bi bi-check-circle-fill me-1"></i>Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary px-2 py-1" style="border-radius: 6px;">
                                            Tạm ngưng
                                        </span>
                                    }
                                </td>
                                @if (Model.CanManage)
                                {
                                    <td class="text-end pe-4">
                                        <div class="d-inline-flex gap-1">
                                            <a asp-action="Edit" asp-route-id="@pos.Id" class="btn btn-sm btn-outline-primary" style="border-radius: 6px;" title="Chỉnh sửa">
                                                <i class="bi bi-pencil-square"></i>
                                                <span class="d-none d-md-inline ms-1">Sửa</span>
                                            </a>

                                            <form asp-action="Delete" asp-route-id="@pos.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa chức danh [@pos.Code] @pos.Title?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: 6px;" title="Xóa chức danh">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalRecords > 0)
        {
            <div class="card-footer bg-white border-top py-3 px-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div class="small text-muted">
                    Hiển thị từ <strong class="text-dark">@((Model.CurrentPage - 1) * Model.PageSize + 1)</strong> đến <strong class="text-dark">@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRecords)</strong> trong tổng số <strong class="text-dark">@Model.TotalRecords</strong> chức danh
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Phân trang chức danh">
                        <ul class="pagination pagination-sm pagination-ats mb-0">
                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@(Model.CurrentPage - 1)"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-keyword="@Model.Keyword"
                                   asp-route-level="@Model.LevelFilter"
                                   asp-route-departmentId="@Model.DepartmentFilter"
                                   aria-label="Trang trước">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>

                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                if (Model.TotalPages <= 7 || p == 1 || p == Model.TotalPages || Math.Abs(p - Model.CurrentPage) <= 1)
                                {
                                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" asp-action="Index"
                                           asp-route-page="@p"
                                           asp-route-pageSize="@Model.PageSize"
                                           asp-route-keyword="@Model.Keyword"
                                           asp-route-level="@Model.LevelFilter"
                                           asp-route-departmentId="@Model.DepartmentFilter">@p</a>
                                    </li>
                                }
                                else if ((p == 2 && Model.CurrentPage > 3) || (p == Model.TotalPages - 1 && Model.CurrentPage < Model.TotalPages - 2))
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                            }

                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@(Model.CurrentPage + 1)"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-keyword="@Model.Keyword"
                                   asp-route-level="@Model.LevelFilter"
                                   asp-route-departmentId="@Model.DepartmentFilter"
                                   aria-label="Trang sau">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        }
    </div>
</div>

<style>
    .pagination-ats .page-link {
        color: #334155;
        border-color: #E2E8F0;
        border-radius: 6px !important;
        margin: 0 2px;
        font-weight: 500;
        min-width: 32px;
        text-align: center;
        background-color: #FFFFFF;
    }
    .pagination-ats .page-item.active .page-link {
        background-color: #059669 !important;
        border-color: #059669 !important;
        color: #FFFFFF !important;
    }
    .pagination-ats .page-item.disabled .page-link {
        color: #94A3B8;
        background-color: #F8FAFC;
        border-color: #E2E8F0;
    }
    .pagination-ats .page-link:hover:not(.active) {
        background-color: #F1F5F9;
        color: #0F172A;
    }
</style>

@section Scripts {
    <script src="~/js/job-position-list.js" asp-append-version="true"></script>
}
