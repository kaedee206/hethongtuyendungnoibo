@model Ats.Web.Models.ViewModels.JobPositions.JobPositionFormViewModel

<form id="jobPositionForm" asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@(Model.IsEdit ? Model.Id : null)" method="post" novalidate>
    @Html.AntiForgeryToken()

    @if (Model.IsEdit)
    {
        <input type="hidden" asp-for="Id" />
    }

    <div id="formValidationAlert" class="alert alert-danger border-0 d-none shadow-sm rounded-3 mb-4 p-3" role="alert">
        <div class="d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-danger flex-shrink-0"></i>
            <div>
                <strong class="d-block fw-bold">Thông tin nhập liệu chưa hợp lệ!</strong>
                <span class="small">Vui lòng kiểm tra lại các trường có viền đỏ và điều chỉnh theo hướng dẫn cụ thể bên dưới.</span>
            </div>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 p-3" role="alert"></div>

    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white border-bottom py-3 px-4">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1" style="border-radius: 6px;">
                    <i class="bi bi-card-heading me-1"></i> Mục 1
                </span>
                <h6 class="mb-0 fw-bold text-dark">Thông tin định danh chức danh</h6>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <label asp-for="Code" class="form-label fw-semibold small text-dark">
                        Mã chức danh <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted" style="border-radius: 8px 0 0 8px;">
                            <i class="bi bi-hash"></i>
                        </span>
                        <input asp-for="Code" 
                               id="posCode" 
                               class="form-control font-monospace text-uppercase" 
                               style="border-radius: 0 8px 8px 0; letter-spacing: 0.05em;" 
                               placeholder="VD: SWE-SR-01" 
                               maxlength="30"
                               autocomplete="off" 
                               required />
                    </div>
                    <div class="form-text small text-muted">
                        Chữ hoa, số, dấu '-' hoặc '_'. Tối thiểu 3 ký tự.
                    </div>
                    <span asp-validation-for="Code" class="invalid-feedback d-block fw-medium"></span>
                </div>

                <div class="col-12 col-md-8">
                    <label asp-for="Title" class="form-label fw-semibold small text-dark">
                        Tên chức danh vị trí <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted" style="border-radius: 8px 0 0 8px;">
                            <i class="bi bi-briefcase"></i>
                        </span>
                        <input asp-for="Title" 
                               id="posTitle" 
                               class="form-control" 
                               style="border-radius: 0 8px 8px 0;" 
                               placeholder="VD: Senior .NET Backend Engineer (Microservices & High Load)" 
                               maxlength="150"
                               required />
                    </div>
                    <div class="form-text small text-muted">
                        Tên gọi chuẩn hóa dùng trong hồ sơ tuyển dụng và hợp đồng lao động.
                    </div>
                    <span asp-validation-for="Title" class="invalid-feedback d-block fw-medium"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="JobLevel" class="form-label fw-semibold small text-dark">
                        Cấp bậc chuyên môn (Job Level) <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted" style="border-radius: 8px 0 0 8px;">
                            <i class="bi bi-layers"></i>
                        </span>
                        <select asp-for="JobLevel" 
                                id="posLevel" 
                                class="form-select" 
                                style="border-radius: 0 8px 8px 0;" 
                                required>
                            <option value="">-- Chọn cấp bậc chuyên môn --</option>
                            @foreach (var level in Model.AvailableJobLevels)
                            {
                                <option value="@level.Value" selected="@level.Selected">@level.Text</option>
                            }
                        </select>
                    </div>
                    <span asp-validation-for="JobLevel" class="invalid-feedback d-block fw-medium"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="DepartmentId" class="form-label fw-semibold small text-dark">
                        Phòng ban trực thuộc <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted" style="border-radius: 8px 0 0 8px;">
                            <i class="bi bi-diagram-3"></i>
                        </span>
                        <select asp-for="DepartmentId" 
                                id="posDepartment" 
                                class="form-select" 
                                style="border-radius: 0 8px 8px 0;" 
                                required>
                            <option value="">-- Chọn phòng ban quản lý --</option>
                            @foreach (var dept in Model.AvailableDepartments)
                            {
                                <option value="@dept.Value" selected="@dept.Selected">@dept.Text</option>
                            }
                        </select>
                    </div>
                    <span asp-validation-for="DepartmentId" class="invalid-feedback d-block fw-medium"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3 mb-4" style="border: 1px solid #E2E8F0 !important;">
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="border-radius: 6px;">
                    <i class="bi bi-cash-coin me-1"></i> Mục 2
                </span>
                <h6 class="mb-0 fw-bold text-dark">Chính sách đãi ngộ & Dải lương định mức (Salary Range)</h6>
            </div>
            <span class="badge text-secondary border font-monospace px-2 py-1" style="border-radius: 6px; background-color: #F8FAFC;">
                Đơn vị: VNĐ / Tháng
            </span>
        </div>

        <div class="card-body p-4" style="background-color: #F8FAFC;">
            <div class="p-3 bg-white border rounded-3 mb-3 shadow-none" style="border-radius: 8px !important;">
                <div class="row g-4 align-items-start">
                    <div class="col-12 col-md-6">
                        <label asp-for="MinSalary" class="form-label fw-semibold small text-dark d-flex justify-content-between align-items-center">
                            <span>Dải lương tối thiểu (Min Salary) <span class="text-danger">*</span></span>
                            <span class="text-muted fw-normal" style="font-size: 0.78rem;">Sàn lương vị trí</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted fw-semibold font-monospace" style="border-radius: 8px 0 0 8px; font-size: 0.85rem;">
                                ₫
                            </span>
                            <input asp-for="MinSalary" 
                                   id="posMinSalary" 
                                   type="number" 
                                   min="0" 
                                   max="1000000000" 
                                   step="1000000" 
                                   class="form-control font-monospace fw-semibold" 
                                   style="border-radius: 0 8px 8px 0; font-size: 1rem; color: #0F172A;" 
                                   placeholder="VD: 20000000" 
                                   required />
                        </div>
                        <div class="mt-2">
                            <span id="minSalaryPreview" class="badge bg-emerald-light text-emerald font-monospace px-2 py-1 d-none" style="border-radius: 6px; font-size: 0.82rem; background-color: #ECFDF5; color: #059669; border: 1px solid #A7F3D0;">
                            </span>
                        </div>
                        <span asp-validation-for="MinSalary" class="invalid-feedback d-block fw-medium"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="MaxSalary" class="form-label fw-semibold small text-dark d-flex justify-content-between align-items-center">
                            <span>Dải lương tối đa (Max Salary) <span class="text-danger">*</span></span>
                            <span class="text-muted fw-normal" style="font-size: 0.78rem;">Trần ngân sách chức danh</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted fw-semibold font-monospace" style="border-radius: 8px 0 0 8px; font-size: 0.85rem;">
                                ₫
                            </span>
                            <input asp-for="MaxSalary" 
                                   id="posMaxSalary" 
                                   type="number" 
                                   min="0" 
                                   max="2000000000" 
                                   step="1000000" 
                                   class="form-control font-monospace fw-semibold" 
                                   style="border-radius: 0 8px 8px 0; font-size: 1rem; color: #0F172A;" 
                                   placeholder="VD: 40000000" 
                                   required />
                        </div>
                        <div class="mt-2">
                            <span id="maxSalaryPreview" class="badge bg-emerald-light text-emerald font-monospace px-2 py-1 d-none" style="border-radius: 6px; font-size: 0.82rem; background-color: #ECFDF5; color: #059669; border: 1px solid #A7F3D0;">
                            </span>
                        </div>
                        <span asp-validation-for="MaxSalary" class="invalid-feedback d-block fw-medium"></span>
                    </div>
                </div>

                <div id="salaryComparisonAlert" class="alert alert-danger border-0 d-none mt-3 mb-0 p-2 px-3 small rounded-3 d-flex align-items-center" role="alert">
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 text-muted small px-1">
                <i class="bi bi-info-circle text-primary"></i>
                <span>Mức lương này được dùng làm cơ sở tự động kiểm tra biên độ ngân sách khi các Hiring Manager tạo Phiếu đề xuất tuyển dụng (Requisition).</span>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white border-bottom py-3 px-4">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1" style="border-radius: 6px;">
                    <i class="bi bi-journal-text me-1"></i> Mục 3
                </span>
                <h6 class="mb-0 fw-bold text-dark">Tiêu chuẩn năng lực & Mô tả trách nhiệm</h6>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="CompetencyFrameworkId" class="form-label fw-semibold small text-dark">
                        Khung năng lực tiêu chuẩn áp dụng
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted" style="border-radius: 8px 0 0 8px;">
                            <i class="bi bi-award"></i>
                        </span>
                        <select asp-for="CompetencyFrameworkId" 
                                id="posCompetencyFramework" 
                                class="form-select" 
                                style="border-radius: 0 8px 8px 0;">
                            <option value="">-- Chưa gán khung năng lực (Chọn sau) --</option>
                            @foreach (var fw in Model.AvailableCompetencyFrameworks)
                            {
                                <option value="@fw.Value" selected="@fw.Selected">@fw.Text</option>
                            }
                        </select>
                    </div>
                    <div class="form-text small text-muted">
                        Liên kết chức danh với bộ khung tiêu chí đánh giá chuẩn để tự động đồng bộ khi tạo phiếu phỏng vấn.
                    </div>
                    <span asp-validation-for="CompetencyFrameworkId" class="invalid-feedback d-block fw-medium"></span>
                </div>

                <div class="col-12">
                    <label asp-for="StandardCompetencies" class="form-label fw-semibold small text-dark">
                        Kỹ năng & Năng lực tiêu chuẩn
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted" style="border-radius: 8px 0 0 8px;">
                            <i class="bi bi-stars"></i>
                        </span>
                        <input asp-for="StandardCompetencies" 
                               class="form-control" 
                               style="border-radius: 0 8px 8px 0;" 
                               placeholder="VD: C#, .NET 9, PostgreSQL, Docker, Microservices, Clean Architecture" />
                    </div>
                    <div class="form-text small text-muted">
                        Nhập các kỹ năng phân cách bởi dấu phẩy (,). Hệ thống sẽ dùng để so khớp tự động khi quét CV ứng viên.
                    </div>
                    <span asp-validation-for="StandardCompetencies" class="invalid-feedback d-block fw-medium"></span>
                </div>

                <div class="col-12">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="Description" class="form-label fw-semibold small text-dark mb-0">
                            Mô tả mục tiêu vị trí & Trách nhiệm chính
                        </label>
                        <span id="descCharCount" class="text-muted small">0 / 2000 ký tự</span>
                    </div>
                    <textarea asp-for="Description" 
                              id="posDescription" 
                              rows="4" 
                              class="form-control" 
                              style="border-radius: 8px;" 
                              placeholder="Mô tả tóm tắt vai trò, sứ mệnh đóng góp trong dự án và các tiêu chí đo lường kết quả công việc (KPIs)..."></textarea>
                    <span asp-validation-for="Description" class="invalid-feedback d-block fw-medium"></span>
                </div>

                <div class="col-12 pt-2">
                    <div class="p-3 bg-light border rounded-3 d-flex align-items-center justify-content-between" style="border-radius: 8px !important;">
                        <div>
                            <label class="form-check-label fw-semibold text-dark mb-0 d-block cursor-pointer" for="posIsActive">
                                Trạng thái hoạt động
                            </label>
                            <small class="text-muted">Khi kích hoạt, chức danh này sẽ sẵn sàng để mở các đợt tuyển dụng mới.</small>
                        </div>
                        <div class="form-check form-switch fs-5 mb-0">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" id="posIsActive" style="cursor: pointer;" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-3 px-4 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3">
            <div class="text-muted small">
                <i class="bi bi-shield-check text-success me-1"></i>
                Dữ liệu được kiểm soát toàn vẹn theo chuẩn định vị và quy định nội bộ NoveraTech.
            </div>

            <div class="d-flex align-items-center gap-2 w-100 w-sm-auto justify-content-end">
                <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-medium" style="border-radius: 8px;">
                    <i class="bi bi-x-circle me-1"></i> Hủy thao tác
                </a>
                <button type="submit" 
                        class="btn btn-primary px-4 fw-semibold d-inline-flex align-items-center gap-1 shadow-sm" 
                        style="border-radius: 8px; background-color: #059669; border-color: #059669;">
                    <i class="bi bi-check2-circle fs-6"></i>
                    <span>@(Model.IsEdit ? "Lưu cập nhật chức danh" : "Tạo chức danh mới")</span>
                </button>
            </div>
        </div>
    </div>
</form>
