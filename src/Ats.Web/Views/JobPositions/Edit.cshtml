@model Ats.Web.Models.ViewModels.JobPositions.JobPositionFormViewModel
@{
    ViewData["Title"] = $"Chỉnh sửa chức danh: [{Model.Code}] {Model.Title}";
}

<div class="container-fluid px-3 px-md-4 py-4" style="max-width: 960px;">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="/dashboard" class="text-decoration-none text-muted">Bàn làm việc</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Danh mục chức danh</a></li>
            <li class="breadcrumb-item active fw-medium text-dark" aria-current="page">Chỉnh sửa: @Model.Code</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <div class="p-2 bg-white rounded-3 shadow-xs border d-inline-flex align-items-center justify-content-center text-primary" style="border-radius: 8px !important; width: 40px; height: 40px;">
                    <i class="bi bi-pencil-square fs-5"></i>
                </div>
                <div>
                    <h1 class="h3 fw-bold text-dark mb-0">Cập nhật chức danh nghề nghiệp</h1>
                    <div class="d-flex align-items-center gap-2 mt-1">
                        <span class="badge bg-light text-secondary border font-monospace" style="border-radius: 6px;">@Model.Code</span>
                        <span class="badge @(Model.IsActive ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary")" style="border-radius: 6px;">
                            @(Model.IsActive ? "Đang hoạt động" : "Ngừng hoạt động")
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1 px-3 py-2" style="border-radius: 8px;">
            <i class="bi bi-arrow-left"></i>
            <span>Quay lại danh sách</span>
        </a>
    </div>

    <partial name="_JobPositionForm" model="Model" />
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/job-position-form.js" asp-append-version="true"></script>
}
