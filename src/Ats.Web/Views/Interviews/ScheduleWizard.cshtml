@model Ats.Web.Models.ViewModels.Interviews.ScheduleInterviewWizardViewModel
@{
    ViewData["Title"] = "Đặt lịch phỏng vấn chuyên biệt (Wizard) - NoveraTech ATS";
    Layout = "_Layout";
}

<style>
    /* ═══════════════════════════════════════════════════════════════════
       INTERVIEW SCHEDULING WIZARD STYLES (Tuân thủ RULE.md)
       Màu chủ đạo: Slate & Emerald (#059669), Bo góc 12px card, 8px button
       ═══════════════════════════════════════════════════════════════════ */
    .wizard-page-container {
        max-width: 1560px;
        margin: 0 auto;
        padding-bottom: 90px; /* Chừa khoảng trống cho sticky navigation footer */
    }

    /* Top Breadcrumb & Header */
    .wizard-header-card {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    }

    /* Step Progress Indicator */
    .wizard-progress-card {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        padding: 1rem 1.5rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    }

    .wizard-steps-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: relative;
    }

    .wizard-step-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        background: transparent;
        border: none;
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
        text-align: left;
        color: #64748B;
        position: relative;
        z-index: 2;
    }

    .wizard-step-item:hover:not(.disabled) {
        background: #F8FAFC;
        color: #0F172A;
    }

    .wizard-step-circle {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: #F1F5F9;
        color: #64748B;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.95rem;
        transition: all 0.2s ease;
        flex-shrink: 0;
        border: 1px solid #CBD5E1;
    }

    .wizard-step-item.active .wizard-step-circle {
        background: #059669;
        color: #FFFFFF;
        border-color: #059669;
        box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15);
    }

    .wizard-step-item.active {
        color: #0F172A;
    }

    .wizard-step-item.completed .wizard-step-circle {
        background: #ECFDF5;
        color: #059669;
        border-color: #10B981;
    }

    .wizard-step-connector {
        flex: 1;
        height: 2px;
        background: #E2E8F0;
        margin: 0 0.5rem;
        position: relative;
        z-index: 1;
    }

    .wizard-step-connector.completed {
        background: #10B981;
    }

    /* Cards & Containers */
    .step-section-card {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
        margin-bottom: 1.5rem;
        overflow: hidden;
    }

    .step-section-header {
        background: #FAFAFA;
        border-bottom: 1px solid #E2E8F0;
        padding: 1rem 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .step-section-body {
        padding: 1.25rem;
    }

    /* Step 1: Candidate Selection Cards */
    .cand-select-card {
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        padding: 0.9rem;
        margin-bottom: 0.75rem;
        cursor: pointer;
        transition: all 0.18s ease;
        background: #FFFFFF;
    }

    .cand-select-card:hover {
        border-color: #94A3B8;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.04);
    }

    .cand-select-card.selected {
        border-color: #059669;
        background: #F0FDF4;
        box-shadow: 0 0 0 2px rgba(5, 150, 105, 0.2);
    }

    .candidate-avatar-badge {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: #0F172A;
        color: #FFFFFF;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.15rem;
        flex-shrink: 0;
    }

    /* Step 2: Time & Room Presets */
    #interviewTypeTabs .nav-link {
        color: #475569;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid transparent;
        background: transparent;
    }

    #interviewTypeTabs .nav-link:hover {
        background: #F1F5F9;
        color: #0F172A;
    }

    #interviewTypeTabs .nav-link.active {
        background: #FFFFFF !important;
        box-shadow: 0 1px 4px rgba(15, 23, 42, 0.08);
    }

    #tab-meet.active {
        border-color: #10B981 !important;
        color: #065F46 !important;
        background: #F0FDF4 !important;
    }

    #tab-teams.active {
        border-color: #3B82F6 !important;
        color: #1E40AF !important;
        background: #EFF6FF !important;
    }

    #tab-offline.active {
        border-color: #F59E0B !important;
        color: #92400E !important;
        background: #FFFBEB !important;
    }

    .preset-room-badge {
        border: 1px solid #CBD5E1;
        border-radius: 8px;
        padding: 0.85rem 1rem;
        cursor: pointer;
        transition: all 0.18s ease;
        background: #FFFFFF;
        margin-bottom: 0.65rem;
    }

    .preset-room-badge:hover {
        border-color: #059669;
        background: #F8FAFC;
    }

    .preset-room-badge.active {
        border-color: #059669;
        background: #ECFDF5;
        box-shadow: 0 0 0 2px rgba(5, 150, 105, 0.2);
    }

    .preset-room-badge[data-platform="TEAMS"].active {
        border-color: #3B82F6;
        background: #EFF6FF;
        box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
    }

    .preset-room-badge[data-platform="OFFLINE"].active {
        border-color: #F59E0B;
        background: #FFFBEB;
        box-shadow: 0 0 0 2px rgba(245, 158, 11, 0.2);
    }

    .duration-pill-btn {
        border: 1px solid #CBD5E1;
        border-radius: 8px;
        padding: 0.45rem 0.9rem;
        font-size: 0.82rem;
        font-weight: 600;
        color: #334155;
        background: #FFFFFF;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .duration-pill-btn:hover {
        border-color: #059669;
        color: #059669;
    }

    .duration-pill-btn.active {
        background: #059669;
        color: #FFFFFF;
        border-color: #059669;
    }

    /* Panelist Checkbox Item */
    .panelist-select-row {
        border: 1px solid #E2E8F0;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #FFFFFF;
        transition: all 0.15s ease;
    }

    .panelist-select-row:hover {
        background: #F8FAFC;
        border-color: #CBD5E1;
    }

    .panelist-select-row.selected {
        background: #F0FDF4;
        border-color: #A7F3D0;
    }

    /* Step 3: Email Live Preview Mockup */
    .email-mockup-wrapper {
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        background: #FFFFFF;
        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.05);
        overflow: hidden;
    }

    .email-mockup-topbar {
        background: #F8FAFC;
        border-bottom: 1px solid #E2E8F0;
        padding: 0.75rem 1rem;
        font-size: 0.8rem;
        color: #64748B;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .email-mockup-body {
        padding: 1.5rem;
        background: #F1F5F9;
        min-height: 480px;
    }

    .email-rendered-letter {
        max-width: 580px;
        margin: 0 auto;
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06);
    }

    /* Step 4: Summary Dashboard */
    .summary-metric-box {
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        padding: 1rem 1.15rem;
        height: 100%;
    }

    /* Sticky Bottom Footer Navigation */
    .wizard-sticky-nav-footer {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: #FFFFFF;
        border-top: 1px solid #E2E8F0;
        padding: 0.85rem 2rem;
        box-shadow: 0 -4px 16px rgba(15, 23, 42, 0.06);
        z-index: 1020;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    /* Timeline Badges */
    .timeline-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #059669;
        display: inline-block;
        margin-right: 8px;
    }

    /* Responsive */
    @@media (max-width: 991px) {
        .wizard-steps-nav {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }
        .wizard-step-connector {
            display: none;
        }
        .wizard-step-item {
            width: 100%;
        }
    }
    @@media (max-width: 767.98px) {
        .wizard-sticky-nav-footer {
            padding: 0.6rem 0.85rem;
            gap: 0.4rem;
        }
        .wizard-sticky-nav-footer #footerStepIndicatorBadge {
            font-size: 0.72rem;
            padding: 0.25rem 0.5rem;
        }
        .wizard-sticky-nav-footer #btnNextStep {
            font-size: 0.8rem;
            padding: 0.45rem 0.75rem;
            white-space: nowrap;
        }
        .wizard-sticky-nav-footer #btnPrevStep {
            font-size: 0.8rem;
            padding: 0.45rem 0.75rem;
            white-space: nowrap;
        }
        .wizard-page-container {
            padding-bottom: 120px;
        }
    }
</style>

<div class="container-fluid px-3 px-lg-4 py-3 wizard-page-container">

    <!-- ── Top Header & Return Action ── -->
    <div class="wizard-header-card d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a href="/dashboard/ung-vien" class="btn btn-sm btn-outline-secondary rounded-2 py-1 px-2.5" title="Quay lại Pipeline">
                    <i class="bi bi-arrow-left me-1"></i>Trở về Pipeline
                </a>
                <span class="badge rounded-2 px-2.5 py-1 text-white" style="background: #059669; font-size: 0.75rem; font-weight: 600;">
                    <i class="bi bi-calendar-check-fill me-1"></i>QUY TRÌNH WIZARD 4 BƯỚC
                </span>
            </div>
            <h4 class="fw-bold text-dark mb-0" style="letter-spacing: -0.3px;">Thiết Lập Lịch Phỏng Vấn Chuyên Biệt</h4>
            <div class="text-muted small mt-1" style="font-size: 0.82rem;">
                Hệ thống điều phối phỏng vấn chuẩn mực NoveraTech ATS · Tự động kiểm tra lịch trống giám khảo và phát hành thư mời bảo mật
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/phong-van/so-sanh-ung-vien" class="btn btn-sm btn-outline-primary rounded-2">
                <i class="bi bi-bar-chart me-1"></i>So sánh ứng viên
            </a>
            <a href="/ung-vien" class="btn btn-sm btn-outline-secondary rounded-2">
                <i class="bi bi-people me-1"></i>Danh sách ứng viên
            </a>
        </div>
    </div>

    <!-- ── Wizard Step Progress Indicator ── -->
    <div class="wizard-progress-card">
        <div class="wizard-steps-nav">
            <!-- Step 1 Button -->
            <button type="button" class="wizard-step-item active" id="stepNavBtn-1" onclick="navigateToStep(1)">
                <div class="wizard-step-circle" id="stepCircle-1">1</div>
                <div>
                    <div class="fw-bold" style="font-size: 0.85rem;">Bước 1: Chọn đối tượng</div>
                    <div class="small text-muted" style="font-size: 0.75rem;">Ứng viên, vị trí & tóm tắt CV</div>
                </div>
            </button>

            <div class="wizard-step-connector" id="stepConnector-1"></div>

            <!-- Step 2 Button -->
            <button type="button" class="wizard-step-item" id="stepNavBtn-2" onclick="navigateToStep(2)">
                <div class="wizard-step-circle" id="stepCircle-2">2</div>
                <div>
                    <div class="fw-bold" style="font-size: 0.85rem;">Bước 2: Thời gian & Hội đồng</div>
                    <div class="small text-muted" style="font-size: 0.75rem;">Lịch trống, phòng họp & giám khảo</div>
                </div>
            </button>

            <div class="wizard-step-connector" id="stepConnector-2"></div>

            <!-- Step 3 Button -->
            <button type="button" class="wizard-step-item" id="stepNavBtn-3" onclick="navigateToStep(3)">
                <div class="wizard-step-circle" id="stepCircle-3">3</div>
                <div>
                    <div class="fw-bold" style="font-size: 0.85rem;">Bước 3: Soạn & Xem trước</div>
                    <div class="small text-muted" style="font-size: 0.75rem;">Live Email Preview thời gian thực</div>
                </div>
            </button>

            <div class="wizard-step-connector" id="stepConnector-3"></div>

            <!-- Step 4 Button -->
            <button type="button" class="wizard-step-item" id="stepNavBtn-4" onclick="navigateToStep(4)">
                <div class="wizard-step-circle" id="stepCircle-4">4</div>
                <div>
                    <div class="fw-bold" style="font-size: 0.85rem;">Bước 4: Xác nhận & Chốt lịch</div>
                    <div class="small text-muted" style="font-size: 0.75rem;">Kiểm duyệt tổng thể & Phát lệnh</div>
                </div>
            </button>
        </div>
    </div>

    <!-- ── Alerts Notification Block ── -->
    <div id="wizardAlertContainer" class="d-none mb-3">
        <div id="wizardAlertBox" class="alert alert-dismissible fade show rounded-2 py-2.5 px-3 mb-0 border-0 shadow-sm" role="alert">
            <div class="d-flex align-items-center">
                <i id="wizardAlertIcon" class="bi bi-info-circle-fill me-2 fs-5"></i>
                <span id="wizardAlertText" class="small fw-semibold"></span>
            </div>
            <button type="button" class="btn-close" onclick="closeWizardAlert()"></button>
        </div>
    </div>

    <!-- ── MAIN FORM WIZARD (Gửi POST về /phong-van/dat-lich) ── -->
    <form id="interviewWizardForm" method="post" action="/phong-van/dat-lich" onsubmit="handleWizardFormSubmit(event)">
        @Html.AntiForgeryToken()

        <!-- Hidden Inputs đồng bộ -->
        <input type="hidden" id="formApplicationId" name="ApplicationId" value="@(Model.SelectedCandidate?.ApplicationId ?? Guid.Empty)" />
        <input type="hidden" id="formRoundNumber" name="RoundNumber" value="@(Model.SelectedCandidate?.NextRoundNumber ?? 1)" />
        <input type="hidden" id="formRoundTitle" name="RoundTitle" value="@(Model.SelectedCandidate?.SuggestedRoundTitle ?? "Phỏng vấn Vòng 1")" />
        <input type="hidden" id="formDurationMinutes" name="DurationMinutes" value="60" />
        <input type="hidden" id="formInterviewType" name="InterviewType" value="ONLINE_MEET" />
        <input type="hidden" id="formInterviewFormat" name="InterviewFormat" value="MEET" />
        <input type="hidden" id="formLocationOrLink" name="LocationOrLink" value="https://meet.google.com/nvr-atsw-int" />
        <input type="hidden" id="formNote" name="Note" value="" />

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- BƯỚC 1: CHỌN ĐỐI TƯỢNG (ỨNG VIÊN & VỊ TRÍ)                          -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <div id="wizardStepPane-1" class="wizard-pane">
            <div class="row g-4">
                <!-- Cột trái: Bộ lọc & Danh sách ứng viên trong Pipeline -->
                <div class="col-12 col-lg-5 col-xl-5">
                    <div class="step-section-card">
                        <div class="step-section-header">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-person-lines-fill text-success fs-5"></i>
                                <span class="fw-bold text-dark" style="font-size: 0.92rem;">Ứng viên trong Pipeline Tuyển Dụng</span>
                            </div>
                            <span class="badge bg-light text-muted border" id="candCountBadge">@Model.PipelineCandidates.Count hồ sơ</span>
                        </div>
                        <div class="step-section-body">
                            <!-- Bộ lọc nhanh -->
                            <div class="mb-3">
                                <div class="input-group input-group-sm mb-2">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                                    <input type="text" id="searchCandidateInput" class="form-control border-start-0" placeholder="Tìm theo họ tên, email, vị trí..." oninput="filterCandidateList()" />
                                </div>
                                <select id="filterStageDropdown" class="form-select form-select-sm text-muted" onchange="filterCandidateList()">
                                    <option value="">-- Tất cả giai đoạn tuyển dụng --</option>
                                    <option value="Ứng tuyển">Ứng tuyển mới</option>
                                    <option value="Sơ loại">Sơ loại hồ sơ</option>
                                    <option value="Phỏng vấn">Phỏng vấn</option>
                                    <option value="Đánh giá">Đánh giá chuyên môn</option>
                                </select>
                            </div>

                            <!-- Danh sách cuộn ứng viên -->
                            <div id="candidateListScroll" style="max-height: 520px; overflow-y: auto; padding-right: 4px;">
                                @if (Model.PipelineCandidates.Any())
                                {
                                    @foreach (var c in Model.PipelineCandidates)
                                    {
                                        var isSelected = Model.SelectedCandidate != null && Model.SelectedCandidate.ApplicationId == c.ApplicationId;
                                        <div class="cand-select-card @(isSelected ? "selected" : "")" 
                                             id="candCard-@c.ApplicationId"
                                             data-app-id="@c.ApplicationId"
                                             data-name="@c.FullName"
                                             data-email="@c.Email"
                                             data-job="@c.JobTitle"
                                             data-stage="@c.CurrentStageName"
                                             onclick="selectCandidate('@c.ApplicationId')">
                                            <div class="d-flex align-items-start gap-2.5">
                                                <div class="candidate-avatar-badge">
                                                    @c.InitialLetter
                                                </div>
                                                <div class="flex-grow-1 min-w-0">
                                                    <div class="d-flex align-items-center justify-content-between">
                                                        <h6 class="fw-bold text-dark mb-0 text-truncate" style="font-size: 0.9rem;">@c.FullName</h6>
                                                        @if (c.MatchScore.HasValue)
                                                        {
                                                            <span class="badge rounded-2" style="background:#ECFDF5; color:#047857; font-size: 0.72rem; border: 1px solid #A7F3D0;">
                                                                ⭐ @c.MatchScore% Match
                                                            </span>
                                                        }
                                                    </div>
                                                    <div class="text-muted small text-truncate mt-0.5" style="font-size: 0.78rem;">
                                                        <i class="bi bi-briefcase me-1 text-secondary"></i>@c.JobTitle
                                                    </div>
                                                    <div class="d-flex align-items-center gap-2 mt-1.5 flex-wrap" style="font-size: 0.72rem;">
                                                        <span class="badge bg-light text-dark border">@c.CurrentStageName</span>
                                                        <span class="text-muted"><i class="bi bi-clock me-0.5"></i>@c.FormattedAppliedDate</span>
                                                        @if (c.TotalInterviewsCount > 0)
                                                        {
                                                            <span class="text-info fw-semibold"><i class="bi bi-chat-dots me-0.5"></i>@c.TotalInterviewsCount vòng đã xếp</span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-center py-5 text-muted">
                                        <i class="bi bi-people fs-1 text-secondary opacity-50 mb-2"></i>
                                        <p class="small mb-0">Hiện chưa có ứng viên nào sẵn sàng trong Pipeline.</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Cột phải: Thẻ Tóm Tắt Hồ Sơ Ứng Viên (Candidate Dossier Card) -->
                <div class="col-12 col-lg-7 col-xl-7">
                    <div class="step-section-card" id="candidateDossierCard">
                        <div class="step-section-header">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-person-badge text-primary fs-5"></i>
                                <span class="fw-bold text-dark" style="font-size: 0.92rem;">Tóm Tắt Hồ Sơ & Lịch Sử Tuyển Dụng</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <a id="dossierCvPreviewBtn" href="@(Model.SelectedCandidate?.ActiveResumeId.HasValue == true ? $"/Candidates/PreviewCv?resumeId={Model.SelectedCandidate.ActiveResumeId.Value}" : "javascript:void(0)")" 
                                   target="_blank" class="btn btn-sm btn-outline-primary rounded-2 @(Model.SelectedCandidate?.ActiveResumeId.HasValue == true ? "" : "disabled")" style="font-size: 0.78rem;">
                                    <i class="bi bi-file-earmark-pdf me-1"></i>Xem CV trực tiếp
                                </a>
                                <a id="dossierCandidateDetailBtn" href="@(Model.SelectedCandidate != null ? $"/Candidates/Details/{Model.SelectedCandidate.CandidateId}" : "javascript:void(0)")" 
                                   target="_blank" class="btn btn-sm btn-outline-secondary rounded-2" style="font-size: 0.78rem;">
                                    <i class="bi bi-box-arrow-up-right me-1"></i>Hồ sơ chi tiết
                                </a>
                            </div>
                        </div>
                        <div class="step-section-body" id="dossierBodyContent">
                            @if (Model.SelectedCandidate != null)
                            {
                                <!-- Thông tin cơ bản -->
                                <div class="d-flex align-items-start gap-3 p-3 rounded-3 mb-3" style="background: #F8FAFC; border: 1px solid #E2E8F0;">
                                    <div class="d-flex align-items-center justify-content-center text-white fw-bold shadow-sm flex-shrink-0"
                                         style="width: 58px; height: 58px; border-radius: 12px; background: #0F172A; font-size: 1.4rem;">
                                        <span id="dossierInitials">@Model.SelectedCandidate.InitialLetter</span>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                            <h5 class="fw-bold text-dark mb-0" id="dossierFullName">@Model.SelectedCandidate.FullName</h5>
                                            <span class="badge bg-success text-white rounded-2 px-2.5 py-1" id="dossierStageBadge">
                                                @Model.SelectedCandidate.CurrentStageName
                                            </span>
                                        </div>
                                        <div class="text-muted small mt-1" id="dossierHeadline">
                                            @Model.SelectedCandidate.CurrentTitle tại @Model.SelectedCandidate.CurrentCompany
                                        </div>
                                        <div class="d-flex flex-wrap align-items-center gap-3 text-muted small mt-2" style="font-size: 0.8rem;">
                                            <span><i class="bi bi-envelope me-1 text-secondary"></i><span id="dossierEmail">@Model.SelectedCandidate.Email</span></span>
                                            <span><i class="bi bi-telephone me-1 text-secondary"></i><span id="dossierPhone">@(string.IsNullOrWhiteSpace(Model.SelectedCandidate.Phone) ? "Chưa có SĐT" : Model.SelectedCandidate.Phone)</span></span>
                                            <span><i class="bi bi-building me-1 text-secondary"></i><span id="dossierDepartment">@Model.SelectedCandidate.DepartmentName</span></span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Thông tin vị trí & Đề xuất vòng tiếp theo -->
                                <div class="row g-3 mb-3">
                                    <div class="col-md-6">
                                        <div class="p-3 rounded-2 border bg-white h-100">
                                            <div class="text-muted small mb-1"><i class="bi bi-briefcase me-1 text-primary"></i>Vị trí ứng tuyển</div>
                                            <div class="fw-bold text-dark" id="dossierJobTitle">@Model.SelectedCandidate.JobTitle</div>
                                            <div class="text-secondary small mt-0.5">Cấp bậc: <span class="fw-medium text-dark" id="dossierJobLevel">@Model.SelectedCandidate.JobLevel</span></div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="p-3 rounded-2 border h-100" style="background:#F0FDF4; border-color:#BBF7D0 !important;">
                                            <div class="text-success small fw-semibold mb-1"><i class="bi bi-lightning-charge-fill me-1"></i>Đề xuất vòng kế tiếp</div>
                                            <div class="fw-bold text-dark" id="dossierNextRoundDisplay">Vòng @Model.SelectedCandidate.NextRoundNumber: Phỏng vấn chuyên sâu</div>
                                            <div class="text-muted small mt-0.5">Tự động điền dữ liệu sang Bước 2</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Lịch sử các vòng phỏng vấn trước đó -->
                                <div class="mt-4">
                                    <h6 class="fw-bold text-dark mb-2.5" style="font-size: 0.88rem;">
                                        <i class="bi bi-clock-history me-1.5 text-secondary"></i>Lịch sử các vòng phỏng vấn đã xếp
                                    </h6>
                                    <div id="dossierHistoryContainer">
                                        @if (Model.SelectedCandidate.InterviewHistory.Any())
                                        {
                                            @foreach (var h in Model.SelectedCandidate.InterviewHistory)
                                            {
                                                <div class="p-3 mb-2 rounded-2 border bg-white" style="border-left: 4px solid #059669 !important;">
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <span class="fw-bold text-dark" style="font-size: 0.88rem;">@h.Title</span>
                                                        <span class="badge bg-light text-dark border">@h.StatusDisplay</span>
                                                    </div>
                                                    <div class="d-flex flex-wrap align-items-center gap-3 text-muted small" style="font-size: 0.78rem;">
                                                        <span><i class="bi bi-calendar3 me-1"></i>@h.FormattedTimeRange</span>
                                                        <span><i class="bi bi-geo-alt me-1"></i>@h.InterviewTypeDisplay</span>
                                                        <span><i class="bi bi-people me-1"></i>Hội đồng: @h.PanelistsDisplay</span>
                                                    </div>
                                                    @if (h.AverageScore.HasValue || !string.IsNullOrWhiteSpace(h.FinalConclusion))
                                                    {
                                                        <div class="d-flex align-items-center gap-2 mt-2 pt-2 border-top" style="font-size: 0.78rem;">
                                                            @if (h.AverageScore.HasValue)
                                                            {
                                                                <span class="badge bg-primary text-white">Điểm TB: @h.AverageScore / 5.0</span>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(h.FinalConclusion))
                                                            {
                                                                <span class="badge bg-info text-dark">Kết luận: @h.FinalConclusion</span>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="text-center py-4 bg-light rounded-2 border text-muted">
                                                <i class="bi bi-chat-square-dots text-secondary opacity-50 fs-3 mb-1 d-block"></i>
                                                <span class="small">Ứng viên chưa tham gia vòng phỏng vấn nào trước đó. Buổi hẹn này sẽ là Vòng 1.</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-5 text-muted">
                                    <i class="bi bi-arrow-left-circle fs-1 text-secondary opacity-50 mb-2"></i>
                                    <p class="small mb-0">Vui lòng chọn một ứng viên trong danh sách bên trái để xem tóm tắt hồ sơ.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- BƯỚC 2: THỜI GIAN & HỘI ĐỒNG PHỎNG VẤN                              -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <div id="wizardStepPane-2" class="wizard-pane d-none">
            <div class="row g-4">
                <!-- Cột trái: Thiết lập Thời gian, Vòng & Địa điểm -->
                <div class="col-12 col-lg-6">
                    <div class="step-section-card">
                        <div class="step-section-header">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-clock-fill text-primary fs-5"></i>
                                <span class="fw-bold text-dark" style="font-size: 0.92rem;">Thời Gian & Hình Thức Phỏng Vấn</span>
                            </div>
                            <span class="badge bg-light text-muted border">Múi giờ GMT+7</span>
                        </div>
                        <div class="step-section-body">
                            <!-- Vòng & Tiêu đề -->
                            <div class="row g-2 mb-3">
                                <div class="col-3">
                                    <label class="form-label small fw-semibold text-dark">Số vòng <span class="text-danger">*</span></label>
                                    <input type="number" id="inputRoundNumber" class="form-control form-control-sm text-center fw-bold" min="1" max="10" 
                                           value="@(Model.SelectedCandidate?.NextRoundNumber ?? 1)" onchange="onRoundNumberChange(this.value)" />
                                </div>
                                <div class="col-9">
                                    <label class="form-label small fw-semibold text-dark">Tiêu đề buổi phỏng vấn <span class="text-danger">*</span></label>
                                    <input type="text" id="inputRoundTitle" class="form-control form-control-sm fw-medium" 
                                           value="@(Model.SelectedCandidate?.SuggestedRoundTitle ?? "Phỏng vấn Vòng 1")" oninput="onRoundTitleChange(this.value)" />
                                </div>
                            </div>

                            <!-- Thời gian bắt đầu -->
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-dark">
                                    Thời điểm bắt đầu phỏng vấn <span class="text-danger">*</span>
                                </label>
                                <input type="datetime-local" id="inputStartTime" name="StartTime" class="form-control form-control-sm fw-medium" 
                                       value="@Model.FormInput.StartTime?.ToString("yyyy-MM-ddTHH:mm")" 
                                       min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" 
                                       onchange="onStartTimeChange(this.value)" required />
                                <div class="form-text text-muted" style="font-size: 0.75rem;">
                                    <i class="bi bi-shield-check text-success me-1"></i>Hệ thống tự động chặn lựa chọn ngày giờ trong quá khứ.
                                </div>
                            </div>

                            <!-- Thời lượng phỏng vấn -->
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-dark mb-1.5">Thời lượng dự kiến</label>
                                <div class="d-flex flex-wrap gap-2">
                                    <button type="button" class="duration-pill-btn" data-minutes="30" onclick="selectDuration(30)">30 phút</button>
                                    <button type="button" class="duration-pill-btn" data-minutes="45" onclick="selectDuration(45)">45 phút</button>
                                    <button type="button" class="duration-pill-btn active" data-minutes="60" onclick="selectDuration(60)">60 phút (Chuẩn)</button>
                                    <button type="button" class="duration-pill-btn" data-minutes="90" onclick="selectDuration(90)">90 phút</button>
                                    <button type="button" class="duration-pill-btn" data-minutes="120" onclick="selectDuration(120)">120 phút</button>
                                </div>
                            </div>

                            <!-- Hình thức phỏng vấn & Phòng họp -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1.5">
                                    <label class="form-label small fw-semibold text-dark mb-0">
                                        Hình thức tổ chức phỏng vấn <span class="text-danger">*</span>
                                    </label>
                                    <span class="badge bg-light text-secondary border font-monospace" style="font-size: 0.72rem;" id="formatSelectionBadge">
                                        <i class="bi bi-camera-video-fill text-success me-1"></i>Google Meet
                                    </span>
                                </div>
                                <ul class="nav nav-pills nav-fill bg-light p-1 rounded-3 mb-2.5 gap-1" id="interviewTypeTabs" role="tablist" style="border: 1px solid #E2E8F0;">
                                    <li class="nav-item">
                                        <button class="nav-link active py-2 text-dark fw-semibold d-flex align-items-center justify-content-center gap-1.5" 
                                                id="tab-meet" type="button" onclick="setInterviewFormat('MEET')" style="font-size: 0.82rem; border-radius: 6px;">
                                            <i class="bi bi-camera-video-fill text-success"></i>
                                            <span>Google Meet</span>
                                        </button>
                                    </li>
                                    <li class="nav-item">
                                        <button class="nav-link py-2 text-dark fw-semibold d-flex align-items-center justify-content-center gap-1.5" 
                                                id="tab-teams" type="button" onclick="setInterviewFormat('TEAMS')" style="font-size: 0.82rem; border-radius: 6px;">
                                            <i class="bi bi-microsoft text-primary"></i>
                                            <span>MS Teams</span>
                                        </button>
                                    </li>
                                    <li class="nav-item">
                                        <button class="nav-link py-2 text-dark fw-semibold d-flex align-items-center justify-content-center gap-1.5" 
                                                id="tab-offline" type="button" onclick="setInterviewFormat('OFFLINE')" style="font-size: 0.82rem; border-radius: 6px;">
                                            <i class="bi bi-building text-warning-emphasis"></i>
                                            <span>Trực tiếp văn phòng</span>
                                        </button>
                                    </li>
                                </ul>

                                <!-- Preset phòng họp có sẵn theo hình thức đã lọc -->
                                <div class="d-flex justify-content-between align-items-center mb-1.5">
                                    <label class="form-label small text-muted mb-0" id="roomPresetLabel">
                                        Chọn mẫu cấu hình sẵn cho Google Meet:
                                    </label>
                                    <span class="text-xs text-muted" id="roomPresetCount">Khả dụng</span>
                                </div>
                                <div id="roomPresetList">
                                    @foreach (var room in Model.RoomPresets)
                                    {
                                        var platform = !string.IsNullOrEmpty(room.Platform) 
                                            ? room.Platform 
                                            : (room.Type == "ONLINE_MEET" ? (room.LocationOrLink.Contains("teams") ? "TEAMS" : "MEET") : "OFFLINE");
                                        var isInitialActive = room.IsDefault && platform == "MEET";
                                        var badgeColorClass = platform switch
                                        {
                                            "MEET" => "bg-success-subtle text-success border border-success-subtle",
                                            "TEAMS" => "bg-primary-subtle text-primary border border-primary-subtle",
                                            _ => "bg-warning-subtle text-warning-emphasis border border-warning-subtle"
                                        };
                                        var platformIcon = platform switch
                                        {
                                            "MEET" => "bi-camera-video-fill text-success",
                                            "TEAMS" => "bi-microsoft text-primary",
                                            _ => "bi-door-closed-fill text-warning-emphasis"
                                        };

                                        <div class="preset-room-badge @(isInitialActive ? "active" : "") @(platform == "MEET" ? "" : "d-none")" 
                                             id="roomBadge-@room.Id"
                                             data-room-id="@room.Id"
                                             data-platform="@platform"
                                             data-room-type="@room.Type"
                                             data-location="@room.LocationOrLink"
                                             onclick="selectRoomPreset('@room.Id', '@room.Type', '@room.LocationOrLink', '@platform')">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <div class="fw-semibold text-dark" style="font-size: 0.85rem;">
                                                    <i class="bi @platformIcon me-1.5"></i>
                                                    @room.Name
                                                </div>
                                                <span class="badge @badgeColorClass" style="font-size: 0.72rem;">@room.BadgeText</span>
                                            </div>
                                            <div class="text-muted small mt-1 text-truncate" style="font-size: 0.76rem;">
                                                <i class="bi bi-info-circle me-1"></i>@room.Capacity · @room.Description
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Input địa điểm / link tùy chỉnh -->
                                <div class="mt-2.5">
                                    <label class="form-label small fw-semibold text-dark d-flex align-items-center gap-1" id="locationLabel">
                                        <i class="bi bi-link-45deg text-success"></i>
                                        <span id="locationLabelText">Liên kết cuộc họp Google Meet</span>
                                        <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light text-muted" id="locationInputPrepend">
                                            <i class="bi bi-camera-video text-success" id="locationPrependIcon"></i>
                                        </span>
                                        <input type="text" id="inputLocationOrLink" class="form-control" 
                                               value="https://meet.google.com/nvr-atsw-int" 
                                               placeholder="https://meet.google.com/xxx-yyyy-zzz"
                                               oninput="onLocationOrLinkChange(this.value)" required />
                                    </div>
                                    <div class="form-text text-muted" style="font-size: 0.74rem;" id="locationHelpText">
                                        <i class="bi bi-info-circle me-1"></i>Đường link Google Meet sẽ được gửi kèm trong email thư mời và hiển thị trên lịch ứng viên.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Cột phải: Chọn Hội đồng phỏng vấn & Kiểm tra Lịch trống (Smart Availability Engine) -->
                <div class="col-12 col-lg-6">
                    <div class="step-section-card">
                        <div class="step-section-header">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-people-fill text-success fs-5"></i>
                                <span class="fw-bold text-dark" style="font-size: 0.92rem;">Hội Đồng Phỏng Vấn (Panelists)</span>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-success rounded-2 py-0.5 px-2" onclick="checkAllInterviewersAvailability()" title="Kiểm tra lại lịch trống">
                                <i class="bi bi-arrow-repeat me-1"></i>Kiểm tra lịch trống
                            </button>
                        </div>
                        <div class="step-section-body">
                            <div class="alert alert-info py-2 px-2.5 mb-3 rounded-2 border-0" style="background:#EFF6FF; color:#1E40AF; font-size: 0.8rem;">
                                <i class="bi bi-info-circle-fill me-1"></i>
                                Chọn ít nhất <strong>01 giám khảo</strong>. Hệ thống sẽ tự động đối soát lịch để tránh trùng lịch phỏng vấn khác trong cùng khung giờ.
                            </div>

                            <!-- Danh sách giám khảo -->
                            <div id="interviewerListScroll" style="max-height: 480px; overflow-y: auto; padding-right: 4px;">
                                @if (Model.AvailableInterviewers.Any())
                                {
                                    @for (int i = 0; i < Model.AvailableInterviewers.Count; i++)
                                    {
                                        var inv = Model.AvailableInterviewers[i];
                                        if (!Ats.Web.Constants.UserRoles.CanBeInterviewer(inv.Role)) { continue; }
                                        var isPrechecked = i < 2; // Chọn mẫu 2 người đầu trong danh sách giám khảo hợp lệ
                                        var displayRole = Ats.Web.Constants.UserRoles.GetDisplayName(inv.Role);
                                        <div class="panelist-select-row @(isPrechecked ? "selected" : "")" id="panelistRow-@inv.Id">
                                            <div class="d-flex align-items-center gap-2.5">
                                                <input type="checkbox" class="form-check-input panelist-checkbox" 
                                                       id="chkInv-@inv.Id" 
                                                       name="InterviewerIds" 
                                                       value="@inv.Id" 
                                                       data-name="@inv.FullName"
                                                       data-role="@displayRole"
                                                       @(isPrechecked ? "checked" : "") 
                                                       onchange="togglePanelistSelect('@inv.Id')" />
                                                <div>
                                                    <div class="fw-bold text-dark" style="font-size: 0.86rem;">@inv.FullName</div>
                                                    <div class="text-muted small" style="font-size: 0.76rem;">
                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle me-1" style="font-size: 0.72rem;">@displayRole</span>
                                                        @inv.Email
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="text-end">
                                                <span class="badge rounded-2 availability-badge" id="availBadge-@inv.Id" 
                                                      style="background:#ECFDF5; color:#065F46; border: 1px solid #A7F3D0; font-size: 0.72rem;">
                                                    <i class="bi bi-check2-circle me-1"></i>Sẵn sàng (Trống lịch)
                                                </span>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-center py-4 text-muted">
                                        <i class="bi bi-person-x fs-2 text-secondary mb-1"></i>
                                        <p class="small mb-0">Chưa tìm thấy nhân sự khả dụng để phân công.</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- BƯỚC 3: SOẠN THẢO & XEM TRƯỚC THƯ MỜI (LIVE EMAIL PREVIEW)          -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <div id="wizardStepPane-3" class="wizard-pane d-none">
            <div class="row g-4">
                <!-- Cột trái: Cấu hình nội dung thư mời -->
                <div class="col-12 col-lg-5">
                    <div class="step-section-card">
                        <div class="step-section-header">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-pencil-square text-primary fs-5"></i>
                                <span class="fw-bold text-dark" style="font-size: 0.92rem;">Cấu Hình Nội Dung Thư Mời Email</span>
                            </div>
                            <span class="badge bg-light text-muted border">Tự động đồng bộ</span>
                        </div>
                        <div class="step-section-body">
                            <!-- Tiêu đề Email -->
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-dark">Tiêu đề thư mời (Subject)</label>
                                <input type="text" id="emailSubjectInput" class="form-control form-control-sm" 
                                       value="📅 [Thư mời phỏng vấn] Vị trí @(Model.SelectedCandidate?.JobTitle ?? "Chuyên môn") — NoveraTech" 
                                       oninput="updateEmailLivePreview()" />
                            </div>

                            <!-- Lời mở đầu -->
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-dark">Lời chào & Đoạn mở đầu</label>
                                <textarea id="emailOpeningInput" class="form-control form-control-sm" rows="3" oninput="updateEmailLivePreview()">NoveraTech trân trọng kính mời bạn tham gia phiên phỏng vấn chính thức. Ban tuyển dụng rất ấn tượng với năng lực và kinh nghiệm chuyên môn của bạn.</textarea>
                            </div>

                            <!-- Hướng dẫn chuẩn bị -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label small fw-semibold text-dark mb-0">Hướng dẫn chuẩn bị cho ứng viên</label>
                                    <button type="button" class="btn btn-link p-0 text-success text-decoration-none small" style="font-size: 0.75rem;" onclick="resetDefaultPreparationGuide()">
                                        <i class="bi bi-arrow-clockwise me-0.5"></i>Khôi phục mẫu chuẩn
                                    </button>
                                </div>
                                <textarea id="emailGuideInput" class="form-control form-control-sm" rows="5" oninput="updateEmailLivePreview()">@Model.DefaultPreparationGuide</textarea>
                            </div>

                            <!-- Thông tin liên hệ HR -->
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-dark">Thông tin hỗ trợ nhân sự (Chân trang)</label>
                                <input type="text" id="emailHrContactInput" class="form-control form-control-sm" 
                                       value="@Model.DefaultHrContactNote" oninput="updateEmailLivePreview()" />
                            </div>

                            <!-- Ghi chú nội bộ -->
                            <div class="mb-2">
                                <label class="form-label small fw-semibold text-dark">Ghi chú lưu hành nội bộ (Chỉ Hội đồng xem)</label>
                                <textarea id="inputInternalNotes" class="form-control form-control-sm" rows="2" placeholder="Ví dụ: Ứng viên mong muốn phỏng vấn tập trung vào System Architecture..." oninput="onNoteChange(this.value)"></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Cột phải: Khung Xem Trước Trực Quan Email (Live Interactive Preview) -->
                <div class="col-12 col-lg-7">
                    <div class="email-mockup-wrapper">
                        <!-- Top Bar mô phỏng ứng dụng Email -->
                        <div class="email-mockup-topbar">
                            <div class="d-flex align-items-center justify-content-between">
