    function suggestDefaultGuideIfUnchanged(mode) {
        const guideEl = document.getElementById('emailGuideInput');
        if (!guideEl) return;
        const curVal = guideEl.value.trim();
        if (!curVal || curVal === ONLINE_DEFAULT_GUIDE.trim() || curVal === OFFLINE_DEFAULT_GUIDE.trim()) {
            guideEl.value = (mode === 'OFFLINE') ? OFFLINE_DEFAULT_GUIDE : ONLINE_DEFAULT_GUIDE;
        }
    }

    function setInterviewFormat(format) {
        selectedInterviewFormat = format;
        selectedInterviewType = (format === 'OFFLINE') ? 'OFFLINE_OFFICE' : 'ONLINE_MEET';

        const formTypeEl = document.getElementById('formInterviewType');
        if (formTypeEl) formTypeEl.value = selectedInterviewType;

        const formFormatEl = document.getElementById('formInterviewFormat');
        if (formFormatEl) formFormatEl.value = format;

        // Cập nhật tab active
        const tabMeet = document.getElementById('tab-meet');
        const tabTeams = document.getElementById('tab-teams');
        const tabOffline = document.getElementById('tab-offline');

        if (tabMeet) tabMeet.classList.toggle('active', format === 'MEET');
        if (tabTeams) tabTeams.classList.toggle('active', format === 'TEAMS');
        if (tabOffline) tabOffline.classList.toggle('active', format === 'OFFLINE');

        // Cập nhật nhãn và thông tin hướng dẫn theo hình thức
        const formatBadge = document.getElementById('formatSelectionBadge');
        const roomPresetLabel = document.getElementById('roomPresetLabel');
        const roomPresetCount = document.getElementById('roomPresetCount');
        const locationLabelText = document.getElementById('locationLabelText');
        const locationPrependIcon = document.getElementById('locationPrependIcon');
        const inputLocation = document.getElementById('inputLocationOrLink');
        const locationHelpText = document.getElementById('locationHelpText');

        // Lọc danh sách preset phòng họp theo platform
        const roomBadges = document.querySelectorAll('.preset-room-badge');
        let visibleCount = 0;
        let firstVisibleBadge = null;
        let currentlyActiveVisible = false;

        roomBadges.forEach(badge => {
            const platform = badge.getAttribute('data-platform');
            if (platform === format) {
                badge.classList.remove('d-none');
                visibleCount++;
                if (!firstVisibleBadge) firstVisibleBadge = badge;
                if (badge.classList.contains('active')) {
                    currentlyActiveVisible = true;
                }
            } else {
                badge.classList.add('d-none');
                badge.classList.remove('active');
            }
        });

        if (roomPresetCount) {
            roomPresetCount.textContent = `${visibleCount} mẫu khả dụng`;
        }

        if (format === 'MEET') {
            if (formatBadge) formatBadge.innerHTML = '<i class="bi bi-camera-video-fill text-success me-1"></i>Google Meet';
            if (roomPresetLabel) roomPresetLabel.textContent = 'Chọn mẫu cấu hình sẵn cho Google Meet:';
            if (locationLabelText) locationLabelText.textContent = 'Liên kết cuộc họp Google Meet';
            if (locationPrependIcon) locationPrependIcon.className = 'bi bi-camera-video text-success';
            if (inputLocation) inputLocation.placeholder = 'https://meet.google.com/xxx-yyyy-zzz';
            if (locationHelpText) locationHelpText.innerHTML = '<i class="bi bi-info-circle me-1"></i>Đường link Google Meet sẽ được gửi kèm trong email thư mời và hiển thị trên lịch ứng viên.';

            if (!currentlyActiveVisible && firstVisibleBadge) {
                const rId = firstVisibleBadge.getAttribute('data-room-id');
                const rType = firstVisibleBadge.getAttribute('data-room-type');
                const rLoc = firstVisibleBadge.getAttribute('data-location');
                selectRoomPreset(rId, rType, rLoc, format);
            }
            suggestDefaultGuideIfUnchanged('ONLINE');
        } else if (format === 'TEAMS') {
            if (formatBadge) formatBadge.innerHTML = '<i class="bi bi-microsoft text-primary me-1"></i>Microsoft Teams';
            if (roomPresetLabel) roomPresetLabel.textContent = 'Chọn mẫu cấu hình sẵn cho Microsoft Teams:';
            if (locationLabelText) locationLabelText.textContent = 'Liên kết cuộc họp Microsoft Teams';
            if (locationPrependIcon) locationPrependIcon.className = 'bi bi-microsoft text-primary';
            if (inputLocation) inputLocation.placeholder = 'https://teams.microsoft.com/l/meetup-join/...';
            if (locationHelpText) locationHelpText.innerHTML = '<i class="bi bi-info-circle me-1"></i>Đường link Microsoft Teams sẽ được gửi kèm trong email thư mời và tối ưu chia sẻ màn hình kỹ thuật.';

            if (!currentlyActiveVisible && firstVisibleBadge) {
                const rId = firstVisibleBadge.getAttribute('data-room-id');
                const rType = firstVisibleBadge.getAttribute('data-room-type');
                const rLoc = firstVisibleBadge.getAttribute('data-location');
                selectRoomPreset(rId, rType, rLoc, format);
            }
            suggestDefaultGuideIfUnchanged('ONLINE');
        } else {
            // OFFLINE
            if (formatBadge) formatBadge.innerHTML = '<i class="bi bi-building text-warning-emphasis me-1"></i>Trực tiếp văn phòng';
            if (roomPresetLabel) roomPresetLabel.textContent = 'Chọn phòng họp trực tiếp tại văn phòng NoveraTech:';
            if (locationLabelText) locationLabelText.textContent = 'Địa điểm & Phòng họp trực tiếp tại văn phòng';
            if (locationPrependIcon) locationPrependIcon.className = 'bi bi-building text-warning-emphasis';
            if (inputLocation) inputLocation.placeholder = 'Nhập địa chỉ, tầng, tên phòng họp trực tiếp tại văn phòng...';
            if (locationHelpText) locationHelpText.innerHTML = '<i class="bi bi-geo-alt me-1"></i>Địa chỉ văn phòng cụ thể sẽ được in rõ ràng trong thư mời gửi ứng viên và giám khảo.';

            if (!currentlyActiveVisible && firstVisibleBadge) {
                const rId = firstVisibleBadge.getAttribute('data-room-id');
                const rType = firstVisibleBadge.getAttribute('data-room-type');
                const rLoc = firstVisibleBadge.getAttribute('data-location');
                selectRoomPreset(rId, rType, rLoc, format);
            }
            suggestDefaultGuideIfUnchanged('OFFLINE');
        }

        updateEmailLivePreview();
        updateSummaryDashboard();
    }

