        if (recipient) recipient.textContent = selectedEmail || 'ungvien@email.com';

        // Cập nhật tiêu đề
        const subj = document.getElementById('emailSubjectInput').value;
        const subjPreview = document.getElementById('previewSubjectText');
        if (subjPreview) subjPreview.textContent = subj;

        // Cập nhật tên ứng viên
        const candName = document.getElementById('previewCandidateName');
        if (candName) candName.textContent = selectedCandidateName || 'Ứng viên';

        // Lời mở đầu
        const opening = document.getElementById('emailOpeningInput').value;
        const openingPreview = document.getElementById('previewOpeningText');
        if (openingPreview) openingPreview.textContent = opening;

        // Bảng chi tiết
        document.getElementById('previewTableJob').textContent = selectedJobTitle || 'Vị trí chuyên môn';
        document.getElementById('previewTableRound').textContent = selectedRoundTitle || `Phỏng vấn Vòng ${selectedRoundNumber}`;

        const startTimeVal = document.getElementById('inputStartTime').value;
        if (startTimeVal) {
            const dt = new Date(startTimeVal);
            const endDt = new Date(dt.getTime() + selectedDurationMinutes * 60000);
            const dateStr = dt.toLocaleDateString('vi-VN', { weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric' });
            const timeStr = `${pad(dt.getHours())}:${pad(dt.getMinutes())} - ${pad(endDt.getHours())}:${pad(endDt.getMinutes())} (GMT+7)`;
            document.getElementById('previewTableTime').textContent = `${dateStr} (${timeStr})`;
        } else {
            document.getElementById('previewTableTime').textContent = 'Chưa chọn ngày giờ';
        }

        const locationPreviewEl = document.getElementById('previewTableLocation');
        if (locationPreviewEl) {
            if (selectedInterviewFormat === 'MEET') {
                locationPreviewEl.innerHTML = `<span class="badge bg-success-subtle text-success border border-success-subtle me-1.5"><i class="bi bi-camera-video me-1"></i>Google Meet</span> <span class="text-dark fw-semibold">${selectedLocationOrLink || 'Chưa cấu hình'}</span>`;
            } else if (selectedInterviewFormat === 'TEAMS') {
                locationPreviewEl.innerHTML = `<span class="badge bg-primary-subtle text-primary border border-primary-subtle me-1.5"><i class="bi bi-microsoft me-1"></i>MS Teams</span> <span class="text-dark fw-semibold">${selectedLocationOrLink || 'Chưa cấu hình'}</span>`;
            } else {
                locationPreviewEl.innerHTML = `<span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle me-1.5"><i class="bi bi-building me-1"></i>Trực tiếp văn phòng</span> <span class="text-dark fw-semibold">${selectedLocationOrLink || 'Chưa cấu hình'}</span>`;
            }
        }

        // Danh sách giám khảo
        const checkedPanelistNames = Array.from(document.querySelectorAll('.panelist-checkbox:checked')).map(el => el.getAttribute('data-name'));
        document.getElementById('previewTablePanelists').textContent = checkedPanelistNames.length > 0 ? checkedPanelistNames.join(', ') : 'Ban Tuyển Dụng NoveraTech';

        // Hướng dẫn chuẩn bị
        const guide = document.getElementById('emailGuideInput').value;
        document.getElementById('previewGuideText').innerHTML = guide.replace(/\n/g, '<br/>');

        // Chân trang
        document.getElementById('previewFooterText').textContent = document.getElementById('emailHrContactInput').value;
    }

