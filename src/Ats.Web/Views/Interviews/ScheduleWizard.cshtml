    }

    function pad(n) {
        return n < 10 ? '0' + n : n;
    }

    // ── Bước 4: Summary Dashboard ──
    function updateSummaryDashboard() {
        document.getElementById('summaryCandName').textContent = selectedCandidateName || 'Ứng viên';
        document.getElementById('summaryCandEmail').textContent = selectedEmail || 'ungvien@email.com';
        document.getElementById('summaryJobTitle').textContent = selectedJobTitle || 'Chuyên môn';

        const startTimeVal = document.getElementById('inputStartTime').value;
        if (startTimeVal) {
            const dt = new Date(startTimeVal);
            const dateStr = dt.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
            const timeStr = `${pad(dt.getHours())}:${pad(dt.getMinutes())}`;
            document.getElementById('summaryTimeDisplay').textContent = `${timeStr} ngày ${dateStr}`;
        }
        document.getElementById('summaryDurationDisplay').textContent = `Thời lượng: ${selectedDurationMinutes} phút`;
        
        const typeBadgeEl = document.getElementById('summaryTypeBadge');
        if (typeBadgeEl) {
            if (selectedInterviewFormat === 'MEET') {
                typeBadgeEl.className = 'badge bg-success-subtle text-success border border-success-subtle py-1 px-2.5';
                typeBadgeEl.innerHTML = '<i class="bi bi-camera-video me-1"></i>Trực tuyến (Google Meet)';
            } else if (selectedInterviewFormat === 'TEAMS') {
                typeBadgeEl.className = 'badge bg-primary-subtle text-primary border border-primary-subtle py-1 px-2.5';
                typeBadgeEl.innerHTML = '<i class="bi bi-microsoft me-1"></i>Trực tuyến (MS Teams)';
            } else {
                typeBadgeEl.className = 'badge bg-warning-subtle text-warning-emphasis border border-warning-subtle py-1 px-2.5';
                typeBadgeEl.innerHTML = '<i class="bi bi-building me-1"></i>Trực tiếp tại văn phòng';
            }
        }
        document.getElementById('summaryLocationDisplay').textContent = selectedLocationOrLink;

        const checkedPanelists = Array.from(document.querySelectorAll('.panelist-checkbox:checked'));
        document.getElementById('summaryPanelistCount').textContent = `${checkedPanelists.length} Giám khảo`;
        const names = checkedPanelists.map(el => el.getAttribute('data-name')).join(', ');
        document.getElementById('summaryPanelistNames').textContent = names || 'Chưa chọn';
    }

    // ── Form Submission ──
    async function handleWizardFormSubmit(event) {
        event.preventDefault();
        closeWizardAlert();

        if (!validateStep(1) || !validateStep(2) || !validateStep(3)) {
            return;
        }

        const confirmCheck = document.getElementById('confirmAccuracyCheckbox');
        if (!confirmCheck.checked) {
            showWizardAlert('Vui lòng tích xác nhận cam kết thông tin trước khi phát lệnh.', 'warning');
            confirmCheck.focus();
            return;
        }

        const submitBtn = document.getElementById('btnFinalSubmitSchedule');
        const originalHtml = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>ĐANG PHÁT LỆNH & GỬI THƯ MỜI...';

        const form = document.getElementById('interviewWizardForm');
        const formData = new FormData(form);

        try {
            const response = await fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            const result = await response.json();

            if (response.ok && result.success) {
                // Hiển thị Success Modal
                document.getElementById('successModalCandName').textContent = selectedCandidateName;
                document.getElementById('successModalRoundTitle').textContent = result.title || selectedRoundTitle;
                document.getElementById('successModalTime').textContent = result.startTime ? `${result.startTime} - ${result.endTime}` : document.getElementById('summaryTimeDisplay').textContent;
                document.getElementById('successModalLink').textContent = selectedLocationOrLink;
                if (result.redirectUrl) {
                    document.getElementById('btnGoToPipeline').href = result.redirectUrl;
                }

                document.getElementById('scheduleSuccessModal').classList.remove('d-none');
            } else {
                const msg = result.message || 'Đã xảy ra lỗi khi tạo lịch phỏng vấn.';
                showWizardAlert(msg, 'danger');
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalHtml;
            }
        } catch (error) {
            console.error('Lỗi Submit Wizard:', error);
            showWizardAlert('Không thể kết nối máy chủ để hoàn tất đặt lịch. Vui lòng thử lại.', 'danger');
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalHtml;
        }
    }

    function resetWizardForNewSchedule() {
        document.getElementById('scheduleSuccessModal').classList.add('d-none');
        window.location.href = '/phong-van/dat-lich';
    }

    function showWizardAlert(message, type) {
        const box = document.getElementById('wizardAlertBox');
        const text = document.getElementById('wizardAlertText');
        const icon = document.getElementById('wizardAlertIcon');
        const container = document.getElementById('wizardAlertContainer');

        box.className = `alert alert-${type} alert-dismissible fade show rounded-2 py-2.5 px-3 mb-0 border-0 shadow-sm`;
        if (type === 'danger') {
            box.style.background = '#FEF2F2';
            box.style.color = '#991B1B';
            box.style.borderLeft = '4px solid #DC2626';
            icon.className = 'bi bi-exclamation-octagon-fill me-2 fs-5 text-danger';
        } else if (type === 'warning') {
            box.style.background = '#FFFBEB';
            box.style.color = '#92400E';
            box.style.borderLeft = '4px solid #F59E0B';
            icon.className = 'bi bi-exclamation-triangle-fill me-2 fs-5 text-warning';
        } else {
            box.style.background = '#ECFDF5';
            box.style.color = '#065F46';
            box.style.borderLeft = '4px solid #059669';
            icon.className = 'bi bi-check-circle-fill me-2 fs-5 text-success';
        }

        text.textContent = message;
        container.classList.remove('d-none');
        container.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function closeWizardAlert() {
        document.getElementById('wizardAlertContainer').classList.add('d-none');
    }
</script>
