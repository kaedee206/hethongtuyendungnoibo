<!-- ── STICKY FOOTER NAVIGATION (Điều hướng 4 bước) ── -->
<div class="wizard-sticky-nav-footer">
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-light text-dark border px-2.5 py-1.5" style="font-size: 0.82rem;" id="footerStepIndicatorBadge">
            Bước 1 / 4: Chọn đối tượng
        </span>
        <span class="text-muted small d-none d-md-inline" id="footerStepHintText">Chọn ứng viên cần phỏng vấn từ danh sách pipeline</span>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-outline-secondary rounded-2 px-3 py-1.5 d-none" id="btnPrevStep" onclick="goPreviousStep()">
            <i class="bi bi-arrow-left me-1"></i>Quay lại bước trước
        </button>
        <button type="button" class="btn text-white fw-semibold rounded-2 px-4 py-1.5 shadow-sm" id="btnNextStep" style="background: #059669; border-color: #059669;" onclick="goNextStep()">
            Tiếp tục sang bước tiếp theo <i class="bi bi-arrow-right ms-1"></i>
        </button>
    </div>
</div>

<script>
    /* ═══════════════════════════════════════════════════════════════════
       JAVASCRIPT ĐIỀU PHỐI WIZARD ĐẶT LỊCH PHỎNG VẤN 4 BƯỚC
       ═══════════════════════════════════════════════════════════════════ */
    let currentStep = 1;
    let selectedApplicationId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SelectedCandidate?.ApplicationId.ToString() ?? ""));
    let selectedCandidateName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SelectedCandidate?.FullName ?? ""));
    let selectedJobTitle = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SelectedCandidate?.JobTitle ?? ""));
    let selectedEmail = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SelectedCandidate?.Email ?? ""));
    let selectedRoundNumber = @(Model.SelectedCandidate?.NextRoundNumber ?? 1);
    let selectedRoundTitle = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SelectedCandidate?.SuggestedRoundTitle ?? "Phỏng vấn Vòng 1"));
    let selectedDurationMinutes = 60;
    let selectedInterviewFormat = 'MEET';
    let selectedInterviewType = 'ONLINE_MEET';
    let selectedLocationOrLink = 'https://meet.google.com/nvr-atsw-int';

    document.addEventListener('DOMContentLoaded', function () {
        // Khởi tạo ngày giờ mặc định nếu chưa có
        const timeInput = document.getElementById('inputStartTime');
        if (!timeInput.value) {
            const tmr = new Date();
            tmr.setDate(tmr.getDate() + 1);
            tmr.setHours(9, 0, 0, 0);
            timeInput.value = formatDateTimeLocal(tmr);
        }

        // Khởi tạo bộ lọc hình thức phỏng vấn (Mặc định: Google Meet)
        setInterviewFormat(selectedInterviewFormat);

        updateEmailLivePreview();
        updateSummaryDashboard();
    });

    function formatDateTimeLocal(date) {
        const pad = (n) => n < 10 ? '0' + n : n;
        return date.getFullYear() + '-' +
            pad(date.getMonth() + 1) + '-' +
            pad(date.getDate()) + 'T' +
            pad(date.getHours()) + ':' +
            pad(date.getMinutes());
    }

    // ── Điều hướng Step ──
    function navigateToStep(stepNumber) {
        if (stepNumber < 1 || stepNumber > 4) return;

        // Validation trước khi chuyển bước tiếp theo
        if (stepNumber > currentStep) {
            if (!validateStep(currentStep)) return;
        }

        currentStep = stepNumber;

        // Ẩn/Hiện Panes
        for (let i = 1; i <= 4; i++) {
            const pane = document.getElementById(`wizardStepPane-${i}`);
            const btn = document.getElementById(`stepNavBtn-${i}`);
            const circle = document.getElementById(`stepCircle-${i}`);
            const connector = document.getElementById(`stepConnector-${i}`);

            if (pane) {
                if (i === currentStep) {
                    pane.classList.remove('d-none');
                } else {
                    pane.classList.add('d-none');
                }
            }

            if (btn && circle) {
                btn.classList.remove('active', 'completed');
                if (i === currentStep) {
                    btn.classList.add('active');
                } else if (i < currentStep) {
                    btn.classList.add('completed');
                }
            }

            if (connector) {
                if (i < currentStep) {
                    connector.classList.add('completed');
                } else {
                    connector.classList.remove('completed');
                }
            }
        }

        // Cập nhật Sticky Footer
        const prevBtn = document.getElementById('btnPrevStep');
        const nextBtn = document.getElementById('btnNextStep');
        const badge = document.getElementById('footerStepIndicatorBadge');
        const hint = document.getElementById('footerStepHintText');

        if (currentStep === 1) {
            prevBtn.classList.add('d-none');
            nextBtn.classList.remove('d-none');
            nextBtn.innerHTML = 'Tiếp tục: Thời gian & Hội đồng <i class="bi bi-arrow-right ms-1"></i>';
            badge.textContent = 'Bước 1 / 4: Chọn đối tượng';
            hint.textContent = 'Chọn ứng viên cần phỏng vấn từ danh sách pipeline';
        } else if (currentStep === 2) {
            prevBtn.classList.remove('d-none');
            nextBtn.classList.remove('d-none');
            nextBtn.innerHTML = 'Tiếp tục: Soạn thảo & Xem trước <i class="bi bi-arrow-right ms-1"></i>';
            badge.textContent = 'Bước 2 / 4: Thời gian & Hội đồng';
            hint.textContent = 'Chọn ngày giờ, thời lượng, phòng họp và giám khảo';
            // Tự động kiểm tra lịch bận khi sang bước 2
            checkAllInterviewersAvailability();
        } else if (currentStep === 3) {
            prevBtn.classList.remove('d-none');
            nextBtn.classList.remove('d-none');
            nextBtn.innerHTML = 'Tiếp tục: Xác nhận & Chốt lịch <i class="bi bi-arrow-right ms-1"></i>';
            badge.textContent = 'Bước 3 / 4: Soạn & Xem trước';
            hint.textContent = 'Kiểm tra bức thư mời email thực tế mà ứng viên sẽ nhận được';
            updateEmailLivePreview();
        } else if (currentStep === 4) {
            prevBtn.classList.remove('d-none');
            nextBtn.classList.add('d-none'); // Ở bước 4 người dùng bấm nút Chốt lịch lớn trong form
            badge.textContent = 'Bước 4 / 4: Xác nhận & Chốt lịch';
            hint.textContent = 'Kiểm duyệt toàn bộ thông tin trước khi phát lệnh';
            updateSummaryDashboard();
        }

        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function goNextStep() {
        if (currentStep < 4) {
            navigateToStep(currentStep + 1);
        }
    }

    function goPreviousStep() {
        if (currentStep > 1) {
            navigateToStep(currentStep - 1);
        }
    }

    // ── Validation từng bước ──
    function validateStep(step) {
        closeWizardAlert();

        if (step === 1) {
            if (!selectedApplicationId || selectedApplicationId === '@Guid.Empty') {
                showWizardAlert('Vui lòng chọn một ứng viên trong danh sách trước khi tiếp tục.', 'warning');
                return false;
            }
            return true;
        }

        if (step === 2) {
            const timeVal = document.getElementById('inputStartTime').value;
            if (!timeVal) {
                showWizardAlert('Vui lòng chọn ngày giờ bắt đầu phỏng vấn.', 'warning');
                document.getElementById('inputStartTime').focus();
                return false;
            }

            const chosenDate = new Date(timeVal);
            if (chosenDate <= new Date()) {
                showWizardAlert('Không thể đặt lịch phỏng vấn trong quá khứ. Vui lòng chọn thời gian trong tương lai.', 'danger');
                document.getElementById('inputStartTime').focus();
                return false;
            }

            const loc = document.getElementById('inputLocationOrLink').value.trim();
            if (!loc) {
                const locMsg = (selectedInterviewFormat === 'OFFLINE')
                    ? 'Vui lòng cung cấp địa chỉ phòng họp trực tiếp tại văn phòng.'
                    : `Vui lòng cung cấp liên kết cuộc họp ${selectedInterviewFormat === 'MEET' ? 'Google Meet' : 'Microsoft Teams'}.`;
                showWizardAlert(locMsg, 'warning');
                document.getElementById('inputLocationOrLink').focus();
                return false;
            }

            if (selectedInterviewFormat !== 'OFFLINE' && !loc.startsWith('http://') && !loc.startsWith('https://')) {
                showWizardAlert(`Liên kết cuộc họp ${selectedInterviewFormat === 'MEET' ? 'Google Meet' : 'Microsoft Teams'} phải là đường dẫn URL hợp lệ (bắt đầu bằng https://).`, 'warning');
                document.getElementById('inputLocationOrLink').focus();
                return false;
            }

            const checkedPanelists = document.querySelectorAll('.panelist-checkbox:checked');
            if (checkedPanelists.length === 0) {
                showWizardAlert('Hội đồng phỏng vấn bắt buộc có ít nhất 01 thành viên. Vui lòng chọn giám khảo.', 'warning');
                return false;
            }

            return true;
        }

        if (step === 3) {
            const subj = document.getElementById('emailSubjectInput').value.trim();
            if (!subj) {
                showWizardAlert('Tiêu đề thư mời không được để trống.', 'warning');
                document.getElementById('emailSubjectInput').focus();
                return false;
            }
            return true;
        }

        return true;
    }

    // ── Bước 1: Chọn ứng viên & Tải Dossier ──
    async function selectCandidate(appId) {
        if (!appId || appId === selectedApplicationId) return;

        // Cập nhật class selected
        document.querySelectorAll('.cand-select-card').forEach(el => el.classList.remove('selected'));
        const targetCard = document.getElementById(`candCard-${appId}`);
        if (targetCard) targetCard.classList.add('selected');

        selectedApplicationId = appId;
        document.getElementById('formApplicationId').value = appId;

        // Gọi API nạp thông tin chi tiết ứng viên
        try {
            const res = await fetch(`/phong-van/api/candidate-dossier/${appId}`);
            const result = await res.json();
            if (result.success && result.data) {
                const d = result.data;
                selectedCandidateName = d.fullName;
                selectedJobTitle = d.jobTitle;
                selectedEmail = d.email;
                selectedRoundNumber = d.nextRoundNumber;
                selectedRoundTitle = d.suggestedRoundTitle;

                // Cập nhật DOM Dossier
                document.getElementById('dossierInitials').textContent = d.initialLetter || 'C';
                document.getElementById('dossierFullName').textContent = d.fullName;
                document.getElementById('dossierStageBadge').textContent = d.currentStageName;
                document.getElementById('dossierHeadline').textContent = `${d.currentTitle} tại ${d.currentCompany}`;
                document.getElementById('dossierEmail').textContent = d.email;
                document.getElementById('dossierPhone').textContent = d.phone || 'Chưa có SĐT';
                document.getElementById('dossierDepartment').textContent = d.departmentName;
                document.getElementById('dossierJobTitle').textContent = d.jobTitle;
                document.getElementById('dossierJobLevel').textContent = d.jobLevel;
                document.getElementById('dossierNextRoundDisplay').textContent = `Vòng ${d.nextRoundNumber}: ${d.suggestedRoundTitle}`;

                // Nút CV và Chi tiết
                const cvBtn = document.getElementById('dossierCvPreviewBtn');
                if (d.activeResumeId) {
                    cvBtn.href = `/Candidates/PreviewCv?resumeId=${d.activeResumeId}`;
                    cvBtn.classList.remove('disabled');
                } else {
                    cvBtn.href = 'javascript:void(0)';
                    cvBtn.classList.add('disabled');
                }
                document.getElementById('dossierCandidateDetailBtn').href = `/Candidates/Details/${d.candidateId}`;

                // Cập nhật Inputs Bước 2
                document.getElementById('formRoundNumber').value = d.nextRoundNumber;
                document.getElementById('inputRoundNumber').value = d.nextRoundNumber;
                document.getElementById('formRoundTitle').value = d.suggestedRoundTitle;
                document.getElementById('inputRoundTitle').value = d.suggestedRoundTitle;

                // Cập nhật Thư mời & Dashboard
                document.getElementById('emailSubjectInput').value = `📅 [Thư mời phỏng vấn] Vị trí ${d.jobTitle} — NoveraTech`;
                updateEmailLivePreview();
                updateSummaryDashboard();

                // Lịch sử
                renderDossierHistory(d.interviewHistory);
            }
        } catch (err) {
            console.error('Lỗi khi tải chi tiết hồ sơ ứng viên:', err);
        }
    }

    function renderDossierHistory(historyList) {
        const container = document.getElementById('dossierHistoryContainer');
        if (!container) return;

        if (!historyList || historyList.length === 0) {
            container.innerHTML = `
                <div class="text-center py-4 bg-light rounded-2 border text-muted">
                    <i class="bi bi-chat-square-dots text-secondary opacity-50 fs-3 mb-1 d-block"></i>
                    <span class="small">Ứng viên chưa tham gia vòng phỏng vấn nào trước đó. Buổi hẹn này sẽ là Vòng 1.</span>
                </div>`;
            return;
        }

        let html = '';
        historyList.forEach(h => {
            html += `
                <div class="p-3 mb-2 rounded-2 border bg-white" style="border-left: 4px solid #059669 !important;">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="fw-bold text-dark" style="font-size: 0.88rem;">${h.title}</span>
                        <span class="badge bg-light text-dark border">${h.statusDisplay}</span>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-3 text-muted small" style="font-size: 0.78rem;">
                        <span><i class="bi bi-calendar3 me-1"></i>${h.formattedTimeRange}</span>
                        <span><i class="bi bi-geo-alt me-1"></i>${h.interviewTypeDisplay}</span>
                        <span><i class="bi bi-people me-1"></i>Hội đồng: ${h.panelistsDisplay}</span>
                    </div>
                    ${h.averageScore ? `<span class="badge bg-primary text-white mt-2 me-2">Điểm TB: ${h.averageScore}/5.0</span>` : ''}
                    ${h.finalConclusion ? `<span class="badge bg-info text-dark mt-2">Kết luận: ${h.finalConclusion}</span>` : ''}
                </div>`;
        });
        container.innerHTML = html;
    }

    function filterCandidateList() {
        const query = document.getElementById('searchCandidateInput').value.toLowerCase().trim();
        const stage = document.getElementById('filterStageDropdown').value.toLowerCase().trim();
        const cards = document.querySelectorAll('.cand-select-card');
        let visibleCount = 0;

        cards.forEach(card => {
            const name = (card.getAttribute('data-name') || '').toLowerCase();
            const email = (card.getAttribute('data-email') || '').toLowerCase();
            const job = (card.getAttribute('data-job') || '').toLowerCase();
            const candStage = (card.getAttribute('data-stage') || '').toLowerCase();

            const matchQuery = !query || name.includes(query) || email.includes(query) || job.includes(query);
            const matchStage = !stage || candStage.includes(stage);

            if (matchQuery && matchStage) {
                card.style.display = '';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });

        document.getElementById('candCountBadge').textContent = `${visibleCount} hồ sơ`;
    }

