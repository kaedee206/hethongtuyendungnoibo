    // Smart Availability Check
    async function checkAllInterviewersAvailability() {
        const checkedPanelists = Array.from(document.querySelectorAll('.panelist-checkbox:checked')).map(el => el.value);
        if (checkedPanelists.length === 0) return;

        const startTimeVal = document.getElementById('inputStartTime').value;
        if (!startTimeVal) return;

        try {
            const url = `/phong-van/api/check-interviewer-busy?interviewerIds=${checkedPanelists.join(',')}&startTime=${encodeURIComponent(startTimeVal)}&durationMinutes=${selectedDurationMinutes}`;
            const res = await fetch(url);
            const json = await res.json();
            if (json.success && json.data) {
                json.data.forEach(item => {
                    const badge = document.getElementById(`availBadge-${item.interviewerId}`);
                    if (badge) {
                        if (item.isBusy) {
                            badge.style.background = '#FEF3C7';
                            badge.style.color = '#92400E';
                            badge.style.borderColor = '#FCD34D';
                            badge.innerHTML = `<i class="bi bi-exclamation-triangle-fill me-1"></i>Trùng: ${item.conflictTitle || 'Lịch khác'} (${item.conflictTimeDisplay || ''})`;
                        } else {
                            badge.style.background = '#ECFDF5';
                            badge.style.color = '#065F46';
                            badge.style.borderColor = '#A7F3D0';
                            badge.innerHTML = `<i class="bi bi-check2-circle me-1"></i>Sẵn sàng (Trống lịch)`;
                        }
                    }
                });
            }
        } catch (e) {
            console.warn('Lỗi khi kiểm tra lịch trống:', e);
        }
    }

    // ── Bước 3: Live Interactive Email Preview ──
