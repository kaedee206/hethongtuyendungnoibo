@model Ats.Web.Models.ViewModels.CandidateComparison.CandidateEvaluationComparisonViewModel
@{
    ViewData["Title"] = "So sánh ứng viên theo điểm đánh giá - SCRUM-336";
    Layout = "_Layout";
}

<div class="container-fluid px-3 px-md-4 py-4" style="max-width: 1440px;">
    <!-- Breadcrumb -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <a href="/dashboard/lich-phong-van" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1.5 hover-text-primary">
            <i class="bi bi-arrow-left"></i> Quay lại Lịch phỏng vấn
        </a>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-light text-muted border px-2.5 py-1" style="border-radius: 6px; font-size: 0.75rem;">
                <i class="bi bi-shield-lock-fill text-success me-1"></i> Quyền: Trưởng bộ phận &amp; Hội đồng đánh giá
            </span>
        </div>
    </div>

    <!-- Header Banner -->
    <div class="card border-0 shadow-sm mb-4 overflow-hidden" style="border-radius: 14px; background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%); color: #F8FAFC;">
        <div class="card-body p-4 p-md-4">
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge" style="background: rgba(16, 185, 129, 0.2); color: #6EE7B7; border: 1px solid rgba(16, 185, 129, 0.3); font-size: 0.72rem; letter-spacing: 0.05em; text-transform: uppercase;">
                            <i class="bi bi-clipboard-data-fill me-1"></i> SCRUM-336 · Scrum - Số 58
                        </span>
                        <span class="text-white-50 small">·</span>
                        <span class="text-white-50 small">Đánh giá tuyển dụng dựa trên dữ liệu &amp; tiêu chí</span>
                    </div>
                    <h2 class="fw-bold text-white mb-1" style="font-size: 1.45rem;">
                        Bảng So Sánh Ứng Viên Vòng Cuối Theo Điểm Đánh Giá
                    </h2>
                    <p class="text-white-50 mb-0 small" style="max-width: 820px; line-height: 1.55;">
                        Là <strong>Trưởng bộ phận</strong>, tính năng này giúp bạn so sánh trực quan điểm từng tiêu chí chuyên môn, kỹ năng mềm và văn hóa của các ứng viên cùng một vị trí. Lựa chọn nhân sự chuẩn xác dựa trên dữ liệu đánh giá thực tế từ hội đồng thay vì ấn tượng cảm tính.
                    </p>
                </div>
                <div class="d-flex gap-2 flex-wrap flex-shrink-0">
                    <button type="button" class="btn btn-outline-light d-inline-flex align-items-center gap-1.5" style="border-radius: 8px; font-size: 0.85rem;" onclick="window.print()" title="In bảng so sánh hoặc lưu PDF">
                        <i class="bi bi-printer-fill"></i> In báo cáo
                    </button>
                    <a href="/interviews/so-sanh-ung-vien" class="btn btn-success d-inline-flex align-items-center gap-1.5 shadow-sm" style="background: #059669; border-color: #059669; border-radius: 8px; font-size: 0.85rem;">
                        <i class="bi bi-arrow-clockwise"></i> Làm mới dữ liệu
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter & Position Selector Card -->
    <div class="card border-0 shadow-sm p-3.5 mb-4 bg-white" style="border: 1px solid #E2E8F0 !important; border-radius: 12px;">
        <form method="get" action="/interviews/so-sanh-ung-vien" id="filterForm">
            <div class="row g-3 align-items-center">
                <!-- Dropdown Chọn Vị trí tuyển dụng -->
                <div class="col-12 col-md-5 col-lg-4">
                    <label class="form-label small fw-bold text-dark mb-1 d-flex align-items-center justify-content-between">
                        <span><i class="bi bi-briefcase-fill text-success me-1"></i> Vị trí tuyển dụng cần so sánh</span>
                        <span class="badge bg-light text-muted border font-mono" style="font-size: 0.7rem;">@Model.AvailableJobs.Count vị trí</span>
                    </label>
                    <select class="form-select form-select-sm" name="jobId" id="jobSelect" style="border-radius: 8px; border-color: #CBD5E1; font-weight: 500;" onchange="this.form.submit()">
                        @if (Model.AvailableJobs.Count == 0)
                        {
                            <option value="">Không có vị trí nào</option>
                        }
                        else
                        {
                            @foreach (var job in Model.AvailableJobs)
                            {
                                <option value="@job.Id" selected="@(job.Id == Model.SelectedJobPostingId)">
                                    @job.DisplayText
                                </option>
                            }
                        }
                    </select>
                </div>

                <!-- Lọc Giai đoạn / Vòng phỏng vấn -->
                <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                    <label class="form-label small fw-bold text-dark mb-1">
                        <i class="bi bi-funnel-fill text-primary me-1"></i> Phạm vi vòng đánh giá
                    </label>
                    <select class="form-select form-select-sm" name="stage" id="stageSelect" style="border-radius: 8px; border-color: #CBD5E1;" onchange="this.form.submit()">
                        <option value="ALL" selected="@(Model.StageFilter == "ALL")">Tất cả ứng viên có điểm</option>
                        <option value="FINAL_ROUND" selected="@(Model.StageFilter == "FINAL_ROUND")">⭐ Chỉ ứng viên Vòng cuối / Offer</option>
                        <option value="3" selected="@(Model.StageFilter == "3")">Vòng Phỏng vấn (Stage 3)</option>
                        <option value="4" selected="@(Model.StageFilter == "4")">Đề xuất Offer (Stage 4)</option>
                        <option value="5" selected="@(Model.StageFilter == "5")">Đã tuyển dụng (Stage 5)</option>
                    </select>
                </div>

                <!-- Sắp xếp theo điểm tổng -->
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <label class="form-label small fw-bold text-dark mb-1">
                        <i class="bi bi-sort-numeric-down text-warning me-1"></i> Thứ tự sắp xếp
                    </label>
                    <select class="form-select form-select-sm" name="sortBy" id="sortSelect" style="border-radius: 8px; border-color: #CBD5E1;" onchange="this.form.submit()">
                        <option value="total_desc" selected="@(Model.SortBy == "total_desc")">🏆 Điểm tổng: Cao xuống Thấp (Mặc định)</option>
                        <option value="total_asc" selected="@(Model.SortBy == "total_asc")">Điểm tổng: Thấp lên Cao</option>
                        <option value="weighted_desc" selected="@(Model.SortBy == "weighted_desc")">Điểm trọng số chuẩn: Cao xuống Thấp</option>
                        <option value="name_asc" selected="@(Model.SortBy == "name_asc")">Tên ứng viên: A &rarr; Z</option>
                    </select>
                </div>

                <!-- Nút thao tác nhanh -->
                <div class="col-12 col-lg-2 d-flex align-items-end justify-content-end gap-2">
                    <a href="/interviews/so-sanh-ung-vien?jobId=@Model.SelectedJobPostingId" class="btn btn-sm btn-outline-secondary w-100" style="border-radius: 8px; font-size: 0.8rem;" title="Đặt lại bộ lọc về mặc định">
                        <i class="bi bi-arrow-counterclockwise"></i> Mặc định
                    </a>
                </div>
            </div>
        </form>

        <!-- Current Target Position Info Bar -->
        @if (Model.SelectedJobPostingId.HasValue && !string.IsNullOrWhiteSpace(Model.SelectedJobTitle))
        {
            <div class="d-flex flex-wrap align-items-center justify-content-between pt-3 mt-3 border-top gap-2" style="border-color: #F1F5F9 !important; font-size: 0.82rem;">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="text-muted">Đang xem so sánh vị trí:</span>
                    <span class="badge bg-dark text-white font-mono px-2 py-1">@Model.SelectedJobCode</span>
                    <strong class="text-dark">@Model.SelectedJobTitle</strong>
                    <span class="text-muted">·</span>
                    <span class="badge bg-light text-secondary border">Phòng ban: <b>@Model.DepartmentName</b></span>
                    <span class="badge bg-light text-secondary border">Cấp bậc: <b>@Model.TargetLevel</b></span>
                </div>
                <div class="d-flex align-items-center gap-1.5 text-muted small">
                    <i class="bi bi-info-circle text-primary"></i>
                    <span>Chỉ hiển thị các ứng viên đã nộp ít nhất 1 phiếu đánh giá phỏng vấn chính thức.</span>
                </div>
            </div>
        }
    </div>

    @if (Model.Candidates.Count > 0)
    {
        <!-- KPI Summary Cards -->
        <div class="row g-3 mb-4">
            <!-- Card 1: Tổng số ứng viên có điểm -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm p-3 bg-white h-100" style="border: 1px solid #E2E8F0 !important; border-radius: 12px;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="small fw-semibold text-muted">Ứng viên đã đánh giá</span>
                        <div class="d-flex align-items-center justify-content-center rounded-3" style="width: 36px; height: 36px; background: #ECFDF5; color: #059669;">
                            <i class="bi bi-people-fill fs-5"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-baseline gap-2">
                        <h3 class="fw-bold text-dark mb-0 font-mono" style="font-size: 1.8rem;">@Model.TotalCandidatesCount</h3>
                        <span class="small text-muted">hồ sơ hợp lệ</span>
                    </div>
                    <div class="small text-success mt-2 d-flex align-items-center gap-1">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>100% có phiếu nộp chính thức</span>
                    </div>
                </div>
            </div>

            <!-- Card 2: Điểm cao nhất -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm p-3 bg-white h-100" style="border: 1px solid #E2E8F0 !important; border-radius: 12px;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="small fw-semibold text-muted">Điểm cao nhất (Top Score)</span>
                        <div class="d-flex align-items-center justify-content-center rounded-3" style="width: 36px; height: 36px; background: #FEF3C7; color: #D97706;">
                            <i class="bi bi-trophy-fill fs-5"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-baseline gap-2">
                        <h3 class="fw-bold text-dark mb-0 font-mono" style="font-size: 1.8rem; color: #D97706 !important;">
                            @Model.HighestScore.ToString("0.0")
                        </h3>
                        <span class="small text-muted">/ 5.0 điểm</span>
                    </div>
                    <div class="small text-muted mt-2 text-truncate" title="@Model.TopCandidateName">
                        Ứng viên: <strong class="text-dark">@Model.TopCandidateName</strong>
                    </div>
                </div>
            </div>

            <!-- Card 3: Điểm trung bình vị trí -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm p-3 bg-white h-100" style="border: 1px solid #E2E8F0 !important; border-radius: 12px;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="small fw-semibold text-muted">Điểm trung bình vòng này</span>
                        <div class="d-flex align-items-center justify-content-center rounded-3" style="width: 36px; height: 36px; background: #EFF6FF; color: #2563EB;">
                            <i class="bi bi-graph-up-arrow fs-5"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-baseline gap-2">
                        <h3 class="fw-bold text-dark mb-0 font-mono" style="font-size: 1.8rem;">
                            @Model.AverageScore.ToString("0.0")
                        </h3>
                        <span class="small text-muted">/ 5.0 điểm</span>
                    </div>
                    <div class="small text-primary mt-2">
                        <i class="bi bi-sliders me-1"></i>Quy chuẩn thang 5 điểm NoveraTech
                    </div>
                </div>
            </div>

            <!-- Card 4: Tỷ lệ Đề xuất Nên tuyển -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm p-3 bg-white h-100" style="border: 1px solid #E2E8F0 !important; border-radius: 12px;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="small fw-semibold text-muted">Được khuyên "Nên tuyển"</span>
                        <div class="d-flex align-items-center justify-content-center rounded-3" style="width: 36px; height: 36px; background: #F0FDF4; color: #16A34A;">
                            <i class="bi bi-patch-check-fill fs-5"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-baseline gap-2">
                        <h3 class="fw-bold text-success mb-0 font-mono" style="font-size: 1.8rem;">
                            @Model.RecommendHireCount
                        </h3>
                        <span class="small text-muted">/ @Model.TotalCandidatesCount ứng viên</span>
                    </div>
                    <div class="small text-muted mt-2">
                        Tỷ lệ đạt chuẩn: <strong>@(Model.TotalCandidatesCount > 0 ? (Model.RecommendHireCount * 100 / Model.TotalCandidatesCount) : 0)%</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Comparison Matrix Table Card -->
        <div class="card border-0 shadow-sm bg-white mb-4 overflow-hidden" style="border: 1px solid #E2E8F0 !important; border-radius: 14px;">
            <div class="card-header bg-white border-bottom p-3.5 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2" style="border-color: #F1F5F9 !important;">
                <div>
                    <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-table text-success"></i>
                        <span>Ma Trận So Sánh Điểm Tiêu Chí</span>
                        <span class="badge bg-success-subtle text-success border border-success-subtle ms-1" style="font-size: 0.72rem;">Sắp xếp theo Điểm Tổng</span>
                    </h5>
                    <div class="text-muted small mt-0.5">
                        Điểm hiển thị là điểm trung bình từ các thành viên hội đồng phỏng vấn đã nộp phiếu.
                    </div>
                </div>
                <!-- Tiêu chuẩn màu sắc thang điểm (Legend) -->
                <div class="d-flex align-items-center gap-2 flex-wrap font-mono" style="font-size: 0.72rem;">
                    <span class="text-muted fw-bold">Thang điểm:</span>
                    <span class="badge" style="background:#059669; color:#FFF;">&ge; 4.5 Xuất sắc</span>
                    <span class="badge" style="background:#0284C7; color:#FFF;">3.5 - 4.4 Tốt</span>
                    <span class="badge" style="background:#D97706; color:#FFF;">2.5 - 3.4 Cân nhắc</span>
                    <span class="badge" style="background:#DC2626; color:#FFF;">&lt; 2.5 Không đạt</span>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="comparisonMatrixTable" style="min-width: 980px;">
                    <thead style="background: #F8FAFC; border-bottom: 2px solid #E2E8F0;">
                        <tr>
                            <!-- Cột Hạng & Ứng viên (Sticky bên trái) -->
                            <th scope="col" class="py-3 px-3 text-center" style="width: 60px; font-size: 0.78rem; text-transform: uppercase; color: #475569;">
                                Hạng
                            </th>
                            <th scope="col" class="py-3 px-3" style="min-width: 240px; font-size: 0.78rem; text-transform: uppercase; color: #475569;">
                                Ứng viên &amp; Vòng PV
                            </th>

                            <!-- Các Cột Tiêu Chí Đánh Giá (Dynamic Criteria Columns) -->
                            @foreach (var crit in Model.CriteriaHeaders)
                            {
                                <th scope="col" class="py-3 px-2 text-center" style="min-width: 140px; font-size: 0.75rem; text-transform: uppercase; color: #475569;" title="@crit.Description">
                                    <div class="d-flex flex-column align-items-center gap-1">
                                        <span class="badge @crit.TypeBadgeClass" style="font-size: 0.65rem; font-weight: 600;">
                                            @crit.TypeDisplayName
                                        </span>
                                        <div class="fw-bold text-dark text-truncate" style="max-width: 140px;" title="@crit.Name">
                                            @crit.Name
                                        </div>
                                        <span class="badge bg-light text-muted border font-mono" style="font-size: 0.68rem;" title="Trọng số tính điểm: x@crit.Weight">
                                            w = @crit.Weight
                                        </span>
                                    </div>
                                </th>
                            }

                            <!-- Cột Điểm Tổng (Overall Score) -->
                            <th scope="col" class="py-3 px-3 text-center" style="min-width: 130px; background: #F1F5F9; font-size: 0.8rem; text-transform: uppercase; color: #0F172A;">
                                <div class="d-flex flex-column align-items-center">
                                    <span class="fw-bold text-success">
                                        <i class="bi bi-star-fill text-warning me-1"></i> Điểm Tổng
                                    </span>
                                    <span class="text-muted" style="font-size: 0.68rem;">Thang 5.0</span>
                                </div>
                            </th>

                            <!-- Cột Kết Luận Hội Đồng -->
                            <th scope="col" class="py-3 px-3 text-center" style="min-width: 160px; font-size: 0.78rem; text-transform: uppercase; color: #475569;">
                                Đề Xuất Tuyển Dụng
                            </th>

                            <!-- Cột Điểm mạnh & Ghi chú -->
                            <th scope="col" class="py-3 px-3" style="min-width: 220px; font-size: 0.78rem; text-transform: uppercase; color: #475569;">
                                Nhận Xét Hội Đồng
                            </th>

                            <!-- Cột Thao tác -->
                            <th scope="col" class="py-3 px-3 text-end" style="width: 110px; font-size: 0.78rem; text-transform: uppercase; color: #475569;">
                                Thao tác
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cand in Model.Candidates)
                        {
                            var rankBadgeBg = cand.Rank == 1 ? "#FEF3C7" : (cand.Rank == 2 ? "#F1F5F9" : (cand.Rank == 3 ? "#FFF7ED" : "#FFFFFF"));
                            var rankColor = cand.Rank == 1 ? "#B45309" : (cand.Rank == 2 ? "#475569" : (cand.Rank == 3 ? "#C2410C" : "#64748B"));
                            var rankBorder = cand.Rank == 1 ? "#FDE68A" : (cand.Rank == 2 ? "#CBD5E1" : (cand.Rank == 3 ? "#FFEDD5" : "#E2E8F0"));
                            var rowBg = cand.IsTopCandidate ? "background: #F0FDF4;" : "";

                            <tr style="@rowBg transition: background .15s;">
                                <!-- Thứ hạng Rank -->
                                <td class="py-3 px-3 text-center">
                                    <div class="d-inline-flex align-items-center justify-content-center fw-bold rounded-circle font-mono"
                                         style="width: 32px; height: 32px; background: @rankBadgeBg; color: @rankColor; border: 1.5px solid @rankBorder; font-size: 0.85rem;"
                                         title="Thứ hạng @cand.Rank theo điểm tổng">
                                        @if (cand.Rank == 1)
                                        {
                                            <i class="bi bi-crown-fill text-warning me-0.5" style="font-size: 0.75rem;"></i>
                                        }
                                        @cand.Rank
                                    </div>
                                </td>

                                <!-- Thông tin Ứng viên & Buổi phỏng vấn -->
                                <td class="py-3 px-3">
                                    <div class="d-flex align-items-start gap-2.5">
                                        <div class="d-flex align-items-center justify-content-center fw-bold text-white rounded-circle flex-shrink-0"
                                             style="width: 38px; height: 38px; background: @(cand.IsTopCandidate ? "#059669" : "#0F172A"); font-size: 0.9rem;">
                                            @(string.IsNullOrEmpty(cand.CandidateName) ? "?" : cand.CandidateName[..1].ToUpper())
                                        </div>
                                        <div>
                                            <div class="d-flex align-items-center gap-1.5">
                                                <a href="/Candidates/Details/@cand.CandidateId" class="fw-bold text-dark text-decoration-none hover-text-primary" style="font-size: 0.92rem;">
                                                    @cand.CandidateName
                                                </a>
                                                @if (cand.IsTopCandidate)
                                                {
                                                    <span class="badge" style="background:#ECFDF5; color:#047857; border:1px solid #A7F3D0; font-size:0.68rem; font-weight:700;">
                                                        <i class="bi bi-trophy-fill me-1 text-warning"></i>DẪN ĐẦU
                                                    </span>
                                                }
                                            </div>
                                            <div class="text-muted" style="font-size: 0.76rem; font-family:'JetBrains Mono',monospace;">
                                                @cand.Email · @cand.Phone
                                            </div>
                                            <div class="d-flex align-items-center gap-2 mt-1" style="font-size: 0.75rem;">
                                                <span class="badge" style="background: @cand.StageColor; color: #FFF; font-size: 0.68rem;">
                                                    @cand.CurrentStageName
                                                </span>
                                                <span class="text-muted">· @cand.InterviewTitle (Vòng @cand.RoundNumber)</span>
                                                @if (!string.IsNullOrEmpty(cand.ResumeFilePath))
                                                {
                                                    <a href="@cand.ResumeFilePath" target="_blank" class="badge bg-light text-primary border text-decoration-none" title="Xem CV đính kèm">
                                                        <i class="bi bi-file-earmark-pdf"></i> CV
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Điểm chi tiết từng tiêu chí -->
                                @foreach (var crit in Model.CriteriaHeaders)
                                {
                                    var hasScore = cand.CriteriaScores.TryGetValue(crit.Id, out var score);
                                    var scoreDisplay = hasScore ? score.ToString("0.0") : "—";

                                    // Phân loại màu sắc điểm số
                                    string scoreBg = "#F1F5F9";
                                    string scoreColor = "#64748B";
                                    string scoreBorder = "#CBD5E1";

                                    if (hasScore)
                                    {
                                        if (score >= 4.5m)
                                        {
                                            scoreBg = "#ECFDF5"; scoreColor = "#047857"; scoreBorder = "#A7F3D0";
                                        }
                                        else if (score >= 3.5m)
                                        {
                                            scoreBg = "#F0F9FF"; scoreColor = "#0284C7"; scoreBorder = "#BAE6FD";
                                        }
                                        else if (score >= 2.5m)
                                        {
                                            scoreBg = "#FFFBEB"; scoreColor = "#B45309"; scoreBorder = "#FDE68A";
                                        }
                                        else
                                        {
                                            scoreBg = "#FEF2F2"; scoreColor = "#DC2626"; scoreBorder = "#FECACA";
                                        }
                                    }

                                    <td class="py-3 px-2 text-center">
                                        <div class="d-inline-flex flex-column align-items-center">
                                            <div class="badge font-mono px-2 py-1"
                                                 style="background: @scoreBg; color: @scoreColor; border: 1px solid @scoreBorder; font-size: 0.82rem; font-weight: 700; min-width: 44px;"
                                                 title="@crit.Name: @scoreDisplay/5.0 (Trọng số w = @crit.Weight)">
                                                @scoreDisplay
                                            </div>
                                            <!-- Mini progress bar trực quan -->
                                            @if (hasScore)
                                            {
                                                <div class="progress mt-1" style="height: 4px; width: 44px; background: #E2E8F0;">
                                                    <div class="progress-bar" role="progressbar"
                                                         style="width: @(score * 20)%; background: @scoreColor;"
                                                         aria-valuenow="@score" aria-valuemin="0" aria-valuemax="5"></div>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                }

                                <!-- Cột Điểm Tổng Kết -->
                                <td class="py-3 px-3 text-center" style="background: @(cand.IsTopCandidate ? "#ECFDF5" : "#F8FAFC");">
                                    <div class="d-inline-flex flex-column align-items-center">
                                        <span class="fw-bold font-mono" style="font-size: 1.15rem; color: @(cand.OverallScore >= 4.0m ? "#059669" : (cand.OverallScore >= 3.0m ? "#0284C7" : "#D97706"));">
                                            @cand.OverallScore.ToString("0.0")
                                        </span>
                                        <span class="text-muted" style="font-size: 0.68rem; font-family:'JetBrains Mono',monospace;">
                                            Trọng số: @cand.WeightedScore.ToString("0.00")
                                        </span>
                                        <div class="progress mt-1" style="height: 5px; width: 60px; background: #E2E8F0; border-radius: 4px;">
                                            <div class="progress-bar @(cand.OverallScore >= 4.0m ? "bg-success" : (cand.OverallScore >= 3.0m ? "bg-info" : "bg-warning"))"
                                                 role="progressbar" style="width: @(cand.OverallScore * 20)%;"></div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Kết luận Đề xuất Tuyển dụng -->
                                <td class="py-3 px-3 text-center">
                                    <span class="badge @cand.RecommendationBadgeClass py-1 px-2 text-wrap" style="border-radius: 6px; font-size: 0.75rem; max-width: 150px;">
                                        @cand.RecommendationDisplay
                                    </span>
                                    <div class="text-muted small mt-1 font-mono" style="font-size: 0.68rem;" title="Hội đồng: @cand.PanelistNames">
                                        <i class="bi bi-people me-1"></i>@cand.SubmittedEvaluationsCount phiếu đã nộp
                                    </div>
                                </td>

                                <!-- Nhận xét Điểm mạnh / Ghi chú -->
                                <td class="py-3 px-3">
                                    @if (!string.IsNullOrEmpty(cand.Strengths))
                                    {
                                        <div class="small text-dark mb-1" style="font-size: 0.76rem;">
                                            <strong class="text-success"><i class="bi bi-plus-circle me-1"></i>Điểm mạnh:</strong> @cand.Strengths
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(cand.Weaknesses))
                                    {
                                        <div class="small text-muted" style="font-size: 0.74rem;">
                                            <strong class="text-danger"><i class="bi bi-dash-circle me-1"></i>Cần cải thiện:</strong> @cand.Weaknesses
                                        </div>
                                    }
                                    @if (string.IsNullOrEmpty(cand.Strengths) && string.IsNullOrEmpty(cand.Weaknesses))
                                    {
                                        <span class="text-muted small fst-italic">@(cand.DetailedFeedback ?? "Chưa có nhận xét định tính.")</span>
                                    }
                                </td>

                                <!-- Thao tác Action Buttons -->
                                <td class="py-3 px-3 text-end">
                                    <div class="d-flex align-items-center justify-content-end gap-1.5">
                                        @if (cand.LastInterviewId.HasValue)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center"
                                                    style="border-radius: 6px; font-size: 0.75rem; padding: 0.25rem 0.5rem;"
                                                    onclick="openInterviewEvaluationModal('@cand.LastInterviewId.Value')"
                                                    title="Xem chi tiết phiếu đánh giá phỏng vấn của hội đồng">
                                                <i class="bi bi-card-checklist me-1"></i> Phiếu
                                            </button>
                                        }
                                        <a href="/Candidates/Details/@cand.CandidateId" class="btn btn-sm btn-outline-secondary"
                                           style="border-radius: 6px; font-size: 0.75rem; padding: 0.25rem 0.5rem;" title="Xem toàn bộ hồ sơ chi tiết">
                                            <i class="bi bi-arrow-right"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-white border-top p-3 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2" style="border-color: #F1F5F9 !important;">
                <div class="small text-muted">
                    Hiển thị <strong>@Model.Candidates.Count</strong> ứng viên của vị trí <strong>@Model.SelectedJobTitle</strong>.
                </div>
                <div class="small text-muted d-flex align-items-center gap-3">
                    <span><i class="bi bi-check-all text-success me-1"></i>Đã đối chiếu tiêu chí chuẩn hóa</span>
                    <span><i class="bi bi-shield-check text-primary me-1"></i>Quy tắc Blind Review &amp; Khóa phiếu</span>
                </div>
            </div>
        </div>

        <!-- Visual Comparison: Top Candidates Bar Comparison -->
        <div class="card border-0 shadow-sm p-4 bg-white mb-4" style="border: 1px solid #E2E8F0 !important; border-radius: 14px;">
            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom" style="border-color: #F1F5F9 !important;">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-bar-chart-fill text-success fs-5"></i>
                    <div>
                        <h6 class="fw-bold text-dark mb-0">Biểu Đồ So Sánh Trực Quan Điểm Tiêu Chí (Top Ứng Viên)</h6>
                        <span class="text-muted small">So sánh trực quan điểm số trên thang 5.0 giữa các ứng viên dẫn đầu để đưa ra quyết định tuyển dụng.</span>
                    </div>
                </div>
                <span class="badge bg-light text-muted border font-mono">Thang điểm 1 - 5</span>
            </div>

            <div class="row g-4 pt-2">
                @foreach (var topCand in Model.Candidates.Take(3))
                {
                    <div class="col-12 col-md-4">
                        <div class="p-3.5 h-100" style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 10px;">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge @(topCand.Rank == 1 ? "bg-warning text-dark" : "bg-secondary text-white") rounded-pill font-mono px-2">
                                        #@topCand.Rank
                                    </span>
                                    <strong class="text-dark">@topCand.CandidateName</strong>
                                </div>
                                <span class="fw-bold font-mono" style="font-size: 1.1rem; color: #059669;">
                                    @topCand.OverallScore.ToString("0.0") / 5.0
                                </span>
                            </div>

                            <!-- Criteria Bars -->
                            <div class="d-flex flex-column gap-2.5">
                                @foreach (var crit in Model.CriteriaHeaders)
                                {
                                    topCand.CriteriaScores.TryGetValue(crit.Id, out var sVal);
                                    var percent = sVal * 20;
                                    var barColor = sVal >= 4.0m ? "#059669" : (sVal >= 3.0m ? "#0284C7" : "#D97706");

                                    <div>
                                        <div class="d-flex justify-content-between small text-muted mb-1" style="font-size: 0.75rem;">
                                            <span class="text-truncate" style="max-width: 180px;" title="@crit.Name">@crit.Name</span>
                                            <strong class="font-mono text-dark">@sVal.ToString("0.0")</strong>
                                        </div>
                                        <div class="progress" style="height: 6px; background: #E2E8F0; border-radius: 3px;">
                                            <div class="progress-bar" role="progressbar" style="width: @percent%; background: @barColor;" aria-valuenow="@sVal" aria-valuemin="0" aria-valuemax="5"></div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="mt-3 pt-2.5 border-top d-flex align-items-center justify-content-between small" style="border-color: #E2E8F0 !important;">
                                <span class="text-muted">Đề xuất:</span>
                                <span class="badge @topCand.RecommendationBadgeClass" style="font-size: 0.72rem;">@topCand.RecommendationDisplay</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <!-- Empty State: Chưa có ứng viên nào có phiếu đánh giá đã nộp -->
        <div class="card border-0 shadow-sm p-5 bg-white text-center mb-4" style="border: 1px solid #E2E8F0 !important; border-radius: 14px;">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mx-auto mb-3" style="width: 72px; height: 72px; background: #F8FAFC; border: 2px dashed #CBD5E1; color: #94A3B8;">
                <i class="bi bi-clipboard2-data" style="font-size: 2rem;"></i>
            </div>
            <h5 class="fw-bold text-dark mb-1">Chưa có ứng viên nào có phiếu đánh giá đã nộp</h5>
            <p class="text-muted small mx-auto mb-4" style="max-width: 540px; line-height: 1.6;">
                Theo quy chuẩn của <strong>SCRUM-336</strong>, bảng so sánh chỉ hiển thị các ứng viên đã được hội đồng phỏng vấn nộp phiếu đánh giá chính thức (<code>IsSubmitted == true</code>). Vị trí <strong>@Model.SelectedJobTitle</strong> hiện chưa có hồ sơ nào thỏa mãn điều kiện này.
            </p>
            <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap">
                <a href="/dashboard/lich-phong-van" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1.5 shadow-sm" style="background: #0284C7; border-color: #0284C7; border-radius: 8px; font-size: 0.82rem;">
                    <i class="bi bi-calendar-check-fill"></i> Xem lịch phỏng vấn &amp; nộp phiếu
                </a>
                <a href="/dashboard/ung-vien" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1.5" style="border-radius: 8px; font-size: 0.82rem;">
                    <i class="bi bi-people"></i> Quản lý hồ sơ ứng viên
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Hàm mở Modal xem chi tiết phiếu đánh giá phỏng vấn
        function openInterviewEvaluationModal(interviewId) {
            if (!interviewId) return;

            // Nếu trang chủ hoặc layout đã có sẵn modal interviewEvaluationModal
            const modalEl = document.getElementById('interviewEvaluationModal');
            if (modalEl && typeof loadInterviewEvaluationData === 'function') {
                const modal = new bootstrap.Modal(modalEl);
                modal.show();
                loadInterviewEvaluationData(interviewId);
            } else {
                // Điều hướng trực tiếp đến trang xem chi tiết
                window.location.href = '/phong-van/' + interviewId + '/phieu-danh-gia';
            }
        }
    </script>
}
