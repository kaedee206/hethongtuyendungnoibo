@model Ats.Web.Models.ViewModels.CandidateComparison.CandidateEvaluationComparisonViewModel
@using System.Globalization
@{
    ViewData["Title"] = $"So sánh ứng viên - {Model.SelectedJobTitle}";
    Layout = "_Layout";
}

<div class="container-fluid px-3 px-md-4 py-4" style="max-width: 1480px;">
    <!-- Breadcrumb điều hướng -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <a href="/dashboard/lich-phong-van" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1.5 hover-text-primary">
            <i class="bi bi-arrow-left"></i> Quay lại Lịch phỏng vấn
        </a>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-white text-dark border px-2.5 py-1 shadow-2xs font-mono" style="border-radius: 6px; font-size: 0.75rem;">
                <i class="bi bi-shield-check text-success me-1"></i> Kiểm chứng dữ liệu độc lập · Nguyên tắc: So sánh trước, kết luận sau
            </span>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- HEADER: So sánh ứng viên - {JobTitle}                                    -->
    <!-- Vòng: Final Interview | Số ứng viên: 4 | Đã có đánh giá: 4/4              -->
    <!-- ========================================================================= -->
    <div class="card border-0 shadow-sm mb-4 overflow-hidden" style="border-radius: 12px; background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%); color: #F8FAFC;">
        <div class="card-body p-4">
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                        <span class="badge bg-success-subtle text-success border border-success-subtle font-mono text-uppercase px-2.5 py-1" style="font-size: 0.72rem; letter-spacing: 0.05em;">
                            <i class="bi bi-clipboard2-data me-1"></i> Bảng đối chiếu năng lực
                        </span>
                        <span class="text-white-50 small">·</span>
                        <span class="text-white-50 small">Vị trí: <b>@Model.SelectedJobCode</b></span>
                        <span class="text-white-50 small">·</span>
                        <span class="text-white-50 small">Phòng ban: <b>@Model.DepartmentName</b></span>
                    </div>

                    <h1 class="fw-bold text-white mb-2" style="font-size: 1.5rem; letter-spacing: -0.01em;">
                        So sánh ứng viên - @Model.SelectedJobTitle
                    </h1>

                    <!-- Thông số Header theo wireframe -->
                    <div class="d-flex flex-wrap align-items-center gap-2 gap-md-4 text-white-50 small pt-1 font-mono">
                        <div class="d-flex align-items-center gap-1.5">
                            <i class="bi bi-diagram-3-fill text-info"></i>
                            <span>Vòng:</span>
                            <strong class="text-white">@(string.IsNullOrWhiteSpace(Model.RoundName) ? "Final Interview" : Model.RoundName)</strong>
                        </div>
                        <span class="text-white-50 d-none d-sm-inline">|</span>
                        <div class="d-flex align-items-center gap-1.5">
                            <i class="bi bi-people-fill text-primary"></i>
                            <span>Số ứng viên:</span>
                            <strong class="text-white">@(Model.TotalCandidatesInJob > 0 ? Model.TotalCandidatesInJob : Model.Candidates.Count)</strong>
                        </div>
                        <span class="text-white-50 d-none d-sm-inline">|</span>
                        <div class="d-flex align-items-center gap-1.5">
                            <i class="bi bi-check-circle-fill text-success"></i>
                            <span>Đã có đánh giá:</span>
                            <span class="badge bg-success text-white font-mono px-2 py-0.5">@Model.EvaluationRatioDisplay</span>
                        </div>
                    </div>
                </div>

                <!-- Các nút hành động thao tác -->
                <div class="d-flex gap-2 flex-wrap flex-shrink-0">
                    <button type="button" class="btn btn-outline-light btn-sm d-inline-flex align-items-center gap-1.5" style="border-radius: 8px; padding: 0.5rem 0.85rem;" onclick="window.print()" title="In bảng so sánh hoặc xuất PDF">
                        <i class="bi bi-printer-fill"></i> In dữ liệu
                    </button>
                    <a href="/interviews/so-sanh-ung-vien?jobId=@Model.SelectedJobPostingId" class="btn btn-light btn-sm d-inline-flex align-items-center gap-1.5 shadow-sm" style="border-radius: 8px; padding: 0.5rem 0.85rem;" title="Làm mới bảng đối chiếu">
                        <i class="bi bi-arrow-clockwise"></i> Làm mới
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- KHU VỰC 5 - BỘ LỌC (Filter Bar)                                           -->
    <!-- [Vị trí] [Vòng đánh giá] [Chỉ hiện ứng viên đạt ngưỡng] [Sắp xếp]         -->
    <!-- ========================================================================= -->
    <div class="card border-0 shadow-sm p-3 mb-4 bg-white" style="border: 1px solid #E2E8F0 !important; border-radius: 12px;">
        <form method="get" action="/interviews/so-sanh-ung-vien" id="filterForm">
            <div class="row g-3 align-items-end">
                <!-- Dropdown Chọn Vị trí -->
                <div class="col-12 col-md-4 col-lg-4">
                    <label class="form-label small fw-bold text-dark mb-1">
                        <i class="bi bi-briefcase-fill text-success me-1"></i> Vị trí tuyển dụng
                    </label>
                    <select class="form-select form-select-sm" name="jobId" id="jobSelect" style="border-radius: 8px; border-color: #CBD5E1; font-weight: 500;" onchange="this.form.submit()">
                        @if (Model.AvailableJobs.Count == 0)
                        {
                            <option value="">Không có vị trí nào</option>
                        }
                        else
                        {
                            @foreach (var job in Model.AvailableJobs)
                            {
                                <option value="@job.Id" selected="@(job.Id == Model.SelectedJobPostingId)">
                                    @job.DisplayText
                                </option>
                            }
                        }
                    </select>
                </div>

                <!-- Lọc Vòng đánh giá -->
                <div class="col-12 col-sm-6 col-md-3 col-lg-2">
                    <label class="form-label small fw-bold text-dark mb-1">
                        <i class="bi bi-funnel-fill text-primary me-1"></i> Vòng đánh giá
                    </label>
                    <select class="form-select form-select-sm" name="stage" id="stageSelect" style="border-radius: 8px; border-color: #CBD5E1;" onchange="this.form.submit()">
                        <option value="ALL" selected="@(Model.StageFilter == "ALL")">Tất cả các vòng</option>
                        <option value="FINAL_ROUND" selected="@(Model.StageFilter == "FINAL_ROUND")">Final Interview</option>
                        <option value="3" selected="@(Model.StageFilter == "3")">Vòng Chuyên môn</option>
                        <option value="4" selected="@(Model.StageFilter == "4")">Đề xuất Offer</option>
                    </select>
                </div>

                <!-- Sắp xếp -->
                <div class="col-12 col-sm-6 col-md-3 col-lg-2">
                    <label class="form-label small fw-bold text-dark mb-1">
                        <i class="bi bi-sort-numeric-down text-warning me-1"></i> Sắp xếp
                    </label>
                    <select class="form-select form-select-sm" name="sortBy" id="sortSelect" style="border-radius: 8px; border-color: #CBD5E1;" onchange="this.form.submit()">
                        <option value="total_desc" selected="@(Model.SortBy == "total_desc")">Điểm tổng giảm dần</option>
                        <option value="name_asc" selected="@(Model.SortBy == "name_asc")">Tên ứng viên (A-Z)</option>
                        <option value="latest" selected="@(Model.SortBy == "latest")">Đánh giá mới nhất</option>
                        <option value="total_asc" selected="@(Model.SortBy == "total_asc")">Điểm tổng tăng dần</option>
                    </select>
                </div>

                <!-- Checkbox Chỉ hiện ứng viên đạt ngưỡng -->
                <div class="col-12 col-md-8 col-lg-3">
                    <div class="p-2 border rounded-3 bg-light d-flex align-items-center justify-content-between" style="border-color: #E2E8F0 !important;">
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" name="thresholdOnly" id="thresholdOnlyCheck" value="true" @(Model.ThresholdOnly ? "checked" : "") onchange="this.form.submit()" style="cursor: pointer;">
                            <label class="form-check-label small fw-semibold text-dark" for="thresholdOnlyCheck" style="cursor: pointer;">
                                Chỉ hiện đạt ngưỡng
                            </label>
                        </div>
                        <div class="d-flex align-items-center gap-1 font-mono small">
                            <span class="text-muted">&ge;</span>
                            <input type="number" step="0.1" min="1.0" max="5.0" name="minScore" value="@Model.MinThreshold.ToString("0.0", CultureInfo.InvariantCulture)"
                                   class="form-control form-control-sm text-center px-1 py-0" style="width: 52px; height: 26px; font-size: 0.78rem; font-weight: 700;"
                                   onchange="this.form.submit()" title="Ngưỡng điểm tối thiểu">
                        </div>
                    </div>
                </div>

                <!-- Nút đặt lại -->
                <div class="col-12 col-lg-1 d-flex align-items-end justify-content-end">
                    <a href="/interviews/so-sanh-ung-vien?jobId=@Model.SelectedJobPostingId" class="btn btn-sm btn-outline-secondary w-100" style="border-radius: 8px; font-size: 0.8rem;" title="Đặt lại bộ lọc mặc định">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>

    @if (Model.Candidates.Count > 0)
    {
        <!-- ========================================================================= -->
        <!-- KHU VỰC 1 - BẢNG SO SÁNH MA TRẬN (Thành phần chính - chiếm ~70% màn hình)  -->
        <!-- Hàng = TIÊU CHÍ (.NET, SQL, Architecture...) | Cột = Ứng viên             -->
        <!-- Hàng cuối = ĐIỂM TỔNG                                                     -->
        <!-- UX Rule:                                                                  -->
        <!-- Điểm cao nhất mỗi hàng tô xanh (bg-success-subtle text-success)           -->
        <!-- Điểm thấp nhất mỗi hàng tô đỏ nhạt (bg-danger-subtle text-danger)         -->
        <!-- Hover hiện: Số người đánh giá, Điểm trung bình, Độ lệch                   -->
        <!-- ========================================================================= -->
        <div class="card border-0 shadow-sm bg-white mb-4 overflow-hidden" style="border: 1px solid #E2E8F0 !important; border-radius: 14px;">
            <div class="card-header bg-white border-bottom p-3.5 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2" style="border-color: #F1F5F9 !important;">
                <div>
                    <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-grid-3x3-gap-fill text-primary"></i>
                        <span>Bảng So Sánh Tiêu Chí &amp; Điểm Đánh Giá</span>
                        <span class="badge bg-light text-muted border font-mono ms-1" style="font-size: 0.72rem;">@Model.Candidates.Count ứng viên</span>
                    </h5>
                    <div class="text-muted small mt-0.5">
                        Dữ liệu đối chiếu điểm số khách quan. Rê chuột vào từng ô điểm để xem số lượng giám khảo và độ lệch chấm điểm.
                    </div>
                </div>

                <!-- Chú thích màu sắc theo UX Rule -->
                <div class="d-flex align-items-center gap-2 flex-wrap font-mono small" style="font-size: 0.75rem;">
                    <span class="text-muted fw-bold">Quy ước ma trận:</span>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                        <i class="bi bi-check-circle-fill me-1"></i> Điểm cao nhất hàng
                    </span>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                        <i class="bi bi-arrow-down-circle-fill me-1"></i> Điểm thấp nhất hàng
                    </span>
                </div>
            </div>

            <div class="table-responsive" style="max-height: 68vh; overflow-y: auto;">
                <table class="table table-bordered table-hover align-middle mb-0 text-center" id="transposedComparisonMatrix" style="min-width: 800px; border-color: #E2E8F0;">
                    <!-- HEADER BẢNG: Cột 1 = TIÊU CHÍ, các cột sau là TÊN ỨNG VIÊN -->
                    <thead class="sticky-top bg-light" style="z-index: 10; border-bottom: 2px solid #CBD5E1;">
                        <tr>
                            <!-- Cột TIÊU CHÍ (Sticky bên trái) -->
                            <th scope="col" class="py-3 px-3 text-start bg-light" style="width: 240px; min-width: 220px; font-size: 0.82rem; text-transform: uppercase; color: #334155; letter-spacing: 0.03em;">
                                <div class="d-flex align-items-center justify-content-between">
                                    <span class="fw-bold"><i class="bi bi-list-check me-1.5 text-primary"></i> Tiêu Chí Đánh Giá</span>
                                    <span class="badge bg-white text-muted border font-mono" style="font-size: 0.68rem;">@Model.CriteriaHeaders.Count tiêu chí</span>
                                </div>
                            </th>

                            <!-- CÁC CỘT ỨNG VIÊN (Sắp xếp theo thứ hạng) -->
                            @foreach (var cand in Model.Candidates)
                            {
                                var isLeader = cand.Rank == 1;
                                var headerBg = isLeader ? "#F0FDF4" : "#F8FAFC";
                                var nameColor = isLeader ? "#047857" : "#0F172A";

                                <th scope="col" class="py-3 px-2 text-center" style="min-width: 140px; background: @headerBg;">
                                    <div class="d-flex flex-column align-items-center gap-1">
                                        <div class="d-flex align-items-center gap-1.5">
                                            <span class="badge font-mono @(isLeader ? "bg-success text-white" : "bg-secondary text-white")" style="font-size: 0.68rem; padding: 0.2rem 0.45rem; border-radius: 9999px;">
                                                #@cand.Rank
                                            </span>
                                            <a href="/Candidates/Details/@cand.CandidateId" class="fw-bold text-decoration-none hover-text-primary" style="color: @nameColor; font-size: 0.95rem;">
                                                @cand.CandidateName
                                            </a>
                                        </div>
                                        <div class="text-muted" style="font-size: 0.7rem; font-family: 'JetBrains Mono', monospace;">
                                            @cand.SubmittedEvaluationsCount phiếu đánh giá
                                        </div>
                                    </div>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        <!-- CÁC HÀNG TIÊU CHÍ (.NET, SQL, Architecture, Problem Solving, Communication...) -->
                        @foreach (var row in Model.TransposedMatrix)
                        {
                            <tr>
                                <!-- Cột Tên Tiêu Chí (Rút gọn <= 4 từ theo UX Rule) -->
                                <td class="py-3 px-3 text-start bg-white" style="font-size: 0.88rem;">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div>
                                            <span class="fw-bold text-dark">@row.DisplayTitle</span>
                                            @if (!string.IsNullOrWhiteSpace(row.CriteriaName) && row.CriteriaName != row.DisplayTitle)
                                            {
                                                <div class="text-muted" style="font-size: 0.72rem;" title="@row.CriteriaName">
                                                    @row.CriteriaName
                                                </div>
                                            }
                                        </div>
                                        <span class="badge bg-light text-muted border font-mono ms-1" style="font-size: 0.65rem;" title="Trọng số: x@row.Weight">
                                            w = @row.Weight
                                        </span>
                                    </div>
                                </td>

                                <!-- Các ô điểm số của từng ứng viên cho tiêu chí này -->
                                @foreach (var cand in Model.Candidates)
                                {
                                    row.ScoresByCandidateId.TryGetValue(cand.CandidateId, out var cell);
                                    var cellScore = cell?.Score ?? cand.OverallScore;
                                    var cellAvg = cell?.AverageScore ?? cellScore;
                                    var evalCount = cell?.EvaluatorCount ?? cand.SubmittedEvaluationsCount;
                                    var spread = cell?.ScoreSpread ?? 0.0m;
                                    var minS = cell?.MinScore ?? cellScore;
                                    var maxS = cell?.MaxScore ?? cellScore;

                                    var isHighest = cell?.IsHighestInRow ?? false;
                                    var isLowest = cell?.IsLowestInRow ?? false;

                                    // UX Rule:
                                    // Điểm cao nhất mỗi hàng tô xanh
                                    // Điểm thấp nhất mỗi hàng tô đỏ nhạt
                                    string cellBg = "bg-white";
                                    string badgeClass = "bg-light text-dark border";

                                    if (isHighest)
                                    {
                                        cellBg = "bg-success-subtle";
                                        badgeClass = "bg-success text-white shadow-xs fw-bold";
                                    }
                                    else if (isLowest)
                                    {
                                        cellBg = "bg-danger-subtle";
                                        badgeClass = "bg-danger-subtle text-danger border border-danger-subtle fw-semibold";
                                    }
                                    else
                                    {
                                        badgeClass = "bg-light text-dark border font-mono fw-semibold";
                                    }

                                    // Nội dung tooltip khi hover: Số người đánh giá, Điểm trung bình, Độ lệch
                                    var tooltipContent = $"<b>{cand.CandidateName} - {row.DisplayTitle}</b><br/>" +
                                                         $"• Số người đánh giá: <b>{evalCount} giám khảo</b><br/>" +
                                                         $"• Điểm trung bình: <b>{cellAvg.ToString("0.0", CultureInfo.InvariantCulture)} / 5.0</b><br/>" +
                                                         $"• Độ lệch: <b>{spread.ToString("0.0", CultureInfo.InvariantCulture)}</b> (Min: {minS:0.0} - Max: {maxS:0.0})";

                                    <td class="py-3 px-2 text-center @cellBg position-relative" style="transition: background .15s;">
                                        <div class="d-inline-flex flex-column align-items-center cursor-pointer"
                                             data-bs-toggle="tooltip"
                                             data-bs-html="true"
                                             data-bs-placement="top"
                                             title="@tooltipContent">
                                            <span class="badge font-mono px-2.5 py-1.5 fs-6 @badgeClass" style="min-width: 48px; font-size: 0.95rem !important;">
                                                @cellScore.ToString("0.0", CultureInfo.InvariantCulture)
                                            </span>
                                            <div class="progress mt-1.5" style="height: 3px; width: 48px; background: #E2E8F0;">
                                                <div class="progress-bar @(isHighest ? "bg-success" : (isLowest ? "bg-danger" : "bg-primary"))"
                                                     role="progressbar"
                                                     style="width: @(cellScore * 20)%;"
                                                     aria-valuenow="@cellScore" aria-valuemin="0" aria-valuemax="5"></div>
                                            </div>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }

                        <!-- ========================================================================= -->
                        <!-- HÀNG CUỐI CÙNG: ĐIỂM TỔNG (Overall Score của từng ứng viên)                -->
                        <!-- ========================================================================= -->
                        <tr class="table-secondary fw-bold" style="border-top: 2.5px solid #CBD5E1; background: #F1F5F9;">
                            <td class="py-3 px-3 text-start bg-secondary-subtle">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-trophy-fill text-warning fs-5"></i>
                                    <div>
                                        <div class="text-uppercase fw-bolder text-dark" style="letter-spacing: 0.05em; font-size: 0.92rem;">
                                            ĐIỂM TỔNG
                                        </div>
                                        <div class="text-muted fw-normal" style="font-size: 0.7rem;">
                                            Thang điểm 5.0 chuẩn hóa
                                        </div>
                                    </div>
                                </div>
                            </td>

                            @foreach (var cand in Model.Candidates)
                            {
                                var isHighestTotal = cand.Rank == 1;
                                var isLowestTotal = cand.OverallScore == Model.LowestScore && Model.Candidates.Count > 1;

                                string totalCellBg = "bg-white";
                                string totalBadgeClass = "bg-light text-dark border";

                                if (isHighestTotal)
                                {
                                    totalCellBg = "bg-success-subtle";
                                    totalBadgeClass = "bg-success text-white shadow-xs fw-bold";
                                }
                                else if (isLowestTotal)
                                {
                                    totalCellBg = "bg-danger-subtle";
                                    totalBadgeClass = "bg-danger-subtle text-danger border border-danger-subtle fw-semibold";
                                }
                                else
                                {
                                    totalBadgeClass = "bg-white text-dark border font-mono fw-bold";
                                }

                                var totalTooltip = $"<b>Điểm tổng: {cand.CandidateName}</b><br/>" +
                                                   $"• Thứ hạng: <b>#{cand.Rank}</b><br/>" +
                                                   $"• Điểm trung bình: <b>{cand.OverallScore.ToString("0.00", CultureInfo.InvariantCulture)} / 5.0</b><br/>" +
                                                   $"• Phiếu đánh giá: <b>{cand.SubmittedEvaluationsCount} phiếu</b>";

                                <td class="py-3 px-2 text-center @totalCellBg"
                                    data-bs-toggle="tooltip"
                                    data-bs-html="true"
                                    data-bs-placement="bottom"
                                    title="@totalTooltip">
                                    <div class="d-inline-flex flex-column align-items-center">
                                        <span class="badge font-mono px-3 py-2 fs-5 @totalBadgeClass" style="min-width: 60px; font-size: 1.15rem !important;">
                                            @cand.OverallScore.ToString("0.00", CultureInfo.InvariantCulture)
                                        </span>
                                        <span class="badge bg-white text-muted border font-mono mt-1" style="font-size: 0.65rem;">
                                            Hạng #@cand.Rank
                                        </span>
                                    </div>
                                </td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-white border-top p-3 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2" style="border-color: #F1F5F9 !important;">
                <div class="small text-muted font-mono">
                    <i class="bi bi-info-circle text-primary me-1"></i>
                    Bảng so sánh chuyển vị: điểm cao nhất mỗi hàng tô xanh, điểm thấp nhất mỗi hàng tô đỏ nhạt.
                </div>
                <div class="small text-muted font-mono">
                    Tổng số: <strong>@Model.Candidates.Count</strong> ứng viên có phiếu đánh giá
                </div>
            </div>
        </div>

        <!-- ========================================================================= -->
        <!-- HÀNG 2 CỘT: KHU VỰC 2 (XẾP HẠNG) VÀ KHU VỰC 3 (CHÊNH LỆCH ỨNG VIÊN)       -->
        <!-- ========================================================================= -->
        <div class="row g-4 mb-4">
            <!-- ===================================================================== -->
            <!-- KHU VỰC 2 - XẾP HẠNG (Rankings)                                       -->
            <!-- #1 Hải ━━━━━━━━━━━━ 4.54                                              -->
            <!-- #2 Nam ━━━━━━━━━━ 4.40                                                -->
            <!-- ===================================================================== -->
            <div class="col-12 col-lg-5">
                <div class="card border-0 shadow-sm h-100 bg-white" style="border: 1px solid #E2E8F0 !important; border-radius: 14px;">
                    <div class="card-header bg-white border-bottom p-3.5" style="border-color: #F1F5F9 !important;">
                        <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-trophy text-warning"></i>
                            <span>Xếp Hạng Ứng Viên</span>
                        </h5>
                        <div class="text-muted small mt-0.5">
                            Sắp xếp tự động theo điểm tổng đánh giá từ cao xuống thấp.
                        </div>
                    </div>
                    <div class="card-body p-3.5">
                        <div class="d-flex flex-column gap-3">
                            @foreach (var rank in Model.Rankings)
                            {
                                var isLeader = rank.IsLeader;
                                var barColor = isLeader ? "#059669" : (rank.Rank == 2 ? "#0284C7" : (rank.Rank == 3 ? "#D97706" : "#64748B"));
                                var bgItem = isLeader ? "background: #F0FDF4; border: 1.5px solid #A7F3D0;" : "background: #F8FAFC; border: 1px solid #E2E8F0;";

                                <div class="p-3 rounded-3" style="@bgItem">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge font-mono @(isLeader ? "bg-success text-white" : "bg-secondary text-white")" style="font-size: 0.75rem; border-radius: 6px; width: 32px; text-align: center;">
                                                #@rank.Rank
                                            </span>
                                            <a href="/Candidates/Details/@rank.CandidateId" class="fw-bold text-dark text-decoration-none hover-text-primary" style="font-size: 0.95rem;">
                                                @rank.CandidateName
                                            </a>
                                            @if (isLeader)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle font-mono" style="font-size: 0.68rem;">
                                                    Dẫn đầu
                                                </span>
                                            }
                                        </div>
                                        <div class="font-mono fw-bold" style="font-size: 1.05rem; color: @barColor;">
                                            @rank.OverallScoreDisplay
                                        </div>
                                    </div>

                                    <!-- Thanh bar độ dài biểu diễn điểm số -->
                                    <div class="progress" style="height: 8px; background: #E2E8F0; border-radius: 9999px;">
                                        <div class="progress-bar progress-bar-striped @(isLeader ? "progress-bar-animated" : "")"
                                             role="progressbar"
                                             style="width: @rank.ScorePercent%; background-color: @barColor; border-radius: 9999px;"
                                             aria-valuenow="@rank.OverallScore" aria-valuemin="0" aria-valuemax="5"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- ===================================================================== -->
            <!-- KHU VỰC 3 - CHÊNH LỆCH ỨNG VIÊN (Delta Analysis)                       -->
            <!-- "Tại sao Hải đang đứng đầu?"                                          -->
            <!-- So với Nam: + SQL +0.3 | + Communication +0.2 | - Problem Solving -0.2 -->
            <!-- ===================================================================== -->
            <div class="col-12 col-lg-7">
                <div class="card border-0 shadow-sm h-100 bg-white" style="border: 1px solid #E2E8F0 !important; border-radius: 14px;">
                    <div class="card-header bg-white border-bottom p-3.5" style="border-color: #F1F5F9 !important;">
                        <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-graph-up-arrow text-success"></i>
                            <span>Chênh Lệch Năng Lực (Delta Analysis)</span>
                        </h5>
                        <div class="text-muted small mt-0.5">
                            Giải đáp cụ thể cho Trưởng bộ phận: <em>"Tại sao ứng viên dẫn đầu đang đứng đầu?"</em>
                        </div>
                    </div>
                    <div class="card-body p-3.5">
                        @if (Model.DeltaAnalysis != null)
                        {
                            var delta = Model.DeltaAnalysis;

                            <!-- Header so sánh Leader vs RunnerUp -->
                            <div class="p-3 mb-3 rounded-3" style="background: #F0FDF4; border: 1.5px solid #BBF7D0;">
                                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
                                    <div>
                                        <div class="small text-muted font-mono">Ứng viên dẫn đầu:</div>
                                        <div class="fw-bold text-success fs-5">
                                            <i class="bi bi-award-fill me-1"></i> @delta.LeaderName
                                            <span class="badge bg-success text-white font-mono ms-1 fs-6">@delta.LeaderScore.ToString("0.00", CultureInfo.InvariantCulture)</span>
                                        </div>
                                        <div class="text-muted small mt-0.5">
                                            Đối chiếu trực tiếp với ứng viên kế tiếp: <b>@delta.RunnerUpName</b> (@delta.RunnerUpScore.ToString("0.00", CultureInfo.InvariantCulture))
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <div class="small text-muted font-mono">Chênh lệch tổng:</div>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle font-mono fs-5 fw-bold px-3 py-1">
                                            @delta.TotalDifferenceText
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <!-- Danh sách tiêu chí chênh lệch (+ / -) -->
                            <div class="row g-2.5">
                                @foreach (var item in delta.CriteriaDeltas)
                                {
                                    var isPlus = item.IsAdvantage;
                                    var isMinus = item.IsDisadvantage;
                                    var itemBg = isPlus ? "#F0FDF4" : (isMinus ? "#FEF2F2" : "#F8FAFC");
                                    var itemBorder = isPlus ? "#BBF7D0" : (isMinus ? "#FECACA" : "#E2E8F0");
                                    var textColor = isPlus ? "#15803D" : (isMinus ? "#DC2626" : "#475569");
                                    var icon = isPlus ? "bi-plus-circle-fill text-success" : (isMinus ? "bi-dash-circle-fill text-danger" : "bi-pause-circle text-muted");

                                    <div class="col-12 col-sm-6">
                                        <div class="p-2.5 px-3 rounded-3 d-flex align-items-center justify-content-between h-100"
                                             style="background: @itemBg; border: 1px solid @itemBorder;">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi @icon fs-6"></i>
                                                <div>
                                                    <span class="fw-bold" style="color: @textColor; font-size: 0.88rem;">
                                                        @item.CriteriaName
                                                    </span>
                                                    @if (item.IsHighestInGroup)
                                                    {
                                                        <span class="badge bg-success text-white font-mono ms-1" style="font-size: 0.6rem; padding: 0.15rem 0.35rem;">
                                                            Cao nhất nhóm
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="text-end font-mono">
                                                <span class="fw-bold" style="color: @textColor; font-size: 0.95rem;">
                                                    @item.DeltaText
                                                </span>
                                                <div class="text-muted" style="font-size: 0.68rem;">
                                                    (@item.LeaderScore:0.0 vs @item.RunnerUpScore:0.0)
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted">
                                <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
                                Cần tối thiểu 2 ứng viên có điểm đánh giá để thực hiện phân tích chênh lệch năng lực.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- ========================================================================= -->
        <!-- KHU VỰC 4 - CHI TIẾT PHIẾU ĐÁNH GIÁ (Collapse mặc định - Chống thiên vị)   -->
        <!-- [+] Xem nguồn điểm                                                        -->
        <!-- Từng ứng viên: Đánh giá viên A, B, C và điểm trung bình                   -->
        <!-- ========================================================================= -->
        <div class="card border-0 shadow-sm bg-white mb-4 overflow-hidden" style="border: 1px solid #E2E8F0 !important; border-radius: 14px;">
            <div class="card-header bg-white border-bottom p-3.5 d-flex align-items-center justify-content-between" style="border-color: #F1F5F9 !important;">
                <div>
                    <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-shield-shaded text-primary"></i>
                        <span>Minh Bạch Nguồn Điểm &amp; Chống Thiên Vị</span>
                    </h5>
                    <div class="text-muted small mt-0.5">
                        Kiểm chứng độc lập điểm số từng giám khảo trong hội đồng. Giúp phát hiện sai lệch hoặc thiên kiến cá nhân.
                    </div>
                </div>
                <!-- Nút toggle mở rộng collapse -->
                <button class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1.5" type="button" data-bs-toggle="collapse" data-bs-target="#evaluatorBreakdownCollapse" aria-expanded="false" aria-controls="evaluatorBreakdownCollapse" style="border-radius: 8px;">
                    <i class="bi bi-chevron-expand"></i> [+] Xem nguồn điểm đánh giá
                </button>
            </div>

            <!-- Khối Collapse (Mặc định thu gọn theo wireframe) -->
            <div class="collapse" id="evaluatorBreakdownCollapse">
                <div class="card-body p-4 bg-light border-top" style="border-color: #F1F5F9 !important;">
                    <div class="row g-4">
                        @foreach (var candidateBreakdown in Model.EvaluatorBreakdowns)
                        {
                            <div class="col-12 col-md-6 col-lg-3">
                                <div class="card border-0 shadow-sm bg-white h-100" style="border: 1px solid #E2E8F0 !important; border-radius: 10px;">
                                    <div class="card-header bg-white border-bottom p-3 d-flex align-items-center justify-content-between" style="border-color: #F1F5F9 !important;">
                                        <div>
                                            <h6 class="fw-bold text-dark mb-0">@candidateBreakdown.CandidateName</h6>
                                            <span class="text-muted small font-mono">@candidateBreakdown.EvaluatorCount giám khảo</span>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge bg-success-subtle text-success border border-success-subtle font-mono fs-6 fw-bold">
                                                @candidateBreakdown.AverageScore.ToString("0.00", CultureInfo.InvariantCulture)
                                            </span>
                                        </div>
                                    </div>

                                    <div class="card-body p-3">
                                        <div class="small fw-bold text-uppercase text-muted mb-2 font-mono" style="font-size: 0.68rem; letter-spacing: 0.05em;">
                                            Chi tiết điểm các giám khảo:
                                        </div>
                                        <ul class="list-unstyled mb-0 d-flex flex-column gap-2 font-mono small">
                                            @foreach (var evaluator in candidateBreakdown.Evaluators)
                                            {
                                                <li class="p-2 rounded-2 bg-light d-flex align-items-center justify-content-between border" style="border-color: #E2E8F0 !important;">
                                                    <span class="text-dark">@evaluator.EvaluatorName</span>
                                                    <span class="badge bg-white text-dark border font-mono fw-bold">
                                                        @evaluator.OverallScore.ToString("0.0", CultureInfo.InvariantCulture)
                                                    </span>
                                                </li>
                                            }
                                        </ul>

                                        <div class="mt-3 pt-2.5 border-top d-flex align-items-center justify-content-between small font-mono" style="border-color: #F1F5F9 !important;">
                                            <span class="text-muted">Trung bình :</span>
                                            <strong class="text-dark">@candidateBreakdown.AverageScore.ToString("0.00", CultureInfo.InvariantCulture)</strong>
                                        </div>

                                        @if (candidateBreakdown.HasDiscrepancy)
                                        {
                                            <div class="mt-2 p-2 rounded-2 bg-warning-subtle text-warning-emphasis border border-warning-subtle small font-mono" style="font-size: 0.72rem;">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i> Có độ lệch điểm giữa các giám khảo (&ge; @candidateBreakdown.Spread.ToString("0.0", CultureInfo.InvariantCulture)). Cần kiểm tra lại phiếu đánh giá.
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Empty State khi chưa có dữ liệu đánh giá -->
        <div class="card border-0 shadow-sm p-5 bg-white text-center mb-4" style="border: 1px solid #E2E8F0 !important; border-radius: 14px;">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mx-auto mb-3" style="width: 72px; height: 72px; background: #F8FAFC; border: 2px dashed #CBD5E1; color: #94A3B8;">
                <i class="bi bi-clipboard2-data" style="font-size: 2rem;"></i>
            </div>
            <h5 class="fw-bold text-dark mb-1">Chưa có ứng viên nào có phiếu đánh giá chính thức</h5>
            <p class="text-muted small mx-auto mb-4" style="max-width: 520px; line-height: 1.6;">
                Theo nguyên tắc so sánh khách quan, bảng so sánh chỉ hiển thị các ứng viên đã được hội đồng phỏng vấn nộp phiếu đánh giá chính thức. Vị trí <strong>@Model.SelectedJobTitle</strong> hiện chưa có ứng viên nào thỏa mãn điều kiện lọc.
            </p>
            <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap">
                <a href="/dashboard/lich-phong-van" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1.5 shadow-sm" style="border-radius: 8px;">
                    <i class="bi bi-calendar-check-fill"></i> Xem lịch phỏng vấn &amp; nộp phiếu
                </a>
                <a href="/interviews/so-sanh-ung-vien" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1.5" style="border-radius: 8px;">
                    <i class="bi bi-arrow-counterclockwise"></i> Xem tất cả vị trí
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Khởi tạo Bootstrap Tooltip cho tất cả ô điểm ma trận
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.forEach(function (tooltipTriggerEl) {
                try {
                    if (typeof bootstrap.Tooltip.getOrCreateInstance === 'function') {
                        bootstrap.Tooltip.getOrCreateInstance(tooltipTriggerEl, {
                            delay: { show: 100, hide: 100 }
                        });
                    } else if (!bootstrap.Tooltip.getInstance(tooltipTriggerEl)) {
                        new bootstrap.Tooltip(tooltipTriggerEl, {
                            delay: { show: 100, hide: 100 }
                        });
                    }
                } catch (e) { }
            });
        });

        // Điều hướng xem chi tiết phiếu đánh giá
        function openInterviewEvaluationModal(interviewId) {
            if (!interviewId) return;

            const modalEl = document.getElementById('interviewEvaluationModal');
            if (modalEl && typeof loadInterviewEvaluationData === 'function') {
                const modal = new bootstrap.Modal(modalEl);
                modal.show();
                loadInterviewEvaluationData(interviewId);
            } else {
                window.location.href = '/phong-van/' + interviewId + '/phieu-danh-gia';
            }
        }
    </script>
}
