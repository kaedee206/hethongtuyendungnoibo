@model List<Ats.Web.Models.DTOs.NotificationPreferenceItemDto>

@{
    ViewData["Title"] = "Cấu hình nhận thông báo";
    var userProfile = ViewBag.UserProfile as Ats.Web.Models.ViewModels.Profiles.ProfileUpdateViewModel;
}

<div class="container py-4" style="max-width: 960px;">
    <!-- Anti-forgery container -->
    <form id="notificationPreferencesForm">
        @Html.AntiForgeryToken()
    </form>

    <!-- Header & Breadcrumb -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1.5" style="font-size: 0.85rem;">
                    <li class="breadcrumb-item"><a href="/ho-so" class="text-decoration-none text-muted">Hồ sơ cá nhân</a></li>
                    <li class="breadcrumb-item active fw-semibold text-primary" aria-current="page">Tùy chọn thông báo</li>
                </ol>
            </nav>
            <h1 class="h4 fw-bold mb-1" style="color: var(--text-primary);">Cấu hình nhận thông báo cá nhân</h1>
            <p class="text-muted mb-0" style="font-size: 0.88rem;">
                SCRUM-349 · Bật/tắt theo từng kênh Trong ứng dụng (In-App) và Email. Các thông báo tuân thủ quy trình bắt buộc sẽ luôn được kích hoạt.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="/ho-so" class="btn btn-sm btn-outline-secondary rounded-2 px-3 py-2 fw-semibold d-inline-flex align-items-center gap-1.5" style="font-size: 0.85rem;">
                <i class="bi bi-arrow-left"></i>
                <span>Quay lại hồ sơ</span>
            </a>
            <button type="button" class="btn btn-sm btn-primary rounded-2 px-3 py-2 fw-semibold d-inline-flex align-items-center gap-1.5 shadow-2xs" id="btnSaveAll" onclick="saveAllPreferences()" style="font-size: 0.85rem;">
                <span class="spinner-border spinner-border-sm d-none" id="saveAllSpinner"></span>
                <i class="bi bi-check2-circle" id="saveAllIcon"></i>
                <span>Lưu toàn bộ thay đổi</span>
            </button>
        </div>
    </div>

    <!-- Alert / Notice Box -->
    <div class="card border-0 shadow-xs mb-4" style="background: #F0FDF4; border-left: 4px solid #16A34A !important; border-radius: 10px;">
        <div class="card-body py-3 px-4 d-flex align-items-start gap-3">
            <div class="text-success mt-0.5">
                <i class="bi bi-shield-check fs-5"></i>
            </div>
            <div class="small text-slate-700">
                <div class="fw-bold text-dark mb-0.5">Kiểm soát thông báo & Quy chuẩn tuân thủ doanh nghiệp</div>
                <div>
                    Hệ thống tự động lưu ngay khi bạn gạt công tắc (Real-time Auto Save). Riêng các thông báo <strong>Yêu cầu phê duyệt (Approval Request)</strong> mang tính chất pháp lý và tuân thủ nội bộ nên công tắc được khóa cố định nhằm đảm bảo tiến độ ra quyết định tuyển dụng.
                </div>
            </div>
        </div>
    </div>

    <!-- Main Notification List Table Card -->
    <div class="card border-0 shadow-sm bg-white" style="border: 1px solid #E2E8F0 !important; border-radius: 12px; overflow: hidden;">
        <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center border-bottom" style="border-color: #F1F5F9 !important;">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-2 p-1.5">
                    <i class="bi bi-bell-fill"></i>
                </span>
                <span class="fw-bold text-dark" style="font-size: 0.95rem;">Danh mục sự kiện thông báo tác nghiệp</span>
            </div>
            <div class="d-flex align-items-center gap-3 text-secondary small">
                <span class="d-none d-md-inline text-muted" style="font-size: 0.8rem;"><i class="bi bi-info-circle me-1"></i>Gạt công tắc để bật/tắt</span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table align-middle mb-0" id="notificationPreferencesTable">
                <thead style="background: #F8FAFC;">
                    <tr style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; color: #64748B;">
                        <th style="padding: 1rem 1.25rem; font-weight: 600;">Sự kiện tác nghiệp</th>
                        <th style="width: 170px; padding: 1rem 1.25rem; text-align: center; font-weight: 600;">
                            <div class="d-flex align-items-center justify-content-center gap-1.5">
                                <i class="bi bi-app-indicator text-primary"></i>
                                <span>Trong ứng dụng</span>
                            </div>
                        </th>
                        <th style="width: 170px; padding: 1rem 1.25rem; text-align: center; font-weight: 600;">
                            <div class="d-flex align-items-center justify-content-center gap-1.5">
                                <i class="bi bi-envelope-at text-success"></i>
                                <span>Thư điện tử</span>
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y" style="border-top: 1px solid #F1F5F9;">
                    @foreach (var item in Model)
                    {
                        var typeInt = (int)item.NotificationType;
                        <tr class="pref-row" data-type="@typeInt" style="transition: background-color 0.15s ease;">
                            <!-- Column 1: Info -->
                            <td style="padding: 1.15rem 1.25rem;">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="d-flex align-items-center justify-content-center flex-shrink-0 text-white rounded-2 shadow-2xs"
                                         style="width: 36px; height: 36px; background: @(item.IsMandatory ? "#DC2626" : "#2563EB"); font-size: 1rem;">
                                        <i class="bi @item.IconClass"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                            <span class="fw-bold text-dark" style="font-size: 0.92rem;">@item.TypeName</span>
                                            <span class="badge bg-light text-secondary border rounded-1 px-1.5 py-0.5" style="font-size: 0.68rem;">
                                                @item.Category
                                            </span>
                                            @if (item.IsMandatory)
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-1 px-1.5 py-0.5 d-inline-flex align-items-center gap-1" style="font-size: 0.68rem;">
                                                    <i class="bi bi-lock-fill"></i>Bắt buộc · Không thể tắt
                                                </span>
                                            }
                                        </div>
                                        <div class="text-secondary small" style="font-size: 0.8rem; line-height: 1.45; max-width: 580px;">
                                            @item.TypeDescription
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <!-- Column 2: In-App Switch -->
                            <td style="padding: 1.15rem 1.25rem; text-align: center;">
                                <div class="d-flex flex-column align-items-center justify-content-center">
                                    <div class="form-check form-switch mb-0">
                                        <input class="form-check-input pref-switch inapp-switch"
                                               type="checkbox"
                                               role="switch"
                                               id="switch_inapp_@typeInt"
                                               data-type="@typeInt"
                                               data-channel="inapp"
                                               @(item.InAppEnabled || item.IsMandatory ? "checked" : "")
                                               @(item.IsMandatory ? "disabled" : "")
                                               onchange="onPreferenceToggle(this)"
                                               style="cursor: @(item.IsMandatory ? "not-allowed" : "pointer"); width: 2.8rem; height: 1.45rem;" />
                                    </div>
                                    <span class="text-muted mt-1 small" id="label_inapp_@typeInt" style="font-size: 0.72rem; font-family: 'JetBrains Mono', monospace;">
                                        @(item.IsMandatory ? "Khóa bật" : (item.InAppEnabled ? "Đang bật" : "Đã tắt"))
                                    </span>
                                </div>
                            </td>

                            <!-- Column 3: Email Switch -->
                            <td style="padding: 1.15rem 1.25rem; text-align: center;">
                                <div class="d-flex flex-column align-items-center justify-content-center">
                                    <div class="form-check form-switch mb-0">
                                        <input class="form-check-input pref-switch email-switch"
                                               type="checkbox"
                                               role="switch"
                                               id="switch_email_@typeInt"
                                               data-type="@typeInt"
                                               data-channel="email"
                                               @(item.EmailEnabled || item.IsMandatory ? "checked" : "")
                                               @(item.IsMandatory ? "disabled" : "")
                                               onchange="onPreferenceToggle(this)"
                                               style="cursor: @(item.IsMandatory ? "not-allowed" : "pointer"); width: 2.8rem; height: 1.45rem;" />
                                    </div>
                                    <span class="text-muted mt-1 small" id="label_email_@typeInt" style="font-size: 0.72rem; font-family: 'JetBrains Mono', monospace;">
                                        @(item.IsMandatory ? "Khóa bật" : (item.EmailEnabled ? "Đang bật" : "Đã tắt"))
                                    </span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-light py-2.5 px-4 d-flex justify-content-between align-items-center border-top small text-muted" style="font-size: 0.78rem;">
            <div>
                <i class="bi bi-check-circle-fill text-success me-1"></i>Hệ thống lưu trữ cấu hình đồng bộ trên mọi thiết bị đăng nhập.
            </div>
            <div>
                Tổng số sự kiện cấu hình: <strong>@Model.Count</strong>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function getCsrfToken() {
            return document.querySelector('#notificationPreferencesForm input[name="__RequestVerificationToken"]')?.value || '';
        }

        // Tự động lưu tức thì khi gạt công tắc (Real-time Auto-save)
        async function onPreferenceToggle(switchEl) {
            const type = parseInt(switchEl.getAttribute('data-type'), 10);
            const channel = switchEl.getAttribute('data-channel');
            const enabled = switchEl.checked;
            const labelEl = document.getElementById(`label_${channel}_${type}`);

            if (labelEl) {
                labelEl.textContent = enabled ? 'Đang bật' : 'Đã tắt';
                labelEl.className = enabled ? 'text-success mt-1 small' : 'text-muted mt-1 small';
            }

            const payload = {
                notificationType: type,
                channel: channel,
                enabled: enabled
            };

            try {
                const response = await fetch('/ho-so/api/thong-bao/cap-nhat-kenh', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getCsrfToken()
                    },
                    body: JSON.stringify(payload)
                });

                const data = await response.json();
                if (data.success) {
                    if (window.NoveraToast) {
                        window.NoveraToast.success(data.message || 'Đã cập nhật tùy chọn thông báo.');
                    }
                } else {
                    // Revert switch on error
                    switchEl.checked = !enabled;
                    if (labelEl) labelEl.textContent = !enabled ? 'Đang bật' : 'Đã tắt';
                    if (window.NoveraToast) {
                        window.NoveraToast.error(data.message || 'Không thể cập nhật cấu hình.');
                    } else {
                        alert(data.message);
                    }
                }
            } catch (err) {
                console.error(err);
                switchEl.checked = !enabled;
                if (labelEl) labelEl.textContent = !enabled ? 'Đang bật' : 'Đã tắt';
                if (window.NoveraToast) {
                    window.NoveraToast.error('Lỗi kết nối khi lưu cấu hình thông báo.');
                }
            }
        }

        // Lưu hàng loạt toàn bộ cấu hình
        async function saveAllPreferences() {
            const rows = document.querySelectorAll('.pref-row');
            const preferences = [];

            rows.forEach(row => {
                const type = parseInt(row.getAttribute('data-type'), 10);
                const inAppSwitch = row.querySelector('.inapp-switch');
                const emailSwitch = row.querySelector('.email-switch');

                preferences.push({
                    notificationType: type,
                    inAppEnabled: inAppSwitch ? inAppSwitch.checked : true,
                    emailEnabled: emailSwitch ? emailSwitch.checked : true
                });
            });

            const btn = document.getElementById('btnSaveAll');
            const spinner = document.getElementById('saveAllSpinner');
            const icon = document.getElementById('saveAllIcon');

            btn.disabled = true;
            spinner.classList.remove('d-none');
            icon.classList.add('d-none');

            try {
                const response = await fetch('/ho-so/api/thong-bao/luu-tat-ca', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getCsrfToken()
                    },
                    body: JSON.stringify({ preferences })
                });

                const data = await response.json();
                if (data.success) {
                    if (window.NoveraToast) {
                        window.NoveraToast.success(data.message || 'Lưu toàn bộ cấu hình thành công!');
                    } else {
                        alert(data.message);
                    }
                } else {
                    if (window.NoveraToast) {
                        window.NoveraToast.error(data.message || 'Có lỗi xảy ra khi lưu.');
                    } else {
                        alert(data.message);
                    }
                }
            } catch (err) {
                console.error(err);
                if (window.NoveraToast) {
                    window.NoveraToast.error('Có lỗi xảy ra khi lưu cấu hình.');
                }
            } finally {
                btn.disabled = false;
                spinner.classList.add('d-none');
                icon.classList.remove('d-none');
            }
        }
    </script>
}
