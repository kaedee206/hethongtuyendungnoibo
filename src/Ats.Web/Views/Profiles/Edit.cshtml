@model Ats.Web.Models.ViewModels.Profiles.ProfileUpdateViewModel

<div class="card shadow-sm profile-component">
    <div class="card-body">
        <h5 class="card-title mb-4">Chỉnh sửa hồ sơ cá nhân</h5>

        <!-- id="profileForm" để JS hook vào xử lý sự kiện submit -->
        <form id="profileForm" novalidate>
            @Html.AntiForgeryToken()
            
            <h6 class="text-muted mb-1">Thông tin tài khoản (Chỉ đọc)</h6>
            <div class="alert alert-secondary py-2 mb-4 d-flex align-items-center" role="alert" style="font-size: 0.85rem;">
                <i class="bi bi-info-circle-fill text-secondary me-2"></i>
                <span>Bạn không được tự thay đổi các thông tin này. Vui lòng liên hệ <strong>Admin</strong> nếu cần cập nhật.</span>
            </div>
            
            <div class="row mb-4">
                <div class="col-md-4 mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control bg-light" disabled readonly data-bs-toggle="tooltip" title="Liên hệ Admin để thay đổi Email" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="RoleName" class="form-label">Vai trò</label>
                    <input asp-for="RoleName" class="form-control bg-light" disabled readonly data-bs-toggle="tooltip" title="Liên hệ Admin để thay đổi Vai trò" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="DepartmentName" class="form-label">Phòng ban</label>
                    <input asp-for="DepartmentName" class="form-control bg-light" disabled readonly data-bs-toggle="tooltip" title="Liên hệ Admin để thay đổi Phòng ban" />
                </div>
            </div>

            <h6 class="text-muted">Thông tin cá nhân</h6>
            <div class="row mb-4">
                <div class="col-md-12 mb-3">
                    <label asp-for="FullName" class="form-label">Họ tên hiển thị <span class="text-danger">*</span></label>
                    <input asp-for="FullName" class="form-control" required />
                    <span class="text-danger" id="error-FullName"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="PhoneNumber" class="form-label">Số điện thoại</label>
                    <input asp-for="PhoneNumber" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="JobTitle" class="form-label">Chức danh / Vị trí</label>
                    <input asp-for="JobTitle" class="form-control" />
                </div>
            </div>

            <div class="d-flex justify-content-end">
                <button type="submit" id="btnSubmitProfile" class="btn btn-primary">
                    <span id="submitSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                    <span id="submitText">Lưu thay đổi</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Toast Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
    <div id="profileToast" class="toast align-items-center text-white border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-center">
                <i id="toastIcon" class="bi me-2 fs-5"></i>
                <span id="toastMessage"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const profileForm = document.getElementById('profileForm');
            const btnSubmit = document.getElementById('btnSubmitProfile');
            const submitSpinner = document.getElementById('submitSpinner');
            const submitText = document.getElementById('submitText');

            // Khởi tạo Toast
            const toastEl = document.getElementById('profileToast');
            const toastMessage = document.getElementById('toastMessage');
            const toastIcon = document.getElementById('toastIcon');
            const profileToast = new bootstrap.Toast(toastEl, { delay: 5000 });

            function showToast(message, type) {
                toastEl.className = 'toast align-items-center text-white border-0'; // reset
                toastIcon.className = 'bi me-2 fs-5'; // reset
                
                if (type === 'success') {
                    toastEl.classList.add('bg-success');
                    toastIcon.classList.add('bi-check-circle-fill');
                } else if (type === 'error') {
                    toastEl.classList.add('bg-danger');
                    toastIcon.classList.add('bi-x-circle-fill');
                }
                
                toastMessage.textContent = message;
                profileToast.show();
            }

            profileForm.addEventListener('submit', async (e) => {
                e.preventDefault();

                // 1. Quản lý trạng thái UI (Loading state & Disable Form)
                btnSubmit.disabled = true;
                submitSpinner.classList.remove('d-none');
                submitText.textContent = 'Đang cập nhật...';
                
                // Disable toàn bộ input có thể edit trong lúc chờ API
                const editableInputs = profileForm.querySelectorAll('input:not([readonly])');
                editableInputs.forEach(input => input.disabled = true);

                // 2. Gom dữ liệu Editable từ Form
                const formData = new FormData(profileForm);
                const payload = {
                    fullName: formData.get('FullName'),
                    phoneNumber: formData.get('PhoneNumber'),
                    jobTitle: formData.get('JobTitle')
                };

                // Lấy Token chống CSRF bắt buộc của ASP.NET Core
                const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]').value;

                try {
                    // 3. Gọi API cập nhật
                    const response = await fetch('/api/tai-khoan/ho-so', {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': csrfToken // Truyền token bảo mật
                        },
                        body: JSON.stringify(payload)
                    });

                    if (response.ok) {
                        showToast('Cập nhật hồ sơ thành công!', 'success');
                    } else {
                        const errorData = await response.json();
                        console.error('Validation Errors:', errorData);
                        
                        let errorMessage = 'Có lỗi xảy ra, vui lòng kiểm tra lại thông tin.';
                        
                        // Parse lỗi validation từ backend (VD: ASP.NET Core model binding errors)
                        if (errorData.errors) {
                            const messages = [];
                            for (const field in errorData.errors) {
                                messages.push(errorData.errors[field].join(', '));
                            }
                            errorMessage = 'Lỗi nhập liệu: ' + messages.join(' | ');
                        } else if (errorData.message) {
                            errorMessage = errorData.message;
                        }
                        
                        showToast(errorMessage, 'error');
                    }
                } catch (error) {
                    console.error('Lỗi mạng:', error);
                    showToast('Lỗi hệ thống: Không thể kết nối đến máy chủ. Vui lòng kiểm tra mạng hoặc thử lại sau.', 'error');
                } finally {
                    // 4. Hoàn tất - Khôi phục trạng thái UI
                    btnSubmit.disabled = false;
                    submitSpinner.classList.add('d-none');
                    submitText.textContent = 'Lưu thay đổi';
                    
                    editableInputs.forEach(input => input.disabled = false);
                }
            });

            // Khởi tạo tooltips của Bootstrap
            const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
            const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));
        });
    </script>
}
