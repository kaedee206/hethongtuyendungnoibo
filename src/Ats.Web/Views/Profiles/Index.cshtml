@model Ats.Web.Models.ViewModels.Profiles.ProfileUpdateViewModel

@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<div class="container py-4" style="max-width: 900px;">
    <!-- Single-Tier Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1" style="color: var(--text-primary);">Hồ sơ cá nhân</h1>
            <p class="text-muted mb-0" style="font-size: 0.9rem;">Thông tin định danh và quyền tác nghiệp tại NoveraTech</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/ho-so/thong-bao" class="btn btn-outline-secondary" style="border-radius: 8px;">
                <i class="bi bi-bell-gear me-1"></i> Tùy chọn thông báo
            </a>
            <a href="/ho-so/chinh-sua" class="btn btn-outline-primary" style="border-radius: 8px;">
                <i class="bi bi-pencil me-1"></i> Chỉnh sửa hồ sơ
            </a>
        </div>
    </div>

    <!-- Main Card -->
    <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
        <div class="card-body p-4 p-md-5">
            <!-- Avatar & Header info row -->
            <div class="d-flex flex-column flex-sm-row align-items-center gap-4 pb-4 mb-4 border-bottom">
                <div class="position-relative">
                    @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                    {
                        <img src="@Model.AvatarUrl" alt="Avatar" class="border shadow-sm" style="width: 100px; height: 100px; border-radius: 12px; object-fit: cover;" id="profileAvatarImg" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center bg-light border text-secondary fw-bold shadow-sm" style="width: 100px; height: 100px; border-radius: 12px; font-size: 2rem;">
                            @(string.IsNullOrEmpty(Model.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper())
                        </div>
                    }
                </div>
                <div class="text-center text-sm-start">
                    <h2 class="h4 fw-bold mb-1" style="color: var(--text-primary);">@Model.FullName</h2>
                    <p class="text-muted mb-2 font-mono" style="font-size: 0.9rem;">@Model.Email</p>
                    <div class="d-flex flex-wrap gap-2 justify-content-center justify-content-sm-start">
                        <span class="badge" style="background-color: var(--brand-surface); color: var(--brand-primary); border: 1px solid var(--brand-border); border-radius: 6px; font-weight: 600; padding: 0.35rem 0.65rem;">
                            <i class="bi bi-shield-check me-1"></i>@Model.RoleName
                        </span>
                        <span class="badge bg-light text-secondary border" style="border-radius: 6px; font-weight: 500; padding: 0.35rem 0.65rem;">
                            <i class="bi bi-building me-1"></i>@Model.DepartmentName
                        </span>
                    </div>
                </div>
            </div>

            <!-- Details Grid -->
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3" style="border-radius: 8px !important; border: 1px solid var(--border-default);">
                        <div class="text-muted small fw-semibold mb-1">Số điện thoại liên hệ</div>
                        <div class="fw-bold font-mono" style="color: var(--text-primary);">
                            @(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Chưa cập nhật" : Model.PhoneNumber)
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3" style="border-radius: 8px !important; border: 1px solid var(--border-default);">
                        <div class="text-muted small fw-semibold mb-1">Chức danh / Vị trí</div>
                        <div class="fw-bold" style="color: var(--text-primary);">
                            @(string.IsNullOrWhiteSpace(Model.JobTitle) ? "Chưa cập nhật" : Model.JobTitle)
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3" style="border-radius: 8px !important; border: 1px solid var(--border-default);">
                        <div class="text-muted small fw-semibold mb-1">Email công vụ (Chỉ đọc)</div>
                        <div class="fw-bold font-mono" style="color: var(--text-primary);">@Model.Email</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3" style="border-radius: 8px !important; border: 1px solid var(--border-default);">
                        <div class="text-muted small fw-semibold mb-1">Phòng ban trực thuộc (Chỉ đọc)</div>
                        <div class="fw-bold" style="color: var(--text-primary);">@Model.DepartmentName</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SCRUM-349: Thẻ Cấu hình Thông báo Cá nhân (Notification Preferences) -->
    <div class="card shadow-sm border-0" style="border-radius: 12px; border: 1px solid #E2E8F0 !important;">
        <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center" style="border-bottom: 1px solid #F1F5F9;">
            <div class="d-flex align-items-center gap-2">
                <span class="p-1.5 bg-primary bg-opacity-10 text-primary rounded-2">
                    <i class="bi bi-bell-fill"></i>
                </span>
                <div>
                    <h6 class="fw-bold text-dark mb-0" style="font-size: 0.95rem;">Tùy chọn nhận thông báo cá nhân</h6>
                    <div class="text-muted small" style="font-size: 0.78rem;">Quản lý kênh In-App & Email cho 6 loại sự kiện tác nghiệp (SCRUM-349)</div>
                </div>
            </div>
            <a href="/ho-so/thong-bao" class="btn btn-sm btn-outline-primary rounded-2 px-3 fw-semibold" style="font-size: 0.82rem;">
                <span>Cấu hình chi tiết</span>
                <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="p-3 rounded-2 border bg-light h-100">
                        <div class="d-flex align-items-center gap-2 mb-1 text-danger fw-bold small">
                            <i class="bi bi-shield-lock-fill"></i>
                            <span>Phê duyệt & Tuân thủ</span>
                        </div>
                        <div class="text-secondary small mb-2" style="font-size: 0.8rem;">Yêu cầu duyệt Offer & Requisition</div>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="font-size: 0.7rem;">
                            Bắt buộc · Luôn bật
                        </span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 rounded-2 border bg-light h-100">
                        <div class="d-flex align-items-center gap-2 mb-1 text-primary fw-bold small">
                            <i class="bi bi-person-lines-fill"></i>
                            <span>Hồ sơ & Ứng tuyển</span>
                        </div>
                        <div class="text-secondary small mb-2" style="font-size: 0.8rem;">Nhận hồ sơ mới & Đổi vòng tuyển dụng</div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.7rem;">
                            Tùy chỉnh In-App / Email
                        </span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 rounded-2 border bg-light h-100">
                        <div class="d-flex align-items-center gap-2 mb-1 text-info text-dark fw-bold small">
                            <i class="bi bi-calendar2-check-fill"></i>
                            <span>Phỏng vấn & SLA</span>
                        </div>
                        <div class="text-secondary small mb-2" style="font-size: 0.8rem;">Lịch PV, Đánh giá điểm & Quá hạn SLA</div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.7rem;">
                            Tùy chỉnh In-App / Email
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
