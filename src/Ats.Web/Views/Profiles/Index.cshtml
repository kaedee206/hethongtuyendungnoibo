@model Ats.Web.Models.ViewModels.Profiles.ProfileUpdateViewModel

<div class="card shadow-sm profile-component">
    <div class="card-body">
        <h5 class="card-title mb-4">Chỉnh sửa hồ sơ cá nhân</h5>

        <!-- id="profileForm" để JS hook vào xử lý sự kiện submit -->
        <form id="profileForm" novalidate>
            @Html.AntiForgeryToken()
            
            <h6 class="text-muted">Thông tin tài khoản (Chỉ đọc)</h6>
            <div class="row mb-4">
                <div class="col-md-4 mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control bg-light" disabled readonly />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="RoleName" class="form-label">Vai trò</label>
                    <input asp-for="RoleName" class="form-control bg-light" disabled readonly />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="DepartmentName" class="form-label">Phòng ban</label>
                    <input asp-for="DepartmentName" class="form-control bg-light" disabled readonly />
                </div>
            </div>

            <h6 class="text-muted">Thông tin cá nhân</h6>
            <div class="row mb-4">
                <div class="col-md-12 mb-3">
                    <label asp-for="FullName" class="form-label">Họ tên hiển thị <span class="text-danger">*</span></label>
                    <input asp-for="FullName" class="form-control" required />
                    <span class="text-danger" id="error-FullName"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="PhoneNumber" class="form-label">Số điện thoại</label>
                    <input asp-for="PhoneNumber" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="JobTitle" class="form-label">Chức danh / Vị trí</label>
                    <input asp-for="JobTitle" class="form-control" />
                </div>
            </div>

            <div class="d-flex justify-content-end">
                <button type="submit" id="btnSubmitProfile" class="btn btn-primary">
                    <span id="submitSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                    <span id="submitText">Lưu thay đổi</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const profileForm = document.getElementById('profileForm');
            const btnSubmit = document.getElementById('btnSubmitProfile');
            const submitSpinner = document.getElementById('submitSpinner');
            const submitText = document.getElementById('submitText');

            profileForm.addEventListener('submit', async (e) => {
                e.preventDefault();

                // 1. Quản lý trạng thái UI (Loading state & Disable Form)
                btnSubmit.disabled = true;
                submitSpinner.classList.remove('d-none');
                submitText.textContent = 'Đang cập nhật...';
                
                // Disable toàn bộ input có thể edit trong lúc chờ API
                const editableInputs = profileForm.querySelectorAll('input:not([readonly])');
                editableInputs.forEach(input => input.disabled = true);

                // 2. Gom dữ liệu Editable từ Form
                const formData = new FormData(profileForm);
                const payload = {
                    fullName: formData.get('FullName'),
                    phoneNumber: formData.get('PhoneNumber'),
                    jobTitle: formData.get('JobTitle')
                };

                // Lấy Token chống CSRF bắt buộc của ASP.NET Core
                const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]').value;

                try {
                    // 3. Gọi API cập nhật (Đã trỏ đúng endpoint backend SCRUM-187)
                    const response = await fetch('/api/tai-khoan/ho-so', {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': csrfToken // Truyền token bảo mật
                        },
                        body: JSON.stringify(payload)
                    });

                    if (response.ok) {
                        // Tích hợp Toast/Notification component dùng chung của dự án ở đây
                        alert('Cập nhật hồ sơ thành công!');
                    } else {
                        const errorData = await response.json();
                        console.error('Validation Errors:', errorData);
                        alert('Có lỗi xảy ra, vui lòng kiểm tra lại thông tin.');
                    }
                } catch (error) {
                    console.error('Lỗi mạng:', error);
                    alert('Không thể kết nối đến máy chủ.');
                } finally {
                    // 4. Hoàn tất - Khôi phục trạng thái UI
                    btnSubmit.disabled = false;
                    submitSpinner.classList.add('d-none');
                    submitText.textContent = 'Lưu thay đổi';
                    
                    editableInputs.forEach(input => input.disabled = false);
                }
            });
        });
    </script>
}
