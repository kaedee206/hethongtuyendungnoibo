@model string?
@{
    ViewData["Title"] = "Liên kết không hợp lệ | NoveraTech";
    Layout = "_Layout";
}

<div class="container py-5" style="max-width: 600px;">
    <div class="card border-0 shadow-sm p-4 p-md-5 text-center" style="border-radius: 20px; background: #FFFFFF; border: 1px solid #E2E8F0;">
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 mx-auto" style="width: 72px; height: 72px; background: #FFFBEB; color: #D97706;">
            <i class="bi bi-shield-slash fs-1"></i>
        </div>

        <h1 class="h4 fw-bold text-dark mb-2">Liên kết không hợp lệ hoặc đã hết hạn</h1>
        <p class="text-muted small mb-4" style="line-height: 1.6;">
            @(Model ?? "Liên kết thư mời nhận việc bạn đang truy cập không hợp lệ, không tồn tại hoặc đã bị thay đổi mã xác thực.")
        </p>

        <div class="p-3 mb-4 text-start" style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 12px; font-size: 0.88rem;">
            <div class="fw-bold text-dark mb-1">
                <i class="bi bi-lightbulb text-warning me-1"></i>Gợi ý xử lý:
            </div>
            <ul class="mb-0 ps-3 text-secondary" style="line-height: 1.7;">
                <li>Kiểm tra lại toàn bộ đường dẫn trong thư mời tuyển dụng được gửi từ NoveraTech.</li>
                <li>Đảm bảo bạn không sao chép thiếu bất kỳ ký tự nào trong liên kết.</li>
                <li>Nếu nghi ngờ liên kết bị lỗi, vui lòng liên hệ phòng nhân sự để được gửi lại thư mời mới.</li>
            </ul>
        </div>

        <div>
            <a href="/" class="btn btn-primary fw-semibold px-4 py-2" style="border-radius: 10px;">
                Về trang chủ Tuyển dụng
            </a>
        </div>
    </div>
</div>
