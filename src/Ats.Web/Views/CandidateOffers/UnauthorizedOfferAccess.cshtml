@{
    ViewData["Title"] = "Từ chối truy cập | NoveraTech";
    Layout = "_Layout";
    var userEmail = ViewBag.LoggedInUserEmail as string;
    var candidateMaskedEmail = ViewBag.CandidateMaskedEmail as string;
    var returnUrl = ViewBag.ReturnUrl as string;
}

<div class="container py-5" style="max-width: 620px;">
    <div class="card border-0 shadow-sm p-4 p-md-5 text-center" style="border-radius: 20px; background: #FFFFFF; border: 1px solid #E2E8F0;">
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 mx-auto" style="width: 72px; height: 72px; background: #FEF2F2; color: #DC2626;">
            <i class="bi bi-person-x-fill fs-1"></i>
        </div>

        <h1 class="h4 fw-bold text-dark mb-2">Truy cập bị từ chối</h1>
        <p class="text-muted small mb-4" style="line-height: 1.6;">
            Bạn đang đăng nhập bằng tài khoản <strong>@userEmail</strong>. Tuy nhiên, thư mời nhận việc này dành riêng cho ứng viên <strong>@candidateMaskedEmail</strong>.
        </p>

        <div class="p-3 mb-4 text-start" style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 12px; font-size: 0.88rem;">
            <div class="fw-bold text-dark mb-1">
                <i class="bi bi-shield-exclamation text-danger me-1"></i>Để đảm bảo tính bảo mật và quyền riêng tư:
            </div>
            <p class="text-secondary mb-0" style="line-height: 1.6;">
                Hệ thống chỉ cho phép ứng viên chính chủ được mời nhận việc thực hiện thao tác xem và phản hồi chính thức. Vui lòng đăng xuất tài khoản hiện tại và đăng nhập bằng đúng tài khoản của bạn.
            </p>
        </div>

        <div class="d-flex flex-wrap justify-content-center gap-2">
            <a asp-controller="Account" asp-action="Logout" asp-route-returnUrl="@returnUrl" class="btn btn-outline-danger fw-semibold px-4 py-2" style="border-radius: 10px;">
                <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất tài khoản hiện tại
            </a>
            <a href="/" class="btn btn-light fw-semibold px-4 py-2" style="border-radius: 10px;">
                Về trang chủ
            </a>
        </div>
    </div>
</div>
