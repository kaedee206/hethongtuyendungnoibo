@section Scripts {
<script>
    function initRequisitionAssignmentsPage() {
        var filterSearchInput = document.getElementById('filterSearchInput');
        var filterDepartmentSelect = document.getElementById('filterDepartmentSelect');
        var filterRecruiterSelect = document.getElementById('filterRecruiterSelect');
        var filterStatusSelect = document.getElementById('filterStatusSelect');
        var quickFilterBtns = document.querySelectorAll('.quick-filter-btn');

        // Khởi tạo Bootstrap Tooltip an toàn
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.forEach(function (tooltipTriggerEl) {
            try {
                if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
                    bootstrap.Tooltip.getOrCreateInstance(tooltipTriggerEl);
                }
            } catch (e) { }
        });

        // Backend Filter & Pagination Navigation Trigger
        function triggerServerFilter(page, overrideFilter) {
            page = page || 1;
            var params = new URLSearchParams();
            params.set('page', page);

            var selectPageSize = document.getElementById('selectPageSize');
            if (selectPageSize && selectPageSize.value) {
                params.set('pageSize', selectPageSize.value);
            }

            var searchVal = (filterSearchInput && filterSearchInput.value) ? filterSearchInput.value.trim() : '';
            if (searchVal) params.set('search', searchVal);

            var deptVal = filterDepartmentSelect ? filterDepartmentSelect.value : '';
            if (deptVal) params.set('department', deptVal);

            var recVal = filterRecruiterSelect ? filterRecruiterSelect.value : '';
            if (recVal) params.set('recruiterId', recVal);

            var filterVal = (overrideFilter !== undefined && overrideFilter !== null) ? overrideFilter : (filterStatusSelect ? filterStatusSelect.value : '');
            if (filterVal && filterVal !== 'ALL') {
                params.set('filter', filterVal);
            }

            window.location.href = window.location.pathname + '?' + params.toString();
        }

        var selectPageSize = document.getElementById('selectPageSize');
        if (selectPageSize) {
            selectPageSize.addEventListener('change', function () {
                triggerServerFilter(1);
            });
        }

        if (filterDepartmentSelect) {
            filterDepartmentSelect.addEventListener('change', function () {
                triggerServerFilter(1);
            });
        }

        if (filterRecruiterSelect) {
            filterRecruiterSelect.addEventListener('change', function () {
                triggerServerFilter(1);
            });
        }

        if (filterStatusSelect) {
            filterStatusSelect.addEventListener('change', function () {
                triggerServerFilter(1);
            });
        }

        if (filterSearchInput) {
            filterSearchInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    triggerServerFilter(1);
                }
            });
        }

        quickFilterBtns.forEach(function (btn) {
            btn.addEventListener('click', function () {
                var filter = this.getAttribute('data-filter');
                triggerServerFilter(1, filter);
            });
        });

        var cardUnassignedFilter = document.getElementById('cardUnassignedFilter');
        if (cardUnassignedFilter) {
            cardUnassignedFilter.addEventListener('click', function () {
                triggerServerFilter(1, 'UNASSIGNED');
            });
        }

        var cardRecruiterTabSwitch = document.getElementById('cardRecruiterTabSwitch');
        if (cardRecruiterTabSwitch) {
            cardRecruiterTabSwitch.addEventListener('click', function () {
                var tabBtn = document.getElementById('tab-workloads-btn');
                if (tabBtn) tabBtn.click();
            });
        }

        var btnResetFilters = document.getElementById('btnResetFilters');
        if (btnResetFilters) {
            btnResetFilters.addEventListener('click', function () {
                window.location.href = window.location.pathname;
            });
        }

        var btnRefreshData = document.getElementById('btnRefreshData');
        if (btnRefreshData) {
            btnRefreshData.addEventListener('click', function () {
                window.location.reload();
            });
        }

        // ==========================================
        // ASSIGN MODAL LOGIC
        // ==========================================
        var assignModalEl = document.getElementById('assignModal');
        var modalReqId = document.getElementById('modalRequisitionId');
        var modalCurrentLeadId = document.getElementById('modalCurrentLeadId');
        var modalReqCode = document.getElementById('modalReqCode');
        var modalReqTitle = document.getElementById('modalReqTitle');
        var modalReqDepartment = document.getElementById('modalReqDepartment');
        var modalReqCountInfo = document.getElementById('modalReqCountInfo');
        var modalLeadSelect = document.getElementById('modalLeadSelect');
        var supportingChecks = document.querySelectorAll('.supporting-check');
        var supportingWrappers = document.querySelectorAll('.supporting-option-wrapper');
        var handoverSection = document.getElementById('handoverSection');
        var modalReasonInput = document.getElementById('modalReasonInput');
        var assignForm = document.getElementById('assignForm');

        function checkHandoverRequirement() {
            var currentLead = modalCurrentLeadId ? modalCurrentLeadId.value : '';
            var newLead = modalLeadSelect ? modalLeadSelect.value : '';

            supportingWrappers.forEach(function (wrap) {
                var uid = wrap.getAttribute('data-user-id');
                var chk = wrap.querySelector('.supporting-check');
                if (chk) {
                    if (uid === newLead) {
                        chk.checked = false;
                        chk.disabled = true;
                        wrap.style.opacity = '0.4';
                    } else {
                        chk.disabled = false;
                        wrap.style.opacity = '1';
                    }
                }
            });

            if (handoverSection && modalReasonInput) {
                if (currentLead && newLead && currentLead !== newLead) {
                    handoverSection.style.display = 'block';
                    modalReasonInput.setAttribute('required', 'required');
                } else {
                    handoverSection.style.display = 'none';
                    modalReasonInput.removeAttribute('required');
                    modalReasonInput.classList.remove('is-invalid');
                }
            }
        }

        if (modalLeadSelect) {
            modalLeadSelect.addEventListener('change', checkHandoverRequirement);
        }

        document.querySelectorAll('.btn-assign-action').forEach(function (btn) {
            btn.addEventListener('click', async function () {
                var reqId = this.getAttribute('data-req-id');
                var reqCode = this.getAttribute('data-req-code') || '';
                var reqTitle = this.getAttribute('data-req-title') || '';
                var reqDept = this.getAttribute('data-req-dept') || '';
                var reqQty = this.getAttribute('data-req-quantity') || '0';
                var reqCandidates = this.getAttribute('data-req-candidates') || '0';
                var currentLead = this.getAttribute('data-lead-id') || '';
                var suppIds = (this.getAttribute('data-support-ids') || '').split(',').filter(Boolean);

                if (modalReqId) modalReqId.value = reqId;
                if (modalReqCode) modalReqCode.textContent = reqCode || 'YÊU CẦU TUYỂN DỤNG';
                if (modalReqTitle) modalReqTitle.textContent = reqTitle || 'Vị trí tuyển dụng';
                if (modalReqDepartment) modalReqDepartment.textContent = reqDept ? ('Phòng ban: ' + reqDept) : '';
                if (modalReqCountInfo) modalReqCountInfo.textContent = reqQty + ' chỉ tiêu / ' + reqCandidates + ' hồ sơ';
                if (modalCurrentLeadId) modalCurrentLeadId.value = currentLead;
                if (modalLeadSelect) modalLeadSelect.value = currentLead;

                supportingChecks.forEach(function (chk) {
                    chk.checked = suppIds.includes(chk.value);
                });

                if (modalReasonInput) {
                    modalReasonInput.value = '';
                    modalReasonInput.classList.remove('is-invalid');
                }
                var modalNotesInput = document.getElementById('modalNotesInput');
                if (modalNotesInput) modalNotesInput.value = '';

                checkHandoverRequirement();

                if (assignModalEl && typeof bootstrap !== 'undefined') {
                    bootstrap.Modal.getOrCreateInstance(assignModalEl).show();
                }

                // Tải chi tiết thời gian thực để cập nhật mới nhất
                try {
                    var res = await fetch('/phan-cong-recruiter/detail/' + reqId);
                    if (res.ok) {
                        var json = await res.json();
                        if (json && json.success && json.data) {
                            var data = json.data;
                            if (modalReqCode) modalReqCode.textContent = data.code || reqCode;
                            if (modalReqTitle) modalReqTitle.textContent = data.jobPositionTitle || data.jobTitle || reqTitle;
                            if (modalReqDepartment) modalReqDepartment.textContent = 'Phòng ban: ' + (data.departmentName || reqDept);
                            if (modalReqCountInfo) modalReqCountInfo.textContent = (data.quantity || reqQty) + ' chỉ tiêu / ' + (data.totalCandidatesCount || data.applicantCount || reqCandidates) + ' hồ sơ';

                            var freshLeadId = data.leadRecruiterId || currentLead;
                            if (modalCurrentLeadId) modalCurrentLeadId.value = freshLeadId;
                            if (modalLeadSelect) modalLeadSelect.value = freshLeadId;

                            var freshSuppIds = data.supportingRecruiters ? data.supportingRecruiters.map(function (s) { return s.recruiterId; }) : suppIds;
                            supportingChecks.forEach(function (chk) {
                                chk.checked = freshSuppIds.includes(chk.value);
                            });

                            checkHandoverRequirement();
                        }
                    }
                } catch (err) {
                    console.warn('Lỗi đồng bộ chi tiết phân công:', err);
                }
            });
        });

        if (assignForm) {
            assignForm.addEventListener('submit', function (e) {
                var currentLead = modalCurrentLeadId ? modalCurrentLeadId.value : '';
                var newLead = modalLeadSelect ? modalLeadSelect.value : '';

                if (currentLead && newLead && currentLead !== newLead) {
                    if (modalReasonInput && !modalReasonInput.value.trim()) {
                        e.preventDefault();
                        modalReasonInput.classList.add('is-invalid');
                        modalReasonInput.focus();
                        return false;
                    }
                }

                if (window.atsInstant && typeof window.atsInstant.clearCache === 'function') {
                    window.atsInstant.clearCache();
                }

                var btn = document.getElementById('btnSubmitAssign');
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Đang lưu...';
                }
            });
        }

        // ==========================================
        // HANDOVER HISTORY MODAL LOGIC
        // ==========================================
        var historyModalEl = document.getElementById('historyModal');
        var historySubtitle = document.getElementById('historyModalSubtitle');
        var historyLoadingSpinner = document.getElementById('historyLoadingSpinner');
        var historyTimelineContainer = document.getElementById('historyTimelineContainer');
        var historyTimelineList = document.getElementById('historyTimelineList');
        var historyEmptyState = document.getElementById('historyEmptyState');

        document.querySelectorAll('.btn-history-action').forEach(function (btn) {
            btn.addEventListener('click', async function () {
                var reqId = this.getAttribute('data-req-id');
                var reqTitle = this.getAttribute('data-req-title') || 'Vị trí tuyển dụng';

                if (historySubtitle) historySubtitle.textContent = 'Vị trí: ' + reqTitle;
                if (historyLoadingSpinner) historyLoadingSpinner.style.display = 'block';
                if (historyTimelineContainer) historyTimelineContainer.style.display = 'none';
                if (historyEmptyState) historyEmptyState.style.display = 'none';
                if (historyTimelineList) historyTimelineList.innerHTML = '';

                if (historyModalEl && typeof bootstrap !== 'undefined') {
                    bootstrap.Modal.getOrCreateInstance(historyModalEl).show();
                }

                try {
                    var res = await fetch('/phan-cong-recruiter/lich-su/' + reqId);
                    var json = await res.json();

                    if (historyLoadingSpinner) historyLoadingSpinner.style.display = 'none';

                    if (json && json.success && json.data && json.data.length > 0) {
                        if (historyTimelineContainer) historyTimelineContainer.style.display = 'block';

                        json.data.forEach(function (item) {
                            var hType = item.handoverType || item.HandoverType || '';
                            var hDisplay = item.handoverTypeDisplay || item.HandoverTypeDisplay || 'Chuyển giao';
                            var fromName = item.fromRecruiterName || item.FromRecruiterName;
                            var toName = item.toRecruiterName || item.ToRecruiterName || 'Chuyên viên';
                            var timeDisplay = item.transferredAtDisplay || item.TransferredAtDisplay || '';
                            var byName = item.transferredByName || item.TransferredByName || 'Quản trị viên';
                            var reason = item.reason || item.Reason || '';
                            var notes = item.notes || item.Notes || '';

                            var isLeadChange = hType === 'LEAD_HANDOVER' || hType === 'PRIMARY_TRANSFER';
                            var isInitial = hType === 'INITIAL_ASSIGNMENT';
                            var badgeIcon = isLeadChange ? 'bi-arrow-left-right' : (isInitial ? 'bi-check-lg' : 'bi-people');
                            var badgeClass = isLeadChange ? 'badge-lead' : (isInitial ? 'badge-initial' : 'badge-support');

                            var node = document.createElement('div');
                            node.className = 'timeline-item';
                            node.innerHTML =
                                '<div class="timeline-badge ' + badgeClass + '">' +
                                    '<i class="bi ' + badgeIcon + '"></i>' +
                                '</div>' +
                                '<div class="card border p-3 shadow-xs rounded-3" style="background: #FFFFFF; border-color: #E2E8F0 !important;">' +
                                    '<div class="d-flex justify-content-between align-items-center mb-1 flex-wrap gap-1">' +
                                        '<div class="fw-semibold text-slate-900 small">' +
                                            '<span class="badge ' + (isLeadChange ? 'bg-amber-50 text-amber-800' : (isInitial ? 'bg-emerald-50 text-emerald-800' : 'bg-slate-100 text-slate-700')) + ' me-1.5" style="border-radius: 6px;">' +
                                                hDisplay +
                                            '</span>' +
                                            (fromName ? ('Từ: <strong>' + fromName + '</strong> <span class="text-muted mx-1">&rarr;</span> ') : '') +
                                            'Đến: <strong class="text-slate-900">' + toName + '</strong>' +
                                        '</div>' +
                                        '<div class="text-muted small font-monospace" style="font-size: 0.73rem; font-family: \'JetBrains Mono\', monospace;">' +
                                            '<i class="bi bi-clock me-1"></i>' + timeDisplay +
                                        '</div>' +
                                    '</div>' +
                                    '<div class="text-muted small" style="font-size: 0.75rem;">' +
                                        'Thực hiện bởi: <strong class="text-slate-800">' + byName + '</strong>' +
                                    '</div>' +
                                    (reason ? ('<div class="mt-2 text-slate-800 small p-2 rounded-2 border" style="background: #F8FAFC; border-color: #E2E8F0 !important;">' +
                                        '<strong class="text-slate-900">Lý do:</strong> ' + reason +
                                    '</div>') : '') +
                                    (notes ? ('<div class="mt-1.5 text-muted small fst-italic" style="font-size: 0.75rem;">' +
                                        '<strong>Ghi chú:</strong> ' + notes +
                                    '</div>') : '') +
                                '</div>';
                            if (historyTimelineList) historyTimelineList.appendChild(node);
                        });
                    } else {
                        if (historyEmptyState) historyEmptyState.style.display = 'block';
                    }
                } catch (err) {
                    console.error('Lỗi tải lịch sử chuyển giao:', err);
                    if (historyLoadingSpinner) historyLoadingSpinner.style.display = 'none';
                    if (historyEmptyState) historyEmptyState.style.display = 'block';
                }
            });
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initRequisitionAssignmentsPage);
    } else {
        initRequisitionAssignmentsPage();
    }
    window.initRequisitionAssignmentsPage = initRequisitionAssignmentsPage;
</script>
}
