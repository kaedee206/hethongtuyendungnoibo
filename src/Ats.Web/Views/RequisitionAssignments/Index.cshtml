@model Ats.Web.Models.ViewModels.RequisitionAssignments.RequisitionAssignmentListViewModel
@{
    ViewData["Title"] = "Phân công Recruiter Phụ trách";
}

<div class="container-fluid px-3 px-md-4 py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0" style="font-size: 0.85rem;">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
            <li class="breadcrumb-item"><span class="text-muted">Cơ cấu &amp; Tiêu chuẩn</span></li>
            <li class="breadcrumb-item active text-emerald-700 fw-semibold" aria-current="page">Phân công Recruiter</li>
        </ol>
    </nav>



    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge px-2.5 py-1 fw-semibold text-uppercase" 
                      style="font-size: 0.72rem; letter-spacing: 0.05em; background: #ECFDF5; color: #047857; border: 1px solid #A7F3D0; border-radius: 6px;">
                    <i class="bi bi-person-check-fill me-1"></i>Điều phối Tuyển dụng
                </span>
                <h1 class="h3 fw-bold text-slate-900 mb-0" style="color: #0F172A;">Phân công Recruiter Phụ trách</h1>
            </div>
            <p class="text-muted small mb-0">
                Chỉ định Chuyên viên tuyển dụng phụ trách chính, phân bổ đội ngũ phối hợp và theo dõi tải công việc theo từng vị trí tuyển dụng.
            </p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm px-3 d-flex align-items-center gap-1.5" 
                    id="btnRefreshData" style="border-radius: 8px;">
                <i class="bi bi-arrow-clockwise"></i>
                <span>Làm mới</span>
            </button>
        </div>
    </div>

    <!-- 4 Executive KPI Cards -->
    <div class="row g-3 mb-4">
        <!-- Tổng vị trí tuyển dụng -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 kpi-card" style="border-radius: 12px; background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
                <div class="card-body p-3.5">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.75rem;">Vị trí tuyển dụng</span>
                        <div class="rounded-circle d-flex align-items-center justify-content-center" 
                             style="width: 38px; height: 38px; background: #ECFDF5; color: #059669;">
                            <i class="bi bi-briefcase-fill fs-6"></i>
                        </div>
                    </div>
                    <div class="h3 fw-bold mb-0 font-monospace" style="color: #0F172A; font-family: 'JetBrains Mono', monospace;">
                        @Model.TotalRequisitions <span class="fs-6 fw-normal text-muted">yêu cầu</span>
                    </div>
                    <div class="text-muted small mt-1.5 d-flex align-items-center gap-1">
                        <i class="bi bi-check-circle text-emerald-600 small"></i>
                        <span>Đang mở tuyển hoặc cần phân bổ</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Đã phân công chính -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 kpi-card" style="border-radius: 12px; background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
                <div class="card-body p-3.5">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.75rem;">Đã có người phụ trách</span>
                        <div class="rounded-circle d-flex align-items-center justify-content-center" 
                             style="width: 38px; height: 38px; background: #F0FDF4; color: #16A34A;">
                            <i class="bi bi-person-check-fill fs-6"></i>
                        </div>
                    </div>
                    <div class="h3 fw-bold mb-0 font-monospace text-emerald-600" style="color: #059669; font-family: 'JetBrains Mono', monospace;">
                        @Model.AssignedRequisitionsCount <span class="fs-6 fw-normal text-muted">vị trí</span>
                    </div>
                    <div class="text-muted small mt-1.5 d-flex align-items-center gap-1">
                        <span class="badge" style="font-size: 0.7rem; background: #ECFDF5; color: #065F46; border: 1px solid #A7F3D0; border-radius: 6px;">
                            @Model.AssignedPercentage% hoàn tất
                        </span>
                        <span>Đã có Lead Recruiter</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cần phân công ngay -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 kpi-card cursor-pointer @(Model.UnassignedRequisitionsCount > 0 ? "border-amber-300" : "")" 
                 id="cardUnassignedFilter"
                 style="border-radius: 12px; background: @(Model.UnassignedRequisitionsCount > 0 ? "#FFFBEB" : "#FFFFFF"); border: 1px solid @(Model.UnassignedRequisitionsCount > 0 ? "#FCD34D" : "#E2E8F0") !important;">
                <div class="card-body p-3.5">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="small fw-semibold text-uppercase @(Model.UnassignedRequisitionsCount > 0 ? "text-amber-800" : "text-secondary")" style="letter-spacing: 0.05em; font-size: 0.75rem;">
                            Cần phân công ngay
                        </span>
                        <div class="rounded-circle d-flex align-items-center justify-content-center" 
                             style="width: 38px; height: 38px; background: @(Model.UnassignedRequisitionsCount > 0 ? "#FEF3C7" : "#F8FAFC"); color: @(Model.UnassignedRequisitionsCount > 0 ? "#D97706" : "#64748B");">
                            <i class="bi bi-exclamation-triangle-fill fs-6"></i>
                        </div>
                    </div>
                    <div class="h3 fw-bold mb-0 font-monospace @(Model.UnassignedRequisitionsCount > 0 ? "text-amber-700" : "text-slate-800")" 
                         style="font-family: 'JetBrains Mono', monospace;">
                        @Model.UnassignedRequisitionsCount <span class="fs-6 fw-normal text-muted">vị trí</span>
                    </div>
                    <div class="small mt-1.5 d-flex align-items-center gap-1 @(Model.UnassignedRequisitionsCount > 0 ? "text-amber-700 fw-medium" : "text-muted")">
                        @if (Model.UnassignedRequisitionsCount > 0)
                        {
                            <i class="bi bi-hand-index-thumb me-1"></i>
                            <span>Bấm để lọc vị trí chưa phân công</span>
                        }
                        else
                        {
                            <i class="bi bi-check-all text-success"></i>
                            <span>Tất cả vị trí đã được phân bổ</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Đội ngũ Recruiter -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 kpi-card cursor-pointer" 
                 id="cardRecruiterTabSwitch"
                 style="border-radius: 12px; background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
                <div class="card-body p-3.5">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.75rem;">Đội ngũ Recruiter</span>
                        <div class="rounded-circle d-flex align-items-center justify-content-center" 
                             style="width: 38px; height: 38px; background: #F1F5F9; color: #475569;">
                            <i class="bi bi-people-fill fs-6"></i>
                        </div>
                    </div>
                    <div class="h3 fw-bold mb-0 font-monospace text-slate-900" style="color: #0F172A; font-family: 'JetBrains Mono', monospace;">
                        @Model.TotalRecruitersCount <span class="fs-6 fw-normal text-muted">chuyên viên</span>
                    </div>
                    <div class="text-muted small mt-1.5 d-flex align-items-center gap-1">
                        <i class="bi bi-bar-chart-line text-slate-500"></i>
                        <span>Xem ma trận tải công việc &rarr;</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-tabs border-bottom mb-4" id="assignmentViewTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-semibold d-flex align-items-center gap-2 py-2.5 px-3.5" 
                    id="tab-requisitions-btn" data-bs-toggle="tab" data-bs-target="#tab-requisitions" 
                    type="button" role="tab" aria-controls="tab-requisitions" aria-selected="true"
                    style="border-top-left-radius: 8px; border-top-right-radius: 8px;">
                <i class="bi bi-list-task"></i>
                <span>Theo Vị trí tuyển dụng</span>
                <span class="badge font-monospace tab-counter-badge" style="font-size: 0.75rem; background: #F1F5F9; color: #1E293B; border: 1px solid #CBD5E1; border-radius: 6px; padding: 2px 8px;">
                    @Model.TotalRequisitions
                </span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold d-flex align-items-center gap-2 py-2.5 px-3.5" 
                    id="tab-workloads-btn" data-bs-toggle="tab" data-bs-target="#tab-workloads" 
                    type="button" role="tab" aria-controls="tab-workloads" aria-selected="false"
                    style="border-top-left-radius: 8px; border-top-right-radius: 8px;">
                <i class="bi bi-speedometer2"></i>
                <span>Khối lượng &amp; Năng lực Recruiter</span>
                <span class="badge font-monospace tab-counter-badge" style="font-size: 0.75rem; background: #F1F5F9; color: #1E293B; border: 1px solid #CBD5E1; border-radius: 6px; padding: 2px 8px;">
                    @Model.TotalRecruitersCount
                </span>
            </button>
        </li>
    </ul>

    <!-- Tab Contents -->
    <div class="tab-content" id="assignmentTabContent">
        <!-- ========================================== -->
        <!-- TAB 1: DANH SÁCH VỊ TRÍ TUYỂN DỤNG        -->
        <!-- ========================================== -->
        <div class="tab-pane fade show active" id="tab-requisitions" role="tabpanel" aria-labelledby="tab-requisitions-btn">
            
            <!-- Filter & Search Toolbar -->
            <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
                <div class="card-body p-3">
                    <div class="row g-2.5 align-items-center">
                        <!-- Search Input -->
                        <div class="col-12 col-md-4">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-slate-50 border-end-0 text-muted" style="border-radius: 8px 0 0 8px; border-color: #E2E8F0;">
                                    <i class="bi bi-search text-slate-400"></i>
                                </span>
                                <input type="text" id="filterSearchInput" class="form-control bg-slate-50 border-start-0" 
                                       placeholder="Tìm theo mã yêu cầu, chức danh, phòng ban..." 
                                       value="@Model.Search"
                                       style="border-radius: 0 8px 8px 0; border-color: #E2E8F0; font-size: 0.85rem;">
                            </div>
                        </div>

                        <!-- Department Filter -->
                        <div class="col-6 col-md-3">
                            <select id="filterDepartmentSelect" class="form-select form-select-sm" style="border-radius: 8px; border-color: #E2E8F0; font-size: 0.85rem;">
                                <option value="">-- Tất cả phòng ban --</option>
                                @foreach (var dept in Model.Departments)
                                {
                                    <option value="@dept" selected="@(Model.SelectedDepartmentName == dept)">@dept</option>
                                }
                            </select>
                        </div>

                        <!-- Recruiter Filter -->
                        <div class="col-6 col-md-3">
                            <select id="filterRecruiterSelect" class="form-select form-select-sm" style="border-radius: 8px; border-color: #E2E8F0; font-size: 0.85rem;">
                                <option value="">-- Tất cả Recruiter --</option>
                                @foreach (var rec in Model.AvailableRecruiters)
                                {
                                    <option value="@rec.UserId" selected="@(Model.SelectedRecruiterId == rec.UserId)">@rec.FullName (@rec.ActiveLeadCount chính / @rec.ActiveSupportingCount phụ)</option>
                                }
                            </select>
                        </div>

                        <!-- Status Quick Pills -->
                        <div class="col-12 col-md-2 d-flex justify-content-md-end">
                            <select id="filterStatusSelect" class="form-select form-select-sm" style="border-radius: 8px; border-color: #E2E8F0; font-size: 0.85rem;">
                                <option value="" selected="@(string.IsNullOrEmpty(Model.AssignmentFilter) || Model.AssignmentFilter == "ALL")">-- Tất cả trạng thái --</option>
                                <option value="UNASSIGNED" selected="@(Model.AssignmentFilter == "UNASSIGNED")">Chưa phân công</option>
                                <option value="ASSIGNED" selected="@(Model.AssignmentFilter == "ASSIGNED")">Đã có phụ trách</option>
                            </select>
                        </div>
                    </div>

                    <!-- Quick Filter Badges -->
                    <div class="d-flex flex-wrap gap-2 mt-2.5 pt-2.5 border-top align-items-center" style="border-color: #F1F5F9 !important;">
                        <span class="text-muted small fw-medium me-1" style="font-size: 0.78rem;">Lọc nhanh:</span>
                        <button type="button" class="btn btn-xs quick-filter-btn @(string.IsNullOrEmpty(Model.AssignmentFilter) || Model.AssignmentFilter == "ALL" ? "active" : "")" data-filter="ALL" 
                                style="font-size: 0.75rem; border-radius: 6px; padding: 3px 10px;">
                            Tất cả (@Model.TotalRequisitions)
                        </button>
                        <button type="button" class="btn btn-xs quick-filter-btn @(Model.AssignmentFilter == "UNASSIGNED" ? "active btn-warning-soft" : (Model.UnassignedRequisitionsCount > 0 ? "btn-warning-soft" : ""))" 
                                data-filter="UNASSIGNED" 
                                style="font-size: 0.75rem; border-radius: 6px; padding: 3px 10px;">
                            <i class="bi bi-exclamation-circle me-1"></i>Cần phân công ngay (@Model.UnassignedRequisitionsCount)
                        </button>
                        <button type="button" class="btn btn-xs quick-filter-btn @(Model.AssignmentFilter == "ASSIGNED" ? "active" : "")" data-filter="ASSIGNED" 
                                style="font-size: 0.75rem; border-radius: 6px; padding: 3px 10px;">
                            <i class="bi bi-check2 me-1"></i>Đã phân công (@Model.AssignedRequisitionsCount)
                        </button>
                        <button type="button" class="btn btn-link btn-sm text-muted text-decoration-none ms-auto p-0" id="btnResetFilters" style="font-size: 0.78rem;">
                            <i class="bi bi-x-circle me-1"></i>Xóa bộ lọc
                        </button>
                    </div>
                </div>
            </div>

            <!-- Requisitions List Table -->
            <div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden; border: 1px solid #E2E8F0 !important;">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="assignmentsTable">
                        <thead class="bg-slate-50 text-slate-600 small text-uppercase fw-semibold" 
                               style="letter-spacing: 0.05em; font-size: 0.73rem; border-bottom: 1px solid #E2E8F0;">
                            <tr>
                                <th class="ps-4 py-3" style="width: 26%;">Vị trí tuyển dụng</th>
                                <th class="py-3" style="width: 17%;">Phòng ban &amp; Cấp bậc</th>
                                <th class="py-3" style="width: 22%;">Chuyên viên phụ trách chính</th>
                                <th class="py-3" style="width: 16%;">Đội ngũ hỗ trợ</th>
                                <th class="py-3 text-center" style="width: 9%;">Hồ sơ</th>
                                <th class="pe-4 py-3 text-end" style="width: 10%;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100" style="font-size: 0.88rem;">
                            @if (!Model.Items.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <div class="py-4">
                                            <i class="bi bi-inbox fs-1 d-block mb-2 text-slate-300"></i>
                                            <div class="fw-medium text-slate-700">Không có yêu cầu tuyển dụng nào phù hợp điều kiện lọc.</div>
                                            <p class="small text-muted mt-1">Hãy thử xóa bộ lọc hoặc tìm kiếm với từ khóa khác.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model.Items)
                                {
                                    <tr class="assignment-row" 
                                        data-requisition-id="@item.RequisitionId"
                                        data-title="@item.JobTitle.ToLower()"
                                        data-code="@item.Code.ToLower()"
                                        data-dept="@item.DepartmentName"
                                        data-lead-id="@(item.LeadRecruiterId?.ToString() ?? "")"
                                        data-support-ids="@string.Join(",", item.SupportingRecruiters.Select(s => s.RecruiterId))"
                                        data-status="@(item.HasLeadRecruiter ? "ASSIGNED" : "UNASSIGNED")">
                                        
                                        <!-- Vị trí -->
                                        <td class="ps-4 py-3.5">
                                            <div class="d-flex align-items-center gap-2.5">
                                                <div class="rounded-3 d-flex align-items-center justify-content-center fw-bold @(item.HasLeadRecruiter ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-amber-50 text-amber-700 border border-amber-200")"
                                                     style="width: 40px; height: 40px; min-width: 40px; font-size: 0.88rem;">
                                                    <i class="bi @(item.HasLeadRecruiter ? "bi-briefcase" : "bi-exclamation-triangle")"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-semibold text-slate-900" style="color: #0F172A;">@item.JobTitle</div>
                                                    <div class="d-flex align-items-center gap-2 mt-1">
                                                        <span class="badge font-monospace" 
                                                              style="font-size: 0.72rem; font-family: 'JetBrains Mono', monospace; background: #F1F5F9; color: #0F172A; border: 1px solid #CBD5E1; border-radius: 6px;">
                                                            @item.Code
                                                        </span>
                                                        <span class="text-muted small">
                                                            Chỉ tiêu: <strong class="text-slate-900">@item.Quantity</strong>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>

                                        <!-- Phòng ban & Cấp bậc -->
                                        <td class="py-3.5">
                                            <div class="fw-medium text-slate-800 small">@item.DepartmentName</div>
                                            <div class="d-flex align-items-center gap-1.5 mt-1">
                                                <span class="badge" style="font-size: 0.7rem; background: #F8FAFC; color: #334155; border: 1px solid #CBD5E1; border-radius: 6px;">
                                                    @(string.IsNullOrWhiteSpace(item.JobLevel) ? "Middle" : item.JobLevel)
                                                </span>
                                                <span class="badge @item.StatusBadgeClass" style="font-size: 0.7rem; border-radius: 6px;">
                                                    @item.StatusDisplay
                                                </span>
                                            </div>
                                        </td>

                                        <!-- Chuyên viên phụ trách chính -->
                                        <td class="py-3.5">
                                            @if (item.HasLeadRecruiter)
                                            {
                                                <div class="d-flex align-items-center gap-2.5">
                                                    <div class="avatar rounded-circle d-flex align-items-center justify-content-center fw-bold text-white shadow-xs"
                                                         style="width: 34px; height: 34px; font-size: 0.78rem; background: linear-gradient(135deg, #059669 0%, #10B981 100%);">
                                                        @item.LeadRecruiterAvatarLetter
                                                    </div>
                                                    <div>
                                                        <div class="fw-semibold text-slate-900 small d-flex align-items-center gap-1.5" style="color: #0F172A;">
                                                            <span>@item.LeadRecruiterName</span>
                                                            <i class="bi bi-star-fill text-amber-500" style="font-size: 0.7rem;" title="Phụ trách chính"></i>
                                                        </div>
                                                        <div class="text-muted" style="font-size: 0.75rem;">@item.LeadRecruiterEmail</div>
                                                        <div class="mt-1 d-flex align-items-center gap-1.5">
                                                            <span class="badge" style="font-size: 0.65rem; background: #ECFDF5; color: #065F46; border: 1px solid #A7F3D0; border-radius: 6px;">
                                                                Phụ trách chính
                                                            </span>
                                                            @if (item.HandoverCount > 0)
                                                            {
                                                                <span class="text-muted" style="font-size: 0.68rem;" title="@item.HandoverCount lần điều chuyển">
                                                                    <i class="bi bi-arrow-repeat me-0.5"></i>@item.HandoverCount
                                                                </span>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="p-2 rounded-3 border border-dashed border-amber-300 bg-amber-50 d-inline-flex align-items-center gap-2">
                                                    <i class="bi bi-exclamation-circle text-amber-600 fs-6"></i>
                                                    <div>
                                                        <div class="fw-bold text-amber-800" style="font-size: 0.78rem;">Chưa có phụ trách</div>
                                                        <button type="button" class="btn btn-link btn-xs p-0 text-amber-700 text-decoration-none fw-semibold btn-assign-action"
                                                                data-req-id="@item.RequisitionId"
                                                                data-req-code="@item.Code"
                                                                data-req-title="@item.JobTitle"
                                                                data-req-dept="@item.DepartmentName"
                                                                data-req-quantity="@item.Quantity"
                                                                data-req-candidates="@item.TotalCandidatesCount"
                                                                data-lead-id=""
                                                                data-support-ids=""
                                                                style="font-size: 0.72rem;">
                                                            + Chỉ định ngay &rarr;
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        </td>

                                        <!-- Đội ngũ hỗ trợ -->
                                        <td class="py-3.5">
                                            @if (item.SupportingRecruiters.Any())
                                            {
                                                <div class="d-flex flex-wrap gap-1 align-items-center">
                                                    @foreach (var supp in item.SupportingRecruiters)
                                                    {
                                                        <span class="badge d-inline-flex align-items-center gap-1 py-1 px-2"
                                                              style="font-size: 0.73rem; background: #F1F5F9; color: #0F172A; border: 1px solid #CBD5E1; border-radius: 6px;" title="@supp.Email">
                                                            <i class="bi bi-person-fill" style="font-size: 0.7rem; color: #64748B;"></i>
                                                            @supp.FullName
                                                        </span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small fst-italic" style="font-size: 0.78rem;">Chưa có hỗ trợ</span>
                                            }
                                        </td>

                                        <!-- Hồ sơ ứng viên -->
                                        <td class="py-3.5 text-center">
                                            <div class="fw-bold font-monospace text-slate-900" style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem;">
                                                @item.InProcessCandidatesCount / @item.TotalCandidatesCount
                                            </div>
                                            <div class="text-muted mt-0.5" style="font-size: 0.68rem;">đang xử lý / tổng</div>
                                            @if (item.TotalCandidatesCount > 0)
                                            {
                                                var pct = Math.Min(100, (int)Math.Round((double)item.InProcessCandidatesCount * 100 / item.TotalCandidatesCount));
                                                <div class="progress mt-1.5" style="height: 4px; background: #E2E8F0;">
                                                    <div class="progress-bar bg-emerald-600" role="progressbar" style="width: @pct%;"></div>
                                                </div>
                                            }
                                        </td>

                                        <!-- Thao tác phân công & Lịch sử -->
                                        <td class="pe-4 py-3.5 text-end text-nowrap">
                                            <div class="d-inline-flex align-items-center justify-content-end gap-1.5">
                                                <button type="button" class="btn btn-sm @(item.HasLeadRecruiter ? "btn-outline-primary" : "btn-novera-emerald") btn-assign-action d-inline-flex align-items-center gap-1.5 px-2.5 py-1"
                                                        data-req-id="@item.RequisitionId"
                                                        data-req-code="@item.Code"
                                                        data-req-title="@item.JobTitle"
                                                        data-req-dept="@item.DepartmentName"
                                                        data-req-quantity="@item.Quantity"
                                                        data-req-candidates="@item.TotalCandidatesCount"
                                                        data-lead-id="@(item.LeadRecruiterId?.ToString() ?? "")"
                                                        data-support-ids="@string.Join(",", item.SupportingRecruiters.Select(s => s.RecruiterId))"
                                                        data-bs-toggle="tooltip" data-bs-placement="top"
                                                        title="@(item.HasLeadRecruiter ? "Điều chuyển / Thay đổi Recruiter phụ trách" : "Phân công chuyên viên phụ trách")">
                                                    <i class="bi @(item.HasLeadRecruiter ? "bi-arrow-left-right" : "bi-person-plus")"></i>
                                                    <span class="small fw-semibold">@(item.HasLeadRecruiter ? "Điều chuyển" : "Phân công")</span>
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary btn-action-icon btn-history-action"
                                                        data-req-id="@item.RequisitionId"
                                                        data-req-title="@item.JobTitle"
                                                        data-bs-toggle="tooltip" data-bs-placement="top"
                                                        title="Xem lịch sử chuyển giao">
                                                    <i class="bi bi-clock-history"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Card Footer: Thanh Phân Trang Backend Chuẩn Đẹp (5 / 10 / 25 / 50 / 75 / 100) -->
                @if (Model.TotalRecords > 0)
                {
                    <div class="card-footer bg-white border-top py-3 px-3 px-md-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3" style="border-color: #E2E8F0 !important;">
                        <!-- Bên trái: Bộ chọn số dòng / trang và phạm vi bản ghi -->
                        <div class="d-flex flex-wrap align-items-center gap-2 small text-muted">
                            <span>Hiển thị:</span>
                            <select id="selectPageSize" class="form-select form-select-sm" style="width: auto; font-size: 0.8rem; border-color: #CBD5E1; border-radius: 6px;">
                                @foreach (var size in Ats.Web.Models.ViewModels.RequisitionAssignments.RequisitionAssignmentListViewModel.AllowedPageSizes)
                                {
                                    <option value="@size" selected="@(Model.PageSize == size)">@size dòng / trang</option>
                                }
                            </select>
                            <span>
                                (Từ <strong class="text-slate-900 font-monospace">@Model.FromItemIndex</strong> đến <strong class="text-slate-900 font-monospace">@Model.ToItemIndex</strong> trong tổng số <strong class="text-slate-900 font-monospace">@Model.TotalRecords</strong> yêu cầu)
                            </span>
                        </div>

                        <!-- Bên phải: Nút phân trang Trước / Số trang / Tiếp -->
                        @if (Model.TotalPages > 1)
                        {
                            <nav aria-label="Phân trang vị trí tuyển dụng">
                                <ul class="pagination pagination-sm mb-0 gap-1">
                                    <!-- Nút Trước -->
                                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                        <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage - 1, pageSize = Model.PageSize, search = Model.Search, department = Model.SelectedDepartmentName, departmentId = Model.SelectedDepartmentId, recruiterId = Model.SelectedRecruiterId, filter = Model.AssignmentFilter })" 
                                           style="border-radius: 6px;" aria-label="Trang trước">
                                            <i class="bi bi-chevron-left me-1"></i>Trước
                                        </a>
                                    </li>

                                    <!-- Các số trang thông minh -->
                                    @for (int p = 1; p <= Model.TotalPages; p++)
                                    {
                                        if (Model.TotalPages <= 7 || p == 1 || p == Model.TotalPages || Math.Abs(p - Model.CurrentPage) <= 1)
                                        {
                                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                                <a class="page-link" href="@Url.Action("Index", new { page = p, pageSize = Model.PageSize, search = Model.Search, department = Model.SelectedDepartmentName, departmentId = Model.SelectedDepartmentId, recruiterId = Model.SelectedRecruiterId, filter = Model.AssignmentFilter })" 
                                                   style="border-radius: 6px;">@p</a>
                                            </li>
                                        }
                                        else if ((p == 2 && Model.CurrentPage > 3) || (p == Model.TotalPages - 1 && Model.CurrentPage < Model.TotalPages - 2))
                                        {
                                            <li class="page-item disabled"><span class="page-link" style="border-radius: 6px;">...</span></li>
                                        }
                                    }

                                    <!-- Nút Tiếp -->
                                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                        <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage + 1, pageSize = Model.PageSize, search = Model.Search, department = Model.SelectedDepartmentName, departmentId = Model.SelectedDepartmentId, recruiterId = Model.SelectedRecruiterId, filter = Model.AssignmentFilter })" 
                                           style="border-radius: 6px;" aria-label="Trang tiếp">
                                            Tiếp<i class="bi bi-chevron-right ms-1"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- ========================================== -->
        <!-- TAB 2: NĂNG LỰC & TẢI CÔNG VIỆC RECRUITER  -->
        <!-- ========================================== -->
        <div class="tab-pane fade" id="tab-workloads" role="tabpanel" aria-labelledby="tab-workloads-btn">
            
            <!-- Workload Overview Banner -->
            <div class="p-3.5 rounded-3 mb-4 border d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3"
                 style="background: #F8FAFC; border-color: #E2E8F0 !important;">
                <div>
                    <h6 class="fw-bold text-slate-900 mb-1" style="color: #0F172A;">Ma trận Phân bổ Khối lượng công việc Đội ngũ</h6>
                    <p class="text-muted small mb-0">
                        Giúp Trưởng phòng Nhân sự quan sát tải công việc thời gian thực của từng chuyên viên để phân công cân đối, tránh quá tải và tối ưu tốc độ tuyển dụng.
                    </p>
                </div>
                <div class="d-flex align-items-center gap-3 text-nowrap">
                    <div class="d-flex align-items-center gap-1.5 small">
                        <span class="d-inline-block rounded-circle" style="width: 8px; height: 8px; background-color: #059669;"></span>
                        <span class="text-muted">Sẵn sàng nhận: 0-1</span>
                    </div>
                    <div class="d-flex align-items-center gap-1.5 small">
                        <span class="d-inline-block rounded-circle" style="width: 8px; height: 8px; background-color: #2563EB;"></span>
                        <span class="text-muted">Cân bằng: 2-4</span>
                    </div>
                    <div class="d-flex align-items-center gap-1.5 small">
                        <span class="d-inline-block rounded-circle" style="width: 8px; height: 8px; background-color: #D97706;"></span>
                        <span class="text-muted">Tải cao: &ge; 5</span>
                    </div>
                </div>
            </div>

            <!-- Recruiter Workload Cards Grid -->
            <div class="row g-3">
                @if (!Model.RecruiterWorkloads.Any())
                {
                    <div class="col-12 text-center py-5 text-muted">
                        <i class="bi bi-people fs-1 d-block mb-2 text-slate-300"></i>
                        <div>Chưa có dữ liệu chuyên viên tuyển dụng trong hệ thống.</div>
                    </div>
                }
                else
                {
                    @foreach (var rec in Model.RecruiterWorkloads)
                    {
                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="card border-0 shadow-sm h-100 recruiter-workload-card" 
                                 style="border-radius: 12px; background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
                                <div class="card-body p-3.5">
                                    <!-- Header: Avatar, Name, Badge -->
                                    <div class="d-flex align-items-start justify-content-between mb-3">
                                        <div class="d-flex align-items-center gap-2.5">
                                            <div class="avatar rounded-circle d-flex align-items-center justify-content-center fw-bold text-white shadow-xs"
                                                 style="width: 42px; height: 42px; font-size: 0.95rem; background: linear-gradient(135deg, #059669 0%, #10B981 100%);">
                                                @rec.AvatarLetter
                                            </div>
                                            <div>
                                                <h6 class="fw-bold text-slate-900 mb-0" style="color: #0F172A;">@rec.FullName</h6>
                                                <div class="text-muted small">@rec.Email</div>
                                                <div class="text-muted" style="font-size: 0.72rem;">@rec.DepartmentName - @rec.JobTitle</div>
                                            </div>
                                        </div>
                                        <span class="badge @rec.WorkloadBadgeClass border px-2 py-1" style="font-size: 0.7rem;">
                                            @rec.WorkloadLevel
                                        </span>
                                    </div>

                                    <!-- 3 Metric Boxes -->
                                    <div class="row g-2 text-center mb-3">
                                        <div class="col-4">
                                            <div class="p-2 rounded-2 bg-slate-50 border border-slate-100">
                                                <div class="h5 fw-bold mb-0 text-emerald-700 font-monospace" style="font-family: 'JetBrains Mono', monospace;">
                                                    @rec.LeadCount
                                                </div>
                                                <div class="text-muted small" style="font-size: 0.7rem;">Phụ trách chính</div>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="p-2 rounded-2 bg-slate-50 border border-slate-100">
                                                <div class="h5 fw-bold mb-0 text-slate-700 font-monospace" style="font-family: 'JetBrains Mono', monospace;">
                                                    @rec.SupportCount
                                                </div>
                                                <div class="text-muted small" style="font-size: 0.7rem;">Hỗ trợ</div>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="p-2 rounded-2 bg-slate-50 border border-slate-100">
                                                <div class="h5 fw-bold mb-0 text-slate-700 font-monospace" style="font-family: 'JetBrains Mono', monospace;">
                                                    @rec.TotalCandidatesInPipeline
                                                </div>
                                                <div class="text-muted small" style="font-size: 0.7rem;">Ứng viên đang chạy</div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Workload Visual Bar -->
                                    @{
                                        var targetBenchmark = 5.0; // Định mức chuẩn 5 vị trí lead
                                        var progressPct = Math.Min(100, (int)Math.Round((rec.LeadCount / targetBenchmark) * 100));
                                        var barColor = rec.LeadCount > 5 ? "bg-amber-500" : (rec.LeadCount >= 2 ? "bg-emerald-600" : "bg-blue-500");
                                    }
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1 small text-muted" style="font-size: 0.72rem;">
                                            <span>Mức độ tải vị trí</span>
                                            <span class="fw-medium text-slate-700">@rec.LeadCount vị trí / định mức 5</span>
                                        </div>
                                        <div class="progress" style="height: 6px; background: #F1F5F9; border-radius: 4px;">
                                            <div class="progress-bar @barColor" role="progressbar" style="width: @progressPct%;"></div>
                                        </div>
                                    </div>

                                    <!-- Current Assigned Jobs -->
                                    <div class="border-top pt-2.5 mt-2.5" style="border-color: #F1F5F9 !important;">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="text-muted small fw-semibold" style="font-size: 0.72rem;">Vị trí đang phụ trách:</span>
                                            <span class="badge font-monospace" style="font-size: 0.68rem; background: #F1F5F9; color: #1E293B; border: 1px solid #CBD5E1; border-radius: 6px;">
                                                @rec.AssignedPositions.Count vị trí
                                            </span>
                                        </div>
                                        @if (!rec.AssignedPositions.Any())
                                        {
                                            <div class="text-muted small fst-italic py-1" style="font-size: 0.75rem;">
                                                Chưa được phân công vị trí nào. Sẵn sàng tiếp nhận nhiệm vụ.
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-column gap-1.5" style="max-height: 120px; overflow-y: auto;">
                                                @foreach (var pos in rec.AssignedPositions.Take(4))
                                                {
                                                    var isLeadHere = pos.LeadRecruiterId == rec.RecruiterId;
                                                    <div class="d-flex align-items-center justify-content-between p-1.5 rounded-2 bg-slate-50 border border-slate-100" style="font-size: 0.75rem;">
                                                        <div class="text-truncate me-2">
                                                            <strong class="text-slate-900">@pos.JobTitle</strong>
                                                            <span class="text-muted ms-1 font-monospace">@pos.Code</span>
                                                        </div>
                                                        <span class="badge text-nowrap" style="font-size: 0.65rem; border-radius: 6px; @(isLeadHere ? "background: #ECFDF5; color: #065F46; border: 1px solid #A7F3D0;" : "background: #F1F5F9; color: #1E293B; border: 1px solid #CBD5E1;")">
                                                            @(isLeadHere ? "Lead" : "Support")
                                                        </span>
                                                    </div>
                                                }
                                                @if (rec.AssignedPositions.Count > 4)
                                                {
                                                    <div class="text-muted text-center small" style="font-size: 0.7rem;">
                                                        + @(rec.AssignedPositions.Count - 4) vị trí khác...
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL 1: PHÂN CÔNG / ĐIỀU CHUYỂN RECRUITER -->
<!-- ========================================== -->
<div class="modal fade" id="assignModal" tabindex="-1" aria-labelledby="assignModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 14px; overflow: hidden;">
            <!-- Modal Header with Emerald Accent -->
            <div class="modal-header border-0 pb-3" style="background: #0F172A; color: #FFFFFF;">
                <div class="d-flex align-items-center gap-2.5">
                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white" 
                         style="width: 40px; height: 40px; background: rgba(16, 185, 129, 0.2); border: 1px solid rgba(16, 185, 129, 0.4);">
                        <i class="bi bi-person-check fs-5 text-emerald-400"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0 text-white" id="assignModalLabel">Phân công Chuyên viên Tuyển dụng</h5>
                        <p class="small mb-0 text-slate-300" style="font-size: 0.78rem;">
                            Chỉ định chuyên viên phụ trách chính và phân bổ đội ngũ phối hợp tuyển dụng
                        </p>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form id="assignForm" method="post" action="/phan-cong-recruiter/assign">
                @Html.AntiForgeryToken()
                <input type="hidden" name="RequisitionId" id="modalRequisitionId" />
                <input type="hidden" id="modalCurrentLeadId" />

                <div class="modal-body p-4">
                    <!-- Position Info Card -->
                    <div class="p-3 rounded-3 border mb-4" style="background: #F8FAFC; border-color: #E2E8F0 !important;">
                        <div class="row g-2 align-items-center">
                            <div class="col-sm-8">
                                <span class="badge font-monospace mb-1" 
                                      id="modalReqCode" style="font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; background: #E2E8F0; color: #0F172A; border: 1px solid #CBD5E1; border-radius: 6px;">
                                    REQ-CODE
                                </span>
                                <h6 class="fw-bold text-slate-900 mb-0.5" id="modalReqTitle" style="color: #0F172A;">Chức danh tuyển dụng</h6>
                                <div class="text-muted small" id="modalReqDepartment" style="font-size: 0.78rem;">Phòng ban: Công nghệ thông tin</div>
                            </div>
                            <div class="col-sm-4 text-sm-end">
                                <div class="text-muted small" style="font-size: 0.75rem;">Chỉ tiêu / Hồ sơ hiện có:</div>
                                <div class="fw-bold font-monospace text-slate-900 fs-6" id="modalReqCountInfo" style="font-family: 'JetBrains Mono', monospace;">
                                    0 chỉ tiêu / 0 ứng viên
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 1. CHỈ ĐỊNH RECRUITER CHÍNH -->
                    <div class="mb-4">
                        <label for="modalLeadSelect" class="form-label fw-bold text-slate-900 d-flex align-items-center justify-content-between">
                            <span class="d-flex align-items-center gap-1.5">
                                <i class="bi bi-star-fill text-amber-500"></i>
                                <span>Chuyên viên phụ trách chính (Lead Recruiter) <span class="text-danger">*</span></span>
                            </span>
                            <span class="badge" style="font-size: 0.7rem; background: #F8FAFC; color: #334155; border: 1px solid #CBD5E1; border-radius: 6px;">Bắt buộc 01 người</span>
                        </label>
                        <select name="LeadRecruiterId" id="modalLeadSelect" class="form-select form-select-lg" required 
                                style="border-radius: 8px; border-color: #CBD5E1; font-size: 0.92rem;">
                            <option value="">-- Chọn Chuyên viên chịu trách nhiệm chính --</option>
                            @foreach (var rec in Model.AvailableRecruiters)
                            {
                                <option value="@rec.UserId" data-name="@rec.FullName" data-lead-count="@rec.ActiveLeadCount">
                                    @rec.FullName - @rec.Email (Đang lead: @rec.ActiveLeadCount vị trí | @(rec.ActiveLeadCount > 5 ? "Tải cao" : "Cân bằng"))
                                </option>
                            }
                        </select>
                        <div class="form-text text-muted mt-1.5" style="font-size: 0.78rem;">
                            <i class="bi bi-info-circle me-1 text-slate-400"></i>
                            Chuyên viên phụ trách chính sẽ toàn quyền quản lý quy trình, phân loại hồ sơ, điều phối phỏng vấn và xúc tiến offer cho vị trí này.
                        </div>
                    </div>

                    <!-- 2. RECRUITER HỖ TRỢ (CHECKBOX LIST) -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-slate-900 d-flex align-items-center justify-content-between">
                            <span class="d-flex align-items-center gap-1.5">
                                <i class="bi bi-people-fill text-slate-600"></i>
                                <span>Chuyên viên phối hợp hỗ trợ (Tùy chọn)</span>
                            </span>
                            <span class="text-muted small" style="font-size: 0.72rem;">Có thể chọn nhiều người</span>
                        </label>
                        <div class="border rounded-3 p-3 bg-slate-50" style="max-height: 190px; overflow-y: auto; border-color: #E2E8F0 !important;">
                            <div class="row g-2" id="supportingRecruitersContainer">
                                @foreach (var rec in Model.AvailableRecruiters)
                                {
                                    <div class="col-12 col-md-6 supporting-option-wrapper" data-user-id="@rec.UserId">
                                        <div class="form-check p-2.5 rounded-2 bg-white border" style="border-color: #E2E8F0 !important;">
                                            <input class="form-check-input supporting-check" type="checkbox" 
                                                   name="SupportingRecruiterIds" value="@rec.UserId" 
                                                   id="supp_@rec.UserId">
                                            <label class="form-check-label d-block text-truncate small ms-1" for="supp_@rec.UserId">
                                                <strong class="text-slate-900">@rec.FullName</strong>
                                                <div class="text-muted" style="font-size: 0.72rem;">@rec.Email (@rec.ActiveLeadCount chính / @rec.ActiveSupportingCount phụ)</div>
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="form-text text-muted mt-1.5" style="font-size: 0.78rem;">
                            Các chuyên viên hỗ trợ có quyền tiếp cận hồ sơ để hỗ trợ sàng lọc CV và tham gia điều phối lịch phỏng vấn khi cần.
                        </div>
                    </div>

                    <!-- 3. BOX ĐIỀU CHUYỂN / BÀN GIAO (BẮT BUỘC KHI THAY ĐỔI LEAD RECRUITER) -->
                    <div id="handoverSection" class="p-3.5 rounded-3 border border-amber-300 bg-amber-50 mb-3" style="display: none;">
                        <div class="d-flex align-items-center gap-2 mb-2 text-amber-900 fw-bold">
                            <i class="bi bi-arrow-left-right text-amber-600 fs-5"></i>
                            <span>Xác nhận Điều chuyển &amp; Bàn giao Trách nhiệm Phụ trách</span>
                        </div>
                        <p class="small text-amber-800 mb-3" style="font-size: 0.78rem;">
                            Hệ thống tự động ghi nhật ký chuyển giao công việc khi thay đổi người phụ trách chính để đảm bảo tính minh bạch và liền mạch dữ liệu.
                        </p>
                        
                        <div class="mb-3">
                            <label for="modalReasonInput" class="form-label fw-bold text-slate-900 small">
                                Lý do chuyển giao công việc <span class="text-danger">*</span>
                            </label>
                            <textarea name="Reason" id="modalReasonInput" rows="2" class="form-control form-control-sm"
                                      placeholder="Ví dụ: Tối ưu khối lượng công việc đội ngũ, nhân sự nghỉ phép dài hạn, điều chuyển dự án ưu tiên..."></textarea>
                            <div class="invalid-feedback">Vui lòng nhập lý do chuyển giao người phụ trách.</div>
                        </div>

                        <div>
                            <label for="modalNotesInput" class="form-label fw-bold text-slate-900 small">
                                Ghi chú bàn giao &amp; Tiến độ ứng viên hiện tại (Tùy chọn)
                            </label>
                            <textarea name="Notes" id="modalNotesInput" rows="2" class="form-control form-control-sm"
                                      placeholder="Ghi chú về các hồ sơ đang trong vòng phỏng vấn, đầu mối liên hệ tiếp theo..."></textarea>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-0 pt-0 px-4 pb-4">
                    <button type="button" class="btn btn-light px-3.5" data-bs-dismiss="modal" style="border-radius: 8px;">Hủy bỏ</button>
                    <button type="submit" class="btn btn-novera-emerald px-4 fw-semibold" id="btnSubmitAssign">
                        <i class="bi bi-check2 me-1"></i>Lưu phân công
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL 2: LỊCH SỬ CHUYỂN GIAO (TIMELINE)   -->
<!-- ========================================== -->
<div class="modal fade" id="historyModal" tabindex="-1" aria-labelledby="historyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 14px; overflow: hidden;">
            <div class="modal-header border-0 pb-3" style="background: #0F172A; color: #FFFFFF;">
                <div class="d-flex align-items-center gap-2.5">
                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white" 
                         style="width: 40px; height: 40px; background: rgba(148, 163, 184, 0.2); border: 1px solid rgba(148, 163, 184, 0.4);">
                        <i class="bi bi-clock-history fs-5 text-slate-200"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-white mb-0" id="historyModalLabel">Lịch sử Chuyển giao Recruiter</h5>
                        <p class="small mb-0 text-slate-300" id="historyModalSubtitle" style="font-size: 0.78rem;">
                            Nhật ký phân công và chuyển giao trách nhiệm tuyển dụng
                        </p>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <div id="historyLoadingSpinner" class="text-center py-4">
                    <div class="spinner-border text-emerald-600" role="status" style="color: #059669;">
                        <span class="visually-hidden">Đang tải...</span>
                    </div>
                    <div class="text-muted small mt-2">Đang tải lịch sử chuyển giao...</div>
                </div>

                <div id="historyTimelineContainer" style="display: none;">
                    <div class="timeline" id="historyTimelineList">
                        <!-- Dynamically injected -->
                    </div>
                </div>

                <div id="historyEmptyState" class="text-center py-5 text-muted" style="display: none;">
                    <i class="bi bi-journal-text fs-1 text-slate-300 mb-2 d-block"></i>
                    <div class="fw-medium text-slate-700">Chưa có lịch sử chuyển giao nào được ghi nhận</div>
                    <p class="small text-muted mt-1">Vị trí này vẫn giữ nguyên người phụ trách ban đầu.</p>
                </div>
            </div>

            <div class="modal-footer border-0 pt-0 px-4 pb-4">
                <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal" style="border-radius: 8px;">Đóng</button>
            </div>
        </div>
    </div>
</div>

