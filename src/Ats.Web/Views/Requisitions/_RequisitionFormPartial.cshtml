@model Ats.Web.Models.ViewModels.Requisitions.RequisitionCreateViewModel
@using Ats.Web.Models.Enums

<form asp-controller="Requisitions" asp-action="@(Model.Id.HasValue ? "Edit" : "Create")" asp-route-id="@(Model.Id.HasValue ? Model.Id.Value.ToString() : null)" method="post" class="requisition-entry-form" novalidate id="requisitionMainForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" id="reqId" />
    <input type="hidden" asp-for="Code" id="reqCode" />
    <input type="hidden" asp-for="IsDraft" id="reqIsDraft" value="false" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 mb-3 small" style="border-radius: 8px;">
        <i class="bi bi-exclamation-triangle-fill me-1"></i>
        <span>Vui lòng kiểm tra lại các thông tin khai báo bên dưới.</span>
    </div>

    <!-- Wizard Progress Nav Header -->
    <div class="requisition-wizard-header mb-4">
        <ul class="wizard-steps-nav" id="wizardStepsNav">
            <li class="wizard-step-item is-active" data-step="1" id="stepNav1" title="Chuyển sang Bước 1: Thông tin cơ bản">
                <div class="wizard-step-circle">
                    <span class="step-num">1</span>
                    <i class="bi bi-check2 step-check d-none"></i>
                </div>
                <div class="wizard-step-info">
                    <span class="wizard-step-title">Thông tin cơ bản</span>
                    <span class="wizard-step-subtitle">Chức danh, phòng ban, lương...</span>
                </div>
            </li>
            <div class="wizard-step-connector" id="connector1"></div>
            <li class="wizard-step-item is-pending" data-step="2" id="stepNav2" title="Chuyển sang Bước 2: Mô tả & Tiêu chuẩn">
                <div class="wizard-step-circle">
                    <span class="step-num">2</span>
                    <i class="bi bi-check2 step-check d-none"></i>
                </div>
                <div class="wizard-step-info">
                    <span class="wizard-step-title">Mô tả & Tiêu chuẩn</span>
                    <span class="wizard-step-subtitle">Nhiệm vụ, KPI & Yêu cầu</span>
                </div>
            </li>
            <div class="wizard-step-connector" id="connector2"></div>
            <li class="wizard-step-item is-pending" data-step="3" id="stepNav3" title="Chuyển sang Bước 3: Xem lại & Gửi duyệt">
                <div class="wizard-step-circle">
                    <span class="step-num">3</span>
                    <i class="bi bi-check2 step-check d-none"></i>
                </div>
                <div class="wizard-step-info">
                    <span class="wizard-step-title">Xem lại & Gửi duyệt</span>
                    <span class="wizard-step-subtitle">Rà soát và hoàn tất</span>
                </div>
            </li>
        </ul>
    </div>

    <!-- ========================================== -->
    <!-- BƯỚC 1: THÔNG TIN CƠ BẢN                   -->
    <!-- ========================================== -->
    <div class="wizard-step-pane is-visible" id="wizardStepPane1" data-step="1">
        
        <!-- 1. Chức danh cần tuyển dụng -->
        <div class="mb-3">
            <label asp-for="JobPositionId" class="form-label fw-bold text-dark small mb-1">
                Chức danh tuyển dụng <span class="text-danger">*</span>
            </label>
            <div class="input-group">
                <span class="input-group-text bg-light text-muted border-end-0" style="border-radius: 8px 0 0 8px;">
                    <i class="bi bi-briefcase"></i>
                </span>
                <select asp-for="JobPositionId" class="form-select req-position-select border-start-0" style="border-radius: 0 8px 8px 0;">
                    <option value="">-- Chọn chức danh từ danh mục chuẩn hóa --</option>
                    @if (Model.JobPositionOptions != null)
                    {
                        foreach (var pos in Model.JobPositionOptions)
                        {
                            var salaryRangeText = (pos.MinSalary.HasValue && pos.MaxSalary.HasValue)
                                ? $"({pos.MinSalary.Value:N0} - {pos.MaxSalary.Value:N0} đ)"
                                : "";
                            <option value="@pos.Id" 
                                    data-min-salary="@(pos.MinSalary ?? 0)" 
                                    data-max-salary="@(pos.MaxSalary ?? 0)"
                                    data-dept-id="@pos.DepartmentId"
                                    data-level="@pos.JobLevel"
                                    selected="@(Model.JobPositionId == pos.Id)">
                                @pos.Title (@pos.Code) · @pos.JobLevel @salaryRangeText
                            </option>
                        }
                    }
                </select>
            </div>
            <span asp-validation-for="JobPositionId" class="text-danger small mt-1 d-block"></span>

            <!-- Khung gợi ý dải lương theo chức danh -->
            <div class="req-benchmark-container d-none mt-2 p-2 px-3 bg-success-subtle border border-success-subtle rounded-3 small d-flex justify-content-between align-items-center" style="border-radius: 8px !important;">
                <div class="text-success-emphasis">
                    <i class="bi bi-info-circle-fill me-1"></i>
                    <span>Dải lương chuẩn chức danh: <strong class="font-monospace req-benchmark-text"></strong></span>
                </div>
                <button type="button" class="btn btn-sm btn-outline-success py-0 px-2 btn-apply-benchmark" style="font-size: 0.75rem; border-radius: 6px;">
                    Áp dụng dải chuẩn
                </button>
            </div>
        </div>

        <!-- 2. Phòng ban phụ trách tuyển dụng -->
        <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <label asp-for="DepartmentId" class="form-label fw-bold text-dark small mb-0">
                    Phòng ban phụ trách <span class="text-danger">*</span>
                </label>
                @if (!string.IsNullOrWhiteSpace(Model.CurrentUserDepartmentName))
                {
                    <span class="badge bg-light text-secondary border font-monospace" style="font-size: 0.75rem; border-radius: 6px;">
                        Phòng ban của bạn: @Model.CurrentUserDepartmentName
                    </span>
                }
            </div>
            <div class="input-group">
                <span class="input-group-text bg-light text-muted border-end-0" style="border-radius: 8px 0 0 8px;">
                    <i class="bi bi-building"></i>
                </span>
                <select asp-for="DepartmentId" class="form-select req-dept-select border-start-0" style="border-radius: 0 8px 8px 0;">
                    <option value="">-- Chọn phòng ban tiếp nhận --</option>
                    @if (Model.DepartmentOptions != null)
                    {
                        foreach (var dept in Model.DepartmentOptions)
                        {
                            <option value="@dept.Id" selected="@(Model.DepartmentId == dept.Id)">
                                @dept.Name (@dept.Code) @(dept.IsUserDepartment ? "★ (Phòng ban của bạn)" : "")
                            </option>
                        }
                    }
                </select>
            </div>
            <span asp-validation-for="DepartmentId" class="text-danger small mt-1 d-block"></span>
            @if (!Model.CanChangeDepartment)
            {
                <div class="form-text text-muted small mt-1">
                    <i class="bi bi-shield-check text-success me-1"></i>Tự động gán phòng ban trực thuộc mà bạn đang phụ trách.
                </div>
            }
            else
            {
                <div class="form-text text-muted small mt-1">
                    Bạn đang quản lý nhiều bộ phận hoặc có quyền quản trị, có thể linh hoạt chọn phòng ban cần bổ sung nhân sự.
                </div>
            }
        </div>

        <!-- 3. Địa điểm làm việc & Hình thức làm việc (SCRUM-173) -->
        <div class="row g-3 mb-3">
            <div class="col-12 col-md-6">
                <label asp-for="LocationId" class="form-label fw-bold text-dark small mb-1">
                    Địa điểm làm việc <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0" style="border-radius: 8px 0 0 8px;">
                        <i class="bi bi-geo-alt"></i>
                    </span>
                    <select asp-for="LocationId" id="reqLocationSelect" class="form-select req-location-select border-start-0" style="border-radius: 0 8px 8px 0;">
                        <option value="">-- Chọn địa điểm làm việc --</option>
                        @if (Model.LocationOptions != null)
                        {
                            foreach (var loc in Model.LocationOptions)
                            {
                                <option value="@loc.Id" selected="@(Model.LocationId == loc.Id)">@loc.Name</option>
                            }
                        }
                    </select>
                </div>
                <span asp-validation-for="LocationId" class="text-danger small mt-1 d-block req-location-error"></span>
                <div class="form-text text-muted small mt-1">Danh mục địa điểm làm việc dùng chung</div>
            </div>

            <div class="col-12 col-md-6">
                <label asp-for="WorkTypeId" class="form-label fw-bold text-dark small mb-1">
                    Hình thức làm việc <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0" style="border-radius: 8px 0 0 8px;">
                        <i class="bi bi-clock-history"></i>
                    </span>
                    <select asp-for="WorkTypeId" id="reqWorkTypeSelect" class="form-select req-worktype-select border-start-0" style="border-radius: 0 8px 8px 0;">
                        <option value="">-- Chọn hình thức làm việc --</option>
                        @if (Model.WorkTypeOptions != null)
                        {
                            foreach (var wt in Model.WorkTypeOptions)
                            {
                                <option value="@wt.Id" selected="@(Model.WorkTypeId == wt.Id)">@wt.Name</option>
                            }
                        }
                    </select>
                </div>
                <span asp-validation-for="WorkTypeId" class="text-danger small mt-1 d-block req-worktype-error"></span>
                <div class="form-text text-muted small mt-1">Full-time, Part-time, Remote, Hybrid...</div>
            </div>
        </div>

        <!-- 4. Số lượng cần tuyển & Ngày cần người -->
        <div class="row g-3 mb-3">
            <div class="col-12 col-md-5">
                <label asp-for="Quantity" class="form-label fw-bold text-dark small mb-1">
                    Số lượng tuyển <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0" style="border-radius: 8px 0 0 8px;">
                        <i class="bi bi-people"></i>
                    </span>
                    <input asp-for="Quantity" 
                           type="number" 
                           class="form-control font-monospace fw-bold text-dark req-quantity-input border-start-0" 
                           min="1" 
                           max="100" 
                           placeholder="VD: 1" 
                           style="border-radius: 0 8px 8px 0;" />
                </div>
                <span asp-validation-for="Quantity" class="text-danger small mt-1 d-block"></span>
                <div class="form-text text-muted small mt-1">Số nguyên dương (1 - 100 người)</div>
            </div>

            <div class="col-12 col-md-7">
                <label asp-for="TargetHireDate" class="form-label fw-bold text-dark small mb-1">
                    Ngày cần nhân sự có mặt <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0" style="border-radius: 8px 0 0 8px;">
                        <i class="bi bi-calendar3"></i>
                    </span>
                    <input asp-for="TargetHireDate" 
                           type="date" 
                           class="form-control font-monospace req-date-input border-start-0" 
                           style="border-radius: 0 8px 8px 0;" />
                </div>
                <span asp-validation-for="TargetHireDate" class="text-danger small mt-1 d-block req-date-error"></span>
                <div class="form-text text-muted small mt-1">Thời gian dự kiến để HR chuẩn bị nguồn và tổ chức phỏng vấn</div>
            </div>
        </div>

        <!-- 4. Lý do tuyển dụng (Segmented Radio) -->
        <div class="mb-3">
            <label class="form-label fw-bold text-dark small mb-2">
                Lý do tuyển dụng <span class="text-danger">*</span>
            </label>
            <div class="row g-2">
                <div class="col-12 col-sm-6">
                    <label class="card h-100 p-3 border cursor-pointer headcount-radio-card" style="border-radius: 8px; cursor: pointer;">
                        <div class="d-flex align-items-start gap-2">
                            <input type="radio" 
                                   asp-for="HeadcountType" 
                                   value="@HeadcountType.NEW_HEADCOUNT" 
                                   class="form-check-input mt-1" 
                                   checked="@(Model.HeadcountType == HeadcountType.NEW_HEADCOUNT)" />
                            <div>
                                <strong class="d-flex align-items-center gap-1 text-dark fs-6">
                                    <i class="bi bi-person-plus text-success"></i>
                                    <span>Tăng mới headcount</span>
                                </strong>
                                <p class="text-secondary small mb-0 mt-1">
                                    Mở rộng quy mô đội ngũ, dự án mới hoặc khối lượng công việc phát sinh thêm.
                                </p>
                            </div>
                        </div>
                    </label>
                </div>
                <div class="col-12 col-sm-6">
                    <label class="card h-100 p-3 border cursor-pointer headcount-radio-card" style="border-radius: 8px; cursor: pointer;">
                        <div class="d-flex align-items-start gap-2">
                            <input type="radio" 
                                   asp-for="HeadcountType" 
                                   value="@HeadcountType.REPLACEMENT" 
                                   class="form-check-input mt-1" 
                                   checked="@(Model.HeadcountType == HeadcountType.REPLACEMENT)" />
                            <div>
                                <strong class="d-flex align-items-center gap-1 text-dark fs-6">
                                    <i class="bi bi-arrow-repeat text-warning"></i>
                                    <span>Thay thế nhân sự nghỉ việc</span>
                                </strong>
                                <p class="text-secondary small mb-0 mt-1">
                                    Bổ sung nhân sự thay thế cho vị trí nhân viên đã xin nghỉ hoặc chuyển bộ phận.
                                </p>
                            </div>
                        </div>
                    </label>
                </div>
            </div>
            <span asp-validation-for="HeadcountType" class="text-danger small mt-1 d-block"></span>
        </div>

        <!-- Chi tiết lý do tuyển dụng -->
        <div class="mb-3">
            <label asp-for="ReasonDetail" class="form-label fw-bold text-dark small mb-1">
                Ghi chú chi tiết mục tiêu tuyển dụng
            </label>
            <textarea asp-for="ReasonDetail" 
                      class="form-control" 
                      rows="2" 
                      placeholder="Ghi rõ tên nhân sự cần thay thế, tên dự án phát sinh hoặc yêu cầu trọng tâm..." 
                      style="border-radius: 8px;"></textarea>
            <span asp-validation-for="ReasonDetail" class="text-danger small mt-1 d-block"></span>
        </div>

        <!-- 5. Dải lương đề xuất (Lương tối thiểu & Lương tối đa) -->
        <div class="p-3 bg-light rounded-3 border mb-4" style="border-radius: 10px !important;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label fw-bold text-dark small mb-0">
                    Dải lương đề xuất (VND) <span class="text-danger">*</span>
                </label>
                <span class="badge bg-white text-secondary border font-monospace" style="border-radius: 6px; font-size: 0.75rem;">
                    Đơn vị: VNĐ / tháng
                </span>
            </div>

            <div class="row g-2">
                <div class="col-12 col-sm-6">
                    <label asp-for="MinSalary" class="form-label text-secondary small mb-1">Lương tối thiểu (Min)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted border-end-0" style="border-radius: 8px 0 0 8px;">
                            <i class="bi bi-cash-stack text-success"></i>
                        </span>
                        <input asp-for="MinSalary" 
                               type="number" 
                               step="1000000"
                               class="form-control font-monospace req-min-salary border-start-0" 
                               placeholder="VD: 20000000" 
                               style="border-radius: 0 8px 8px 0;" />
                    </div>
                    <span class="text-success small fw-medium mt-1 d-block req-min-salary-hint d-none font-monospace"></span>
                    <span asp-validation-for="MinSalary" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="col-12 col-sm-6">
                    <label asp-for="MaxSalary" class="form-label text-secondary small mb-1">Lương tối đa (Max)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted border-end-0" style="border-radius: 8px 0 0 8px;">
                            <i class="bi bi-cash-stack text-success"></i>
                        </span>
                        <input asp-for="MaxSalary" 
                               type="number" 
                               step="1000000"
                               class="form-control font-monospace req-max-salary border-start-0" 
                               placeholder="VD: 35000000" 
                               style="border-radius: 0 8px 8px 0;" />
                    </div>
                    <span class="text-success small fw-medium mt-1 d-block req-max-salary-hint d-none font-monospace"></span>
                    <span asp-validation-for="MaxSalary" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>

            <span class="text-danger small mt-2 d-none d-block req-salary-error"></span>

            <div class="form-text text-muted small mt-2">
                <i class="bi bi-info-circle text-primary me-1"></i>
                Dải lương đề xuất là căn cứ để Ban Giám đốc & Phòng Nhân sự phê duyệt ngân sách tuyển dụng cho quý/năm.
            </div>
        </div>

        <!-- Footer Bước 1 -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 pt-3 border-top mt-4">
            <div class="d-flex align-items-center flex-wrap gap-3">
                <a asp-action="Drafts" class="text-decoration-none small text-secondary d-inline-flex align-items-center gap-1" title="Xem danh sách bản nháp đã lưu">
                    <i class="bi bi-folder2-open text-success"></i>
                    <span class="fw-medium">Bản nháp của tôi</span>
                </a>
                <span class="auto-save-indicator small text-muted d-none align-items-center gap-1 font-monospace" style="font-size: 0.8rem;">
                    <span class="spinner-grow text-success auto-save-spinner d-none" style="width: 0.65rem; height: 0.65rem;" role="status"></span>
                    <i class="bi bi-cloud-check text-success auto-save-icon"></i>
                    <span class="auto-save-text">Tự động lưu...</span>
                </span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a asp-action="Drafts" class="btn btn-outline-secondary px-3" style="border-radius: 8px;">
                    Đóng
                </a>
                <button type="button" class="btn btn-outline-secondary px-3 d-inline-flex align-items-center gap-2 fw-semibold btn-save-draft" style="border-radius: 8px;">
                    <span class="spinner-border spinner-border-sm d-none btn-spinner-draft" role="status" aria-hidden="true"></span>
                    <i class="bi bi-floppy"></i>
                    <span>Lưu bản nháp</span>
                </button>
                <button type="button" class="btn btn-success px-4 d-inline-flex align-items-center gap-2 fw-semibold btn-step-next" data-next-step="2" style="border-radius: 8px;">
                    <span>Tiếp tục sang Bước 2</span>
                    <i class="bi bi-arrow-right"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- BƯỚC 2: MÔ TẢ & TIÊU CHUẨN ỨNG VIÊN        -->
    <!-- ========================================== -->
    <div class="wizard-step-pane" id="wizardStepPane2" data-step="2">
        
        <div class="alert alert-light border p-3 mb-4 rounded-3 d-flex align-items-center justify-content-between flex-wrap gap-2" style="border-color: #E2E8F0 !important;">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-file-earmark-richtext text-success fs-4"></i>
                <div>
                    <h6 class="fw-bold text-dark mb-0">Mô tả công việc & Yêu cầu ứng viên</h6>
                    <span class="text-muted small">Sử dụng thanh công cụ soạn thảo để định dạng rõ ràng các đầu việc, KPI và tiêu chuẩn tuyển chọn.</span>
                </div>
            </div>
            <span class="badge bg-light text-secondary border font-monospace" style="font-size: 0.75rem;">Bước 2 / 3</span>
        </div>

        <!-- 6. Mô tả công việc (Rich Text Editor) -->
        <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <label class="form-label fw-bold text-dark small mb-0">
                    Mô tả công việc <span class="text-danger req-submit-required">*</span>
                </label>
                <span class="text-muted small" style="font-size: 0.75rem;">
                    Trách nhiệm, nhiệm vụ chính và các chỉ số đo lường hiệu quả (KPIs)
                </span>
            </div>

            <div class="rich-editor-wrapper" id="jobDescEditorWrapper" data-template-type="description">
                <input type="hidden" asp-for="JobDescription" id="reqJobDescription" class="rich-editor-target" />
                <div class="rich-editor-toolbar">
                    <div class="rich-editor-group">
                        <select class="rich-editor-select rich-editor-heading-select" title="Định dạng tiêu đề">
                            <option value="p">Đoạn văn (Normal)</option>
                            <option value="h2">Tiêu đề lớn (H2)</option>
                            <option value="h3">Tiêu đề phụ (H3)</option>
                        </select>
                    </div>
                    <div class="rich-editor-divider"></div>
                    <div class="rich-editor-group">
                        <button type="button" class="rich-editor-btn" data-command="bold" title="In đậm (Ctrl+B)">
                            <i class="bi bi-type-bold"></i>
                        </button>
                        <button type="button" class="rich-editor-btn" data-command="italic" title="In nghiêng (Ctrl+I)">
                            <i class="bi bi-type-italic"></i>
                        </button>
                    </div>
                    <div class="rich-editor-divider"></div>
                    <div class="rich-editor-group">
                        <button type="button" class="rich-editor-btn" data-command="insertUnorderedList" title="Danh sách dấu đầu dòng (Bullet list)">
                            <i class="bi bi-list-ul"></i>
                        </button>
                        <button type="button" class="rich-editor-btn" data-command="insertOrderedList" title="Danh sách số thứ tự (Numbered list)">
                            <i class="bi bi-list-ol"></i>
                        </button>
                    </div>
                    <div class="rich-editor-divider"></div>
                    <div class="rich-editor-group">
                        <button type="button" class="rich-editor-btn" data-command="removeFormat" title="Xóa định dạng">
                            <i class="bi bi-eraser"></i>
                        </button>
                    </div>
                </div>

                <div class="rich-editor-content" 
                     contenteditable="true" 
                     data-placeholder="Nhập trách nhiệm, nhiệm vụ chính, phạm vi quyền hạn và KPI mục tiêu công việc..."
                     id="jobDescEditorContent">@Html.Raw(Model.JobDescription)</div>

                <div class="rich-editor-footer">
                    <span class="rich-editor-stats">0 từ | 0 ký tự</span>
                    <button type="button" class="rich-editor-template-btn" title="Chèn khung trách nhiệm và KPI mẫu">
                        <i class="bi bi-magic"></i>
                        <span>Chèn mẫu gợi ý</span>
                    </button>
                </div>
            </div>
            <span asp-validation-for="JobDescription" class="text-danger small mt-1 d-block" id="jobDescError"></span>
        </div>

        <!-- 7. Yêu cầu ứng viên (Rich Text Editor) -->
        <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <label class="form-label fw-bold text-dark small mb-0">
                    Yêu cầu ứng viên <span class="text-danger req-submit-required">*</span>
                </label>
                <span class="text-muted small" style="font-size: 0.75rem;">
                    Trình độ học vấn, kinh nghiệm thực chiến, kỹ năng chuyên môn và chứng chỉ
                </span>
            </div>

            <div class="rich-editor-wrapper" id="requirementsEditorWrapper" data-template-type="requirements">
                <input type="hidden" asp-for="Requirements" id="reqRequirements" class="rich-editor-target" />
                <div class="rich-editor-toolbar">
                    <div class="rich-editor-group">
                        <select class="rich-editor-select rich-editor-heading-select" title="Định dạng tiêu đề">
                            <option value="p">Đoạn văn (Normal)</option>
                            <option value="h2">Tiêu đề lớn (H2)</option>
                            <option value="h3">Tiêu đề phụ (H3)</option>
                        </select>
                    </div>
                    <div class="rich-editor-divider"></div>
                    <div class="rich-editor-group">
                        <button type="button" class="rich-editor-btn" data-command="bold" title="In đậm (Ctrl+B)">
                            <i class="bi bi-type-bold"></i>
                        </button>
                        <button type="button" class="rich-editor-btn" data-command="italic" title="In nghiêng (Ctrl+I)">
                            <i class="bi bi-type-italic"></i>
                        </button>
                    </div>
                    <div class="rich-editor-divider"></div>
                    <div class="rich-editor-group">
                        <button type="button" class="rich-editor-btn" data-command="insertUnorderedList" title="Danh sách dấu đầu dòng (Bullet list)">
                            <i class="bi bi-list-ul"></i>
                        </button>
                        <button type="button" class="rich-editor-btn" data-command="insertOrderedList" title="Danh sách số thứ tự (Numbered list)">
                            <i class="bi bi-list-ol"></i>
                        </button>
                    </div>
                    <div class="rich-editor-divider"></div>
                    <div class="rich-editor-group">
                        <button type="button" class="rich-editor-btn" data-command="removeFormat" title="Xóa định dạng">
                            <i class="bi bi-eraser"></i>
                        </button>
                    </div>
                </div>

                <div class="rich-editor-content" 
                     contenteditable="true" 
                     data-placeholder="Nhập trình độ học vấn, số năm kinh nghiệm, kỹ năng cốt lõi và chứng chỉ ưu tiên..."
                     id="requirementsEditorContent">@Html.Raw(Model.Requirements)</div>

                <div class="rich-editor-footer">
                    <span class="rich-editor-stats">0 từ | 0 ký tự</span>
                    <button type="button" class="rich-editor-template-btn" title="Chèn khung tiêu chuẩn ứng viên mẫu">
                        <i class="bi bi-magic"></i>
                        <span>Chèn mẫu gợi ý</span>
                    </button>
                </div>
            </div>
            <span asp-validation-for="Requirements" class="text-danger small mt-1 d-block" id="requirementsError"></span>
        </div>

        <!-- Footer Bước 2 -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 pt-3 border-top mt-4">
            <div class="d-flex align-items-center flex-wrap gap-3">
                <a asp-action="Drafts" class="text-decoration-none small text-secondary d-inline-flex align-items-center gap-1" title="Xem danh sách bản nháp đã lưu">
                    <i class="bi bi-folder2-open text-success"></i>
                    <span class="fw-medium">Bản nháp của tôi</span>
                </a>
                <span class="auto-save-indicator small text-muted d-none align-items-center gap-1 font-monospace" style="font-size: 0.8rem;">
                    <span class="spinner-grow text-success auto-save-spinner d-none" style="width: 0.65rem; height: 0.65rem;" role="status"></span>
                    <i class="bi bi-cloud-check text-success auto-save-icon"></i>
                    <span class="auto-save-text">Tự động lưu...</span>
                </span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-outline-secondary px-3 d-inline-flex align-items-center gap-1 btn-step-prev" data-prev-step="1" style="border-radius: 8px;">
                    <i class="bi bi-arrow-left"></i>
                    <span>Quay lại Bước 1</span>
                </button>
                <button type="button" class="btn btn-outline-secondary px-3 d-inline-flex align-items-center gap-2 fw-semibold btn-save-draft" style="border-radius: 8px;">
                    <span class="spinner-border spinner-border-sm d-none btn-spinner-draft" role="status" aria-hidden="true"></span>
                    <i class="bi bi-floppy"></i>
                    <span>Lưu bản nháp</span>
                </button>
                <button type="button" class="btn btn-success px-4 d-inline-flex align-items-center gap-2 fw-semibold btn-step-next" data-next-step="3" style="border-radius: 8px;">
                    <span>Xem lại đề xuất</span>
                    <i class="bi bi-arrow-right"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- BƯỚC 3: XEM LẠI & GỬI DUYỆT                 -->
    <!-- ========================================== -->
    <div class="wizard-step-pane" id="wizardStepPane3" data-step="3">
        
        <div class="alert alert-success-subtle border border-success-subtle p-3 mb-4 rounded-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2 text-success-emphasis">
                <i class="bi bi-shield-check fs-4"></i>
                <div>
                    <h6 class="fw-bold mb-0">Rà soát thông tin đề xuất tuyển dụng</h6>
                    <span class="small">Kiểm tra lại toàn bộ thông tin dưới đây. Bạn có thể nhấn 'Chỉnh sửa' ở từng phần để cập nhật nếu cần.</span>
                </div>
            </div>
            <span class="badge bg-white text-success border border-success-subtle font-monospace" style="font-size: 0.75rem;">Bước 3 / 3</span>
        </div>

        <!-- Review Card 1: Thông tin cơ bản -->
        <div class="review-summary-card">
            <div class="review-card-header">
                <h6 class="review-card-title">
                    <i class="bi bi-card-checklist text-success"></i>
                    <span>1. Thông tin chung tuyển dụng</span>
                </h6>
                <button type="button" class="btn btn-sm btn-outline-success py-1 px-2 btn-jump-step" data-target-step="1" style="font-size: 0.75rem; border-radius: 6px;">
                    <i class="bi bi-pencil-square me-1"></i>Chỉnh sửa Bước 1
                </button>
            </div>
            <div class="review-card-body">
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <div class="review-item-label">Chức danh tuyển dụng</div>
                        <div class="review-item-value" id="reviewPositionTitle">--</div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="review-item-label">Phòng ban phụ trách</div>
                        <div class="review-item-value" id="reviewDepartmentName">--</div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="review-item-label">Địa điểm làm việc</div>
                        <div class="review-item-value" id="reviewLocationName">--</div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="review-item-label">Hình thức làm việc</div>
                        <div class="review-item-value" id="reviewWorkTypeName">--</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="review-item-label">Số lượng tuyển</div>
                        <div class="review-item-value font-monospace" id="reviewQuantity">1 người</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="review-item-label">Ngày cần có mặt</div>
                        <div class="review-item-value font-monospace" id="reviewHireDate">--</div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="review-item-label">Dải lương đề xuất (Min - Max)</div>
                        <div class="review-item-value font-monospace text-success" id="reviewSalaryRange">--</div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="review-item-label">Loại chỉ tiêu (Headcount)</div>
                        <div class="review-item-value" id="reviewHeadcountType">--</div>
                    </div>
                    <div class="col-12">
                        <div class="review-item-label">Ghi chú mục tiêu tuyển dụng</div>
                        <div class="review-item-value text-secondary small fst-italic" id="reviewReasonDetail">Chưa có ghi chú</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Review Card 2: Mô tả công việc (HTML preview) -->
        <div class="review-summary-card">
            <div class="review-card-header">
                <h6 class="review-card-title">
                    <i class="bi bi-file-earmark-text text-success"></i>
                    <span>2. Mô tả công việc (Job Description)</span>
                </h6>
                <button type="button" class="btn btn-sm btn-outline-success py-1 px-2 btn-jump-step" data-target-step="2" style="font-size: 0.75rem; border-radius: 6px;">
                    <i class="bi bi-pencil-square me-1"></i>Chỉnh sửa Mô tả
                </button>
            </div>
            <div class="review-card-body">
                <div class="review-html-preview-box" id="reviewJobDescContent">
                    <span class="text-muted fst-italic">(Chưa có nội dung mô tả công việc)</span>
                </div>
            </div>
        </div>

        <!-- Review Card 3: Yêu cầu ứng viên (HTML preview) -->
        <div class="review-summary-card">
            <div class="review-card-header">
                <h6 class="review-card-title">
                    <i class="bi bi-person-check text-success"></i>
                    <span>3. Yêu cầu ứng viên (Requirements)</span>
                </h6>
                <button type="button" class="btn btn-sm btn-outline-success py-1 px-2 btn-jump-step" data-target-step="2" style="font-size: 0.75rem; border-radius: 6px;">
                    <i class="bi bi-pencil-square me-1"></i>Chỉnh sửa Yêu cầu
                </button>
            </div>
            <div class="review-card-body">
                <div class="review-html-preview-box" id="reviewRequirementsContent">
                    <span class="text-muted fst-italic">(Chưa có nội dung tiêu chuẩn ứng viên)</span>
                </div>
            </div>
        </div>

        <!-- Review Card 4: Người lập & Quy trình -->
        <div class="p-3 bg-light border rounded-3 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2" style="border-radius: 8px !important;">
            <div class="small text-muted">
                Người lập đề xuất: <strong class="text-dark">@(Model.CurrentUserName ?? User.Identity?.Name ?? "Hiring Manager")</strong> 
                @if (!string.IsNullOrWhiteSpace(Model.CurrentUserDepartmentName))
                {
                    <span>· Bộ phận: <strong class="text-dark">@Model.CurrentUserDepartmentName</strong></span>
                }
            </div>
            <div class="small text-muted">
                Trạng thái sau khi gửi: <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle font-monospace">PENDING_APPROVAL</span>
            </div>
        </div>

        <!-- Footer Bước 3 -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 pt-3 border-top mt-4">
            <div class="d-flex align-items-center flex-wrap gap-3">
                <a asp-action="Drafts" class="text-decoration-none small text-secondary d-inline-flex align-items-center gap-1" title="Xem danh sách bản nháp đã lưu">
                    <i class="bi bi-folder2-open text-success"></i>
                    <span class="fw-medium">Bản nháp của tôi</span>
                </a>
                <span class="auto-save-indicator small text-muted d-none align-items-center gap-1 font-monospace" style="font-size: 0.8rem;">
                    <span class="spinner-grow text-success auto-save-spinner d-none" style="width: 0.65rem; height: 0.65rem;" role="status"></span>
                    <i class="bi bi-cloud-check text-success auto-save-icon"></i>
                    <span class="auto-save-text">Tự động lưu...</span>
                </span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-outline-secondary px-3 d-inline-flex align-items-center gap-1 btn-step-prev" data-prev-step="2" style="border-radius: 8px;">
                    <i class="bi bi-arrow-left"></i>
                    <span>Quay lại Bước 2</span>
                </button>
                <button type="button" class="btn btn-outline-secondary px-3 d-inline-flex align-items-center gap-2 fw-semibold btn-save-draft" style="border-radius: 8px;">
                    <span class="spinner-border spinner-border-sm d-none btn-spinner-draft" role="status" aria-hidden="true"></span>
                    <i class="bi bi-floppy"></i>
                    <span>Lưu bản nháp</span>
                </button>
                <button type="button" class="btn btn-success px-4 d-inline-flex align-items-center gap-2 fw-semibold" style="border-radius: 8px;" id="btnSubmitRequisition">
                    <span class="spinner-border spinner-border-sm d-none btn-spinner" role="status" aria-hidden="true"></span>
                    <i class="bi bi-send-check"></i>
                    <span>Gửi đề xuất tuyển dụng</span>
                </button>
            </div>
        </div>
    </div>
</form>

<style>
    .headcount-radio-card:has(input[type="radio"]:checked) {
        border-color: #059669 !important;
        background-color: #ECFDF5 !important;
    }
    .headcount-radio-card:hover {
        background-color: #F8FAFC;
    }
</style>
