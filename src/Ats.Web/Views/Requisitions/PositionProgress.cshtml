@model Ats.Web.Models.ViewModels.Requisitions.PositionRecruitmentProgressViewModel
@using Ats.Web.Models.Enums
@{
    ViewData["Title"] = $"Tiến độ tuyển dụng: {Model.PositionTitle}";
}

<div class="container-fluid px-3 px-md-4 py-4" style="background-color: #F8FAFC; min-height: 100vh;">
    <!-- Top Breadcrumb & Actions Bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 text-muted small">
                    <li class="breadcrumb-item"><a href="/dashboard/tong-quan" class="text-decoration-none text-secondary">Bàn làm việc</a></li>
                    <li class="breadcrumb-item"><a href="/yeu-cau-tuyen-dung" class="text-decoration-none text-secondary">Yêu cầu tuyển dụng</a></li>
                    <li class="breadcrumb-item active text-dark fw-medium" aria-current="page">Tiến độ vị trí</li>
                </ol>
            </nav>
            <div class="d-flex align-items-center gap-3">
                <h4 class="fw-bold text-dark mb-0">Tiến Độ Tuyển Dụng Vị Trí</h4>
                <span class="badge @Model.UrgencyBadgeClass px-3 py-2" style="border-radius: 6px; font-size: 0.82rem; font-weight: 600;">
                    <i class="bi bi-clock-history me-1"></i>@Model.DaysRemainingDisplay
                </span>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <!-- Dropdown Chuyển nhanh giữa các vị trí sở hữu -->
            @if (Model.OwnedPositions.Count > 1)
            {
                <div class="dropdown">
                    <button class="btn btn-white border shadow-sm px-3 py-2 d-flex align-items-center gap-2 dropdown-toggle text-dark fw-medium"
                            type="button" id="positionSelectDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="border-radius: 8px; background: #FFFFFF;">
                        <i class="bi bi-briefcase text-primary"></i>
                        <span>Đổi vị trí: <strong>@Model.PositionTitle</strong></span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 p-2" aria-labelledby="positionSelectDropdown" style="border-radius: 10px; min-width: 320px; font-size: 0.875rem;">
                        <li><h6 class="dropdown-header text-uppercase text-muted small" style="font-size: 0.75rem;">Vị trí tuyển dụng của bạn (@Model.OwnedPositions.Count)</h6></li>
                        @foreach (var pos in Model.OwnedPositions)
                        {
                            <li>
                                <a class="dropdown-item d-flex justify-content-between align-items-center py-2 px-3 rounded @(pos.IsSelected ? "active" : "")" 
                                   href="@Url.Action("PositionProgress", "Requisitions", new { id = pos.RequisitionId })"
                                   style="border-radius: 6px;">
                                    <div>
                                        <div class="fw-semibold">@pos.Title</div>
                                        <small class="text-muted font-monospace">@pos.Code • @pos.HiredCount/@pos.Quantity người</small>
                                    </div>
                                    <span class="badge @pos.UrgencyBadgeClass font-monospace" style="border-radius: 6px; font-size: 0.72rem;">
                                        @pos.TargetHireDateDisplay
                                    </span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }

            <a href="@Url.Action("Details", "Requisitions", new { id = Model.SelectedRequisitionId })" 
               class="btn btn-outline-secondary px-3 py-2 fw-medium d-flex align-items-center gap-1 shadow-sm" style="border-radius: 8px; background: #FFFFFF;">
                <i class="bi bi-file-earmark-text"></i>
                <span>Xem Yêu Cầu Gốc</span>
            </a>
            <a href="/yeu-cau-tuyen-dung" 
               class="btn btn-outline-secondary px-3 py-2 fw-medium d-flex align-items-center gap-1 shadow-sm" style="border-radius: 8px; background: #FFFFFF;">
                <i class="bi bi-arrow-left"></i>
                <span>Quay lại</span>
            </a>
        </div>
    </div>

    <!-- ── THẺ TIÊU ĐIỂM: THỜI HẠN & CHỈ TIÊU HEADCOUNT ── -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; background: #FFFFFF;">
        <div class="card-body p-4">
            <div class="row g-4 align-items-center">
                <!-- Cột thông tin chức danh & cơ cấu -->
                <div class="col-12 col-lg-5 border-lg-end pe-lg-4">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace px-2 py-1" style="border-radius: 6px; font-size: 0.78rem;">
                            @Model.RequisitionCode
                        </span>
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1" style="border-radius: 6px; font-size: 0.78rem;">
                            @Model.RequisitionStatusDisplay
                        </span>
                    </div>
                    <h3 class="fw-bold text-dark mb-1" style="font-size: 1.45rem;">@Model.PositionTitle</h3>
                    <div class="text-muted small d-flex flex-wrap align-items-center gap-3 mt-2">
                        <span><i class="bi bi-building text-secondary me-1"></i>Phòng ban: <strong class="text-dark">@Model.DepartmentName</strong></span>
                        <span><i class="bi bi-geo-alt text-secondary me-1"></i>Địa điểm: <strong class="text-dark">@Model.WorkLocation</strong></span>
                    </div>
                    <div class="d-flex align-items-center gap-2 mt-3 pt-3 border-top" style="border-color: #F1F5F9 !important;">
                        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center text-primary fw-bold" style="width: 34px; height: 34px; font-size: 0.85rem;">
                            <i class="bi bi-person-badge"></i>
                        </div>
                        <div style="font-size: 0.82rem;">
                            <span class="text-muted">Chuyên viên Nhân sự phụ trách:</span>
                            <span class="fw-semibold text-dark ms-1">@Model.AssignedRecruiterName</span>
                            @if (!string.IsNullOrEmpty(Model.AssignedRecruiterEmail))
                            {
                                <a href="mailto:@Model.AssignedRecruiterEmail" class="text-primary text-decoration-none ms-1" title="Gửi email trao đổi">
                                    <i class="bi bi-envelope"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>

                <!-- Cột đếm ngược thời hạn & tiến độ Headcount -->
                <div class="col-12 col-sm-6 col-lg-3 ps-lg-4 border-sm-end pe-sm-4">
                    <div class="text-uppercase text-secondary fw-bold" style="font-size: 0.72rem; letter-spacing: 0.05em;">
                        HẠN CẦN NGƯỜI (TARGET DATE)
                    </div>
                    <div class="d-flex align-items-baseline gap-2 mt-1">
                        <span class="font-monospace fw-bold" style="font-size: 1.85rem; color: #0F172A; line-height: 1.2;">
                            @Model.DaysRemainingDisplay
                        </span>
                    </div>
                    <div class="text-muted small mt-1">
                        Hạn chót: <strong class="text-dark font-monospace">@Model.TargetHireDateDisplay</strong>
                    </div>
                    <div class="mt-2">
                        <span class="badge @Model.UrgencyBadgeClass px-2 py-1" style="border-radius: 6px; font-size: 0.75rem;">
                            @Model.UrgencyMessage
                        </span>
                    </div>
                </div>

                <!-- Cột chỉ tiêu tuyển dụng (Headcount) -->
                <div class="col-12 col-sm-6 col-lg-4 ps-lg-4">
                    <div class="text-uppercase text-secondary fw-bold" style="font-size: 0.72rem; letter-spacing: 0.05em;">
                        CHỈ TIÊU TUYỂN DỤNG (HEADCOUNT)
                    </div>
                    <div class="d-flex align-items-baseline justify-content-between mt-1">
                        <span class="font-monospace fw-bold text-dark" style="font-size: 1.85rem; line-height: 1.2;">
                            @Model.HiredCount <span style="font-size: 1.1rem; color: #64748B; font-weight: normal;">/ @Model.Quantity nhân sự</span>
                        </span>
                        <span class="badge bg-success-subtle text-success border border-success-subtle font-monospace" style="border-radius: 6px; font-size: 0.8rem;">
                            @Model.HeadcountFulfillmentPercentage%
                        </span>
                    </div>
                    <!-- Thanh tiến độ mini -->
                    <div class="progress mt-2" style="height: 8px; border-radius: 4px; background: #E2E8F0;">
                        <div class="progress-bar bg-success" role="progressbar" style="width: @Model.HeadcountFulfillmentPercentage%;" aria-valuenow="@Model.HeadcountFulfillmentPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-2 small text-muted">
                        <span>Đã tuyển: <strong class="text-success">@Model.HiredCount</strong></span>
                        <span>Còn thiếu: <strong class="text-danger">@Model.RemainingHeadcountNeeded</strong></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── HỘP BÁO CÁO NHANH CHO SẾP (EXECUTIVE 1-CLICK COPY) ── -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; background: #FFFFFF; border-left: 4px solid #2563EB !important;">
        <div class="card-body p-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary" style="width: 32px; height: 32px;">
                        <i class="bi bi-chat-quote-fill"></i>
                    </span>
                    <div>
                        <h6 class="fw-bold text-dark mb-0">Báo Cáo Nhanh Cho Ban Lãnh Đạo / Sếp</h6>
                        <small class="text-muted">Được tự động tổng hợp từ dữ liệu thời gian thực để trả lời sếp ngay lập tức mà không phải hỏi nhân sự</small>
                    </div>
                </div>
                <button type="button" class="btn btn-outline-primary px-3 py-2 fw-semibold d-flex align-items-center gap-2 shadow-sm" 
                        id="btnCopyBossReport" onclick="copyBossReportText()" style="border-radius: 8px;">
                    <i class="bi bi-clipboard" id="copyIcon"></i>
                    <span id="copyBtnText">Sao chép báo cáo</span>
                </button>
            </div>
            <div class="mt-3">
                <textarea id="bossReportContent" class="form-control font-monospace text-dark p-3" rows="6" readonly 
                          style="border-radius: 8px; background: #F8FAFC; border-color: #E2E8F0; font-size: 0.85rem; line-height: 1.6;">@Model.ExecutiveBossReportText</textarea>
            </div>
        </div>
    </div>

    <!-- ── HÀNG NỘI DUNG CHÍNH: PHỄU GIAI ĐOẠN & KHỐI PHỎNG VẤN ── -->
    <div class="row g-4 mb-4">
        <!-- Cột trái: Phễu Tuyển Dụng Tuyến Tính & Hồ Sơ Theo Giai Đoạn (col-lg-8) -->
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 12px; background: #FFFFFF;">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-3 pb-2 gap-2" style="border-bottom: 1px solid #F1F5F9;">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h5 class="fw-bold text-dark mb-0" style="font-size: 1.05rem;">
                                <i class="bi bi-funnel text-primary me-1"></i>Số Lượng Hồ Sơ Ở Từng Giai Đoạn
                            </h5>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace px-2 py-1" style="border-radius: 6px; font-size: 0.75rem;">
                                Tổng @Model.TotalApplications hồ sơ
                            </span>
                        </div>
                        <small class="text-muted">Phân bố ứng viên trong quy trình tuyển dụng của riêng vị trí này</small>
                    </div>
                </div>

                <!-- Dải phễu các giai đoạn (Stage Funnel Grid) -->
                <div class="row g-2 mb-4">
                    @foreach (var stage in Model.Stages)
                    {
                        var isSelected = stage.StageOrder == 1;
                        <div class="col-6 col-md-4 col-xl">
                            <div class="p-3 border text-center cursor-pointer stage-funnel-card @(stage.IsTerminal ? "bg-light opacity-75" : "")" 
                                 data-stage-order="@stage.StageOrder"
                                 onclick="filterCandidatesByStage(@stage.StageOrder)"
                                 style="border-radius: 8px; border-color: #E2E8F0 !important; transition: all 0.2s ease;">
                                <div class="text-uppercase small fw-bold text-truncate" style="font-size: 0.72rem; color: @stage.ColorCode;">
                                    @stage.ShortName
                                </div>
                                <div class="font-monospace fw-bold mt-1" style="font-size: 1.5rem; color: #0F172A; line-height: 1.1;">
                                    @stage.CandidateCount
                                </div>
                                <div class="text-muted font-monospace" style="font-size: 0.72rem;">
                                    @stage.Percentage%
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Danh sách ứng viên theo từng giai đoạn -->
                <div class="mt-2">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold text-dark mb-0" id="currentStageListTitle">
                            <i class="bi bi-people-fill text-secondary me-1"></i>Danh Sách Ứng Viên Chi Tiết (<span id="stageCandidateCountDisplay">@Model.TotalApplications</span>)
                        </h6>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary px-2 py-1" onclick="filterCandidatesByStage('ALL')" style="border-radius: 6px; font-size: 0.78rem;">
                                Tất cả giai đoạn
                            </button>
                        </div>
                    </div>

                    <div class="table-responsive" style="max-height: 480px; overflow-y: auto;">
                        <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th class="ps-3 py-2 text-secondary text-uppercase fw-semibold" style="font-size: 0.72rem;">Ứng viên</th>
                                    <th class="py-2 text-secondary text-uppercase fw-semibold" style="font-size: 0.72rem;">Giai đoạn</th>
                                    <th class="py-2 text-secondary text-uppercase fw-semibold" style="font-size: 0.72rem;">Ngày nộp</th>
                                    <th class="py-2 text-secondary text-uppercase fw-semibold" style="font-size: 0.72rem;">Lưu trú</th>
                                    <th class="py-2 text-secondary text-uppercase fw-semibold text-center" style="font-size: 0.72rem;">Đánh giá</th>
                                    <th class="pe-3 py-2 text-secondary text-uppercase fw-semibold text-end" style="font-size: 0.72rem;">CV</th>
                                </tr>
                            </thead>
                            <tbody id="candidatesTableBody">
                                @{
                                    var allCandidatesList = Model.Stages.SelectMany(s => s.Candidates.Select(c => new { Candidate = c, Stage = s })).ToList();
                                }
                                @if (allCandidatesList.Any())
                                {
                                    @foreach (var item in allCandidatesList)
                                    {
                                        <tr class="candidate-row" data-stage-order="@item.Stage.StageOrder">
                                            <td class="ps-3 py-2">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold flex-shrink-0" 
                                                         style="width: 32px; height: 32px; font-size: 0.8rem; background-color: @item.Stage.ColorCode;">
                                                        @item.Candidate.AvatarLetter
                                                    </div>
                                                    <div>
                                                        <div class="fw-semibold text-dark">@item.Candidate.CandidateName</div>
                                                        <small class="text-muted">@item.Candidate.Email</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="py-2">
                                                <span class="badge" style="background-color: @(item.Stage.ColorCode)20; color: @item.Stage.ColorCode; border: 1px solid @(item.Stage.ColorCode)40; border-radius: 6px; font-size: 0.75rem;">
                                                    @item.Stage.ShortName
                                                </span>
                                            </td>
                                            <td class="py-2 font-monospace text-muted">
                                                @item.Candidate.AppliedDateDisplay
                                            </td>
                                            <td class="py-2 font-monospace">
                                                @if (item.Candidate.IsSlaOverdue)
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="border-radius: 6px; font-size: 0.72rem;">
                                                        <i class="bi bi-exclamation-circle me-1"></i>@item.Candidate.DaysInStage ngày (Quá hạn)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-secondary">@item.Candidate.DaysInStage ngày</span>
                                                }
                                            </td>
                                            <td class="py-2 text-center">
                                                @if (item.Candidate.Rating.HasValue)
                                                {
                                                    <span class="text-warning fw-semibold">
                                                        <i class="bi bi-star-fill"></i> @item.Candidate.Rating.Value
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                            <td class="pe-3 py-2 text-end">
                                                @if (!string.IsNullOrEmpty(item.Candidate.ResumeFilePath))
                                                {
                                                    <a href="@item.Candidate.ResumeFilePath" target="_blank" class="btn btn-sm btn-outline-secondary px-2 py-1" style="border-radius: 6px; font-size: 0.75rem;" title="Xem hồ sơ CV">
                                                        <i class="bi bi-file-earmark-pdf"></i> CV
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">Chưa có CV</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">
                                            <i class="bi bi-inbox fs-3 d-block mb-2 text-secondary"></i>
                                            Chưa có hồ sơ ứng tuyển nào cho vị trí này.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột phải: Ứng viên chờ cho ý kiến & Lịch phỏng vấn sắp tới (col-lg-4) -->
        <div class="col-12 col-lg-4 d-flex flex-column gap-4">
            
            <!-- ── KHỐI 1: ỨNG VIÊN ĐANG CHỜ MÌNH CHO Ý KIẾN (PENDING FEEDBACK) ── -->
            <div class="card border-0 shadow-sm" style="border-radius: 12px; background: #FFFFFF; border-top: 4px solid @(Model.PendingFeedbackCandidates.Any() ? "#D97706" : "#059669") !important;">
                <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <span class="d-inline-flex align-items-center justify-content-center rounded-circle @(Model.PendingFeedbackCandidates.Any() ? "bg-warning-subtle text-warning-emphasis" : "bg-success-subtle text-success")" style="width: 32px; height: 32px;">
                            <i class="bi @(Model.PendingFeedbackCandidates.Any() ? "bi-bell-fill" : "bi-check2-circle")"></i>
                        </span>
                        <div>
                            <h6 class="fw-bold text-dark mb-0">Chờ Bạn Cho Ý Kiến</h6>
                            <small class="text-muted">Đánh giá sau các phiên phỏng vấn</small>
                        </div>
                    </div>
                    <span class="badge @(Model.PendingFeedbackCandidates.Any() ? "bg-warning-subtle text-warning-emphasis border border-warning-subtle" : "bg-success-subtle text-success border border-success-subtle") font-monospace px-2 py-1" style="border-radius: 6px; font-size: 0.75rem;">
                        @(Model.PendingFeedbackCandidates.Count) ứng viên
                    </span>
                </div>
                <div class="card-body p-3">
                    @if (Model.PendingFeedbackCandidates.Any())
                    {
                        <div class="d-flex flex-column gap-2" style="max-height: 280px; overflow-y: auto;">
                            @foreach (var cand in Model.PendingFeedbackCandidates)
                            {
                                <div class="p-3 border rounded-3 bg-light d-flex justify-content-between align-items-center gap-2" style="border-radius: 8px !important; border-color: #FEF3C7 !important;">
                                    <div class="d-flex align-items-center gap-2 overflow-hidden">
                                        <div class="rounded-circle bg-warning text-dark fw-bold d-flex align-items-center justify-content-center flex-shrink-0" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                            @cand.AvatarLetter
                                        </div>
                                        <div class="overflow-hidden">
                                            <div class="fw-semibold text-dark text-truncate" style="font-size: 0.88rem;">@cand.CandidateName</div>
                                            <small class="text-muted text-truncate d-block" style="font-size: 0.75rem;">
                                                <i class="bi bi-calendar-event me-1"></i>@cand.RoundTitle • @cand.InterviewDateDisplay
                                            </small>
                                        </div>
                                    </div>
                                    <a href="/phong-van/so-sanh-ung-vien" class="btn btn-sm btn-warning text-dark fw-semibold px-2 py-1 flex-shrink-0 shadow-sm" style="border-radius: 6px; font-size: 0.75rem;">
                                        <i class="bi bi-pencil-square me-1"></i>Cho ý kiến
                                    </a>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-check-circle-fill fs-2 text-success d-block mb-2"></i>
                            <div class="fw-medium text-dark small">Không có hồ sơ nào chờ ý kiến!</div>
                            <small class="text-muted">Bạn đã hoàn tất toàn bộ đánh giá cho các phiên phỏng vấn vị trí này.</small>
                        </div>
                    }
                </div>
            </div>

            <!-- ── KHỐI 2: LỊCH PHỎNG VẤN SẮP TỚI CỦA VỊ TRÍ ── -->
            <div class="card border-0 shadow-sm" style="border-radius: 12px; background: #FFFFFF;">
                <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-info-subtle text-info-emphasis" style="width: 32px; height: 32px;">
                            <i class="bi bi-calendar-check"></i>
                        </span>
                        <div>
                            <h6 class="fw-bold text-dark mb-0">Lịch Phỏng Vấn Sắp Tới</h6>
                            <small class="text-muted">Kế hoạch phỏng vấn vị trí này</small>
                        </div>
                    </div>
                    <span class="badge bg-secondary-subtle text-secondary font-monospace px-2 py-1" style="border-radius: 6px; font-size: 0.75rem;">
                        @(Model.UpcomingInterviews.Count) buổi
                    </span>
                </div>
                <div class="card-body p-3">
                    @if (Model.UpcomingInterviews.Any())
                    {
                        <div class="d-flex flex-column gap-3" style="max-height: 380px; overflow-y: auto;">
                            @foreach (var iv in Model.UpcomingInterviews)
                            {
                                <div class="p-3 border rounded-3 bg-light" style="border-radius: 8px !important; border-color: #E2E8F0 !important;">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace" style="border-radius: 6px; font-size: 0.72rem;">
                                            Vòng @iv.RoundNumber • @iv.RoundTitle
                                        </span>
                                        <span class="badge @iv.StatusBadgeClass" style="border-radius: 6px; font-size: 0.72rem;">
                                            @iv.StatusDisplay
                                        </span>
                                    </div>
                                    <div class="fw-semibold text-dark" style="font-size: 0.9rem;">@iv.CandidateName</div>
                                    <div class="text-muted small mt-1 d-flex align-items-center gap-2">
                                        <span><i class="bi bi-clock me-1 text-secondary"></i><strong class="font-monospace text-dark">@iv.TimeDisplay</strong></span>
                                        <span>•</span>
                                        <span><i class="bi bi-calendar3 me-1 text-secondary"></i>@iv.DateDisplay</span>
                                    </div>
                                    <div class="text-muted small mt-1">
                                        <i class="bi bi-people me-1 text-secondary"></i>Hội đồng: @iv.PanelistNames
                                    </div>
                                    @if (!string.IsNullOrEmpty(iv.LocationOrLink))
                                    {
                                        <div class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center">
                                            <a href="@iv.LocationOrLink" target="_blank" class="btn btn-sm btn-outline-primary px-2 py-1 d-flex align-items-center gap-1" style="border-radius: 6px; font-size: 0.75rem;">
                                                <i class="bi bi-camera-video-fill"></i> Link Google Meet
                                            </a>
                                            <span class="text-muted font-monospace" style="font-size: 0.72rem;">
                                                @(iv.CandidateConfirmed == CandidateConfirmStatus.ACCEPTED ? "Ứng viên sẵn sàng" : "Chờ ứng viên chốt")
                                            </span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-calendar-x fs-2 text-secondary d-block mb-2"></i>
                            <div class="fw-medium text-dark small">Không có lịch phỏng vấn sắp tới</div>
                            <small class="text-muted">Chưa có lịch phỏng vấn mới được xếp cho vị trí này.</small>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
<script>
    // Hàm sao chép báo cáo nhanh gửi Sếp
    function copyBossReportText() {
        var textarea = document.getElementById('bossReportContent');
        if (!textarea) return;

        textarea.select();
        textarea.setSelectionRange(0, 99999); // Mobile compatibility

        navigator.clipboard.writeText(textarea.value).then(function() {
            var btnText = document.getElementById('copyBtnText');
            var icon = document.getElementById('copyIcon');
            var originalText = btnText.innerText;

            btnText.innerText = 'Đã sao chép!';
            icon.className = 'bi bi-check2 text-success';

            setTimeout(function() {
                btnText.innerText = originalText;
                icon.className = 'bi bi-clipboard';
            }, 2500);
        }).catch(function(err) {
            console.error('Không thể sao chép văn bản: ', err);
        });
    }

    // Hàm lọc ứng viên hiển thị trong bảng theo giai đoạn phễu
    function filterCandidatesByStage(stageOrder) {
        var rows = document.querySelectorAll('.candidate-row');
        var cards = document.querySelectorAll('.stage-funnel-card');
        var count = 0;

        cards.forEach(function(card) {
            if (stageOrder === 'ALL') {
                card.style.borderColor = '#E2E8F0';
                card.style.background = '#FFFFFF';
            } else if (card.getAttribute('data-stage-order') == stageOrder) {
                card.style.borderColor = '#2563EB';
                card.style.background = '#EFF6FF';
            } else {
                card.style.borderColor = '#E2E8F0';
                card.style.background = '#FFFFFF';
            }
        });

        rows.forEach(function(row) {
            if (stageOrder === 'ALL' || row.getAttribute('data-stage-order') == stageOrder) {
                row.classList.remove('d-none');
                count++;
            } else {
                row.classList.add('d-none');
            }
        });

        var displayEl = document.getElementById('stageCandidateCountDisplay');
        if (displayEl) {
            displayEl.innerText = count;
        }
    }
</script>
}
