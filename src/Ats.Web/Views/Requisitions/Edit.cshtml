@model Ats.Web.Models.ViewModels.Requisitions.RequisitionCreateViewModel
@{
    ViewData["Title"] = $"Chỉnh sửa Bản nháp {Model.Code}";
}

<div class="container-fluid px-3 px-md-4 py-4" style="background-color: #F8FAFC; min-height: calc(100vh - 70px);">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-8">
            
            <!-- Breadcrumb & Header -->
            <div class="bg-white border rounded-3 p-3 p-md-4 mb-4 shadow-sm" style="border-radius: 12px !important; border-color: #E2E8F0 !important;">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1 text-muted small">
                        <li class="breadcrumb-item">
                            <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Trang chủ</a>
                        </li>
                        <li class="breadcrumb-item">
                            <a asp-action="Drafts" class="text-decoration-none text-muted">Bản nháp yêu cầu</a>
                        </li>
                        <li class="breadcrumb-item active text-dark fw-medium" aria-current="page">Chỉnh sửa @Model.Code</li>
                    </ol>
                </nav>
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-2">
                    <div>
                        <h4 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                            <i class="bi bi-pencil-square text-success"></i>
                            <span>Chỉnh sửa Yêu cầu Tuyển dụng (Bản nháp)</span>
                        </h4>
                        <p class="text-secondary small mb-0">
                            Tiếp tục hoàn thiện các thông tin tuyển dụng, mô tả công việc và yêu cầu ứng viên trước khi gửi phê duyệt.
                        </p>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 font-monospace" style="border-radius: 6px; font-size: 0.85rem;">
                            <i class="bi bi-file-earmark-diff me-1"></i>@(Model.Code ?? "BẢN NHÁP")
                        </span>
                        <a asp-action="Drafts" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" style="border-radius: 6px;">
                            <i class="bi bi-arrow-left"></i>
                            <span>DS Bản nháp</span>
                        </a>
                    </div>
                </div>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 py-3 px-4 shadow-sm mb-4" role="alert" style="border-radius: 10px; border-left: 5px solid #059669 !important;">
                    <i class="bi bi-check-circle-fill fs-4 text-success"></i>
                    <div>
                        <strong>Thành công!</strong> @TempData["SuccessMessage"]
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 py-3 px-4 shadow-sm mb-4" role="alert" style="border-radius: 10px; border-left: 5px solid #DC2626 !important;">
                    <i class="bi bi-exclamation-triangle-fill fs-4 text-danger"></i>
                    <div>
                        <strong>Lỗi!</strong> @TempData["ErrorMessage"]
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Main Form Card -->
            <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; overflow: hidden; background: #FFFFFF;">
                <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h6 class="fw-bold text-dark mb-0">Thông tin chi tiết yêu cầu</h6>
                        <span class="text-muted small">Có thể lưu nháp ở bất kỳ thời điểm nào. Chỉ bắt buộc điền đủ khi bấm Gửi duyệt.</span>
                    </div>
                    <div class="small text-muted font-monospace">
                        Người lập: <strong class="text-dark">@(Model.CurrentUserName ?? User.Identity?.Name ?? "Hiring Manager")</strong>
                    </div>
                </div>

                <div class="card-body p-4">
                    <partial name="_RequisitionFormPartial" model="Model" />
                </div>
            </div>

        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/rich-text-editor.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/rich-text-editor.js" asp-append-version="true"></script>
    <script src="~/js/requisition-form.js" asp-append-version="true"></script>
}
