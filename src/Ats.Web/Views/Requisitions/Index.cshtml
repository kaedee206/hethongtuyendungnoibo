@model Ats.Web.Models.DTOs.PagedResult<Ats.Web.Models.ViewModels.Requisitions.RequisitionApprovalListItemViewModel>
@using Ats.Web.Models.Enums
@{
    ViewData["Title"] = "Quản lý Yêu cầu Tuyển dụng";
    var currentTab = (string)(ViewBag.CurrentTab ?? "all");
    var search = (string)(ViewBag.Search ?? "");
    var pendingMyApprovalCount = (int)(ViewBag.PendingMyApprovalCount ?? 0);
    var myRequisitionsCount = (int)(ViewBag.MyRequisitionsCount ?? 0);
}

<style>
    /* Styling đồng bộ thương hiệu NoveraTech cho trang Quản lý Yêu cầu Tuyển dụng */
    .req-page-container {
        background-color: #F8FAFC;
        min-height: 100vh;
    }

    /* Tabs điều hướng hiện đại, chuẩn màu NoveraTech */
    .req-tabs-nav {
        border-bottom: none;
        gap: 0.5rem;
    }
    .req-tab-link {
        border-radius: 8px !important;
        font-size: 0.85rem !important;
        font-weight: 500 !important;
        padding: 0.5rem 0.85rem !important;
        background: #F1F5F9;
        color: #475569;
        border: 1px solid #E2E8F0 !important;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        transition: all 0.15s ease;
        white-space: nowrap;
    }
    .req-tab-link:hover {
        background: #E2E8F0;
        color: #0F172A;
        border-color: #CBD5E1 !important;
    }
    .req-tab-link.active {
        background: #059669 !important;
        color: #FFFFFF !important;
        border-color: #059669 !important;
        font-weight: 600 !important;
        box-shadow: 0 2px 6px rgba(5, 150, 105, 0.25);
    }
    .req-tab-badge {
        font-size: 0.72rem;
        padding: 0.15rem 0.45rem;
        border-radius: 6px;
        font-family: 'JetBrains Mono', monospace;
        font-weight: 600;
    }
    .req-tab-link.active .req-tab-badge {
        background: rgba(255, 255, 255, 0.25) !important;
        color: #FFFFFF !important;
    }
    .req-tab-link:not(.active) .req-tab-badge.badge-pending {
        background: #FEE2E2;
        color: #DC2626;
    }
    .req-tab-link:not(.active) .req-tab-badge.badge-my {
        background: #E2E8F0;
        color: #334155;
    }

    /* Nút thương hiệu NoveraTech */
    .btn-novera-primary {
        background-color: #059669 !important;
        border-color: #059669 !important;
        color: #FFFFFF !important;
        transition: all 0.15s ease;
    }
    .btn-novera-primary:hover {
        background-color: #047857 !important;
        border-color: #047857 !important;
        color: #FFFFFF !important;
        box-shadow: 0 4px 12px rgba(5, 150, 105, 0.25);
    }

    /* Filter inputs styling */
    .req-filter-control {
        border-radius: 8px !important;
        border-color: #CBD5E1 !important;
        font-size: 0.85rem !important;
    }
    .req-filter-control:focus {
        border-color: #059669 !important;
        box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15) !important;
    }

    /* Pagination active item */
    .pagination .page-item.active .page-link {
        background-color: #059669 !important;
        border-color: #059669 !important;
        color: #FFFFFF !important;
        font-weight: 600;
    }
    .pagination .page-link {
        color: #334155;
        border-color: #E2E8F0;
        font-size: 0.82rem;
    }
    .pagination .page-link:hover {
        color: #059669;
        background-color: #F8FAFC;
        border-color: #CBD5E1;
    }
    .pagination .page-item.disabled .page-link {
        color: #94A3B8;
        border-color: #E2E8F0;
    }

    /* Table */
    .req-table thead th {
        background: #F8FAFC;
        border-bottom: 2px solid #E2E8F0;
        color: #475569;
        font-weight: 600;
        font-size: 0.76rem;
        letter-spacing: 0.04em;
    }
    .req-code-link {
        color: #059669;
        font-family: 'JetBrains Mono', monospace;
        font-weight: 700;
        text-decoration: none;
        transition: color 0.15s ease;
    }
    .req-code-link:hover {
        color: #047857;
        text-decoration: underline;
    }
</style>

<div class="container-fluid px-4 py-4 req-page-container">
    <!-- Breadcrumb & Top Bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 text-muted small">
                    <li class="breadcrumb-item"><a href="/dashboard/tong-quan" class="text-decoration-none text-secondary">Dashboard</a></li>
                    <li class="breadcrumb-item active text-dark fw-medium" aria-current="page">Yêu cầu tuyển dụng</li>
                </ol>
            </nav>
            <h4 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-file-earmark-check text-success"></i>
                Danh sách Yêu cầu Tuyển dụng
            </h4>
        </div>

        <div class="mobile-action-bar align-items-center gap-2">
            <a href="/yeu-cau-tuyen-dung/ban-nhap" class="btn btn-outline-secondary px-3 py-2 fw-medium d-flex align-items-center gap-2 shadow-sm" style="border-radius: 8px; font-size: 0.88rem;">
                <i class="bi bi-folder2-open"></i>
                <span>Bản nháp</span>
            </a>
            <a href="/yeu-cau-tuyen-dung/tao-moi" class="btn btn-novera-primary px-3 py-2 fw-medium d-flex align-items-center gap-2 shadow-sm" style="border-radius: 8px; font-size: 0.88rem;">
                <i class="bi bi-plus-lg"></i>
                <span>Tạo yêu cầu mới</span>
            </a>
        </div>
    </div>



    <!-- Main Card -->
    <div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden; border: 1px solid #E2E8F0 !important;">
        <!-- Header: Tabs and Search -->
        <div class="card-header bg-white border-bottom p-3" style="border-color: #F1F5F9 !important;">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <!-- Navigation Tabs (Sạch đẹp, đồng bộ màu Emerald #059669) -->
                <ul class="nav nav-pills flex-nowrap overflow-auto req-tabs-nav" id="requisitionTabs" role="tablist">
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Requisitions", new { tab = "my-requisitions", search, departmentId = ViewBag.DepartmentId, recruiterId = ViewBag.RecruiterId, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, pageSize = Model.PageSize })"
                           class="req-tab-link @(currentTab == "my-requisitions" || currentTab == "cua-toi" ? "active" : "")">
                            <i class="bi bi-person-workspace"></i>
                            <span>Yêu cầu của tôi</span>
                            @if (myRequisitionsCount > 0)
                            {
                                <span class="req-tab-badge badge-my">@myRequisitionsCount</span>
                            }
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Requisitions", new { tab = "my-pending", search, departmentId = ViewBag.DepartmentId, recruiterId = ViewBag.RecruiterId, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, pageSize = Model.PageSize })"
                           class="req-tab-link @(currentTab == "my-pending" || currentTab == "cho-toi-duyet" ? "active" : "")">
                            <i class="bi bi-inbox-fill"></i>
                            <span>Chờ tôi duyệt</span>
                            @if (pendingMyApprovalCount > 0)
                            {
                                <span class="req-tab-badge badge-pending">@pendingMyApprovalCount</span>
                            }
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Requisitions", new { tab = "all", search, departmentId = ViewBag.DepartmentId, recruiterId = ViewBag.RecruiterId, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, pageSize = Model.PageSize })"
                           class="req-tab-link @(currentTab == "all" || currentTab == "tat-ca" ? "active" : "")">
                            Tất cả
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Requisitions", new { tab = "pending", search, departmentId = ViewBag.DepartmentId, recruiterId = ViewBag.RecruiterId, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, pageSize = Model.PageSize })"
                           class="req-tab-link @(currentTab == "pending" || currentTab == "cho-duyet" ? "active" : "")">
                            Đang chờ duyệt
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Requisitions", new { tab = "approved", search, departmentId = ViewBag.DepartmentId, recruiterId = ViewBag.RecruiterId, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, pageSize = Model.PageSize })"
                           class="req-tab-link @(currentTab == "approved" || currentTab == "da-duyet" ? "active" : "")">
                            Đã duyệt
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Requisitions", new { tab = "changes-requested", search, departmentId = ViewBag.DepartmentId, recruiterId = ViewBag.RecruiterId, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, pageSize = Model.PageSize })"
                           class="req-tab-link @(currentTab == "changes-requested" || currentTab == "yeu-cau-bo-sung" ? "active" : "")">
                            Yêu cầu bổ sung
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Requisitions", new { tab = "rejected", search, departmentId = ViewBag.DepartmentId, recruiterId = ViewBag.RecruiterId, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, pageSize = Model.PageSize })"
                           class="req-tab-link @(currentTab == "rejected" || currentTab == "tu-choi" ? "active" : "")">
                            Từ chối
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Requisitions", new { tab = "paused", search, departmentId = ViewBag.DepartmentId, recruiterId = ViewBag.RecruiterId, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, pageSize = Model.PageSize })"
                           class="req-tab-link @(currentTab == "paused" || currentTab == "tam-dung" ? "active" : "")">
                            Tạm dừng
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Requisitions", new { tab = "closed", search, departmentId = ViewBag.DepartmentId, recruiterId = ViewBag.RecruiterId, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, pageSize = Model.PageSize })"
                           class="req-tab-link @(currentTab == "closed" || currentTab == "da-dong" ? "active" : "")">
                            Đã đóng
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Requisitions", new { tab = "cancelled", search, departmentId = ViewBag.DepartmentId, recruiterId = ViewBag.RecruiterId, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, pageSize = Model.PageSize })"
                           class="req-tab-link @(currentTab == "cancelled" || currentTab == "da-huy" ? "active" : "")">
                            Đã hủy
                        </a>
                    </li>
                </ul>

                <!-- Search Input Form -->
                <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
                    <input type="hidden" name="tab" value="@currentTab" />
                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                    @if (ViewBag.DepartmentId != null) { <input type="hidden" name="departmentId" value="@ViewBag.DepartmentId" /> }
                    @if (ViewBag.RecruiterId != null) { <input type="hidden" name="recruiterId" value="@ViewBag.RecruiterId" /> }
                    @if (ViewBag.FromDate != null) { <input type="hidden" name="fromDate" value="@(ViewBag.FromDate?.ToString("yyyy-MM-dd"))" /> }
                    @if (ViewBag.ToDate != null) { <input type="hidden" name="toDate" value="@(ViewBag.ToDate?.ToString("yyyy-MM-dd"))" /> }
                    
                    <div class="input-group" style="width: 280px;">
                        <span class="input-group-text bg-light border-end-0 text-muted" style="border-radius: 8px 0 0 8px; border-color: #CBD5E1;">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" name="search" class="form-control border-start-0 ps-0 req-filter-control" 
                               placeholder="Tìm mã, chức danh, phòng ban..." 
                               value="@search" style="border-radius: 0 8px 8px 0; font-size: 0.85rem;" />
                    </div>
                </form>
            </div>
            
            <!-- Filters Toolbar -->
            <form method="get" asp-action="Index" class="mt-3 d-flex flex-wrap align-items-center gap-3">
                <input type="hidden" name="tab" value="@currentTab" />
                <input type="hidden" name="search" value="@search" />
                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                
                <div style="width: 200px;">
                    <select name="departmentId" class="form-select form-select-sm req-filter-control" asp-items="@ViewBag.Departments">
                        <option value="">-- Tất cả phòng ban --</option>
                    </select>
                </div>
                
                <div style="width: 200px;">
                    <select name="recruiterId" class="form-select form-select-sm req-filter-control" asp-items="@ViewBag.Recruiters">
                        <option value="">-- Tất cả Recruiter --</option>
                    </select>
                </div>
                
                <div class="d-flex align-items-center gap-2">
                    <label class="small text-muted mb-0">Từ:</label>
                    <input type="date" name="fromDate" class="form-control form-control-sm req-filter-control" value="@(ViewBag.FromDate?.ToString("yyyy-MM-dd"))" style="width: 135px;" />
                </div>
                
                <div class="d-flex align-items-center gap-2">
                    <label class="small text-muted mb-0">Đến:</label>
                    <input type="date" name="toDate" class="form-control form-control-sm req-filter-control" value="@(ViewBag.ToDate?.ToString("yyyy-MM-dd"))" style="width: 135px;" />
                </div>
                
                <button type="submit" class="btn btn-sm btn-novera-primary px-3 fw-medium d-flex align-items-center gap-1.5" style="border-radius: 8px;">
                    <i class="bi bi-funnel-fill"></i>
                    <span>Lọc</span>
                </button>

                @if (ViewBag.DepartmentId != null || ViewBag.RecruiterId != null || ViewBag.FromDate != null || ViewBag.ToDate != null || !string.IsNullOrWhiteSpace(search))
                {
                    <a href="@Url.Action("Index", "Requisitions", new { tab = currentTab, pageSize = Model.PageSize })" class="btn btn-sm btn-outline-secondary px-3" style="border-radius: 8px;">
                        <i class="bi bi-x-circle me-1"></i>Xóa bộ lọc
                    </a>
                }
            </form>
        </div>

        <!-- Table Content -->
        <div class="card-body p-0">
            @if (Model == null || Model.Items.Count == 0)
            {
                <div class="text-center py-5">
                    <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle mb-3" style="width: 72px; height: 72px; border: 2px dashed #CBD5E1;">
                        <i class="bi bi-inbox text-secondary fs-2"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-1">Không có yêu cầu tuyển dụng nào</h6>
                    <p class="text-muted small mb-3">Chưa có dữ liệu phù hợp với tab lọc hoặc từ khóa tìm kiếm hiện tại.</p>
                    <a href="/yeu-cau-tuyen-dung/tao-moi" class="btn btn-sm btn-novera-primary px-3 py-1.5" style="border-radius: 8px;">
                        <i class="bi bi-plus-lg me-1"></i>Tạo yêu cầu mới
                    </a>
                </div>
            }
            else
            {
                <div class="ats-mobile-table-hint px-3 pt-2"><i class="bi bi-arrow-left-right"></i> Vuốt ngang để xem đủ thông tin yêu cầu tuyển dụng & tiến trình duyệt</div>
                <div class="ats-mobile-table-wrapper table-responsive mb-0">
                    <table class="table table-hover align-middle mb-0 req-table" style="min-width: 950px; font-size: 0.875rem;">
                        <thead>
                            <tr>
                                <th class="ps-4 py-3">Mã &amp; Chức danh</th>
                                <th class="py-3">Phòng ban</th>
                                <th class="py-3 text-center">Số lượng</th>
                                <th class="py-3">Dải lương đề xuất</th>
                                <th class="py-3">Người đề xuất / Hạn</th>
                                <th class="py-3 text-center">Thời gian mở</th>
                                <th class="py-3">Trạng thái</th>
                                <th class="py-3">Tiến trình phê duyệt &amp; Bàn làm việc</th>
                                <th class="pe-4 py-3 text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr class="@(item.IsOverdue ? "table-danger border-danger" : "")">
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <a href="@Url.Action("Details", "Requisitions", new { id = item.Id })" class="req-code-link" title="Xem chi tiết yêu cầu">
                                                @item.Code
                                            </a>
                                            @if (item.IsCreatedByCurrentUser)
                                            {
                                                <span class="badge" style="background: #ECFDF5; color: #047857; border: 1px solid #A7F3D0; font-size: 0.65rem; font-weight: 600; border-radius: 4px;">Của tôi</span>
                                            }
                                        </div>
                                        <div class="text-dark fw-medium mt-1">@item.JobTitle</div>
                                    </td>
                                    <td class="py-3">
                                        <span class="badge bg-light text-dark border fw-normal" style="border-radius: 6px;">
                                            @item.DepartmentName
                                        </span>
                                    </td>
                                    <td class="py-3 text-center">
                                        <span class="fw-bold fs-6 font-mono">@item.Quantity</span>
                                        <small class="d-block text-muted" style="font-size: 0.75rem;">
                                            @(item.HeadcountType == HeadcountType.NEW_HEADCOUNT ? "Tăng mới" : "Thay thế")
                                        </small>
                                    </td>
                                    <td class="py-3">
                                        <div class="text-dark fw-medium">@item.SalaryDisplay</div>
                                    </td>
                                    <td class="py-3">
                                        <div class="fw-medium text-dark">@item.HiringManagerName</div>
                                        <small class="text-muted d-block font-mono" style="font-size: 0.75rem;">
                                            <i class="bi bi-calendar3 me-1"></i>Hạn: @item.TargetHireDateDisplay
                                        </small>
                                    </td>
                                    <td class="py-3 text-center">
                                        <div class="fw-bold @(item.IsOverdue ? "text-danger" : "text-dark") font-mono">@item.OpenDays ngày</div>
                                        @if (item.RemainingDays.HasValue)
                                        {
                                            <small class="d-block @(item.IsOverdue ? "text-danger fw-medium" : "text-muted")" style="font-size: 0.75rem;">
                                                @(item.IsOverdue ? $"Quá hạn {Math.Abs(item.RemainingDays.Value)} ngày" : $"Còn {item.RemainingDays.Value} ngày")
                                            </small>
                                        }
                                        else
                                        {
                                            <small class="d-block text-muted" style="font-size: 0.75rem;">Không giới hạn</small>
                                        }
                                    </td>
                                    <td class="py-3">
                                        @switch (item.Status)
                                        {
                                            case RequisitionStatus.PENDING_APPROVAL:
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1" style="border-radius: 6px;">
                                                    <i class="bi bi-hourglass-split me-1"></i>Chờ duyệt
                                                </span>
                                                break;
                                            case RequisitionStatus.APPROVED:
                                                <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle px-2 py-1" style="border-radius: 6px;">
                                                    <i class="bi bi-check-circle me-1"></i>Đã duyệt
                                                </span>
                                                break;
                                            case RequisitionStatus.CHANGES_REQUESTED:
                                                <span class="badge bg-warning-subtle text-dark border border-warning px-2 py-1" style="border-radius: 6px;">
                                                    <i class="bi bi-arrow-repeat me-1"></i>Yêu cầu bổ sung
                                                </span>
                                                break;
                                            case RequisitionStatus.REJECTED:
                                                <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle px-2 py-1" style="border-radius: 6px;">
                                                    <i class="bi bi-x-circle me-1"></i>Từ chối
                                                </span>
                                                break;
                                            case RequisitionStatus.PAUSED:
                                                <span class="badge bg-warning-subtle text-dark border border-warning px-2 py-1" style="border-radius: 6px;">
                                                    <i class="bi bi-pause-circle me-1"></i>Tạm dừng
                                                </span>
                                                break;
                                            case RequisitionStatus.CLOSED:
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary px-2 py-1" style="border-radius: 6px;">
                                                    <i class="bi bi-lock me-1"></i>Đã đóng
                                                </span>
                                                break;
                                            case RequisitionStatus.CANCELLED:
                                                <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle px-2 py-1" style="border-radius: 6px;">
                                                    <i class="bi bi-x-circle me-1"></i>Đã hủy
                                                </span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary-subtle text-secondary px-2 py-1" style="border-radius: 6px;">
                                                    @item.Status
                                                </span>
                                                break;
                                        }

                                        @if (!string.IsNullOrWhiteSpace(item.LatestComment))
                                        {
                                            <div class="text-muted mt-1 small fst-italic text-truncate" style="max-width: 180px;" title="@item.LatestComment">
                                                <i class="bi bi-chat-quote me-1"></i>"@item.LatestComment"
                                            </div>
                                        }
                                    </td>
                                    <td class="py-3">
                                        @if (item.Status == RequisitionStatus.PENDING_APPROVAL)
                                        {
                                            <div class="d-flex flex-column gap-1">
                                                <div class="d-flex align-items-center gap-1">
                                                    <span class="badge" style="background: #0F172A; color: #FFF; border-radius: 4px; font-size: 0.72rem; font-weight: 600;">Cấp @item.CurrentStepOrder</span>
                                                    <span class="fw-semibold text-dark small">@item.CurrentApproverName</span>
                                                </div>
                                                <div class="text-muted d-flex align-items-center gap-2" style="font-size: 0.75rem;">
                                                    <span class="text-secondary"><i class="bi bi-person-badge me-1"></i>@item.CurrentApproverRole</span>
                                                    @if (!string.IsNullOrEmpty(item.WaitingDurationDisplay) && item.WaitingDurationDisplay != "—")
                                                    {
                                                        <span class="badge bg-warning-subtle text-dark border border-warning-subtle py-0 px-1 font-mono" style="font-size: 0.7rem;">
                                                            <i class="bi bi-clock-history me-1"></i>@item.WaitingDurationDisplay
                                                        </span>
                                                    }
                                                </div>
                                                <div class="fw-medium small" style="color: #059669; font-size: 0.74rem;">
                                                    <i class="bi bi-arrow-right-short"></i>Đang ở bàn: @item.CurrentApproverName
                                                </div>
                                            </div>
                                        }
                                        else if (item.Status == RequisitionStatus.APPROVED)
                                        {
                                            <div class="d-flex flex-column gap-1">
                                                <span class="badge bg-success-subtle text-success border border-success-subtle w-auto align-self-start" style="border-radius: 4px; font-size: 0.72rem; font-weight: 600;">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Đã duyệt 2/2 cấp
                                                </span>
                                                <small class="text-muted" style="font-size: 0.75rem;">BOD đã duyệt hoàn tất</small>
                                            </div>
                                        }
                                        else if (item.Status == RequisitionStatus.CHANGES_REQUESTED)
                                        {
                                            <div class="d-flex flex-column gap-1">
                                                <span class="badge bg-warning-subtle text-dark border border-warning w-auto align-self-start" style="border-radius: 4px; font-size: 0.72rem;">
                                                    <i class="bi bi-arrow-repeat me-1"></i>Đang ở bàn Bạn (Cần bổ sung)
                                                </span>
                                                @if (!string.IsNullOrWhiteSpace(item.LatestComment))
                                                {
                                                    <small class="text-muted fst-italic text-truncate" style="max-width: 200px;" title="@item.LatestComment">
                                                        "@item.LatestComment"
                                                    </small>
                                                }
                                            </div>
                                        }
                                        else if (item.Status == RequisitionStatus.REJECTED)
                                        {
                                            <div class="d-flex flex-column gap-1">
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle w-auto align-self-start" style="border-radius: 4px; font-size: 0.72rem;">
                                                    <i class="bi bi-x-circle-fill me-1"></i>Đã dừng quy trình
                                                </span>
                                                <small class="text-muted" style="font-size: 0.75rem;">Đã từ chối</small>
                                            </div>
                                        }
                                        else
                                        {
                                            <small class="text-muted">—</small>
                                        }
                                    </td>
                                    <td class="pe-4 py-3 text-end">
                                        <div class="d-inline-flex align-items-center gap-1">
                                            @if (item.CanCurrentUserApprove)
                                            {
                                                <button type="button" 
                                                        class="btn btn-sm btn-success px-2 py-1 fw-medium d-flex align-items-center gap-1"
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#approvalDecisionModal"
                                                        data-requisition-id="@item.Id"
                                                        data-requisition-code="@item.Code"
                                                        data-default-action="APPROVE"
                                                        style="background: #059669; border-color: #059669; border-radius: 6px;"
                                                        title="Ra quyết định phê duyệt">
                                                    <i class="bi bi-check2-circle"></i>
                                                    <span>Duyệt</span>
                                                </button>
                                            }

                                            <a href="@Url.Action("Details", "Requisitions", new { id = item.Id })" 
                                               class="btn btn-sm btn-outline-secondary px-2 py-1" 
                                               style="border-radius: 6px;"
                                               title="Xem chi tiết">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            @if (item.Status == RequisitionStatus.CHANGES_REQUESTED || item.Status == RequisitionStatus.DRAFT)
                                            {
                                                <a href="@Url.Action("Edit", "Requisitions", new { id = item.Id })" 
                                                   class="btn btn-sm btn-outline-warning px-2 py-1 text-dark" 
                                                   style="border-radius: 6px;"
                                                   title="Chỉnh sửa bổ sung">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                            }

                                            @* Nút thao tác Quản lý trạng thái Tạm dừng / Đóng / Hủy cho HR Manager *@
                                            @if (User.IsInRole(Ats.Web.Constants.UserRoles.HRManager) || User.IsInRole("Trưởng phòng nhân sự"))
                                            {
                                                @if (item.Status != RequisitionStatus.CLOSED && item.Status != RequisitionStatus.CANCELLED)
                                                {
                                                    <div class="dropdown d-inline-block">
                                                        <button type="button" 
                                                                class="btn btn-sm btn-outline-danger px-2 py-1 dropdown-toggle" 
                                                                data-bs-toggle="dropdown" 
                                                                title="Quản lý trạng thái (HR Manager)" 
                                                                style="border-radius: 6px;">
                                                            <i class="bi bi-sliders2-vertical"></i>
                                                        </button>
                                                        <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="border-radius: 8px; font-size: 0.85rem;">
                                                            <li><h6 class="dropdown-header text-muted" style="font-size: 0.75rem;">Trạng thái tuyển dụng</h6></li>
                                                            @if (item.Status != RequisitionStatus.PAUSED)
                                                            {
                                                                <li>
                                                                    <a class="dropdown-item py-2 text-warning open-status-modal-btn" href="javascript:void(0)"
                                                                       data-requisition-id="@item.Id" data-requisition-code="@item.Code" data-target-status="PAUSED">
                                                                        <i class="bi bi-pause-circle me-2"></i>Tạm dừng tuyển
                                                                    </a>
                                                                </li>
                                                            }
                                                            <li>
                                                                <a class="dropdown-item py-2 text-secondary open-status-modal-btn" href="javascript:void(0)"
                                                                   data-requisition-id="@item.Id" data-requisition-code="@item.Code" data-target-status="CLOSED">
                                                                    <i class="bi bi-lock-fill me-2"></i>Đóng yêu cầu
                                                                </a>
                                                            </li>
                                                            <li><hr class="dropdown-divider my-1"></li>
                                                            <li>
                                                                <a class="dropdown-item py-2 text-danger open-status-modal-btn" href="javascript:void(0)"
                                                                   data-requisition-id="@item.Id" data-requisition-code="@item.Code" data-target-status="CANCELLED">
                                                                    <i class="bi bi-x-circle-fill me-2"></i>Hủy yêu cầu
                                                                </a>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                }
                                            }

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary px-2 py-1 d-inline-flex align-items-center"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#duplicateRequisitionModal"
                                                    data-requisition-id="@item.Id"
                                                    data-requisition-code="@item.Code"
                                                    data-requisition-title="@item.JobTitle"
                                                    style="border-radius: 6px;"
                                                    title="Sao chép yêu cầu này">
                                                <i class="bi bi-copy"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                
                <!-- Thanh Phân Trang & Bộ Chọn Số Bản Ghi Mỗi Trang (5 / 10 / 25 / 50 / 75 / 100) -->
                <div class="card-footer bg-white border-top p-3 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3" style="border-color: #F1F5F9 !important;">
                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <span class="text-muted small">
                            Hiển thị từ <strong class="text-dark font-mono">@((Model.Page - 1) * Model.PageSize + (Model.TotalCount > 0 ? 1 : 0))</strong> 
                            đến <strong class="text-dark font-mono">@Math.Min(Model.Page * Model.PageSize, Model.TotalCount)</strong> 
                            trong tổng số <strong class="text-dark font-mono">@Model.TotalCount</strong> yêu cầu tuyển dụng
                        </span>

                        <div class="d-flex align-items-center gap-2">
                            <label for="pageSizeSelect" class="small text-muted mb-0 text-nowrap">Hiển thị:</label>
                            <select id="pageSizeSelect" class="form-select form-select-sm req-filter-control" style="width: auto; font-family: 'JetBrains Mono', monospace;" onchange="changeRequisitionPageSize(this.value)">
                                <option value="5" selected="@(Model.PageSize == 5)">5 / trang</option>
                                <option value="10" selected="@(Model.PageSize == 10)">10 / trang</option>
                                <option value="25" selected="@(Model.PageSize == 25)">25 / trang</option>
                                <option value="50" selected="@(Model.PageSize == 50)">50 / trang</option>
                                <option value="75" selected="@(Model.PageSize == 75)">75 / trang</option>
                                <option value="100" selected="@(Model.PageSize == 100)">100 / trang</option>
                            </select>
                        </div>
                    </div>

                    @if (Model.TotalPages > 1)
                    {
                        <nav aria-label="Phân trang danh sách yêu cầu">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { tab = currentTab, search, departmentId = ViewBag.DepartmentId, recruiterId = ViewBag.RecruiterId, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, page = Model.Page - 1, pageSize = Model.PageSize })">
                                        <i class="bi bi-chevron-left me-1"></i>Trước
                                    </a>
                                </li>

                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    if (i == 1 || i == Model.TotalPages || (i >= Model.Page - 2 && i <= Model.Page + 2))
                                    {
                                        <li class="page-item @(i == Model.Page ? "active" : "")">
                                            <a class="page-link font-mono" href="@Url.Action("Index", new { tab = currentTab, search, departmentId = ViewBag.DepartmentId, recruiterId = ViewBag.RecruiterId, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, page = i, pageSize = Model.PageSize })">@i</a>
                                        </li>
                                    }
                                    else if (i == Model.Page - 3 || i == Model.Page + 3)
                                    {
                                        <li class="page-item disabled"><span class="page-link">...</span></li>
                                    }
                                }

                                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { tab = currentTab, search, departmentId = ViewBag.DepartmentId, recruiterId = ViewBag.RecruiterId, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, page = Model.Page + 1, pageSize = Model.PageSize })">
                                        Sau<i class="bi bi-chevron-right ms-1"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Ra quyết định phê duyệt -->
@await Html.PartialAsync("_ApprovalDecisionModalPartial", new Ats.Web.Models.ViewModels.Requisitions.RequisitionApprovalDecisionInputModel())

<!-- Modal Quản lý trạng thái: Tạm dừng, Đóng, Hủy -->
@await Html.PartialAsync("_RequisitionStatusChangeModalPartial", new Ats.Web.Models.ViewModels.Requisitions.RequisitionStatusChangeInputModel())

<!-- Modal Sao chép yêu cầu tuyển dụng -->
@await Html.PartialAsync("_DuplicateRequisitionModalPartial")

@section Scripts {
    <script>
        function changeRequisitionPageSize(newSize) {
            const url = new URL(window.location.href);
            url.searchParams.set('pageSize', newSize);
            url.searchParams.set('page', '1');
            window.location.href = url.toString();
        }
    </script>
}
