@model List<Ats.Web.Models.ViewModels.Requisitions.RequisitionApprovalListItemViewModel>
@using Ats.Web.Models.Enums
@{
    ViewData["Title"] = "Quản lý Yêu cầu Tuyển dụng";
    var currentTab = (string)(ViewBag.CurrentTab ?? "all");
    var search = (string)(ViewBag.Search ?? "");
    var pendingMyApprovalCount = (int)(ViewBag.PendingMyApprovalCount ?? 0);
}

<div class="container-fluid px-4 py-4" style="background-color: #F8FAFC; min-height: 100vh;">
    <!-- Breadcrumb & Top Bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 text-muted small">
                    <li class="breadcrumb-item"><a href="/dashboard/tong-quan" class="text-decoration-none text-secondary">Dashboard</a></li>
                    <li class="breadcrumb-item active text-dark fw-medium" aria-current="page">Yêu cầu tuyển dụng</li>
                </ol>
            </nav>
            <h4 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-file-earmark-check text-primary"></i>
                Danh sách Yêu cầu Tuyển dụng
            </h4>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a href="/yeu-cau-tuyen-dung/ban-nhap" class="btn btn-outline-secondary px-3 py-2 fw-medium d-flex align-items-center gap-2 shadow-sm" style="border-radius: 8px;">
                <i class="bi bi-folder2-open"></i>
                <span>Bản nháp</span>
            </a>
            <a href="/yeu-cau-tuyen-dung/tao-moi" class="btn btn-primary px-3 py-2 fw-medium d-flex align-items-center gap-2 shadow-sm" style="border-radius: 8px;">
                <i class="bi bi-plus-lg"></i>
                <span>Tạo yêu cầu mới</span>
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm mb-4" role="alert" style="border-radius: 10px;">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm mb-4" role="alert" style="border-radius: 10px;">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <!-- Main Card -->
    <div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
        <!-- Header: Tabs and Search -->
        <div class="card-header bg-white border-bottom p-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <!-- Navigation Tabs -->
                <ul class="nav nav-pills flex-nowrap overflow-auto gap-2" id="requisitionTabs" role="tablist">
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Requisitions", new { tab = "my-pending", search })"
                           class="nav-link py-2 px-3 fw-medium d-flex align-items-center gap-2 @(currentTab == "my-pending" || currentTab == "cho-toi-duyet" ? "active" : "")"
                           style="border-radius: 8px; font-size: 0.9rem;">
                            <i class="bi bi-inbox-fill"></i>
                            <span>Chờ tôi duyệt</span>
                            @if (pendingMyApprovalCount > 0)
                            {
                                <span class="badge rounded-pill bg-danger">@pendingMyApprovalCount</span>
                            }
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Requisitions", new { tab = "all", search })"
                           class="nav-link py-2 px-3 fw-medium @(currentTab == "all" || currentTab == "tat-ca" ? "active" : "")"
                           style="border-radius: 8px; font-size: 0.9rem;">
                            Tất cả
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Requisitions", new { tab = "pending", search })"
                           class="nav-link py-2 px-3 fw-medium @(currentTab == "pending" || currentTab == "cho-duyet" ? "active" : "")"
                           style="border-radius: 8px; font-size: 0.9rem;">
                            Đang chờ duyệt
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Requisitions", new { tab = "approved", search })"
                           class="nav-link py-2 px-3 fw-medium @(currentTab == "approved" || currentTab == "da-duyet" ? "active" : "")"
                           style="border-radius: 8px; font-size: 0.9rem;">
                            Đã duyệt
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Requisitions", new { tab = "changes-requested", search })"
                           class="nav-link py-2 px-3 fw-medium @(currentTab == "changes-requested" || currentTab == "yeu-cau-bo-sung" ? "active" : "")"
                           style="border-radius: 8px; font-size: 0.9rem;">
                            Yêu cầu bổ sung
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Requisitions", new { tab = "rejected", search })"
                           class="nav-link py-2 px-3 fw-medium @(currentTab == "rejected" || currentTab == "tu-choi" ? "active" : "")"
                           style="border-radius: 8px; font-size: 0.9rem;">
                            Từ chối
                        </a>
                    </li>
                </ul>

                <!-- Search Input Form -->
                <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
                    <input type="hidden" name="tab" value="@currentTab" />
                    <div class="input-group" style="width: 280px;">
                        <span class="input-group-text bg-light border-end-0 text-muted" style="border-radius: 8px 0 0 8px;">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" name="search" class="form-control border-start-0 ps-0" 
                               placeholder="Tìm mã, chức danh, phòng ban..." 
                               value="@search" style="border-radius: 0 8px 8px 0; font-size: 0.875rem;" />
                    </div>
                    @if (!string.IsNullOrWhiteSpace(search))
                    {
                        <a href="@Url.Action("Index", "Requisitions", new { tab = currentTab })" class="btn btn-outline-secondary btn-sm px-2 py-1" title="Xóa tìm kiếm" style="border-radius: 6px;">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </form>
            </div>
        </div>

        <!-- Table Content -->
        <div class="card-body p-0">
            @if (Model == null || Model.Count == 0)
            {
                <div class="text-center py-5">
                    <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle mb-3" style="width: 72px; height: 72px;">
                        <i class="bi bi-inbox text-secondary fs-2"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-1">Không có yêu cầu tuyển dụng nào</h6>
                    <p class="text-muted small mb-3">Chưa có dữ liệu phù hợp với tab lọc hoặc từ khóa tìm kiếm hiện tại.</p>
                    <a href="/yeu-cau-tuyen-dung/tao-moi" class="btn btn-sm btn-primary px-3" style="border-radius: 6px;">
                        <i class="bi bi-plus-lg me-1"></i>Tạo yêu cầu mới
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.875rem;">
                        <thead class="table-light text-secondary text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                            <tr>
                                <th class="ps-4 py-3">Mã &amp; Chức danh</th>
                                <th class="py-3">Phòng ban</th>
                                <th class="py-3 text-center">Số lượng</th>
                                <th class="py-3">Dải lương đề xuất</th>
                                <th class="py-3">Người đề xuất / Hạn</th>
                                <th class="py-3">Trạng thái</th>
                                <th class="py-3">Tiến trình phê duyệt</th>
                                <th class="pe-4 py-3 text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="fw-bold text-primary">
                                            <a href="@Url.Action("Details", "Requisitions", new { id = item.Id })" class="text-decoration-none">
                                                @item.Code
                                            </a>
                                        </div>
                                        <div class="text-dark fw-medium mt-1">@item.JobTitle</div>
                                    </td>
                                    <td class="py-3">
                                        <span class="badge bg-light text-dark border fw-normal" style="border-radius: 6px;">
                                            @item.DepartmentName
                                        </span>
                                    </td>
                                    <td class="py-3 text-center">
                                        <span class="fw-bold fs-6">@item.Quantity</span>
                                        <small class="d-block text-muted" style="font-size: 0.75rem;">
                                            @(item.HeadcountType == HeadcountType.NEW_HEADCOUNT ? "Tăng mới" : "Thay thế")
                                        </small>
                                    </td>
                                    <td class="py-3">
                                        <div class="text-dark fw-medium">@item.SalaryDisplay</div>
                                    </td>
                                    <td class="py-3">
                                        <div class="fw-medium text-dark">@item.HiringManagerName</div>
                                        <small class="text-muted d-block" style="font-size: 0.75rem;">
                                            <i class="bi bi-calendar3 me-1"></i>Hạn: @item.TargetHireDateDisplay
                                        </small>
                                    </td>
                                    <td class="py-3">
                                        @switch (item.Status)
                                        {
                                            case RequisitionStatus.PENDING_APPROVAL:
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1" style="border-radius: 6px;">
                                                    <i class="bi bi-hourglass-split me-1"></i>Chờ duyệt
                                                </span>
                                                break;
                                            case RequisitionStatus.APPROVED:
                                                <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle px-2 py-1" style="border-radius: 6px;">
                                                    <i class="bi bi-check-circle me-1"></i>Đã duyệt
                                                </span>
                                                break;
                                            case RequisitionStatus.CHANGES_REQUESTED:
                                                <span class="badge bg-warning-subtle text-dark border border-warning px-2 py-1" style="border-radius: 6px;">
                                                    <i class="bi bi-arrow-repeat me-1"></i>Yêu cầu bổ sung
                                                </span>
                                                break;
                                            case RequisitionStatus.REJECTED:
                                                <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle px-2 py-1" style="border-radius: 6px;">
                                                    <i class="bi bi-x-circle me-1"></i>Từ chối
                                                </span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary-subtle text-secondary px-2 py-1" style="border-radius: 6px;">
                                                    @item.Status
                                                </span>
                                                break;
                                        }

                                        @if (!string.IsNullOrWhiteSpace(item.LatestComment))
                                        {
                                            <div class="text-muted mt-1 small fst-italic text-truncate" style="max-width: 180px;" title="@item.LatestComment">
                                                <i class="bi bi-chat-quote me-1"></i>"@item.LatestComment"
                                            </div>
                                        }
                                    </td>
                                    <td class="py-3">
                                        @if (item.Status == RequisitionStatus.PENDING_APPROVAL)
                                        {
                                            <div class="d-flex align-items-center gap-1">
                                                <span class="badge bg-primary text-white" style="border-radius: 4px; font-size: 0.7rem;">Cấp @item.CurrentStepOrder</span>
                                                <span class="text-muted small">@item.CurrentApproverName</span>
                                            </div>
                                        }
                                        else if (item.Status == RequisitionStatus.APPROVED)
                                        {
                                            <small class="text-success fw-medium"><i class="bi bi-check2-all me-1"></i>Đã duyệt 2/2 cấp</small>
                                        }
                                        else if (item.Status == RequisitionStatus.CHANGES_REQUESTED)
                                        {
                                            <small class="text-warning-emphasis fw-medium"><i class="bi bi-reply-fill me-1"></i>Đã trả hồ sơ về</small>
                                        }
                                        else
                                        {
                                            <small class="text-muted">—</small>
                                        }
                                    </td>
                                    <td class="pe-4 py-3 text-end">
                                        <div class="d-inline-flex align-items-center gap-1">
                                            @if (item.CanCurrentUserApprove)
                                            {
                                                <button type="button" 
                                                        class="btn btn-sm btn-success px-2 py-1 fw-medium d-flex align-items-center gap-1"
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#approvalDecisionModal"
                                                        data-requisition-id="@item.Id"
                                                        data-requisition-code="@item.Code"
                                                        data-default-action="APPROVE"
                                                        style="border-radius: 6px;"
                                                        title="Ra quyết định phê duyệt">
                                                    <i class="bi bi-check2-circle"></i>
                                                    <span>Duyệt</span>
                                                </button>
                                            }

                                            <a href="@Url.Action("Details", "Requisitions", new { id = item.Id })" 
                                               class="btn btn-sm btn-outline-secondary px-2 py-1" 
                                               style="border-radius: 6px;"
                                               title="Xem chi tiết">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            @if (item.Status == RequisitionStatus.CHANGES_REQUESTED || item.Status == RequisitionStatus.DRAFT)
                                            {
                                                <a href="@Url.Action("Edit", "Requisitions", new { id = item.Id })" 
                                                   class="btn btn-sm btn-outline-warning px-2 py-1 text-dark" 
                                                   style="border-radius: 6px;"
                                                   title="Chỉnh sửa bổ sung">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Ra quyết định phê duyệt -->
@await Html.PartialAsync("_ApprovalDecisionModalPartial", new Ats.Web.Models.ViewModels.Requisitions.RequisitionApprovalDecisionInputModel())
