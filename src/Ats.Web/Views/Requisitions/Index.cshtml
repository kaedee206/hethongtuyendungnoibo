@model Ats.Web.Models.ViewModels.Requisitions.RequisitionListViewModel
@using Ats.Web.Models.Enums
@{
    ViewData["Title"] = "Danh sách Yêu cầu Tuyển dụng";
}

@section Styles {
    <link rel="stylesheet" href="~/css/requisition-list.css" asp-append-version="true" />
}

<div class="requisition-list-container">
    <div class="container-fluid px-0 px-md-2" style="max-width: 1320px; margin: 0 auto;">

        <!-- ── Header & Breadcrumb Card ── -->
        <div class="req-header-card">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small text-muted">
                    <li class="breadcrumb-item">
                        <a href="/dashboard" class="text-decoration-none text-muted">Bàn làm việc</a>
                    </li>
                    <li class="breadcrumb-item active text-dark fw-medium" aria-current="page">Yêu cầu tuyển dụng</li>
                </ol>
            </nav>
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mt-2">
                <div>
                    <h4 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                        <i class="bi bi-file-earmark-ruled text-success"></i>
                        <span>Danh sách Yêu cầu Tuyển dụng</span>
                    </h4>
                    <p class="text-secondary small mb-0">
                        Quản lý toàn bộ các đề xuất nhân sự đã khởi tạo, theo dõi quy trình duyệt và deadline tuyển dụng.
                    </p>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <a asp-action="Drafts" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 fw-medium px-3 py-2" style="border-radius: 8px; font-size: 0.875rem;">
                        <i class="bi bi-file-earmark-text text-muted"></i>
                        <span>Bản nháp (@Model.DraftCount)</span>
                    </a>
                    <a asp-action="Create" class="btn btn-success d-inline-flex align-items-center gap-2 fw-semibold px-3 py-2" style="border-radius: 8px; font-size: 0.875rem; background-color: #059669; border-color: #059669;">
                        <i class="bi bi-plus-lg"></i>
                        <span>+ Tạo yêu cầu mới</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- ── Global Alert Notifications ── -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 py-3 px-4 shadow-sm mb-3" role="alert" style="border-radius: 10px; border-left: 5px solid #059669 !important; background-color: #ECFDF5; border-color: #A7F3D0; color: #065F46;">
                <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                <div class="flex-grow-1">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 py-3 px-4 shadow-sm mb-3" role="alert" style="border-radius: 10px; border-left: 5px solid #DC2626 !important; background-color: #FEF2F2; border-color: #FECACA; color: #991B1B;">
                <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                <div class="flex-grow-1">@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- ── Quick Filter Tabs Bar ── -->
        <div class="req-quick-tabs">
            <button type="button" 
                    class="req-tab-btn @(!Model.Status.HasValue ? "is-active" : "")" 
                    data-status="">
                <i class="bi bi-collection"></i>
                <span>Tất cả</span>
                <span class="tab-count">@Model.TotalCount</span>
            </button>
            <button type="button" 
                    class="req-tab-btn @(Model.Status == RequisitionStatus.DRAFT ? "is-active" : "")" 
                    data-status="@RequisitionStatus.DRAFT">
                <i class="bi bi-pencil-square"></i>
                <span>Bản nháp</span>
                <span class="tab-count">@Model.DraftCount</span>
            </button>
            <button type="button" 
                    class="req-tab-btn @(Model.Status == RequisitionStatus.PENDING_APPROVAL ? "is-active" : "")" 
                    data-status="@RequisitionStatus.PENDING_APPROVAL">
                <i class="bi bi-clock-history"></i>
                <span>Chờ duyệt</span>
                <span class="tab-count">@Model.PendingCount</span>
            </button>
            <button type="button" 
                    class="req-tab-btn @(Model.Status == RequisitionStatus.APPROVED ? "is-active" : "")" 
                    data-status="@RequisitionStatus.APPROVED">
                <i class="bi bi-check2-circle"></i>
                <span>Đã duyệt</span>
                <span class="tab-count">@Model.ApprovedCount</span>
            </button>
            <button type="button" 
                    class="req-tab-btn @(Model.Status == RequisitionStatus.REJECTED ? "is-active" : "")" 
                    data-status="@RequisitionStatus.REJECTED">
                <i class="bi bi-x-circle"></i>
                <span>Từ chối</span>
                <span class="tab-count">@Model.RejectedCount</span>
            </button>
        </div>

        <!-- ── Filter & Search Bar ── -->
        <div class="req-filter-card">
            <form method="get" asp-action="Index" id="requisitionFilterForm">
                <input type="hidden" name="Page" value="@Model.CurrentPage" />
                <input type="hidden" name="PageSize" value="@Model.PageSize" />

                <div class="row g-2 align-items-center">
                    <!-- Ô tìm kiếm từ khóa -->
                    <div class="col-12 col-md-4 col-lg-4">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted" style="border-radius: 8px 0 0 8px; border-color: #CBD5E1;">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" 
                                   name="Search" 
                                   class="form-control border-start-0" 
                                   placeholder="Tìm theo mã yêu cầu, chức danh..." 
                                   value="@Model.Search" 
                                   style="border-radius: 0 8px 8px 0; border-color: #CBD5E1;" />
                        </div>
                    </div>

                    <!-- Lọc theo Chức danh -->
                    <div class="col-6 col-md-3 col-lg-3">
                        <select name="JobPositionId" class="form-select auto-submit-select" asp-items="Model.JobPositionOptions">
                            <option value="">-- Tất cả chức danh --</option>
                        </select>
                    </div>

                    <!-- Lọc theo Trạng thái -->
                    <div class="col-6 col-md-2 col-lg-2">
                        <select name="Status" id="statusFilterSelect" class="form-select auto-submit-select" asp-items="Model.StatusOptions">
                        </select>
                    </div>

                    <!-- Sắp xếp theo ngày tạo / ngày cần người -->
                    <div class="col-8 col-md-2 col-lg-2">
                        <select name="SortBy" class="form-select auto-submit-select" asp-items="Model.SortOptions">
                        </select>
                    </div>

                    <!-- Nút Thao tác Lọc / Reset -->
                    <div class="col-4 col-md-1 col-lg-1 d-flex gap-1">
                        <button type="submit" class="btn btn-primary w-100 p-2" title="Tìm kiếm" style="border-radius: 8px; background-color: #059669; border-color: #059669;">
                            <i class="bi bi-funnel"></i>
                        </button>
                        @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.Status.HasValue || Model.JobPositionId.HasValue || Model.SortBy != "created_desc")
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary p-2" title="Xóa bộ lọc" style="border-radius: 8px;">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </a>
                        }
                    </div>
                </div>
            </form>
        </div>

        <!-- ── Data Table Card ── -->
        <div class="req-table-card">
            @if (Model.Items != null && Model.Items.Any())
            {
                <div class="table-responsive">
                    <table class="table req-table align-middle">
                        <thead>
                            <tr>
                                <th class="ps-4" style="width: 150px;">Mã yêu cầu</th>
                                <th>Chức danh &amp; Phòng ban</th>
                                <th class="text-center" style="width: 110px;">Số lượng</th>
                                <th style="width: 140px;">Trạng thái</th>
                                <th style="width: 170px;">Ngày tạo</th>
                                <th style="width: 160px;">Ngày cần người</th>
                                <th class="pe-4 text-end" style="width: 130px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                var detailUrl = item.IsDraft 
                                    ? Url.Action("Edit", "Requisitions", new { id = item.Id }) 
                                    : Url.Action("Details", "Requisitions", new { id = item.Id });

                                <tr class="req-row-clickable" data-href="@detailUrl" title="Nhấp để @(item.IsDraft ? "tiếp tục chỉnh sửa bản nháp" : "xem chi tiết yêu cầu")">
                                    <!-- Cột 1: Mã yêu cầu -->
                                    <td class="ps-4">
                                        <div class="req-code-badge">
                                            <i class="bi bi-hash text-muted"></i>
                                            <span>@item.Code</span>
                                        </div>
                                    </td>

                                    <!-- Cột 2: Chức danh & Phòng ban -->
                                    <td>
                                        <div class="fw-semibold text-dark" style="font-size: 0.925rem;">
                                            @item.JobPositionTitle
                                        </div>
                                        <div class="text-secondary small d-flex align-items-center gap-2 mt-0.5">
                                            @if (!string.IsNullOrEmpty(item.DepartmentName))
                                            {
                                                <span><i class="bi bi-building me-1"></i>@item.DepartmentName</span>
                                            }
                                            <span class="text-muted">&bull;</span>
                                            <span class="text-muted font-monospace" style="font-size: 0.8rem;">@item.SalaryDisplay</span>
                                        </div>
                                    </td>

                                    <!-- Cột 3: Số lượng & Loại -->
                                    <td class="text-center">
                                        <div class="fw-bold text-dark font-monospace" style="font-size: 1rem;">
                                            @item.Quantity
                                        </div>
                                        <span class="badge bg-light text-secondary border px-1.5 py-0.5" style="font-size: 0.7rem; border-radius: 4px;">
                                            @item.HeadcountTypeName
                                        </span>
                                    </td>

                                    <!-- Cột 4: Trạng thái (RULE.MD 4.2) -->
                                    <td>
                                        <span class="@item.StatusBadgeClass d-inline-flex align-items-center gap-1.5">
                                            @if (item.Status == RequisitionStatus.DRAFT)
                                            {
                                                <i class="bi bi-pencil-fill" style="font-size: 0.65rem;"></i>
                                            }
                                            else if (item.Status == RequisitionStatus.PENDING_APPROVAL)
                                            {
                                                <i class="bi bi-hourglass-split" style="font-size: 0.65rem;"></i>
                                            }
                                            else if (item.Status == RequisitionStatus.APPROVED)
                                            {
                                                <i class="bi bi-check-circle-fill" style="font-size: 0.65rem;"></i>
                                            }
                                            else if (item.Status == RequisitionStatus.REJECTED)
                                            {
                                                <i class="bi bi-x-circle-fill" style="font-size: 0.65rem;"></i>
                                            }
                                            else if (item.Status == RequisitionStatus.IN_PROGRESS)
                                            {
                                                <i class="bi bi-broadcast" style="font-size: 0.65rem;"></i>
                                            }
                                            <span>@item.StatusDisplayName</span>
                                        </span>
                                    </td>

                                    <!-- Cột 5: Ngày tạo -->
                                    <td>
                                        <div class="text-dark small">
                                            @item.CreatedAt.ToString("dd/MM/yyyy")
                                        </div>
                                        <div class="text-secondary" style="font-size: 0.75rem;">
                                            @item.CreatedAt.ToString("HH:mm")
                                        </div>
                                    </td>

                                    <!-- Cột 6: Ngày cần người -->
                                    <td>
                                        @if (item.TargetHireDate.HasValue)
                                        {
                                            @if (item.IsUrgentOrOverdue)
                                            {
                                                <div class="req-date-urgent small" title="Sắp đến hạn hoặc quá hạn tuyển dụng">
                                                    <i class="bi bi-exclamation-triangle-fill"></i>
                                                    <span>@item.TargetHireDate.Value.ToString("dd/MM/yyyy")</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="req-date-normal small">
                                                    <i class="bi bi-calendar-event me-1 text-muted"></i>
                                                    <span>@item.TargetHireDate.Value.ToString("dd/MM/yyyy")</span>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small">--</span>
                                        }
                                    </td>

                                    <!-- Cột 7: Thao tác -->
                                    <td class="pe-4 text-end req-actions-cell">
                                        @if (item.IsDraft)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1 px-2.5 py-1" style="border-radius: 6px; font-size: 0.8rem;" title="Tiếp tục chỉnh sửa bản nháp">
                                                <i class="bi bi-pencil"></i>
                                                <span>Sửa nháp</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light border d-inline-flex align-items-center gap-1 px-2.5 py-1 text-secondary" style="border-radius: 6px; font-size: 0.8rem;" title="Xem chi tiết yêu cầu">
                                                <i class="bi bi-eye"></i>
                                                <span>Chi tiết</span>
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- ── Pagination Bar ── -->
                <div class="req-pagination">
                    <div class="text-muted">
                        Hiển thị <strong>@(((Model.CurrentPage - 1) * Model.PageSize) + 1)</strong> đến <strong>@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems))</strong> trong tổng số <strong>@Model.TotalItems</strong> yêu cầu
                    </div>
                    @if (Model.TotalPages > 1)
                    {
                        <nav aria-label="Phân trang yêu cầu tuyển dụng">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                    <a class="page-link" 
                                       asp-action="Index" 
                                       asp-route-Page="@(Model.CurrentPage - 1)" 
                                       asp-route-PageSize="@Model.PageSize"
                                       asp-route-Search="@Model.Search"
                                       asp-route-JobPositionId="@Model.JobPositionId"
                                       asp-route-Status="@Model.Status"
                                       asp-route-SortBy="@Model.SortBy">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>

                                @for (int p = 1; p <= Model.TotalPages; p++)
                                {
                                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" 
                                           asp-action="Index" 
                                           asp-route-Page="@p" 
                                           asp-route-PageSize="@Model.PageSize"
                                           asp-route-Search="@Model.Search"
                                           asp-route-JobPositionId="@Model.JobPositionId"
                                           asp-route-Status="@Model.Status"
                                           asp-route-SortBy="@Model.SortBy">@p</a>
                                    </li>
                                }

                                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                    <a class="page-link" 
                                       asp-action="Index" 
                                       asp-route-Page="@(Model.CurrentPage + 1)" 
                                       asp-route-PageSize="@Model.PageSize"
                                       asp-route-Search="@Model.Search"
                                       asp-route-JobPositionId="@Model.JobPositionId"
                                       asp-route-Status="@Model.Status"
                                       asp-route-SortBy="@Model.SortBy">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            }
            else
            {
                <!-- ── Empty State ── -->
                <div class="req-empty-state">
                    <div class="req-empty-icon">
                        <i class="bi bi-file-earmark-x"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">Không tìm thấy yêu cầu tuyển dụng nào</h5>
                    <p class="text-secondary small mb-3" style="max-width: 420px; margin: 0 auto;">
                        @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.Status.HasValue || Model.JobPositionId.HasValue)
                        {
                            <span>Không có kết quả nào phù hợp với bộ lọc hiện tại. Vui lòng thử tìm kiếm với từ khóa khác hoặc xóa bộ lọc.</span>
                        }
                        else
                        {
                            <span>Bạn chưa khởi tạo yêu cầu tuyển dụng nào. Hãy bắt đầu tạo đề xuất nhân sự mới ngay hôm nay.</span>
                        }
                    </p>
                    <div class="d-flex justify-content-center gap-2">
                        @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.Status.HasValue || Model.JobPositionId.HasValue)
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary px-3 py-2" style="border-radius: 8px;">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> Xóa bộ lọc
                            </a>
                        }
                        <a asp-action="Create" class="btn btn-success px-3 py-2 fw-semibold" style="border-radius: 8px; background-color: #059669; border-color: #059669;">
                            <i class="bi bi-plus-lg me-1"></i> Tạo yêu cầu mới
                        </a>
                    </div>
                </div>
            }
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/requisition-list.js" asp-append-version="true"></script>
}
