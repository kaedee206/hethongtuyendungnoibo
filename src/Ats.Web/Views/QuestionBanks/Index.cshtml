@{
    ViewData["Title"] = "Quản lý ngân hàng câu hỏi";
}

<div class="container-fluid px-3 px-md-4 py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1" style="color: #0F172A;">Quản lý ngân hàng câu hỏi phỏng vấn</h1>
            <p class="text-muted mb-0" style="font-size: 0.95rem;">Theo khung năng lực - Hỗ trợ người phỏng vấn đánh giá ứng viên đúng trọng tâm</p>
        </div>
        <div class="mt-3 mt-md-0">
            <button class="btn text-white fw-semibold shadow-sm" style="background-color: #059669; border-radius: 8px;" onclick="openAddModal()">
                <i class="bi bi-plus-lg me-1"></i> Thêm câu hỏi mới
            </button>
        </div>
    </div>

    <!-- Bộ lọc -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
        <div class="card-body p-4">
            <form id="filterForm" class="row g-3" onsubmit="event.preventDefault(); applyFilter();">
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-secondary small">Tìm kiếm</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control border-start-0 bg-light" id="filterKeyword" placeholder="Nhập từ khóa câu hỏi (từ 3 ký tự)...">
                    </div>
                    <div id="questionSearchHint" class="text-warning d-none" style="font-size: 0.72rem; margin-top: 3px;">
                        <i class="bi bi-info-circle me-1"></i>Nhập tối thiểu 3 ký tự để tìm kiếm
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary small">Khung năng lực</label>
                    <select class="form-select bg-light" id="filterCompetency" onchange="applyFilter()">
                        <option value="">Tất cả khung năng lực</option>
                        <option value="Kỹ năng chuyên môn">Kỹ năng chuyên môn</option>
                        <option value="Giải quyết vấn đề">Giải quyết vấn đề</option>
                        <option value="Làm việc nhóm">Làm việc nhóm</option>
                        <option value="Giao tiếp">Giao tiếp</option>
                        <option value="Lãnh đạo">Lãnh đạo</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary small">Mức độ khó</label>
                    <select class="form-select bg-light" id="filterDifficulty" onchange="applyFilter()">
                        <option value="">Tất cả mức độ</option>
                        <option value="Cơ bản">Cơ bản</option>
                        <option value="Trung bình">Trung bình</option>
                        <option value="Nâng cao">Nâng cao</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="button" class="btn btn-light border w-100 fw-medium" onclick="resetFilter()">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Đặt lại
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Danh sách câu hỏi -->
    <div class="card border-0 shadow-sm" style="border-radius: 12px;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color: #F8FAFC;">
                        <tr>
                            <th class="py-3 px-4 text-secondary fw-semibold" style="width: 50px;">STT</th>
                            <th class="py-3 px-4 text-secondary fw-semibold" style="width: 40%;">Nội dung câu hỏi</th>
                            <th class="py-3 px-4 text-secondary fw-semibold">Khung năng lực</th>
                            <th class="py-3 px-4 text-secondary fw-semibold text-center">Mức độ khó</th>
                            <th class="py-3 px-4 text-secondary fw-semibold text-center">Trạng thái</th>
                            <th class="py-3 px-4 text-secondary fw-semibold text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="questionTableBody">
                        <!-- Render via JS -->
                    </tbody>
                </table>
            </div>
            
            <div id="emptyState" class="text-center py-5 d-none">
                <div class="mb-3">
                    <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                </div>
                <h5 class="fw-semibold text-secondary">Không tìm thấy câu hỏi nào</h5>
                <p class="text-muted">Thử thay đổi điều kiện lọc hoặc thêm mới câu hỏi.</p>
            </div>
        </div>
        <div class="card-footer bg-white py-3 px-4 border-top">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="text-muted small" id="totalCount">Hiển thị 0 câu hỏi</span>
                    <div class="d-flex align-items-center gap-1 ms-md-2">
                        <label for="questionPageSizeSelect" class="small text-muted mb-0">Mỗi trang:</label>
                        <select id="questionPageSizeSelect" class="form-select form-select-sm py-1 px-2 text-dark" style="width: auto; border-radius: 6px; font-size: 0.8rem;" onchange="changeQuestionPageSize(this.value)">
                            <option value="5">5</option>
                            <option value="10" selected>10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                    </div>
                </div>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0 gap-1" id="questionPaginationUl">
                        <!-- Dynamic page links -->
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thêm/Sửa Câu Hỏi -->
<div class="modal fade" id="questionModal" tabindex="-1" aria-labelledby="questionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow" style="border-radius: 12px;">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold" id="questionModalLabel" style="color: #0F172A;">Thêm câu hỏi mới</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="questionForm" class="needs-validation" novalidate onsubmit="event.preventDefault(); saveQuestion();">
                    <input type="hidden" id="questionId" />
                    
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary">Khung năng lực <span class="text-danger">*</span></label>
                            <select class="form-select bg-light" id="qCompetency" required>
                                <option value="" disabled selected>-- Chọn khung năng lực --</option>
                                <option value="Kỹ năng chuyên môn">Kỹ năng chuyên môn</option>
                                <option value="Giải quyết vấn đề">Giải quyết vấn đề</option>
                                <option value="Làm việc nhóm">Làm việc nhóm</option>
                                <option value="Giao tiếp">Giao tiếp</option>
                                <option value="Lãnh đạo">Lãnh đạo</option>
                            </select>
                            <div class="invalid-feedback">Vui lòng chọn khung năng lực.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary">Mức độ khó <span class="text-danger">*</span></label>
                            <select class="form-select bg-light" id="qDifficulty" required>
                                <option value="" disabled selected>-- Chọn mức độ khó --</option>
                                <option value="Cơ bản">Cơ bản</option>
                                <option value="Trung bình">Trung bình</option>
                                <option value="Nâng cao">Nâng cao</option>
                            </select>
                            <div class="invalid-feedback">Vui lòng chọn mức độ khó.</div>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <label class="form-label fw-semibold text-secondary">Nội dung câu hỏi <span class="text-danger">*</span></label>
                        <textarea class="form-control bg-light" id="qContent" rows="3" placeholder="Nhập câu hỏi để đánh giá năng lực ứng viên..." required></textarea>
                        <div class="invalid-feedback">Vui lòng nhập nội dung câu hỏi.</div>
                    </div>
                    
                    <div class="mb-4">
                        <label class="form-label fw-semibold text-secondary">Gợi ý trả lời / Tiêu chí đánh giá</label>
                        <textarea class="form-control bg-light" id="qSuggestion" rows="3" placeholder="Hướng dẫn người phỏng vấn các điểm cần lưu ý khi ứng viên trả lời..."></textarea>
                    </div>

                    <div class="mb-4 form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="qIsActive" checked>
                        <label class="form-check-label fw-semibold text-secondary" for="qIsActive">Trạng thái hoạt động</label>
                    </div>
                    
                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <button type="button" class="btn btn-light fw-medium px-4" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn text-white fw-semibold px-4" style="background-color: #059669;">Lưu câu hỏi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Xác nhận xóa -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow" style="border-radius: 12px;">
            <div class="modal-body text-center p-4">
                <div class="mb-3">
                    <i class="bi bi-exclamation-triangle text-danger" style="font-size: 3rem;"></i>
                </div>
                <h5 class="fw-bold mb-3">Xác nhận xóa</h5>
                <p class="text-muted mb-4">Bạn có chắc chắn muốn xóa câu hỏi này không? Hành động này không thể hoàn tác.</p>
                <input type="hidden" id="deleteQuestionId" />
                <div class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-light fw-medium" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-danger fw-semibold" onclick="confirmDelete()">Xóa câu hỏi</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Toast Notification -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
    <div id="actionToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="toastMessage">
                Thành công!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Mock dữ liệu ban đầu
        let questionsData = [];
        let questionModal = null;
        let deleteModal = null;
        let toastObj = null;

        $(document).ready(function () {
            questionModal = new bootstrap.Modal(document.getElementById('questionModal'));
            deleteModal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
            toastObj = new bootstrap.Toast(document.getElementById('actionToast'), { delay: 4000 });
            
            fetchQuestions();
        });

        function showToast(message, isSuccess = true) {
            const toastEl = document.getElementById('actionToast');
            toastEl.className = 'toast align-items-center shadow-lg border-0 ' + (isSuccess ? 'toast-success' : 'toast-error');
            document.getElementById('toastMessage').innerText = message;
            toastObj.show();
        }

        function getDifficultyBadge(level) {
            switch(level) {
                case 'Cơ bản': return '<span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1" style="border-radius: 6px;">Cơ bản</span>';
                case 'Trung bình': return '<span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1" style="border-radius: 6px;">Trung bình</span>';
                case 'Nâng cao': return '<span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1" style="border-radius: 6px;">Nâng cao</span>';
                default: return '<span class="badge bg-secondary">' + (level || 'Tiêu chuẩn') + '</span>';
            }
        }

        let currentQuestionPage = 1;
        let currentQuestionPageSize = 10;
        let totalQuestionPages = 1;
        let totalQuestionRecords = 0;

        async function fetchQuestions(page = 1) {
            currentQuestionPage = page;
            const keyword = document.getElementById('filterKeyword').value.trim();
            const competency = document.getElementById('filterCompetency').value;
            const difficulty = document.getElementById('filterDifficulty').value;
            const hint = document.getElementById('questionSearchHint');

            if (hint) {
                if (keyword.length > 0 && keyword.length < 3) hint.classList.remove('d-none');
                else hint.classList.add('d-none');
            }

            const params = new URLSearchParams();
            // Chỉ gửi từ khóa tìm kiếm khi có từ 3 ký tự trở lên (>= 3 chars)
            if (keyword && keyword.length >= 3) params.append('keyword', keyword);
            if (competency) params.append('competency', competency);
            if (difficulty) params.append('difficulty', difficulty);
            params.append('page', currentQuestionPage);
            params.append('pageSize', currentQuestionPageSize);

            try {
                const res = await fetch(`/api/question-banks?${params.toString()}`);
                const result = await res.json();
                if (res.ok && result.isSuccess) {
                    questionsData = result.data || [];
                    totalQuestionRecords = result.totalRecords ?? questionsData.length;
                    totalQuestionPages = result.totalPages ?? 1;
                    const startIndex = (currentQuestionPage - 1) * currentQuestionPageSize + 1;
                    renderTable(questionsData, startIndex);
                    renderQuestionPagination();
                } else {
                    showToast(result.message || 'Lỗi khi tải danh sách câu hỏi.', false);
                }
            } catch (err) {
                showToast('Lỗi kết nối máy chủ: ' + err.message, false);
            }
        }

        function renderTable(data, startIndex = 1) {
            const tbody = document.getElementById('questionTableBody');
            const emptyState = document.getElementById('emptyState');
            const totalCount = document.getElementById('totalCount');
            
            tbody.innerHTML = '';
            
            if (data.length === 0) {
                emptyState.classList.remove('d-none');
                totalCount.innerText = 'Hiển thị 0 câu hỏi';
                return;
            }
            
            emptyState.classList.add('d-none');
            const startDisplay = (currentQuestionPage - 1) * currentQuestionPageSize + 1;
            const endDisplay = Math.min(currentQuestionPage * currentQuestionPageSize, totalQuestionRecords);
            totalCount.innerHTML = `Hiển thị từ <strong class="text-dark">${startDisplay}</strong> đến <strong class="text-dark">${endDisplay}</strong> trong tổng số <strong class="text-dark">${totalQuestionRecords}</strong> câu hỏi`;
            
            data.forEach((item, index) => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="px-4 fw-medium text-secondary">${startIndex + index}</td>
                    <td class="px-4">
                        <div class="fw-semibold text-dark mb-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">${item.content}</div>
                        <div class="text-muted small text-truncate" style="max-width: 400px;" title="${item.suggestion || 'Không có gợi ý'}">
                            <i class="bi bi-lightbulb text-warning me-1"></i> ${item.suggestion || 'Không có gợi ý'}
                        </div>
                    </td>
                    <td class="px-4">
                        <span class="badge bg-light text-dark border px-2 py-1" style="border-radius: 6px;">
                            ${item.competency}
                        </span>
                    </td>
                    <td class="px-4 text-center">
                        ${getDifficultyBadge(item.difficulty)}
                    </td>
                    <td class="px-4 text-center">
                        ${item.isActive 
                            ? '<span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1" style="border-radius: 6px;">Hoạt động</span>' 
                            : '<span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1" style="border-radius: 6px;">Tạm ẩn</span>'}
                    </td>
                    <td class="px-4 text-end">
                        <button class="btn btn-sm btn-light border shadow-sm me-1" onclick="openEditModal('${item.id}')" title="Chỉnh sửa" style="border-radius: 6px;">
                            <i class="bi bi-pencil-square text-primary"></i>
                        </button>
                        <button class="btn btn-sm btn-light border shadow-sm" onclick="promptDelete('${item.id}')" title="Xóa" style="border-radius: 6px;">
                            <i class="bi bi-trash text-danger"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function applyFilter() {
            fetchQuestions();
        }

        function resetFilter() {
            document.getElementById('filterForm').reset();
            fetchQuestions();
        }

        function openAddModal() {
            document.getElementById('questionForm').reset();
            document.getElementById('questionForm').classList.remove('was-validated');
            document.getElementById('questionId').value = '';
            document.getElementById('qIsActive').checked = true;
            document.getElementById('questionModalLabel').innerText = 'Thêm câu hỏi mới';
            questionModal.show();
        }

        function openEditModal(id) {
            const question = questionsData.find(q => q.id === id);
            if (!question) return;

            document.getElementById('questionForm').classList.remove('was-validated');
            document.getElementById('questionId').value = question.id;
            document.getElementById('qCompetency').value = question.competency;
            document.getElementById('qDifficulty').value = question.difficulty;
            document.getElementById('qContent').value = question.content;
            document.getElementById('qSuggestion').value = question.suggestion || '';
            document.getElementById('qIsActive').checked = question.isActive;
            
            document.getElementById('questionModalLabel').innerText = 'Sửa câu hỏi phỏng vấn';
            questionModal.show();
        }

        async function saveQuestion() {
            const form = document.getElementById('questionForm');
            if (!form.checkValidity()) {
                form.classList.add('was-validated');
                return;
            }

            const id = document.getElementById('questionId').value;
            const competency = document.getElementById('qCompetency').value;
            const difficulty = document.getElementById('qDifficulty').value;
            const content = document.getElementById('qContent').value;
            const suggestion = document.getElementById('qSuggestion').value;

            const payload = { competency, difficulty, content, suggestion };
            const isEdit = Boolean(id);
            const url = isEdit ? `/api/question-banks/${id}` : '/api/question-banks';
            const method = isEdit ? 'PUT' : 'POST';

            try {
                const res = await fetch(url, {
                    method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await res.json();
                if (res.ok && result.isSuccess) {
                    questionModal.hide();
                    fetchQuestions();
                    showToast(result.message || (isEdit ? 'Cập nhật thành công!' : 'Thêm mới thành công!'), true);
                } else {
                    showToast(result.message || 'Lỗi khi lưu câu hỏi.', false);
                }
            } catch (err) {
                showToast('Lỗi máy chủ: ' + err.message, false);
            }
        }

        function promptDelete(id) {
            document.getElementById('deleteQuestionId').value = id;
            deleteModal.show();
        }

        async function confirmDelete() {
            const id = document.getElementById('deleteQuestionId').value;
            if (!id) return;

            try {
                const res = await fetch(`/api/question-banks/${id}`, { method: 'DELETE' });
                const result = await res.json();
                if (res.ok && result.isSuccess) {
                    deleteModal.hide();
                    fetchQuestions();
                    showToast(result.message || 'Đã xóa câu hỏi thành công!', true);
                } else {
                    showToast(result.message || 'Không thể xóa câu hỏi.', false);
                }
            } catch (err) {
                showToast('Lỗi máy chủ: ' + err.message, false);
            }
        }
        function renderQuestionPagination() {
            const paginationUl = document.getElementById('questionPaginationUl');
            if (!paginationUl) return;

            if (totalQuestionPages <= 1) {
                paginationUl.innerHTML = '';
                return;
            }

            let html = '';
            // Previous button
            const prevDisabled = currentQuestionPage <= 1 ? 'disabled' : '';
            html += `<li class="page-item ${prevDisabled}">
                        <a class="page-link" href="javascript:void(0)" onclick="fetchQuestions(${currentQuestionPage - 1})" style="border-radius: 6px; border-color: #E2E8F0; color: #0F172A;">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                     </li>`;

            // Numbered buttons
            for (let i = 1; i <= totalQuestionPages; i++) {
                if (i === 1 || i === totalQuestionPages || (i >= currentQuestionPage - 2 && i <= currentQuestionPage + 2)) {
                    const activeClass = i === currentQuestionPage ? 'active' : '';
                    const inlineStyle = i === currentQuestionPage
                        ? 'border-radius: 6px; background: #059669; border-color: #059669; color: #FFF;'
                        : 'border-radius: 6px; border-color: #E2E8F0; color: #0F172A;';
                    html += `<li class="page-item ${activeClass}">
                                <a class="page-link" href="javascript:void(0)" onclick="fetchQuestions(${i})" style="${inlineStyle}">
                                    ${i}
                                </a>
                             </li>`;
                } else if (i === currentQuestionPage - 3 || i === currentQuestionPage + 3) {
                    html += `<li class="page-item disabled"><span class="page-link border-0">...</span></li>`;
                }
            }

            // Next button
            const nextDisabled = currentQuestionPage >= totalQuestionPages ? 'disabled' : '';
            html += `<li class="page-item ${nextDisabled}">
                        <a class="page-link" href="javascript:void(0)" onclick="fetchQuestions(${currentQuestionPage + 1})" style="border-radius: 6px; border-color: #E2E8F0; color: #0F172A;">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                     </li>`;

            paginationUl.innerHTML = html;
        }

        function changeQuestionPageSize(newSize) {
            currentQuestionPageSize = parseInt(newSize, 10) || 10;
            fetchQuestions(1);
        }

        function applyFilter() {
            fetchQuestions(1);
        }

        function resetFilter() {
            const kw = document.getElementById('filterKeyword');
            if (kw) kw.value = '';
            document.getElementById('filterCompetency').value = '';
            document.getElementById('filterDifficulty').value = '';
            const hint = document.getElementById('questionSearchHint');
            if (hint) hint.classList.add('d-none');
            fetchQuestions(1);
        }

        document.addEventListener('DOMContentLoaded', function () {
            const kwInput = document.getElementById('filterKeyword');
            if (kwInput) {
                kwInput.addEventListener('input', function () {
                    const val = kwInput.value.trim();
                    const hint = document.getElementById('questionSearchHint');
                    if (hint) {
                        if (val.length > 0 && val.length < 3) hint.classList.remove('d-none');
                        else hint.classList.add('d-none');
                    }
                });
            }
        });
    </script>
}
