                    <!-- Thông báo chế độ xem trước TopCV -->
                    <div class="alert alert-info border-0 shadow-sm d-flex align-items-center justify-content-between py-2 px-3 mb-3" style="border-radius: 10px; background: #EFF6FF; color: #1E40AF;">
                        <div class="d-flex align-items-center gap-2 small">
                            <i class="bi bi-info-circle-fill fs-6 text-primary"></i>
                            <span>Giao diện thực tế mà ứng viên nhìn thấy khi truy cập bài đăng này trên cổng tuyển dụng.</span>
                        </div>
                        <span class="badge bg-primary text-white font-monospace" id="prevJobCodeBadge">NT-JOB</span>
                    </div>

                    <!-- Thẻ Hero Banner Tin tuyển dụng (TopCV Style) -->
                    <div class="card border-0 shadow-sm p-4 mb-3" style="border-radius: 14px; background: #FFFFFF;">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <span class="badge bg-light text-secondary border font-monospace" id="prevBadgeDept">Phòng IT</span>
                            <span class="badge bg-light text-secondary border font-monospace" id="prevBadgeLevel">SENIOR</span>
                            <span class="badge bg-light text-secondary border" id="prevBadgeType">Toàn thời gian</span>
                            <span class="badge bg-success-subtle text-success border border-success-subtle" id="prevBadgeStatus">
                                <span class="d-inline-block rounded-circle bg-success me-1" style="width: 6px; height: 6px;"></span> Đang nhận hồ sơ
                            </span>
                        </div>

                        <h3 class="fw-bold text-dark mb-2" id="prevJobTitle" style="letter-spacing: -0.02em;">Tên vị trí tuyển dụng</h3>
                        <p class="text-muted small mb-3" id="prevJobOverviewShort">Tóm tắt vị trí công việc...</p>

                        <!-- Box 4 thông tin trọng điểm (Key Info Cards - TopCV Highlight) -->
                        <div class="row g-2 mb-3">
                            <div class="col-6 col-md-3">
                                <div class="p-2.5 rounded border bg-light text-center">
                                    <div class="text-muted small" style="font-size: 0.72rem;"><i class="bi bi-cash-stack text-success me-1"></i>Mức thu nhập</div>
                                    <div class="fw-bold font-monospace mt-1" style="color: #059669; font-size: 0.88rem;" id="prevSalary">Thương lượng</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-2.5 rounded border bg-light text-center">
                                    <div class="text-muted small" style="font-size: 0.72rem;"><i class="bi bi-geo-alt text-primary me-1"></i>Địa điểm</div>
                                    <div class="fw-semibold text-dark text-truncate mt-1" style="font-size: 0.85rem;" id="prevLocation">Hà Nội</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-2.5 rounded border bg-light text-center">
                                    <div class="text-muted small" style="font-size: 0.72rem;"><i class="bi bi-clock-history text-danger me-1"></i>Hạn nộp hồ sơ</div>
                                    <div class="fw-semibold text-dark font-monospace mt-1" style="font-size: 0.85rem;" id="prevDeadline">01/11/2026</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-2.5 rounded border bg-light text-center">
                                    <div class="text-muted small" style="font-size: 0.72rem;"><i class="bi bi-briefcase text-info me-1"></i>Cấp bậc</div>
                                    <div class="fw-semibold text-dark text-truncate mt-1" style="font-size: 0.85rem;" id="prevLevel">Senior</div>
                                </div>
                            </div>
                        </div>

                        <!-- Giả lập nút bấm Ứng viên (TopCV Style) -->
                        <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                            <button type="button" class="btn btn-novera-primary px-4 fw-bold disabled shadow-sm" style="border-radius: 8px;">
                                <i class="bi bi-send-fill me-1.5"></i> Ứng tuyển ngay
                            </button>
                            <button type="button" class="btn btn-outline-secondary px-3 disabled" style="border-radius: 8px;">
                                <i class="bi bi-bookmark me-1"></i> Lưu tin
                            </button>
                            <button type="button" class="btn btn-outline-secondary px-3 disabled" style="border-radius: 8px;">
                                <i class="bi bi-share me-1"></i> Chia sẻ
                            </button>
                            <span class="text-muted small align-self-center ms-auto fst-italic">
                                <i class="bi bi-eye text-muted me-1"></i>Giao diện ứng viên xem trước (Không thực hiện ứng tuyển)
                            </span>
                        </div>
                    </div>

                    <!-- Nội dung chi tiết Job Description -->
                    <div class="card border-0 shadow-sm p-4 mb-3" style="border-radius: 14px; background: #FFFFFF;">
                        <!-- 1. Tổng quan vị trí -->
                        <div class="mb-4" id="prevSectionOverview">
                            <h5 class="fw-bold text-dark d-flex align-items-center gap-2 mb-2 pb-1 border-bottom" style="font-size: 0.95rem;">
                                <i class="bi bi-card-text text-success"></i> 1. Tổng quan về vị trí công việc
                            </h5>
                            <div class="text-secondary small lh-base" id="prevOverviewContent" style="white-space: pre-line;"></div>
                        </div>

                        <!-- 2. Trách nhiệm công việc -->
                        <div class="mb-4" id="prevSectionResponsibilities">
                            <h5 class="fw-bold text-dark d-flex align-items-center gap-2 mb-2 pb-1 border-bottom" style="font-size: 0.95rem;">
                                <i class="bi bi-check2-circle text-success"></i> 2. Trách nhiệm công việc chính
                            </h5>
                            <div class="text-secondary small lh-base" id="prevRespList"></div>
                        </div>

                        <!-- 3. Yêu cầu ứng viên -->
                        <div class="mb-4" id="prevSectionRequirements">
                            <h5 class="fw-bold text-dark d-flex align-items-center gap-2 mb-2 pb-1 border-bottom" style="font-size: 0.95rem;">
                                <i class="bi bi-mortarboard text-success"></i> 3. Yêu cầu chuyên môn & Năng lực
                            </h5>
                            <div class="text-secondary small lh-base" id="prevReqList"></div>
                        </div>

                        <!-- 4. Kỹ năng & Công nghệ -->
                        <div class="mb-4" id="prevSectionTech">
                            <h5 class="fw-bold text-dark d-flex align-items-center gap-2 mb-2 pb-1 border-bottom" style="font-size: 0.95rem;">
                                <i class="bi bi-code-slash text-success"></i> 4. Công nghệ & Kỹ năng yêu cầu
                            </h5>
                            <div class="d-flex flex-wrap gap-1.5" id="prevTechBadges"></div>
                        </div>

                        <!-- 5. Quyền lợi & Đãi ngộ -->
                        <div class="mb-3" id="prevSectionBenefits">
                            <h5 class="fw-bold text-dark d-flex align-items-center gap-2 mb-2 pb-1 border-bottom" style="font-size: 0.95rem;">
                                <i class="bi bi-gift text-success"></i> 5. Chế độ đãi ngộ & Quyền lợi
                            </h5>
                            <div class="text-secondary small lh-base" id="prevBenefitsList"></div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Footer Modal Preview -->
            <div class="modal-footer bg-white border-top py-2.5 px-4 d-flex justify-content-between">
                <span class="text-muted small">
                    <i class="bi bi-shield-check text-success me-1"></i>Đồng bộ trực tiếp với hệ thống tuyển dụng NoveraTech ATS
                </span>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-secondary px-3" data-bs-dismiss="modal" style="border-radius: 8px;">Đóng</button>
                    <button type="button" class="btn btn-sm btn-novera-primary px-3 fw-semibold" onclick="switchToEditFromPreview()" style="border-radius: 8px;">
                        <i class="bi bi-pencil-square me-1"></i> Mở form chỉnh sửa
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════
     MODAL 2: CHỈNH SỬA BÀI ĐĂNG TRỰC TIẾP (DIRECT EDIT MODAL)
     ══════════════════════════════════════════════════════════ -->
<div class="modal fade" id="jobDirectEditModal" tabindex="-1" aria-labelledby="jobDirectEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-header bg-white border-bottom py-3 px-4">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1 font-monospace" style="font-size: 0.75rem;">EDITOR</span>
                    <h5 class="modal-title fw-bold text-dark mb-0 fs-6" id="jobDirectEditModalLabel">
                        <i class="bi bi-pencil-square text-warning me-1"></i> Chỉnh sửa bài đăng tuyển dụng
                    </h5>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-outline-primary px-3" onclick="openPreviewFromCurrentEdit()" style="border-radius: 8px;">
                        <i class="bi bi-eye me-1"></i> Xem trước (Live Preview)
                    </button>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>

            <form id="formDirectEdit" onsubmit="handleDirectEditSubmit(event)">
                <input type="hidden" id="editJobId" name="JobId" value="" />
                <input type="hidden" id="editJobSlug" value="" />

                <div class="modal-body p-4" style="background: #FAFBFD;">
                    <div class="alert alert-light border py-2 px-3 mb-3 small d-flex align-items-center justify-content-between" style="border-radius: 8px;">
                        <div>
                            <i class="bi bi-shield-check text-success me-1"></i>
                            Đang chỉnh sửa mã tin: <strong id="editJobCodeDisplay" class="font-monospace text-dark">NT-CODE</strong>
                        </div>
                        <span class="text-muted" style="font-size: 0.75rem;">Mọi thay đổi sẽ cập nhật trực tiếp lên cổng tuyển dụng NoveraTech</span>
                    </div>

                    <!-- Phần 1: Thông tin cơ bản -->
                    <div class="card border-0 shadow-sm p-3 mb-3" style="border-radius: 10px;">
                        <h6 class="fw-bold text-dark mb-3 pb-1 border-bottom" style="font-size: 0.88rem;">
                            <i class="bi bi-info-circle text-primary me-1"></i> 1. Thông tin chung bài đăng
                        </h6>
                        <div class="row g-3">
                            <div class="col-12 col-md-8">
                                <label class="form-label fw-semibold small text-dark">Tiêu đề vị trí tuyển dụng <span class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-sm" id="editTitle" required style="border-radius: 6px;" placeholder="Ví dụ: Lead Cloud & AI Solutions Architect" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-semibold small text-dark">Phòng ban</label>
                                <input type="text" class="form-control form-control-sm" id="editDepartment" style="border-radius: 6px;" placeholder="Ví dụ: Phòng Công nghệ Thông tin" />
                            </div>

                            <div class="col-6 col-md-3">
                                <label class="form-label fw-semibold small text-dark">Cấp bậc (Level)</label>
                                <select class="form-select form-select-sm" id="editExperienceLevel" style="border-radius: 6px;">
                                    <option value="INTERN">Thực tập sinh (Intern)</option>
                                    <option value="FRESHER">Fresher</option>
                                    <option value="JUNIOR">Junior</option>
                                    <option value="MIDDLE">Middle</option>
                                    <option value="MIDDLE-SENIOR">Middle - Senior</option>
                                    <option value="SENIOR">Senior</option>
                                    <option value="LEAD">Tech Lead / Lead</option>
                                    <option value="MANAGER">Manager / Quản lý</option>
                                    <option value="DIRECTOR">Director / Giám đốc</option>
                                </select>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label fw-semibold small text-dark">Mức lương hiển thị</label>
                                <input type="text" class="form-control form-control-sm font-monospace" id="editSalaryDisplay" style="border-radius: 6px;" placeholder="Ví dụ: 45 - 65 Triệu VND hoặc Thương lượng..." />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label fw-semibold small text-dark">Địa điểm làm việc</label>
                                <input type="text" class="form-control form-control-sm" id="editWorkLocation" style="border-radius: 6px;" placeholder="Ví dụ: Hà Nội (Hybrid 2 ngày WFH)" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label fw-semibold small text-dark">Hạn nộp hồ sơ (Deadline)</label>
                                <input type="date" class="form-control form-control-sm font-monospace" id="editDeadline" style="border-radius: 6px;" />
                            </div>
                        </div>
                    </div>

                    <!-- Phần 2: Nội dung Job Description chi tiết -->
                    <div class="card border-0 shadow-sm p-3 mb-2" style="border-radius: 10px;">
                        <h6 class="fw-bold text-dark mb-3 pb-1 border-bottom" style="font-size: 0.88rem;">
                            <i class="bi bi-file-earmark-text text-success me-1"></i> 2. Nội dung chi tiết Job Description (TopCV Format)
                        </h6>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-dark">Tổng quan vị trí (Overview / Summary)</label>
                            <textarea class="form-control form-control-sm" id="editOverview" rows="2" style="border-radius: 6px;" placeholder="Mô tả tóm tắt vai trò trọng tâm của vị trí này..."></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-dark">Trách nhiệm công việc chính (Mỗi ý một dòng)</label>
                            <textarea class="form-control form-control-sm" id="editResponsibilities" rows="4" style="border-radius: 6px;" placeholder="Xây dựng và phát triển kiến trúc hệ thống...&#10;Thiết kế các API microservices hiệu năng cao...&#10;Phối hợp cùng team Tech Lead và Product Manager..."></textarea>
                            <div class="form-text small text-muted">Nhập các đầu việc chính, mỗi ý cách nhau bằng một lần Enter (xuống dòng).</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-dark">Yêu cầu chuyên môn & Năng lực (Mỗi ý một dòng)</label>
                            <textarea class="form-control form-control-sm" id="editRequirements" rows="4" style="border-radius: 6px;" placeholder="Tối thiểu 3 năm kinh nghiệm trong lĩnh vực liên quan...&#10;Hiểu sâu về các giải pháp Cloud, Microservices, Security...&#10;Khả năng tư duy logic và giải quyết vấn đề tốt..."></textarea>
                            <div class="form-text small text-muted">Nhập các tiêu chuẩn kỹ thuật & kinh nghiệm cần thiết cho ứng viên.</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-dark">Kỹ năng & Công nghệ yêu cầu (Tech Stack Tags)</label>
                            <input type="text" class="form-control form-control-sm" id="editTechStack" style="border-radius: 6px;" placeholder="Ví dụ: Azure, AWS, .NET 9, Docker, Kubernetes, AI/LLM, PostgreSQL" />
                            <div class="form-text small text-muted">Nhập các thẻ công nghệ, phân tách bằng dấu phẩy (,) để tự động sinh badge kỹ năng.</div>
                        </div>

                        <div class="mb-2">
                            <label class="form-label fw-semibold small text-dark">Chế độ đãi ngộ & Quyền lợi (Mỗi ý một dòng)</label>
                            <textarea class="form-control form-control-sm" id="editBenefits" rows="3" style="border-radius: 6px;" placeholder="Lương tháng 13 + thưởng hiệu quả kinh doanh hàng quý...&#10;Bảo hiểm sức khỏe cao cấp NoveraCare cho bản thân và gia đình...&#10;Chính sách Hybrid linh hoạt 2 ngày WFH / tuần..."></textarea>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-white border-top py-3 px-4 d-flex justify-content-between">
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3" data-bs-dismiss="modal" style="border-radius: 8px;">Hủy bỏ</button>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-primary px-3" onclick="openPreviewFromCurrentEdit()" style="border-radius: 8px;">
                            <i class="bi bi-eye me-1"></i> Xem trước trước khi lưu
                        </button>
                        <button type="submit" class="btn btn-sm btn-novera-primary px-4 fw-semibold" id="btnSaveDirectEdit" style="border-radius: 8px;">
                            <span class="spinner-border spinner-border-sm me-1 d-none" id="spinnerSaveDirectEdit"></span>
                            <i class="bi bi-check-lg me-1" id="iconSaveDirectEdit"></i> Lưu thay đổi
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // ── KHỞI TẠO BOOTSTRAP TOOLTIPS ──
        const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"], [data-bs-toggle-second="tooltip"]'));
        tooltipTriggerList.forEach(function (tooltipTriggerEl) {
            try {
                if (typeof bootstrap.Tooltip.getOrCreateInstance === 'function') {
                    bootstrap.Tooltip.getOrCreateInstance(tooltipTriggerEl);
                } else if (!bootstrap.Tooltip.getInstance(tooltipTriggerEl)) {
                    new bootstrap.Tooltip(tooltipTriggerEl);
                }
            } catch (e) { }
        });

        // ── 1. MODAL GỠ TIN THỦ CÔNG ──
        const unpublishModalEl = document.getElementById('unpublishModal');
        const unpublishModal = new bootstrap.Modal(unpublishModalEl);
        const unpublishJobIdInput = document.getElementById('unpublishJobId');
        const unpublishJobTitleDisplay = document.getElementById('unpublishJobTitleDisplay');
        const unpublishJobCodeDisplay = document.getElementById('unpublishJobCodeDisplay');
        const selectUnpublishReason = document.getElementById('selectUnpublishReason');
        const unpublishReasonText = document.getElementById('unpublishReasonText');

        unpublishReasonText.value = selectUnpublishReason.value;
        selectUnpublishReason.addEventListener('change', function () {
            if (this.value === 'other') {
                unpublishReasonText.value = '';
                unpublishReasonText.focus();
            } else {
                unpublishReasonText.value = this.value;
            }
        });

        function openUnpublish(jobId, jobTitle, jobCode) {
            unpublishJobIdInput.value = jobId;
            unpublishJobTitleDisplay.textContent = jobTitle;
            unpublishJobCodeDisplay.textContent = jobCode;
            unpublishModal.show();
        }

        document.querySelectorAll('.btn-unpublish').forEach(btn => {
            btn.addEventListener('click', function () {
                openUnpublish(this.getAttribute('data-job-id'), this.getAttribute('data-job-title'), this.getAttribute('data-job-code'));
            });
        });

        document.querySelectorAll('.btn-dropdown-unpublish').forEach(btn => {
            btn.addEventListener('click', function () {
                openUnpublish(this.getAttribute('data-job-id'), this.getAttribute('data-job-title'), this.getAttribute('data-job-code'));
            });
        });

        // ── 2. MODAL ĐĂNG LẠI / GIA HẠN TIN ──
        const republishModalEl = document.getElementById('republishModal');
        const republishModal = new bootstrap.Modal(republishModalEl);
        const republishJobIdInput = document.getElementById('republishJobId');
        const republishJobTitleDisplay = document.getElementById('republishJobTitleDisplay');
        const republishJobCodeDisplay = document.getElementById('republishJobCodeDisplay');
        const republishDeadlineInput = document.getElementById('republishDeadline');

        function openRepublish(jobId, jobTitle, jobCode, deadline) {
            republishJobIdInput.value = jobId;
            republishJobTitleDisplay.textContent = jobTitle;
            republishJobCodeDisplay.textContent = jobCode;

            const todayStr = new Date().toISOString().split('T')[0];
            if (!deadline || deadline <= todayStr) {
                const future = new Date();
                future.setDate(future.getDate() + 30);
                republishDeadlineInput.value = future.toISOString().split('T')[0];
            } else {
                republishDeadlineInput.value = deadline;
            }

            republishModal.show();
        }

        document.querySelectorAll('.btn-republish').forEach(btn => {
            btn.addEventListener('click', function () {
                openRepublish(this.getAttribute('data-job-id'), this.getAttribute('data-job-title'), this.getAttribute('data-job-code'), this.getAttribute('data-deadline'));
            });
        });

        document.querySelectorAll('.btn-dropdown-republish').forEach(btn => {
            btn.addEventListener('click', function () {
                openRepublish(this.getAttribute('data-job-id'), this.getAttribute('data-job-title'), this.getAttribute('data-job-code'), this.getAttribute('data-deadline'));
            });
        });

        // ── 3. NÚT KÍCH HOẠT QUÉT HẾT HẠN ──
        const btnTriggerScan = document.getElementById('btnTriggerScan');
        const btnTriggerScanText = document.getElementById('btnTriggerScanText');
        const scanResultAlert = document.getElementById('scanResultAlert');
        const scanResultMessage = document.getElementById('scanResultMessage');

        btnTriggerScan.addEventListener('click', async function () {
            if (btnTriggerScan.disabled) return;

            btnTriggerScan.disabled = true;
            btnTriggerScanText.textContent = 'Đang quét...';

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            try {
                const response = await fetch('/Jobs/trigger-scan', {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'RequestVerificationToken': token,
                        'Content-Type': 'application/x-www-form-urlencoded'
                    }
                });

                if (response.ok) {
                    const data = await response.json();
                    scanResultMessage.innerHTML = `<strong>Thành công:</strong> ${data.message} (Lần quét: ${data.scanTime})`;
                    scanResultAlert.classList.remove('d-none');
                    scanResultAlert.scrollIntoView({ behavior: 'smooth' });

                    setTimeout(() => {
                        window.location.reload();
                    }, 1200);
                } else {
                    if (window.NoveraToast) window.NoveraToast.show('Lỗi máy chủ khi quét tin hết hạn.', 'error');
                    else alert('Lỗi máy chủ khi quét tin hết hạn.');
                }
            } catch (err) {
                console.error(err);
                if (window.NoveraToast) window.NoveraToast.show('Không thể kết nối đến máy chủ.', 'error');
                else alert('Không thể kết nối đến máy chủ.');
            } finally {
                btnTriggerScan.disabled = false;
                btnTriggerScanText.textContent = 'Quét quá hạn';
            }
        });

        // ── 4. LIVE PREVIEW MODAL CONTROLLER ──
        const previewModalEl = document.getElementById('jobLivePreviewModal');
        const previewModal = new bootstrap.Modal(previewModalEl);
        const editModalEl = document.getElementById('jobDirectEditModal');
        const editModal = new bootstrap.Modal(editModalEl);

        let currentPreviewJobId = null;
        let currentPreviewSlug = null;
        let currentEditJobId = null;
        let currentEditSlug = null;

        function escapeHtml(str) {
            if (!str) return '';
            const d = document.createElement('div');
            d.textContent = str;
            return d.innerHTML;
        }

        window.setPreviewDevice = function(device) {
            const container = document.getElementById('previewFrameContainer');
            const btnDesktop = document.getElementById('btnPreviewDesktop');
            const btnMobile = document.getElementById('btnPreviewMobile');

            if (device === 'mobile') {
                container.classList.add('is-mobile');
                btnMobile.classList.add('btn-white', 'active');
                btnMobile.classList.remove('text-secondary');
                btnDesktop.classList.remove('btn-white', 'active');
                btnDesktop.classList.add('text-secondary');
            } else {
                container.classList.remove('is-mobile');
                btnDesktop.classList.add('btn-white', 'active');
                btnDesktop.classList.remove('text-secondary');
                btnMobile.classList.remove('btn-white', 'active');
                btnMobile.classList.add('text-secondary');
            }
        };

        window.bindJobPreviewData = function(job) {
            document.getElementById('prevJobCodeBadge').textContent = job.code || 'NT-JOB';
            document.getElementById('prevBadgeDept').textContent = job.department || 'Phòng ban';
            document.getElementById('prevBadgeLevel').textContent = (job.experienceLevel || 'SENIOR').toUpperCase();
            document.getElementById('prevBadgeType').textContent = job.employmentType || 'Toàn thời gian';
            document.getElementById('prevJobTitle').textContent = job.title || 'Tiêu đề tuyển dụng';
            document.getElementById('prevJobOverviewShort').textContent = job.overview || job.positionDescription || 'Đang cập nhật tóm tắt vị trí...';
            
            document.getElementById('prevSalary').textContent = job.salaryDisplay || 'Thương lượng';
            document.getElementById('prevLocation').textContent = job.workLocation || 'Hà Nội';
            document.getElementById('prevLevel').textContent = job.experienceLevel || 'Senior';

            if (job.deadline) {
                const dl = new Date(job.deadline);
                document.getElementById('prevDeadline').textContent = isNaN(dl.getTime()) ? job.deadline : `${String(dl.getDate()).padStart(2, '0')}/${String(dl.getMonth() + 1).padStart(2, '0')}/${dl.getFullYear()}`;
            } else {
                document.getElementById('prevDeadline').textContent = 'Không giới hạn';
            }

            // External link
            const extLink = document.getElementById('previewExternalLink');
            extLink.href = '/Jobs/' + (job.slug || job.id);

            // 1. Overview
            const overviewEl = document.getElementById('prevOverviewContent');
            overviewEl.textContent = job.overview || job.positionDescription || 'Chưa cập nhật nội dung tổng quan.';

            // 2. Responsibilities
            const respListEl = document.getElementById('prevRespList');
            respListEl.innerHTML = '';
            const resps = Array.isArray(job.responsibilities) ? job.responsibilities : (job.responsibilities ? job.responsibilities.split('\n') : []);
            if (resps.length > 0) {
                resps.filter(r => r && r.trim()).forEach(r => {
                    const item = document.createElement('div');
                    item.className = 'prev-check-item';
                    item.innerHTML = escapeHtml(r.trim());
                    respListEl.appendChild(item);
                });
                document.getElementById('prevSectionResponsibilities').classList.remove('d-none');
            } else {
                document.getElementById('prevSectionResponsibilities').classList.add('d-none');
            }

            // 3. Requirements
            const reqListEl = document.getElementById('prevReqList');
            reqListEl.innerHTML = '';
            const reqs = Array.isArray(job.requirements) ? job.requirements : (job.requirements ? job.requirements.split('\n') : []);
            if (reqs.length > 0) {
                reqs.filter(r => r && r.trim()).forEach(r => {
                    const item = document.createElement('div');
                    item.className = 'prev-check-item';
                    item.innerHTML = escapeHtml(r.trim());
                    reqListEl.appendChild(item);
                });
                document.getElementById('prevSectionRequirements').classList.remove('d-none');
            } else {
                document.getElementById('prevSectionRequirements').classList.add('d-none');
            }

            // 4. Tech Stack
            const techEl = document.getElementById('prevTechBadges');
            techEl.innerHTML = '';
            const techs = Array.isArray(job.techStack) ? job.techStack : (job.techStack ? job.techStack.split(',').map(s => s.trim()) : []);
            if (techs.length > 0 && techs[0]) {
                techs.forEach(t => {
                    if (!t) return;
                    const badge = document.createElement('span');
                    badge.className = 'badge bg-light text-dark border px-2.5 py-1.5 font-monospace';
                    badge.style.borderRadius = '6px';
                    badge.style.fontSize = '0.78rem';
                    badge.textContent = t;
                    techEl.appendChild(badge);
                });
                document.getElementById('prevSectionTech').classList.remove('d-none');
            } else {
                document.getElementById('prevSectionTech').classList.add('d-none');
            }

            // 5. Benefits
            const beneListEl = document.getElementById('prevBenefitsList');
            beneListEl.innerHTML = '';
            const benes = Array.isArray(job.benefits) ? job.benefits : (job.benefits ? job.benefits.split('\n') : []);
            if (benes.length > 0) {
                benes.filter(b => b && b.trim()).forEach(b => {
                    const item = document.createElement('div');
                    item.className = 'prev-check-item';
                    item.innerHTML = escapeHtml(b.trim());
                    beneListEl.appendChild(item);
                });
                document.getElementById('prevSectionBenefits').classList.remove('d-none');
            } else {
                document.getElementById('prevSectionBenefits').classList.add('d-none');
            }
        };

        window.openJobPreview = async function(jobId, jobSlug) {
            currentPreviewJobId = jobId;
            currentPreviewSlug = jobSlug;

            const modalInstance = bootstrap.Modal.getOrCreateInstance(document.getElementById('jobLivePreviewModal'));
            modalInstance.show();

            try {
                const res = await fetch(`/api/jobs/${encodeURIComponent(jobId)}`);
                if (!res.ok) throw new Error('Không thể tải bài đăng');
                const json = await res.json();
                if (json.success && json.data) {
                    window.bindJobPreviewData(json.data);
                } else {
                    if (window.NoveraToast) window.NoveraToast.show(json.message || 'Lỗi khi tải thông tin bài đăng.', 'error');
                }
            } catch (err) {
                console.error(err);
                if (window.NoveraToast) window.NoveraToast.show('Không thể tải dữ liệu xem trước bài đăng.', 'error');
            }
        };

        window.switchToEditFromPreview = function() {
            bootstrap.Modal.getOrCreateInstance(document.getElementById('jobLivePreviewModal')).hide();
            if (currentPreviewJobId) {
                window.openJobEdit(currentPreviewJobId, currentPreviewSlug);
            }
        };

        // ── 5. DIRECT EDIT MODAL CONTROLLER ──
        window.openJobEdit = async function(jobId, jobSlug) {
            currentEditJobId = jobId;
            currentEditSlug = jobSlug;

            const modalInstance = bootstrap.Modal.getOrCreateInstance(document.getElementById('jobDirectEditModal'));
            document.getElementById('editJobId').value = jobId;
            document.getElementById('editJobSlug').value = jobSlug || jobId;
            document.getElementById('editJobCodeDisplay').textContent = 'Đang tải dữ liệu...';
            modalInstance.show();

            try {
                const res = await fetch(`/api/jobs/${encodeURIComponent(jobId)}`);
                if (!res.ok) throw new Error('Không thể tải bài đăng');
                const json = await res.json();
                if (json.success && json.data) {
                    const job = json.data;
                    document.getElementById('editJobId').value = job.id;
                    document.getElementById('editJobSlug').value = job.slug || job.id;
                    document.getElementById('editJobCodeDisplay').textContent = job.code || 'NT-JOB';
                    document.getElementById('editTitle').value = job.title || '';
                    document.getElementById('editDepartment').value = job.department || '';
                    document.getElementById('editExperienceLevel').value = (job.experienceLevel || 'SENIOR').toUpperCase();
                    document.getElementById('editSalaryDisplay').value = job.salaryDisplay || '';
                    document.getElementById('editWorkLocation').value = job.workLocation || '';
                    
                    if (job.deadline) {
                        const dl = new Date(job.deadline);
                        if (!isNaN(dl.getTime())) {
                            document.getElementById('editDeadline').value = dl.toISOString().split('T')[0];
                        }
                    } else {
                        document.getElementById('editDeadline').value = '';
                    }

                    document.getElementById('editOverview').value = job.overview || job.positionDescription || '';
                    document.getElementById('editResponsibilities').value = Array.isArray(job.responsibilities) ? job.responsibilities.join('\n') : (job.responsibilities || '');
                    document.getElementById('editRequirements').value = Array.isArray(job.requirements) ? job.requirements.join('\n') : (job.requirements || '');
                    document.getElementById('editTechStack').value = Array.isArray(job.techStack) ? job.techStack.join(', ') : (job.techStack || '');
                    document.getElementById('editBenefits').value = Array.isArray(job.benefits) ? job.benefits.join('\n') : (job.benefits || '');
                } else {
                    if (window.NoveraToast) window.NoveraToast.show(json.message || 'Lỗi khi tải thông tin bài đăng.', 'error');
                }
            } catch (err) {
                console.error(err);
                if (window.NoveraToast) window.NoveraToast.show('Không thể tải dữ liệu để chỉnh sửa.', 'error');
            }
        };

        window.openPreviewFromCurrentEdit = function() {
            const mockJob = {
                id: document.getElementById('editJobId').value,
                slug: document.getElementById('editJobSlug').value,
                code: document.getElementById('editJobCodeDisplay').textContent,
                title: document.getElementById('editTitle').value,
                department: document.getElementById('editDepartment').value,
                experienceLevel: document.getElementById('editExperienceLevel').value,
                salaryDisplay: document.getElementById('editSalaryDisplay').value,
                workLocation: document.getElementById('editWorkLocation').value,
                deadline: document.getElementById('editDeadline').value,
                overview: document.getElementById('editOverview').value,
                responsibilities: document.getElementById('editResponsibilities').value.split('\n').filter(s => s.trim()),
                requirements: document.getElementById('editRequirements').value.split('\n').filter(s => s.trim()),
                techStack: document.getElementById('editTechStack').value.split(',').map(s => s.trim()).filter(Boolean),
                benefits: document.getElementById('editBenefits').value.split('\n').filter(s => s.trim())
            };
            currentPreviewJobId = mockJob.id;
            currentPreviewSlug = mockJob.slug;

            window.bindJobPreviewData(mockJob);
            previewModal.show();
        };

        window.handleDirectEditSubmit = async function(e) {
            e.preventDefault();
            const jobId = document.getElementById('editJobId').value;
            if (!jobId) return;

            const btnSave = document.getElementById('btnSaveDirectEdit');
            const spinner = document.getElementById('spinnerSaveDirectEdit');
            const icon = document.getElementById('iconSaveDirectEdit');

            btnSave.disabled = true;
            spinner.classList.remove('d-none');
            icon.classList.add('d-none');

            const payload = {
                title: document.getElementById('editTitle').value.trim(),
                department: document.getElementById('editDepartment').value.trim(),
                experienceLevel: document.getElementById('editExperienceLevel').value,
                salaryDisplay: document.getElementById('editSalaryDisplay').value.trim(),
                workLocation: document.getElementById('editWorkLocation').value.trim(),
                deadline: document.getElementById('editDeadline').value ? document.getElementById('editDeadline').value + 'T23:59:59Z' : null,
                overview: document.getElementById('editOverview').value.trim(),
                responsibilities: document.getElementById('editResponsibilities').value.trim(),
                requirements: document.getElementById('editRequirements').value.trim(),
                techStack: document.getElementById('editTechStack').value.trim(),
                benefits: document.getElementById('editBenefits').value.trim()
            };

            try {
                const res = await fetch(`/api/jobs/${encodeURIComponent(jobId)}`, {
                    method: 'PATCH',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                const data = await res.json();
                if (res.ok && data.success) {
                    // Cập nhật DOM trên dòng tương ứng của bảng
                    const titleEl = document.getElementById(`job-title-${jobId}`);
                    if (titleEl) titleEl.textContent = payload.title;

                    const deptEl = document.getElementById(`job-dept-${jobId}`);
                    if (deptEl) deptEl.textContent = payload.department;

                    const locEl = document.getElementById(`job-loc-${jobId}`);
                    if (locEl) locEl.textContent = payload.workLocation;

                    const salaryEl = document.getElementById(`job-salary-${jobId}`);
                    if (salaryEl) salaryEl.textContent = payload.salaryDisplay;

                    const deadlineEl = document.getElementById(`job-deadline-${jobId}`);
                    if (deadlineEl && payload.deadline) {
                        const dl = new Date(payload.deadline);
                        deadlineEl.textContent = `${String(dl.getDate()).padStart(2, '0')}/${String(dl.getMonth() + 1).padStart(2, '0')}/${dl.getFullYear()}`;
                    }

                    if (window.NoveraToast) window.NoveraToast.show('Cập nhật tin tuyển dụng thành công!', 'success');
                    else alert('Cập nhật bài đăng tuyển dụng thành công!');

                    bootstrap.Modal.getOrCreateInstance(document.getElementById('jobDirectEditModal')).hide();
                } else {
                    if (window.NoveraToast) window.NoveraToast.show(data.message || 'Lỗi cập nhật tin tuyển dụng.', 'error');
                    else alert(data.message || 'Lỗi cập nhật bài đăng.');
                }
            } catch (err) {
                console.error(err);
                if (window.NoveraToast) window.NoveraToast.show('Không thể kết nối đến máy chủ để cập nhật.', 'error');
                else alert('Lỗi kết nối máy chủ.');
            } finally {
                btnSave.disabled = false;
                spinner.classList.add('d-none');
                icon.classList.remove('d-none');
            }
        };

        // Sao chép link JD helper
        window.copyJobUrl = function(slugOrId) {
            const url = `${window.location.origin}/Jobs/${slugOrId}`;
            if (navigator.clipboard) {
                navigator.clipboard.writeText(url).then(() => {
                    if (window.NoveraToast) window.NoveraToast.show('Đã sao chép liên kết tin tuyển dụng!', 'success');
                    else alert('Đã sao chép liên kết bài đăng!');
                });
            } else {
                prompt('Sao chép liên kết:', url);
            }
        };
    });
</script>
}
