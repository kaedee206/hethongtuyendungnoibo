@using Ats.Web.Models.Enums
@model Ats.Web.Models.ViewModels.Jobs.JobManagementListViewModel
@{
    ViewData["Title"] = "Quản lý tin tuyển dụng";
    Layout = "_Layout";
}

@* ══════════════════════════════════════════════════════════
   NOVERATECH ATS — MÀN HÌNH QUẢN LÝ TIN TUYỂN DỤNG
   Tuân thủ RULE.md: Nền #F8FAFC, Accent #059669, Single-Tier Header,
   Loại bỏ AI Slop, Icon Action Group thu gọn chống rối mắt.
   ══════════════════════════════════════════════════════════ *@

<style>
    .jobs-manage-container {
        padding: 1.5rem 0 3rem;
    }

    /* KPI Stat Cards */
    .job-stat-card {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        padding: 1.15rem 1.25rem;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .job-stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
    }
    .job-stat-icon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    /* Filter Bar */
    .job-filter-card {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        padding: 1rem 1.25rem;
    }

    /* Table Container */
    .job-table-card {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        overflow: hidden;
    }
    .job-table thead th {
        background-color: #F8FAFC;
        color: #64748B;
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid #E2E8F0;
        padding: 0.85rem 1rem;
        vertical-align: middle;
    }
    .job-table tbody td {
        padding: 0.95rem 1rem;
        vertical-align: middle;
        border-bottom: 1px solid #F1F5F9;
        font-size: 0.875rem;
    }
    .job-table tbody tr:hover td {
        background-color: #F8FAFC;
    }

    /* Action Buttons: Compact Icon Group (Zero Clutter) */
    .btn-action-icon {
        width: 32px;
        height: 32px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        font-size: 0.85rem;
        transition: all 0.15s ease;
    }
    .btn-action-icon:hover {
        transform: translateY(-1px);
        box-shadow: 0 2px 6px rgba(15, 23, 42, 0.08);
    }

    /* Live Preview Container (Desktop vs Mobile Frame) */
    .preview-frame-container {
        width: 100%;
        max-width: 100%;
        transition: max-width 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
    }
    .preview-frame-container.is-mobile {
        max-width: 430px !important;
        border: 8px solid #1E293B;
        border-radius: 28px;
        box-shadow: 0 16px 36px rgba(15, 23, 42, 0.18);
        background: #FFFFFF;
        padding: 14px;
        margin: 10px auto 25px;
    }
    .prev-check-item {
        position: relative;
        padding-left: 1.4rem;
        margin-bottom: 0.5rem;
    }
    .prev-check-item::before {
        content: '\F26E';
        font-family: 'bootstrap-icons';
        position: absolute;
        left: 0;
        top: 0;
        color: #059669;
        font-weight: 700;
    }

    /* Brand Primary Color */
    .btn-novera-primary {
        background-color: #059669 !important;
        border-color: #059669 !important;
        color: #FFFFFF !important;
    }
    .btn-novera-primary:hover {
        background-color: #047857 !important;
        border-color: #047857 !important;
        color: #FFFFFF !important;
    }

    /* Status Badges */
    .job-badge-status {
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.3rem 0.6rem;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        white-space: nowrap;
    }

    /* Pagination */
    .pagination .page-item.active .page-link {
        background-color: #059669 !important;
        border-color: #059669 !important;
        color: #FFFFFF !important;
        font-weight: 600;
    }
    .pagination .page-link {
        color: #0F172A;
        border-color: #E2E8F0;
        padding: 0.3rem 0.65rem;
        font-size: 0.825rem;
    }
</style>

<div class="container-fluid px-3 px-md-4 jobs-manage-container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0" style="font-size: 0.85rem;">
            <li class="breadcrumb-item"><a href="/Workspace" class="text-decoration-none text-muted">Bàn làm việc</a></li>
            <li class="breadcrumb-item"><a href="/Jobs" class="text-decoration-none text-muted">Cổng Tuyển dụng</a></li>
            <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Quản lý tin đăng</li>
        </ol>
    </nav>

    <!-- Single-Tier Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h4 fw-bold text-dark mb-1">Quản lý tin tuyển dụng</h1>
            <p class="text-muted small mb-0">Theo dõi vòng đời bài đăng, điều chỉnh trạng thái công khai và đồng bộ dữ liệu tuyển dụng.</p>
        </div>
        <div class="mobile-action-bar align-items-center gap-2">
            <!-- Nút quét quá hạn tinh gọn -->
            <button type="button" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1.5 shadow-sm" id="btnTriggerScan" style="border-radius: 8px; font-weight: 500;" title="Kiểm tra và tự động cập nhật trạng thái các tin đã quá hạn nộp hồ sơ">
                <i class="bi bi-arrow-repeat"></i> <span id="btnTriggerScanText">Quét quá hạn</span>
            </button>

            <!-- Xem cổng việc làm -->
            <a href="/Jobs" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1.5 shadow-sm" style="border-radius: 8px; font-weight: 500;">
                <i class="bi bi-briefcase"></i> Cổng việc làm
            </a>

            <!-- Đăng tin mới -->
            <a href="/Workspace" class="btn btn-sm btn-novera-primary d-inline-flex align-items-center gap-1.5 shadow-sm" style="border-radius: 8px; font-weight: 500;">
                <i class="bi bi-plus-lg"></i> Tạo tin tuyển dụng
            </a>
        </div>
    </div>



    <!-- Banner kết quả quét tự động -->
    <div id="scanResultAlert" class="alert alert-info alert-dismissible fade show shadow-sm mb-4 d-none" role="alert" style="border-radius: 8px; border-left: 4px solid #0EA5E9;">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-info-circle-fill text-info"></i>
            <div id="scanResultMessage" class="fw-semibold small"></div>
        </div>
        <button type="button" class="btn-close" onclick="document.getElementById('scanResultAlert').classList.add('d-none');" aria-label="Close"></button>
    </div>

    <!-- 4 KPI Stat Cards đối xứng chuẩn RULE.md -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="job-stat-card shadow-sm">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-secondary small fw-semibold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.04em;">Tổng tin đăng</div>
                        <div class="fw-bold text-dark mt-1 font-monospace" style="font-size: 1.65rem;">@Model.TotalPostings</div>
                    </div>
                    <div class="job-stat-icon bg-light text-secondary border">
                        <i class="bi bi-folder2-open"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2">Toàn bộ tin trên hệ thống</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="job-stat-card shadow-sm">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-secondary small fw-semibold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.04em;">Đang đăng tuyển</div>
                        <div class="fw-bold mt-1 font-monospace" style="color: #059669; font-size: 1.65rem;">@Model.PublishedCount</div>
                    </div>
                    <div class="job-stat-icon" style="background: #ECFDF5; color: #059669;">
                        <i class="bi bi-broadcast"></i>
                    </div>
                </div>
                <div class="small mt-2" style="color: #059669;">
                    <span class="d-inline-block rounded-circle me-1" style="width: 6px; height: 6px; background-color: #059669;"></span>Hiển thị công khai
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="job-stat-card shadow-sm">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-secondary small fw-semibold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.04em;">Đã gỡ thủ công</div>
                        <div class="fw-bold mt-1 font-monospace" style="color: #D97706; font-size: 1.65rem;">@Model.ClosedCount</div>
                    </div>
                    <div class="job-stat-icon" style="background: #FFFBEB; color: #D97706;">
                        <i class="bi bi-eye-slash"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2">Tạm ẩn khỏi cổng tuyển dụng</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="job-stat-card shadow-sm">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-secondary small fw-semibold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.04em;">Quá hạn nhận hồ sơ</div>
                        <div class="fw-bold mt-1 font-monospace" style="color: #DC2626; font-size: 1.65rem;">@Model.ExpiredCount</div>
                    </div>
                    <div class="job-stat-icon" style="background: #FEF2F2; color: #DC2626;">
                        <i class="bi bi-clock-history"></i>
                    </div>
                </div>
                <div class="small text-muted mt-2">Đã hết hạn nhận hồ sơ</div>
            </div>
        </div>
    </div>

    <!-- Thanh Lọc & Tìm kiếm -->
    <div class="job-filter-card shadow-sm mb-4">
        <form method="get" asp-action="Manage" class="row g-2 align-items-center">
            <!-- Tìm kiếm từ khoá -->
            <div class="col-12 col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted" style="border-radius: 8px 0 0 8px;">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="search" value="@Model.SearchKeyword" class="form-control border-start-0 py-2" placeholder="Tìm theo tiêu đề, mã tin, phòng ban, địa điểm..." style="border-radius: 0 8px 8px 0; font-size: 0.85rem;" />
                </div>
            </div>

            <!-- Lọc trạng thái -->
            <div class="col-12 col-md-4">
                <select name="status" class="form-select form-select-sm py-2" onchange="this.form.submit()" style="border-radius: 8px; font-size: 0.85rem;">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.SelectedStatus))">Tất cả trạng thái tin đăng</option>
                    <option value="PUBLISHED" selected="@(Model.SelectedStatus == "PUBLISHED")">🟢 Đang đăng tuyển (Công khai)</option>
                    <option value="CLOSED" selected="@(Model.SelectedStatus == "CLOSED")">🟡 Đã gỡ thủ công (Tạm ẩn)</option>
                    <option value="EXPIRED" selected="@(Model.SelectedStatus == "EXPIRED")">🔴 Quá hạn nhận hồ sơ (Đã ẩn)</option>
                    <option value="DRAFT" selected="@(Model.SelectedStatus == "DRAFT")">⚪ Bản nháp (Chưa công bố)</option>
                </select>
            </div>

            <!-- Nút tìm kiếm & Xoá bộ lọc -->
            <div class="col-12 col-md-3 d-flex gap-2 justify-content-md-end">
                <button type="submit" class="btn btn-sm btn-novera-primary px-3 py-2 flex-grow-1 flex-md-grow-0" style="border-radius: 8px; font-weight: 500;">
                    <i class="bi bi-funnel me-1"></i> Lọc
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.SearchKeyword) || !string.IsNullOrWhiteSpace(Model.SelectedStatus))
                {
                    <a asp-action="Manage" class="btn btn-sm btn-outline-secondary py-2 px-3" style="border-radius: 8px;" title="Xoá bộ lọc">
                        <i class="bi bi-x-circle me-1"></i> Bỏ lọc
                    </a>
                }
            </div>
        </form>
        @if (Model.LastAutoScanTime.HasValue)
        {
            <div class="d-flex align-items-center gap-1 text-muted small mt-2 pt-2 border-top" style="font-size: 0.78rem;">
                <i class="bi bi-shield-check text-success"></i>
                <span>Tác vụ kiểm soát quá hạn lần cuối:</span>
                <span class="font-monospace text-dark fw-semibold">@Model.LastAutoScanTime.Value.ToString("HH:mm:ss dd/MM/yyyy")</span>
                @if (Model.LastAutoScanExpiredCount > 0)
                {
                    <span class="badge bg-warning-subtle text-dark border ms-1" style="border-radius: 4px; font-size: 0.7rem;">Ẩn @Model.LastAutoScanExpiredCount tin</span>
                }
            </div>
        }
    </div>

    <!-- Bảng danh sách tin tuyển dụng -->
    <div class="job-table-card shadow-sm">
        <div class="ats-mobile-table-hint px-3 pt-2"><i class="bi bi-arrow-left-right"></i> Vuốt ngang để xem đủ thông tin tin tuyển dụng & thao tác</div>
        <div class="ats-mobile-table-wrapper table-responsive mb-0">
            <table class="table job-table align-middle mb-0" style="min-width: 900px;">
                <thead>
                    <tr>
                        <th class="ps-4" style="min-width: 220px;">Tin tuyển dụng & Mã</th>
                        <th style="min-width: 150px;">Phòng ban & Địa điểm</th>
                        <th style="min-width: 120px;">Mức lương</th>
                        <th style="min-width: 110px;">Hạn nộp</th>
                        <th style="min-width: 70px;" class="text-center">Hồ sơ</th>
                        <th style="min-width: 130px;">Trạng thái</th>
                        <th class="pe-4 text-end" style="min-width: 100px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                <span class="fw-medium">Không tìm thấy tin tuyển dụng nào phù hợp với điều kiện tìm kiếm.</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr id="job-row-@item.Id">
                                <!-- Tiêu đề & Mã tin -->
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-1.5 mb-1">
                                        <span class="badge bg-light text-secondary border font-monospace" style="border-radius: 4px; font-size: 0.72rem; font-weight: 600;">
                                            @item.Code
                                        </span>
                                    </div>
                                    <a href="/Jobs/@(item.Slug ?? item.Id.ToString())" class="fw-bold text-dark text-decoration-none text-truncate d-block" style="max-width: 320px;" title="@item.Title" id="job-title-@item.Id">
                                        @item.Title
                                    </a>
                                </td>

                                <!-- Phòng ban & Địa điểm -->
                                <td>
                                    <div class="fw-medium text-dark" id="job-dept-@item.Id">@item.Department</div>
                                    <div class="text-muted small d-flex align-items-center gap-1 mt-0.5">
                                        <i class="bi bi-geo-alt"></i> <span id="job-loc-@item.Id">@item.WorkLocation</span>
                                    </div>
                                </td>

                                <!-- Lương -->
                                <td>
                                    <span class="font-monospace fw-semibold small" style="color: #059669;" id="job-salary-@item.Id">
                                        @item.SalaryDisplay
                                    </span>
                                </td>

                                <!-- Hạn nộp hồ sơ -->
                                <td>
                                    @if (item.ExpiredAt.HasValue)
                                    {
                                        var isPassed = item.ExpiredAt.Value <= DateTimeOffset.UtcNow;
                                        <div class="font-monospace small @(isPassed ? "text-danger fw-bold" : "text-dark")" id="job-deadline-@item.Id">
                                            @item.ExpiredAt.Value.ToString("dd/MM/yyyy")
                                        </div>
                                        @if (isPassed)
                                        {
                                            <span class="badge bg-danger-subtle text-danger px-1.5 py-0.5" style="border-radius: 4px; font-size: 0.68rem;">Đã hết hạn</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small" id="job-deadline-@item.Id">Không giới hạn</span>
                                    }
                                </td>

                                <!-- Hồ sơ ứng tuyển -->
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border px-2 py-1 font-monospace" style="border-radius: 6px; font-size: 0.8rem;">
                                        <i class="bi bi-people text-muted me-1"></i>@item.ApplicationsCount
                                    </span>
                                </td>

                                <!-- Trạng thái (Không dùng spinner-grow, chuẩn màu RULE.md) -->
                                <td id="job-status-@item.Id">
                                    @if (item.IsPublished)
                                    {
                                        <span class="job-badge-status" style="background: #ECFDF5; color: #065F46; border: 1px solid #A7F3D0;">
                                            <span class="d-inline-block rounded-circle" style="width: 6px; height: 6px; background-color: #059669;"></span>
                                            Đang đăng tuyển
                                        </span>
                                    }
                                    else if (item.IsClosed)
                                    {
                                        <span class="job-badge-status" style="background: #FFFBEB; color: #92400E; border: 1px solid #FDE68A;" title="@(string.IsNullOrWhiteSpace(item.UnpublishReason) ? "Đã gỡ thủ công" : $"Lý do: {item.UnpublishReason}")">
                                            <i class="bi bi-eye-slash-fill"></i> Đã gỡ thủ công
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(item.UnpublishReason))
                                        {
                                            <div class="text-muted small mt-1 text-truncate" style="max-width: 150px; font-size: 0.72rem;" title="@item.UnpublishReason">
                                                Lý do: @item.UnpublishReason
                                            </div>
                                        }
                                    }
                                    else if (item.IsExpired)
                                    {
                                        <span class="job-badge-status" style="background: #FEF2F2; color: #991B1B; border: 1px solid #FECACA;" title="Tin đã hết hạn nhận hồ sơ">
                                            <i class="bi bi-clock-history"></i> Đã quá hạn (Ẩn)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="job-badge-status" style="background: #F1F5F9; color: #475569; border: 1px solid #CBD5E1;">
                                            <i class="bi bi-pencil"></i> Bản nháp
                                        </span>
                                    }
                                </td>

                                <!-- Thao tác tinh gọn TopCV ATS: 3 nút biểu tượng với tooltip mô tả -->
                                <td class="pe-4 text-end text-nowrap">
                                    <div class="d-inline-flex align-items-center gap-1.5">
                                        <!-- 1. Nút Live Preview: Xem trước bài đăng như ứng viên thấy -->
                                        <button type="button" class="btn btn-sm btn-outline-primary btn-action-icon" 
                                                data-bs-toggle="tooltip" data-bs-placement="top" title="Xem trước bài đăng (Live Preview)"
                                                onclick="openJobPreview('@item.Id', '@(item.Slug ?? item.Id.ToString())')">
                                            <i class="bi bi-eye"></i>
                                        </button>

                                        <!-- 2. Nút Chỉnh sửa trực tiếp: Mở form modal chỉnh sửa bài đăng -->
                                        <button type="button" class="btn btn-sm btn-outline-warning btn-action-icon text-dark" 
                                                data-bs-toggle="tooltip" data-bs-placement="top" title="Chỉnh sửa bài đăng trực tiếp"
                                                onclick="openJobEdit('@item.Id', '@(item.Slug ?? item.Id.ToString())')">
                                            <i class="bi bi-pencil-square text-dark"></i>
                                        </button>

                                        <!-- 3. Nút Tùy chọn (3 chấm): Chứa Ẩn/Hiện bài đăng và các tính năng phụ -->
                                        <div class="dropdown d-inline-block">
                                            <button type="button" class="btn btn-sm btn-outline-secondary btn-action-icon" 
                                                    data-bs-toggle="dropdown" aria-expanded="false" 
                                                    data-bs-toggle-second="tooltip" data-bs-placement="top" title="Tùy chọn khác">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow border py-1" style="border-radius: 8px; font-size: 0.85rem; border-color: #E2E8F0 !important; min-width: 210px;">
                                                @if (item.IsPublished)
                                                {
                                                    <li>
                                                        <a class="dropdown-item py-2 text-danger d-flex align-items-center gap-2 btn-dropdown-unpublish" href="javascript:void(0)"
                                                           data-job-id="@item.Id" data-job-title="@item.Title" data-job-code="@item.Code">
                                                            <i class="bi bi-eye-slash-fill"></i> Ẩn / Gỡ tin tuyển dụng
                                                        </a>
                                                    </li>
                                                }
                                                else if (item.IsClosed || item.IsExpired)
                                                {
                                                    <li>
                                                        <a class="dropdown-item py-2 text-success d-flex align-items-center gap-2 btn-dropdown-republish" href="javascript:void(0)"
                                                           data-job-id="@item.Id" data-job-title="@item.Title" data-job-code="@item.Code"
                                                           data-deadline="@(item.ExpiredAt?.ToString("yyyy-MM-dd") ?? DateTime.UtcNow.AddDays(30).ToString("yyyy-MM-dd"))">
                                                            <i class="bi bi-arrow-repeat"></i> Hiện / Đăng lại tin
                                                        </a>
                                                    </li>
                                                }
                                                <li><hr class="dropdown-divider my-1"></li>
                                                <li>
                                                    <a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/kho-tiem-nang/goi-y/@item.Id">
                                                        <i class="bi bi-stars text-warning"></i> Gợi ý ứng viên kho
                                                    </a>
                                                </li>
                                                @if (User.IsInRole(UserRoles.HRManager) || User.IsInRole(UserRoles.Admin) || User.IsInRole("Trưởng phòng nhân sự") || User.IsInRole("Quản trị viên"))
                                                {
                                                    <li>
                                                        <a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/so-sanh-ung-vien/@item.Id">
                                                            <i class="bi bi-bar-chart-line text-info"></i> Bảng so sánh ứng viên
                                                        </a>
                                                    </li>
                                                }
                                                <li>
                                                    <a class="dropdown-item py-2 d-flex align-items-center gap-2" href="/Jobs/@(item.Slug ?? item.Id.ToString())">
                                                        <i class="bi bi-file-earmark-text text-secondary"></i> Xem trang JD công khai
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item py-2 d-flex align-items-center gap-2" href="javascript:void(0)" onclick="copyJobUrl('@(item.Slug ?? item.Id.ToString())')">
                                                        <i class="bi bi-link-45deg text-secondary"></i> Sao chép link JD
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Phân trang chuẩn đẹp -->
        @if (Model.TotalPages > 1)
        {
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 py-3 px-4 border-top" style="background: #FAFAFA; border-color: #E2E8F0 !important;">
                <span class="small text-muted">
                    Trang <strong>@Model.CurrentPage</strong> / <strong>@Model.TotalPages</strong> (tổng số <strong>@Model.TotalPostings</strong> tin)
                </span>
                <nav aria-label="Phân trang tin tuyển dụng">
                    <ul class="pagination pagination-sm mb-0 gap-1">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Manage", new { page = Model.CurrentPage - 1, search = Model.SearchKeyword, status = Model.SelectedStatus })" style="border-radius: 6px;"><i class="bi bi-chevron-left"></i></a>
                        </li>
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Manage", new { page = p, search = Model.SearchKeyword, status = Model.SelectedStatus })" style="border-radius: 6px;">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Manage", new { page = Model.CurrentPage + 1, search = Model.SearchKeyword, status = Model.SelectedStatus })" style="border-radius: 6px;"><i class="bi bi-chevron-right"></i></a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Modal Gỡ tin thủ công -->
<div class="modal fade" id="unpublishModal" tabindex="-1" aria-labelledby="unpublishModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 12px; overflow: hidden;">
            <div class="modal-header bg-white border-bottom py-3">
                <h5 class="modal-title text-danger fw-bold d-flex align-items-center gap-2" id="unpublishModalLabel" style="font-size: 1.1rem;">
                    <i class="bi bi-exclamation-triangle-fill"></i> Xác nhận gỡ tin tuyển dụng
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formUnpublish" asp-controller="Jobs" asp-action="Unpublish" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="JobId" id="unpublishJobId" value="" />

                <div class="modal-body p-4">
                    <div class="alert alert-warning mb-3 py-2 px-3 small" style="border-radius: 8px;">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        Tin tuyển dụng sẽ được ẩn ngay lập tức khỏi cổng ứng viên công khai.
                    </div>

                    <p class="mb-3 small">
                        Vị trí đang gỡ: <strong id="unpublishJobTitleDisplay" class="text-dark"></strong> 
                        (<span id="unpublishJobCodeDisplay" class="font-monospace text-muted"></span>)
                    </p>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Lý do gỡ tin <span class="text-danger">*</span></label>
                        <select class="form-select form-select-sm mb-2" id="selectUnpublishReason" style="border-radius: 8px;">
                            <option value="Đã tuyển dụng đủ chỉ tiêu nhân sự">Đã tuyển dụng đủ chỉ tiêu nhân sự</option>
                            <option value="Tạm dừng kế hoạch tuyển dụng vị trí này">Tạm dừng kế hoạch tuyển dụng vị trí này</option>
                            <option value="Thay đổi yêu cầu / Cơ cấu lại chức danh">Thay đổi yêu cầu / Cơ cấu lại chức danh</option>
                            <option value="Hết hạn ngân sách tuyển dụng quý">Hết hạn ngân sách tuyển dụng quý</option>
                            <option value="other">Lý do khác (Nhập chi tiết bên dưới)...</option>
                        </select>
                        <textarea class="form-control form-control-sm" name="Reason" id="unpublishReasonText" rows="2" placeholder="Ghi chú thêm lý do gỡ tin..." style="border-radius: 8px;"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3 px-4 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-sm btn-secondary px-3" data-bs-dismiss="modal" style="border-radius: 8px;">Huỷ</button>
                    <button type="submit" class="btn btn-sm btn-danger px-3 fw-semibold" id="btnConfirmUnpublish" style="border-radius: 8px;">
                        <i class="bi bi-eye-slash-fill me-1"></i> Gỡ tin ngay
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Đăng lại / Gia hạn tin -->
<div class="modal fade" id="republishModal" tabindex="-1" aria-labelledby="republishModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 12px; overflow: hidden;">
            <div class="modal-header bg-white border-bottom py-3">
                <h5 class="modal-title text-success fw-bold d-flex align-items-center gap-2" id="republishModalLabel" style="font-size: 1.1rem;">
                    <i class="bi bi-arrow-repeat"></i> Đăng lại & Gia hạn tin tuyển dụng
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formRepublish" asp-controller="Jobs" asp-action="Republish" method="post">
