                </div>
            </form>
        </div>

<!-- ══════════════════════════════════════════════════════════
     MODAL 1: LIVE PREVIEW BÀI ĐĂNG (CHUẨN TOPCV / LINKEDIN ATS)
     ══════════════════════════════════════════════════════════ -->
<div class="modal fade" id="jobLivePreviewModal" tabindex="-1" aria-labelledby="jobLivePreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden; background: #F8FAFC;">
            <!-- Header Modal Preview -->
            <div class="modal-header bg-white border-bottom py-2.5 px-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary-subtle text-primary fw-semibold px-2 py-1 font-monospace" style="font-size: 0.75rem;">LIVE PREVIEW</span>
                    <h5 class="modal-title fw-bold text-dark mb-0 fs-6" id="jobLivePreviewModalLabel">Xem trước giao diện tin tuyển dụng</h5>
                </div>
                
