                        <button type="button" class="btn btn-sm btn-white active px-3 rounded-pill fw-medium shadow-none" id="btnPreviewDesktop" onclick="setPreviewDevice('desktop')">
                            <i class="bi bi-laptop me-1"></i> Desktop
                        </button>
                        <button type="button" class="btn btn-sm text-secondary px-3 rounded-pill fw-medium shadow-none" id="btnPreviewMobile" onclick="setPreviewDevice('mobile')">
                            <i class="bi bi-phone me-1"></i> Mobile
                        </button>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-warning text-dark fw-semibold px-3" onclick="switchToEditFromPreview()" style="border-radius: 8px;">
                        <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa tin
                    </button>
                    <a href="#" target="_blank" id="previewExternalLink" class="btn btn-sm btn-outline-secondary px-2.5" style="border-radius: 8px;" title="Mở trang trong tab mới">
                        <i class="bi bi-box-arrow-up-right"></i>
                    </a>
