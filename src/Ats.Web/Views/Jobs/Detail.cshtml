@using System.Security.Claims
@using Ats.Web.Constants
@model Ats.Web.Models.ViewModels.Jobs.JobDetailViewModel
@{
    ViewData["Title"] = $"{Model.Job.Title} — Tuyển Dụng NoveraTech";
    ViewData["BodyClass"] = "job-detail-page";
    var job = Model.Job;

    var currentUserIdStr = User.FindFirstValue(ClaimTypes.NameIdentifier);
    _ = Guid.TryParse(currentUserIdStr, out var currentUserId);
    var userDept = User.FindFirstValue("Department") ?? "";
    var userEmail = User.FindFirstValue(ClaimTypes.Email) ?? "";

    var isRecruiterOrHr = User.Identity?.IsAuthenticated == true && (
        User.IsInRole(UserRoles.Recruiter) || 
        User.IsInRole(UserRoles.HRManager) || 
        User.IsInRole(UserRoles.Admin) || 
        userDept.Equals("HR", StringComparison.OrdinalIgnoreCase) || 
        userDept.Contains("Nhân sự", StringComparison.OrdinalIgnoreCase)
    );

    var isAdmin = User.Identity?.IsAuthenticated == true && (User.IsInRole(UserRoles.Admin) || User.IsInRole(UserRoles.HRManager));
    var isAuthor = !string.IsNullOrEmpty(userEmail) && (
        string.Equals(userEmail, job.RecruiterEmail, StringComparison.OrdinalIgnoreCase) ||
        string.IsNullOrEmpty(job.Id)
    );

    // CanEdit = (user.role == 'Recruiter' || user.department == 'HR') && (isAuthor || isAdmin)
    var canEditJob = isRecruiterOrHr && (isAuthor || isAdmin);
}

@* ══════════════════════════════════════════════════════════
   NOVERATECH CAREERS — TRANG CHI TIẾT CÔNG VIỆC (JOB DETAIL)
   Định vị: Cổng Tuyển Dụng Nhân Tài NoveraTech (RULE.md Compliant)
   ══════════════════════════════════════════════════════════ *@

<style>
    :root {
        --color-canvas: #F8FAFC;
        --color-card: #FFFFFF;
        --color-border: #E2E8F0;
        --color-text-main: #0F172A;
        --color-text-muted: #64748B;
        --color-accent: #059669;
        --color-accent-hover: #047857;
        --color-accent-subtle: #ECFDF5;
        --radius-button: 8px;
        --radius-card: 12px;
        --radius-badge: 6px;
    }

    body {
        background-color: var(--color-canvas);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        color: var(--color-text-main);
    }

    /* Breadcrumbs */
    .job-breadcrumb {
        font-size: 0.85rem;
        color: var(--color-text-muted);
        margin-bottom: 1.25rem;
    }
    .job-breadcrumb a {
        color: var(--color-text-muted);
        text-decoration: none;
    }
    .job-breadcrumb a:hover {
        color: var(--color-accent);
    }

    /* Header Banner Box */
    .job-header-card {
        background: #FFFFFF;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-card);
        padding: 2.25rem;
        box-shadow: 0 2px 12px rgba(15, 23, 42, 0.04);
        margin-bottom: 2rem;
    }

    .job-h1 {
        font-size: clamp(1.8rem, 3.2vw, 2.35rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        color: var(--color-text-main);
        line-height: 1.25;
    }

    .salary-badge-lg {
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--color-accent);
        background: var(--color-accent-subtle);
        border: 1px solid #A7F3D0;
        border-radius: var(--radius-button);
        padding: 0.4rem 1rem;
        display: inline-block;
    }

    /* Content Card */
    .detail-card {
        background: #FFFFFF;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-card);
        padding: 2rem;
        margin-bottom: 1.75rem;
    }

    .section-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--color-text-main);
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 1.25rem;
        padding-bottom: 0.75rem;
        border-bottom: 1.5px solid #F1F5F9;
    }

    /* Check list */
    .jd-list {
        list-style: none;
        padding-left: 0;
        margin-bottom: 0;
    }
    .jd-list li {
        position: relative;
        padding-left: 1.75rem;
        margin-bottom: 0.85rem;
        line-height: 1.65;
        color: #334155;
        font-size: 0.95rem;
    }
    .jd-list li::before {
        content: '\F26E';
        font-family: 'bootstrap-icons';
        position: absolute;
        left: 0;
        top: 0.1rem;
        color: var(--color-accent);
        font-size: 1rem;
        font-weight: 700;
    }

    /* Sidebar info box */
    .sidebar-widget {
        background: #FFFFFF;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-card);
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .info-row {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 0.65rem 0;
        border-bottom: 1px dashed #E2E8F0;
        font-size: 0.875rem;
    }
    .info-row:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }
    .info-row i {
        color: var(--color-accent);
        font-size: 1.1rem;
        margin-top: 0.1rem;
    }

    /* Buttons */
    .btn-apply-main {
        background: var(--color-accent);
        color: #FFFFFF;
        border: none;
        border-radius: var(--radius-button);
        padding: 0.75rem 1.75rem;
        font-weight: 600;
        font-size: 1rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        text-decoration: none;
        transition: all .2s ease;
        box-shadow: 0 2px 6px rgba(5, 150, 105, 0.2);
    }
    .btn-apply-main:hover {
        background: var(--color-accent-hover);
        color: #FFFFFF;
        box-shadow: 0 4px 14px rgba(5, 150, 105, 0.3);
    }

    .btn-save-job {
        background: #FFFFFF;
        color: var(--color-text-main);
        border: 1.5px solid var(--color-border);
        border-radius: var(--radius-button);
        padding: 0.75rem 1.25rem;
        font-weight: 600;
        font-size: 0.95rem;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        text-decoration: none;
        transition: all .2s ease;
    }
    .btn-save-job:hover {
        border-color: var(--color-accent);
        color: var(--color-accent);
        background: var(--color-accent-subtle);
    }

    /* Tags */
    .tech-pill {
        background: #F1F5F9;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-badge);
        color: #334155;
        font-size: 0.8rem;
        font-weight: 500;
        padding: 0.35rem 0.75rem;
    }
</style>

<div class="container-fluid px-4 px-md-5 py-4">
    <!-- Breadcrumb -->
    <nav class="job-breadcrumb">
        <a href="/gioi-thieu">Trang chủ</a>
        <span class="mx-1.5 text-muted">/</span>
        <a asp-controller="Jobs" asp-action="Index">Cơ hội nghề nghiệp</a>
        <span class="mx-1.5 text-muted">/</span>
        <span class="text-dark fw-medium">@job.Title</span>
    </nav>

    <!-- Success Message Alert if applied -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show p-3 mb-4 shadow-sm" style="border-radius: var(--radius-button); border-left: 5px solid var(--color-accent);" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                <div class="fw-semibold">@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show p-3 mb-4 shadow-sm" style="border-radius: var(--radius-button); border-left: 5px solid #DC2626;" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                <div class="fw-semibold">@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- ── THÔNG BÁO TRẠNG THÁI GỠ TIN / QUÁ HẠN (SCRUM-38) ── -->
    @if (job.IsClosed)
    {
        <div class="alert alert-warning alert-dismissible fade show p-3.5 mb-4 shadow-sm" style="border-radius: var(--radius-button); border-left: 5px solid #F59E0B;" role="alert">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2.5">
                    <i class="bi bi-eye-slash-fill fs-3 text-warning"></i>
                    <div>
                        <div class="fw-bold text-dark fs-6">Tin tuyển dụng này đã được gỡ thủ công khỏi cổng tuyển dụng</div>
                        <div class="small text-muted mt-0.5">
                            Lý do: <strong>@(string.IsNullOrWhiteSpace(job.UnpublishReason) ? "Đã đóng theo quyết định của nhà tuyển dụng" : job.UnpublishReason)</strong>
                            @if (job.ClosedAt.HasValue)
                            {
                                <span> • Thời gian gỡ: @job.ClosedAt.Value.ToString("HH:mm dd/MM/yyyy")</span>
                            }
                        </div>
                    </div>
                </div>
                @if (isRecruiterOrHr)
                {
                    <div class="d-flex gap-2">
                        <a href="/Jobs/quan-ly" class="btn btn-sm btn-outline-dark" style="border-radius: 6px;">
                            <i class="bi bi-sliders me-1"></i> Quản lý tin
                        </a>
                        <button type="button" class="btn btn-sm btn-success fw-semibold" data-bs-toggle="modal" data-bs-target="#detailRepublishModal" style="border-radius: 6px;">
                            <i class="bi bi-arrow-repeat me-1"></i> Đăng lại tin
                        </button>
                    </div>
                }
            </div>
        </div>
    }
    else if (job.IsExpired)
    {
        <div class="alert alert-danger alert-dismissible fade show p-3.5 mb-4 shadow-sm" style="border-radius: var(--radius-button); border-left: 5px solid #EF4444;" role="alert">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2.5">
                    <i class="bi bi-clock-history fs-3 text-danger"></i>
                    <div>
                        <div class="fw-bold text-dark fs-6">Tin tuyển dụng đã quá hạn tiếp nhận hồ sơ</div>
                        <div class="small text-muted mt-0.5">
                            Thời hạn nộp hồ sơ đã kết thúc vào ngày <strong>@job.Deadline.ToString("dd/MM/yyyy")</strong>. Tin đã được tự động ẩn khỏi cổng tuyển dụng.
                        </div>
                    </div>
                </div>
                @if (isRecruiterOrHr)
                {
                    <div class="d-flex gap-2">
                        <a href="/Jobs/quan-ly" class="btn btn-sm btn-outline-dark" style="border-radius: 6px;">
                            <i class="bi bi-sliders me-1"></i> Quản lý tin
                        </a>
                        <button type="button" class="btn btn-sm btn-success fw-semibold" data-bs-toggle="modal" data-bs-target="#detailRepublishModal" style="border-radius: 6px;">
                            <i class="bi bi-calendar-plus me-1"></i> Gia hạn & Đăng lại
                        </button>
                    </div>
                }
            </div>
        </div>
    }

    <!-- ── HEADER BANNER CARD ── -->
    <div class="job-header-card">
        <div class="row align-items-center gy-4">
            <div class="col-12 col-lg-8">
                <!-- Badges -->
                <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
                    @if (!string.IsNullOrWhiteSpace(job.Code))
                    {
                        <span class="badge font-monospace px-2.5 py-1 text-xs" style="background: #0F172A; color: #38BDF8; border-radius: var(--radius-badge); font-weight: 700; letter-spacing: 0.05em;" title="Mã định danh vị trí tuyển dụng chính thức">
                            <i class="bi bi-upc-scan me-1"></i> REF: @job.Code
                        </span>
                    }
                    <span class="badge px-2.5 py-1 text-xs" style="background: #EFF6FF; color: #1D4ED8; border-radius: var(--radius-badge); font-weight: 600;">
                        <i class="bi bi-building me-1"></i> @job.Department
                    </span>
                    @if (job.IsClosed)
                    {
                        <span class="badge px-2.5 py-1 text-xs" style="background: #FFFBEB; color: #92400E; border: 1px solid #FDE68A; border-radius: var(--radius-badge); font-weight: 700;">
                            <i class="bi bi-eye-slash-fill me-1"></i> ĐÃ GỠ THỦ CÔNG
                        </span>
                    }
                    else if (job.IsExpired)
                    {
                        <span class="badge px-2.5 py-1 text-xs" style="background: #FEF2F2; color: #991B1B; border: 1px solid #FECACA; border-radius: var(--radius-badge); font-weight: 700;">
                            <i class="bi bi-clock-history me-1"></i> ĐÃ QUÁ HẠN (ẨN)
                        </span>
                    }
                    else if (job.IsHot)
                    {
                        <span class="badge px-2.5 py-1 text-xs" style="background: #FEE2E2; color: #DC2626; border: 1px solid #FECACA; border-radius: var(--radius-badge); font-weight: 700;">
                            <i class="bi bi-fire me-0.5"></i> TUYỂN GẤP (HOT)
                        </span>
                    }
                    <span class="badge bg-light text-secondary border px-2.5 py-1 text-xs" style="border-radius: var(--radius-badge);">
                        <i class="bi bi-geo-alt me-1"></i> @job.WorkLocation
                    </span>
                    <span class="badge bg-light text-secondary border px-2.5 py-1 text-xs" style="border-radius: var(--radius-badge);">
                        <i class="bi bi-bar-chart-steps me-1"></i> @job.ExperienceLevel
                    </span>
                </div>

                <!-- Job Title -->
                <h1 class="job-h1 mb-3">@job.Title</h1>

                <!-- Short summary -->
                <p class="text-muted fs-6 mb-3" style="line-height: 1.65; max-width: 720px;">
                    @job.ShortSummary
                </p>

                <!-- Salary Display -->
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <div>
                        <span class="text-muted small d-block mb-1 font-monospace text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Mức thu nhập đãi ngộ:</span>
                        <span class="salary-badge-lg">@job.SalaryDisplay</span>
                    </div>
                    <div class="ms-md-3 ps-md-3 border-start">
                        <span class="text-muted small d-block mb-1" style="font-size: 0.75rem;">Hạn nộp hồ sơ:</span>
                        <span class="fw-semibold text-dark font-monospace" style="font-size: 0.95rem;">@job.Deadline.ToString("dd/MM/yyyy")</span>
                    </div>
                </div>
            </div>

            <!-- Header Actions -->
            <div class="col-12 col-lg-4 text-lg-end">
                <div class="d-flex flex-column gap-2 justify-content-lg-end align-items-lg-end">
                    @if (canEditJob)
                    {
                        <div class="d-flex gap-2 w-100 flex-wrap">
                            <a href="/kho-tiem-nang/goi-y/@job.Id" class="btn btn-outline-warning text-dark fw-bold w-100 shadow-sm d-flex align-items-center justify-content-center gap-1.5" style="border-radius: var(--radius-button); padding: 0.65rem 1rem;" title="Xem danh sách ứng viên phù hợp từ Kho tiềm năng (Scrum 45)">
                                <i class="bi bi-stars text-warning"></i> Gợi ý từ Kho tiềm năng
                            </a>
                            <button type="button" class="btn btn-warning text-dark fw-bold flex-grow-1 shadow-sm d-flex align-items-center justify-content-center gap-1.5" data-bs-toggle="modal" data-bs-target="#editJobPostingModal" style="border-radius: var(--radius-button); padding: 0.65rem 1rem;">
                                <i class="bi bi-pencil-square"></i> Chỉnh sửa
                            </button>
                            @if (!job.IsClosed && !job.IsExpired)
                            {
                                <button type="button" class="btn btn-outline-danger fw-semibold shadow-sm d-flex align-items-center justify-content-center gap-1.5" data-bs-toggle="modal" data-bs-target="#detailUnpublishModal" style="border-radius: var(--radius-button); padding: 0.65rem 1rem;" title="Gỡ tin này khỏi cổng ứng viên ngay lập tức">
                                    <i class="bi bi-eye-slash-fill"></i> Gỡ tin
                                </button>
                            }
                        </div>
                    }
                    @if (job.IsClosed || job.IsExpired)
                    {
                        @if (isRecruiterOrHr)
                        {
                            <button type="button" class="btn btn-success w-100 shadow-sm d-flex align-items-center justify-content-center gap-2 py-2.5" data-bs-toggle="modal" data-bs-target="#detailRepublishModal" style="border-radius: var(--radius-button); font-weight: 600;">
                                <i class="bi bi-arrow-repeat fs-5"></i> Đăng lại tin này
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-secondary w-100 py-2.5 d-flex align-items-center justify-content-center gap-2" disabled style="border-radius: var(--radius-button); font-weight: 600;">
                                <i class="bi bi-x-circle-fill"></i> Đã đóng nhận hồ sơ
                            </button>
                        }
                    }
                    else
                    {
                        <a href="#apply-section" class="btn-apply-main w-100 w-sm-auto">
                            <i class="bi bi-send-fill"></i> Ứng tuyển vị trí này
                        </a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a href="/gioi-thieu-ung-vien?jobId=@job.Id" class="btn btn-outline-success fw-semibold w-100 w-sm-auto d-inline-flex align-items-center justify-content-center gap-1.5" style="border-radius: var(--radius-button); padding: 0.7rem 1.25rem;">
                                <i class="bi bi-person-plus-fill"></i> Giới thiệu ứng viên
                            </a>
                        }
                    }
                    <div class="d-flex gap-2 w-100 justify-content-lg-end">
                        <button type="button" class="btn-save-job flex-grow-1 flex-lg-grow-0" onclick="navigator.clipboard.writeText(window.location.href); alert('Đã sao chép liên kết vị trí tuyển dụng vào bộ nhớ tạm!');">
                            <i class="bi bi-share"></i> Chia sẻ
                        </button>
                        <a asp-controller="Jobs" asp-action="Index" class="btn-save-job flex-grow-1 flex-lg-grow-0" title="Xem tất cả vị trí">
                            <i class="bi bi-grid"></i> Tất cả việc làm
                        </a>
                    </div>
                    @if (isRecruiterOrHr)
                    {
                        <a href="/Jobs/quan-ly" class="small text-muted text-decoration-none mt-1" style="font-size: 0.78rem;">
                            <i class="bi bi-sliders text-primary me-1"></i> Mở Bảng điều khiển Quản lý tin đăng
                        </a>
                    }
                    else
                    {
                        <span class="text-muted small" style="font-size: 0.75rem;">
                            <i class="bi bi-shield-check text-success me-1"></i> Cam kết phản hồi ứng viên trong 48h
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ── MAIN BODY & SIDEBAR ── -->
    <div class="row g-4">
        <!-- Left: Job Details (8 cols) -->
        <div class="col-12 col-lg-8">
            <!-- 1. Bối cảnh & Tổng quan -->
            <div class="detail-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="section-title mb-0 border-0 pb-0">
                        <i class="bi bi-info-circle text-primary"></i> Tổng quan về vị trí công việc
                    </h2>
                    @if (canEditJob)
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#editJobPostingModal" style="border-radius: 6px; font-size: 0.8rem;">
                            <i class="bi bi-pencil"></i> Chỉnh sửa
                        </button>
                    }
                </div>
                <div style="line-height: 1.75; color: #334155; font-size: 0.95rem; white-space: pre-line;">
                    @HtmlSanitizerHelper.SanitizeToHtmlString(job.Overview)
                </div>
                <div class="p-3 bg-light rounded-3 border mt-3" style="border-radius: var(--radius-button); font-size: 0.875rem;">
                    <strong class="text-dark"><i class="bi bi-lightbulb text-warning me-1"></i> Văn hóa Kỹ thuật tại NoveraTech:</strong>
                    <div class="text-muted mt-1" style="line-height: 1.6;">
                        Chúng tôi đề cao tính thực chất, trao quyền tự chủ kỹ thuật tối đa cho kỹ sư và đánh giá dựa trên giá trị giải pháp thay vì hình thức chấm công.
                    </div>
                </div>
            </div>

            <!-- 2. Mô tả chức năng & Vai trò (Position Function & Role Description) -->
            <div class="detail-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="section-title mb-0 border-0 pb-0">
                        <i class="bi bi-briefcase text-success"></i> Mô tả chức năng & Vai trò công việc
                    </h2>
                    @if (canEditJob)
                    {
                        <span class="badge bg-light text-secondary border font-monospace" style="font-size: 0.72rem; border-radius: 4px;">Recruiter / HR / Admin</span>
                    }
                </div>
                <div style="line-height: 1.75; color: #334155; font-size: 0.95rem; white-space: pre-line;">
                    @if (!string.IsNullOrWhiteSpace(job.PositionDescription))
                    {
                        @HtmlSanitizerHelper.SanitizeToHtmlString(job.PositionDescription)
                    }
                    else
                    {
                        @HtmlSanitizerHelper.SanitizeToHtmlString(job.Overview)
                    }
                </div>
                <div class="mt-3 p-3 rounded-3 border" style="background: #F8FAFC; border-color: #E2E8F0; border-radius: var(--radius-button); font-size: 0.85rem;">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="bi bi-diagram-3-fill text-primary"></i>
                        <span class="fw-bold text-dark">Khung định biên & Vị trí trong tổ chức:</span>
                    </div>
                    <div class="text-muted" style="line-height: 1.55;">
                        Chức danh <strong>@job.Title</strong> thuộc <strong>@job.Department</strong>, cấp bậc <strong>@job.ExperienceLevel</strong>, chế độ <strong>@job.EmploymentType</strong> tại <strong>@job.WorkLocation</strong>.
                    </div>
                </div>
            </div>

            <!-- 2. Trách nhiệm công việc -->
            <div class="detail-card">
                <h2 class="section-title">
                    <i class="bi bi-card-checklist text-success"></i> Trách nhiệm & Nhiệm vụ chính
                </h2>
                <ul class="jd-list">
                    @foreach (var res in job.Responsibilities)
                    {
                        <li>@res</li>
                    }
                </ul>
            </div>

            <!-- 3. Yêu cầu chuyên môn -->
            <div class="detail-card">
                <h2 class="section-title">
                    <i class="bi bi-person-check text-info"></i> Yêu cầu năng lực & Kinh nghiệm
                </h2>
                <ul class="jd-list">
                    @foreach (var req in job.Requirements)
                    {
                        <li>@req</li>
                    }
                </ul>
            </div>

            <!-- 4. Tech Stack -->
            <div class="detail-card">
                <h2 class="section-title">
                    <i class="bi bi-stack text-warning"></i> Công nghệ & Công cụ sử dụng
                </h2>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var t in job.TechStack)
                    {
                        <span class="tech-pill">
                            <i class="bi bi-code-slash text-success me-1"></i> @t
                        </span>
                    }
                </div>
            </div>

            <!-- 5. Quyền lợi đãi ngộ -->
            <div class="detail-card" style="border-color: #A7F3D0; background: #FAFFFD;">
                <h2 class="section-title" style="color: #065F46; border-color: #D1FAE5;">
                    <i class="bi bi-gift text-success"></i> Quyền lợi & Đãi ngộ đặc quyền tại NoveraTech
                </h2>
                <ul class="jd-list">
                    @foreach (var ben in job.Benefits)
                    {
                        <li>@ben</li>
                    }
                </ul>
            </div>

            <!-- 6. Quy trình 4 bước tuyển dụng -->
            <div class="detail-card">
                <h2 class="section-title">
                    <i class="bi bi-bezier2 text-primary"></i> Quy trình phỏng vấn tinh gọn (Cam kết 48h)
                </h2>
                <div class="row g-3">
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light rounded-3 text-center border h-100">
                            <div class="fw-bold font-monospace text-success mb-1" style="font-size: 1.1rem;">BƯỚC 1</div>
                            <div class="fw-semibold text-dark small mb-1">Nộp hồ sơ</div>
                            <div class="text-muted" style="font-size: 0.75rem;">Nộp CV trực tuyến trong 1 phút</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light rounded-3 text-center border h-100">
                            <div class="fw-bold font-monospace text-success mb-1" style="font-size: 1.1rem;">BƯỚC 2</div>
                            <div class="fw-semibold text-dark small mb-1">Sàng lọc CV</div>
                            <div class="text-muted" style="font-size: 0.75rem;">Phản hồi kết quả trong 48h</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light rounded-3 text-center border h-100">
                            <div class="fw-bold font-monospace text-success mb-1" style="font-size: 1.1rem;">BƯỚC 3</div>
                            <div class="fw-semibold text-dark small mb-1">Phỏng vấn Kỹ thuật</div>
                            <div class="text-muted" style="font-size: 0.75rem;">Trao đổi online cùng Tech Lead</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light rounded-3 text-center border h-100">
                            <div class="fw-bold font-monospace text-success mb-1" style="font-size: 1.1rem;">BƯỚC 4</div>
                            <div class="fw-semibold text-dark small mb-1">Offer & Onboard</div>
                            <div class="text-muted" style="font-size: 0.75rem;">Nhận MacBook Pro & Gia nhập</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 7. FORM ỨNG TUYỂN HOẶC THÔNG BÁO ĐÓNG NHẬN HỒ SƠ (SCRUM-38) -->
            @if (job.IsClosed || job.IsExpired)
            {
                <div id="apply-section" class="detail-card text-center py-5 shadow-sm" style="border: 2px dashed #CBD5E1; background: #F8FAFC; border-radius: var(--radius-card); scroll-margin-top: 2rem;">
                    <div class="mb-3">
                        @if (job.IsClosed)
                        {
                            <div class="d-inline-flex p-3 bg-warning-subtle text-warning-emphasis rounded-circle mb-2">
                                <i class="bi bi-eye-slash-fill fs-1"></i>
                            </div>
                            <h3 class="h4 fw-bold text-dark mb-2">Vị trí này hiện đã đóng nhận hồ sơ ứng tuyển</h3>
                            <p class="text-muted mb-3 mx-auto px-3" style="max-width: 580px; line-height: 1.6;">
                                Tin tuyển dụng này đã được gỡ bởi Nhà tuyển dụng 
                                @if (!string.IsNullOrWhiteSpace(job.UnpublishReason))
                                {
                                    <span>(Lý do: <em>@job.UnpublishReason</em>)</span>
                                }
                                . Rất tiếc hiện tại hệ thống tạm thời không tiếp nhận thêm hồ sơ mới cho vị trí này.
                            </p>
                        }
                        else
                        {
                            <div class="d-inline-flex p-3 bg-danger-subtle text-danger rounded-circle mb-2">
                                <i class="bi bi-clock-history fs-1"></i>
                            </div>
                            <h3 class="h4 fw-bold text-dark mb-2">Vị trí tuyển dụng này đã quá hạn nộp hồ sơ</h3>
                            <p class="text-muted mb-3 mx-auto px-3" style="max-width: 580px; line-height: 1.6;">
                                Thời hạn tiếp nhận hồ sơ đã kết thúc vào ngày <strong>@job.Deadline.ToString("dd/MM/yyyy")</strong>. Đội ngũ tuyển dụng đang tiến hành sàng lọc các hồ sơ đã gửi trước đó.
                            </p>
                        }
                    </div>
                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                        <a asp-controller="Jobs" asp-action="Index" class="btn btn-primary px-4 py-2" style="border-radius: var(--radius-button); font-weight: 600;">
                            <i class="bi bi-grid-fill me-1"></i> Khám phá các vị trí khác
                        </a>
                        @if (isRecruiterOrHr)
                        {
                            <button type="button" class="btn btn-success px-4 py-2" data-bs-toggle="modal" data-bs-target="#detailRepublishModal" style="border-radius: var(--radius-button); font-weight: 600;">
                                <i class="bi bi-arrow-repeat me-1"></i> Đăng lại vị trí này
                            </button>
                        }
                    </div>
                </div>
            }
            else
            {
                <div id="apply-section" class="detail-card" style="border: 2px solid var(--color-accent); scroll-margin-top: 2rem;">
                    <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                        <div>
                            <h2 class="fw-bold mb-1" style="font-size: 1.25rem; color: var(--color-text-main);">
                                <i class="bi bi-send text-success me-1.5"></i> Nộp hồ sơ ứng tuyển vị trí này
                            </h2>
                            <span class="text-muted small">Điền thông tin và tải lên CV của bạn (PDF / DOCX). Chúng tôi sẽ liên hệ trong 48 giờ.</span>
                        </div>
                        <span class="badge bg-success-subtle text-success px-2.5 py-1" style="border-radius: 6px; font-weight: 600;">
                            Nhanh & Bảo mật
                        </span>
                    </div>

                    <form method="post" asp-controller="Jobs" asp-action="QuickApply" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="jobId" value="@job.Id" />

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-semibold text-dark">Họ và tên của bạn <span class="text-danger">*</span></label>
                                <input type="text" name="candidateName" class="form-control" style="border-radius: var(--radius-button); padding: 0.65rem 0.85rem;" placeholder="Ví dụ: Nguyễn Văn An" required />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-semibold text-dark">Email liên hệ <span class="text-danger">*</span></label>
                                <input type="email" name="candidateEmail" class="form-control" style="border-radius: var(--radius-button); padding: 0.65rem 0.85rem;" placeholder="an.nguyen@example.com" required />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-semibold text-dark">Số điện thoại di động <span class="text-danger">*</span></label>
                                <input type="tel" name="candidatePhone" class="form-control" style="border-radius: var(--radius-button); padding: 0.65rem 0.85rem;" placeholder="0912 345 678" required />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-semibold text-dark">Tải lên hồ sơ CV (PDF/DOCX) <span class="text-danger">*</span></label>
                                <input type="file" name="cvFile" class="form-control" style="border-radius: var(--radius-button); padding: 0.55rem 0.85rem;" accept=".pdf,.docx,.doc" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold text-dark">Lời giới thiệu ngắn hoặc link GitHub / LinkedIn (Tùy chọn)</label>
                                <textarea name="coverLetter" rows="3" class="form-control" style="border-radius: var(--radius-button);" placeholder="Chia sẻ thêm về các dự án tiêu biểu hoặc kinh nghiệm thực chiến của bạn..."></textarea>
                            </div>
                            <div class="col-12">
                                <div class="form-check p-2 bg-light rounded border" style="border-color: #E2E8F0 !important;">
                                    <input class="form-check-input ms-1 me-2" type="checkbox" name="agreeToPrivacyConsent" value="true" id="privacyConsentCheck" required />
                                    <label class="form-check-label small text-muted" for="privacyConsentCheck" style="font-size: 0.8rem; line-height: 1.5;">
                                        Tôi xác nhận đã đọc và đồng ý cho phép NoveraTech thu thập, lưu trữ và xử lý dữ liệu cá nhân phục vụ quy trình tuyển dụng theo quy định của <strong>Nghị định 13/2023/NĐ-CP</strong> và Chính sách bảo mật dữ liệu. <span class="text-danger">*</span>
                                    </label>
                                </div>
                            </div>
                            <div class="col-12 pt-2">
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                    <span class="text-muted" style="font-size: 0.78rem;">
                                        <i class="bi bi-shield-lock text-success me-1"></i> Thông tin của bạn được cam kết bảo mật theo chính sách quyền riêng tư NoveraTech.
                                    </span>
                                    <button type="submit" class="btn-apply-main">
                                        <i class="bi bi-check-circle-fill"></i> Hoàn tất nộp hồ sơ
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            }
        </div>

        <!-- Right: Sidebar (4 cols) -->
        <div class="col-12 col-lg-4">
            <!-- Widget 1: Tóm tắt thông tin công việc -->
            <div class="sidebar-widget">
                <h5 class="fw-bold mb-3 pb-2 border-bottom" style="font-size: 1rem; color: var(--color-text-main);">
                    <i class="bi bi-briefcase text-success me-1.5"></i> Thông tin tuyển dụng
                </h5>
                @if (!string.IsNullOrWhiteSpace(job.Code))
                {
                    <div class="info-row">
                        <i class="bi bi-upc-scan text-primary"></i>
                        <div>
                            <div class="text-muted small">Mã định danh tuyển dụng:</div>
                            <div class="fw-bold font-monospace text-primary">@job.Code</div>
                        </div>
                    </div>
                }
                <div class="info-row">
                    <i class="bi bi-currency-dollar"></i>
                    <div>
                        <div class="text-muted small">Mức thu nhập:</div>
                        <div class="fw-bold font-monospace text-success">@job.SalaryDisplay</div>
                    </div>
                </div>
                <div class="info-row">
                    <i class="bi bi-building"></i>
                    <div>
                        <div class="text-muted small">Khối / Phòng ban:</div>
                        <div class="fw-semibold text-dark">@job.Department</div>
                    </div>
                </div>
                <div class="info-row">
                    <i class="bi bi-geo-alt"></i>
                    <div>
                        <div class="text-muted small">Địa điểm làm việc:</div>
                        <div class="fw-semibold text-dark">@job.WorkLocation</div>
                        <div class="text-muted" style="font-size: 0.75rem;">@job.WorkAddress</div>
                    </div>
                </div>
                <div class="info-row">
                    <i class="bi bi-clock-history"></i>
                    <div>
                        <div class="text-muted small">Hình thức làm việc:</div>
                        <div class="fw-semibold text-dark">@job.EmploymentType</div>
                    </div>
                </div>
                <div class="info-row">
                    <i class="bi bi-bar-chart-steps"></i>
                    <div>
                        <div class="text-muted small">Cấp bậc yêu cầu:</div>
                        <div class="fw-semibold text-dark">@job.ExperienceLevel</div>
                    </div>
                </div>
                <div class="info-row">
                    <i class="bi bi-calendar-event"></i>
                    <div>
                        <div class="text-muted small">Hạn nộp hồ sơ:</div>
                        <div class="fw-semibold text-danger font-monospace">@job.Deadline.ToString("dd/MM/yyyy")</div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <a href="#apply-section" class="btn-apply-main w-100">
                        <i class="bi bi-send-fill"></i> Nộp đơn ngay
                    </a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a href="/gioi-thieu-ung-vien?jobId=@job.Id" class="btn btn-outline-success w-100 mt-2 fw-semibold d-inline-flex align-items-center justify-content-center gap-1.5" style="border-radius: var(--radius-button); padding: 0.65rem 1rem; font-size: 0.9rem;">
                            <i class="bi bi-person-plus-fill"></i> Giới thiệu ứng viên
                        </a>
                    }
                </div>
            </div>

            <!-- Widget 2: Môi trường NoveraTech -->
            <div class="sidebar-widget" style="background: #FFFFFF;">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <img src="~/img/logo-icon-dark-transparent.png" alt="NoveraTech" style="width: 28px; height: 28px;" asp-append-version="true" />
                    <div>
                        <div class="fw-bold small text-dark">Đặc quyền Kỹ sư NoveraTech</div>
                        <div class="text-muted" style="font-size: 0.72rem;">Engineering-First Organization</div>
                    </div>
                </div>

                <div class="d-flex flex-column gap-2 mb-3">
                    <div class="p-2.5 bg-light rounded-3 border" style="border-radius: 8px;">
                        <div class="fw-semibold text-dark small"><i class="bi bi-laptop text-primary me-1"></i> Cấp MacBook Pro M3/M4 Max</div>
                        <div class="text-muted" style="font-size: 0.75rem;">Trang bị 100% kèm 2 màn hình 4K công thái học.</div>
                    </div>
                    <div class="p-2.5 bg-light rounded-3 border" style="border-radius: 8px;">
                        <div class="fw-semibold text-dark small"><i class="bi bi-heart-pulse text-danger me-1"></i> Bảo hiểm NoveraCare VIP</div>
                        <div class="text-muted" style="font-size: 0.75rem;">Bảo lãnh viện quốc tế nội & ngoại trú cho bạn + gia đình.</div>
                    </div>
                    <div class="p-2.5 bg-light rounded-3 border" style="border-radius: 8px;">
                        <div class="fw-semibold text-dark small"><i class="bi bi-mortarboard text-success me-1"></i> Tài trợ chứng chỉ 25tr/năm</div>
                        <div class="text-muted" style="font-size: 0.75rem;">Tài trợ học và thi chứng chỉ AWS, Azure, CMMI, TOGAF.</div>
                    </div>
                </div>

                <div class="text-center pt-2">
                    <div class="text-muted small" style="font-size: 0.78rem;">Cần hỗ trợ về vị trí này? Liên hệ HR:</div>
                    <div class="font-monospace fw-bold text-dark small mt-0.5">careers@@noveratech.digital</div>
                </div>
            </div>

            <!-- Widget 3: Vị trí tuyển dụng liên quan -->
            @if (Model.RelatedJobs.Any())
            {
                <div class="sidebar-widget">
                    <h5 class="fw-bold mb-3 pb-2 border-bottom" style="font-size: 1rem; color: var(--color-text-main);">
                        <i class="bi bi-layers text-primary me-1.5"></i> Vị trí tương tự đang mở
                    </h5>
                    <div class="d-flex flex-column gap-3">
                        @foreach (var rel in Model.RelatedJobs)
                        {
                            <div class="p-2.5 rounded-3 border" style="background: #F8FAFC; border-color: var(--color-border) !important; border-radius: 8px;">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <span class="badge bg-white text-secondary border px-1.5 py-0.5" style="font-size: 0.68rem; border-radius: 4px;">
                                        @rel.Department
                                    </span>
                                    <span class="fw-bold font-monospace text-success" style="font-size: 0.8rem;">@rel.SalaryDisplay</span>
                                </div>
                                <a asp-controller="Jobs" asp-action="Detail" asp-route-id="@rel.Slug" class="fw-bold text-dark text-decoration-none small d-block mb-1 hover-green" style="line-height: 1.35;">
                                    @rel.Title
                                </a>
                                <div class="text-muted" style="font-size: 0.72rem;">
                                    <i class="bi bi-geo-alt me-0.5"></i> @rel.WorkLocation
                                </div>
                            </div>
                        }
                    </div>
                    <div class="mt-3 text-center">
                        <a asp-controller="Jobs" asp-action="Index" class="btn btn-sm btn-link text-success fw-semibold text-decoration-none" style="font-size: 0.85rem;">
                            Xem toàn bộ vị trí khác &rarr;
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@if (canEditJob)
{
    <!-- Modal Chỉnh sửa bài đăng trực tiếp (Dành cho Recruiter, HRManager, Admin) -->
    <div class="modal fade" id="editJobPostingModal" tabindex="-1" aria-labelledby="editJobPostingModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 14px;">
                <div class="modal-header border-bottom pb-3" style="background: #F8FAFC;">
                    <div class="d-flex align-items-center gap-2">
                        <div class="d-flex align-items-center justify-content-center rounded-3 bg-warning text-dark" style="width: 38px; height: 38px;">
                            <i class="bi bi-pencil-square fs-5"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold text-dark mb-0" id="editJobPostingModalLabel">
                                Chỉnh sửa trực tiếp tin tuyển dụng
                            </h5>
                            <span class="text-muted" style="font-size: 0.78rem;">Phân quyền: Recruiter / Trưởng phòng Nhân sự / Admin hệ thống</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <form id="editJobPostingForm" onsubmit="handleUpdateJobPosting(event)">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="JobId" value="@(string.IsNullOrEmpty(job.Id) ? job.Slug : job.Id)" />

                        <div class="row g-3">
                            <div class="col-12 col-md-8">
                                <label class="form-label small fw-bold text-dark">Tiêu đề vị trí công việc <span class="text-danger">*</span></label>
                                <input type="text" name="Title" class="form-control" value="@job.Title" required style="border-radius: 8px;" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-bold text-dark">Phòng ban / Đơn vị <span class="text-danger">*</span></label>
                                <input type="text" name="Department" class="form-control" value="@job.Department" required style="border-radius: 8px;" />
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-bold text-dark">Cấp bậc / Trình độ</label>
                                <input type="text" name="ExperienceLevel" class="form-control" value="@job.ExperienceLevel" placeholder="VD: Senior, Middle, Lead" style="border-radius: 8px;" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-bold text-dark">Mức thu nhập đãi ngộ (Lương)</label>
                                <input type="text" name="SalaryDisplay" class="form-control" value="@job.SalaryDisplay" placeholder="VD: 35 – 50 Triệu VNĐ" style="border-radius: 8px;" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-bold text-dark">Hạn nộp hồ sơ</label>
                                <input type="date" name="Deadline" class="form-control" value="@job.Deadline.ToString("yyyy-MM-dd")" required style="border-radius: 8px;" />
                            </div>

                            <div class="col-12">
                                <label class="form-label small fw-bold text-dark">Địa điểm làm việc & Chế độ</label>
                                <input type="text" name="WorkLocation" list="locationOptionsList" class="form-control" value="@job.WorkLocation" placeholder="Chọn hoặc nhập địa điểm làm việc..." style="border-radius: 8px;" />
                                <datalist id="locationOptionsList">
                                    @if (ViewBag.Locations != null)
                                    {
                                        foreach (var loc in (List<SelectListItem>)ViewBag.Locations)
                                        {
                                            <option value="@loc.Value">@loc.Text</option>
                                        }
                                    }
                                </datalist>
                                <div class="form-text text-muted small">Gợi ý tự động từ Danh mục địa điểm dùng chung.</div>
                            </div>

                            <!-- 1. Tổng quan vị trí -->
                            <div class="col-12">
                                <label class="form-label small fw-bold text-dark">1. Tổng quan vị trí công việc</label>
                                <textarea name="Overview" class="form-control" rows="3" style="border-radius: 8px;" placeholder="Bối cảnh dự án, sứ mệnh của vị trí...">@job.Overview</textarea>
                            </div>

                            <!-- 2. Mô tả chức năng & Vai trò -->
                            <div class="col-12">
                                <label class="form-label small fw-bold text-dark">2. Mô tả chức năng & Vai trò nhiệm vụ</label>
                                <textarea name="PositionDescription" class="form-control" rows="3" style="border-radius: 8px;" placeholder="Mô tả chức năng nhiệm vụ của vị trí trong cơ cấu doanh nghiệp...">@job.PositionDescription</textarea>
                            </div>

                            <!-- 3. Trách nhiệm chính -->
                            <div class="col-12">
                                <label class="form-label small fw-bold text-dark">3. Trách nhiệm & Nhiệm vụ chính (Mỗi ý một dòng)</label>
                                <textarea name="Responsibilities" class="form-control font-monospace" rows="4" style="border-radius: 8px; font-size: 0.88rem;">@string.Join("\n", job.Responsibilities)</textarea>
                            </div>

                            <!-- 4. Yêu cầu chuyên môn -->
                            <div class="col-12">
                                <label class="form-label small fw-bold text-dark">4. Yêu cầu năng lực & Kinh nghiệm (Mỗi ý một dòng)</label>
                                <textarea name="Requirements" class="form-control font-monospace" rows="4" style="border-radius: 8px; font-size: 0.88rem;">@string.Join("\n", job.Requirements)</textarea>
                            </div>

                            <!-- 5. Tech Stack -->
                            <div class="col-12">
                                <label class="form-label small fw-bold text-dark">5. Công nghệ & Công cụ (Cách nhau bằng dấu phẩy)</label>
                                <input type="text" name="TechStack" class="form-control font-monospace" value="@string.Join(", ", job.TechStack)" placeholder=".NET 9, C#, React 19, TypeScript, PostgreSQL" style="border-radius: 8px; font-size: 0.88rem;" />
                            </div>

                            <!-- 6. Quyền lợi đãi ngộ -->
                            <div class="col-12">
                                <label class="form-label small fw-bold text-dark">6. Quyền lợi & Đãi ngộ (Mỗi ý một dòng)</label>
                                <textarea name="Benefits" class="form-control font-monospace" rows="4" style="border-radius: 8px; font-size: 0.88rem;">@string.Join("\n", job.Benefits)</textarea>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <button type="button" class="btn btn-light px-4" style="border-radius: 8px;" data-bs-dismiss="modal">Hủy bỏ</button>
                            <button type="submit" class="btn btn-success px-4 fw-bold text-white d-inline-flex align-items-center gap-2" id="btnSubmitEditJob" style="border-radius: 8px;">
                                <span class="spinner-border spinner-border-sm d-none" id="spinnerEditJob"></span>
                                <i class="bi bi-floppy"></i> Lưu thay đổi trực tiếp
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@if (isRecruiterOrHr)
{
    <!-- Modal Gỡ tin thủ công trực tiếp từ trang chi tiết (Scrum-38 Yêu cầu 1) -->
    <div class="modal fade" id="detailUnpublishModal" tabindex="-1" aria-labelledby="detailUnpublishModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
                <div class="modal-header bg-danger-subtle border-0 py-3">
                    <h5 class="modal-title text-danger fw-bold d-flex align-items-center gap-2" id="detailUnpublishModalLabel">
                        <i class="bi bi-exclamation-triangle-fill"></i> Xác nhận Gỡ Tin Tuyển Dụng
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="Jobs" asp-action="Unpublish" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="JobId" value="@(string.IsNullOrWhiteSpace(job.Id) ? job.Slug : job.Id)" />

                    <div class="modal-body p-4">
                        <div class="alert alert-warning mb-3 py-2.5 px-3" style="border-radius: 8px; font-size: 0.875rem;">
                            <i class="bi bi-info-circle-fill me-1"></i>
                            Tin tuyển dụng sẽ <strong>ngay lập tức ẩn khỏi trang việc làm công khai</strong>. Ứng viên sẽ không thể gửi thêm hồ sơ ứng tuyển.
                        </div>

                        <p class="mb-3">
                            Bạn đang thao tác gỡ tin: <strong class="text-dark">@job.Title</strong> 
                            <span class="font-monospace text-muted">(@job.Code)</span>
                        </p>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-dark">Lý do gỡ tin tuyển dụng <span class="text-danger">*</span></label>
                            <select class="form-select mb-2" id="detailSelectUnpublishReason" style="border-radius: 8px;" onchange="if(this.value!=='other'){document.getElementById('detailUnpublishReasonText').value=this.value;}else{document.getElementById('detailUnpublishReasonText').value='';document.getElementById('detailUnpublishReasonText').focus();}">
                                <option value="Đã tuyển dụng đủ chỉ tiêu nhân sự">Đã tuyển dụng đủ chỉ tiêu nhân sự</option>
                                <option value="Tạm dừng kế hoạch tuyển dụng vị trí này">Tạm dừng kế hoạch tuyển dụng vị trí này</option>
                                <option value="Thay đổi yêu cầu / Cơ cấu lại chức danh">Thay đổi yêu cầu / Cơ cấu lại chức danh</option>
                                <option value="other">Lý do khác (Nhập chi tiết bên dưới)...</option>
                            </select>
                            <textarea class="form-control" name="Reason" id="detailUnpublishReasonText" rows="2" placeholder="Ghi chú thêm lý do gỡ tin..." style="border-radius: 8px;">Đã tuyển dụng đủ chỉ tiêu nhân sự</textarea>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-0 py-3 px-4 d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal" style="border-radius: 8px;">Huỷ bỏ</button>
                        <button type="submit" class="btn btn-danger px-4 fw-semibold" style="border-radius: 8px;">
                            <i class="bi bi-trash3-fill me-1"></i> Xác nhận gỡ tin ngay
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Đăng lại / Gia hạn tin từ trang chi tiết (Scrum-38) -->
    <div class="modal fade" id="detailRepublishModal" tabindex="-1" aria-labelledby="detailRepublishModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
                <div class="modal-header bg-success-subtle border-0 py-3">
                    <h5 class="modal-title text-success fw-bold d-flex align-items-center gap-2" id="detailRepublishModalLabel">
                        <i class="bi bi-arrow-repeat"></i> Đăng Lại & Gia Hạn Tin Tuyển Dụng
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="Jobs" asp-action="Republish" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="JobId" value="@(string.IsNullOrWhiteSpace(job.Id) ? job.Slug : job.Id)" />

                    <div class="modal-body p-4">
                        <p class="mb-3">
                            Bạn đang mở lại tin tuyển dụng: <strong class="text-dark">@job.Title</strong>
                            <span class="font-monospace text-muted">(@job.Code)</span>
                        </p>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-dark">Hạn nộp hồ sơ mới (Deadline) <span class="text-danger">*</span></label>
                            <input type="date" name="NewDeadline" class="form-control" value="@DateTime.UtcNow.AddDays(30).ToString("yyyy-MM-dd")" style="border-radius: 8px;" required />
                            <div class="form-text small text-muted">Tin sẽ lập tức xuất hiện trở lại trên cổng ứng viên và hết hạn vào ngày đã chọn.</div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-0 py-3 px-4 d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal" style="border-radius: 8px;">Huỷ</button>
                        <button type="submit" class="btn btn-success px-4 fw-semibold" style="border-radius: 8px;">
                            <i class="bi bi-check-lg me-1"></i> Đăng lại tin
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        async function handleUpdateJobPosting(e) {
            e.preventDefault();
            var form = document.getElementById('editJobPostingForm');
            var btn = document.getElementById('btnSubmitEditJob');
            var spinner = document.getElementById('spinnerEditJob');

            btn.disabled = true;
            spinner.classList.remove('d-none');

            var formData = new FormData(form);
            var jobId = form.querySelector('[name="JobId"]')?.value || '';
            var payload = {
                title: form.querySelector('[name="Title"]')?.value || '',
                department: form.querySelector('[name="Department"]')?.value || '',
                experienceLevel: form.querySelector('[name="ExperienceLevel"]')?.value || '',
                salaryDisplay: form.querySelector('[name="SalaryDisplay"]')?.value || '',
                deadline: form.querySelector('[name="Deadline"]')?.value || null,
                workLocation: form.querySelector('[name="WorkLocation"]')?.value || '',
                overview: form.querySelector('[name="Overview"]')?.value || '',
                positionDescription: form.querySelector('[name="PositionDescription"]')?.value || '',
                responsibilities: form.querySelector('[name="Responsibilities"]')?.value || '',
                requirements: form.querySelector('[name="Requirements"]')?.value || '',
                techStack: form.querySelector('[name="TechStack"]')?.value || '',
                benefits: form.querySelector('[name="Benefits"]')?.value || ''
            };

            try {
                // Ưu tiên gọi API chuẩn RESTful PATCH /api/jobs/{id}
                var res = await fetch('/api/jobs/' + encodeURIComponent(jobId), {
                    method: 'PATCH',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                // Fallback nếu cần
                if (res.status === 404 || res.status === 405) {
                    res = await fetch('/Jobs/UpdatePosting', {
                        method: 'POST',
                        body: formData
                    });
                }

                var data = await res.json();
                if (data.success) {
                    alert(data.message || 'Cập nhật bài đăng thành công!');
                    var modalEl = document.getElementById('editJobPostingModal');
                    if (modalEl) {
                        var m = bootstrap.Modal.getInstance(modalEl);
                        if (m) m.hide();
                    }
                    if (data.slug) {
                        window.location.href = '/Jobs/Detail/' + data.slug;
                    } else {
                        window.location.reload();
                    }
                } else {
                    alert(data.message || 'Lỗi khi cập nhật bài đăng.');
                }
            } catch (err) {
                alert('Lỗi kết nối máy chủ: ' + err.message);
            } finally {
                btn.disabled = false;
                spinner.classList.add('d-none');
            }
        }
    </script>
    <script src="/js/cv-autofill.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (window.CvAutoFill) {
                window.CvAutoFill.init({
                    fileInput: 'input[name="cvFile"]',
                    nameInput: 'input[name="candidateName"]',
                    emailInput: 'input[name="candidateEmail"]',
                    phoneInput: 'input[name="candidatePhone"]'
                });
            }
        });
    </script>
}

