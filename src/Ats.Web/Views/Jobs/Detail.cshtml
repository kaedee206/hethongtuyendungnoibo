                    </div>
                </div>
                <div class="info-row">
                    <i class="bi bi-geo-alt"></i>
                    <div>
                        <div class="text-muted small">Địa điểm làm việc:</div>
                        <div class="fw-semibold text-dark">@job.WorkLocation</div>
                        <div class="text-muted" style="font-size: 0.75rem;">@job.WorkAddress</div>
                    </div>
                </div>
                <div class="info-row">
                    <i class="bi bi-clock-history"></i>
                    <div>
                        <div class="text-muted small">Hình thức làm việc:</div>
                        <div class="fw-semibold text-dark">@job.EmploymentType</div>
                    </div>
                </div>
                <div class="info-row">
                    <i class="bi bi-bar-chart-steps"></i>
                    <div>
                        <div class="text-muted small">Cấp bậc yêu cầu:</div>
                        <div class="fw-semibold text-dark">@job.ExperienceLevel</div>
                    </div>
                </div>
                <div class="info-row">
                    <i class="bi bi-calendar-event"></i>
                    <div>
                        <div class="text-muted small">Hạn nộp hồ sơ:</div>
                        <div class="fw-semibold text-danger font-monospace">@job.Deadline.ToString("dd/MM/yyyy")</div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <a href="#apply-section" class="btn-apply-main w-100">
                        <i class="bi bi-send-fill"></i> Nộp đơn ngay
                    </a>
                </div>
            </div>

            <!-- Widget 2: Môi trường NoveraTech -->
            <div class="sidebar-widget" style="background: #FFFFFF;">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <img src="~/img/logo-icon-dark-transparent.png" alt="NoveraTech" style="width: 28px; height: 28px;" asp-append-version="true" />
                    <div>
                        <div class="fw-bold small text-dark">Đặc quyền Kỹ sư NoveraTech</div>
                        <div class="text-muted" style="font-size: 0.72rem;">Engineering-First Organization</div>
                    </div>
                </div>

                <div class="d-flex flex-column gap-2 mb-3">
                    <div class="p-2.5 bg-light rounded-3 border" style="border-radius: 8px;">
                        <div class="fw-semibold text-dark small"><i class="bi bi-laptop text-primary me-1"></i> Cấp MacBook Pro M3/M4 Max</div>
                        <div class="text-muted" style="font-size: 0.75rem;">Trang bị 100% kèm 2 màn hình 4K công thái học.</div>
                    </div>
                    <div class="p-2.5 bg-light rounded-3 border" style="border-radius: 8px;">
                        <div class="fw-semibold text-dark small"><i class="bi bi-heart-pulse text-danger me-1"></i> Bảo hiểm NoveraCare VIP</div>
                        <div class="text-muted" style="font-size: 0.75rem;">Bảo lãnh viện quốc tế nội & ngoại trú cho bạn + gia đình.</div>
                    </div>
                    <div class="p-2.5 bg-light rounded-3 border" style="border-radius: 8px;">
                        <div class="fw-semibold text-dark small"><i class="bi bi-mortarboard text-success me-1"></i> Tài trợ chứng chỉ 25tr/năm</div>
                        <div class="text-muted" style="font-size: 0.75rem;">Tài trợ học và thi chứng chỉ AWS, Azure, CMMI, TOGAF.</div>
                    </div>
                </div>

                <div class="text-center pt-2">
                    <div class="text-muted small" style="font-size: 0.78rem;">Cần hỗ trợ về vị trí này? Liên hệ HR:</div>
                    <div class="font-monospace fw-bold text-dark small mt-0.5">careers@@noveratech.digital</div>
                </div>
            </div>

            <!-- Widget 3: Vị trí tuyển dụng liên quan -->
            @if (Model.RelatedJobs.Any())
            {
                <div class="sidebar-widget">
                    <h5 class="fw-bold mb-3 pb-2 border-bottom" style="font-size: 1rem; color: var(--color-text-main);">
                        <i class="bi bi-layers text-primary me-1.5"></i> Vị trí tương tự đang mở
                    </h5>
                    <div class="d-flex flex-column gap-3">
                        @foreach (var rel in Model.RelatedJobs)
                        {
                            <div class="p-2.5 rounded-3 border" style="background: #F8FAFC; border-color: var(--color-border) !important; border-radius: 8px;">
                                <div class="d-flex justify-content-between align-items-start mb-1">
