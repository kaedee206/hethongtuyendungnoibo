@using Ats.Web.Constants
@model Ats.Web.Models.ViewModels.Jobs.JobDetailViewModel
@{
    ViewData["Title"] = $"{Model.Job.Title} — Tuyển Dụng NoveraTech";
    ViewData["BodyClass"] = "job-detail-page";
    var job = Model.Job;
    var canEditJob = User.Identity?.IsAuthenticated == true && (User.IsInRole(UserRoles.Recruiter) || User.IsInRole(UserRoles.HRManager) || User.IsInRole(UserRoles.Admin));
}

@* ══════════════════════════════════════════════════════════
   NOVERATECH CAREERS — TRANG CHI TIẾT CÔNG VIỆC (JOB DETAIL)
   Định vị: Cổng Tuyển Dụng Nhân Tài NoveraTech (RULE.md Compliant)
   ══════════════════════════════════════════════════════════ *@

<style>
    :root {
        --color-canvas: #F8FAFC;
        --color-card: #FFFFFF;
        --color-border: #E2E8F0;
        --color-text-main: #0F172A;
        --color-text-muted: #64748B;
        --color-accent: #059669;
        --color-accent-hover: #047857;
        --color-accent-subtle: #ECFDF5;
        --radius-button: 8px;
        --radius-card: 12px;
        --radius-badge: 6px;
    }

    body {
        background-color: var(--color-canvas);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        color: var(--color-text-main);
    }

    /* Breadcrumbs */
    .job-breadcrumb {
        font-size: 0.85rem;
        color: var(--color-text-muted);
        margin-bottom: 1.25rem;
    }
    .job-breadcrumb a {
        color: var(--color-text-muted);
        text-decoration: none;
    }
    .job-breadcrumb a:hover {
        color: var(--color-accent);
    }

    /* Header Banner Box */
    .job-header-card {
        background: #FFFFFF;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-card);
        padding: 2.25rem;
        box-shadow: 0 2px 12px rgba(15, 23, 42, 0.04);
        margin-bottom: 2rem;
    }

    .job-h1 {
        font-size: clamp(1.8rem, 3.2vw, 2.35rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        color: var(--color-text-main);
        line-height: 1.25;
    }

    .salary-badge-lg {
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--color-accent);
        background: var(--color-accent-subtle);
        border: 1px solid #A7F3D0;
        border-radius: var(--radius-button);
        padding: 0.4rem 1rem;
        display: inline-block;
    }

    /* Content Card */
    .detail-card {
        background: #FFFFFF;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-card);
        padding: 2rem;
        margin-bottom: 1.75rem;
    }

    .section-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--color-text-main);
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 1.25rem;
        padding-bottom: 0.75rem;
        border-bottom: 1.5px solid #F1F5F9;
    }

    /* Check list */
    .jd-list {
        list-style: none;
        padding-left: 0;
        margin-bottom: 0;
    }
    .jd-list li {
        position: relative;
        padding-left: 1.75rem;
        margin-bottom: 0.85rem;
        line-height: 1.65;
        color: #334155;
        font-size: 0.95rem;
    }
    .jd-list li::before {
        content: '\F26E';
        font-family: 'bootstrap-icons';
        position: absolute;
        left: 0;
        top: 0.1rem;
        color: var(--color-accent);
        font-size: 1rem;
        font-weight: 700;
    }

    /* Sidebar info box */
    .sidebar-widget {
        background: #FFFFFF;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-card);
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .info-row {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 0.65rem 0;
        border-bottom: 1px dashed #E2E8F0;
        font-size: 0.875rem;
    }
    .info-row:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }
    .info-row i {
        color: var(--color-accent);
        font-size: 1.1rem;
        margin-top: 0.1rem;
    }

    /* Buttons */
    .btn-apply-main {
        background: var(--color-accent);
        color: #FFFFFF;
        border: none;
        border-radius: var(--radius-button);
        padding: 0.75rem 1.75rem;
        font-weight: 600;
        font-size: 1rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        text-decoration: none;
        transition: all .2s ease;
        box-shadow: 0 2px 6px rgba(5, 150, 105, 0.2);
    }
    .btn-apply-main:hover {
        background: var(--color-accent-hover);
        color: #FFFFFF;
        box-shadow: 0 4px 14px rgba(5, 150, 105, 0.3);
    }

    .btn-save-job {
        background: #FFFFFF;
        color: var(--color-text-main);
        border: 1.5px solid var(--color-border);
        border-radius: var(--radius-button);
        padding: 0.75rem 1.25rem;
        font-weight: 600;
        font-size: 0.95rem;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        text-decoration: none;
        transition: all .2s ease;
    }
    .btn-save-job:hover {
        border-color: var(--color-accent);
        color: var(--color-accent);
        background: var(--color-accent-subtle);
    }

    /* Tags */
    .tech-pill {
        background: #F1F5F9;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-badge);
        color: #334155;
        font-size: 0.8rem;
        font-weight: 500;
        padding: 0.35rem 0.75rem;
    }
</style>

<div class="container-fluid px-4 px-md-5 py-4">
    <!-- Breadcrumb -->
    <nav class="job-breadcrumb">
        <a href="/gioi-thieu">Trang chủ</a>
        <span class="mx-1.5 text-muted">/</span>
        <a asp-controller="Jobs" asp-action="Index">Cơ hội nghề nghiệp</a>
        <span class="mx-1.5 text-muted">/</span>
        <span class="text-dark fw-medium">@job.Title</span>
    </nav>

    <!-- Success Message Alert if applied -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show p-3 mb-4 shadow-sm" style="border-radius: var(--radius-button); border-left: 5px solid var(--color-accent);" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                <div class="fw-semibold">@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- ── HEADER BANNER CARD ── -->
    <div class="job-header-card">
        <div class="row align-items-center gy-4">
            <div class="col-12 col-lg-8">
                <!-- Badges -->
                <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
                    <span class="badge px-2.5 py-1 text-xs" style="background: #EFF6FF; color: #1D4ED8; border-radius: var(--radius-badge); font-weight: 600;">
                        <i class="bi bi-building me-1"></i> @job.Department
                    </span>
                    @if (job.IsHot)
                    {
                        <span class="badge px-2.5 py-1 text-xs" style="background: #FEE2E2; color: #DC2626; border: 1px solid #FECACA; border-radius: var(--radius-badge); font-weight: 700;">
                            <i class="bi bi-fire me-0.5"></i> TUYỂN GẤP (HOT)
                        </span>
                    }
                    <span class="badge bg-light text-secondary border px-2.5 py-1 text-xs" style="border-radius: var(--radius-badge);">
                        <i class="bi bi-geo-alt me-1"></i> @job.WorkLocation
                    </span>
                    <span class="badge bg-light text-secondary border px-2.5 py-1 text-xs" style="border-radius: var(--radius-badge);">
                        <i class="bi bi-bar-chart-steps me-1"></i> @job.ExperienceLevel
                    </span>
                </div>

                <!-- Job Title -->
                <h1 class="job-h1 mb-3">@job.Title</h1>

                <!-- Short summary -->
                <p class="text-muted fs-6 mb-3" style="line-height: 1.65; max-width: 720px;">
                    @job.ShortSummary
                </p>

                <!-- Salary Display -->
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <div>
                        <span class="text-muted small d-block mb-1 font-monospace text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Mức thu nhập đãi ngộ:</span>
                        <span class="salary-badge-lg">@job.SalaryDisplay</span>
                    </div>
                    <div class="ms-md-3 ps-md-3 border-start">
                        <span class="text-muted small d-block mb-1" style="font-size: 0.75rem;">Hạn nộp hồ sơ:</span>
                        <span class="fw-semibold text-dark font-monospace" style="font-size: 0.95rem;">@job.Deadline.ToString("dd/MM/yyyy")</span>
                    </div>
                </div>
            </div>

            <!-- Header Actions -->
            <div class="col-12 col-lg-4 text-lg-end">
                <div class="d-flex flex-column gap-2.5 justify-content-lg-end align-items-lg-end">
                    @if (canEditJob)
                    {
                        <button type="button" class="btn btn-warning text-dark fw-bold w-100 shadow-sm d-flex align-items-center justify-content-center gap-2 mb-1" data-bs-toggle="modal" data-bs-target="#editJobPostingModal" style="border-radius: var(--radius-button); padding: 0.7rem 1.25rem;">
                            <i class="bi bi-pencil-square fs-5"></i> Chỉnh sửa bài đăng
                        </button>
                    }
                    <a href="#apply-section" class="btn-apply-main w-100 w-sm-auto">
                        <i class="bi bi-send-fill"></i> Ứng tuyển vị trí này
                    </a>
                    <div class="d-flex gap-2 w-100 justify-content-lg-end">
                        <button type="button" class="btn-save-job flex-grow-1 flex-lg-grow-0" onclick="navigator.clipboard.writeText(window.location.href); alert('Đã sao chép liên kết vị trí tuyển dụng vào bộ nhớ tạm!');">
                            <i class="bi bi-share"></i> Chia sẻ
                        </button>
                        <a asp-controller="Jobs" asp-action="Index" class="btn-save-job flex-grow-1 flex-lg-grow-0" title="Xem tất cả vị trí">
                            <i class="bi bi-grid"></i> Tất cả việc làm
                        </a>
                    </div>
                    <span class="text-muted small" style="font-size: 0.75rem;">
                        <i class="bi bi-shield-check text-success me-1"></i> Cam kết phản hồi ứng viên trong 48h
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- ── MAIN BODY & SIDEBAR ── -->
    <div class="row g-4">
        <!-- Left: Job Details (8 cols) -->
        <div class="col-12 col-lg-8">
            <!-- 1. Bối cảnh & Tổng quan -->
            <div class="detail-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="section-title mb-0 border-0 pb-0">
                        <i class="bi bi-info-circle text-primary"></i> Tổng quan về vị trí công việc
                    </h2>
                    @if (canEditJob)
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#editJobPostingModal" style="border-radius: 6px; font-size: 0.8rem;">
                            <i class="bi bi-pencil"></i> Chỉnh sửa
                        </button>
                    }
                </div>
                <div style="line-height: 1.75; color: #334155; font-size: 0.95rem; white-space: pre-line;">
                    @Html.Raw(job.Overview)
                </div>
                <div class="p-3 bg-light rounded-3 border mt-3" style="border-radius: var(--radius-button); font-size: 0.875rem;">
                    <strong class="text-dark"><i class="bi bi-lightbulb text-warning me-1"></i> Văn hóa Kỹ thuật tại NoveraTech:</strong>
                    <div class="text-muted mt-1" style="line-height: 1.6;">
                        Chúng tôi đề cao tính thực chất, trao quyền tự chủ kỹ thuật tối đa cho kỹ sư và đánh giá dựa trên giá trị giải pháp thay vì hình thức chấm công.
                    </div>
                </div>
            </div>

            <!-- 2. Mô tả chức năng & Vai trò (Position Function & Role Description) -->
            <div class="detail-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="section-title mb-0 border-0 pb-0">
                        <i class="bi bi-briefcase text-success"></i> Mô tả chức năng & Vai trò công việc
                    </h2>
                    @if (canEditJob)
                    {
                        <span class="badge bg-light text-secondary border font-monospace" style="font-size: 0.72rem; border-radius: 4px;">Recruiter / HR / Admin</span>
                    }
                </div>
                <div style="line-height: 1.75; color: #334155; font-size: 0.95rem; white-space: pre-line;">
                    @if (!string.IsNullOrWhiteSpace(job.PositionDescription))
                    {
                        @Html.Raw(job.PositionDescription)
                    }
                    else
                    {
                        @Html.Raw(job.Overview)
                    }
                </div>
                <div class="mt-3 p-3 rounded-3 border" style="background: #F8FAFC; border-color: #E2E8F0; border-radius: var(--radius-button); font-size: 0.85rem;">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="bi bi-diagram-3-fill text-primary"></i>
                        <span class="fw-bold text-dark">Khung định biên & Vị trí trong tổ chức:</span>
                    </div>
                    <div class="text-muted" style="line-height: 1.55;">
                        Chức danh <strong>@job.Title</strong> thuộc <strong>@job.Department</strong>, cấp bậc <strong>@job.ExperienceLevel</strong>, chế độ <strong>@job.EmploymentType</strong> tại <strong>@job.WorkLocation</strong>.
                    </div>
                </div>
            </div>

            <!-- 2. Trách nhiệm công việc -->
            <div class="detail-card">
                <h2 class="section-title">
                    <i class="bi bi-card-checklist text-success"></i> Trách nhiệm & Nhiệm vụ chính
                </h2>
                <ul class="jd-list">
                    @foreach (var res in job.Responsibilities)
                    {
                        <li>@res</li>
                    }
                </ul>
            </div>

            <!-- 3. Yêu cầu chuyên môn -->
            <div class="detail-card">
                <h2 class="section-title">
                    <i class="bi bi-person-check text-info"></i> Yêu cầu năng lực & Kinh nghiệm
                </h2>
                <ul class="jd-list">
                    @foreach (var req in job.Requirements)
                    {
                        <li>@req</li>
                    }
                </ul>
            </div>

            <!-- 4. Tech Stack -->
            <div class="detail-card">
                <h2 class="section-title">
                    <i class="bi bi-stack text-warning"></i> Công nghệ & Công cụ sử dụng
                </h2>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var t in job.TechStack)
                    {
                        <span class="tech-pill">
                            <i class="bi bi-code-slash text-success me-1"></i> @t
                        </span>
                    }
                </div>
            </div>

            <!-- 5. Quyền lợi đãi ngộ -->
            <div class="detail-card" style="border-color: #A7F3D0; background: #FAFFFD;">
                <h2 class="section-title" style="color: #065F46; border-color: #D1FAE5;">
                    <i class="bi bi-gift text-success"></i> Quyền lợi & Đãi ngộ đặc quyền tại NoveraTech
                </h2>
                <ul class="jd-list">
                    @foreach (var ben in job.Benefits)
                    {
                        <li>@ben</li>
                    }
                </ul>
            </div>

            <!-- 6. Quy trình 4 bước tuyển dụng -->
            <div class="detail-card">
                <h2 class="section-title">
                    <i class="bi bi-bezier2 text-primary"></i> Quy trình phỏng vấn tinh gọn (Cam kết 48h)
                </h2>
                <div class="row g-3">
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light rounded-3 text-center border h-100">
                            <div class="fw-bold font-monospace text-success mb-1" style="font-size: 1.1rem;">BƯỚC 1</div>
                            <div class="fw-semibold text-dark small mb-1">Nộp hồ sơ</div>
                            <div class="text-muted" style="font-size: 0.75rem;">Nộp CV trực tuyến trong 1 phút</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light rounded-3 text-center border h-100">
                            <div class="fw-bold font-monospace text-success mb-1" style="font-size: 1.1rem;">BƯỚC 2</div>
                            <div class="fw-semibold text-dark small mb-1">Sàng lọc CV</div>
                            <div class="text-muted" style="font-size: 0.75rem;">Phản hồi kết quả trong 48h</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light rounded-3 text-center border h-100">
                            <div class="fw-bold font-monospace text-success mb-1" style="font-size: 1.1rem;">BƯỚC 3</div>
                            <div class="fw-semibold text-dark small mb-1">Phỏng vấn Kỹ thuật</div>
                            <div class="text-muted" style="font-size: 0.75rem;">Trao đổi online cùng Tech Lead</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light rounded-3 text-center border h-100">
                            <div class="fw-bold font-monospace text-success mb-1" style="font-size: 1.1rem;">BƯỚC 4</div>
                            <div class="fw-semibold text-dark small mb-1">Offer & Onboard</div>
                            <div class="text-muted" style="font-size: 0.75rem;">Nhận MacBook Pro & Gia nhập</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 7. FORM ỨNG TUYỂN TRỰC TIẾP -->
            <div id="apply-section" class="detail-card" style="border: 2px solid var(--color-accent); scroll-margin-top: 2rem;">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                    <div>
                        <h2 class="fw-bold mb-1" style="font-size: 1.25rem; color: var(--color-text-main);">
                            <i class="bi bi-send text-success me-1.5"></i> Nộp hồ sơ ứng tuyển vị trí này
                        </h2>
                        <span class="text-muted small">Điền thông tin và tải lên CV của bạn (PDF / DOCX). Chúng tôi sẽ liên hệ trong 48 giờ.</span>
                    </div>
                    <span class="badge bg-success-subtle text-success px-2.5 py-1" style="border-radius: 6px; font-weight: 600;">
                        Nhanh & Bảo mật
                    </span>
                </div>

                <form method="post" asp-controller="Jobs" asp-action="QuickApply" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="jobId" value="@job.Id" />

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-dark">Họ và tên của bạn <span class="text-danger">*</span></label>
                            <input type="text" name="candidateName" class="form-control" style="border-radius: var(--radius-button); padding: 0.65rem 0.85rem;" placeholder="Ví dụ: Nguyễn Văn An" required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-dark">Email liên hệ <span class="text-danger">*</span></label>
                            <input type="email" name="candidateEmail" class="form-control" style="border-radius: var(--radius-button); padding: 0.65rem 0.85rem;" placeholder="an.nguyen@example.com" required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-dark">Số điện thoại di động <span class="text-danger">*</span></label>
                            <input type="tel" name="candidatePhone" class="form-control" style="border-radius: var(--radius-button); padding: 0.65rem 0.85rem;" placeholder="0912 345 678" required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-dark">Tải lên hồ sơ CV (PDF/DOCX) <span class="text-danger">*</span></label>
                            <input type="file" name="cvFile" class="form-control" style="border-radius: var(--radius-button); padding: 0.55rem 0.85rem;" accept=".pdf,.docx,.doc" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-dark">Lời giới thiệu ngắn hoặc link GitHub / LinkedIn (Tùy chọn)</label>
                            <textarea name="coverLetter" rows="3" class="form-control" style="border-radius: var(--radius-button);" placeholder="Chia sẻ thêm về các dự án tiêu biểu hoặc kinh nghiệm thực chiến của bạn..."></textarea>
                        </div>
                        <div class="col-12 pt-2">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <span class="text-muted" style="font-size: 0.78rem;">
                                    <i class="bi bi-shield-lock text-success me-1"></i> Thông tin của bạn được cam kết bảo mật theo chính sách quyền riêng tư NoveraTech.
                                </span>
                                <button type="submit" class="btn-apply-main">
                                    <i class="bi bi-check-circle-fill"></i> Hoàn tất nộp hồ sơ
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Right: Sidebar (4 cols) -->
        <div class="col-12 col-lg-4">
            <!-- Widget 1: Tóm tắt thông tin công việc -->
            <div class="sidebar-widget">
                <h5 class="fw-bold mb-3 pb-2 border-bottom" style="font-size: 1rem; color: var(--color-text-main);">
                    <i class="bi bi-briefcase text-success me-1.5"></i> Thông tin tuyển dụng
                </h5>
                <div class="info-row">
                    <i class="bi bi-currency-dollar"></i>
                    <div>
                        <div class="text-muted small">Mức thu nhập:</div>
                        <div class="fw-bold font-monospace text-success">@job.SalaryDisplay</div>
                    </div>
