                                        @rel.Department
                                    </span>
                                    <span class="fw-bold font-monospace text-success" style="font-size: 0.8rem;">@rel.SalaryDisplay</span>
                                </div>
                                <a asp-controller="Jobs" asp-action="Detail" asp-route-id="@rel.Slug" class="fw-bold text-dark text-decoration-none small d-block mb-1 hover-green" style="line-height: 1.35;">
                                    @rel.Title
                                </a>
                                <div class="text-muted" style="font-size: 0.72rem;">
                                    <i class="bi bi-geo-alt me-0.5"></i> @rel.WorkLocation
                                </div>
                            </div>
                        }
                    </div>
                    <div class="mt-3 text-center">
                        <a asp-controller="Jobs" asp-action="Index" class="btn btn-sm btn-link text-success fw-semibold text-decoration-none" style="font-size: 0.85rem;">
                            Xem toàn bộ vị trí khác &rarr;
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@if (canEditJob)
{
    <!-- Modal Chỉnh sửa bài đăng trực tiếp (Dành cho Recruiter, HRManager, Admin) -->
    <div class="modal fade" id="editJobPostingModal" tabindex="-1" aria-labelledby="editJobPostingModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 14px;">
                <div class="modal-header border-bottom pb-3" style="background: #F8FAFC;">
                    <div class="d-flex align-items-center gap-2">
                        <div class="d-flex align-items-center justify-content-center rounded-3 bg-warning text-dark" style="width: 38px; height: 38px;">
                            <i class="bi bi-pencil-square fs-5"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold text-dark mb-0" id="editJobPostingModalLabel">
                                Chỉnh sửa trực tiếp tin tuyển dụng
                            </h5>
                            <span class="text-muted" style="font-size: 0.78rem;">Phân quyền: Recruiter / Trưởng phòng Nhân sự / Admin hệ thống</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <form id="editJobPostingForm" onsubmit="handleUpdateJobPosting(event)">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="JobId" value="@(string.IsNullOrEmpty(job.Id) ? job.Slug : job.Id)" />

                        <div class="row g-3">
                            <div class="col-12 col-md-8">
                                <label class="form-label small fw-bold text-dark">Tiêu đề vị trí công việc <span class="text-danger">*</span></label>
                                <input type="text" name="Title" class="form-control" value="@job.Title" required style="border-radius: 8px;" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-bold text-dark">Phòng ban / Đơn vị <span class="text-danger">*</span></label>
                                <input type="text" name="Department" class="form-control" value="@job.Department" required style="border-radius: 8px;" />
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-bold text-dark">Cấp bậc / Trình độ</label>
                                <input type="text" name="ExperienceLevel" class="form-control" value="@job.ExperienceLevel" placeholder="VD: Senior, Middle, Lead" style="border-radius: 8px;" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-bold text-dark">Mức thu nhập đãi ngộ (Lương)</label>
                                <input type="text" name="SalaryDisplay" class="form-control" value="@job.SalaryDisplay" placeholder="VD: 35 – 50 Triệu VNĐ" style="border-radius: 8px;" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-bold text-dark">Hạn nộp hồ sơ</label>
                                <input type="date" name="Deadline" class="form-control" value="@job.Deadline.ToString("yyyy-MM-dd")" required style="border-radius: 8px;" />
                            </div>

                            <div class="col-12">
                                <label class="form-label small fw-bold text-dark">Địa điểm làm việc & Chế độ</label>
                                <input type="text" name="WorkLocation" class="form-control" value="@job.WorkLocation" placeholder="VD: Hà Nội (Hybrid 2 ngày WFH)" style="border-radius: 8px;" />
                            </div>

                            <!-- 1. Tổng quan vị trí -->
                            <div class="col-12">
                                <label class="form-label small fw-bold text-dark">1. Tổng quan vị trí công việc</label>
                                <textarea name="Overview" class="form-control" rows="3" style="border-radius: 8px;" placeholder="Bối cảnh dự án, sứ mệnh của vị trí...">@job.Overview</textarea>
                            </div>

                            <!-- 2. Mô tả chức năng & Vai trò -->
                            <div class="col-12">
                                <label class="form-label small fw-bold text-dark">2. Mô tả chức năng & Vai trò nhiệm vụ</label>
                                <textarea name="PositionDescription" class="form-control" rows="3" style="border-radius: 8px;" placeholder="Mô tả chức năng nhiệm vụ của vị trí trong cơ cấu doanh nghiệp...">@job.PositionDescription</textarea>
                            </div>

                            <!-- 3. Trách nhiệm chính -->
                            <div class="col-12">
                                <label class="form-label small fw-bold text-dark">3. Trách nhiệm & Nhiệm vụ chính (Mỗi ý một dòng)</label>
                                <textarea name="Responsibilities" class="form-control font-monospace" rows="4" style="border-radius: 8px; font-size: 0.88rem;">@string.Join("\n", job.Responsibilities)</textarea>
                            </div>

                            <!-- 4. Yêu cầu chuyên môn -->
                            <div class="col-12">
                                <label class="form-label small fw-bold text-dark">4. Yêu cầu năng lực & Kinh nghiệm (Mỗi ý một dòng)</label>
                                <textarea name="Requirements" class="form-control font-monospace" rows="4" style="border-radius: 8px; font-size: 0.88rem;">@string.Join("\n", job.Requirements)</textarea>
                            </div>

                            <!-- 5. Tech Stack -->
                            <div class="col-12">
                                <label class="form-label small fw-bold text-dark">5. Công nghệ & Công cụ (Cách nhau bằng dấu phẩy)</label>
                                <input type="text" name="TechStack" class="form-control font-monospace" value="@string.Join(", ", job.TechStack)" placeholder=".NET 9, C#, React 19, TypeScript, PostgreSQL" style="border-radius: 8px; font-size: 0.88rem;" />
                            </div>

                            <!-- 6. Quyền lợi đãi ngộ -->
                            <div class="col-12">
                                <label class="form-label small fw-bold text-dark">6. Quyền lợi & Đãi ngộ (Mỗi ý một dòng)</label>
                                <textarea name="Benefits" class="form-control font-monospace" rows="4" style="border-radius: 8px; font-size: 0.88rem;">@string.Join("\n", job.Benefits)</textarea>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <button type="button" class="btn btn-light px-4" style="border-radius: 8px;" data-bs-dismiss="modal">Hủy bỏ</button>
                            <button type="submit" class="btn btn-success px-4 fw-bold text-white d-inline-flex align-items-center gap-2" id="btnSubmitEditJob" style="border-radius: 8px;">
                                <span class="spinner-border spinner-border-sm d-none" id="spinnerEditJob"></span>
                                <i class="bi bi-floppy"></i> Lưu thay đổi trực tiếp
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        async function handleUpdateJobPosting(e) {
            e.preventDefault();
            var form = document.getElementById('editJobPostingForm');
            var btn = document.getElementById('btnSubmitEditJob');
            var spinner = document.getElementById('spinnerEditJob');

            btn.disabled = true;
            spinner.classList.remove('d-none');

            var formData = new FormData(form);

            try {
                var res = await fetch('/Jobs/UpdatePosting', {
                    method: 'POST',
                    body: formData
                });

                var data = await res.json();
                if (data.success) {
                    alert(data.message || 'Cập nhật bài đăng thành công!');
                    var modalEl = document.getElementById('editJobPostingModal');
                    if (modalEl) {
                        var m = bootstrap.Modal.getInstance(modalEl);
                        if (m) m.hide();
                    }
                    if (data.slug) {
                        window.location.href = '/Jobs/Detail/' + data.slug;
                    } else {
                        window.location.reload();
                    }
                } else {
                    alert(data.message || 'Lỗi khi cập nhật bài đăng.');
                }
            } catch (err) {
                alert('Lỗi kết nối máy chủ: ' + err.message);
            } finally {
                btn.disabled = false;
                spinner.classList.add('d-none');
            }
        }
    </script>
}

