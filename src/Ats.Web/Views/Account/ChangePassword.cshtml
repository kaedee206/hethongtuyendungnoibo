@model Ats.Web.Models.ViewModels.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="container py-5" style="max-width: 520px;">
    <div style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 12px; box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04); padding: 2rem;">
        <!-- Header -->
        <div class="d-flex align-items-center gap-3 pb-3 mb-4" style="border-bottom: 1px solid #E2E8F0;">
            <div style="width: 44px; height: 44px; background: #ECFDF5; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <i class="bi bi-shield-lock-fill" style="color: #059669; font-size: 1.25rem;"></i>
            </div>
            <div>
                <h1 style="font-size: 1.25rem; font-weight: 700; color: #0F172A; margin: 0; letter-spacing: -0.01em;">Đổi Mật Khẩu</h1>
                <p style="font-size: 0.85rem; color: #64748B; margin: 0.2rem 0 0 0;">Cập nhật mật khẩu để bảo vệ tài khoản nội bộ NoveraTech</p>
            </div>
        </div>

        <form asp-controller="Account" asp-action="ChangePassword" method="post" novalidate id="changePwdForm">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 mb-3 small" style="border-radius: 8px;" role="alert"></div>

            <!-- Mật khẩu hiện tại -->
            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label d-block" style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #475569;">
                    Mật khẩu hiện tại
                </label>
                <div class="input-group">
                    <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" autofocus
                           placeholder="••••••••"
                           style="border-radius: 8px 0 0 8px; border: 1px solid #CBD5E1; font-size: 0.9rem; height: 42px;" />
                    <button class="btn btn-outline-secondary toggle-pwd-btn" type="button" aria-label="Hiện/ẩn mật khẩu"
                            style="border-radius: 0 8px 8px 0; border: 1px solid #CBD5E1; border-left: none; color: #64748B;">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="CurrentPassword" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Mật khẩu mới -->
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label d-block" style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #475569;">
                    Mật khẩu mới
                </label>
                <div class="input-group">
                    <input asp-for="NewPassword" class="form-control" id="newPasswordInput" autocomplete="new-password"
                           placeholder="••••••••"
                           style="border-radius: 8px 0 0 8px; border: 1px solid #CBD5E1; font-size: 0.9rem; height: 42px;" />
                    <button class="btn btn-outline-secondary toggle-pwd-btn" type="button" aria-label="Hiện/ẩn mật khẩu"
                            style="border-radius: 0 8px 8px 0; border: 1px solid #CBD5E1; border-left: none; color: #64748B;">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block"></span>

                <!-- Realtime Password Strength Indicators (4 Cấp độ: Yếu - Vừa - Mạnh - Siêu mạnh) -->
                <div class="mt-3" style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px; padding: 1.25rem 1.15rem 1.15rem 1.15rem;">
                    <div class="d-flex justify-content-between align-items-center mb-2.5">
                        <span style="font-size: 0.75rem; font-weight: 600; color: #475569;">Độ mạnh mật khẩu:</span>
                        <span id="strength-badge" class="badge" style="font-size: 0.7rem; font-weight: 600; background: #E2E8F0; color: #64748B; border-radius: 6px; padding: 4px 10px;">Chưa nhập</span>
                    </div>
                    <!-- Progress Bar (4 segments / 4 levels) - Giãn khoảng cách trên dưới thanh ratio -->
                    <div class="progress" style="height: 7px; background-color: #E2E8F0; border-radius: 9999px; overflow: hidden; margin-bottom: 1.15rem;">
                        <div id="strength-bar" class="progress-bar" role="progressbar" style="width: 0%; transition: width 0.3s ease, background-color 0.3s ease;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <!-- Gợi ý tiêu chuẩn mật khẩu mạnh/yếu - Giãn cách các tiêu chí thoáng và dễ nhìn -->
                    <div style="font-size: 0.73rem; font-weight: 600; color: #64748B; margin-bottom: 0.65rem; text-transform: uppercase; letter-spacing: 0.05em;">
                        Tiêu chuẩn bảo mật:
                    </div>
                    <div class="d-flex flex-column gap-2" style="font-size: 0.8rem;">
                        <div id="rule-length" class="text-muted d-flex align-items-center gap-2 py-0.5">
                            <i class="bi bi-circle"></i> <span>Tối thiểu 8 ký tự</span>
                        </div>
                        <div id="rule-lower-upper" class="text-muted d-flex align-items-center gap-2 py-0.5">
                            <i class="bi bi-circle"></i> <span>Bao gồm cả chữ hoa (A-Z) &amp; chữ thường (a-z)</span>
                        </div>
                        <div id="rule-digit" class="text-muted d-flex align-items-center gap-2 py-0.5">
                            <i class="bi bi-circle"></i> <span>Ít nhất 1 chữ số (0-9)</span>
                        </div>
                        <div id="rule-special" class="text-muted d-flex align-items-center gap-2 py-0.5">
                            <i class="bi bi-circle"></i> <span>Ít nhất 1 ký tự đặc biệt (@@$!%*?&amp;_-#)</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Xác nhận mật khẩu mới -->
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label d-block" style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #475569;">
                    Xác nhận mật khẩu mới
                </label>
                <div class="input-group">
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password"
                           placeholder="••••••••"
                           style="border-radius: 8px 0 0 8px; border: 1px solid #CBD5E1; font-size: 0.9rem; height: 42px;" />
                    <button class="btn btn-outline-secondary toggle-pwd-btn" type="button" aria-label="Hiện/ẩn mật khẩu"
                            style="border-radius: 0 8px 8px 0; border: 1px solid #CBD5E1; border-left: none; color: #64748B;">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Action buttons -->
            <div class="d-flex justify-content-end gap-2 pt-3" style="border-top: 1px solid #E2E8F0;">
                <a asp-controller="Home" asp-action="Index" class="btn"
                   style="background: #F1F5F9; color: #475569; border-radius: 8px; font-weight: 500; font-size: 0.9rem; padding: 0.55rem 1.25rem;">
                    Hủy bỏ
                </a>
                <button type="submit" class="btn"
                        style="background: #059669; color: #FFFFFF; border-radius: 8px; font-weight: 600; font-size: 0.9rem; padding: 0.55rem 1.5rem; transition: background 0.2s;"
                        onmouseover="this.style.background='#047857'" onmouseout="this.style.background='#059669'">
                    <i class="bi bi-check2-circle me-1"></i> Lưu mật khẩu mới
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Password visibility toggle
        document.querySelectorAll('.toggle-pwd-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const input = this.parentElement.querySelector('input');
                const icon = this.querySelector('i');
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.replace('bi-eye', 'bi-eye-slash');
                } else {
                    input.type = 'password';
                    icon.classList.replace('bi-eye-slash', 'bi-eye');
                }
            });
        });

        // Realtime 4-Level Password Strength Validator
        const newPwdInput = document.getElementById('newPasswordInput');
        if (newPwdInput) {
            const ruleLength = document.getElementById('rule-length');
            const ruleLowerUpper = document.getElementById('rule-lower-upper');
            const ruleDigit = document.getElementById('rule-digit');
            const ruleSpecial = document.getElementById('rule-special');
            const strengthBar = document.getElementById('strength-bar');
            const strengthBadge = document.getElementById('strength-badge');

            function updateRule(elem, isValid) {
                const icon = elem.querySelector('i');
                if (isValid) {
                    elem.classList.remove('text-muted');
                    elem.classList.add('text-success', 'fw-medium');
                    icon.className = 'bi bi-check-circle-fill text-success';
                } else {
                    elem.classList.add('text-muted');
                    elem.classList.remove('text-success', 'fw-medium');
                    icon.className = 'bi bi-circle';
                }
            }

            newPwdInput.addEventListener('input', function() {
                const val = this.value || '';
                if (!val) {
                    strengthBar.style.width = '0%';
                    strengthBar.style.backgroundColor = '#E2E8F0';
                    strengthBadge.textContent = 'Chưa nhập';
                    strengthBadge.style.backgroundColor = '#E2E8F0';
                    strengthBadge.style.color = '#64748B';
                    [ruleLength, ruleLowerUpper, ruleDigit, ruleSpecial].forEach(el => updateRule(el, false));
                    return;
                }

                const hasLength = val.length >= 8;
                const hasLower = /[a-z]/.test(val);
                const hasUpper = /[A-Z]/.test(val);
                const hasDigit = /[0-9]/.test(val);
                const hasSpecial = /[@@$!%*?&_\-#]/.test(val);

                updateRule(ruleLength, hasLength);
                updateRule(ruleLowerUpper, hasLower && hasUpper);
                updateRule(ruleDigit, hasDigit);
                updateRule(ruleSpecial, hasSpecial);

                let score = 0;
                if (hasLength) score++;
                if (hasLower && hasUpper) score++;
                if (hasDigit) score++;
                if (hasSpecial) score++;

                // 4 Cấp độ: Yếu - Vừa - Mạnh - Siêu mạnh
                if (score <= 1) {
                    strengthBar.style.width = '25%';
                    strengthBar.style.backgroundColor = '#EF4444'; // Đỏ
                    strengthBadge.textContent = 'Yếu';
                    strengthBadge.style.backgroundColor = '#FEE2E2';
                    strengthBadge.style.color = '#B91C1C';
                } else if (score === 2) {
                    strengthBar.style.width = '50%';
                    strengthBar.style.backgroundColor = '#F59E0B'; // Cam
                    strengthBadge.textContent = 'Vừa';
                    strengthBadge.style.backgroundColor = '#FEF3C7';
                    strengthBadge.style.color = '#B45309';
                } else if (score === 3) {
                    strengthBar.style.width = '75%';
                    strengthBar.style.backgroundColor = '#10B981'; // Xanh lục nhạt
                    strengthBadge.textContent = 'Mạnh';
                    strengthBadge.style.backgroundColor = '#D1FAE5';
                    strengthBadge.style.color = '#047857';
                } else {
                    strengthBar.style.width = '100%';
                    strengthBar.style.backgroundColor = '#059669'; // Xanh lục bảo
                    strengthBadge.textContent = 'Siêu mạnh';
                    strengthBadge.style.backgroundColor = '#ECFDF5';
                    strengthBadge.style.color = '#065F46';
                }
            });
        }
    </script>
}
