@{
    ViewData["Title"] = "Đổi Mật Khẩu - ATS";
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Account" asp-action="Profile">Hồ sơ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Đổi mật khẩu</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="ats-card">
                <div class="ats-card-header">
                    <h1 class="ats-card-title h5">
                        <i class="bi bi-shield-lock text-primary"></i> Đổi Mật Khẩu
                    </h1>
                </div>

                <form method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-semibold">Mật khẩu hiện tại</label>
                        <input type="password" class="form-control" name="CurrentPassword" required placeholder="Nhập mật khẩu đang dùng" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-semibold">Mật khẩu mới</label>
                        <input type="password" class="form-control" name="NewPassword" required placeholder="Tối thiểu 8 ký tự, gồm chữ hoa, số" />
                        <div class="form-text small text-muted">Mật khẩu phải có ít nhất 8 ký tự, bao gồm chữ hoa, chữ thường và chữ số.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-semibold">Xác nhận mật khẩu mới</label>
                        <input type="password" class="form-control" name="ConfirmPassword" required placeholder="Nhập lại mật khẩu mới" />
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex gap-2">
                        <button type="submit" class="btn btn-primary rounded-pill px-4">
                            <i class="bi bi-check2-circle me-1"></i> Cập Nhật Mật Khẩu
                        </button>
                        <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary rounded-pill px-4">
                            Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
