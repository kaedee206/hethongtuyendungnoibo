@model Ats.Web.Models.ViewModels.Account.AccountLoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_LoginLayout";
}

<div class="login-wrapper">
    <div class="login-card shadow-sm">

        <div class="login-card__header text-center">
            <a href="/gioi-thieu" title="Quay lại Trang chủ NoveraTech">
                <img src="~/img/logo-dark-transparent.png" alt="NoveraTech Careers" class="login-card__logo" asp-append-version="true" />
            </a>
            <h1 class="login-card__title">Đăng nhập hệ thống</h1>
            <p class="login-card__subtitle">Sử dụng email công việc (@@noveratech.digital) để đăng nhập</p>
        </div>

        <form asp-controller="Account" asp-action="Login" method="post" novalidate class="login-card__form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger login-card__alert"
                 role="alert"
                 aria-live="polite"></div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email"
                       class="form-control"
                       autocomplete="username"
                       autofocus
                       placeholder="user@noveratech.digital" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Password" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <button class="btn btn-outline-secondary login-card__toggle-password"
                            type="button"
                            aria-label="Hiện/ẩn mật khẩu"
                            aria-pressed="false">
                        <i class="bi bi-eye" aria-hidden="true"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="form-group d-flex justify-content-between align-items-center mb-3">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>
                <a asp-controller="Account" asp-action="ForgotPassword" class="login-card__forgot-link">
                    Quên mật khẩu?
                </a>
            </div>

            <button type="submit" class="btn btn-primary w-100 login-card__submit mb-3" style="border-radius: 8px;">
                Đăng nhập
            </button>

            @* Cổng Chuyển Hướng Cán bộ Nhân sự (Shield) & Ứng viên (Person) *@
            <div class="mt-3 pt-3 border-top border-slate-200">
                <a asp-controller="Account" asp-action="StaffLogin" class="d-flex align-items-center gap-2 p-2 mb-2 text-decoration-none text-dark bg-light border border-slate-200" style="border-radius: 8px;">
                    <i class="bi bi-shield-lock-fill text-success fs-5"></i>
                    <div class="text-start">
                        <div class="fw-semibold small text-slate-800">Cổng Nhân Sự Nội Bộ</div>
                        <div class="text-muted" style="font-size: 11px;">Dành cho cán bộ @@noveratech.digital</div>
                    </div>
                </a>
                <a asp-controller="Account" asp-action="CandidateAuth" class="d-flex align-items-center gap-2 p-2 text-decoration-none text-dark bg-light border border-slate-200" style="border-radius: 8px;">
                    <i class="bi bi-person-badge-fill text-primary fs-5"></i>
                    <div class="text-start">
                        <div class="fw-semibold small text-slate-800">Cổng Ứng Viên Tuyển Dụng</div>
                        <div class="text-muted" style="font-size: 11px;">Dành cho ứng viên nộp hồ sơ & tra cứu</div>
                    </div>
                </a>
            </div>

            <div class="text-center mt-3">
                <a href="/gioi-thieu" class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại Trang chủ
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/account-login.js" asp-append-version="true"></script>
}
