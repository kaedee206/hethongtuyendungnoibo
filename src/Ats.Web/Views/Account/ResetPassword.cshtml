@model Ats.Web.Models.ViewModels.Account.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = "_LoginLayout";
}

<div class="login-wrapper">
    <div class="login-card shadow-sm">
        <div class="login-card__header text-center">
            <a href="/gioi-thieu" title="Về trang chủ NoveraTech" class="d-inline-block mb-2">
                <img src="~/img/logo-dark-transparent.png" alt="NoveraTech Careers" class="login-card__logo" asp-append-version="true" />
            </a>
            <h1 class="login-card__title">Tạo mật khẩu mới</h1>
            <p class="login-card__subtitle">Vui lòng thiết lập mật khẩu mới có độ bảo mật cao</p>
        </div>

        <form asp-controller="Account" asp-action="ResetPassword" method="post" novalidate class="login-card__form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Token" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger login-card__alert" role="alert"></div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" readonly />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="NewPassword" class="form-control" id="resetNewPassword" autocomplete="new-password" />
                    <button class="btn btn-outline-secondary login-card__toggle-password" type="button" aria-label="Hiện/ẩn mật khẩu">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <!-- Realtime 4-Level Strength Meter -->
                <div class="mt-3" style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px; padding: 1.25rem 1.15rem 1.15rem 1.15rem;">
                    <div class="d-flex justify-content-between align-items-center mb-2.5">
                        <span style="font-size: 0.75rem; font-weight: 600; color: #475569;">Độ mạnh:</span>
                        <span id="reset-strength-badge" class="badge" style="font-size: 0.7rem; font-weight: 600; background: #E2E8F0; color: #64748B; border-radius: 6px; padding: 4px 10px;">Chưa nhập</span>
                    </div>
                    <div class="progress" style="height: 7px; background-color: #E2E8F0; border-radius: 9999px; margin-bottom: 1.15rem;">
                        <div id="reset-strength-bar" class="progress-bar" role="progressbar" style="width: 0%; transition: width 0.3s ease, background-color 0.3s ease;"></div>
                    </div>
                    <div style="font-size: 0.73rem; font-weight: 600; color: #64748B; margin-bottom: 0.65rem; text-transform: uppercase; letter-spacing: 0.05em;">
                        Tiêu chuẩn bảo mật:
                    </div>
                    <div class="d-flex flex-column gap-2" style="font-size: 0.78rem; color: #64748B;">
                        <div id="reset-r-len" class="d-flex align-items-center gap-2 py-0.5"><i class="bi bi-circle"></i> <span>Tối thiểu 8 ký tự</span></div>
                        <div id="reset-r-case" class="d-flex align-items-center gap-2 py-0.5"><i class="bi bi-circle"></i> <span>Chữ hoa &amp; chữ thường</span></div>
                        <div id="reset-r-num" class="d-flex align-items-center gap-2 py-0.5"><i class="bi bi-circle"></i> <span>Chữ số (0-9)</span></div>
                        <div id="reset-r-spec" class="d-flex align-items-center gap-2 py-0.5"><i class="bi bi-circle"></i> <span>Ký tự đặc biệt (@@$!%*?&amp;_)</span></div>
                    </div>
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <button class="btn btn-outline-secondary login-card__toggle-password" type="button" aria-label="Hiện/ẩn mật khẩu">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 login-card__submit mb-3">
                <i class="bi bi-shield-check me-1"></i> Xác nhận đổi mật khẩu
            </button>

            <div class="text-center">
                <a asp-controller="Account" asp-action="Login" class="text-decoration-none small text-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại Đăng nhập
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/account-login.js" asp-append-version="true"></script>
    <script>
        const resetPwd = document.getElementById('resetNewPassword');
        if (resetPwd) {
            const bar = document.getElementById('reset-strength-bar');
            const badge = document.getElementById('reset-strength-badge');
            const rLen = document.getElementById('reset-r-len');
            const rCase = document.getElementById('reset-r-case');
            const rNum = document.getElementById('reset-r-num');
            const rSpec = document.getElementById('reset-r-spec');

            function setR(el, ok) {
                const icon = el.querySelector('i');
                if (ok) {
                    el.className = 'd-flex align-items-center gap-1 text-success fw-medium';
                    icon.className = 'bi bi-check-circle-fill text-success';
                } else {
                    el.className = 'd-flex align-items-center gap-1 text-muted';
                    icon.className = 'bi bi-circle';
                }
            }

            resetPwd.addEventListener('input', function() {
                const val = this.value || '';
                if (!val) {
                    bar.style.width = '0%';
                    badge.textContent = 'Chưa nhập';
                    badge.style.backgroundColor = '#E2E8F0';
                    badge.style.color = '#64748B';
                    [rLen, rCase, rNum, rSpec].forEach(el => setR(el, false));
                    return;
                }
                const hasLen = val.length >= 8;
                const hasCase = /[a-z]/.test(val) && /[A-Z]/.test(val);
                const hasNum = /[0-9]/.test(val);
                const hasSpec = /[@@$!%*?&_\-#]/.test(val);

                setR(rLen, hasLen);
                setR(rCase, hasCase);
                setR(rNum, hasNum);
                setR(rSpec, hasSpec);

                let score = 0;
                if (hasLen) score++;
                if (hasCase) score++;
                if (hasNum) score++;
                if (hasSpec) score++;

                if (score <= 1) {
                    bar.style.width = '25%';
                    bar.style.backgroundColor = '#EF4444';
                    badge.textContent = 'Yếu';
                    badge.style.backgroundColor = '#FEE2E2';
                    badge.style.color = '#B91C1C';
                } else if (score === 2) {
                    bar.style.width = '50%';
                    bar.style.backgroundColor = '#F59E0B';
                    badge.textContent = 'Vừa';
                    badge.style.backgroundColor = '#FEF3C7';
                    badge.style.color = '#B45309';
                } else if (score === 3) {
                    bar.style.width = '75%';
                    bar.style.backgroundColor = '#10B981';
                    badge.textContent = 'Mạnh';
                    badge.style.backgroundColor = '#D1FAE5';
                    badge.style.color = '#047857';
                } else {
                    bar.style.width = '100%';
                    bar.style.backgroundColor = '#059669';
                    badge.textContent = 'Siêu mạnh';
                    badge.style.backgroundColor = '#ECFDF5';
                    badge.style.color = '#065F46';
                }
            });
        }
    </script>
}
