@model Ats.Web.Models.ViewModels.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = "_LoginLayout";
}

<div class="login-wrapper">
    <div class="login-card shadow-sm">
        <div class="login-card__header text-center">
            <a href="/gioi-thieu" title="Về trang chủ NoveraTech" class="d-inline-block mb-2">
                <img src="~/img/logo.svg" alt="NoveraTech ATS" class="login-card__logo" onerror="this.style.display='none'" />
            </a>
            <h1 class="login-card__title">Khôi phục mật khẩu</h1>
            <p class="login-card__subtitle">Nhập email công ty để nhận liên kết đặt lại mật khẩu</p>
        </div>

        @if (Model.EmailSent)
        {
            <div class="alert alert-success login-card__alert" role="alert">
                <div class="d-flex align-items-center mb-2">
                    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                    <strong>Yêu cầu đã được ghi nhận</strong>
                </div>
                <p class="mb-0 small">
                    Nếu email <strong>@Model.Email</strong> tồn tại trong hệ thống NoveraTech, một liên kết khôi phục mật khẩu đã được gửi đến hộp thư của bạn. Liên kết có hiệu lực trong 30 phút.
                </p>
            </div>

            <div class="text-center mt-4">
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary w-100">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại Đăng nhập
                </a>
            </div>
        }
        else
        {
            <form asp-controller="Account" asp-action="ForgotPassword" method="post" novalidate class="login-card__form">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger login-card__alert" role="alert"></div>

                <div class="form-group mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email"
                           class="form-control"
                           autocomplete="email"
                           autofocus
                           placeholder="ten.nguoi@noveratech.digital" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 login-card__submit mb-3">
                    <i class="bi bi-envelope me-1"></i> Gửi liên kết khôi phục
                </button>

                <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                    <a asp-controller="Account" asp-action="Login" class="text-decoration-none small text-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại Đăng nhập
                    </a>
                    <a href="/gioi-thieu" class="text-decoration-none small text-primary fw-medium">
                        <i class="bi bi-house me-1"></i> Về trang chủ
                    </a>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
