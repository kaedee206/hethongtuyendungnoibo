            function callResend(email, type, alertEl, timerId, btnId) {
                if (!email) {
                    if (alertEl) {
                        alertEl.textContent = 'Không tìm thấy địa chỉ email để gửi lại mã.';
                        alertEl.className = 'mb-4 px-3 py-2.5 border border-red-300 dark:border-red-800 bg-red-50 dark:bg-red-950/40 text-red-700 dark:text-red-400 text-sm rounded-lg';
                        alertEl.classList.remove('hidden');
                    }
                    return;
                }
                var btn = document.getElementById(btnId);
                if (btn) btn.disabled = true;

                var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                var fd = new FormData();
                fd.append('__RequestVerificationToken', token);
                fd.append('email', email);
                fd.append('type', type);

                fetch('/Account/CandidateResendOtp', {
                    method: 'POST',
                    body: fd,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    if (alertEl) {
                        alertEl.textContent = res.message;
                        alertEl.classList.remove('hidden');
                        if (res.success) {
                            alertEl.className = 'mb-4 px-3 py-2.5 border border-[#10B981]/40 bg-[#10B981]/5 text-[#047857] dark:text-[#10B981] text-sm rounded-lg';
                            startCountdown(timerId, btnId, 60);
                        } else {
                            alertEl.className = 'mb-4 px-3 py-2.5 border border-red-300 dark:border-red-800 bg-red-50 dark:bg-red-950/40 text-red-700 dark:text-red-400 text-sm rounded-lg';
                            if (btn) btn.disabled = false;
                        }
                    }
                })
                .catch(function () {
                    if (alertEl) {
                        alertEl.textContent = 'Lỗi kết nối khi gửi lại mã OTP.';
                        alertEl.className = 'mb-4 px-3 py-2.5 border border-red-300 dark:border-red-800 bg-red-50 dark:bg-red-950/40 text-red-700 dark:text-red-400 text-sm rounded-lg';
