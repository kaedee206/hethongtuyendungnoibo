@model CandidateAuthCompositeViewModel
@{
    ViewData["Title"] = "Gia nhập Novera Tech";
    Layout = "_AuthLayout";
    var activePanel = Model.ActivePanel ?? ViewData["ActivePanel"]?.ToString() ?? "signin";
    // translateX mapping: signin=0%, signup=-33.333%, reset=-66.666%
    string translateX = activePanel switch
    {
        "signup" => "-33.333%",
        "reset"  => "-66.666%",
        _        => "0%"
    };
}

@*
    Cổng Tuyển dụng Ứng viên - Candidate & Careers Portal
    Dành cho ứng viên bên ngoài đăng ký/đăng nhập vào hệ thống tuyển dụng Novera Tech
    Slider 3 trạng thái: #signin / #signup / #reset — sync URL Hash + Server ModelState fallback
*@

<section
    class="h-screen w-full flex flex-col lg:flex-row overflow-hidden"
    aria-label="Cổng Tuyển dụng Ứng viên Novera Tech">

    @* ─────────────────────────────────────────────────────────────
       PANEL TRÁI: Ambient Career Visual (Clean Tech & Employer Brand)
    ───────────────────────────────────────────────────────────── *@
    <div class="hidden lg:flex lg:w-1/2 relative flex-col justify-between h-full overflow-hidden bg-slate-950"
         aria-hidden="true">

        @* Background authentic career visual (Clean neutral contrast, zero dot-grid) *@
        <div class="absolute inset-0 z-0 bg-cover bg-center transition-transform duration-700 scale-100 hover:scale-[1.01]"
             style="background-image: url('/img/candidate_portal.jpg');">
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/75 to-slate-950/40 backdrop-blur-[1px]"></div>
        </div>

        @* Top Header Brand *@
        <div class="relative z-10 p-10 lg:p-12">
            <a href="/" class="inline-flex items-center gap-3 text-decoration-none group cursor-pointer" title="Quay lại Cổng Tuyển dụng NoveraTech">
                <div class="w-9 h-9 flex items-center justify-center rounded-lg bg-white/10 border border-white/15 backdrop-blur-md group-hover:border-emerald-500/50 group-hover:bg-emerald-500/15 transition-all duration-200">
                    <img src="~/img/logo-icon-dark-transparent.png"
                         alt="NoveraTech"
                         class="w-5 h-5 object-contain brightness-0 invert" />
                </div>
                <div>
                    <span class="block font-sans font-bold text-sm tracking-wider uppercase text-white leading-tight">NOVERATECH</span>
                    <span class="block font-sans text-[11px] text-slate-300 font-normal leading-none mt-0.5">Cổng Cơ Hội Nghề Nghiệp</span>
                </div>
            </a>
        </div>

        @* Center Content (Human-crafted, confident, zero buzzing AI slop) *@
        <div class="relative z-10 px-10 lg:px-12 my-auto max-w-xl">
            <div class="mb-4">
                <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400 font-mono">
                    NoveraTech Careers &middot; Khối Công Nghệ
                </span>
            </div>
            <h1 class="text-3xl lg:text-4xl font-bold text-white tracking-tight leading-[1.2]">
                Kiến Tạo Sự Nghiệp Công Nghệ Tại NoveraTech
            </h1>
            <p class="mt-4 text-sm text-slate-300 leading-relaxed max-w-md font-normal">
                Gia nhập đội ngũ hơn 500+ kỹ sư xuất sắc. Xây dựng nền tảng quy mô lớn với văn hóa kỹ thuật thực chiến "Engineering-First, Zero Politics".
            </p>

            @* Core Employer Commitments (Clean modern styling) *@
            <div class="grid grid-cols-1 gap-2.5 pt-6 max-w-md">
                <div class="flex items-center gap-3 p-3 bg-white/5 border border-white/10 rounded-lg backdrop-blur-sm">
                    <div class="w-2 h-2 rounded-full bg-emerald-400 flex-shrink-0"></div>
                    <div>
                        <p class="text-xs font-semibold text-white">Chính Sách Đãi Ngộ Hàng Đầu</p>
                        <p class="text-[11px] text-slate-300">Thu nhập Top 10% thị trường &middot; Trang bị MacBook Pro M3/M4 Max</p>
                    </div>
                </div>
                <div class="flex items-center gap-3 p-3 bg-white/5 border border-white/10 rounded-lg backdrop-blur-sm">
                    <div class="w-2 h-2 rounded-full bg-emerald-400 flex-shrink-0"></div>
                    <div>
                        <p class="text-xs font-semibold text-white">Kiến Trúc &amp; Bài Toán Thách Thức</p>
                        <p class="text-[11px] text-slate-300">Clean Architecture, High-load Microservices, Generative AI</p>
                    </div>
                </div>
                <div class="flex items-center gap-3 p-3 bg-white/5 border border-white/10 rounded-lg backdrop-blur-sm">
                    <div class="w-2 h-2 rounded-full bg-emerald-400 flex-shrink-0"></div>
                    <div>
                        <p class="text-xs font-semibold text-white">Minh Bạch &amp; Tốc Độ Phản Hồi</p>
                        <p class="text-[11px] text-slate-300">Cam kết phản hồi tiến độ và kết quả hồ sơ trong vòng 48 giờ</p>
                    </div>
                </div>
            </div>
        </div>

        @* Bottom Status & Recruiter Contact *@
        <div class="relative z-10 p-10 lg:p-12 border-t border-white/10 bg-slate-950/40 backdrop-blur-md">
            <div class="flex items-center justify-between text-xs text-slate-400">
                <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                    <span class="text-slate-300 font-medium">Tuyển dụng minh bạch &middot; Phản hồi 48h</span>
                </div>
                <div class="text-[11px] text-slate-400">
                    Tuyển dụng: <a href="mailto:careers@noveratech.digital" class="text-emerald-400 hover:underline font-mono">careers@noveratech.digital</a>
                </div>
            </div>
        </div>
    </div>

    @* ─────────────────────────────────────────────────────────────
       PANEL PHẢI: Multi-State Slider (100% mobile, 50% desktop)
    ───────────────────────────────────────────────────────────── *@
    <div class="w-full lg:w-1/2 flex flex-col h-full overflow-hidden bg-white dark:bg-[#0B0F17] transition-colors duration-200">

        @* Mobile Brand (visible only mobile) *@
        <div class="lg:hidden flex items-center justify-between px-6 py-4 border-b border-slate-200 dark:border-slate-800 flex-shrink-0">
            <a href="/" title="Quay lại Trang chủ NoveraTech" class="flex items-center gap-2.5">
                <img src="~/img/logo-icon-dark-transparent.png"
                     alt="NoveraTech"
                     class="h-6 w-6 object-contain dark:brightness-0 dark:invert" />
                <span class="font-bold text-sm text-slate-900 dark:text-white uppercase tracking-wider">NOVERATECH</span>
            </a>
            <a href="/" class="text-xs font-semibold text-[#047857] dark:text-[#10B981] hover:underline" title="Quay lại Trang chủ">
                <span>Trang chủ &rarr;</span>
            </a>
        </div>

        @* Slider Viewport *@
        <div class="flex-1 overflow-hidden relative">
            @* Track holds 3 panels side by side *@
            <div id="candSliderTrack"
                 class="flex w-[300%] h-full transition-transform duration-[350ms] ease-out"
                 style="transform: translateX(@translateX);"
                 data-active-panel="@activePanel">

                @* ─── SLIDE 1: Sign In ─── *@
                <div id="panelSignin"
                     class="w-1/3 flex flex-col justify-center px-6 sm:px-12 lg:px-16 overflow-y-auto"
                     role="region"
                     aria-label="Đăng nhập ứng viên"
                     aria-hidden="@(activePanel == "signin" ? "false" : "true")">

                    <div class="w-full max-w-sm mx-auto my-auto py-8">

                        <div class="mb-6">
                            <a href="/" class="inline-block mb-3 group cursor-pointer" title="Quay lại Trang chủ NoveraTech">
                                <img src="~/img/logo-dark-transparent.png"
                                     alt="NoveraTech Careers"
                                     class="h-7 object-contain logo-brand-invert transition-opacity group-hover:opacity-85" />
                            </a>
                            <h2 class="text-slate-900 dark:text-slate-100 text-2xl font-bold tracking-tight">
                                Cổng Ứng Viên Tuyển Dụng
                            </h2>
                            <p class="text-slate-500 dark:text-slate-400 text-xs mt-1.5 leading-relaxed">
                                Đăng nhập để theo dõi tiến độ hồ sơ ứng tuyển &amp; cơ hội nghề nghiệp tại NoveraTech.
                            </p>
                        </div>

                        @* Validation Summary *@
                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.TryGetValue(string.Empty, out var candidateErrors) && candidateErrors.Errors.Count > 0)
                        {
                            <div asp-validation-summary="ModelOnly"
                                 class="mb-4 px-3.5 py-2.5 border border-red-200 dark:border-red-900/60 bg-red-50 dark:bg-red-950/40 text-red-700 dark:text-red-400 text-xs rounded-lg"
                                 role="alert" aria-live="polite"></div>
                        }

                        <div id="signinDynamicSuccess"
                             class="mb-4 px-3.5 py-2.5 border border-emerald-300 dark:border-emerald-800 bg-[#ECFDF5] text-[#047857] dark:text-[#10B981] text-xs rounded-lg @(activePanel == "signin" && Model.IsSuccess && !string.IsNullOrWhiteSpace(Model.StatusMessage) ? "" : "hidden")"
                             role="status">
                            @(activePanel == "signin" && Model.IsSuccess ? Model.StatusMessage : "")
                        </div>

                        <form asp-controller="Account" asp-action="CandidateLogin" method="post" novalidate autocomplete="on" class="space-y-4">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="LoginInput.ReturnUrl" />
                            <input type="hidden" name="ActivePanel" value="signin" />

                            <div>
                                <label asp-for="LoginInput.Email" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">
                                    Email cá nhân
                                </label>
                                <input asp-for="LoginInput.Email" id="candLoginEmailInput" type="email" autocomplete="username" placeholder="your@email.com"
                                       class="w-full px-3.5 py-2.5 text-sm font-sans rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-900/80 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-[#047857]/20 focus:border-[#047857] transition-all" />
                                <span asp-validation-for="LoginInput.Email" class="block mt-1 text-xs text-red-600 dark:text-red-400 font-mono"></span>
                            </div>

                            <div>
                                <div class="flex items-center justify-between mb-1.5">
                                    <label asp-for="LoginInput.Password" class="block text-xs font-medium text-slate-700 dark:text-slate-300">
                                        Mật khẩu
                                    </label>
                                    <button type="button" id="btnGoToReset"
                                            class="text-xs font-medium text-[#047857] dark:text-[#10B981] hover:underline underline-offset-2">
                                        Quên mật khẩu?
                                    </button>
                                </div>
                                <div class="relative">
                                    <input asp-for="LoginInput.Password" type="password" id="candPasswordInput" autocomplete="current-password"
                                           placeholder="••••••••••••"
                                           class="w-full px-3.5 py-2.5 pr-10 text-sm font-sans rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-900/80 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-[#047857]/20 focus:border-[#047857] transition-all" />
                                    <button type="button" id="candEyeToggle" aria-label="Hiện hoặc ẩn mật khẩu" aria-pressed="false"
                                            class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors p-1">
                                        <svg id="candEyeOpen" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                        </svg>
                                        <svg id="candEyeClosed" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"/>
                                        </svg>
                                    </button>
                                </div>
                                <span asp-validation-for="LoginInput.Password" class="block mt-1 text-xs text-red-600 dark:text-red-400 font-mono"></span>
                            </div>

                            <div class="flex items-center justify-between pt-0.5">
                                <label class="flex items-center gap-2 cursor-pointer select-none group">
                                    <div class="relative">
                                        <input asp-for="LoginInput.RememberMe" type="checkbox" class="peer sr-only" />
                                        <div class="w-4 h-4 border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 rounded peer-checked:bg-[#047857] peer-checked:border-[#047857] transition-all flex items-center justify-center">
                                            <svg class="w-2.5 h-2.5 text-white opacity-0 peer-checked:opacity-100" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                                            </svg>
                                        </div>
                                    </div>
                                    <span class="text-xs text-slate-600 dark:text-slate-400">Ghi nhớ đăng nhập</span>
                                </label>
                            </div>

                            <button type="submit"
                                    class="w-full py-2.5 px-4 bg-[#047857] hover:bg-[#065F46] text-white text-sm font-semibold tracking-wide rounded-lg border border-[#047857] hover:border-[#065F46] transition-all shadow-sm active:translate-y-[1px] duration-100 flex items-center justify-center gap-2">
                                <span>Đăng Nhập</span>
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                                </svg>
                            </button>

                            <p class="text-center text-xs text-slate-500 dark:text-slate-400 pt-1">
                                Chưa có tài khoản?
                                <button type="button" id="btnGoToSignup1"
                                        class="font-medium text-[#047857] dark:text-[#10B981] hover:underline underline-offset-2 ml-1">
                                    Đăng ký ngay &rarr;
                                </button>
                            </p>

                            @* Subtle Link to Staff Portal (Clean footnote, zero bulky card) *@
                            <div class="mt-8 pt-5 border-t border-slate-200 dark:border-slate-800 text-center">
                                <p class="text-xs text-slate-500 dark:text-slate-400">
                                    Bạn là cán bộ nhân sự NoveraTech?
                                    <a asp-controller="Account" asp-action="StaffLogin"
                                       class="font-medium text-[#047857] dark:text-[#10B981] hover:underline inline-flex items-center gap-1 ml-1"
                                       title="Chuyển đến Cổng Quản trị & Xác thực dành cho Cán bộ Nhân viên Nội bộ">
                                        Đăng nhập Cổng Nội bộ &rarr;
                                    </a>
                                </p>
                            </div>
                        </form>
                    </div>
                </div>

                @* ─── SLIDE 2: Sign Up ─── *@
                <div id="panelSignup"
                     class="w-1/3 flex flex-col justify-center px-6 sm:px-12 lg:px-16 overflow-y-auto"
                     role="region"
                     aria-label="Đăng ký tài khoản ứng viên"
                     aria-hidden="@(activePanel == "signup" ? "false" : "true")">

                    <div class="w-full max-w-sm mx-auto my-auto py-8">

                        @{
                            var isSignupVerifyStep = activePanel == "signup" && Model.OtpStep == "verify";
                            var pendingSignupEmail = Model.PendingEmail ?? Model.VerifyRegisterOtpInput?.Email ?? Model.RegisterInput?.Email ?? "";
                        }

                        @* ═══ BƯỚC 1: NHẬP THÔNG TIN ĐĂNG KÝ ═══ *@
                        <div id="signupStepInput" class="@(isSignupVerifyStep ? "hidden" : "")">
                            <div class="mb-5">
                                <a href="/" class="inline-block mb-3 group cursor-pointer" title="Quay lại Trang chủ NoveraTech">
                                    <img src="~/img/logo-dark-transparent.png"
                                         alt="NoveraTech Careers"
                                         class="h-7 object-contain logo-brand-invert transition-opacity group-hover:opacity-85" />
                                </a>
                                <h2 class="text-slate-900 dark:text-slate-100 text-2xl font-bold tracking-tight">Tạo tài khoản ứng viên</h2>
                                <p class="text-slate-500 dark:text-slate-400 text-xs mt-1.5 leading-relaxed">Đăng ký tài khoản để ứng tuyển và quản lý hồ sơ tại NoveraTech.</p>
                            </div>

                            <div id="signupInputError"
                                 class="mb-4 px-3.5 py-2.5 border border-red-200 dark:border-red-900/60 bg-red-50 dark:bg-red-950/40 text-red-700 dark:text-red-400 text-xs rounded-lg @(activePanel == "signup" && !isSignupVerifyStep && !Model.IsSuccess && !string.IsNullOrWhiteSpace(Model.StatusMessage) ? "" : "hidden")"
                                 role="alert" aria-live="polite">
                                @(activePanel == "signup" && !isSignupVerifyStep && !Model.IsSuccess ? Model.StatusMessage : "")
                            </div>

                            <form id="formCandidateRegister" asp-controller="Account" asp-action="CandidateRegister" method="post" novalidate autocomplete="on" class="space-y-3">
                                @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="RegisterInput.ReturnUrl" />
                                <input type="hidden" name="ActivePanel" value="signup" />

                                <div>
                                    <label asp-for="RegisterInput.FullName" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Họ và tên</label>
                                    <input asp-for="RegisterInput.FullName" id="candRegisterFullName" type="text" autocomplete="name" placeholder="Nguyễn Văn A"
                                           class="w-full px-3.5 py-2 text-sm font-sans rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-900/80 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-[#047857]/20 focus:border-[#047857] transition-all" />
                                    <span asp-validation-for="RegisterInput.FullName" class="block mt-0.5 text-xs text-red-600 dark:text-red-400 font-mono"></span>
                                </div>

                                <div>
                                    <div class="flex items-center justify-between mb-1">
                                        <label asp-for="RegisterInput.Email" class="block text-xs font-medium text-slate-700 dark:text-slate-300">Email cá nhân</label>
                                        <span class="text-[10px] font-mono text-[#047857] dark:text-[#10B981] font-semibold">(chỉ nhận @@gmail.com)</span>
                                    </div>
                                    <input asp-for="RegisterInput.Email" id="candRegisterEmail" type="email" autocomplete="email" placeholder="ten_ban@gmail.com"
                                           class="w-full px-3.5 py-2 text-sm font-sans rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-900/80 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-[#047857]/20 focus:border-[#047857] transition-all" />
                                    <span asp-validation-for="RegisterInput.Email" class="block mt-0.5 text-xs text-red-600 dark:text-red-400 font-mono"></span>
                                </div>

                                <div>
                                    <label asp-for="RegisterInput.PhoneNumber" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Số điện thoại liên hệ</label>
                                    <input asp-for="RegisterInput.PhoneNumber" id="candRegisterPhone" type="tel" autocomplete="tel" placeholder="0912345678"
                                           class="w-full px-3.5 py-2 text-sm font-sans rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-900/80 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-[#047857]/20 focus:border-[#047857] transition-all" />
                                    <span asp-validation-for="RegisterInput.PhoneNumber" class="block mt-0.5 text-xs text-red-600 dark:text-red-400 font-mono"></span>
                                </div>

                                <div>
                                    <label asp-for="RegisterInput.Password" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Mật khẩu</label>
                                    <input asp-for="RegisterInput.Password" id="candRegisterPassword" type="password" autocomplete="new-password"
                                           class="w-full px-3.5 py-2 text-sm font-sans rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-900/80 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-[#047857]/20 focus:border-[#047857] transition-all" />
                                    <!-- 4-Level Strength Meter for Candidate Register -->
                                    <div class="mt-1 p-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg text-[10px]">
                                        <div class="flex justify-between items-center mb-1 text-[10px] font-mono">
                                            <span class="text-slate-500 dark:text-slate-400">Độ mạnh:</span>
                                            <span id="candRegBadge" class="font-bold text-slate-500">Chưa nhập</span>
                                        </div>
                                        <div class="w-full bg-slate-200 dark:bg-slate-800 h-1 rounded-full overflow-hidden mb-1.5">
                                            <div id="candRegBar" class="h-full w-0 transition-all duration-300"></div>
                                        </div>
                                        <div class="grid grid-cols-2 gap-1 text-[10px] text-slate-500 dark:text-slate-400">
                                            <div id="cr-len" class="flex items-center gap-1"><i class="bi bi-circle"></i> 8+ ký tự</div>
                                            <div id="cr-case" class="flex items-center gap-1"><i class="bi bi-circle"></i> Hoa &amp; Thường</div>
                                            <div id="cr-num" class="flex items-center gap-1"><i class="bi bi-circle"></i> Chữ số (0-9)</div>
                                            <div id="cr-spec" class="flex items-center gap-1"><i class="bi bi-circle"></i> Ký tự đặc biệt</div>
                                        </div>
                                    </div>
                                    <span asp-validation-for="RegisterInput.Password" class="block mt-0.5 text-xs text-red-600 dark:text-red-400 font-mono"></span>
                                </div>

                                <div>
                                    <label asp-for="RegisterInput.ConfirmPassword" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Xác nhận mật khẩu</label>
                                    <input asp-for="RegisterInput.ConfirmPassword" id="candRegisterConfirmPassword" type="password" autocomplete="new-password"
                                           class="w-full px-3.5 py-2 text-sm font-sans rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-900/80 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-[#047857]/20 focus:border-[#047857] transition-all" />
                                    <span asp-validation-for="RegisterInput.ConfirmPassword" class="block mt-0.5 text-xs text-red-600 dark:text-red-400 font-mono"></span>
                                </div>

                                @* Terms & Conditions Checkbox - State Gating *@
                                <div class="pt-0.5">
                                    <label class="flex items-start gap-2.5 cursor-pointer select-none" for="agreeTerms">
                                        <div class="relative flex-shrink-0 mt-0.5">
                                            <input asp-for="RegisterInput.AgreeToTerms"
                                                   type="checkbox"
                                                   id="agreeTerms"
                                                   class="peer sr-only" />
                                            <div id="termsCheckboxVisual"
                                                 class="w-4 h-4 border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 rounded peer-checked:bg-[#047857] peer-checked:border-[#047857] transition-colors flex items-center justify-center">
                                                <svg id="termsCheckIcon" xmlns="http://www.w3.org/2000/svg" class="w-2.5 h-2.5 text-white @(Model.RegisterInput?.AgreeToTerms == true ? "" : "hidden")" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true">
                                                    <path stroke-linecap="square" stroke-linejoin="miter" d="M5 13l4 4L19 7"/>
                                                </svg>
                                            </div>
                                        </div>
                                        <span class="text-xs text-slate-600 dark:text-slate-400 leading-tight">
                                            Tôi đồng ý với
                                            <a href="/terms" target="_blank" class="text-[#047857] dark:text-[#10B981] underline underline-offset-2">Điều khoản dịch vụ</a>
                                            và
                                            <a href="/privacy" target="_blank" class="text-[#047857] dark:text-[#10B981] underline underline-offset-2">Quyền riêng tư</a>.
                                        </span>
                                    </label>
                                    <span asp-validation-for="RegisterInput.AgreeToTerms" class="block mt-0.5 text-xs text-red-600 dark:text-red-400 font-mono"></span>
                                </div>

                                @* Submit — State Gated *@
                                <button type="submit"
                                        id="btnRegisterSubmit"
                                        disabled
                                        class="w-full py-2.5 px-4 bg-[#047857] text-white text-sm font-semibold tracking-wide rounded-lg border border-[#047857] transition-all duration-100 active:translate-y-[1px] opacity-40 cursor-not-allowed pointer-events-none shadow-sm">
                                    Đăng Ký
                                </button>
                                <p id="termsRequiredHint" class="text-[10px] text-slate-400 dark:text-slate-500 text-center">
                                    Bạn cần xác nhận đồng ý với điều khoản để tiếp tục
                                </p>

                                <p class="text-center text-xs text-slate-500 dark:text-slate-400 pt-1">
                                    Đã có tài khoản?
                                    <button type="button" id="btnGoToSignin"
                                            class="font-medium text-[#047857] dark:text-[#10B981] hover:underline underline-offset-2 ml-1">
                                        Đăng nhập ngay &rarr;
                                    </button>
                                </p>

                                @* Subtle Link to Staff Portal *@
                                <div class="mt-6 pt-4 border-t border-slate-200 dark:border-slate-800 text-center">
                                    <p class="text-xs text-slate-500 dark:text-slate-400">
                                        Bạn là cán bộ nhân sự NoveraTech?
                                        <a asp-controller="Account" asp-action="StaffLogin"
                                           class="font-medium text-[#047857] dark:text-[#10B981] hover:underline inline-flex items-center gap-1 ml-1"
                                           title="Chuyển đến Cổng Quản trị & Xác thực dành cho Cán bộ Nhân viên Nội bộ">
                                            Đăng nhập Cổng Nội bộ &rarr;
                                        </a>
                                    </p>
                                </div>
                            </form>
                        </div>

                        @* ═══ BƯỚC 2: XÁC THỰC MÃ OTP ĐĂNG KÝ ═══ *@
                        <div id="signupStepVerify" class="@(isSignupVerifyStep ? "" : "hidden")">
                            <div class="mb-5">
                                <div class="w-9 h-9 rounded-lg border border-emerald-500/30 bg-emerald-500/10 flex items-center justify-center mb-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                    </svg>
                                </div>
                                <h2 class="text-slate-900 dark:text-slate-100 text-2xl font-bold tracking-tight">Xác thực tài khoản</h2>
                                <p class="text-slate-500 dark:text-slate-400 text-xs mt-1.5 leading-relaxed">
                                    Mã OTP 6 chữ số đã được gửi tới email <br/>
                                    <strong id="signupVerifyEmailDisplay" class="text-emerald-600 dark:text-emerald-400 font-semibold break-all">@pendingSignupEmail</strong>.
                                </p>
                            </div>

                            <div id="signupVerifyAlert"
                                 class="mb-4 px-3.5 py-2.5 border border-red-200 dark:border-red-900/60 bg-red-50 dark:bg-red-950/40 text-red-700 dark:text-red-400 text-xs rounded-lg @(isSignupVerifyStep && !Model.IsSuccess && !string.IsNullOrWhiteSpace(Model.StatusMessage) ? "" : "hidden")"
                                 role="alert" aria-live="polite">
                                @(isSignupVerifyStep && !Model.IsSuccess ? Model.StatusMessage : "")
                            </div>

                            <form id="formVerifyRegisterOtp" asp-controller="Account" asp-action="CandidateVerifyRegisterOtp" method="post" novalidate class="space-y-4">
                                @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="VerifyRegisterOtpInput.Email" id="signupVerifyEmailInput" value="@pendingSignupEmail" />
                                <input type="hidden" asp-for="VerifyRegisterOtpInput.ReturnUrl" />
                                <input type="hidden" name="ActivePanel" value="signup" />
                                <input type="hidden" name="OtpStep" value="verify" />

                                <div>
                                    <label asp-for="VerifyRegisterOtpInput.OtpCode" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">
                                        Mã xác thực OTP (6 chữ số)
                                    </label>
                                    <input asp-for="VerifyRegisterOtpInput.OtpCode"
                                           id="signupOtpCodeInput"
                                           type="text"
                                           maxlength="6"
                                           inputmode="numeric"
                                           pattern="[0-9]{6}"
                                           autocomplete="one-time-code"
                                           placeholder="••••••"
                                           class="w-full px-4 py-2.5 border border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-900/80 text-emerald-600 dark:text-emerald-400 text-center font-mono text-2xl font-bold tracking-[0.35em] placeholder-slate-400 dark:placeholder-slate-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#047857]/20 focus:border-[#047857] transition-all" />
                                    <span asp-validation-for="VerifyRegisterOtpInput.OtpCode" id="signupOtpErrorSpan" class="block mt-1 text-xs text-red-600 dark:text-red-400 font-mono"></span>
                                </div>

                                <button type="submit"
                                        id="btnVerifyRegisterSubmit"
                                        class="w-full py-2.5 px-4 bg-[#047857] hover:bg-[#065F46] text-white text-sm font-semibold tracking-wide rounded-lg border border-[#047857] transition-all active:translate-y-[1px] duration-100 shadow-sm">
                                    Xác Nhận & Hoàn Tất
                                </button>

                                <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 pt-1">
                                    <span>Chưa nhận được mã?</span>
                                    <button type="button"
                                            id="btnResendRegisterOtp"
                                            class="text-xs font-medium text-[#047857] dark:text-[#10B981] hover:underline disabled:opacity-40 disabled:cursor-not-allowed disabled:no-underline font-semibold">
                                        Gửi lại mã (<span id="resendRegisterTimer">60</span>s)
                                    </button>
                                </div>

                                <button type="button"
                                        id="btnBackToSignupInput"
                                        class="w-full py-2.5 px-4 border border-slate-200 dark:border-slate-700 bg-transparent text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-50 dark:hover:bg-slate-800/60 text-xs font-semibold rounded-lg transition-all">
                                    &larr; Quay lại chỉnh sửa thông tin
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                @* ─── SLIDE 3: Reset Password ─── *@
                <div id="panelReset"
                     class="w-1/3 flex flex-col justify-center px-6 py-4 lg:px-12 overflow-y-auto"
                     role="region"
                     aria-label="Quên mật khẩu ứng viên"
                     aria-hidden="@(activePanel == "reset" ? "false" : "true")">

                    <div class="w-full max-w-sm mx-auto my-auto py-8">

                        @{
                            var isResetVerifyStep = activePanel == "reset" && Model.OtpStep == "verify";
                            var pendingResetEmail = Model.PendingEmail ?? Model.ResetPasswordOtpInput?.Email ?? Model.ForgotPasswordInput?.Email ?? "";
                        }

                        @* ═══ BƯỚC 1: NHẬP EMAIL YÊU CẦU ĐẶT LẠI ═══ *@
                        <div id="resetStepInput" class="@(isResetVerifyStep ? "hidden" : "")">
                            <div class="mb-5">
                                <a href="/" class="inline-block mb-3 group cursor-pointer" title="Quay lại Trang chủ NoveraTech">
                                    <img src="~/img/logo-dark-transparent.png"
                                         alt="NoveraTech Careers"
                                         class="h-7 object-contain logo-brand-invert transition-opacity group-hover:opacity-85" />
                                </a>
                                <h2 class="text-slate-900 dark:text-slate-100 text-2xl font-bold tracking-tight">Khôi phục mật khẩu</h2>
                                <p class="text-slate-500 dark:text-slate-400 text-xs mt-1.5 leading-relaxed">Nhập email đã đăng ký để nhận mã OTP xác thực đặt lại mật khẩu an toàn.</p>
                            </div>

                            <div id="resetInputAlert"
                                 class="mb-4 px-3.5 py-2.5 border border-red-200 dark:border-red-900/60 bg-red-50 dark:bg-red-950/40 text-red-700 dark:text-red-400 text-xs rounded-lg @(activePanel == "reset" && !isResetVerifyStep && !Model.IsSuccess && !string.IsNullOrWhiteSpace(Model.StatusMessage) ? "" : "hidden")"
                                 role="alert" aria-live="polite">
                                @(activePanel == "reset" && !isResetVerifyStep && !Model.IsSuccess ? Model.StatusMessage : "")
                            </div>

                            <form id="formCandidateForgotPassword" asp-controller="Account" asp-action="CandidateForgotPassword" method="post" novalidate class="space-y-4">
                                @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="ForgotPasswordInput.ReturnUrl" />
                                <input type="hidden" name="ActivePanel" value="reset" />

                                <div>
                                    <label asp-for="ForgotPasswordInput.Email" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">Địa chỉ email</label>
                                    <input asp-for="ForgotPasswordInput.Email" id="candForgotEmail" type="email" autocomplete="email" placeholder="your@email.com"
                                           class="w-full px-3.5 py-2.5 text-sm font-sans rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-900/80 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-[#047857]/20 focus:border-[#047857] transition-all" />
                                    <span asp-validation-for="ForgotPasswordInput.Email" class="block mt-1 text-xs text-red-600 dark:text-red-400 font-mono"></span>
                                </div>

                                <button type="submit"
                                        id="btnForgotSubmit"
                                        class="w-full py-2.5 px-4 bg-[#047857] hover:bg-[#065F46] text-white text-sm font-semibold tracking-wide rounded-lg border border-[#047857] transition-all active:translate-y-[1px] duration-100 shadow-sm">
                                    Gửi Mã Xác Thực OTP
                                </button>

                                <button type="button" id="btnResetBackToSignin"
                                        class="w-full py-2.5 px-4 border border-slate-200 dark:border-slate-700 bg-transparent text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-50 dark:hover:bg-slate-800/60 text-xs font-semibold rounded-lg transition-all">
                                    &larr; Quay lại Đăng nhập
                                </button>

                                @* Switcher to Staff Portal *@
                                <div class="mt-8 pt-5 border-t border-slate-200 dark:border-slate-800 text-center">
                                    <p class="text-xs text-slate-500 dark:text-slate-400">
                                        Bạn là cán bộ nhân sự NoveraTech?
                                        <a asp-controller="Account" asp-action="StaffLogin"
                                           class="font-medium text-[#047857] dark:text-[#10B981] hover:underline inline-flex items-center gap-1 ml-1">
                                            Đăng nhập Cổng Nội bộ &rarr;
                                        </a>
                                    </p>
                                </div>
                            </form>
                        </div>

                        @* ═══ BƯỚC 2: NHẬP OTP VÀ ĐẶT LẠI MẬT KHẨU MỚI ═══ *@
                        <div id="resetStepVerify" class="@(isResetVerifyStep ? "" : "hidden")">
                            <div class="mb-5">
                                <div class="w-9 h-9 rounded-lg border border-emerald-500/30 bg-emerald-500/10 flex items-center justify-center mb-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                                    </svg>
                                </div>
                                <h2 class="text-slate-900 dark:text-slate-100 text-2xl font-bold tracking-tight">Đặt lại mật khẩu</h2>
                                <p class="text-slate-500 dark:text-slate-400 text-xs mt-1.5 leading-relaxed">
                                    Nhập mã OTP đã được gửi đến <strong id="resetVerifyEmailDisplay" class="text-emerald-600 dark:text-emerald-400 font-semibold break-all">@pendingResetEmail</strong> và tạo mật khẩu mới.
                                </p>
                            </div>

                            <div id="resetVerifyAlert"
                                 class="mb-4 px-3.5 py-2.5 border border-red-200 dark:border-red-900/60 bg-red-50 dark:bg-red-950/40 text-red-700 dark:text-red-400 text-xs rounded-lg @(isResetVerifyStep && !Model.IsSuccess && !string.IsNullOrWhiteSpace(Model.StatusMessage) ? "" : "hidden")"
                                 role="alert" aria-live="polite">
                                @(isResetVerifyStep && !Model.IsSuccess ? Model.StatusMessage : "")
                            </div>

                            <form id="formResetPasswordWithOtp" asp-controller="Account" asp-action="CandidateResetPasswordWithOtp" method="post" novalidate class="space-y-3">
                                @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="ResetPasswordOtpInput.Email" id="resetVerifyEmailInput" value="@pendingResetEmail" />
                                <input type="hidden" asp-for="ResetPasswordOtpInput.ReturnUrl" />
                                <input type="hidden" name="ActivePanel" value="reset" />
                                <input type="hidden" name="OtpStep" value="verify" />

                                <div>
                                    <label asp-for="ResetPasswordOtpInput.OtpCode" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">
                                        Mã xác thực OTP (6 chữ số)
                                    </label>
                                    <input asp-for="ResetPasswordOtpInput.OtpCode"
                                           id="resetOtpCodeInput"
                                           type="text"
                                           maxlength="6"
                                           inputmode="numeric"
                                           pattern="[0-9]{6}"
                                           autocomplete="one-time-code"
                                           placeholder="••••••"
                                           class="w-full px-3.5 py-2 border border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-900/80 text-emerald-600 dark:text-emerald-400 text-center font-mono text-2xl font-bold tracking-[0.3em] placeholder-slate-400 dark:placeholder-slate-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#047857]/20 focus:border-[#047857] transition-all" />
                                    <span asp-validation-for="ResetPasswordOtpInput.OtpCode" id="resetOtpErrorSpan" class="block mt-0.5 text-xs text-red-600 dark:text-red-400 font-mono"></span>
                                </div>

                                <div>
                                    <label asp-for="ResetPasswordOtpInput.NewPassword" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Mật khẩu mới</label>
                                    <input asp-for="ResetPasswordOtpInput.NewPassword" id="candResetNewPassword" type="password" autocomplete="new-password"
                                           class="w-full px-3.5 py-2 text-sm font-sans rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-900/80 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-[#047857]/20 focus:border-[#047857] transition-all" />
                                    <!-- 4-Level Strength Meter for Candidate Reset -->
                                    <div class="mt-1 p-2 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg">
                                        <div class="flex justify-between items-center mb-1 text-[10px] font-mono">
                                            <span class="text-slate-500 dark:text-slate-400">Độ mạnh mật khẩu:</span>
                                            <span id="candResetBadge" class="font-bold text-slate-500">Chưa nhập</span>
                                        </div>
                                        <div class="w-full bg-slate-200 dark:bg-slate-800 h-1 rounded-full overflow-hidden mb-1.5">
                                            <div id="candResetBar" class="h-full w-0 transition-all duration-300"></div>
                                        </div>
                                        <div class="grid grid-cols-2 gap-1 text-[10px] text-slate-500 dark:text-slate-400">
                                            <div id="crst-len" class="flex items-center gap-1"><i class="bi bi-circle"></i> 8+ ký tự</div>
                                            <div id="crst-case" class="flex items-center gap-1"><i class="bi bi-circle"></i> Hoa &amp; Thường</div>
                                            <div id="crst-num" class="flex items-center gap-1"><i class="bi bi-circle"></i> Chữ số (0-9)</div>
                                            <div id="crst-spec" class="flex items-center gap-1"><i class="bi bi-circle"></i> Ký tự đặc biệt</div>
                                        </div>
                                    </div>
                                    <span asp-validation-for="ResetPasswordOtpInput.NewPassword" class="block mt-0.5 text-xs text-red-600 dark:text-red-400 font-mono"></span>
                                </div>

                                <div>
                                    <label asp-for="ResetPasswordOtpInput.ConfirmNewPassword" class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Xác nhận mật khẩu mới</label>
                                    <input asp-for="ResetPasswordOtpInput.ConfirmNewPassword" id="candResetConfirmPassword" type="password" autocomplete="new-password"
                                           class="w-full px-3.5 py-2 text-sm font-sans rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-900/80 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-[#047857]/20 focus:border-[#047857] transition-all" />
                                    <span asp-validation-for="ResetPasswordOtpInput.ConfirmNewPassword" class="block mt-0.5 text-xs text-red-600 dark:text-red-400 font-mono"></span>
                                </div>

                                <button type="submit"
                                        id="btnResetPasswordSubmit"
                                        class="w-full py-2.5 px-4 bg-[#047857] hover:bg-[#065F46] text-white text-sm font-semibold tracking-wide rounded-lg border border-[#047857] transition-colors active:translate-y-[1px] duration-100 shadow-sm">
                                    Xác Nhận Đổi Mật Khẩu
                                </button>

                                <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 pt-1">
                                    <span>Chưa nhận được mã?</span>
                                    <button type="button"
                                            id="btnResendResetOtp"
                                            class="text-xs font-medium text-[#047857] dark:text-[#10B981] hover:underline disabled:opacity-40 disabled:cursor-not-allowed disabled:no-underline font-semibold">
                                        Gửi lại mã (<span id="resendResetTimer">60</span>s)
                                    </button>
                                </div>

                                <button type="button"
                                        id="btnBackToResetInput"
                                        class="w-full py-2.5 px-4 border border-slate-200 dark:border-slate-700 bg-transparent text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-50 dark:hover:bg-slate-800/60 text-xs font-semibold rounded-lg transition-all">
                                    &larr; Quay lại nhập email khác
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>@* end sliderTrack *@
        </div>

        @* Footer Watermark *@
        <div class="px-6 py-3 shrink-0 border-t border-slate-200 dark:border-slate-800/80 text-center">
            <p class="text-[11px] text-slate-400 dark:text-slate-500 font-normal">
                &copy; @DateTime.Now.Year NoveraTech Corporation &middot; Cổng Tuyển Dụng Ứng Viên
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            'use strict';

            var track = document.getElementById('candSliderTrack');
            if (!track) return;

            var panels = {
                signin: document.getElementById('panelSignin'),
                signup: document.getElementById('panelSignup'),
                reset:  document.getElementById('panelReset')
            };

            // translateX per panel (3 panels = 33.333% each in 300% track)
            var translateMap = {
                signin: '0%',
                signup: '-33.333%',
                reset:  '-66.666%'
            };

            // ─── Set Panel ────────────────────────────────────────────────────
            function setPanel(name) {
                if (!translateMap[name]) name = 'signin';
                track.style.transform = 'translateX(' + translateMap[name] + ')';

                Object.keys(panels).forEach(function (key) {
                    var panel = panels[key];
                    var isActive = (key === name);
                    panel.setAttribute('aria-hidden', isActive ? 'false' : 'true');
                    setTabIndex(panel, isActive ? '0' : '-1');
                });

                var firstInput = panels[name] && panels[name].querySelector('input:not([type="hidden"]):not([type="checkbox"])');
                if (firstInput) setTimeout(function () { firstInput.focus(); }, 420);
            }

            function setTabIndex(panel, val) {
                var focusables = panel.querySelectorAll('input, button, a, select, textarea');
                for (var i = 0; i < focusables.length; i++) {
                    focusables[i].setAttribute('tabindex', val);
                }
            }

            // ─── Hash Sync ────────────────────────────────────────────────────
            function readHash() {
                var h = window.location.hash;
                if (h === '#signup') return 'signup';
                if (h === '#reset') return 'reset';
                return 'signin';
            }
            window.addEventListener('hashchange', function () { setPanel(readHash()); });

            // ─── Nav Buttons ──────────────────────────────────────────────────
            function navTo(panel) {
                window.location.hash = '#' + panel;
                setPanel(panel);
            }

            ['btnGoToSignup1'].forEach(function (id) {
                var btn = document.getElementById(id);
                if (btn) btn.addEventListener('click', function () { navTo('signup'); });
            });

            var btnGoToReset = document.getElementById('btnGoToReset');
            if (btnGoToReset) btnGoToReset.addEventListener('click', function () { navTo('reset'); });

            var btnGoToSignin = document.getElementById('btnGoToSignin');
            if (btnGoToSignin) btnGoToSignin.addEventListener('click', function () { navTo('signin'); });

            var btnResetBack = document.getElementById('btnResetBackToSignin');
            if (btnResetBack) btnResetBack.addEventListener('click', function () { navTo('signin'); });

            // ─── Eye Toggle ───────────────────────────────────────────────────
            var eyeToggle = document.getElementById('candEyeToggle');
            var passInput = document.getElementById('candPasswordInput');
            var eyeOpen = document.getElementById('candEyeOpen');
            var eyeClosed = document.getElementById('candEyeClosed');
            if (eyeToggle && passInput) {
                eyeToggle.addEventListener('click', function () {
                    var isPass = passInput.type === 'password';
                    passInput.type = isPass ? 'text' : 'password';
                    eyeToggle.setAttribute('aria-pressed', isPass ? 'true' : 'false');
                    if (eyeOpen) eyeOpen.classList.toggle('hidden', !isPass);
                    if (eyeClosed) eyeClosed.classList.toggle('hidden', isPass);
                });
            }

            // ─── STATE GATING: Terms Checkbox -> Submit Button ────────────────
            var agreeCheckbox = document.getElementById('agreeTerms');
            var submitBtn = document.getElementById('btnRegisterSubmit');
            var termsHint = document.getElementById('termsRequiredHint');
            var termsCheckIcon = document.getElementById('termsCheckIcon');

            function syncTermsUI(agreed) {
                if (submitBtn) {
                    if (agreed) {
                        submitBtn.removeAttribute('disabled');
                        submitBtn.classList.remove('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
                    } else {
                        submitBtn.setAttribute('disabled', 'disabled');
                        submitBtn.classList.add('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
                    }
                }
                if (termsHint) {
                    if (agreed) termsHint.classList.add('opacity-0');
                    else termsHint.classList.remove('opacity-0');
                }
                if (termsCheckIcon) {
                    termsCheckIcon.classList.toggle('hidden', !agreed);
                }
            }

            if (agreeCheckbox) {
                agreeCheckbox.addEventListener('change', function () {
                    syncTermsUI(this.checked);
                });
                syncTermsUI(agreeCheckbox.checked);
            }

            // ─── OTP Helpers & Countdown Timers ───────────────────────────────
            var resendTimers = {};
            function startCountdown(timerId, btnId, seconds) {
                if (resendTimers[timerId]) clearInterval(resendTimers[timerId]);
                var timeLeft = seconds;
                var btn = document.getElementById(btnId);
                var timerSpan = document.getElementById(timerId);
                if (!btn || !timerSpan) return;

                btn.disabled = true;
                timerSpan.textContent = timeLeft;

                resendTimers[timerId] = setInterval(function () {
                    timeLeft--;
                    if (timeLeft <= 0) {
                        clearInterval(resendTimers[timerId]);
                        btn.disabled = false;
                        btn.innerHTML = 'Gửi lại mã OTP';
                    } else {
                        timerSpan.textContent = timeLeft;
                    }
                }, 1000);
            }

            function setupOtpInput(inputId) {
                var el = document.getElementById(inputId);
                if (!el) return;
                el.addEventListener('input', function () {
                    this.value = this.value.replace(/[^0-9]/g, '').slice(0, 6);
                });
                el.addEventListener('paste', function (e) {
                    var paste = (e.clipboardData || window.clipboardData).getData('text');
                    if (paste) {
                        e.preventDefault();
                        this.value = paste.replace(/[^0-9]/g, '').slice(0, 6);
                    }
                });
            }
            setupOtpInput('signupOtpCodeInput');
            setupOtpInput('resetOtpCodeInput');

            function setBtnLoading(btn, isLoading, loadingText, defaultText) {
                if (!btn) return;
                if (isLoading) {
                    btn.disabled = true;
                    btn.dataset.originalText = btn.innerHTML;
                    btn.innerHTML = '<span class="inline-flex items-center justify-center gap-2"><svg class="animate-spin h-4 w-4" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>' + loadingText + '</span>';
                } else {
                    btn.disabled = false;
                    btn.innerHTML = defaultText || btn.dataset.originalText || 'Xác nhận';
                }
            }

            function showSigninSuccess(msg) {
                var el = document.getElementById('signinDynamicSuccess');
                if (el) {
                    el.textContent = msg;
