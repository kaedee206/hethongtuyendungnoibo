            // ─── Realtime 4-Level Password Strength Evaluator Helper ──────────
            function bindStrengthMeter(inputId, barId, badgeId, lenId, caseId, numId, specId) {
                var input = document.getElementById(inputId);
                var bar = document.getElementById(barId);
                var badge = document.getElementById(badgeId);
                var elLen = document.getElementById(lenId);
                var elCase = document.getElementById(caseId);
                var elNum = document.getElementById(numId);
                var elSpec = document.getElementById(specId);

                if (!input || !bar || !badge) return;

                function updateRule(elem, ok) {
                    if (!elem) return;
                    var icon = elem.querySelector('i');
                    if (ok) {
                        elem.className = 'flex items-center gap-1 text-emerald-600 font-medium';
                        if (icon) icon.className = 'bi bi-check-circle-fill text-emerald-600';
                    } else {
                        elem.className = 'flex items-center gap-1 text-[#64748B] dark:text-[#94A3B8]';
                        if (icon) icon.className = 'bi bi-circle';
                    }
                }

                input.addEventListener('input', function() {
                    var val = this.value || '';
                    if (!val) {
                        bar.style.width = '0%';
                        bar.style.backgroundColor = '#E2E8F0';
                        badge.textContent = 'Chưa nhập';
                        badge.style.color = '#64748B';
                        [elLen, elCase, elNum, elSpec].forEach(function(e) { updateRule(e, false); });
                        return;
                    }

                    var hasLen = val.length >= 8;
                    var hasCase = /[a-z]/.test(val) && /[A-Z]/.test(val);
                    var hasNum = /[0-9]/.test(val);
                    var hasSpec = /[@@$!%*?&_\-#]/.test(val);

                    updateRule(elLen, hasLen);
                    updateRule(elCase, hasCase);
                    updateRule(elNum, hasNum);
                    updateRule(elSpec, hasSpec);

                    var score = 0;
                    if (hasLen) score++;
                    if (hasCase) score++;
                    if (hasNum) score++;
                    if (hasSpec) score++;

                    if (score <= 1) {
                        bar.style.width = '25%';
                        bar.style.backgroundColor = '#EF4444';
                        badge.textContent = 'Yếu';
                        badge.style.color = '#EF4444';
                    } else if (score === 2) {
                        bar.style.width = '50%';
                        bar.style.backgroundColor = '#F59E0B';
                        badge.textContent = 'Vừa';
                        badge.style.color = '#F59E0B';
                    } else if (score === 3) {
                        bar.style.width = '75%';
                        bar.style.backgroundColor = '#10B981';
                        badge.textContent = 'Mạnh';
                        badge.style.color = '#10B981';
                    } else {
                        bar.style.width = '100%';
                        bar.style.backgroundColor = '#047857';
                        badge.textContent = 'Siêu mạnh';
                        badge.style.color = '#047857';
                    }
                });
            }

            bindStrengthMeter('candRegisterPassword', 'candRegBar', 'candRegBadge', 'cr-len', 'cr-case', 'cr-num', 'cr-spec');
            bindStrengthMeter('candResetNewPassword', 'candResetBar', 'candResetBadge', 'crst-len', 'crst-case', 'crst-num', 'crst-spec');

        })();
    </script>
}
