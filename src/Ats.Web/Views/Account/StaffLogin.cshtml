@model StaffAuthCompositeViewModel
@{
    ViewData["Title"] = "Đăng nhập Nội bộ";
    Layout = "_AuthLayout";
    var activePanel = Model.ActivePanel ?? ViewData["ActivePanel"]?.ToString() ?? "login";
}

@*
    S1-01: Cổng Nhân sự Nội bộ - Internal Staff Portal
    Clean Modern Enterprise Design (No AI Slop / De-bloated)
    Sliding Panel: Login <-> Forgot Password, đồng bộ URL hash
*@

<section
    class="h-screen w-full flex flex-col lg:flex-row overflow-hidden"
    aria-label="Cổng Đăng nhập Nhân sự Nội bộ NoveraTech">

    @* ─────────────────────────────────────────────────────────────
       PANEL TRÁI: Architectural Ambient Visual & Genuine Enterprise Anchor
       (Loại bỏ hoàn toàn dot-grid và gradient xanh đục - Giữ chiều sâu thực tế)
    ───────────────────────────────────────────────────────────── *@
    <div class="hidden lg:flex lg:w-1/2 relative flex-col justify-between h-full overflow-hidden bg-slate-950"
         aria-hidden="true">

        @* Background Architectural Visual *@
        <div class="absolute inset-0 z-0 bg-cover bg-center transition-transform duration-700 scale-100 hover:scale-[1.01]"
             style="background-image: url('/img/noveratech_office_focus.jpg');">
            @* Neutral dark gradient wash: High contrast & natural office illumination *@
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/75 to-slate-950/40 backdrop-blur-[1px]"></div>
        </div>

        @* Header Brand - Link về Landing Page *@
        <div class="relative z-10 p-10 lg:p-12">
            <a href="/" class="inline-flex items-center gap-3 text-decoration-none group cursor-pointer" title="Quay lại Trang chủ NoveraTech">
                <div class="w-9 h-9 flex items-center justify-center rounded-lg bg-white/10 border border-white/15 backdrop-blur-md group-hover:border-emerald-500/50 group-hover:bg-emerald-500/15 transition-all duration-200">
                    <img src="~/img/logo-icon-dark-transparent.png"
                         alt="NoveraTech"
                         class="w-5 h-5 object-contain brightness-0 invert" />
                </div>
                <div>
                    <span class="block font-sans font-bold text-sm tracking-wider uppercase text-white leading-tight">
                        NOVERATECH
                    </span>
                    <span class="block font-sans text-[11px] text-slate-300 font-normal leading-none mt-0.5">
                        Hệ thống Tuyển dụng Doanh nghiệp
                    </span>
                </div>
            </a>
        </div>

        @* Center Headline (Súc tích, trang trọng, không từ ngữ tiếp thị sáo rỗng) *@
        <div class="relative z-10 px-10 lg:px-12 my-auto max-w-xl">
            <div class="mb-4">
                <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400 font-mono">
                    Staff Workspace &middot; Quản trị Tuyển dụng
                </span>
            </div>

            <h1 class="text-3xl lg:text-4xl font-bold text-white tracking-tight leading-[1.2]">
                Không Gian Tác Nghiệp & Điều Phối Tuyển Dụng
            </h1>

            <p class="mt-4 text-sm text-slate-300 leading-relaxed max-w-md font-normal">
                Hệ thống điều phối tập trung dành cho Ban Lãnh đạo, Hội đồng Phỏng vấn và Bộ phận Nhân sự NoveraTech.
            </p>
        </div>

        @* Bottom Status & Real Enterprise Utility (Thay thế thẻ RBAC giả lập) *@
        <div class="relative z-10 p-10 lg:p-12 border-t border-white/10 bg-slate-950/40 backdrop-blur-md">
            <div class="flex items-center justify-between text-xs text-slate-400">
                <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                    <span class="text-slate-300 font-medium">Bảo mật định danh đa lớp &middot; Authelia SSO</span>
                </div>
                <div class="text-[11px] text-slate-400">
                    Hỗ trợ IT: <a href="mailto:it.support@noveratech.digital" class="text-emerald-400 hover:underline font-mono">it.support@noveratech.digital</a>
                </div>
            </div>
        </div>
    </div>

    @* ─────────────────────────────────────────────────────────────
       PANEL PHẢI: Auth Sliding Container (100% mobile, 50% desktop)
    ───────────────────────────────────────────────────────────── *@
    <div class="w-full lg:w-1/2 flex flex-col h-full overflow-hidden bg-white dark:bg-[#0B0F17] transition-colors duration-200">

        @* Mobile Brand Header (visible only on mobile) *@
        <div class="lg:hidden flex items-center justify-between px-6 py-4 border-b border-slate-200 dark:border-slate-800 flex-shrink-0">
            <a href="/" title="Quay lại Cổng Tuyển dụng NoveraTech" class="flex items-center gap-2.5">
                <img src="~/img/logo-icon-dark-transparent.png"
                     alt="NoveraTech"
                     class="h-6 w-6 object-contain dark:brightness-0 dark:invert" />
                <span class="font-bold text-sm text-slate-900 dark:text-white uppercase tracking-wider">NOVERATECH</span>
            </a>
            <a href="/" class="text-xs font-semibold text-[#047857] dark:text-[#10B981] hover:underline" title="Quay lại Trang chủ">
                <span>Cổng Tuyển dụng &rarr;</span>
            </a>
        </div>

        @* Sliding Panels Viewport *@
        <div class="flex-1 flex flex-col overflow-hidden relative">
            @* Sliding track wrapper *@
            <div id="staffSliderTrack"
                 class="flex w-[200%] h-full transition-transform duration-[350ms] ease-out"
                 style="transform: translateX(@(activePanel == "forgot" ? "-50%" : "0%"));"
                 data-active-panel="@activePanel">

                @* ─── SLIDE 1: Login ─── *@
                <div id="panelLogin"
                     class="w-1/2 flex flex-col justify-center px-6 sm:px-12 lg:px-16 overflow-y-auto"
                     role="region"
                     aria-label="Đăng nhập nhân sự"
                     aria-hidden="@(activePanel == "forgot" ? "true" : "false")">

                    <div class="w-full max-w-sm mx-auto my-auto py-8">
                        @* Panel Header *@
                        <div class="mb-6">
                            <a href="/" class="inline-block mb-3 group cursor-pointer" title="Quay lại Cổng Tuyển dụng NoveraTech">
                                <img src="~/img/logo-dark-transparent.png"
                                     alt="NoveraTech Careers"
                                     class="h-7 object-contain logo-brand-invert transition-opacity group-hover:opacity-85" />
                            </a>
                            <h2 class="text-slate-900 dark:text-slate-100 text-2xl font-bold tracking-tight">
                                Đăng nhập Quản trị Nội bộ
                            </h2>
                            <p class="text-slate-500 dark:text-slate-400 text-xs mt-1.5 leading-relaxed">
                                Dành riêng cho Hội đồng Tuyển dụng và Cán bộ Nhân sự NoveraTech.
                            </p>
                        </div>

                        @* Validation Summary (Model-level errors only when present) *@
                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.TryGetValue(string.Empty, out var loginErrors) && loginErrors.Errors.Count > 0)
                        {
                            <div asp-validation-summary="ModelOnly"
                                 class="mb-4 px-3.5 py-2.5 border border-red-200 dark:border-red-900/60 bg-red-50 dark:bg-red-950/40 text-red-700 dark:text-red-400 text-xs rounded-lg"
                                 role="alert"
                                 aria-live="polite"></div>
                        }

                        @* Quick SSO Button (Prominent, clean, zero pulsing gimmick) *@
                        <div class="mb-5">
                            <a href="/Account/ExternalLogin?provider=NoveraOidcScheme&userType=staff&returnUrl=@Model.LoginInput.ReturnUrl"
                               tabindex="@(activePanel == "forgot" ? "-1" : "0")"
                               class="flex items-center justify-center gap-2.5 w-full py-2.5 px-4 rounded-lg border border-slate-200 dark:border-slate-700/80 bg-slate-50 dark:bg-slate-900 text-slate-700 dark:text-slate-200 text-xs font-semibold hover:bg-slate-100 dark:hover:bg-slate-800 hover:border-slate-300 dark:hover:border-slate-600 transition-all shadow-sm">
                                <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                                </svg>
                                <span>Đăng nhập nhanh với NoveraTech SSO</span>
                            </a>
                        </div>

                        @* Natural Divider *@
                        <div class="flex items-center gap-3 mb-5">
                            <div class="flex-1 h-px bg-slate-200 dark:bg-slate-800"></div>
                            <span class="text-[11px] font-medium text-slate-400 dark:text-slate-500">
                                hoặc sử dụng mật khẩu
                            </span>
                            <div class="flex-1 h-px bg-slate-200 dark:bg-slate-800"></div>
                        </div>

                        @* Login Form *@
                        <form asp-controller="Account"
                              asp-action="StaffLogin"
                              method="post"
                              novalidate
                              autocomplete="on"
                              class="space-y-4">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="LoginInput.ReturnUrl" />
                            <input type="hidden" name="ActivePanel" value="login" />

                            @* Email Field (Standard Inter font, no aggressive uppercase tracking) *@
                            <div>
                                <label asp-for="LoginInput.Email"
                                       class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">
                                    Email công ty
                                </label>
                                <div class="relative">
                                    <input asp-for="LoginInput.Email"
                                           type="email"
                                           autocomplete="username"
                                           autofocus
                                           placeholder="user@noveratech.digital"
                                           tabindex="@(activePanel == "forgot" ? "-1" : "0")"
                                           class="w-full px-3.5 py-2.5 text-sm font-sans rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-900/80 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-[#047857]/20 focus:border-[#047857] transition-all" />
                                </div>
                                <span asp-validation-for="LoginInput.Email"
                                      class="block mt-1 text-xs text-red-600 dark:text-red-400 font-mono"></span>
                            </div>

                            @* Password Field with Eye Toggle *@
                            <div>
                                <div class="flex items-center justify-between mb-1.5">
                                    <label asp-for="LoginInput.Password"
                                           class="block text-xs font-medium text-slate-700 dark:text-slate-300">
                                        Mật khẩu
                                    </label>
                                    <button type="button"
                                            id="btnGoToForgot"
                                            tabindex="@(activePanel == "forgot" ? "-1" : "0")"
                                            class="text-xs font-medium text-[#047857] dark:text-[#10B981] hover:underline underline-offset-2 transition-colors">
                                        Quên mật khẩu?
                                    </button>
                                </div>
                                <div class="relative">
                                    <input asp-for="LoginInput.Password"
                                           type="password"
                                           id="staffPasswordInput"
                                           autocomplete="current-password"
                                           placeholder="••••••••••••"
                                           tabindex="@(activePanel == "forgot" ? "-1" : "0")"
                                           class="w-full px-3.5 py-2.5 pr-10 text-sm font-sans rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-900/80 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-[#047857]/20 focus:border-[#047857] transition-all" />
                                    <button type="button"
                                            id="staffEyeToggle"
                                            aria-label="Hiện hoặc ẩn mật khẩu"
                                            aria-pressed="false"
                                            tabindex="@(activePanel == "forgot" ? "-1" : "0")"
                                            class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1 transition-colors">
                                        @* Eye icon (password visible) *@
                                        <svg id="staffEyeOpen" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                        </svg>
                                        @* Eye-off icon (password hidden) *@
                                        <svg id="staffEyeClosed" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                                        </svg>
                                    </button>
                                </div>
                                <span asp-validation-for="LoginInput.Password"
                                      class="block mt-1 text-xs text-red-600 dark:text-red-400 font-mono"></span>
                            </div>

                            @* Remember Me Checkbox *@
                            <div class="flex items-center justify-between pt-0.5">
                                <label class="flex items-center gap-2 cursor-pointer select-none group">
                                    <div class="relative">
                                        <input asp-for="LoginInput.RememberMe"
                                               type="checkbox"
                                               tabindex="@(activePanel == "forgot" ? "-1" : "0")"
                                               class="peer sr-only" />
                                        <div class="w-4 h-4 border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 rounded peer-checked:bg-[#047857] peer-checked:border-[#047857] transition-all flex items-center justify-center">
                                            <svg class="w-2.5 h-2.5 text-white opacity-0 peer-checked:opacity-100" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                                            </svg>
                                        </div>
                                    </div>
                                    <span class="text-xs text-slate-600 dark:text-slate-400">Ghi nhớ thiết bị này trong 30 ngày</span>
                                </label>
                            </div>

                            @* Submit Button (Bo góc 8px rounded-lg, màu #047857 WCAG AA) *@
                            <button type="submit"
                                    tabindex="@(activePanel == "forgot" ? "-1" : "0")"
                                    class="w-full py-2.5 px-4 bg-[#047857] hover:bg-[#065F46] text-white text-sm font-semibold tracking-wide rounded-lg border border-[#047857] hover:border-[#065F46] transition-all active:translate-y-[1px] duration-100 flex items-center justify-center gap-2 shadow-sm">
                                <span>Đăng Nhập Cổng Nội Bộ</span>
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                                </svg>
                            </button>

                            @* Subtle Candidate Link (Clean text link, not an overwhelming bulky card) *@
                            <div class="mt-8 pt-5 border-t border-slate-200 dark:border-slate-800 text-center">
                                <p class="text-xs text-slate-500 dark:text-slate-400">
                                    Bạn là ứng viên tuyển dụng?
                                    <a asp-controller="Account" asp-action="CandidateAuth"
                                       tabindex="@(activePanel == "forgot" ? "-1" : "0")"
                                       class="font-medium text-[#047857] dark:text-[#10B981] hover:underline inline-flex items-center gap-1 ml-1"
                                       title="Chuyển đến Cổng Tuyển dụng dành cho Ứng viên">
                                        Cổng nộp hồ sơ &amp; tra cứu &rarr;
                                    </a>
                                </p>
                            </div>
                        </form>
                    </div>
                </div>

                @* ─── SLIDE 2: Forgot Password ─── *@
                <div id="panelForgot"
                     class="w-1/2 flex flex-col justify-center px-6 sm:px-12 lg:px-16 overflow-y-auto"
                     role="region"
                     aria-label="Quên mật khẩu"
                     aria-hidden="@(activePanel == "forgot" ? "false" : "true")">

                    <div class="w-full max-w-sm mx-auto my-auto py-8">
                        @* Panel Header *@
                        <div class="mb-6">
                            <a href="/" class="inline-block mb-3 group cursor-pointer" title="Quay lại Cổng Tuyển dụng NoveraTech">
                                <img src="~/img/logo-dark-transparent.png"
                                     alt="NoveraTech Careers"
                                     class="h-7 object-contain logo-brand-invert transition-opacity group-hover:opacity-85" />
                            </a>
                            <h2 class="text-slate-900 dark:text-slate-100 text-2xl font-bold tracking-tight">
                                Khôi phục Mật khẩu
                            </h2>
                            <p class="text-slate-500 dark:text-slate-400 text-xs mt-1.5 leading-relaxed">
                                Nhập email doanh nghiệp để nhận liên kết xác thực đặt lại mật khẩu an toàn.
                            </p>
                        </div>

                        @* Forgot Form Validation Summary *@
                        @if (ViewData["ForgotError"] != null && !string.IsNullOrWhiteSpace(ViewData["ForgotError"]?.ToString()))
                        {
                            <div class="mb-4 px-3.5 py-2.5 border border-red-200 dark:border-red-900/60 bg-red-50 dark:bg-red-950/40 text-red-700 dark:text-red-400 text-xs rounded-lg"
                                 role="alert"
                                 aria-live="polite">
                                @ViewData["ForgotError"]
                            </div>
                        }

                        @if (Model.ActivePanel == "forgot" && Model.IsSuccess)
                        {
                            <div class="mb-4 px-3.5 py-2.5 border border-emerald-300 dark:border-emerald-800 bg-[#ECFDF5] text-[#047857] dark:text-[#10B981] text-xs rounded-lg" role="status">
                                @(Model.StatusMessage ?? "Nếu email tổ chức tồn tại trong hệ thống, liên kết đặt lại mật khẩu đã được gửi đến hộp thư của bạn.")
                            </div>
                        }

                        <form asp-controller="Account"
                              asp-action="StaffForgotPassword"
                              method="post"
                              novalidate
                              class="space-y-4">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="ForgotPasswordInput.ReturnUrl" />
                            <input type="hidden" name="ActivePanel" value="forgot" />

                            @* Forgot Email Field *@
                            <div>
                                <label asp-for="ForgotPasswordInput.Email"
                                       class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5">
                                    Email công ty
                                </label>
                                <input asp-for="ForgotPasswordInput.Email"
                                       type="email"
                                       autocomplete="email"
                                       placeholder="user@noveratech.digital"
                                       tabindex="@(activePanel == "forgot" ? "0" : "-1")"
                                       class="w-full px-3.5 py-2.5 text-sm font-sans rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-900/80 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-[#047857]/20 focus:border-[#047857] transition-all" />
                                <span asp-validation-for="ForgotPasswordInput.Email"
                                      class="block mt-1 text-xs text-red-600 dark:text-red-400 font-mono"></span>
                            </div>

                            <button type="submit"
                                    tabindex="@(activePanel == "forgot" ? "0" : "-1")"
                                    class="w-full py-2.5 px-4 bg-[#047857] hover:bg-[#065F46] text-white text-sm font-semibold tracking-wide rounded-lg border border-[#047857] transition-colors active:translate-y-[1px] duration-100">
                                Gửi Liên Kết Xác Thực
                            </button>

                            <button type="button"
                                    id="btnBackToLogin"
                                    tabindex="@(activePanel == "forgot" ? "0" : "-1")"
                                    class="w-full py-2.5 px-4 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-50 dark:hover:bg-slate-800/60 text-xs font-semibold transition-all">
                                &larr; Quay lại Đăng nhập
                            </button>

                            @* Switcher to Candidate Portal *@
                            <div class="mt-8 pt-5 border-t border-slate-200 dark:border-slate-800 text-center">
                                <p class="text-xs text-slate-500 dark:text-slate-400">
                                    Bạn là ứng viên tuyển dụng?
                                    <a asp-controller="Account" asp-action="CandidateAuth"
                                       tabindex="@(activePanel == "forgot" ? "0" : "-1")"
                                       class="font-medium text-[#047857] dark:text-[#10B981] hover:underline inline-flex items-center gap-1 ml-1">
                                        Cổng nộp hồ sơ &amp; tra cứu &rarr;
                                    </a>
                                </p>
                            </div>
                        </form>
                    </div>
                </div>
            </div>@* end sliderTrack *@
        </div>

        @* Footer Watermark *@
        <div class="px-6 py-3 border-t border-slate-200 dark:border-slate-800/80 flex-shrink-0 text-center">
            <p class="text-[11px] text-slate-400 dark:text-slate-500 font-normal">
                &copy; @DateTime.Now.Year NoveraTech Corporation &middot; Cổng Tác Nghiệp Quản Trị Tuyển Dụng
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            'use strict';

            // ─── State Machine ────────────────────────────────────────────────
            var track = document.getElementById('staffSliderTrack');
            var panelLogin = document.getElementById('panelLogin');
            var panelForgot = document.getElementById('panelForgot');
            var btnGoToForgot = document.getElementById('btnGoToForgot');
            var btnBackToLogin = document.getElementById('btnBackToLogin');
            var eyeToggle = document.getElementById('staffEyeToggle');
            var passwordInput = document.getElementById('staffPasswordInput');
            var eyeOpen = document.getElementById('staffEyeOpen');
            var eyeClosed = document.getElementById('staffEyeClosed');

            if (!track) return;

            // ─── Slide Functions ──────────────────────────────────────────────
            function setPanel(panel) {
                if (panel === 'forgot') {
                    track.style.transform = 'translateX(-50%)';
                    panelLogin.setAttribute('aria-hidden', 'true');
                    panelForgot.setAttribute('aria-hidden', 'false');
                    setTabIndex(panelLogin, '-1');
                    setTabIndex(panelForgot, '0');
                    var firstInput = panelForgot.querySelector('input[type="email"]');
                    if (firstInput) setTimeout(function () { firstInput.focus(); }, 350);
                } else {
                    track.style.transform = 'translateX(0%)';
                    panelLogin.setAttribute('aria-hidden', 'false');
                    panelForgot.setAttribute('aria-hidden', 'true');
                    setTabIndex(panelForgot, '-1');
                    setTabIndex(panelLogin, '0');
                    var firstInput = panelLogin.querySelector('input[type="email"]');
                    if (firstInput) setTimeout(function () { firstInput.focus(); }, 350);
                }
            }

            function setTabIndex(panel, val) {
                var focusables = panel.querySelectorAll('input, button, a, select, textarea');
                for (var i = 0; i < focusables.length; i++) {
                    focusables[i].setAttribute('tabindex', val);
                }
            }

            if (btnGoToForgot) {
                btnGoToForgot.addEventListener('click', function () {
                    setPanel('forgot');
                    history.replaceState(null, '', '#forgot');
                });
            }

            if (btnBackToLogin) {
                btnBackToLogin.addEventListener('click', function () {
                    setPanel('login');
                    history.replaceState(null, '', '#login');
                });
            }

            // Sync with URL hash on load
            if (window.location.hash === '#forgot') {
                setPanel('forgot');
            } else if (window.location.hash === '#login') {
                setPanel('login');
            }

            // Eye Toggle
            if (eyeToggle && passwordInput) {
                eyeToggle.addEventListener('click', function () {
                    var isPassword = passwordInput.getAttribute('type') === 'password';
                    passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
                    eyeToggle.setAttribute('aria-pressed', isPassword ? 'true' : 'false');
                    if (eyeOpen && eyeClosed) {
                        eyeOpen.classList.toggle('hidden', !isPassword);
                        eyeOpen.classList.toggle('block', isPassword);
                        eyeClosed.classList.toggle('hidden', isPassword);
                        eyeClosed.classList.toggle('block', !isPassword);
                    }
                });
            }
        })();
    </script>
}
