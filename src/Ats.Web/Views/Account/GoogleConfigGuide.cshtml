@model Ats.Web.Models.ViewModels.Account.GoogleConfigGuideViewModel
@{
    ViewData["Title"] = "Cấu hình Đăng nhập Google (OAuth 2.0) - NoveraTech ATS";
    Layout = "_Layout";
}

<div class="min-h-screen bg-[#F8FAFC] dark:bg-[#0B0F17] py-12 px-4 sm:px-6 lg:px-8 font-sans">
    <div class="max-w-4xl mx-auto">
        @* Header & Navigation *@
        <div class="mb-8 flex items-center justify-between">
            <a href="@(Model.UserType == "staff" ? "/Account/StaffLogin" : "/Account/CandidateAuth")"
               class="inline-flex items-center gap-2 text-sm font-medium text-[#64748B] dark:text-[#94A3B8] hover:text-[#0D5C4D] dark:hover:text-[#10B981] transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                <span>Quay lại trang @(Model.UserType == "staff" ? "Đăng nhập Nhân sự" : "Cổng Ứng viên")</span>
            </a>

            @if (Model.IsConfigured)
            {
                <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 text-xs font-mono font-medium border border-emerald-300 dark:border-emerald-800">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    GOOGLE OAUTH SẴN SÀNG
                </span>
            }
            else
            {
                <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-400 text-xs font-mono font-medium border border-amber-300 dark:border-amber-800">
                    <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                    CHẾ ĐỘ DEV / CHƯA CÓ GOOGLE CLIENT ID
                </span>
            }
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mb-6 p-4 border border-red-300 dark:border-red-800 bg-red-50 dark:bg-red-950/30 text-red-700 dark:text-red-300 text-sm">
                @TempData["ErrorMessage"]
            </div>
        }

        @* Hero Card *@
        <div class="bg-white dark:bg-[#111827] border border-[#E2E8F0] dark:border-[#1E293B] p-6 sm:p-8 mb-8 shadow-sm">
            <div class="flex items-start gap-5">
                <div class="w-12 h-12 flex-shrink-0 flex items-center justify-center border border-[#E2E8F0] dark:border-[#334155] bg-white dark:bg-[#0B0F17]">
                    <svg class="w-6 h-6" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                    </svg>
                </div>
                <div class="flex-1">
                    <h1 class="text-2xl font-bold text-[#0F172A] dark:text-[#F8FAFC]">Cấu hình Single Sign-On với Google</h1>
                    <p class="text-[#64748B] dark:text-[#94A3B8] text-sm mt-1.5 leading-relaxed">
                        Hệ thống NoveraTech ATS hỗ trợ chuẩn xác thực Google OAuth 2.0. Bạn có thể kiểm thử đăng nhập ngay qua công cụ <b>Dev Mock Login</b> bên dưới hoặc thực hiện theo hướng dẫn 4 bước để kết nối trực tiếp với tài khoản Google thật.
                    </p>
                </div>
            </div>

            @* Quick Action Box *@
            <div class="mt-6 pt-6 border-t border-[#E2E8F0] dark:border-[#1E293B] grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="p-4 bg-[#F8FAFC] dark:bg-[#0B0F17] border border-[#E2E8F0] dark:border-[#1E293B]">
                    <span class="block text-xs font-mono uppercase tracking-wider text-[#64748B] dark:text-[#94A3B8] mb-1">
                        1. Dành cho Kiểm thử nhanh (Developer Mode)
                    </span>
                    <p class="text-xs text-[#64748B] dark:text-[#94A3B8] mb-3">
                        Kiểm tra luồng tạo ứng viên tự động và cấp phiên đăng nhập mà không cần chờ cấu hình Google Cloud API.
                    </p>
                    <a href="#devQuickLoginSection" class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#0D5C4D] dark:text-[#10B981] hover:underline">
                        <span>Chuyển tới Form Đăng nhập Thử nghiệm &darr;</span>
                    </a>
                </div>

                <div class="p-4 bg-[#F8FAFC] dark:bg-[#0B0F17] border border-[#E2E8F0] dark:border-[#1E293B]">
                    <span class="block text-xs font-mono uppercase tracking-wider text-[#64748B] dark:text-[#94A3B8] mb-1">
                        2. Dành cho Triển khai thật (Production / Cloud)
                    </span>
                    <p class="text-xs text-[#64748B] dark:text-[#94A3B8] mb-3">
                        Thực hiện theo các bước thiết lập OAuth 2.0 Client trên Google Cloud Console.
                    </p>
                    <a href="#googleSetupGuideSection" class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#0D5C4D] dark:text-[#10B981] hover:underline">
                        <span>Xem Hướng dẫn 4 Bước Cấu hình &darr;</span>
                    </a>
                </div>
            </div>
        </div>

        @* Dev Quick Login Test Card *@
        <div id="devQuickLoginSection" class="bg-white dark:bg-[#111827] border border-[#0D5C4D]/30 dark:border-[#10B981]/30 p-6 sm:p-8 mb-8 shadow-sm">
            <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 bg-[#0D5C4D] dark:bg-[#10B981]"></span>
                    <h2 class="text-lg font-bold text-[#0F172A] dark:text-[#F8FAFC]">Thử nghiệm Đăng nhập Google (Dev Mock)</h2>
                </div>
                <span class="text-xs font-mono text-[#0D5C4D] dark:text-[#10B981] bg-[#0D5C4D]/5 dark:bg-[#10B981]/10 px-2 py-0.5 border border-[#0D5C4D]/20">
                    ONE-CLICK TEST
                </span>
            </div>

            <p class="text-sm text-[#64748B] dark:text-[#94A3B8] mb-6">
                Hệ thống sẽ gọi <code class="text-xs font-mono bg-gray-100 dark:bg-gray-800 px-1.5 py-0.5 text-[#0D5C4D] dark:text-[#10B981]">ProcessExternalLoginAsync</code> 
                với thông tin dưới đây. Nếu email chưa tồn tại, hệ thống sẽ tự động tạo một tài khoản Ứng viên mới và cấp Cookie phiên làm việc ngay lập tức.
            </p>

            <form asp-controller="Account" asp-action="DevMockGoogleLogin" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <input type="hidden" name="userType" value="@Model.UserType" />

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-mono text-[10px] tracking-wider uppercase text-[#64748B] dark:text-[#94A3B8] mb-1.5">
                            Email Google Thử Nghiệm
                        </label>
                        <input type="email" name="email" value="candidate.google@gmail.com" required
                               class="w-full px-3 py-2 border border-[#E2E8F0] dark:border-[#334155] bg-[#F8FAFC] dark:bg-[#0B0F17] text-[#0F172A] dark:text-[#F8FAFC] text-sm focus:outline-none focus:border-[#0D5C4D] dark:focus:border-[#10B981]" />
                    </div>

                    <div>
                        <label class="block font-mono text-[10px] tracking-wider uppercase text-[#64748B] dark:text-[#94A3B8] mb-1.5">
                            Họ và Tên Hiển Thị
                        </label>
                        <input type="text" name="fullName" value="Nguyễn Văn Google" required
                               class="w-full px-3 py-2 border border-[#E2E8F0] dark:border-[#334155] bg-[#F8FAFC] dark:bg-[#0B0F17] text-[#0F172A] dark:text-[#F8FAFC] text-sm focus:outline-none focus:border-[#0D5C4D] dark:focus:border-[#10B981]" />
                    </div>
                </div>

                <div class="pt-2 flex items-center gap-3">
                    <button type="submit"
                            class="px-5 py-2.5 bg-[#0D5C4D] hover:bg-[#0a463a] text-white text-sm font-semibold tracking-wide border border-[#0D5C4D] transition-colors flex items-center gap-2">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/>
                        </svg>
                        <span>Đăng Nhập Thử Nghiệm Ngay</span>
                    </button>

                    <span class="text-xs text-[#64748B] dark:text-[#94A3B8]">
                        Không gửi request ra ngoài Internet, tạo session trực tiếp trên CSDL nội bộ.
                    </span>
                </div>
            </form>
        </div>

        @* Setup Guide Steps *@
        <div id="googleSetupGuideSection" class="bg-white dark:bg-[#111827] border border-[#E2E8F0] dark:border-[#1E293B] p-6 sm:p-8 shadow-sm">
            <h2 class="text-xl font-bold text-[#0F172A] dark:text-[#F8FAFC] mb-6 flex items-center gap-2">
                <span>Hướng dẫn thiết lập Google Cloud Console</span>
            </h2>

            <div class="space-y-8">
                @* Bước 1 *@
                <div class="flex gap-4">
                    <div class="w-8 h-8 flex-shrink-0 bg-[#0D5C4D] text-white font-mono font-bold flex items-center justify-center text-sm">
                        1
                    </div>
                    <div class="flex-1">
                        <h3 class="text-base font-semibold text-[#0F172A] dark:text-[#F8FAFC]">Tạo dự án trên Google Cloud</h3>
                        <p class="text-sm text-[#64748B] dark:text-[#94A3B8] mt-1 leading-relaxed">
                            Truy cập <a href="https://console.cloud.google.com/apis/credentials" target="_blank" rel="noopener noreferrer" class="text-[#0D5C4D] dark:text-[#10B981] underline font-medium">Google Cloud Console &rarr; Credentials</a>. 
                            Nếu chưa có dự án, hãy tạo mới một dự án (ví dụ: <code class="font-mono text-xs">NoveraTech-ATS</code>).
                        </p>
                    </div>
                </div>

                @* Bước 2 *@
                <div class="flex gap-4">
                    <div class="w-8 h-8 flex-shrink-0 bg-[#0D5C4D] text-white font-mono font-bold flex items-center justify-center text-sm">
                        2
                    </div>
                    <div class="flex-1">
                        <h3 class="text-base font-semibold text-[#0F172A] dark:text-[#F8FAFC]">Tạo OAuth Client ID</h3>
                        <p class="text-sm text-[#64748B] dark:text-[#94A3B8] mt-1 leading-relaxed">
                            Bấm <b>Create Credentials</b> &rarr; chọn <b>OAuth client ID</b>.<br/>
                            Application type chọn: <b>Web application</b>. Đặt tên (ví dụ: <i>NoveraTech ATS Web</i>).
                        </p>
                    </div>
                </div>

                @* Bước 3 *@
                <div class="flex gap-4">
                    <div class="w-8 h-8 flex-shrink-0 bg-[#0D5C4D] text-white font-mono font-bold flex items-center justify-center text-sm">
                        3
                    </div>
                    <div class="flex-1">
                        <h3 class="text-base font-semibold text-[#0F172A] dark:text-[#F8FAFC]">Cấu hình Authorized URIs</h3>
                        <p class="text-sm text-[#64748B] dark:text-[#94A3B8] mt-1 leading-relaxed">
                            Điền chính xác các thông số bên dưới vào phần cấu hình Google:
                        </p>

                        <div class="mt-3 space-y-3">
                            <div>
                                <span class="block text-xs font-mono uppercase text-[#64748B] dark:text-[#94A3B8] mb-1">
                                    Authorized JavaScript origins:
                                </span>
                                <div class="flex items-center gap-2">
                                    <input type="text" readonly value="@($"{Context.Request.Scheme}://{Context.Request.Host}")" id="txtOrigin"
                                           class="flex-1 px-3 py-1.5 bg-[#F8FAFC] dark:bg-[#0B0F17] border border-[#CBD5E1] dark:border-[#334155] text-xs font-mono text-[#0F172A] dark:text-[#F8FAFC]" />
                                    <button type="button" onclick="navigator.clipboard.writeText(document.getElementById('txtOrigin').value); alert('Đã sao chép Origin!');"
                                            class="px-3 py-1.5 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-xs font-mono border border-gray-300 dark:border-gray-700 transition-colors">
                                        Copy
                                    </button>
                                </div>
                            </div>

                            <div>
                                <span class="block text-xs font-mono uppercase text-[#64748B] dark:text-[#94A3B8] mb-1">
                                    Authorized redirect URIs (Quan trọng nhất):
                                </span>
                                <div class="flex items-center gap-2">
                                    <input type="text" readonly value="@Model.CallbackUrl" id="txtCallback"
                                           class="flex-1 px-3 py-1.5 bg-[#F8FAFC] dark:bg-[#0B0F17] border border-[#CBD5E1] dark:border-[#334155] text-xs font-mono text-[#0D5C4D] dark:text-[#10B981] font-semibold" />
                                    <button type="button" onclick="navigator.clipboard.writeText(document.getElementById('txtCallback').value); alert('Đã sao chép Callback URI!');"
                                            class="px-3 py-1.5 bg-[#0D5C4D] text-white hover:bg-[#0a463a] text-xs font-mono transition-colors">
                                        Copy URI
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* Bước 4 *@
                <div class="flex gap-4">
                    <div class="w-8 h-8 flex-shrink-0 bg-[#0D5C4D] text-white font-mono font-bold flex items-center justify-center text-sm">
                        4
                    </div>
                    <div class="flex-1">
                        <h3 class="text-base font-semibold text-[#0F172A] dark:text-[#F8FAFC]">Lưu thông tin vào file .env</h3>
                        <p class="text-sm text-[#64748B] dark:text-[#94A3B8] mt-1 leading-relaxed">
                            Mở file <code class="font-mono text-xs text-[#0D5C4D] dark:text-[#10B981]">.env</code> ở thư mục gốc của dự án và cập nhật 2 giá trị bạn nhận được từ Google:
                        </p>
                        <div class="mt-3 p-3 bg-[#0B0F17] text-gray-200 font-mono text-xs border border-gray-800 rounded-none overflow-x-auto">
                            GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com<br/>
                            GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret-here
                        </div>
                        <p class="text-xs text-[#64748B] dark:text-[#94A3B8] mt-2">
                            Sau khi lưu file <code class="font-mono">.env</code>, khởi động lại ứng dụng (<code class="font-mono">dotnet run</code>) để kích hoạt Google OAuth tự động.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
