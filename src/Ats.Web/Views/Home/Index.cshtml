<!-- Toast Container để hiển thị phản hồi tức thì (RULE.MD: bottom-right, clean theme) -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1090;">
    <div id="actionToast" class="toast toast-success align-items-center bg-white shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" style="border-radius: 12px; min-width: 320px; max-width: 420px;">
        <div class="d-flex align-items-center p-2">
            <div class="toast-body d-flex align-items-center gap-2 flex-grow-1" id="toastMessage" style="font-size: 0.85rem; color: #0F172A; font-weight: 500;">
                <i class="bi bi-check-circle-fill text-success fs-5"></i> <span>Thao tác thành công.</span>
            </div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function getCsrfToken() {
            var input = document.querySelector('input[name="__RequestVerificationToken"]');
            return input ? input.value : '';
        }

        function showToast(message, isSuccess = true) {
            var toastEl = document.getElementById('actionToast');
            var msgEl = document.getElementById('toastMessage');
            if (isSuccess) {
                toastEl.className = "toast toast-success align-items-center bg-white shadow-lg";
                msgEl.innerHTML = '<i class="bi bi-check-circle-fill text-success fs-5"></i> <span>' + message + '</span>';
            } else {
                toastEl.className = "toast toast-error align-items-center bg-white shadow-lg";
                msgEl.innerHTML = '<i class="bi bi-x-circle-fill text-danger fs-5"></i> <span>' + message + '</span>';
            }
            var toast = new bootstrap.Toast(toastEl, { delay: 4000 });
            toast.show();
        }

        // 1. Ứng tuyển nhanh Modal
        function openApplyJobModal(id, title, dept) {
            document.getElementById('modalJobId').value = id;
            document.getElementById('modalJobTitle').textContent = title;
            document.getElementById('modalJobDept').textContent = dept;
            var modal = new bootstrap.Modal(document.getElementById('applyJobModal'));
            modal.show();
        }

        async function submitQuickApply() {
            var jobId = document.getElementById('modalJobId').value;
            var coverLetter = document.getElementById('modalCoverLetter').value;
            var btn = document.getElementById('btnSubmitApply');
            var spinner = document.getElementById('spinnerApply');

            btn.disabled = true;
            spinner.classList.remove('d-none');

            var formData = new FormData();
            formData.append('jobId', jobId);
            formData.append('coverLetter', coverLetter);
            formData.append('__RequestVerificationToken', getCsrfToken());

            try {
                var res = await fetch('/Workspace/ApplyJob', {
                    method: 'POST',
                    body: formData
                });
                var data = await res.json();
                if (data.success) {
                    var modalEl = document.getElementById('applyJobModal');
                    bootstrap.Modal.getInstance(modalEl).hide();
                    showToast(data.message, true);
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    showToast(data.message || 'Lỗi khi ứng tuyển', false);
                }
            } catch (err) {
                showToast('Lỗi kết nối máy chủ: ' + err.message, false);
            } finally {
                btn.disabled = false;
                spinner.classList.add('d-none');
            }
        }

        // 2. Cập nhật CV Form
        async function handleCvSubmit(e) {
            e.preventDefault();
            var btn = document.getElementById('btnSubmitCv');
            var spinner = document.getElementById('spinnerCv');
            btn.disabled = true;
            spinner.classList.remove('d-none');

            var form = document.getElementById('cvUpdateForm');
            var formData = new FormData(form);
            formData.append('__RequestVerificationToken', getCsrfToken());

            try {
                var res = await fetch('/Workspace/UpdateCv', {
                    method: 'POST',
                    body: formData
                });
                var data = await res.json();
                if (data.success) {
                    var modalEl = document.getElementById('updateCvModal');
                    bootstrap.Modal.getInstance(modalEl).hide();
                    showToast(data.message, true);
                    if (data.fileName) {
                        var cvText = document.getElementById('cvStatusText');
                        if (cvText) cvText.textContent = data.fileName;
                    }
                    if (data.phone) {
                        var phoneText = document.getElementById('cvCandidatePhone');
                        if (phoneText) phoneText.textContent = data.phone;
                    }
                    if (data.fullName) {
                        var nameText = document.getElementById('cvCandidateName');
                        if (nameText) nameText.textContent = data.fullName;
                    }
                } else {
                    showToast(data.message || 'Lỗi khi cập nhật CV', false);
                }
            } catch (err) {
                showToast('Lỗi kết nối máy chủ: ' + err.message, false);
            } finally {
                btn.disabled = false;
                spinner.classList.add('d-none');
            }
        }

        // 3. Phê duyệt Offer thực tế
        async function approveSelectedOffer(offerId, name, pos, salary) {
            if (!confirm('Xác nhận PHÊ DUYỆT thư mời nhận việc (Offer Letter) cho ứng viên ' + name + ' với vị trí ' + pos + ' (Mức lương: ' + salary + ')?')) {
                return;
            }

            var formData = new FormData();
            formData.append('offerId', offerId);
            formData.append('candidateName', name);
            formData.append('__RequestVerificationToken', getCsrfToken());

            try {
                var res = await fetch('/Workspace/ApproveOffer', {
                    method: 'POST',
                    body: formData
                });
                var data = await res.json();
                if (data.success) {
                    showToast(data.message, true);
                    var kpiOffer = document.getElementById('kpiPendingOffers');
                    if (kpiOffer) {
                        var count = parseInt(kpiOffer.textContent || '1') - 1;
                        kpiOffer.textContent = Math.max(0, count);
                    }
                    var container = document.getElementById('approverActionContainer');
                    if (container) {
                        container.innerHTML = '<div class="p-3 text-center my-2" style="background:#F8FAFC; border:1px dashed #CBD5E1; border-radius:8px;"><i class="bi bi-check-circle-fill text-success fs-4 d-block mb-1"></i><div class="fw-semibold text-dark small">Đã duyệt Offer ' + name + '</div></div>';
                    }
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    showToast(data.message || 'Lỗi khi duyệt Offer', false);
                }
            } catch (err) {
                showToast('Lỗi kết nối: ' + err.message, false);
            }
        }

        // 4. Tạo tin tuyển dụng mới
        async function handleJobCreateSubmit(e) {
            e.preventDefault();
            var btn = document.getElementById('btnSubmitJobCreate');
            var spinner = document.getElementById('spinnerJobCreate');
            btn.disabled = true;
            spinner.classList.remove('d-none');

            var formData = new FormData();
            formData.append('title', document.getElementById('newJobTitle').value);
            formData.append('deptName', document.getElementById('newJobDept').value);
            formData.append('quantity', document.getElementById('newJobQuantity').value);
            formData.append('salaryDisplay', document.getElementById('newJobSalary').value);
            formData.append('expiredDate', document.getElementById('newJobExpiredDate').value);
            formData.append('description', document.getElementById('newJobDescription').value);
            formData.append('__RequestVerificationToken', getCsrfToken());

            try {
                var res = await fetch('/Workspace/CreateJobPosting', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': getCsrfToken()
                    },
                    body: formData
                });
                var data = {};
                try {
                    data = await res.json();
                } catch (jsonErr) {
                    data = { success: false, message: 'Phản hồi từ máy chủ không hợp lệ (Mã: ' + res.status + ')' };
                }
                if (data.success) {
                    var modalEl = document.getElementById('createJobModal');
                    if (modalEl) {
                        var modalInst = bootstrap.Modal.getInstance(modalEl);
                        if (modalInst) modalInst.hide();
                    }
                    showToast(data.message, true);
                    var kpiJobs = document.getElementById('kpiOpenJobs');
                    if (kpiJobs) {
                        kpiJobs.textContent = parseInt(kpiJobs.textContent || '0') + 1;
                    }
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    showToast(data.message || 'Lỗi tạo tin', false);
                }
            } catch (err) {
                showToast('Lỗi kết nối: ' + err.message, false);
            } finally {
                btn.disabled = false;
                spinner.classList.add('d-none');
            }
        }

        // 5. Khởi tạo đề xuất nhân sự (Đồng bộ chuẩn Module Requisitions EP-03)
        var reqOptionsLoaded = false;
        var reqPositionsData = [];

        function formatVndNumber(val) {
            if (!val && val !== 0) return '';
            var clean = val.toString().replace(/\D/g, '');
            if (!clean) return '';
            return new Intl.NumberFormat('vi-VN').format(clean);
        }

        function parseRawVnd(val) {
            if (!val) return 0;
            return parseInt(val.toString().replace(/\D/g, ''), 10) || 0;
        }

        async function loadRequisitionOptions() {
            if (reqOptionsLoaded) return;
            try {
                var res = await fetch('/yeu-cau-tuyen-dung/api/form-options');
                if (!res.ok) return;
                var data = await res.json();
                if (data.success) {
                    reqPositionsData = data.jobPositions || [];

                    var posSelect = document.getElementById('reqPositionId');
                    if (posSelect) {
                        posSelect.innerHTML = '<option value="">-- Chọn chức danh cần tuyển --</option>';
                        reqPositionsData.forEach(function (p) {
                            var opt = document.createElement('option');
                            opt.value = p.id;
                            opt.textContent = p.title + ' (' + p.code + ' - ' + p.jobLevel + ')';
                            opt.dataset.deptId = p.departmentId || '';
                            opt.dataset.deptName = p.departmentName || '';
                            opt.dataset.minSalary = p.standardMinSalary || 0;
                            opt.dataset.maxSalary = p.standardMaxSalary || 0;
                            posSelect.appendChild(opt);
                        });
                    }

                    var deptSelect = document.getElementById('reqDepartmentId');
                    if (deptSelect) {
                        deptSelect.innerHTML = '<option value="">-- Chọn phòng ban --</option>';
                        (data.departments || []).forEach(function (d) {
                            var opt = document.createElement('option');
                            opt.value = d.id;
                            opt.textContent = d.name + ' (' + d.code + ')';
                            deptSelect.appendChild(opt);
