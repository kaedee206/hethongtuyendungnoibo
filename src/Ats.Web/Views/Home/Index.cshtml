        // Initialize candidate pipeline search events & URL hydration
        document.addEventListener('DOMContentLoaded', function () {
            const candInput = document.getElementById('candidateSearchInput');
            const candClearBtn = document.getElementById('candidateSearchClearBtn');
            const candJobSelect = document.getElementById('candidateJobFilter') || document.getElementById('kanbanJobFilter');

            if (candInput) {
                const debouncedSearch = window.NoveraInstantSearch
                    ? window.NoveraInstantSearch.debounce(() => {
                        applyPipelineFilters(true, true);
                        applyKanbanFilters();
                    }, 15)
                    : () => {
                        applyPipelineFilters(true, true);
                        applyKanbanFilters();
                    };
                candInput.addEventListener('input', debouncedSearch);
                candInput.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') e.preventDefault();
                });
            }

            if (candClearBtn) {
                candClearBtn.addEventListener('click', function () {
                    if (candInput) {
                        candInput.value = '';
                        applyPipelineFilters(true, true);
                        applyKanbanFilters();
                        candInput.focus();
                    }
                });
            }

            function hydrateCandidatePipelineFromUrl() {
                if (!window.NoveraInstantSearch) return;
                const params = window.NoveraInstantSearch.getUrlParams();
                if (candInput && params.cand_search !== undefined) {
                    candInput.value = params.cand_search;
                }
                if (candJobSelect && params.cand_job !== undefined) {
                    candJobSelect.value = params.cand_job;
                    window.currentPipelineJob = params.cand_job;
                    window.currentPipelineJobId = params.cand_job;
                }
                if (params.cand_page !== undefined) {
                    window.candCurrentPage = parseInt(params.cand_page, 10) || 1;
                }
                if (params.cand_stage !== undefined) {
                    window.currentPipelineStage = params.cand_stage;
                    const stageButtons = document.querySelectorAll('#candidateStageFilterGroup .candidate-stage-pill');
                    stageButtons.forEach(btn => {
                        const onclickAttr = btn.getAttribute('onclick') || '';
                        if (onclickAttr.includes(`'${params.cand_stage}'`)) {
                            stageButtons.forEach(b => b.classList.remove('active'));
                            btn.classList.add('active');
                        }
                    });
                }
                applyPipelineFilters(false, false);
            }

            window.addEventListener('popstate', hydrateCandidatePipelineFromUrl);
            hydrateCandidatePipelineFromUrl();

            // Khởi tạo chế độ xem Kanban và lọc ban đầu
            switchPipelineView(window.pipelineViewMode || 'kanban');
            applyKanbanFilters();
            restoreKanbanPreferences();
            initMobileKanbanSwipeObserver();
        });

