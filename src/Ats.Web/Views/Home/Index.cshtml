                                    <div class="small mb-1"><b>Trạng thái:</b> <span class="badge bg-light text-dark border">${d.status}</span></div>
                                    <div class="small mb-3"><b>Ngày nộp:</b> ${d.appliedDate}</div>
                                    ${d.resumeFilePath && d.resumeFilePath !== '#' ? `
                                        <a href="${d.resumeFilePath}" target="_blank" class="btn btn-sm btn-outline-danger w-100 fw-semibold mb-2" style="border-radius:6px;">
                                            <i class="bi bi-file-earmark-pdf me-1"></i>Xem CV ${d.resumeFileName || ''}
                                        </a>
                                    ` : '<div class="text-muted small mb-2"><i class="bi bi-file-earmark-check me-1"></i>CV: ' + (d.resumeFileName || 'Đã nạp') + '</div>'}
                                    <a href="/Workspace/CandidateTimeline?candidateId=${d.candidateId || ''}&applicationId=${d.applicationId || applicationId}" class="btn btn-sm btn-outline-success w-100 fw-semibold" style="border-radius:6px;">
                                        <i class="bi bi-clock-history me-1"></i>Xem nhật ký tương tác
                                    </a>
                                </div>
                            </div>
                            <div class="col-12 col-md-7">
                                <h6 class="fw-bold text-dark mb-2" style="font-size: 0.9rem;"><i class="bi bi-journal-text me-1 text-primary"></i>Lịch sử tuyển chọn (Audit Trail)</h6>
                                <div class="mb-3" style="max-height: 180px; overflow-y: auto;">
                                    ${timelineHtml || '<div class="text-muted small">Chưa có lịch sử chuyển giai đoạn.</div>'}
                                </div>

                                <h6 class="fw-bold text-dark mb-2" style="font-size: 0.9rem;"><i class="bi bi-calendar2-check me-1 text-success"></i>Lịch phỏng vấn</h6>
                                <div class="mb-3" style="max-height: 140px; overflow-y: auto;">
                                    ${interviewsHtml || '<div class="text-muted small">Chưa có phiên phỏng vấn nào.</div>'}
                                </div>

                                ${offersHtml ? `
                                    <h6 class="fw-bold text-dark mb-2" style="font-size: 0.9rem;"><i class="bi bi-envelope-paper me-1 text-warning"></i>Đề xuất Offer</h6>
                                    <div>${offersHtml}</div>
                                ` : ''}
                            </div>
                        </div>
                    `;
                } else {
                    container.innerHTML = '<div class="text-center py-4 text-danger">' + (data.message || 'Không thể tải chi tiết hồ sơ.') + '</div>';
                }
            } catch (err) {
                container.innerHTML = '<div class="text-center py-4 text-danger">Lỗi kết nối: ' + err.message + '</div>';
            }
        }

        // 9. Client-side Dashboard Feature Router (/dashboard/{ten-tinh-nang})
        var activeFeature = '@(ViewBag.ActiveFeature ?? "tong-quan")';

        function switchDashboardFeature(featureName, e) {
            if (e) {
                e.preventDefault();
            }

            var cleanFeature = (featureName || 'tong-quan').toLowerCase().trim();
            if (cleanFeature === 'overview') cleanFeature = 'tong-quan';
            if (cleanFeature === 'pipeline' || cleanFeature === 'tuyen-dung') cleanFeature = 'ung-vien';
            if (cleanFeature === 'candidates' || cleanFeature === 'ho-so-ung-vien') cleanFeature = 'ung-vien';
            if (cleanFeature === 'interviews' || cleanFeature === 'phong-van') cleanFeature = 'lich-phong-van';
            if (cleanFeature === 'approvals' || cleanFeature === 'offers') cleanFeature = 'phe-duyet';
            if (cleanFeature === 'actions') cleanFeature = 'tac-vu';
            if (cleanFeature === 'cv') cleanFeature = 'ho-so';
            if (cleanFeature === 'lich-trinh') cleanFeature = 'tien-do';
            if (cleanFeature === 'jobs') cleanFeature = 'viec-lam';
            if (cleanFeature === 'referral' || cleanFeature === 'referrals' || cleanFeature === 'ho-so-gioi-thieu') cleanFeature = 'gioi-thieu';

            var targetUrl = cleanFeature === 'tong-quan' ? '/dashboard' : '/dashboard/' + cleanFeature;

            // 1. Cập nhật URL trên browser history không cần reload trang
            window.history.pushState({ feature: cleanFeature }, '', targetUrl);

            // 2. Cập nhật active tab trên Sub-navigation
            var tabs = document.querySelectorAll('.dashboard-feature-tab');
            tabs.forEach(function (tab) {
                if (tab.getAttribute('data-feature') === cleanFeature) {
                    tab.classList.add('active');
                } else {
                    tab.classList.remove('active');
                }
            });

            // 3. Cập nhật active link trên Sidebar ATS
            var sidebarLinks = document.querySelectorAll('.ats-sidebar .sidebar-nav-link');
            sidebarLinks.forEach(function (slink) {
                var sHref = (slink.getAttribute('href') || '').toLowerCase();
                var sPath = (slink.getAttribute('data-path') || '').toLowerCase();
                var targetMatch = '/dashboard/' + cleanFeature;
                if (cleanFeature === 'tong-quan') {
                    if (sHref === '/dashboard' || sHref === '/dashboard/tong-quan' || sPath === '/dashboard' || sPath === '/dashboard/tong-quan') {
                        slink.classList.add('active');
                    } else if (sHref.startsWith('/dashboard')) {
                        slink.classList.remove('active');
                    }
                } else {
                    if (sHref === targetMatch || sPath === targetMatch) {
                        slink.classList.add('active');
                    } else if (sHref.startsWith('/dashboard')) {
                        slink.classList.remove('active');
                    }
                }
            });

            // 4. Cập nhật badge URL góc phải
            var badge = document.getElementById('currentFeatureUrlBadge');
            if (badge) {
                badge.innerHTML = '<i class="bi bi-link-45deg me-1"></i>' + targetUrl;
            }

            // 5. Phân tách và hiển thị ĐỘC LẬP panel tính năng tương ứng
            var isCandidate = @(Model.IsCandidate ? "true" : "false");
            if (isCandidate) {
                var cPanels = document.querySelectorAll('.candidate-feature-panel');
                cPanels.forEach(function (p) {
                    if (p.getAttribute('data-feature-panel') === cleanFeature) {
                        p.classList.remove('d-none');
                    } else {
                        p.classList.add('d-none');
                    }
                });
            } else {
                var sPanels = document.querySelectorAll('.staff-feature-panel');
                sPanels.forEach(function (p) {
                    if (p.getAttribute('data-feature-panel') === cleanFeature) {
                        p.classList.remove('d-none');
                    } else {
                        p.classList.add('d-none');
                    }
                });
            }

            // 6. Cuộn mượt lên đầu không gian làm việc
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        window.switchDashboardFeature = switchDashboardFeature;

        function scrollToFeatureSection(feature) {
            var targetId = null;
            var isCandidate = @(Model.IsCandidate ? "true" : "false");

            if (isCandidate) {
                if (feature === 'ho-so' || feature === 'cv') {
                    targetId = 'feature-section-candidate-ho-so';
                } else if (feature === 'tien-do' || feature === 'lich-trinh' || feature === 'phong-van') {
                    targetId = 'feature-section-candidate-tien-do';
                } else if (feature === 'viec-lam' || feature === 'jobs') {
                    targetId = 'feature-section-candidate-viec-lam';
                }
            } else {
                if (feature === 'ung-vien' || feature === 'candidates' || feature === 'ho-so-ung-vien' || feature === 'tuyen-dung' || feature === 'pipeline') {
                    targetId = 'feature-section-staff-ung-vien';
                } else if (feature === 'lich-phong-van' || feature === 'phong-van' || feature === 'interviews') {
                    targetId = 'feature-section-staff-lich-phong-van';
                } else if (feature === 'phe-duyet' || feature === 'approvals' || feature === 'offers') {
                    targetId = 'feature-section-staff-phe-duyet';
                } else if (feature === 'tac-vu' || feature === 'actions') {
                    targetId = 'feature-section-staff-tac-vu';
                } else if (feature === 'tong-quan' || feature === 'overview') {
                    targetId = 'feature-section-staff-tong-quan';
                }
            }

            if (targetId) {
                var el = document.getElementById(targetId);
                if (el) {
                    el.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            } else {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        }

        window.addEventListener('popstate', function (e) {
            var feature = (e.state && e.state.feature) ? e.state.feature : 'tong-quan';
            switchDashboardFeature(feature);
        });

        document.addEventListener('DOMContentLoaded', function () {

            // Đăng ký sự kiện nạp dữ liệu và xử lý dải lương cho Modal Đề xuất tuyển dụng
            var reqModalEl = document.getElementById('createRequisitionModal');
            if (reqModalEl) {
                reqModalEl.addEventListener('show.bs.modal', function () {
                    loadRequisitionOptions();
                });
            }

            var posSelect = document.getElementById('reqPositionId');
            if (posSelect) {
                posSelect.addEventListener('change', handleModalPositionChange);
            }

            var minInp = document.getElementById('reqMinSalaryFormatted');
            var maxInp = document.getElementById('reqMaxSalaryFormatted');
            [minInp, maxInp].forEach(function (inp) {
                if (!inp) return;
                inp.addEventListener('input', function () {
                    var raw = parseRawVnd(this.value);
                    this.value = raw > 0 ? formatVndNumber(raw) : '';
                });
            });
        });
    </script>
}
