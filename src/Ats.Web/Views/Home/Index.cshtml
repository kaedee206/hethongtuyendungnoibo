                    var interviewsHtml = (d.interviews || []).map(iv => `
                        <div class="p-2.5 mb-2" style="background:#F8FAFC; border:1px solid #E2E8F0; border-radius:8px;">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-dark" style="font-size: 0.85rem;">${iv.title || 'Phỏng vấn'}</span>
                                <span class="badge ${iv.status === 'COMPLETED' ? 'bg-success' : 'bg-primary'}">${iv.status}</span>
                            </div>
                            <div class="small text-muted mt-1">Thời gian: <b>${iv.time || iv.scheduledDate || 'Chưa ấn định'}</b></div>
                            <div class="small text-muted">Địa điểm / Link: <b>${iv.link || iv.locationOrLink || 'Trực tuyến'}</b></div>
                        </div>
                    `).join('');

                    var offersHtml = (d.offers || []).map(o => `
                        <div class="p-2.5 mb-2" style="background:#FEF3C7; border:1px solid #FDE68A; border-radius:8px;">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-dark">Lương: ${o.salaryDisplay}</span>
                                <span class="badge ${o.status === 'APPROVED' ? 'bg-success' : 'bg-warning text-dark'}">${o.status}</span>
                            </div>
                            <div class="small text-muted mt-1">Gia nhập: ${o.joinDate} · Hạn offer: ${o.expirationDate}</div>
