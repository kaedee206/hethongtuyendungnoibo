                if (data.success && data.data) {
                    var d = data.data;
                    var timelineHtml = (d.histories || d.stageHistory || []).map(h => `
                        <div class="d-flex align-items-start gap-2 mb-2 pb-2" style="border-bottom: 1px dashed #E2E8F0;">
                            <i class="bi bi-clock-history text-muted mt-1"></i>
