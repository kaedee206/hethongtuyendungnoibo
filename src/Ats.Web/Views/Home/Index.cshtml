                        <!-- ============================================================== -->
                        <div id="candidateTableViewContainer" class="d-none mt-2">
                            <!-- Filter Stage Pills (Pipeline Funnel Stepper + Trạng thái đặc biệt - Chỉ hiện khi ở chế độ Bảng) -->
                            <div class="d-flex flex-wrap align-items-center gap-1.5 mb-3 p-2 rounded-3 bg-light border" id="candidateStageFilterGroup" style="border-color: #E2E8F0 !important;">
                                <button type="button" class="candidate-stage-pill active" onclick="filterPipelineCandidates('ALL', this)">
                                    Tất cả <span class="pill-count">@Model.CandidatePipelineItems.Count</span>
                                </button>
                                <div class="vr my-auto mx-1 text-muted opacity-25 d-none d-sm-block" style="height: 18px;"></div>
                                @foreach (var stage in Model.PipelineFunnel.Where(s => !s.IsTerminal))
                                {
                                    var count = Model.CandidatePipelineItems.Count(x => x.CurrentStageOrder == stage.StageOrder);
                                    <button type="button" class="candidate-stage-pill @(count == 0 ? "opacity-75" : "")" onclick="filterPipelineCandidates('@stage.StageOrder', this)">
                                        <span class="opacity-75 font-mono" style="font-size: 0.7rem;">@stage.StageOrder.ToString("D2").</span>
                                        <span>@(string.IsNullOrWhiteSpace(stage.ShortName) ? stage.StageName : stage.ShortName)</span>
                                        <span class="pill-count">@count</span>
                                    </button>
                                }
                                <div class="vr my-auto mx-1 text-muted opacity-25 d-none d-sm-block" style="height: 18px;"></div>
                                @if (Model.DuplicateCandidatesCount > 0)
                                {
                                    <button type="button" class="candidate-stage-pill" onclick="filterPipelineCandidates('DUPLICATE', this)" title="Lọc hồ sơ nghi ngờ trùng lặp">
                                        <i class="bi bi-intersect text-warning"></i>Cảnh báo trùng <span class="pill-count text-warning fw-bold">@Model.CandidatePipelineItems.Count(x => x.HasDuplicateWarning)</span>
                                    </button>
                                }
                                <button type="button" class="candidate-stage-pill" onclick="filterPipelineCandidates('REFERRAL', this)" title="Hồ sơ được nhân sự nội bộ giới thiệu">
                                    <i class="bi bi-person-heart text-danger"></i>Giới thiệu <span class="pill-count">@Model.CandidatePipelineItems.Count(x => x.IsReferral)</span>
                                </button>
                                <button type="button" class="candidate-stage-pill" onclick="filterPipelineCandidates('REJECTED', this)" title="Ứng viên đã từ chối">
                                    <i class="bi bi-x-circle text-danger"></i>Từ chối <span class="pill-count">@Model.CandidatePipelineItems.Count(x => x.Status == "REJECTED")</span>
                                </button>
                                <button type="button" class="candidate-stage-pill" onclick="filterPipelineCandidates('WITHDRAWN', this)" title="Ứng viên chủ động rút">
                                    <i class="bi bi-box-arrow-left text-secondary"></i>Rút hồ sơ <span class="pill-count">@Model.CandidatePipelineItems.Count(x => x.Status == "WITHDRAWN")</span>
                                </button>
                            </div>

                            <div class="dashboard-table-responsive">
                                <table class="table align-middle mb-0" style="min-width: 900px; font-size: 0.85rem;">
                                    <thead>
                                        <tr style="border-bottom: 1px solid #E2E8F0; color: #64748B; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;">
