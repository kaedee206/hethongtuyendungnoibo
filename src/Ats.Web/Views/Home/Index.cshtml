                        <button type="submit" class="btn btn-success px-4 fw-semibold text-white" style="border-radius: 8px; font-size: 0.85rem;" id="btnSubmitCv">
                            <span class="spinner-border spinner-border-sm me-1 d-none" id="spinnerCv"></span>
