                showToast('Lỗi kết nối: ' + err.message, false);
            }
        }

        // --- Table View Filters ---
        function applyPipelineFilters(shouldSyncUrl = true, resetPage = false) {
            if (resetPage) {
                window.candCurrentPage = 1;
            }
            const input = document.getElementById('candidateSearchInput');
            const jobSelect = document.getElementById('candidateJobFilter') || document.getElementById('kanbanJobFilter');
            const clearBtn = document.getElementById('candidateSearchClearBtn');
            const hint = document.getElementById('candSearchHint');
            const query = (input ? input.value : '').trim();
            const stageOrder = window.currentPipelineStage || 'ALL';
            const selectedJob = window.currentPipelineJob || window.currentPipelineJobId || (jobSelect ? jobSelect.value : '') || 'ALL';
            const selectedJobId = (selectedJob !== 'ALL' && selectedJob) ? selectedJob : null;

            if (clearBtn) {
                if (query.length > 0) clearBtn.classList.remove('d-none');
                else clearBtn.classList.add('d-none');
            }

            if (hint) {
                if (query.length > 0 && query.length < 3) hint.classList.remove('d-none');
                else hint.classList.add('d-none');
            }

            const rows = Array.from(document.querySelectorAll('.pipeline-candidate-row'));
            const matchedRows = [];

            rows.forEach(r => {
                const rowStage = r.getAttribute('data-stage-order') || '';
                const rowStatus = r.getAttribute('data-status') || '';
                const rowJobId = r.getAttribute('data-job-id') || '';
                const name = r.getAttribute('data-name') || '';
                const email = r.getAttribute('data-email') || '';
                const job = r.getAttribute('data-job') || '';

                // Job match
                const jobMatch = (selectedJob === 'ALL' || !selectedJob || rowJobId.toLowerCase() === selectedJob.toLowerCase());

                // SLA match
                const isOverdue = r.getAttribute('data-is-overdue') === 'true';
                const slaMatch = !window.filterSlaOverdueOnly || isOverdue;

                // Stage match
                let stageMatch = false;
                if (stageOrder === 'ALL') {
                    stageMatch = (rowStatus !== 'WITHDRAWN');
                } else if (stageOrder === 'WITHDRAWN') {
                    stageMatch = (rowStatus === 'WITHDRAWN');
                } else if (stageOrder === 'REJECTED') {
                    stageMatch = (rowStatus === 'REJECTED');
                } else if (stageOrder === 'REFERRAL') {
                    stageMatch = (r.getAttribute('data-is-referral') === 'true');
                } else if (stageOrder === 'DUPLICATE') {
                    stageMatch = (r.getAttribute('data-has-duplicate') === 'true');
                } else {
                    stageMatch = (rowStage === stageOrder && rowStatus !== 'REJECTED' && rowStatus !== 'WITHDRAWN');
                }

                // Text search match: Chỉ lọc khi từ khóa có từ 3 ký tự trở lên (>= 3 chars)
                const combinedText = `${name} ${email} ${job}`;
                const textMatch = !query || query.length < 3 || (window.NoveraInstantSearch
                    ? window.NoveraInstantSearch.matchSearchTokens(combinedText, query)
                    : combinedText.toLowerCase().includes(query.toLowerCase()));

                if (stageMatch && textMatch && jobMatch && slaMatch) {
                    matchedRows.push(r);
                }
            });

            // Pagination calculation
            const pageSizeSelect = document.getElementById('candPageSizeSelect');
            const pageSize = parseInt(pageSizeSelect ? pageSizeSelect.value : (window.candPageSize || 10), 10) || 10;
            window.candPageSize = pageSize;

            const totalRecords = matchedRows.length;
            const totalPages = Math.max(1, Math.ceil(totalRecords / pageSize));
            if (window.candCurrentPage > totalPages) window.candCurrentPage = totalPages;
            if (window.candCurrentPage < 1) window.candCurrentPage = 1;

            const startIndex = (window.candCurrentPage - 1) * pageSize;
            const endIndex = Math.min(startIndex + pageSize, totalRecords);

            // Display / hide rows based on page slice
            rows.forEach(r => {
                const matchedIndex = matchedRows.indexOf(r);
                if (matchedIndex >= startIndex && matchedIndex < endIndex) {
                    r.style.display = '';
                } else {
                    r.style.display = 'none';
                }
            });

            // Empty state row in table
            const tbody = document.getElementById('candidatePipelineTableBody');
            let noResultsRow = document.getElementById('pipelineNoResultsRow');
            if (totalRecords === 0) {
                if (!noResultsRow && tbody) {
                    noResultsRow = document.createElement('tr');
                    noResultsRow.id = 'pipelineNoResultsRow';
                    noResultsRow.innerHTML = '<td colspan="5" class="text-center py-4 text-muted"><i class="bi bi-search me-1"></i> Không tìm thấy ứng viên nào phù hợp với bộ lọc hiện tại.</td>';
                    tbody.appendChild(noResultsRow);
                }
            } else if (noResultsRow) {
                noResultsRow.remove();
            }

            // Update pagination UI stats
            const pageStartEl = document.getElementById('candPageStart');
            const pageEndEl = document.getElementById('candPageEnd');
            const totalRecordsEl = document.getElementById('candTotalRecords');
            const paginationContainer = document.getElementById('candidatePaginationContainer');

            if (pageStartEl) pageStartEl.innerText = totalRecords > 0 ? (startIndex + 1) : 0;
            if (pageEndEl) pageEndEl.innerText = endIndex;
            if (totalRecordsEl) totalRecordsEl.innerText = totalRecords;
            if (paginationContainer) {
                paginationContainer.style.display = totalRecords > 0 ? 'flex' : 'none';
            }

            renderCandidatePagination(totalPages, window.candCurrentPage);

            // Sync URL query
            if (shouldSyncUrl && window.NoveraInstantSearch) {
                window.NoveraInstantSearch.syncUrlParams({
                    cand_search: query || null,
                    cand_stage: stageOrder !== 'ALL' ? stageOrder : null,
                    cand_job: selectedJobId || null,
                    cand_page: window.candCurrentPage > 1 ? window.candCurrentPage : null
                });
            }
        }

        function renderCandidatePagination(totalPages, currentPage) {
            const ul = document.getElementById('candPaginationUl');
            if (!ul) return;
            ul.innerHTML = '';

            const pages = Math.max(1, totalPages || 1);
            const curr = Math.max(1, Math.min(currentPage || 1, pages));

            // Previous Button (Chuyển trang trước)
            const prevLi = document.createElement('li');
            const isPrevDisabled = (curr <= 1);
            prevLi.className = `page-item ${isPrevDisabled ? 'disabled' : ''}`;
            prevLi.innerHTML = `<button class="page-link ${isPrevDisabled ? 'text-muted' : 'text-dark fw-semibold'}" type="button" ${isPrevDisabled ? 'disabled' : `onclick="goToCandidatePage(${curr - 1})"`} style="border-radius: 6px; padding: 0.28rem 0.6rem; font-size: 0.8rem; border-color: #CBD5E1;" aria-label="Trang trước" title="Trang trước"><i class="bi bi-chevron-left"></i></button>`;
            ul.appendChild(prevLi);

            // Page numbers
            if (pages <= 7) {
                for (let p = 1; p <= pages; p++) {
                    const li = document.createElement('li');
                    const isActive = (p === curr);
                    li.className = `page-item ${isActive ? 'active' : ''}`;
                    li.innerHTML = `<button class="page-link ${isActive ? 'text-white fw-bold' : 'text-dark'}" type="button" ${isActive ? '' : `onclick="goToCandidatePage(${p})"`} style="border-radius: 6px; padding: 0.28rem 0.65rem; font-size: 0.8rem; ${isActive ? 'background-color:#059669; border-color:#059669;' : 'border-color:#CBD5E1;'}">${p}</button>`;
                    ul.appendChild(li);
                }
            } else {
                let startP = Math.max(1, curr - 2);
                let endP = Math.min(pages, curr + 2);

                if (startP > 1) {
                    const li1 = document.createElement('li');
                    li1.className = 'page-item';
                    li1.innerHTML = `<button class="page-link text-dark" type="button" onclick="goToCandidatePage(1)" style="border-radius: 6px; padding: 0.28rem 0.65rem; font-size: 0.8rem; border-color: #CBD5E1;">1</button>`;
                    ul.appendChild(li1);
                    if (startP > 2) {
                        const dots = document.createElement('li');
                        dots.className = 'page-item disabled';
                        dots.innerHTML = `<span class="page-link text-muted" style="border-radius: 6px; padding: 0.28rem 0.45rem; font-size: 0.8rem; border-color: #CBD5E1;">...</span>`;
                        ul.appendChild(dots);
                    }
                }

                for (let p = startP; p <= endP; p++) {
                    const li = document.createElement('li');
                    const isActive = (p === curr);
                    li.className = `page-item ${isActive ? 'active' : ''}`;
                    li.innerHTML = `<button class="page-link ${isActive ? 'text-white fw-bold' : 'text-dark'}" type="button" ${isActive ? '' : `onclick="goToCandidatePage(${p})"`} style="border-radius: 6px; padding: 0.28rem 0.65rem; font-size: 0.8rem; ${isActive ? 'background-color:#059669; border-color:#059669;' : 'border-color:#CBD5E1;'}">${p}</button>`;
                    ul.appendChild(li);
                }

                if (endP < pages) {
                    if (endP < pages - 1) {
                        const dots = document.createElement('li');
                        dots.className = 'page-item disabled';
                        dots.innerHTML = `<span class="page-link text-muted" style="border-radius: 6px; padding: 0.28rem 0.45rem; font-size: 0.8rem; border-color: #CBD5E1;">...</span>`;
                        ul.appendChild(dots);
                    }
                    const liLast = document.createElement('li');
                    liLast.className = 'page-item';
                    liLast.innerHTML = `<button class="page-link text-dark" type="button" onclick="goToCandidatePage(${pages})" style="border-radius: 6px; padding: 0.28rem 0.65rem; font-size: 0.8rem; border-color: #CBD5E1;">${pages}</button>`;
                    ul.appendChild(liLast);
                }
            }

            // Next Button (Chuyển trang sau)
            const nextLi = document.createElement('li');
            const isNextDisabled = (curr >= pages);
            nextLi.className = `page-item ${isNextDisabled ? 'disabled' : ''}`;
            nextLi.innerHTML = `<button class="page-link ${isNextDisabled ? 'text-muted' : 'text-dark fw-semibold'}" type="button" ${isNextDisabled ? 'disabled' : `onclick="goToCandidatePage(${curr + 1})"`} style="border-radius: 6px; padding: 0.28rem 0.6rem; font-size: 0.8rem; border-color: #CBD5E1;" aria-label="Trang sau" title="Trang sau"><i class="bi bi-chevron-right"></i></button>`;
            ul.appendChild(nextLi);
        }

