@model Ats.Web.Models.ViewModels.Workspace.WorkspaceDashboardViewModel
@using System.Security.Claims
@using Ats.Web.Constants
@{
    ViewData["Title"] = Model.IsAuthenticated ? "Không gian làm việc" : "Hệ thống Tuyển dụng NoveraTech";
    var activeFeature = (ViewBag.ActiveFeature as string ?? "tong-quan").ToLowerInvariant().Trim();
    if (string.IsNullOrWhiteSpace(activeFeature)) activeFeature = "tong-quan";
}

@Html.AntiForgeryToken()

@section Styles {
    <style>
        .dashboard-feature-tab {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            padding: 0.45rem 0.95rem;
            font-size: 0.82rem;
            font-weight: 600;
            color: #475569;
            text-decoration: none;
            border-radius: 8px;
            transition: all 0.18s ease;
            border: 1px solid transparent;
            cursor: pointer;
            white-space: nowrap;
        }
        .dashboard-feature-tab:hover {
            color: #0F172A;
            background: #F8FAFC;
            border-color: #E2E8F0;
        }
        .dashboard-feature-tab.active {
            color: #047857;
            background: #ECFDF5;
            border-color: #A7F3D0;
            box-shadow: 0 1px 2px rgba(5, 150, 105, 0.08);
        }
        .feature-highlight-pulse {
            animation: featurePulse 1.8s ease;
            border-color: #059669 !important;
            box-shadow: 0 0 0 4px rgba(5, 150, 105, 0.15) !important;
        }
        @@keyframes featurePulse {
            0% { box-shadow: 0 0 0 0 rgba(5, 150, 105, 0.4); }
            70% { box-shadow: 0 0 0 8px rgba(5, 150, 105, 0); }
            100% { box-shadow: 0 0 0 0 rgba(5, 150, 105, 0); }
        }
        .scroll-margin-nav {
            scroll-margin-top: 90px;
        }
    </style>
}

<div class="container-fluid px-3 px-xl-4 py-3" style="max-width: 1600px;">
    @if (Model.IsAuthenticated)
    {
        <!-- ── SINGLE OPERATIONAL HEADER (RULE.MD: Clean, No Stacked Banners) ── -->
        <div class="mb-3 pb-3 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3"
             style="border-bottom: 1px solid #E2E8F0;">
            <div class="d-flex align-items-center gap-3">
                <!-- User Avatar Badge -->
                <div class="d-flex align-items-center justify-content-center fw-bold text-white shadow-sm"
                     style="width: 42px; height: 42px; background: linear-gradient(135deg, #059669 0%, #047857 100%); border-radius: 10px; font-size: 1.05rem; flex-shrink: 0; letter-spacing: -0.02em;">
                    @(Model.UserFullName.Length > 0 ? Model.UserFullName[..1].ToUpper() : "U")
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span style="font-size: 0.95rem; font-weight: 700; color: #0F172A; letter-spacing: -0.01em;">
                            @Model.UserFullName
                        </span>
                        <span style="color:#CBD5E1;">·</span>
                        <span style="font-size: 0.8rem; color: #64748B;">
                            @(Model.IsCandidate ? "Cổng Ứng Viên" : "Trung Tâm Điều Hành Tuyển Dụng")
                        </span>
                        @foreach (var rDisplayName in Model.UserRolesList)
                        {
                            <span style="background:#F1F5F9; color:#475569; border: 1px solid #E2E8F0; border-radius:6px; font-size:0.7rem; padding:2px 8px; font-weight:600;">
                                @rDisplayName
                            </span>
                        }
                    </div>
                    <div class="d-flex align-items-center gap-2 mt-0.5">
                        <span style="font-size: 0.75rem; color: #94A3B8; font-family: 'JetBrains Mono', ui-monospace, monospace;">
                            @Model.UserEmail
                        </span>
                        <span style="color:#E2E8F0;">•</span>
                        <span style="font-size: 0.72rem; color: #059669; font-weight: 600;">
                            <i class="bi bi-shield-check me-1"></i>Hệ thống bảo mật trực tuyến
                        </span>
                    </div>
                </div>
            </div>

            <!-- Quick Global Shortcuts -->
            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                <a href="/Jobs" style="display:inline-flex; align-items:center; gap:0.4rem; font-size:0.8rem; font-weight:600; color:#065F46; background:#ECFDF5; text-decoration:none; padding:0.4rem 0.85rem; border:1px solid #A7F3D0; border-radius:8px; transition:all .2s;">
                    <i class="bi bi-briefcase-fill" style="color:#059669;"></i> Vị Trí Đang Mở (@Model.TotalOpenJobs)
                </a>
                <a asp-controller="Account" asp-action="ChangePassword"
                   style="display:inline-flex; align-items:center; gap:0.4rem; font-size:0.8rem; font-weight:500; color:#475569; background:#FFFFFF; text-decoration:none; padding:0.4rem 0.85rem; border:1px solid #E2E8F0; border-radius:8px; transition:all .2s;"
                   onmouseover="this.style.borderColor='#059669'; this.style.color='#059669';"
                   onmouseout="this.style.borderColor='#E2E8F0'; this.style.color='#475569';">
                    <i class="bi bi-key"></i> Đổi mật khẩu
                </a>
            </div>
        </div>

        @if (Model.IsCandidate)
        {
            <!-- ========================================== -->
            <!-- PHÂN HỆ 1: DASHBOARD DÀNH CHO ỨNG VIÊN -->
            <!-- Layout cân đối 4 Cột (Trái) & 8 Cột (Phải) -->
            <!-- ========================================== -->
            <div id="candidate-workspace">
                <!-- 1. TÍNH NĂNG TỔNG QUAN (TONG-QUAN) -->
                <div class="candidate-feature-panel @(activeFeature == "tong-quan" ? "" : "d-none")" data-feature-panel="tong-quan">
                    <div class="row g-4 mb-4">
                        <div class="col-12 col-lg-5 d-flex flex-column gap-4">
                            <!-- Hồ sơ tóm lược -->
                            <div class="card border-0 shadow-sm p-4 bg-white" style="border: 1px solid #E2E8F0 !important; border-radius: 12px;">
                                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-person-badge me-2 text-success"></i>Hồ Sơ Của Bạn</h6>
                                    <button type="button" class="btn btn-sm btn-link text-success p-0 text-decoration-none fw-semibold" style="font-size: 0.78rem;" onclick="switchDashboardFeature('ho-so', event)">
                                        Xem chi tiết <i class="bi bi-arrow-right"></i>
                                    </button>
                                </div>
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <div class="d-flex align-items-center justify-content-center fw-bold text-white rounded-circle" style="width: 44px; height: 44px; background: #059669; font-size: 1.1rem;">
                                        @(Model.UserFullName.Length > 0 ? Model.UserFullName[..1].ToUpper() : "U")
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@(Model.CandidateProfile?.FullName ?? Model.UserFullName)</div>
                                        <div class="text-muted small" style="font-family:'JetBrains Mono',monospace;">@Model.UserEmail</div>
                                    </div>
                                </div>
                                <div class="p-2.5 bg-light rounded-2 border mb-3" style="font-size: 0.8rem;">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted">Số điện thoại:</span>
                                        <span class="fw-semibold text-dark">@(Model.CandidateProfile?.Phone ?? "Chưa cập nhật")</span>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span class="text-muted">File CV:</span>
                                        <span class="fw-semibold text-dark text-truncate" style="max-width: 180px;">@(Model.CandidateProfile?.ResumeFileName ?? "Chưa có CV")</span>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-outline-success btn-sm w-100 fw-semibold" style="border-radius: 6px;" onclick="switchDashboardFeature('ho-so', event)">
                                    <i class="bi bi-pencil-square me-1"></i> Quản lý hồ sơ &amp; CV
                                </button>
                            </div>

                            <!-- Hỗ trợ ứng viên -->
                            <div class="card border-0 shadow-sm p-4 bg-white" style="border: 1px solid #E2E8F0 !important; border-radius: 12px;">
                                <div class="d-flex align-items-center gap-2 mb-2 pb-2 border-bottom">
                                    <i class="bi bi-headset text-success"></i>
                                    <h6 class="fw-bold text-dark mb-0">Hỗ Trợ Tuyển Dụng</h6>
                                </div>
                                <p class="text-muted small mb-3">Bộ phận Tuyển dụng NoveraTech luôn sẵn sàng giải đáp thắc mắc về các vòng xét tuyển.</p>
                                <div class="d-flex flex-column gap-2 small">
                                    <div><i class="bi bi-envelope text-muted me-2"></i>tuyendung@noveratech.com</div>
                                    <div><i class="bi bi-telephone text-muted me-2"></i>(024) 3856 9999 (Máy lẻ: 104)</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-7 d-flex flex-column gap-4">
                            <!-- Tiến độ xét tuyển tóm tắt -->
                            <div class="card border-0 shadow-sm p-4 bg-white" style="border: 1px solid #E2E8F0 !important; border-radius: 12px;">
                                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-calendar2-check me-2 text-success"></i>Tiến Độ Ứng Tuyển Hiện Tại</h6>
                                    <button type="button" class="btn btn-sm btn-link text-success p-0 text-decoration-none fw-semibold" style="font-size: 0.78rem;" onclick="switchDashboardFeature('tien-do', event)">
                                        Xem lịch trình đầy đủ <i class="bi bi-arrow-right"></i>
                                    </button>
                                </div>
                                @if (Model.ActiveApplication != null)
                                {
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div>
                                            <span class="badge bg-light text-secondary border mb-1" style="font-family:'JetBrains Mono',monospace;">@Model.ActiveApplication.ApplicationCode</span>
                                            <h6 class="fw-bold text-dark mb-0">@Model.ActiveApplication.JobTitle</h6>
                                        </div>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle py-1.5 px-2.5">
                                            @Model.ActiveApplication.CurrentStageName
                                        </span>
                                    </div>
                                    <div class="progress mb-2" style="height: 6px; border-radius: 999px;">
                                        <div class="progress-bar bg-success" style="width: @(Model.ActiveApplication.ProgressPercentage)%;"></div>
                                    </div>
                                    <div class="d-flex justify-content-between text-muted small mb-3">
                                        <span>Tiến độ tuyển chọn</span>
                                        <span class="fw-bold text-success" style="font-family:'JetBrains Mono',monospace;">@(Model.ActiveApplication.ProgressPercentage)%</span>
                                    </div>

                                    @if (Model.CandidateInterview != null)
                                    {
                                        <div class="p-3 bg-light border border-success-subtle rounded-3" style="border-left: 4px solid #059669 !important;">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="fw-bold text-dark"><i class="bi bi-camera-video text-success me-1"></i>@Model.CandidateInterview.RoundTitle</span>
                                                <span class="badge bg-success-subtle text-success">@Model.CandidateInterview.StatusDisplay</span>
                                            </div>
                                            <div class="small text-muted mb-2">
                                                Thời gian: <b>@Model.CandidateInterview.TimeDisplay, @Model.CandidateInterview.DateDisplay</b>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-success fw-semibold" onclick="switchDashboardFeature('tien-do', event)">
                                                <i class="bi bi-arrow-up-right-square me-1"></i> Vào phòng họp Google Meet
                                            </button>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-center py-4 text-muted">
                                        <i class="bi bi-briefcase fs-2 text-secondary mb-2 d-block"></i>
                                        <p class="small mb-3">Bạn chưa nộp đơn vào vị trí nào.</p>
                                        <button type="button" class="btn btn-sm btn-success fw-semibold" onclick="switchDashboardFeature('viec-lam', event)">
                                            <i class="bi bi-search me-1"></i> Khám phá việc làm ngay
                                        </button>
                                    </div>
                                }
                            </div>

                            <!-- Cơ hội việc làm nhanh -->
                            <div class="card border-0 shadow-sm p-4 bg-white" style="border: 1px solid #E2E8F0 !important; border-radius: 12px;">
                                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-briefcase me-2 text-success"></i>Việc Làm Đang Mở</h6>
                                    <button type="button" class="btn btn-sm btn-link text-success p-0 text-decoration-none fw-semibold" style="font-size: 0.78rem;" onclick="switchDashboardFeature('viec-lam', event)">
                                        Xem tất cả (@Model.CandidateOpenJobs.Count) <i class="bi bi-arrow-right"></i>
                                    </button>
                                </div>
                                <div class="d-flex flex-column gap-2.5">
                                    @foreach (var job in Model.CandidateOpenJobs.Take(2))
                                    {
                                        <div class="p-3 border rounded-2 d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="fw-bold text-dark" style="font-size: 0.9rem;">@job.Title</div>
                                                <div class="text-muted small">@job.WorkLocation · @job.Department</div>
                                            </div>
                                            <div class="text-end">
                                                <div class="fw-bold text-success small" style="font-family:'JetBrains Mono',monospace;">@job.SalaryDisplay</div>
                                                <button type="button" class="btn btn-sm btn-outline-success mt-1" style="font-size: 0.75rem; border-radius: 6px;" onclick="openApplyJobModal('@job.Id', '@job.Title', '@job.Department')">Ứng tuyển</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. TÍNH NĂNG HỒ SƠ & CV (HO-SO) -->
                <div class="candidate-feature-panel @(activeFeature == "ho-so" ? "" : "d-none")" data-feature-panel="ho-so">
                    <div class="row g-4 mb-4">
                        <div class="col-12 col-lg-8">
                            <div id="feature-section-candidate-ho-so" class="card border-0 shadow-sm p-4 bg-white" style="border: 1px solid #E2E8F0 !important; border-radius: 12px;">
                                <div class="d-flex align-items-center justify-content-between mb-3 pb-2" style="border-bottom: 1px solid #F1F5F9;">
                                    <h6 class="fw-bold text-dark mb-0" style="font-size: 0.95rem;">
                                        <i class="bi bi-person-badge me-1.5" style="color: #059669;"></i>Hồ Sơ Ứng Tuyển &amp; CV Đính Kèm
                                    </h6>
                                    <span style="background: #ECFDF5; color: #047857; font-size: 0.72rem; font-weight: 600; padding: 2px 8px; border-radius: 6px; border: 1px solid #A7F3D0;">
                                        <i class="bi bi-check-circle-fill me-1"></i>Đã kích hoạt
                                    </span>
                                </div>

                                <div class="p-3 mb-3" style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px;">
                                    <div class="mb-2.5">
                                        <div style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: #64748B; font-weight: 600;">Họ và tên</div>
                                        <div class="fw-bold text-dark" id="cvCandidateName" style="font-size: 0.95rem;">
                                            @(Model.CandidateProfile?.FullName ?? Model.UserFullName)
                                        </div>
                                    </div>
                                    <div class="mb-2.5">
                                        <div style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: #64748B; font-weight: 600;">Email tài khoản</div>
                                        <div class="fw-semibold text-dark text-truncate" style="font-family: 'JetBrains Mono', monospace; font-size: 0.82rem;">
                                            @Model.UserEmail
                                        </div>
                                    </div>
                                    <div class="mb-2.5">
                                        <div style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: #64748B; font-weight: 600;">Số điện thoại</div>
                                        <div class="fw-semibold text-dark" id="cvCandidatePhone" style="font-size: 0.85rem;">
                                            @(Model.CandidateProfile?.Phone ?? "Chưa cập nhật")
                                        </div>
                                    </div>
                                    <div>
                                        <div style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: #64748B; font-weight: 600;">File CV hiện tại</div>
                                        <div class="d-flex align-items-center gap-2 mt-1">
                                            <i class="bi bi-file-earmark-pdf-fill text-danger fs-5"></i>
                                            <div class="text-truncate">
                                                <div class="fw-semibold text-dark text-truncate" id="cvStatusText" style="font-size: 0.82rem;">
                                                    @(Model.CandidateProfile?.ResumeFileName ?? "Chưa có file CV")
                                                </div>
                                                <div style="font-size: 0.7rem; color: #94A3B8;">
                                                    Cập nhật: <span id="cvUpdatedAt">@(Model.CandidateProfile?.ResumeUpdatedAt ?? "Gần đây")</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <button type="button" class="btn btn-outline-success w-100 fw-semibold py-2" style="border-radius: 8px; font-size: 0.85rem;" data-bs-toggle="modal" data-bs-target="#updateCvModal">
                                    <i class="bi bi-cloud-arrow-up me-1.5"></i> Cập nhật CV &amp; Thông tin
                                </button>
                            </div>
                        </div>

                        <div class="col-12 col-lg-4">
                            <!-- Card Hướng Dẫn & Kênh Hỗ Trợ Tuyển Dụng -->
                            <div class="card border-0 shadow-sm p-4 bg-white" style="border: 1px solid #E2E8F0 !important; border-radius: 12px;">
                                <div class="d-flex align-items-center gap-2 mb-3 pb-2" style="border-bottom: 1px solid #F1F5F9;">
                                    <i class="bi bi-headset" style="color: #059669; font-size: 1.1rem;"></i>
                                    <h6 class="fw-bold text-dark mb-0" style="font-size: 0.95rem;">Hỗ Trợ Ứng Viên NoveraTech</h6>
                                </div>
                                <p style="font-size: 0.8rem; color: #64748B; line-height: 1.5;" class="mb-3">
                                    Bộ phận Tuyển dụng luôn sẵn sàng giải đáp thắc mắc về các vòng phỏng vấn, chính sách phúc lợi và thủ tục tiếp nhận.
                                </p>
                                <div class="d-flex flex-column gap-2 mb-3" style="font-size: 0.8rem;">
                                    <div class="d-flex align-items-center gap-2 text-dark">
                                        <i class="bi bi-envelope text-muted"></i>
                                        <span>tuyendung@noveratech.com</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 text-dark">
                                        <i class="bi bi-telephone text-muted"></i>
                                        <span>(024) 3856 9999 (Máy lẻ: 104)</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 text-dark">
                                        <i class="bi bi-clock text-muted"></i>
                                        <span>Thứ Hai – Thứ Sáu (08:30 – 17:30)</span>
                                    </div>
                                </div>
                                <div class="p-2.5" style="background: #F1F5F9; border-radius: 8px; font-size: 0.75rem; color: #475569;">
                                    <i class="bi bi-info-circle me-1" style="color: #059669;"></i>
                                    Mọi thông báo lịch phỏng vấn và kết quả sẽ được gửi tự động qua email của bạn.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. TÍNH NĂNG TIẾN ĐỘ ỨNG TUYỂN & PHỎNG VẤN (TIEN-DO) -->
                <div class="candidate-feature-panel @(activeFeature == "tien-do" ? "" : "d-none")" data-feature-panel="tien-do">
                    <div id="feature-section-candidate-tien-do" class="card border-0 shadow-sm p-4 bg-white mb-4" style="border: 1px solid #E2E8F0 !important; border-radius: 12px;">
                        @if (Model.ActiveApplication != null)
                        {
                            <!-- Application Header -->
                            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 pb-3 gap-2" style="border-bottom: 1px solid #F1F5F9;">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span style="font-size: 0.75rem; color: #64748B;">Mã hồ sơ:</span>
                                        <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; font-weight: 700; color: #0F172A; background: #F1F5F9; padding: 1px 6px; border-radius: 4px;">
                                            @Model.ActiveApplication.ApplicationCode
                                        </span>
                                    </div>
                                    <h5 class="fw-bold text-dark mb-0" style="font-size: 1.15rem;">
                                        @Model.ActiveApplication.JobTitle
                                    </h5>
                                </div>
                                <div class="text-sm-end">
                                    <span style="background: #ECFDF5; color: #047857; font-size: 0.8rem; font-weight: 700; padding: 4px 12px; border-radius: 6px; border: 1px solid #A7F3D0; display: inline-block;">
                                        @Model.ActiveApplication.CurrentStageName
                                    </span>
                                </div>
                            </div>

                            <!-- Connected Step Tracker (Clean Line Stepper) -->
                            <div class="mb-4 pt-1 pb-3">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #64748B;">
                                        Tiến độ xét tuyển hồ sơ
                                    </span>
                                    <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; font-weight: 700; color: #059669;">
                                        @(Model.ActiveApplication.ProgressPercentage)% Hoàn thành
                                    </span>
                                </div>
                                <div class="progress" style="height: 6px; background-color: #E2E8F0; border-radius: 999px;">
                                    <div class="progress-bar" role="progressbar" style="width: @(Model.ActiveApplication.ProgressPercentage)%; background-color: #059669; border-radius: 999px;" aria-valuenow="@Model.ActiveApplication.ProgressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>

                                <!-- Step Nodes Grid -->
                                <div class="d-grid mt-3" style="grid-template-columns: repeat(@Model.ActiveApplication.Steps.Count, 1fr); gap: 0.75rem;">
                                    @foreach (var step in Model.ActiveApplication.Steps)
                                    {
                                        var isDone = step.Status == "completed";
                                        var isActive = step.Status == "active";
                                        <div class="text-center">
                                            <div class="d-inline-flex align-items-center justify-content-center fw-bold mb-1.5"
                                                 style="width: 28px; height: 28px; border-radius: 50%; font-size: 0.75rem; transition: all .2s;
                                                        @(isDone ? "background:#059669; color:#fff;" : (isActive ? "background:#0F172A; color:#fff; box-shadow: 0 0 0 3px #A7F3D0;" : "background:#F1F5F9; color:#94A3B8; border:1px solid #CBD5E1;"))">
                                                @if (isDone)
                                                {
                                                    <i class="bi bi-check-lg" style="font-size: 0.9rem;"></i>
                                                }
                                                else
                                                {
                                                    <span>@step.StepNumber</span>
                                                }
                                            </div>
                                            <div class="fw-semibold text-truncate px-1" style="font-size: 0.78rem; color: @(isActive ? "#0F172A" : (isDone ? "#059669" : "#64748B"));">
                                                @step.StepName
                                            </div>
                                            <div class="text-truncate px-1" style="font-size: 0.7rem; color: @(isActive ? "#059669" : "#94A3B8");">
                                                @step.Subtitle
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Phỏng vấn / Sự kiện Google Meet (Thẻ chuẩn mực Enterprise Event Ticket) -->
                            @if (Model.CandidateInterview != null)
                            {
                                <div class="p-3.5 mb-0 mt-auto" style="background: #F8FAFC; border: 1px solid #CBD5E1; border-left: 4px solid #059669; border-radius: 8px;">
                                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-3 pb-2 gap-2" style="border-bottom: 1px solid #E2E8F0;">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-calendar2-check-fill" style="color: #059669; font-size: 1.15rem;"></i>
                                            <div>
                                                <span class="fw-bold text-dark" style="font-size: 0.95rem;">@Model.CandidateInterview.RoundTitle</span>
                                                <span style="font-size: 0.75rem; color: #64748B;" class="ms-2">· Hình thức Trực tuyến</span>
                                            </div>
                                        </div>
                                        <span style="background: #ECFDF5; color: #047857; font-size: 0.75rem; font-weight: 700; padding: 2px 10px; border-radius: 6px; border: 1px solid #A7F3D0;">
                                            <i class="bi bi-dot"></i><span id="candidateInterviewStatusText">@Model.CandidateInterview.StatusDisplay</span>
                                        </span>
                                    </div>

                                    <div class="row g-2 mb-3" style="font-size: 0.82rem;">
                                        <div class="col-12 col-sm-6">
                                            <div style="font-size: 0.7rem; text-transform: uppercase; color: #64748B; font-weight: 600;">Thời gian phỏng vấn</div>
                                            <div class="fw-bold text-dark mt-0.5" style="font-family: 'JetBrains Mono', monospace;">
                                                <i class="bi bi-clock me-1" style="color: #059669;"></i>@Model.CandidateInterview.TimeDisplay, @Model.CandidateInterview.DateDisplay
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6">
                                            <div style="font-size: 0.7rem; text-transform: uppercase; color: #64748B; font-weight: 600;">Hội đồng chuyên môn</div>
                                            <div class="fw-semibold text-dark mt-0.5">
                                                <i class="bi bi-people me-1" style="color: #059669;"></i>@Model.CandidateInterview.PanelistNames
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div style="font-size: 0.7rem; text-transform: uppercase; color: #64748B; font-weight: 600;">Đường link phòng họp (Google Meet)</div>
                                            <div class="fw-semibold text-dark mt-0.5 text-truncate" style="font-family: 'JetBrains Mono', monospace;">
                                                <i class="bi bi-camera-video me-1" style="color: #059669;"></i>
                                                <a href="@Model.CandidateInterview.LocationOrLink" target="_blank" class="text-decoration-none" style="color: #059669;">
                                                    @Model.CandidateInterview.LocationOrLink
                                                </a>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="d-flex flex-wrap gap-2 pt-2" style="border-top: 1px solid #E2E8F0;">
                                        <a href="@Model.CandidateInterview.LocationOrLink" target="_blank" class="btn btn-sm fw-semibold text-white px-3" style="background: #059669; border-radius: 8px; font-size: 0.8rem;">
                                            <i class="bi bi-box-arrow-up-right me-1"></i> Vào phòng họp Google Meet
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-success px-3 fw-semibold" style="border-radius: 8px; font-size: 0.8rem;" onclick="confirmCandidateInterview('@Model.CandidateInterview.InterviewId')">
                                            <i class="bi bi-check2-circle me-1"></i> Xác nhận tham gia
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary px-3" style="border-radius: 8px; font-size: 0.8rem;" onclick="requestReschedulePrompt('@Model.CandidateInterview.InterviewId')">
                                            <i class="bi bi-calendar-x me-1"></i> Yêu cầu đổi giờ hẹn
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="p-3 mb-0 mt-auto" style="background: #F8FAFC; border: 1px dashed #CBD5E1; border-radius: 8px; font-size: 0.82rem; color: #475569;">
                                    <i class="bi bi-info-circle me-1.5" style="color: #059669;"></i>
                                    Hồ sơ của bạn đang được bộ phận chuyên môn xem xét. Lịch phỏng vấn chi tiết sẽ được cập nhật tại đây và gửi qua email ngay khi hội đồng hoàn tất xếp lịch.
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-5 my-auto">
                                <div class="d-inline-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px; background: #ECFDF5; border-radius: 12px;">
                                    <i class="bi bi-briefcase" style="font-size: 1.75rem; color: #059669;"></i>
                                </div>
                                <h5 class="fw-bold text-dark mb-1">Bạn chưa nộp hồ sơ ứng tuyển nào</h5>
                                <p class="text-muted small mb-4">Khám phá các vị trí tuyển dụng đang mở của NoveraTech bên dưới và nộp đơn ngay hôm nay!</p>
                                <button type="button" class="btn btn-success fw-semibold px-4 py-2" style="border-radius: 8px;" onclick="switchDashboardFeature('viec-lam', event)">
                                    <i class="bi bi-briefcase me-1"></i> Xem danh sách vị trí đang mở
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <!-- 4. TÍNH NĂNG KHÁM PHÁ VIỆC LÀM (VIEC-LAM) -->
                <div class="candidate-feature-panel @(activeFeature == "viec-lam" ? "" : "d-none")" data-feature-panel="viec-lam">
                    <div id="feature-section-candidate-viec-lam" class="card border-0 shadow-sm p-4 bg-white mb-4" style="border: 1px solid #E2E8F0 !important; border-radius: 12px;">
                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-2 pb-3" style="border-bottom: 1px solid #F1F5F9;">
                            <div>
                                <h5 class="fw-bold text-dark mb-0" style="font-size: 1.1rem;">
                                    Các Vị Trí Đang Tuyển Dụng Tại NoveraTech
                                </h5>
                                <div class="text-muted small mt-0.5">Môi trường công nghệ tiêu chuẩn cao, chế độ đãi ngộ cạnh tranh hàng đầu thị trường</div>
                            </div>
                            <a href="/Jobs" class="btn btn-outline-success btn-sm fw-semibold px-3 py-1.5" style="border-radius: 8px; font-size: 0.8rem;">
                                <i class="bi bi-grid me-1"></i> Xem tất cả @Model.CandidateOpenJobs.Count vị trí
                            </a>
                        </div>

                        <div class="row g-3">
                            @foreach (var job in Model.CandidateOpenJobs)
                            {
                                <div class="col-12 col-md-6">
                                    <div class="card h-100 p-3.5 bg-white d-flex flex-column" style="border: 1px solid #E2E8F0; border-radius: 10px; transition: border-color .2s, box-shadow .2s;"
                                         onmouseover="this.style.borderColor='#A7F3D0'; this.style.boxShadow='0 4px 12px rgba(15,23,42,0.06)';"
                                         onmouseout="this.style.borderColor='#E2E8F0'; this.style.boxShadow='none';">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <span style="font-size: 0.72rem; font-weight: 600; padding: 2px 8px; border-radius: 6px;
                                                         @(job.IsHot ? "background:#FEF3C7; color:#92400E; border:1px solid #FDE68A;" : "background:#F1F5F9; color:#475569; border:1px solid #E2E8F0;")">
                                                @(job.IsHot ? "Hot Role" : job.EmploymentType)
                                            </span>
                                            <span class="fw-bold small" style="color: #059669; font-family: 'JetBrains Mono', monospace;">
                                                @job.SalaryDisplay
                                            </span>
                                        </div>
                                        <h6 class="fw-bold text-dark mb-1" style="font-size: 0.95rem; line-height: 1.35;">
                                            <a href="/Jobs/Detail/@(string.IsNullOrWhiteSpace(job.Slug) ? job.Id : job.Slug)" class="text-dark text-decoration-none"
                                               onmouseover="this.style.color='#059669';" onmouseout="this.style.color='#0F172A';">
                                                @job.Title
                                            </a>
                                        </h6>
                                        <div class="text-muted text-xs mb-2">
                                            <i class="bi bi-geo-alt me-1"></i>@job.WorkLocation · <span class="fw-semibold">@job.Department</span>
                                        </div>
                                        <p class="text-muted text-xs flex-grow-1 mb-3" style="line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                            @job.ShortSummary
                                        </p>
                                        <div class="d-flex gap-2 pt-2" style="border-top: 1px solid #F1F5F9;">
                                            <a href="/Jobs/Detail/@(string.IsNullOrWhiteSpace(job.Slug) ? job.Id : job.Slug)" class="btn btn-sm btn-outline-secondary flex-grow-1" style="border-radius: 8px; font-size: 0.8rem;">
                                                Chi tiết
                                            </a>
                                            <button type="button" class="btn btn-sm btn-success fw-semibold px-3" style="border-radius: 8px; font-size: 0.8rem;" onclick="openApplyJobModal('@job.Id', '@job.Title', '@job.Department')">
                                                <i class="bi bi-send me-1"></i> Ứng tuyển
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- ========================================== -->
            <!-- PHÂN HỆ 2: WORKSPACE DÀNH CHO NỘI BỘ (HR / LEAD / ADMIN) -->
            <!-- ========================================== -->
            <div id="staff-workspace">
                <!-- ── SUB-NAVIGATION PILL TABS BAR (RULE.MD Compliant) ── -->
                <div class="dashboard-nav-container mb-4">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 p-1.5 bg-white border"
                         style="border-color: #E2E8F0 !important; border-radius: 12px; box-shadow: 0 1px 3px rgba(15,23,42,0.04);">
                        <nav class="d-flex align-items-center gap-1.5 flex-wrap" id="dashboardFeatureTabsNav" role="tablist" aria-label="Phân hệ chức năng Dashboard">
                            <button type="button" class="dashboard-feature-tab @(activeFeature == "tong-quan" ? "active" : "")"
                                    data-feature="tong-quan"
                                    onclick="switchDashboardFeature('tong-quan', event)">
                                <i class="bi bi-grid-1x2"></i> Tổng quan
                            </button>
                            <button type="button" class="dashboard-feature-tab @(activeFeature == "ung-vien" ? "active" : "")"
                                    data-feature="ung-vien"
                                    onclick="switchDashboardFeature('ung-vien', event)">
                                <i class="bi bi-people"></i> Hồ sơ ứng viên
                                <span class="tab-counter-badge ms-1">@Model.CandidatePipelineItems.Count</span>
                            </button>
                            <button type="button" class="dashboard-feature-tab @(activeFeature == "lich-phong-van" ? "active" : "")"
                                    data-feature="lich-phong-van"
                                    onclick="switchDashboardFeature('lich-phong-van', event)">
                                <i class="bi bi-calendar3"></i> Lịch phỏng vấn
                                <span class="tab-counter-badge ms-1">@Model.UpcomingInterviews.Count</span>
                            </button>
                            <button type="button" class="dashboard-feature-tab @(activeFeature == "phe-duyet" ? "active" : "")"
                                    data-feature="phe-duyet"
                                    onclick="switchDashboardFeature('phe-duyet', event)">
                                <i class="bi bi-patch-check"></i> Phê duyệt Offer
                                <span class="tab-counter-badge ms-1 @(Model.PendingOffers.Any() ? "badge-warning-highlight" : "")">@Model.PendingOffers.Count</span>
                            </button>
                            <button type="button" class="dashboard-feature-tab @(activeFeature == "tac-vu" ? "active" : "")"
                                    data-feature="tac-vu"
                                    onclick="switchDashboardFeature('tac-vu', event)">
                                <i class="bi bi-lightning-charge"></i> Tác vụ nhanh
                            </button>
                        </nav>

                        <!-- Quick Role Action Buttons -->
                        <div class="d-flex align-items-center gap-2 ms-auto">
                            @if (User.IsInRole(UserRoles.Admin) || User.IsInRole(UserRoles.HRManager) || User.IsInRole(UserRoles.Recruiter))
                            {
                                <a href="/Jobs/Create" class="btn btn-sm btn-success fw-semibold d-inline-flex align-items-center gap-1.5"
                                   style="border-radius: 8px; font-size: 0.8rem; padding: 0.38rem 0.85rem; background: #059669; border-color: #059669;">
                                    <i class="bi bi-plus-lg"></i> Đăng tin mới
                                </a>
                            }
                            @if (User.IsInRole(UserRoles.HiringManager) || User.IsInRole(UserRoles.Admin))
                            {
                                <button type="button" class="btn btn-sm btn-light border fw-semibold d-inline-flex align-items-center gap-1.5"
                                        style="border-radius: 8px; font-size: 0.8rem; padding: 0.38rem 0.85rem; border-color: #E2E8F0; color: #334155;"
                                        data-bs-toggle="modal" data-bs-target="#createRequisitionModal">
                                    <i class="bi bi-file-earmark-plus text-warning"></i> Đề xuất nhân sự
                                </button>
                            }
                        </div>
                    </div>
                </div>

                <!-- ============================================================== -->
                <!-- 1. TÍNH NĂNG TỔNG QUAN (TONG-QUAN): KPI + EXECUTIVE OVERVIEW -->
                <!-- ============================================================== -->
                <div class="staff-feature-panel @(activeFeature == "tong-quan" ? "" : "d-none")" data-feature-panel="tong-quan">
                    <!-- Hàng 4 Thẻ KPI Tương Tác Hiện Đại -->
                    <div id="feature-section-staff-tong-quan" class="row g-3 mb-4 scroll-margin-nav">
                        <!-- KPI 1: Vị trí đang mở -->
                        <div class="col-6 col-lg-3">
                            <a href="/Jobs" class="dashboard-kpi-card text-decoration-none d-block">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #64748B;">
                                        Vị trí đang mở
                                    </span>
                                    <div class="kpi-icon-box" style="background: #ECFDF5; color: #059669;">
                                        <i class="bi bi-briefcase"></i>
                                    </div>
                                </div>
                                <div id="kpiOpenJobs" style="font-size: 2rem; font-weight: 700; font-family: 'JetBrains Mono', monospace; color: #0F172A; line-height: 1.1;">
                                    @Model.TotalOpenJobs
                                </div>
                                <div class="d-flex align-items-center justify-content-between mt-2 pt-1 border-top" style="border-color: #F1F5F9 !important;">
                                    <span style="font-size: 0.72rem; color: #64748B;">Tin đang hoạt động</span>
                                    <span style="font-size: 0.72rem; color: #059669; font-weight: 600;">Xem chi tiết &rarr;</span>
                                </div>
                            </a>
                        </div>

                        <!-- KPI 2: Hồ sơ tiếp nhận -->
                        <div class="col-6 col-lg-3">
                            <div class="dashboard-kpi-card cursor-pointer" onclick="switchDashboardFeature('ung-vien', event); filterPipelineCandidates('ALL');">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #64748B;">
                                        Hồ sơ tiếp nhận
                                    </span>
                                    <div class="kpi-icon-box" style="background: #EFF6FF; color: #2563EB;">
                                        <i class="bi bi-file-earmark-person"></i>
                                    </div>
                                </div>
                                <div id="kpiTotalApps" style="font-size: 2rem; font-weight: 700; font-family: 'JetBrains Mono', monospace; color: #0F172A; line-height: 1.1;">
                                    @Model.TotalApplications
                                </div>
                                <div class="d-flex align-items-center justify-content-between mt-2 pt-1 border-top" style="border-color: #F1F5F9 !important;">
                                    <span style="font-size: 0.72rem; color: #64748B;">Toàn bộ ứng viên</span>
                                    <span style="font-size: 0.72rem; color: #2563EB; font-weight: 600;">Quản lý &rarr;</span>
                                </div>
                            </div>
                        </div>

                        <!-- KPI 3: Phỏng vấn tuần này -->
                        <div class="col-6 col-lg-3">
                            <div class="dashboard-kpi-card cursor-pointer" onclick="switchDashboardFeature('lich-phong-van', event);">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #64748B;">
                                        Phỏng vấn tuần này
                                    </span>
                                    <div class="kpi-icon-box" style="background: #F5F3FF; color: #7C3AED;">
                                        <i class="bi bi-calendar2-event"></i>
                                    </div>
                                </div>
                                <div id="kpiInterviews" style="font-size: 2rem; font-weight: 700; font-family: 'JetBrains Mono', monospace; color: #0F172A; line-height: 1.1;">
                                    @Model.TotalInterviewsThisWeek
                                </div>
                                <div class="d-flex align-items-center justify-content-between mt-2 pt-1 border-top" style="border-color: #F1F5F9 !important;">
                                    <span style="font-size: 0.72rem; color: #64748B;">Phiên họp đã xếp</span>
                                    <span style="font-size: 0.72rem; color: #7C3AED; font-weight: 600;">Xem lịch &rarr;</span>
                                </div>
                            </div>
                        </div>

                        <!-- KPI 4: Offer chờ duyệt -->
                        <div class="col-6 col-lg-3">
                            <div class="dashboard-kpi-card cursor-pointer" onclick="switchDashboardFeature('phe-duyet', event);">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #64748B;">
                                        Offer chờ duyệt
                                    </span>
                                    <div class="kpi-icon-box" style="background: @(Model.TotalPendingOffers > 0 ? "#FEF3C7" : "#F8FAFC"); color: @(Model.TotalPendingOffers > 0 ? "#D97706" : "#64748B");">
                                        <i class="bi bi-patch-check"></i>
                                    </div>
                                </div>
                                <div id="kpiPendingOffers" style="font-size: 2rem; font-weight: 700; font-family: 'JetBrains Mono', monospace; color: @(Model.TotalPendingOffers > 0 ? "#D97706" : "#0F172A"); line-height: 1.1;">
                                    @Model.TotalPendingOffers
                                </div>
                                <div class="d-flex align-items-center justify-content-between mt-2 pt-1 border-top" style="border-color: #F1F5F9 !important;">
                                    <span style="font-size: 0.72rem; color: @(Model.TotalPendingOffers > 0 ? "#D97706" : "#64748B"); font-weight: @(Model.TotalPendingOffers > 0 ? "600" : "normal");">
                                        @(Model.TotalPendingOffers > 0 ? "Cần Ban Giám Đốc duyệt" : "Không tồn đọng")
                                    </span>
                                    <span style="font-size: 0.72rem; color: @(Model.TotalPendingOffers > 0 ? "#D97706" : "#64748B"); font-weight: 600;">Xử lý &rarr;</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- BỐ CỤC EXECUTIVE OVERVIEW (8 Cột Phễu + Ứng viên mới, 4 Cột Hàng đợi duyệt + Tác vụ) -->
                    <div class="row g-4 mb-4">
                        <div class="col-12 col-xl-8 d-flex flex-column gap-4">
                            <!-- Phễu Tuyển Dụng Tuyến Tính (Linear Pipeline & Funnel Distribution) -->
                            <div class="card border-0 shadow-sm p-4 pipeline-funnel-card">
                                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-3 pb-2 gap-2" style="border-bottom: 1px solid #F1F5F9;">
                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <h5 class="fw-bold text-dark mb-0" style="font-size: 1.05rem;">
                                                <i class="bi bi-funnel text-success me-1"></i>Phễu Tuyển Dụng Tuyến Tính
                                            </h5>
                                            <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle rounded-pill" style="font-size: 0.72rem; font-weight: 600;">
                                                @Model.PipelineFunnel.Where(s => !s.IsTerminal).Sum(s => s.Count) đang xử lý
                                            </span>
                                        </div>
                                        <small class="text-muted">Nhấp vào từng giai đoạn để lọc nhanh danh sách ứng viên tương ứng</small>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        @{
                                            var rejectedStage = Model.PipelineFunnel.FirstOrDefault(s => s.IsTerminal);
                                        }
                                        @if (rejectedStage != null)
                                        {
                                            <button type="button" class="btn btn-outline-danger btn-sm fw-semibold d-inline-flex align-items-center gap-1.5"
                                                    style="border-radius: 8px; font-size: 0.78rem; padding: 0.35rem 0.65rem;"
                                                    onclick="switchDashboardFeature('ung-vien', event); setTimeout(function() { filterPipelineCandidates('REJECTED'); }, 50);"
                                                    title="Xem ứng viên đã từ chối hoặc rớt tuyển">
                                                <span class="rounded-circle" style="width: 7px; height: 7px; background: #E11D48;"></span>
                                                Đã từ chối (@rejectedStage.Count)
                                            </button>
                                        }
                                        <button type="button" class="btn btn-outline-success btn-sm fw-semibold" style="border-radius: 8px; font-size: 0.78rem; padding: 0.35rem 0.65rem;" onclick="switchDashboardFeature('ung-vien', event); filterPipelineCandidates('ALL');">
                                            <i class="bi bi-people me-1"></i> Quản lý hồ sơ &rarr;
                                        </button>
                                    </div>
                                </div>

                                <!-- Thanh tiến trình tỷ lệ chuyển đổi (Funnel Conversion Bar) -->
                                <div class="pipeline-conversion-track" title="Tỷ lệ phân bổ hồ sơ qua các giai đoạn">
                                    @foreach (var stage in Model.PipelineFunnel.Where(s => !s.IsTerminal))
                                    {
                                        if (stage.Percentage > 0)
                                        {
                                            <div class="pipeline-conversion-segment" 
                                                 style="width: @stage.Percentage%; background-color: @stage.ColorCode;"
                                                 data-bs-toggle="tooltip"
                                                 title="@stage.StageName: @stage.Count hồ sơ (@stage.Percentage%)">
                                            </div>
                                        }
                                    }
                                </div>

                                <!-- 6 Bước Tuyến Tính Gọn Gàng - Vừa Khít 100% Không Cuộn Ngang -->
                                <div class="pipeline-steps-grid">
                                    @foreach (var stage in Model.PipelineFunnel.Where(s => !s.IsTerminal))
                                    {
                                        <div class="pipeline-step-item cursor-pointer"
                                             style="--stage-color: @stage.ColorCode;"
                                             onclick="switchDashboardFeature('ung-vien', event); setTimeout(function() { filterPipelineCandidates('@stage.StageOrder'); }, 50);"
                                             title="Giai đoạn @stage.StageOrder: @stage.StageName (@stage.Subtitle) — Bấm để lọc danh sách">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <span class="step-badge" style="background-color: @(stage.ColorCode)15; color: @stage.ColorCode;">
                                                    @stage.StageOrder.ToString("D2")
                                                </span>
                                                <span class="step-pct">@stage.Percentage%</span>
                                            </div>
                                            <div class="step-title" title="@stage.StageName">
                                                @(string.IsNullOrWhiteSpace(stage.ShortName) ? stage.StageName : stage.ShortName)
                                            </div>
                                            <div class="d-flex align-items-baseline gap-1">
                                                <span class="step-count">@stage.Count</span>
                                                <span class="step-unit">hồ sơ</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Hồ Sơ Ứng Viên Mới Nhất -->
                            <div class="card border-0 shadow-sm p-4 bg-white" style="border: 1px solid #E2E8F0 !important; border-radius: 12px;">
                                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-3 pb-2 gap-2" style="border-bottom: 1px solid #F1F5F9;">
                                    <div>
                                        <h5 class="fw-bold text-dark mb-0" style="font-size: 1.05rem;">
                                            <i class="bi bi-clock-history me-1.5 text-success"></i>Hồ Sơ Ứng Tuyển Mới Nhất
                                        </h5>
                                        <small class="text-muted">Các ứng viên tiếp nhận gần đây cần sàng lọc và xử lý quy trình</small>
                                    </div>
                                    <button type="button" class="btn btn-outline-primary btn-sm fw-semibold" style="border-radius: 8px; font-size: 0.78rem;" onclick="switchDashboardFeature('ung-vien', event); filterPipelineCandidates('ALL');">
                                        <i class="bi bi-people me-1"></i> Xem tất cả @Model.CandidatePipelineItems.Count ứng viên &rarr;
                                    </button>
                                </div>
                                <div class="dashboard-table-responsive">
                                    <table class="table align-middle mb-0" style="min-width: 700px; font-size: 0.85rem;">
                                        <thead>
                                            <tr style="border-bottom: 1px solid #E2E8F0; color: #64748B; font-size: 0.72rem; text-transform: uppercase;">
                                                <th class="py-2.5 px-3 bg-light border-0 fw-semibold">Ứng viên</th>
                                                <th class="py-2.5 px-3 bg-light border-0 fw-semibold">Vị trí</th>
                                                <th class="py-2.5 px-3 bg-light border-0 fw-semibold">Giai đoạn</th>
                                                <th class="py-2.5 px-3 bg-light border-0 fw-semibold">Ngày nộp</th>
                                                <th class="py-2.5 px-3 bg-light border-0 fw-semibold text-end">Thao tác</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.CandidatePipelineItems.Any())
                                            {
                                                @foreach (var cand in Model.CandidatePipelineItems.Take(5))
                                                {
                                                    <tr style="border-bottom: 1px solid #F1F5F9;">
                                                        <td class="py-2.5 px-3">
                                                            <div class="fw-bold text-dark" style="font-size: 0.85rem;">@cand.CandidateName</div>
                                                            <div class="text-muted" style="font-size: 0.72rem; font-family:'JetBrains Mono',monospace;">@cand.CandidateEmail</div>
                                                        </td>
                                                        <td class="py-2.5 px-3 fw-semibold text-dark">@cand.JobTitle</td>
                                                        <td class="py-2.5 px-3">
                                                            <span class="badge" style="background:@(cand.StageColor)15; color:@cand.StageColor; border:1px solid @(cand.StageColor)40; border-radius:6px; font-size:0.72rem; font-weight:600;">
                                                                @cand.CurrentStageName
                                                            </span>
                                                        </td>
                                                        <td class="py-2.5 px-3 text-muted" style="font-size: 0.75rem; font-family:'JetBrains Mono',monospace;">@cand.AppliedDateDisplay</td>
                                                        <td class="py-2.5 px-3 text-end">
                                                            <button type="button" class="btn btn-sm btn-light border py-1 px-2.5" style="font-size: 0.75rem; border-radius: 8px;" onclick="openCandidateDetailModal('@cand.ApplicationId')">
                                                                <i class="bi bi-eye text-muted me-1"></i> Chi tiết
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="5" class="text-center text-muted py-3">Chưa có ứng viên nào ứng tuyển.</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-xl-4 d-flex flex-column gap-4">
                            <!-- Pending Approvals Alert Card -->
                            <div class="card border-0 shadow-sm p-4 bg-white" style="border: 1px solid #E2E8F0 !important; border-radius: 12px;">
                                <div class="d-flex align-items-center justify-content-between mb-3 pb-2" style="border-bottom: 1px solid #F1F5F9;">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-patch-check" style="color: #059669; font-size: 1.15rem;"></i>
                                        <h6 class="fw-bold text-dark mb-0" style="font-size: 0.95rem;">Hàng Đợi Phê Duyệt</h6>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-link text-success p-0 text-decoration-none fw-semibold" style="font-size: 0.78rem;" onclick="switchDashboardFeature('phe-duyet', event)">
                                        Xem tất cả (@Model.PendingOffers.Count) &rarr;
                                    </button>
                                </div>
                                @if (Model.PendingOffers.Any())
                                {
                                    <div class="d-flex flex-column gap-2 mb-2">
                                        @foreach (var offer in Model.PendingOffers.Take(3))
                                        {
                                            <div class="p-2.5" style="background: #F8FAFC; border: 1px solid #E2E8F0; border-left: 3px solid #D97706; border-radius: 8px;">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <span class="fw-bold text-dark" style="font-size: 0.85rem;">@offer.CandidateName</span>
                                                    <span class="fw-bold text-success font-mono" style="font-size: 0.75rem;">@offer.SalaryDisplay</span>
                                                </div>
                                                <div class="text-muted" style="font-size: 0.75rem;">Vị trí: <b class="text-dark">@offer.JobTitle</b></div>
                                            </div>
                                        }
                                    </div>
                                    <button type="button" class="btn btn-sm btn-warning w-100 fw-semibold text-dark mt-2" style="border-radius: 8px; font-size: 0.78rem;" onclick="switchDashboardFeature('phe-duyet', event)">
                                        <i class="bi bi-patch-check me-1"></i> Xử lý @Model.PendingOffers.Count thư mời đang chờ
                                    </button>
                                }
                                else
                                {
                                    <div class="p-3 text-center" style="background: #F8FAFC; border: 1px dashed #CBD5E1; border-radius: 8px;">
                                        <i class="bi bi-check2-circle text-success fs-5 d-block mb-1"></i>
                                        <div class="fw-semibold text-dark small">Không có hồ sơ tồn đọng</div>
                                        <div style="font-size: 0.72rem; color: #64748B;">Mọi đề xuất đã được giải quyết.</div>
                                    </div>
                                }
                            </div>

                            <!-- Tác vụ nhanh Shortcuts -->
                            <div class="card border-0 shadow-sm p-4 bg-white" style="border: 1px solid #E2E8F0 !important; border-radius: 12px;">
                                <div class="d-flex align-items-center justify-content-between mb-3 pb-2" style="border-bottom: 1px solid #F1F5F9;">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-lightning-charge" style="color: #059669; font-size: 1.15rem;"></i>
                                        <h6 class="fw-bold text-dark mb-0" style="font-size: 0.95rem;">Lối Tắt Tác Vụ</h6>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-link text-success p-0 text-decoration-none fw-semibold" style="font-size: 0.78rem;" onclick="switchDashboardFeature('tac-vu', event)">
                                        Xem tất cả &rarr;
                                    </button>
                                </div>
                                <div class="d-flex flex-column gap-2">
                                    <a href="/Jobs/Create" class="btn w-100 text-start p-2 d-flex align-items-center justify-content-between text-decoration-none" style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px;">
                                        <span class="small fw-semibold text-dark"><i class="bi bi-megaphone-fill text-success me-2"></i>Đăng tin tuyển dụng mới</span>
                                        <i class="bi bi-chevron-right text-muted small"></i>
                                    </a>
                                    <button type="button" class="btn w-100 text-start p-2 d-flex align-items-center justify-content-between" style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px;" data-bs-toggle="modal" data-bs-target="#createRequisitionModal">
                                        <span class="small fw-semibold text-dark"><i class="bi bi-file-earmark-plus-fill text-warning me-2"></i>Đề xuất nhân sự phòng ban</span>
                                        <i class="bi bi-chevron-right text-muted small"></i>
                                    </button>
                                    <button type="button" class="btn w-100 text-start p-2 d-flex align-items-center justify-content-between" style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px;" data-bs-toggle="modal" data-bs-target="#interviewEvaluationModal">
                                        <span class="small fw-semibold text-dark"><i class="bi bi-clipboard2-check-fill text-success me-2"></i>Nhập phiếu đánh giá ứng viên</span>
                                        <i class="bi bi-chevron-right text-muted small"></i>
                                    </button>
                                    @if (User.IsInRole(UserRoles.Admin))
                                    {
                                        <a asp-controller="Users" asp-action="Index" class="btn w-100 text-start p-2 d-flex align-items-center justify-content-between text-decoration-none" style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px;">
                                            <span class="small fw-semibold text-dark"><i class="bi bi-people-fill text-danger me-2"></i>Quản trị tài khoản hệ thống</span>
                                            <i class="bi bi-chevron-right text-muted small"></i>
                                        </a>
                                    }
                                </div>
                            </div>

                            <!-- Quy chuẩn bảo mật -->
                            <div class="card border-0 shadow-sm p-3 bg-white" style="border: 1px solid #E2E8F0 !important; border-radius: 12px;">
                                <div class="d-flex align-items-center gap-2 mb-1.5 pb-1.5 border-bottom">
                                    <i class="bi bi-shield-lock text-success"></i>
                                    <h6 class="fw-bold text-dark mb-0" style="font-size: 0.85rem;">Quy Chuẩn An Toàn & Bảo Mật</h6>
                                </div>
                                <p class="text-muted mb-0" style="font-size: 0.72rem; line-height: 1.5;">
                                    Mọi hành động chuyển giai đoạn, xếp lịch và duyệt offer đều được ghi nhận Audit Log. Dữ liệu ứng viên được bảo mật tuyệt đối.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ============================================================== -->
                <!-- 2. TÍNH NĂNG QUẢN LÝ ỨNG VIÊN (UNG-VIEN: FULL WIDTH) -->
                <!-- ============================================================== -->
                <div class="staff-feature-panel @(activeFeature == "ung-vien" ? "" : "d-none")" data-feature-panel="ung-vien">
                    <div id="feature-section-staff-ung-vien" class="card border-0 shadow-sm p-4 bg-white mb-4 scroll-margin-nav" style="border: 1px solid #E2E8F0 !important; border-radius: 12px;">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 pb-2 gap-2" style="border-bottom: 1px solid #F1F5F9;">
                            <div>
                                <h5 class="fw-bold text-dark mb-0" style="font-size: 1.15rem;">
                                    <i class="bi bi-people-fill me-2" style="color: #059669;"></i>Quản Lý Hồ Sơ &amp; Tiến Trình Tuyển Dụng
                                </h5>
                                <small class="text-muted">Chuyển tiếp giai đoạn tuyển chọn, lên lịch phỏng vấn, thẩm định và phát hành offer trực tiếp</small>
                            </div>
                            <div class="d-flex align-items-center gap-2 w-100 w-md-auto">
                                <div class="input-group input-group-sm position-relative" style="max-width: 320px;">
                                    <span class="input-group-text bg-light border-end-0" style="border-color: #E2E8F0;"><i class="bi bi-search text-muted"></i></span>
                                    <input type="text" id="candidateSearchInput" class="form-control border-start-0 pe-4" placeholder="Tìm tên, email, vị trí... (từ 3 ký tự)" style="border-color: #E2E8F0; font-size: 0.82rem;" autocomplete="off" />
                                    <button type="button" id="candidateSearchClearBtn" class="btn btn-sm btn-link position-absolute top-50 end-0 translate-middle-y me-1 text-muted d-none" style="text-decoration:none; z-index: 5;" title="Xóa từ khóa">
                                        <i class="bi bi-x-circle-fill"></i>
                                    </button>
                                    <div id="candSearchHint" class="text-warning d-none position-absolute" style="top: 100%; left: 0; font-size: 0.72rem; white-space: nowrap; z-index: 10; padding-top: 2px;">
                                        <i class="bi bi-info-circle me-1"></i>Nhập tối thiểu 3 ký tự để tìm kiếm
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Filter Stage Pills (Segmented Chips - 8px radius) -->
                        <div class="d-flex flex-wrap gap-2 mb-3" id="candidateStageFilterGroup">
                            <button type="button" class="candidate-stage-pill active" onclick="filterPipelineCandidates('ALL', this)">
                                Tất cả <span class="pill-count">@Model.CandidatePipelineItems.Count</span>
                            </button>
                            @foreach (var stage in Model.PipelineFunnel.Where(s => !s.IsTerminal))
                            {
                                <button type="button" class="candidate-stage-pill" onclick="filterPipelineCandidates('@stage.StageOrder', this)">
                                    @stage.StageOrder.ToString("D2"). @(string.IsNullOrWhiteSpace(stage.ShortName) ? stage.StageName : stage.ShortName) <span class="pill-count">@Model.CandidatePipelineItems.Count(x => x.CurrentStageOrder == stage.StageOrder)</span>
                                </button>
                            }
                            <button type="button" class="candidate-stage-pill" onclick="filterPipelineCandidates('REJECTED', this)">
                                Đã từ chối <span class="pill-count">@Model.CandidatePipelineItems.Count(x => x.Status == "REJECTED")</span>
                            </button>
                        </div>

                        <div class="dashboard-table-responsive">
                            <table class="table align-middle mb-0" style="min-width: 900px; font-size: 0.85rem;">
                                <thead>
                                    <tr style="border-bottom: 1px solid #E2E8F0; color: #64748B; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;">
                                        <th class="py-2.5 px-3 bg-light border-0 fw-semibold" style="border-top-left-radius: 8px; border-bottom-left-radius: 8px;">Ứng viên</th>
                                        <th class="py-2.5 px-3 bg-light border-0 fw-semibold">Vị trí ứng tuyển</th>
                                        <th class="py-2.5 px-3 bg-light border-0 fw-semibold">Giai đoạn hiện tại</th>
                                        <th class="py-2.5 px-3 bg-light border-0 fw-semibold">Ngày nộp</th>
                                        <th class="py-2.5 px-3 bg-light border-0 fw-semibold text-end" style="border-top-right-radius: 8px; border-bottom-right-radius: 8px;">Thao tác xử lý quy trình</th>
                                    </tr>
                                </thead>
                                <tbody id="candidatePipelineTableBody">
                                    @if (Model.CandidatePipelineItems.Any())
                                    {
                                        @foreach (var cand in Model.CandidatePipelineItems)
                                        {
                                            <tr id="cand-row-@cand.ApplicationId" class="pipeline-candidate-row"
                                                data-stage-order="@cand.CurrentStageOrder"
                                                data-status="@cand.Status"
                                                data-name="@cand.CandidateName.ToLower()"
                                                data-email="@cand.CandidateEmail.ToLower()"
                                                data-job="@cand.JobTitle.ToLower()"
                                                style="border-bottom: 1px solid #F1F5F9; transition: background .15s;"
                                                onmouseover="this.style.background='#F8FAFC';" onmouseout="this.style.background='#FFFFFF';">
                                                <td class="py-3 px-3">
                                                    <div class="d-flex align-items-center gap-2.5">
                                                        <div class="d-flex align-items-center justify-content-center fw-bold text-white rounded-circle flex-shrink-0"
                                                             style="width: 36px; height: 36px; background: #0F172A; font-size: 0.85rem;">
                                                            @(string.IsNullOrEmpty(cand.CandidateName) ? "?" : cand.CandidateName.Substring(0, 1).ToUpper())
                                                        </div>
                                                        <div>
                                                            <div class="fw-bold text-dark" style="font-size: 0.9rem;">@cand.CandidateName</div>
                                                            <div class="d-flex align-items-center gap-2" style="font-size: 0.75rem; color: #64748B;">
                                                                <span style="font-family:'JetBrains Mono',monospace;">@cand.CandidateEmail</span>
                                                                @if (!string.IsNullOrEmpty(cand.CandidatePhone))
                                                                {
                                                                    <span>•</span>
                                                                    <span>@cand.CandidatePhone</span>
                                                                }
                                                                @if (!string.IsNullOrEmpty(cand.ResumeFilePath))
                                                                {
                                                                    <a href="@cand.ResumeFilePath" target="_blank" class="candidate-cv-pill ms-1" title="Xem CV đính kèm">
                                                                        <i class="bi bi-file-earmark-pdf"></i> CV
                                                                    </a>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="py-3 px-3">
                                                    <span class="fw-semibold text-dark">@cand.JobTitle</span>
                                                </td>
                                                <td class="py-3 px-3">
                                                    @if (cand.Status == "REJECTED")
                                                    {
                                                        <span class="badge" style="background:#FEE2E2; color:#DC2626; border:1px solid #FECACA; border-radius:6px; font-size:0.75rem; font-weight:600;">
                                                            <i class="bi bi-x-circle me-1"></i>Từ chối hồ sơ
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge" style="background:@(cand.StageColor)15; color:@cand.StageColor; border:1px solid @(cand.StageColor)40; border-radius:6px; font-size:0.75rem; font-weight:600;">
                                                            <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem; vertical-align: middle;"></i>@cand.CurrentStageName
                                                        </span>
                                                    }
                                                </td>
                                                <td class="py-3 px-3 text-muted" style="font-size: 0.78rem; font-family:'JetBrains Mono',monospace;">
                                                    @cand.AppliedDateDisplay
                                                </td>
                                                <td class="py-3 px-3 text-end">
                                                    <div class="d-flex justify-content-end align-items-center gap-2">
                                                        @if (cand.Status == "REJECTED")
                                                        {
                                                            <span class="badge bg-light text-muted border" style="border-radius:6px; font-size:0.72rem;">Đã lưu trữ</span>
                                                        }
                                                        else if (cand.CurrentStageOrder == 1)
                                                        {
                                                            <button type="button" class="btn btn-sm btn-outline-success candidate-action-btn-primary"
                                                                    onclick="advanceStageQuick('@cand.ApplicationId', 'Sàng lọc CV', '@cand.CandidateName')">
                                                                <i class="bi bi-arrow-right-circle"></i> Duyệt Sơ Loại
                                                            </button>
                                                        }
                                                        else if (cand.CurrentStageOrder == 2)
                                                        {
                                                            <button type="button" class="btn btn-sm btn-primary candidate-action-btn-primary" style="background:#0284C7; border-color:#0284C7;"
                                                                    onclick="openScheduleModal('@cand.ApplicationId', '@cand.CandidateName', '@cand.JobTitle')">
                                                                <i class="bi bi-calendar-plus"></i> Lên Lịch PV
                                                            </button>
                                                        }
                                                        else if (cand.CurrentStageOrder == 4)
                                                        {
                                                            <button type="button" class="btn btn-sm btn-warning text-dark candidate-action-btn-primary fw-semibold"
                                                                    onclick="openCreateOfferModal('@cand.ApplicationId', '@cand.CandidateName', '@cand.JobTitle')">
                                                                <i class="bi bi-envelope-paper-heart-fill"></i> Đề Xuất Offer
                                                            </button>
                                                        }
                                                        else if (cand.CurrentStageOrder == 5)
                                                        {
                                                            <button type="button" class="btn btn-sm btn-success candidate-action-btn-primary"
                                                                    onclick="advanceStageQuick('@cand.ApplicationId', 'Đã Onboard', '@cand.CandidateName')">
                                                                <i class="bi bi-check2-all"></i> Xác Nhận Onboard
                                                            </button>
                                                        }
                                                        else if (cand.CurrentStageOrder == 6)
                                                        {
                                                            <span class="badge" style="background:#ECFDF5; color:#047857; border:1px solid #A7F3D0; border-radius:6px; font-size:0.75rem; font-weight:600;">
                                                                <i class="bi bi-person-check-fill me-1"></i>Đã Tiếp Nhận
                                                            </span>
                                                        }

                                                        <!-- Dropdown Thao tác mở rộng (...) -->
                                                        <div class="dropdown d-inline-block">
                                                            <button type="button" class="candidate-dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" title="Thao tác khác">
                                                                <i class="bi bi-three-dots-vertical"></i>
                                                            </button>
                                                            <ul class="dropdown-menu dropdown-menu-end candidate-dropdown-menu shadow-sm">
                                                                <li>
                                                                    <a class="dropdown-item" href="javascript:void(0)" onclick="openCandidateDetailModal('@cand.ApplicationId')">
                                                                        <i class="bi bi-eye text-primary"></i> Xem chi tiết hồ sơ
                                                                    </a>
                                                                </li>
                                                                @if (!string.IsNullOrEmpty(cand.ResumeFilePath))
                                                                {
                                                                    <li>
                                                                        <a class="dropdown-item" href="@cand.ResumeFilePath" target="_blank">
                                                                            <i class="bi bi-file-earmark-pdf text-danger"></i> Xem file CV
                                                                        </a>
                                                                    </li>
                                                                }
                                                                @if (cand.CurrentStageOrder == 4)
                                                                {
                                                                    <li>
                                                                        <a class="dropdown-item" href="javascript:void(0)" onclick="openScheduleModal('@cand.ApplicationId', '@cand.CandidateName', '@cand.JobTitle')">
                                                                            <i class="bi bi-calendar-event text-info"></i> Lên lịch phỏng vấn tiếp
                                                                        </a>
                                                                    </li>
                                                                }
                                                                @if (cand.Status != "REJECTED" && cand.CurrentStageOrder != 6)
                                                                {
                                                                    <li><hr class="dropdown-divider my-1"></li>
                                                                    <li>
                                                                        <a class="dropdown-item text-danger" href="javascript:void(0)" onclick="openRejectModal('@cand.ApplicationId', '@cand.CandidateName', '@cand.JobTitle')">
                                                                            <i class="bi bi-x-circle text-danger"></i> Từ chối hồ sơ
                                                                        </a>
                                                                    </li>
                                                                }
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-4">Chưa có hồ sơ ứng viên nào trong hệ thống.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination Container for Candidate Pipeline -->
                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3 pt-3 mt-2 border-top" id="candidatePaginationContainer" style="border-color: #F1F5F9 !important;">
                            <div class="d-flex align-items-center gap-2 text-muted" style="font-size: 0.8rem;">
                                <span>Hiển thị từ <strong id="candPageStart" class="text-dark">0</strong> đến <strong id="candPageEnd" class="text-dark">0</strong> trong tổng số <strong id="candTotalRecords" class="text-dark">0</strong> ứng viên</span>
                                <span class="mx-1">•</span>
                                <label for="candPageSizeSelect" class="me-1">Mỗi trang:</label>
                                <select id="candPageSizeSelect" class="form-select form-select-sm" style="width: auto; font-size: 0.8rem; border-color: #E2E8F0; border-radius: 8px;" onchange="changeCandidatePageSize(this.value)">
                                    <option value="5">5</option>
                                    <option value="10" selected>10</option>
                                    <option value="25">25</option>
                                    <option value="50">50</option>
                                </select>
                            </div>
                            <nav aria-label="Candidate Navigation">
                                <ul class="pagination pagination-sm mb-0 gap-1" id="candPaginationUl">
                                    <!-- Rendered dynamically by JavaScript -->
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>

                <!-- ============================================================== -->
                <!-- 3. TÍNH NĂNG LỊCH PHỎNG VẤN (LICH-PHONG-VAN: FULL WIDTH) -->
                <!-- ============================================================== -->
                <div class="staff-feature-panel @(activeFeature == "lich-phong-van" ? "" : "d-none")" data-feature-panel="lich-phong-van">
                    <div id="feature-section-staff-lich-phong-van" class="card border-0 shadow-sm p-4 bg-white mb-4 scroll-margin-nav" style="border: 1px solid #E2E8F0 !important; border-radius: 12px;">
                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-3 pb-2 gap-2" style="border-bottom: 1px solid #F1F5F9;">
                            <div>
                                <h5 class="fw-bold text-dark mb-0" style="font-size: 1.15rem;">
                                    <i class="bi bi-calendar3 text-success me-2"></i>Lịch Phỏng Vấn Tuần Này (Interview Schedule)
                                </h5>
                                <small class="text-muted">Các phiên làm việc trực tuyến và đánh giá chuyên môn đã được sắp xếp trong tuần</small>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="btn btn-sm btn-primary" style="border-radius: 8px; font-size: 0.78rem; background: #059669; border-color: #059669;" onclick="switchDashboardFeature('ung-vien', event); filterPipelineCandidates('2');">
                                    <i class="bi bi-calendar-plus me-1"></i> Lên lịch phỏng vấn mới
                                </button>
                                <span style="font-size:0.75rem; font-weight:600; color:#0F172A; background:#F1F5F9; padding:0.25rem 0.75rem; border-radius:6px; font-family:'JetBrains Mono',monospace; border: 1px solid #E2E8F0;">
                                    @Model.UpcomingInterviews.Count phiên họp
                                </span>
                            </div>
                        </div>

                        <div class="dashboard-table-responsive">
                            <table class="table align-middle mb-0" style="min-width: 820px; font-size: 0.85rem;">
                                <thead>
                                    <tr style="border-bottom: 1px solid #E2E8F0; color: #64748B; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;">
                                        <th class="py-2.5 px-3 bg-light border-0 fw-semibold" style="border-top-left-radius: 8px; border-bottom-left-radius: 8px;">Ứng viên</th>
                                        <th class="py-2.5 px-3 bg-light border-0 fw-semibold">Vị trí ứng tuyển</th>
                                        <th class="py-2.5 px-3 bg-light border-0 fw-semibold">Thời gian</th>
                                        <th class="py-2.5 px-3 bg-light border-0 fw-semibold">Hội đồng</th>
                                        <th class="py-2.5 px-3 bg-light border-0 fw-semibold">Trạng thái</th>
                                        <th class="py-2.5 px-3 bg-light border-0 fw-semibold text-end" style="border-top-right-radius: 8px; border-bottom-right-radius: 8px;">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody id="interviewTableBody">
                                    @if (Model.UpcomingInterviews.Any())
                                    {
                                        @foreach (var interview in Model.UpcomingInterviews)
                                        {
                                            <tr id="interview-row-@interview.InterviewId" style="border-bottom: 1px solid #F1F5F9; transition: background .15s;"
                                                onmouseover="this.style.background='#F8FAFC';" onmouseout="this.style.background='#FFFFFF';">
                                                <td class="py-3 px-3">
                                                    <div class="d-flex align-items-center gap-2.5">
                                                        <div class="d-flex align-items-center justify-content-center fw-bold text-white rounded-circle"
                                                             style="width: 34px; height: 34px; background: #334155; font-size: 0.82rem; flex-shrink: 0;">
                                                            @interview.CandidateAvatarLetter
                                                        </div>
                                                        <div>
                                                            <div class="fw-bold text-dark" style="font-size: 0.88rem;">@interview.CandidateName</div>
                                                            <div style="font-family:'JetBrains Mono',monospace; font-size:0.75rem; color:#64748B;">@interview.CandidateEmail</div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="py-3 px-3">
                                                    <span class="fw-semibold text-dark">@interview.JobTitle</span>
                                                </td>
                                                <td class="py-3 px-3" style="font-family:'JetBrains Mono',monospace;">
                                                    <div class="fw-bold text-dark" style="font-size: 0.82rem;">
                                                        <i class="bi bi-clock me-1 text-muted"></i>@interview.TimeDisplay
                                                    </div>
                                                    <div class="text-muted" style="font-size: 0.72rem;">@interview.DateDisplay</div>
                                                </td>
                                                <td class="py-3 px-3">
                                                    <span style="background: #F1F5F9; color: #475569; font-size: 0.75rem; padding: 2px 8px; border-radius: 6px; border: 1px solid #E2E8F0;">
                                                        @interview.PanelistNames
                                                    </span>
                                                </td>
                                                <td class="py-3 px-3">
                                                    <span class="badge @interview.StatusBadgeClass" style="border-radius: 6px; font-weight: 600; font-size: 0.72rem;">
                                                        @interview.StatusDisplay
                                                    </span>
                                                </td>
                                                <td class="py-3 px-3 text-end">
                                                    <div class="d-flex justify-content-end gap-1.5">
                                                        @if (!string.IsNullOrWhiteSpace(interview.LocationOrLink))
                                                        {
                                                            <a href="@interview.LocationOrLink" target="_blank" class="btn btn-sm btn-outline-primary"
                                                               style="border-radius:8px; font-size:0.75rem; font-weight:600; padding: 0.25rem 0.65rem;"
                                                               title="Mở Google Meet">
                                                                <i class="bi bi-camera-video me-1"></i> Meet
                                                            </a>
                                                        }
                                                        @if (interview.Status == Ats.Web.Models.Enums.InterviewStatus.COMPLETED)
                                                        {
                                                            <button type="button" class="btn btn-sm btn-light"
                                                                    style="border-radius:8px; font-size:0.75rem; font-weight:600; border:1px solid #E2E8F0; padding: 0.25rem 0.65rem;"
                                                                    onclick="showEvaluationDetails('@(interview.EvaluationResult ?? "Đã hoàn thành đánh giá")')">
                                                                <i class="bi bi-eye me-1"></i> Kết quả
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                                    style="border-radius:8px; font-size:0.75rem; font-weight:600; padding: 0.25rem 0.65rem;"
                                                                    onclick="openEvaluationForInterview('@interview.InterviewId', '@interview.CandidateName', '@interview.JobTitle')">
                                                                <i class="bi bi-pencil-square me-1"></i> Đánh giá
                                                            </button>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center text-muted py-4">Chưa có lịch phỏng vấn nào được lên lịch trong tuần.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- ============================================================== -->
                <!-- 4. TÍNH NĂNG PHÊ DUYỆT OFFER (PHE-DUYET: FULL WIDTH) -->
                <!-- ============================================================== -->
                <div class="staff-feature-panel @(activeFeature == "phe-duyet" ? "" : "d-none")" data-feature-panel="phe-duyet">
                    <div id="feature-section-staff-phe-duyet" class="card border-0 shadow-sm p-4 bg-white mb-4 scroll-margin-nav" style="border: 1px solid #E2E8F0 !important; border-radius: 12px;">
                        <div class="d-flex align-items-center justify-content-between mb-3 pb-2" style="border-bottom: 1px solid #F1F5F9;">
                            <div>
                                <h5 class="fw-bold text-dark mb-0" style="font-size: 1.15rem;">
                                    <i class="bi bi-patch-check text-warning me-2"></i>Hàng Đợi Phê Duyệt Thư Mời Nhận Việc (Offer Queue)
                                </h5>
                                <small class="text-muted">Kiểm duyệt mức đãi ngộ, chế độ phúc lợi và phê chuẩn phát hành offer cho ứng viên</small>
                            </div>
                            <span style="font-family:'JetBrains Mono',monospace; font-size:0.75rem; font-weight:700; color:@(Model.PendingOffers.Any() ? "#D97706" : "#64748B"); background:@(Model.PendingOffers.Any() ? "#FEF3C7" : "#F1F5F9"); padding:4px 10px; border-radius:6px; border: 1px solid @(Model.PendingOffers.Any() ? "#FDE68A" : "#E2E8F0");">
                                @Model.PendingOffers.Count hồ sơ chờ xử lý
                            </span>
                        </div>

                        <div id="approverActionContainer">
                            @if (Model.PendingOffers.Any())
                            {
                                <div class="row g-3 mb-3">
                                    @foreach (var offer in Model.PendingOffers)
                                    {
                                        <div class="col-12 col-md-6 col-xl-4">
                                            <div class="p-3.5 h-100 d-flex flex-column justify-content-between" style="background: #F8FAFC; border: 1px solid #E2E8F0; border-left: 4px solid #D97706; border-radius: 10px;">
                                                <div>
                                                    <div class="d-flex justify-content-between align-items-start mb-1.5">
                                                        <span class="fw-bold text-dark" style="font-size: 0.95rem;">@offer.CandidateName</span>
                                                        <span class="fw-bold text-success font-mono" style="font-size:0.85rem;">
                                                            @offer.SalaryDisplay
                                                        </span>
                                                    </div>
                                                    <div class="text-muted mb-1" style="font-size: 0.8rem;">
                                                        Vị trí: <b class="text-dark">@offer.JobTitle</b>
                                                    </div>
                                                    <div class="text-muted small" style="font-size: 0.72rem;">
                                                        Ngày khởi tạo: @offer.CreatedDateDisplay
                                                    </div>
                                                </div>
                                                <div class="mt-3 pt-2" style="border-top: 1px solid #E2E8F0;">
                                                    <button type="button" class="btn btn-sm btn-success w-100 fw-semibold py-1.5" style="border-radius: 8px; font-size: 0.8rem;"
                                                            onclick="approveSelectedOffer('@offer.OfferId', '@offer.CandidateName', '@offer.JobTitle', '@offer.SalaryDisplay')">
                                                        <i class="bi bi-check2-all me-1"></i> Phê Duyệt Thư Mời (Offer)
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="p-5 text-center my-3" style="background: #F8FAFC; border: 1px dashed #CBD5E1; border-radius: 12px;">
                                    <i class="bi bi-check2-circle text-success fs-1 d-block mb-2"></i>
                                    <div class="fw-bold text-dark fs-6 mb-1">Không có hồ sơ tồn đọng</div>
                                    <div style="font-size: 0.85rem; color: #64748B;">Mọi đề xuất tuyển dụng và offer đã được phê duyệt đầy đủ và kịp thời.</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- ============================================================== -->
                <!-- 5. TÍNH NĂNG TÁC VỤ NHANH (TAC-VU: FULL WIDTH) -->
                <!-- ============================================================== -->
                <div class="staff-feature-panel @(activeFeature == "tac-vu" ? "" : "d-none")" data-feature-panel="tac-vu">
                    <div id="feature-section-staff-tac-vu" class="card border-0 shadow-sm p-4 bg-white mb-4 scroll-margin-nav" style="border: 1px solid #E2E8F0 !important; border-radius: 12px;">
                        <div class="d-flex align-items-center justify-content-between mb-4 pb-2" style="border-bottom: 1px solid #F1F5F9;">
                            <div>
                                <h5 class="fw-bold text-dark mb-0" style="font-size: 1.15rem;">
                                    <i class="bi bi-lightning-charge text-success me-2"></i>Trung Tâm Tác Vụ Nghiệp Vụ Nhanh (Role Actions Hub)
                                </h5>
                                <small class="text-muted">Các thao tác khởi tạo quy trình, phân quyền, đăng tin và đánh giá theo chuẩn NoveraTech</small>
                            </div>
                            <span class="badge bg-light text-muted border px-2.5 py-1.5" style="border-radius: 6px; font-size: 0.75rem;">Phân quyền theo vai trò</span>
                        </div>

                        <div class="row g-3 mb-4">
                            <!-- Action 1: Đăng tin tuyển dụng mới -->
                            @if (User.IsInRole(UserRoles.HRManager) || User.IsInRole(UserRoles.Recruiter) || User.IsInRole(UserRoles.Admin))
                            {
                                <div class="col-12 col-md-6 col-xl-4">
                                    <a href="/Jobs/Create" class="btn w-100 text-start p-3.5 d-flex align-items-center justify-content-between text-decoration-none h-100 bg-white"
                                       style="border: 1px solid #E2E8F0; border-radius: 10px; transition: all .15s;"
                                       onmouseover="this.style.background='#F8FAFC'; this.style.borderColor='#059669'; this.style.transform='translateY(-2px)';"
                                       onmouseout="this.style.background='#FFFFFF'; this.style.borderColor='#E2E8F0'; this.style.transform='none';">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="d-flex align-items-center justify-content-center rounded-3" style="width: 42px; height: 42px; background: #ECFDF5; color: #059669;">
                                                <i class="bi bi-megaphone-fill" style="font-size: 1.15rem;"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark" style="font-size: 0.88rem;">Đăng tin tuyển dụng mới</div>
                                                <div style="font-size: 0.72rem; color: #64748B;">Soạn thảo chuẩn mực, gắn tag & Live Preview</div>
                                            </div>
                                        </div>
                                        <i class="bi bi-chevron-right text-muted"></i>
                                    </a>
                                </div>
                            }

                            <!-- Action 2: Khởi tạo đề xuất nhân sự -->
                            @if (User.IsInRole(UserRoles.HiringManager) || User.IsInRole(UserRoles.Admin))
                            {
                                <div class="col-12 col-md-6 col-xl-4">
                                    <button type="button" class="btn w-100 text-start p-3.5 d-flex align-items-center justify-content-between h-100 bg-white"
                                            style="border: 1px solid #E2E8F0; border-radius: 10px; transition: all .15s;"
                                            data-bs-toggle="modal" data-bs-target="#createRequisitionModal"
                                            onmouseover="this.style.background='#F8FAFC'; this.style.borderColor='#059669'; this.style.transform='translateY(-2px)';"
                                            onmouseout="this.style.background='#FFFFFF'; this.style.borderColor='#E2E8F0'; this.style.transform='none';">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="d-flex align-items-center justify-content-center rounded-3" style="width: 42px; height: 42px; background: #FEF3C7; color: #D97706;">
                                                <i class="bi bi-file-earmark-plus-fill" style="font-size: 1.15rem;"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark" style="font-size: 0.88rem;">Đề xuất nhân sự phòng ban</div>
                                                <div style="font-size: 0.72rem; color: #64748B;">Gửi nhu cầu tuyển dụng bổ sung</div>
                                            </div>
                                        </div>
                                        <i class="bi bi-chevron-right text-muted"></i>
                                    </button>
                                </div>
                            }

                            <!-- Action 3: Nhập phiếu đánh giá phỏng vấn -->
                            @if (User.IsInRole(UserRoles.Interviewer) || User.IsInRole(UserRoles.Admin) || User.IsInRole(UserRoles.HiringManager))
                            {
                                <div class="col-12 col-md-6 col-xl-4">
                                    <button type="button" class="btn w-100 text-start p-3.5 d-flex align-items-center justify-content-between h-100 bg-white"
                                            style="border: 1px solid #E2E8F0; border-radius: 10px; transition: all .15s;"
                                            data-bs-toggle="modal" data-bs-target="#interviewEvaluationModal"
                                            onmouseover="this.style.background='#F8FAFC'; this.style.borderColor='#059669'; this.style.transform='translateY(-2px)';"
                                            onmouseout="this.style.background='#FFFFFF'; this.style.borderColor='#E2E8F0'; this.style.transform='none';">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="d-flex align-items-center justify-content-center rounded-3" style="width: 42px; height: 42px; background: #ECFDF5; color: #047857;">
                                                <i class="bi bi-clipboard2-check-fill" style="font-size: 1.15rem;"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark" style="font-size: 0.88rem;">Nhập phiếu đánh giá ứng viên</div>
                                                <div style="font-size: 0.72rem; color: #64748B;">Chấm điểm chuyên môn & văn hóa</div>
                                            </div>
                                        </div>
                                        <i class="bi bi-chevron-right text-muted"></i>
                                    </button>
                                </div>
                            }

                            <!-- Action 4: Quản trị tài khoản người dùng -->
                            @if (User.IsInRole(UserRoles.Admin))
                            {
                                <div class="col-12 col-md-6 col-xl-4">
                                    <a asp-controller="Users" asp-action="Index" class="btn w-100 text-start p-3.5 d-flex align-items-center justify-content-between text-decoration-none h-100 bg-white"
                                       style="border: 1px solid #E2E8F0; border-radius: 10px; transition: all .15s;"
                                       onmouseover="this.style.background='#F8FAFC'; this.style.borderColor='#059669'; this.style.transform='translateY(-2px)';"
                                       onmouseout="this.style.background='#FFFFFF'; this.style.borderColor='#E2E8F0'; this.style.transform='none';">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="d-flex align-items-center justify-content-center rounded-3" style="width: 42px; height: 42px; background: #FEE2E2; color: #DC2626;">
                                                <i class="bi bi-people-fill" style="font-size: 1.15rem;"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark" style="font-size: 0.88rem;">Quản trị tài khoản hệ thống</div>
                                                <div style="font-size: 0.72rem; color: #64748B;">Cấp quyền, phân vai trò & bảo mật</div>
                                            </div>
                                        </div>
                                        <i class="bi bi-chevron-right text-muted"></i>
                                    </a>
                                </div>
                            }

                            <!-- Action 5: Tra cứu & Lọc hồ sơ toàn hệ thống -->
                            <div class="col-12 col-md-6 col-xl-4">
                                <button type="button" class="btn w-100 text-start p-3.5 d-flex align-items-center justify-content-between h-100 bg-white"
                                        style="border: 1px solid #E2E8F0; border-radius: 10px; transition: all .15s;"
                                        onclick="switchDashboardFeature('ung-vien', event); filterPipelineCandidates('ALL');"
                                        onmouseover="this.style.background='#F8FAFC'; this.style.borderColor='#059669'; this.style.transform='translateY(-2px)';"
                                        onmouseout="this.style.background='#FFFFFF'; this.style.borderColor='#E2E8F0'; this.style.transform='none';">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="d-flex align-items-center justify-content-center rounded-3" style="width: 42px; height: 42px; background: #EFF6FF; color: #2563EB;">
                                            <i class="bi bi-funnel-fill" style="font-size: 1.15rem;"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark" style="font-size: 0.88rem;">Tra cứu danh sách hồ sơ</div>
                                            <div style="font-size: 0.72rem; color: #64748B;">Lọc nhanh theo từng giai đoạn phễu</div>
                                        </div>
                                    </div>
                                    <i class="bi bi-chevron-right text-muted"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Khối Quy Chuẩn Tuyển Dụng & Bảo Mật NoveraTech -->
                        <div class="p-3.5 rounded-3" style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 10px;">
                            <div class="d-flex align-items-center gap-2 mb-2 pb-2" style="border-bottom: 1px solid #E2E8F0;">
                                <i class="bi bi-shield-lock" style="color: #059669; font-size: 1.1rem;"></i>
                                <h6 class="fw-bold text-dark mb-0" style="font-size: 0.95rem;">Quy Chuẩn Tuyển Dụng Nội Bộ</h6>
                            </div>
                            <p style="font-size: 0.8rem; color: #64748B; line-height: 1.5;" class="mb-2">
                                Dữ liệu ứng viên và mức lương đề xuất được mã hóa và bảo mật nghiêm ngặt. Mọi thao tác phê duyệt đều được lưu vết kiểm toán (Audit Trail).
                            </p>
                            <div class="d-flex align-items-center justify-content-between pt-2" style="font-size: 0.75rem; color: #94A3B8; border-top: 1px solid #E2E8F0;">
                                <span>Phiên làm việc: @DateTime.UtcNow.ToString("dd/MM/yyyy")</span>
                                <span class="text-success"><i class="bi bi-check-circle me-1"></i>Trạng thái sẵn sàng</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <!-- Khi chưa đăng nhập -> Hiển thị Public Landing Page chuẩn mực -->
        @await Html.PartialAsync("~/Views/Home/Landing.cshtml")
    }
</div>

<!-- ======================================================== -->
<!-- MODALS DÀNH CHO CẢ ỨNG VIÊN VÀ NHÂN SỰ (THỰC THI THẬT) -->
<!-- ======================================================== -->

<!-- Modal 1: Cập nhật CV Ứng Viên -->
<div class="modal fade" id="updateCvModal" tabindex="-1" aria-labelledby="updateCvModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="updateCvModalLabel" style="font-size: 1.05rem;">
                    <i class="bi bi-file-earmark-arrow-up text-success me-2"></i>Cập nhật CV & Thông tin ứng tuyển
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <form id="cvUpdateForm" onsubmit="handleCvSubmit(event)">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Họ và tên</label>
                        <input type="text" class="form-control" name="fullName" value="@Model.UserFullName" required id="cvInputFullName" style="border-radius: 8px;" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Số điện thoại liên hệ</label>
                        <input type="tel" class="form-control" name="phone" placeholder="0912 345 678" value="@(Model.CandidateProfile?.Phone ?? "")" id="cvInputPhone" required style="border-radius: 8px;" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Chọn file CV mới (PDF, DOCX, tối đa 10MB)</label>
                        <input type="file" class="form-control" id="cvFileInput" name="cvFile" accept=".pdf,.doc,.docx" style="border-radius: 8px;" />
                        <small class="text-muted" style="font-size: 0.75rem;">Để trống nếu muốn giữ nguyên file CV hiện tại.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Link Portfolio / LinkedIn / GitHub (nếu có)</label>
                        <input type="url" class="form-control" name="linkedinUrl" value="@(Model.CandidateProfile?.LinkedinUrl ?? "")" placeholder="https://linkedin.com/in/..." style="border-radius: 8px;" />
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4 pt-2" style="border-top: 1px solid #E2E8F0;">
                        <button type="button" class="btn btn-light px-4" style="border-radius: 8px; font-size: 0.85rem;" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-success px-4 fw-semibold text-white" style="border-radius: 8px; font-size: 0.85rem;" id="btnSubmitCv">
                            <span class="spinner-border spinner-border-sm me-1 d-none" id="spinnerCv"></span>
                            Lưu & Đồng bộ CSDL
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal 2: Ứng tuyển nhanh vào vị trí -->
<div class="modal fade" id="applyJobModal" tabindex="-1" aria-labelledby="applyJobModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="applyJobModalLabel" style="font-size: 1.05rem;">
                    <i class="bi bi-send-check text-success me-2"></i>Xác nhận Ứng tuyển
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <p class="text-muted small mb-2">
                    Bạn đang ứng tuyển vào vị trí: <b class="text-dark" id="modalJobTitle"></b> thuộc phòng ban <b class="text-dark" id="modalJobDept"></b>.
                </p>
                <div class="p-2.5 mb-3" style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px; font-size: 0.78rem; color: #475569;">
                    <i class="bi bi-info-circle me-1" style="color: #059669;"></i> Hệ thống sẽ sử dụng hồ sơ CV và thông tin liên hệ trong tài khoản của bạn để lưu trực tiếp vào cơ sở dữ liệu tuyển dụng NoveraTech.
                </div>
                <input type="hidden" id="modalJobId" />
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-dark">Lời nhắn gửi kèm đến bộ phận Tuyển dụng (tùy chọn)</label>
                    <textarea class="form-control" rows="3" id="modalCoverLetter" placeholder="Giới thiệu ngắn gọn kinh nghiệm và lý do muốn gia nhập NoveraTech..." style="border-radius: 8px; font-size: 0.85rem;"></textarea>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-4 pt-2" style="border-top: 1px solid #E2E8F0;">
                    <button type="button" class="btn btn-light px-4" style="border-radius: 8px; font-size: 0.85rem;" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-success px-4 fw-semibold text-white" style="border-radius: 8px; font-size: 0.85rem;" id="btnSubmitApply" onclick="submitQuickApply()">
                        <span class="spinner-border spinner-border-sm me-1 d-none" id="spinnerApply"></span>
                        Xác nhận nộp đơn vào CSDL
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal 3: Đăng tin tuyển dụng mới (HR / Recruiter) -->
<div class="modal fade" id="createJobModal" tabindex="-1" aria-labelledby="createJobModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="createJobModalLabel" style="font-size: 1.05rem;">
                    <i class="bi bi-megaphone text-success me-2"></i>Tạo tin tuyển dụng mới
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <form id="jobCreateForm" onsubmit="handleJobCreateSubmit(event)">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-12 col-md-8">
                            <label class="form-label small fw-semibold text-dark">Tiêu đề vị trí tuyển dụng</label>
                            <input type="text" class="form-control" placeholder="VD: Senior Cloud DevOps Engineer" required id="newJobTitle" style="border-radius: 8px;" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-semibold text-dark">Phòng ban</label>
                            <select class="form-select" id="newJobDept" style="border-radius: 8px;">
                                <option value="IT">Phòng Công nghệ Thông tin (IT)</option>
                                <option value="AI">AI & Data Lab</option>
                                <option value="HR">Phòng Nhân sự</option>
                                <option value="SALES">Phòng Kinh Doanh</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-semibold text-dark">Số lượng cần tuyển</label>
                            <input type="number" class="form-control" value="2" min="1" required id="newJobQuantity" style="border-radius: 8px;" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-semibold text-dark">Dải lương dự kiến</label>
                            <input type="text" class="form-control" placeholder="VD: 35 – 50 Triệu VNĐ" required id="newJobSalary" style="border-radius: 8px;" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-semibold text-dark">Hạn nộp hồ sơ</label>
                            <input type="date" class="form-control" value="@DateTime.UtcNow.AddDays(30).ToString("yyyy-MM-dd")" required id="newJobExpiredDate" style="border-radius: 8px;" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-dark">Mô tả công việc & Yêu cầu kỹ năng</label>
                            <textarea class="form-control" rows="4" placeholder="Nhập các yêu cầu chính, trách nhiệm và quyền lợi của vị trí..." required id="newJobDescription" style="border-radius: 8px;"></textarea>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4 pt-2" style="border-top: 1px solid #E2E8F0;">
                        <button type="button" class="btn btn-light px-4" style="border-radius: 8px; font-size: 0.85rem;" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-success px-4 fw-semibold text-white" style="border-radius: 8px; font-size: 0.85rem;" id="btnSubmitJobCreate">
                            <span class="spinner-border spinner-border-sm me-1 d-none" id="spinnerJobCreate"></span>
                            Xuất bản tin vào CSDL
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal 4: Khởi tạo đề xuất nhân sự (Hiring Manager) -->
<div class="modal fade" id="createRequisitionModal" tabindex="-1" aria-labelledby="createRequisitionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
            <div class="modal-header border-0 pb-0 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <div class="d-flex align-items-center justify-content-center rounded" style="width: 34px; height: 34px; background: #FEF3C7; color: #D97706;">
                        <i class="bi bi-file-earmark-plus-fill"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="createRequisitionModalLabel" style="font-size: 1.05rem;">
                            Đề xuất tuyển dụng nhân sự
                        </h5>
                        <div class="text-muted" style="font-size: 0.75rem;">Khai báo nhanh yêu cầu tuyển dụng cho phòng ban</div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a href="/yeu-cau-tuyen-dung/tao-moi" class="btn btn-outline-secondary btn-sm d-none d-sm-inline-flex align-items-center gap-1" style="border-radius: 8px; font-size: 0.78rem;">
                        <i class="bi bi-box-arrow-up-right"></i> Mở trang chi tiết
                    </a>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body py-3">
                <div id="reqModalAlert" class="alert alert-danger d-none py-2 px-3 small rounded-3" role="alert"></div>
                <form id="reqForm" onsubmit="handleReqSubmit(event)">
                    <div class="row g-3">
                        <!-- Chức danh -->
                        <div class="col-12 col-md-7">
                            <label class="form-label small fw-semibold text-dark">Chức danh cần tuyển <span class="text-danger">*</span></label>
                            <select class="form-select" id="reqPositionId" required style="border-radius: 8px;">
                                <option value="">-- Đang nạp danh mục chức danh... --</option>
                            </select>
                            <div class="form-text" style="font-size: 0.72rem;" id="reqPosHelpText">
                                Dữ liệu chuẩn từ danh mục chức danh của công ty
                            </div>
                        </div>

                        <!-- Phòng ban -->
                        <div class="col-12 col-md-5">
                            <label class="form-label small fw-semibold text-dark">Phòng ban đề xuất <span class="text-danger">*</span></label>
                            <select class="form-select" id="reqDepartmentId" required style="border-radius: 8px;">
                                <option value="">-- Đang nạp phòng ban... --</option>
                            </select>
                            <div class="form-text text-muted" style="font-size: 0.72rem;" id="reqDeptNotice">
                                Tự động gán phòng ban của Trưởng bộ phận
                            </div>
                        </div>

                        <!-- Số lượng & Ngày cần người & Loại đề xuất -->
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-semibold text-dark">Số lượng cần tuyển <span class="text-danger">*</span></label>
                            <input type="number" class="form-control font-monospace" value="1" min="1" max="1000" required id="reqQuantity" style="border-radius: 8px;" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-semibold text-dark">Ngày cần có nhân sự <span class="text-danger">*</span></label>
                            <input type="date" class="form-control font-monospace" min="@DateTime.UtcNow.ToString("yyyy-MM-dd")" value="@DateTime.UtcNow.AddDays(30).ToString("yyyy-MM-dd")" required id="reqDate" style="border-radius: 8px;" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-semibold text-dark">Lý do tuyển dụng <span class="text-danger">*</span></label>
                            <select class="form-select" id="reqHeadcountType" required style="border-radius: 8px;">
                                <option value="REPLACEMENT">Thay thế nhân sự nghỉ việc</option>
                                <option value="NEW_HEADCOUNT">Tăng mới headcount</option>
                            </select>
                        </div>

                        <!-- Dải lương đề xuất -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-dark">Mức lương tối thiểu (VND) <span class="text-danger">*</span></label>
                            <input type="text" class="form-control font-monospace" placeholder="10,000,000" required id="reqMinSalaryFormatted" style="border-radius: 8px;" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-dark">Mức lương tối đa (VND) <span class="text-danger">*</span></label>
                            <input type="text" class="form-control font-monospace" placeholder="25,000,000" required id="reqMaxSalaryFormatted" style="border-radius: 8px;" />
                        </div>

                        <!-- Chi tiết lý do -->
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-dark">Chi tiết lý do / Mục tiêu tuyển dụng</label>
                            <textarea class="form-control" rows="2" placeholder="Ví dụ: Bổ sung cho dự án Core Banking Quý 4, thay thế nhân viên nghỉ việc..." id="reqDescription" style="border-radius: 8px;"></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center gap-2 mt-4 pt-2" style="border-top: 1px solid #E2E8F0;">
                        <a href="/yeu-cau-tuyen-dung/tao-moi" class="text-decoration-none small text-muted">
                            <i class="bi bi-box-arrow-up-right me-1"></i>Trang tạo đầy đủ có preview
                        </a>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-light px-3" style="border-radius: 8px; font-size: 0.85rem;" data-bs-dismiss="modal">Hủy</button>
                            <button type="submit" class="btn btn-primary px-4 fw-semibold text-white" style="border-radius: 8px; font-size: 0.85rem;" id="btnSubmitReq">
                                <span class="spinner-border spinner-border-sm me-1 d-none" id="spinnerReq"></span>
                                Lưu & Gửi duyệt đề xuất
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal 5: Nhập phiếu đánh giá phỏng vấn (Interviewer) -->
<div class="modal fade" id="interviewEvaluationModal" tabindex="-1" aria-labelledby="interviewEvaluationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="interviewEvaluationModalLabel" style="font-size: 1.05rem;">
                    <i class="bi bi-clipboard2-check text-success me-2"></i>Phiếu Đánh Giá Phỏng Vấn
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <form id="evaluationForm" onsubmit="handleEvalSubmit(event)">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Phiên phỏng vấn ứng viên</label>
                        <select class="form-select" id="evalInterviewId" required style="border-radius: 8px;">
                            @if (Model.EvaluationCandidates.Any())
                            {
                                @foreach (var cand in Model.EvaluationCandidates)
                                {
                                    <option value="@cand.InterviewId">@cand.DisplayText</option>
                                }
                            }
                            else
                            {
                                <option value="">Không có phiên phỏng vấn nào cần đánh giá</option>
                            }
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-dark">Điểm chuyên môn (1-5)</label>
                            <select class="form-select" id="evalScore" style="border-radius: 8px;">
                                <option value="5">5/5 - Xuất sắc</option>
                                <option value="4" selected>4/5 - Tốt, đáp ứng tốt</option>
                                <option value="3">3/5 - Trung bình khá</option>
                                <option value="2">2/5 - Dưới yêu cầu</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-dark">Độ phù hợp văn hóa</label>
                            <select class="form-select" id="evalCulture" style="border-radius: 8px;">
                                <option selected>Rất phù hợp</option>
                                <option>Phù hợp</option>
                                <option>Cần xem xét thêm</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Kết luận đề xuất của Interviewer</label>
                        <select class="form-select fw-semibold" id="evalRecommendation" style="border-radius: 8px;">
                            <option value="PASS" class="text-success">ĐẠT — Đề xuất tiến hành gửi Thư mời Offer</option>
                            <option value="CONSIDER" class="text-warning">XEM XÉT — Cần phỏng vấn thêm vòng 2</option>
                            <option value="REJECT" class="text-danger">KHÔNG ĐẠT — Lưu trữ hồ sơ</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Nhận xét chi tiết</label>
                        <textarea class="form-control" rows="3" id="evalFeedback" placeholder="Điểm mạnh kỹ thuật, phong cách tư duy giải quyết bài toán và thái độ ứng viên..." required style="border-radius: 8px; font-size: 0.85rem;"></textarea>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4 pt-2" style="border-top: 1px solid #E2E8F0;">
                        <button type="button" class="btn btn-light px-4" style="border-radius: 8px; font-size: 0.85rem;" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-success px-4 fw-semibold text-white" style="border-radius: 8px; font-size: 0.85rem;" id="btnSubmitEval">
                            <span class="spinner-border spinner-border-sm me-1 d-none" id="spinnerEval"></span>
                            Nộp phiếu vào CSDL
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal 6: Xem danh sách hồ sơ ứng viên (Lọc hồ sơ) -->
<div class="modal fade" id="candidateFilterModal" tabindex="-1" aria-labelledby="candidateFilterModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="candidateFilterModalLabel" style="font-size: 1.05rem;">
