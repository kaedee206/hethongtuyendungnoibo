<!-- Modal 4: Khởi tạo đề xuất nhân sự (Hiring Manager) -->
<div class="modal fade" id="createRequisitionModal" tabindex="-1" aria-labelledby="createRequisitionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
            <div class="modal-header border-0 pb-0 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <div class="d-flex align-items-center justify-content-center rounded" style="width: 34px; height: 34px; background: #FEF3C7; color: #D97706;">
                        <i class="bi bi-file-earmark-plus-fill"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="createRequisitionModalLabel" style="font-size: 1.05rem;">
                            Đề xuất tuyển dụng nhân sự
                        </h5>
                        <div class="text-muted" style="font-size: 0.75rem;">Khai báo nhanh yêu cầu tuyển dụng cho phòng ban</div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a href="/yeu-cau-tuyen-dung/tao-moi" class="btn btn-outline-secondary btn-sm d-none d-sm-inline-flex align-items-center gap-1" style="border-radius: 8px; font-size: 0.78rem;">
                        <i class="bi bi-box-arrow-up-right"></i> Mở trang chi tiết
                    </a>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body py-3">
                <div id="reqModalAlert" class="alert alert-danger d-none py-2 px-3 small rounded-3" role="alert"></div>
                <form id="reqForm" onsubmit="handleReqSubmit(event)">
                    <div class="row g-3">
                        <!-- Chức danh -->
                        <div class="col-12 col-md-7">
                            <label class="form-label small fw-semibold text-dark">Chức danh cần tuyển <span class="text-danger">*</span></label>
                            <select class="form-select" id="reqPositionId" required style="border-radius: 8px;">
                                <option value="">-- Đang nạp danh mục chức danh... --</option>
                            </select>
                            <div class="form-text" style="font-size: 0.72rem;" id="reqPosHelpText">
                                Dữ liệu chuẩn từ danh mục chức danh của công ty
                            </div>
                        </div>

                        <!-- Phòng ban -->
                        <div class="col-12 col-md-5">
                            <label class="form-label small fw-semibold text-dark">Phòng ban đề xuất <span class="text-danger">*</span></label>
                            <select class="form-select" id="reqDepartmentId" required style="border-radius: 8px;">
                                <option value="">-- Đang nạp phòng ban... --</option>
                            </select>
                            <div class="form-text text-muted" style="font-size: 0.72rem;" id="reqDeptNotice">
                                Tự động gán phòng ban của Trưởng bộ phận
                            </div>
                        </div>

                        <!-- Số lượng & Ngày cần người & Loại đề xuất -->
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-semibold text-dark">Số lượng cần tuyển <span class="text-danger">*</span></label>
                            <input type="number" class="form-control font-monospace" value="1" min="1" max="1000" required id="reqQuantity" style="border-radius: 8px;" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-semibold text-dark">Ngày cần có nhân sự <span class="text-danger">*</span></label>
                            <input type="date" class="form-control font-monospace" min="@DateTime.UtcNow.ToString("yyyy-MM-dd")" value="@DateTime.UtcNow.AddDays(30).ToString("yyyy-MM-dd")" required id="reqDate" style="border-radius: 8px;" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-semibold text-dark">Lý do tuyển dụng <span class="text-danger">*</span></label>
                            <select class="form-select" id="reqHeadcountType" required style="border-radius: 8px;">
                                <option value="REPLACEMENT">Thay thế nhân sự nghỉ việc</option>
                                <option value="NEW_HEADCOUNT">Tăng mới headcount</option>
                            </select>
                        </div>

                        <!-- Dải lương đề xuất -->
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-dark">Mức lương tối thiểu (VND) <span class="text-danger">*</span></label>
                            <input type="text" class="form-control font-monospace" placeholder="10,000,000" required id="reqMinSalaryFormatted" style="border-radius: 8px;" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold text-dark">Mức lương tối đa (VND) <span class="text-danger">*</span></label>
                            <input type="text" class="form-control font-monospace" placeholder="25,000,000" required id="reqMaxSalaryFormatted" style="border-radius: 8px;" />
                        </div>

                        <!-- Chi tiết lý do -->
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-dark">Chi tiết lý do / Mục tiêu tuyển dụng</label>
                            <textarea class="form-control" rows="2" placeholder="Ví dụ: Bổ sung cho dự án Core Banking Quý 4, thay thế nhân viên nghỉ việc..." id="reqDescription" style="border-radius: 8px;"></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center gap-2 mt-4 pt-2" style="border-top: 1px solid #E2E8F0;">
                        <a href="/yeu-cau-tuyen-dung/tao-moi" class="text-decoration-none small text-muted">
                            <i class="bi bi-box-arrow-up-right me-1"></i>Trang tạo đầy đủ có preview
                        </a>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-light px-3" style="border-radius: 8px; font-size: 0.85rem;" data-bs-dismiss="modal">Hủy</button>
                            <button type="submit" class="btn btn-primary px-4 fw-semibold text-white" style="border-radius: 8px; font-size: 0.85rem;" id="btnSubmitReq">
                                <span class="spinner-border spinner-border-sm me-1 d-none" id="spinnerReq"></span>
                                Lưu & Gửi duyệt đề xuất
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal 5: Nhập phiếu đánh giá phỏng vấn (Scrum - Số 57) -->
<div class="modal fade" id="interviewEvaluationModal" tabindex="-1" aria-labelledby="interviewEvaluationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
            <div class="modal-header border-bottom pb-3">
                <div>
                    <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="interviewEvaluationModalLabel" style="font-size: 1.05rem;">
                        <i class="bi bi-clipboard2-check text-success"></i>
                        <span>Phiếu Đánh Giá Sau Phỏng Vấn</span>
                        <span id="evalStatusBadge" class="badge bg-secondary-subtle text-secondary small" style="font-size: 0.72rem;">Đang tải...</span>
                    </h5>
                    <div id="evalCandidateSubtitle" class="text-muted small mt-1">Chọn phiên phỏng vấn để mở phiếu đánh giá</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <!-- Loading State Spinner -->
                <div id="evalModalLoading" class="text-center py-4 d-none">
                    <div class="spinner-border text-primary" role="status"></div>
                    <div class="text-muted small mt-2">Đang tải thông tin phiếu đánh giá...</div>
                </div>

                <!-- Error / Permission Alert (Rule 1: Only invited panelists can open) -->
                <div id="evalModalAlert" class="alert alert-danger d-none py-2 px-3 small align-items-center mb-3" style="border-radius: 8px;">
                    <i class="bi bi-shield-x fs-5 me-2 text-danger"></i>
                    <div>
                        <strong>Quyền truy cập bị từ chối:</strong> <span id="evalModalAlertMsg"></span>
                    </div>
                </div>

                <!-- Rule 3: Submitted lock banner -->
                <div id="evalLockBanner" class="alert alert-info d-none py-2 px-3 small align-items-center mb-3" style="border-radius: 8px;">
                    <i class="bi bi-lock-fill fs-5 text-primary me-2"></i>
                    <div>
                        <strong>Phiếu đánh giá đã được nộp (Đã khóa).</strong> Theo quy định, phiếu đã nộp không thể chỉnh sửa trừ khi Recruiter mở lại trong vòng 24 giờ.
                    </div>
                </div>

                <!-- Rule 3: Reopened banner -->
                <div id="evalReopenBanner" class="alert alert-warning d-none py-2 px-3 small align-items-center mb-3" style="border-radius: 8px;">
                    <i class="bi bi-unlock-fill fs-5 text-warning me-2"></i>
                    <div>
                        <strong>Phiếu đã được Recruiter mở lại:</strong> <span id="evalReopenReasonText" class="fw-semibold"></span>. Bạn có thể cập nhật và nộp lại phiếu.
                    </div>
                </div>

                <!-- Not panelist (Recruiter / Admin view mode) -->
                <div id="evalNotPanelistBanner" class="alert alert-secondary d-none py-2 px-3 small align-items-center mb-3" style="border-radius: 8px;">
                    <i class="bi bi-info-circle-fill fs-5 text-secondary me-2"></i>
                    <div>
                        <strong>Chế độ xem Hội đồng:</strong> Bạn không thuộc danh sách người phỏng vấn được mời, đang xem tổng hợp kết quả của hội đồng.
                    </div>
                </div>

                <!-- Form container -->
                <form id="evaluationForm" onsubmit="handleEvalSubmit(event)">
                    <!-- Interview Selection -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Phiên phỏng vấn ứng viên</label>
                        <select class="form-select" id="evalInterviewId" required style="border-radius: 8px;" onchange="onEvalInterviewChanged(this.value)">
                            @if (Model.EvaluationCandidates.Any())
                            {
                                @foreach (var cand in Model.EvaluationCandidates)
                                {
                                    <option value="@cand.InterviewId">@cand.DisplayText</option>
                                }
                            }
                            else
                            {
                                <option value="">Không có phiên phỏng vấn nào cần đánh giá</option>
                            }
                        </select>
                    </div>

                    <!-- Interview Details Info Bar -->
                    <div id="evalInterviewInfoBar" class="p-2.5 mb-3 bg-light rounded-3 d-flex flex-wrap gap-3 align-items-center border" style="font-size: 0.78rem;">
                        <div><i class="bi bi-person text-muted me-1"></i>Ứng viên: <strong id="evalCandidateName" class="text-dark">---</strong></div>
                        <div><i class="bi bi-briefcase text-muted me-1"></i>Vị trí: <strong id="evalJobTitle" class="text-dark">---</strong></div>
                        <div><i class="bi bi-calendar3 text-muted me-1"></i>Thời gian: <strong id="evalTimeDisplay" class="text-dark">---</strong></div>
                        <div><i class="bi bi-people text-muted me-1"></i>Hội đồng: <span id="evalPanelists" class="text-muted">---</span></div>
                    </div>

                    <!-- Input Fields (Disabled when locked) -->
                    <fieldset id="evalFormFieldset">
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-dark">Điểm chuyên môn tổng quan (1.0 - 5.0)</label>
                                <select class="form-select" id="evalScore" style="border-radius: 8px;">
                                    <option value="5.0">5.0 / 5.0 - Xuất sắc, vượt trội</option>
                                    <option value="4.0" selected>4.0 / 5.0 - Tốt, đáp ứng tốt yêu cầu</option>
                                    <option value="3.0">3.0 / 5.0 - Trung bình khá, đạt yêu cầu</option>
                                    <option value="2.0">2.0 / 5.0 - Dưới yêu cầu chuyên môn</option>
                                    <option value="1.0">1.0 / 5.0 - Rất kém, không phù hợp</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-dark">
                                    Kết luận đánh giá <span class="text-danger">* (Bắt buộc)</span>
                                </label>
                                <select class="form-select fw-semibold" id="evalRecommendation" required style="border-radius: 8px;">
                                    <option value="" disabled selected>-- Bắt buộc chọn kết luận --</option>
                                    <option value="HIRE" class="text-success fw-bold">Nên tuyển</option>
                                    <option value="CONSIDER" class="text-warning fw-bold">Cân nhắc</option>
                                    <option value="STRONG_NO_HIRE" class="text-danger fw-bold">Không nên tuyển</option>
                                </select>
                                <div class="invalid-feedback">Bắt buộc chọn một trong 3 kết luận: Nên tuyển, Cân nhắc hoặc Không nên tuyển.</div>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-dark">Điểm mạnh nổi bật</label>
                                <textarea class="form-control" rows="2" id="evalStrengths" placeholder="Kiến thức nền tảng vững, tư duy logic, kỹ năng giao tiếp tốt..." style="border-radius: 8px; font-size: 0.85rem;"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-dark">Điểm cần cải thiện / Lưu ý</label>
                                <textarea class="form-control" rows="2" id="evalWeaknesses" placeholder="Cần củng cố kinh nghiệm thực chiến với hệ thống tải cao..." style="border-radius: 8px; font-size: 0.85rem;"></textarea>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-dark">Nhận định & Nhận xét chi tiết sau buổi phỏng vấn</label>
                            <textarea class="form-control" rows="3" id="evalFeedback" placeholder="Ghi lại nhận định khi còn nhớ rõ thay vì trả lời qua chat vài ngày sau: phong cách xử lý vấn đề, thái độ, phản hồi các câu hỏi tình huống..." required style="border-radius: 8px; font-size: 0.85rem;"></textarea>
                        </div>
                    </fieldset>

                    <!-- Section: Đánh giá từ các thành viên khác trong Hội đồng (Rule 4: Blind evaluation) -->
                    <div class="mt-4 pt-3 border-top">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <h6 class="fw-bold text-dark mb-0" style="font-size: 0.92rem;">
                                <i class="bi bi-people-fill text-primary me-2"></i>Đánh giá từ các giám khảo khác trong Hội đồng
                            </h6>
                            <span id="panelEvaluationsBadge" class="badge bg-light text-muted border">---</span>
                        </div>

                        <!-- Blind evaluation notice or reviews list container -->
                        <div id="panelEvaluationsContainer">
                            <!-- Populated dynamically via JavaScript -->
                        </div>
                    </div>

                    <!-- Footer buttons -->
                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <div id="evalFooterInfo" class="small text-muted"></div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-light px-4" style="border-radius: 8px; font-size: 0.85rem;" data-bs-dismiss="modal">Đóng</button>
                            <button type="submit" class="btn btn-success px-4 fw-semibold text-white" style="border-radius: 8px; font-size: 0.85rem;" id="btnSubmitEval">
                                <span class="spinner-border spinner-border-sm me-1 d-none" id="spinnerEval"></span>
                                <span id="btnSubmitEvalText">Nộp phiếu đánh giá</span>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Recruiter mở lại phiếu đánh giá trong vòng 24 giờ (Scrum - Số 57 Rule 3) -->
<div class="modal fade" id="reopenEvaluationModal" tabindex="-1" aria-labelledby="reopenEvaluationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
            <div class="modal-header border-bottom pb-2">
                <h6 class="modal-title fw-bold text-dark d-flex align-items-center" id="reopenEvaluationModalLabel">
                    <i class="bi bi-arrow-counterclockwise text-warning me-2"></i>Mở lại phiếu đánh giá (24h)
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <form id="reopenEvaluationForm" onsubmit="handleReopenSubmit(event)">
                    <input type="hidden" id="reopenEvaluationId" />
                    <p class="small text-muted mb-2">
                        Mở khóa phiếu đánh giá của giám khảo <strong id="reopenPanelistName" class="text-dark">---</strong> để cho phép cập nhật lại nhận định.
                    </p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Lý do mở lại <span class="text-muted">(tùy chọn)</span></label>
                        <textarea class="form-control" rows="2" id="reopenReasonInput" placeholder="Ví dụ: Giám khảo cần bổ sung điểm mạnh kỹ thuật, sửa lại kết luận..." style="border-radius: 8px; font-size: 0.82rem;"></textarea>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal" style="border-radius: 8px;">Hủy</button>
                        <button type="submit" class="btn btn-sm btn-warning fw-semibold text-dark" id="btnConfirmReopen" style="border-radius: 8px;">
                            <span class="spinner-border spinner-border-sm me-1 d-none" id="spinnerReopen"></span>
                            Xác nhận mở lại
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal 6: Xem danh sách hồ sơ ứng viên (Lọc hồ sơ) -->
<div class="modal fade" id="candidateFilterModal" tabindex="-1" aria-labelledby="candidateFilterModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="candidateFilterModalLabel" style="font-size: 1.05rem;">
                    <i class="bi bi-funnel text-success me-2"></i>Danh sách hồ sơ ứng viên trong CSDL
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                @if (Model.IsRecruiterScoped)
                {
                    <div class="alert alert-primary-subtle border border-primary-subtle py-2 px-3 small d-flex align-items-center gap-2 mb-3" style="border-radius: 8px;">
                        <i class="bi bi-person-check-fill text-primary fs-6"></i>
                        <span>Đang chỉ hiển thị hồ sơ ứng viên thuộc <strong>@Model.AssignedPositionsCount</strong> vị trí tuyển dụng được phân công cho bạn.</span>
                    </div>
                }
                else if (Model.RecruitersFilterList != null && Model.RecruitersFilterList.Any())
                {
                    <div class="d-flex align-items-center gap-2 mb-3 p-2 bg-light rounded-3 border">
                        <label for="filterCandidateRecruiterSelect" class="small text-muted fw-semibold mb-0 text-nowrap">
                            <i class="bi bi-funnel me-1"></i>Lọc theo Recruiter:
                        </label>
                        <select id="filterCandidateRecruiterSelect" class="form-select form-select-sm" style="border-radius: 6px;" onchange="loadCandidatesByStage(window.lastFilteredStage || 'ALL')">
                            <option value="">-- Tất cả Recruiter phụ trách --</option>
                            @foreach (var r in Model.RecruitersFilterList)
                            {
                                <option value="@r.UserId">@r.FullName (@r.ActiveLeadCount chính / @r.ActiveSupportingCount phụ)</option>
                            }
                        </select>
                    </div>
                }
                <div class="d-flex flex-wrap gap-1.5 mb-3">
                    <button type="button" class="btn btn-sm btn-outline-success active" style="border-radius: 6px; font-size: 0.75rem;" onclick="loadCandidatesByStage('ALL', this)">Tất cả</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" style="border-radius: 6px; font-size: 0.75rem;" onclick="loadCandidatesByStage('1', this)">Ứng tuyển mới</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" style="border-radius: 6px; font-size: 0.75rem;" onclick="loadCandidatesByStage('2', this)">Sàng lọc CV</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" style="border-radius: 6px; font-size: 0.75rem;" onclick="loadCandidatesByStage('4', this)">Phỏng vấn</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" style="border-radius: 6px; font-size: 0.75rem;" onclick="loadCandidatesByStage('5', this)">Offer</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" style="border-radius: 6px; font-size: 0.75rem;" onclick="loadCandidatesByStage('6', this)">Đã Onboard</button>
                </div>
                <div class="table-responsive" style="max-height: 420px; overflow-y: auto;">
                    <table class="table table-hover align-middle mb-0" style="min-width: 580px; font-size: 0.85rem;">
                        <thead class="table-light">
                            <tr style="font-size: 0.75rem; text-transform: uppercase; color: #64748B;">
                                <th>Ứng viên</th>
                                <th>Vị trí ứng tuyển</th>
                                <th>Giai đoạn</th>
                                <th>Ngày nộp</th>
                            </tr>
                        </thead>
                        <tbody id="filteredCandidatesBody">
                            <tr>
                                <td colspan="4" class="text-center py-3 text-muted">Đang tải dữ liệu...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal 7: Lên lịch phỏng vấn & Phân công hội đồng -->
<div class="modal fade" id="scheduleInterviewModal" tabindex="-1" aria-labelledby="scheduleInterviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="scheduleInterviewModalLabel" style="font-size: 1.05rem;">
                    <i class="bi bi-calendar-plus text-primary me-2"></i>Lên lịch phỏng vấn ứng viên
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <div id="schedCandidateBox" class="p-2.5 mb-3" style="background:#F8FAFC; border:1px solid #E2E8F0; border-radius:8px;">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-bold text-dark" id="schedCandidateName" style="font-size: 0.92rem;">-</div>
                            <div class="text-muted small" id="schedJobTitle">-</div>
                        </div>
                        <span class="badge bg-light text-primary border" style="font-size: 0.72rem;">
                            <i class="bi bi-person-badge me-1"></i>Ứng viên được chọn
                        </span>
                    </div>
                </div>
                <div id="schedCandidateSelectGroup" class="mb-3" style="display: none;">
                    <label class="form-label small fw-semibold text-dark">
                        <i class="bi bi-person-check-fill text-success me-1"></i>Chọn ứng viên cần lên lịch <span class="text-danger">*</span>
                    </label>
                    <select class="form-select form-select-sm" id="schedCandidateSelect" style="border-radius:8px;" onchange="onSchedCandidateSelectChange(this)">
                        <option value="">-- Chọn ứng viên trong quy trình tuyển dụng --</option>
                        @foreach (var group in Model.CandidatePipelineItems.Where(x => x.Status != "REJECTED" && x.Status != "WITHDRAWN" && x.CurrentStageOrder != 6).GroupBy(x => x.JobTitle))
                        {
                            <optgroup label="@group.Key">
                                @foreach (var c in group)
                                {
                                    <option value="@c.ApplicationId" data-name="@c.CandidateName" data-job="@c.JobTitle" data-stage-order="@c.CurrentStageOrder">
                                        @c.CandidateName (@c.CurrentStageName)
                                    </option>
                                }
                            </optgroup>
                        }
                    </select>
                </div>
                <form id="scheduleInterviewForm" onsubmit="handleScheduleInterviewSubmit(event)">
                    <input type="hidden" id="schedApplicationId" />
                    <div class="row g-2 mb-3">
                        <div class="col-5">
                            <label class="form-label small fw-semibold text-dark">Vòng phỏng vấn <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm" id="schedRoundNumber" style="border-radius:8px;" onchange="onSchedRoundChange(this.value)">
                                <option value="1">Vòng 1: Sơ loại HR</option>
                                <option value="2" selected>Vòng 2: Chuyên môn</option>
                                <option value="3">Vòng 3: Văn hóa/Sếp</option>
                                <option value="4">Vòng 4: Thực chiến</option>
                                <option value="5">Vòng 5: Offer</option>
                            </select>
                        </div>
                        <div class="col-7">
                            <label class="form-label small fw-semibold text-dark">Tiêu đề buổi họp <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" id="schedRoundTitle" value="Phỏng vấn chuyên môn kỹ thuật" required style="border-radius:8px;" />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-7">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label small fw-semibold text-dark mb-0">Thời gian bắt đầu <span class="text-danger">*</span></label>
                                <span class="conflict-loading-spinner spinner-border spinner-border-sm text-primary d-none" role="status" title="Đang kiểm tra trùng lịch..."></span>
                            </div>
                            <input type="datetime-local" class="form-control form-control-sm" id="schedDate" required style="border-radius:8px;" onchange="validateSchedDateTime()" />
                            <div id="schedPastDateError" class="text-danger small mt-1 d-none" style="font-size:0.75rem;">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>Không thể đặt lịch trong quá khứ. Vui lòng chọn thời gian tới.
                            </div>
                        </div>
                        <div class="col-5">
                            <label class="form-label small fw-semibold text-dark">Thời lượng <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm" id="schedDuration" style="border-radius:8px;" onchange="triggerHomeConflictCheck()">
                                <option value="30">30 phút</option>
                                <option value="45">45 phút</option>
                                <option value="60" selected>60 phút (Chuẩn)</option>
                                <option value="90">90 phút</option>
                                <option value="120">120 phút (2 giờ)</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Hình thức phỏng vấn</label>
                        <select class="form-select form-select-sm" id="schedType" style="border-radius:8px;" onchange="onHomeSchedTypeChange(this.value)">
                            <option value="ONLINE_MEET">Trực tuyến (Google Meet / MS Teams)</option>
                            <option value="OFFLINE_OFFICE">Trực tiếp tại Trụ sở NoveraTech</option>
                        </select>
                    </div>
                    <!-- Chọn Phòng họp khi trực tiếp (SCRUM-53) -->
                    <div class="mb-3" id="schedMeetingRoomGroup" style="display: none;">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label small fw-semibold text-dark mb-0">Phòng họp phỏng vấn trực tiếp <span class="text-danger">*</span></label>
                            <span class="conflict-loading-spinner spinner-border spinner-border-sm text-primary d-none" role="status" title="Đang kiểm tra xung đột phòng họp..."></span>
                        </div>
                        <select class="form-select form-select-sm" id="schedMeetingRoomId" style="border-radius:8px;" onchange="onHomeMeetingRoomChange(this)">
                            <option value="">-- Chọn phòng họp khả dụng --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Địa điểm / Link phòng họp <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-sm" id="schedLocation" placeholder="https://meet.google.com/... hoặc Phòng Họp Tầng 12" required style="border-radius:8px;" oninput="triggerHomeConflictCheck()" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Thành viên hội đồng phỏng vấn (Panelists) <span class="text-danger">*</span></label>
                        <select class="form-select form-select-sm" id="schedPanelists" multiple size="3" style="border-radius:8px; font-size:0.85rem;" onchange="validateSchedPanelists()">
                            <!-- Populated dynamically via /Workspace/GetInterviewers -->
                        </select>
                        <small class="text-muted" style="font-size:0.75rem;">Giữ phím Ctrl / Shift để chọn nhiều người phỏng vấn.</small>
                        <div id="schedPanelistError" class="text-danger small mt-1 d-none" style="font-size:0.75rem;">
                            <i class="bi bi-exclamation-circle-fill me-1"></i>Vui lòng chọn ít nhất một người phỏng vấn.
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Ghi chú chuẩn bị / Lời nhắn ứng viên</label>
                        <textarea class="form-control form-control-sm" id="schedNotes" rows="2" placeholder="Vui lòng chuẩn bị slide hoặc mã nguồn demo (nếu có)..." style="border-radius:8px; font-size:0.85rem;"></textarea>
                    </div>

                    <!-- Khung Cảnh Báo Xung Đột & Mở Khóa Ghi Đè (SCRUM-53) -->
                    <partial name="_InterviewConflictAlertPartial" />

