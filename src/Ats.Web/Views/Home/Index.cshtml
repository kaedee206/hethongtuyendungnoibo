        // SCRUM-328: Xuất danh sách ứng viên rút gọn ra file Excel cho Trưởng bộ phận theo bộ lọc đang áp dụng
        function exportCandidateShortlistExcel() {
            const stageOrder = window.currentPipelineStage || 'ALL';
            const jobSelect = document.getElementById('candidateJobFilter') || document.getElementById('kanbanJobFilter');
            const jobId = (jobSelect ? jobSelect.value : '') || (window.currentPipelineJobId || '');
