        // 8.3. Lên lịch phỏng vấn (Schedule Interview)
        async function openScheduleModal(applicationId, candidateName, jobTitle) {
            document.getElementById('schedApplicationId').value = applicationId;
            document.getElementById('schedCandidateName').textContent = candidateName || 'Ứng viên';
            document.getElementById('schedJobTitle').textContent = jobTitle || 'Vị trí';

            // Set default date to tomorrow at 09:00
            var tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            tomorrow.setHours(9, 0, 0, 0);
            var localIso = new Date(tomorrow.getTime() - tomorrow.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
            document.getElementById('schedDate').value = localIso;

            // Load internal interviewers
            var select = document.getElementById('schedPanelists');
            select.innerHTML = '<option disabled>Đang tải danh sách nhân sự...</option>';

            try {
                var res = await fetch('/Workspace/GetInterviewers');
                var data = await res.json();
                if (data.success && data.interviewers.length > 0) {
                    select.innerHTML = data.interviewers.map((u, idx) => `
                        <option value="${u.id}" ${idx === 0 ? 'selected' : ''}>${u.name} (${u.role}) - ${u.email}</option>
                    `).join('');
                } else {
                    select.innerHTML = '<option value="">(Chưa có người phỏng vấn khác trong CSDL)</option>';
                }
            } catch (e) {
                select.innerHTML = '<option value="">(Không thể tải danh sách)</option>';
            }

            var modal = new bootstrap.Modal(document.getElementById('scheduleInterviewModal'));
            modal.show();
        }

        async function handleScheduleInterviewSubmit(e) {
            e.preventDefault();
            var btn = document.getElementById('btnSubmitSched');
            var spinner = document.getElementById('spinnerSched');
            btn.disabled = true;
            spinner.classList.remove('d-none');

            var select = document.getElementById('schedPanelists');
            var selectedPanelists = Array.from(select.selectedOptions).map(o => o.value).filter(v => v);

            var payload = {
                applicationId: document.getElementById('schedApplicationId').value,
                scheduledDate: document.getElementById('schedDate').value,
                interviewType: document.getElementById('schedType').value,
                locationOrLink: document.getElementById('schedLocation').value,
                notes: document.getElementById('schedNotes').value,
                panelistIds: selectedPanelists
            };

            try {
                var res = await fetch('/Workspace/ScheduleInterview', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getCsrfToken()
                    },
                    body: JSON.stringify(payload)
                });
                var data = await res.json();
                if (data.success) {
                    bootstrap.Modal.getInstance(document.getElementById('scheduleInterviewModal')).hide();
                    showToast(data.message, true);
                    setTimeout(() => window.location.reload(), 1200);
                } else {
                    showToast(data.message || 'Lỗi khi lên lịch phỏng vấn', false);
                }
            } catch (err) {
                showToast('Lỗi kết nối: ' + err.message, false);
            } finally {
                btn.disabled = false;
                spinner.classList.add('d-none');
            }
        }

        // 8.4. Đề xuất Thư mời Offer
        function openCreateOfferModal(applicationId, candidateName, jobTitle) {
