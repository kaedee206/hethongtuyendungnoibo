            document.getElementById('offerCandidateName').textContent = candidateName || 'Ứng viên';
            document.getElementById('offerJobTitle').textContent = jobTitle || 'Vị trí';

            var now = new Date();
            var join = new Date();
            join.setDate(now.getDate() + 14);
            var exp = new Date();
            exp.setDate(now.getDate() + 7);

            document.getElementById('offerJoinDate').value = join.toISOString().split('T')[0];
            document.getElementById('offerExpirationDate').value = exp.toISOString().split('T')[0];

            var modal = new bootstrap.Modal(document.getElementById('createOfferModal'));
            modal.show();
        }

