        function validateSchedDateTime() {
            var timeInput = document.getElementById('schedDate');
            var errEl = document.getElementById('schedPastDateError');
            var btn = document.getElementById('btnSubmitSched');
            if (!timeInput) return true;

            var val = timeInput.value;
            if (!val) return false;

            var selectedDate = new Date(val);
            var now = new Date();

            if (selectedDate <= now) {
                if (errEl) errEl.classList.remove('d-none');
                timeInput.classList.add('is-invalid');
                if (btn) btn.disabled = true;
                return false;
            } else {
                if (errEl) errEl.classList.add('d-none');
                timeInput.classList.remove('is-invalid');
                if (btn) btn.disabled = false;
                triggerHomeConflictCheck();
                return true;
            }
        }

        function validateSchedPanelists() {
            var select = document.getElementById('schedPanelists');
            var errEl = document.getElementById('schedPanelistError');
            var btn = document.getElementById('btnSubmitSched');
            if (!select) return true;

            var selectedPanelists = Array.from(select.selectedOptions).map(o => o.value).filter(v => v);
            if (selectedPanelists.length === 0) {
                if (errEl) errEl.classList.remove('d-none');
                if (btn) btn.disabled = true;
                return false;
            } else {
                if (errEl) errEl.classList.add('d-none');
                var isDateValid = validateSchedDateTime();
                if (btn) btn.disabled = !isDateValid;
                triggerHomeConflictCheck();
                return true;
            }
        }

        function onSchedCandidateSelectChange(select) {
            var selectedOpt = select.options[select.selectedIndex];
            if (!selectedOpt || !selectedOpt.value) {
                document.getElementById('schedApplicationId').value = '';
                document.getElementById('schedCandidateName').textContent = '-';
                document.getElementById('schedJobTitle').textContent = '-';
                return;
            }
            var appId = selectedOpt.value;
            var candName = selectedOpt.getAttribute('data-name') || '';
            var jobTitle = selectedOpt.getAttribute('data-job') || '';
            var stageOrder = parseInt(selectedOpt.getAttribute('data-stage-order') || '1', 10);

            document.getElementById('schedApplicationId').value = appId;
            document.getElementById('schedCandidateName').textContent = candName;
            document.getElementById('schedJobTitle').textContent = jobTitle;

            var defaultRound = stageOrder >= 4 ? 2 : 1;
            var roundSelect = document.getElementById('schedRoundNumber');
            if (roundSelect) {
                roundSelect.value = String(defaultRound);
                if (typeof onSchedRoundChange === 'function') {
                    onSchedRoundChange(defaultRound);
                }
            }
            triggerHomeConflictCheck();
        }

        function onHomeSchedTypeChange(typeVal) {
            var roomGroup = document.getElementById('schedMeetingRoomGroup');
            var locInput = document.getElementById('schedLocation');
            if (typeVal === 'ONLINE_MEET') {
                if (roomGroup) roomGroup.style.display = 'none';
                if (locInput && (!locInput.value || locInput.value.startsWith('Phòng'))) {
                    locInput.value = 'https://meet.google.com/nov-' + Math.random().toString(36).substring(2, 6) + '-' + Math.random().toString(36).substring(2, 5);
                }
            } else {
                if (roomGroup) {
                    roomGroup.style.display = 'block';
                    loadHomeMeetingRooms();
                }
                if (locInput && (!locInput.value || locInput.value.startsWith('https://'))) {
                    locInput.value = 'Phòng Hội nghị Tầng 12 - Trụ sở NoveraTech';
                }
            }
            triggerHomeConflictCheck();
        }

        var homeMeetingRoomsLoaded = false;
        async function loadHomeMeetingRooms() {
            if (homeMeetingRoomsLoaded) return;
            var select = document.getElementById('schedMeetingRoomId');
            if (!select) return;
            try {
                var res = await fetch('/interviews/danh-sach-phong-hop', {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                var json = await res.json();
                var list = json.data || json;
                if (Array.isArray(list) && list.length > 0) {
                    select.innerHTML = '<option value="">-- Chọn phòng họp khả dụng --</option>' +
                        list.map(r => `<option value="${r.id}">${escapeHtml(r.name)}</option>`).join('');
                    homeMeetingRoomsLoaded = true;
                }
            } catch (e) {
                console.warn('Lỗi khi tải danh sách phòng họp:', e);
            }
        }

        function onHomeMeetingRoomChange(selectEl) {
            if (!selectEl) return;
            var selectedText = selectEl.options[selectEl.selectedIndex]?.text;
            var locInput = document.getElementById('schedLocation');
            if (locInput && selectEl.value && selectedText && !selectedText.startsWith('--')) {
                locInput.value = selectedText;
            }
            triggerHomeConflictCheck();
        }

        function triggerHomeConflictCheck() {
            if (!window.interviewConflict) return;
            var timeVal = document.getElementById('schedDate')?.value;
            var durationVal = document.getElementById('schedDuration')?.value || 60;
            var locVal = document.getElementById('schedLocation')?.value;
            var roomIdVal = document.getElementById('schedMeetingRoomId')?.value;
            var select = document.getElementById('schedPanelists');
            var selectedPanelists = select ? Array.from(select.selectedOptions).map(o => o.value).filter(v => v) : [];

            window.interviewConflict.scheduleCheck({
                startTime: timeVal,
                durationMinutes: durationVal,
                interviewerIds: selectedPanelists,
                meetingRoomId: roomIdVal,
                locationOrLink: locVal,
                submitBtnId: 'btnSubmitSched'
            });
        }

        async function openScheduleModal(applicationId, candidateName, jobTitle, roundNumber) {
            var candidateBox = document.getElementById('schedCandidateBox');
            var candidateSelectGroup = document.getElementById('schedCandidateSelectGroup');
            var candidateSelect = document.getElementById('schedCandidateSelect');

            if (applicationId && String(applicationId).trim() !== '') {
                document.getElementById('schedApplicationId').value = applicationId;
                document.getElementById('schedCandidateName').textContent = candidateName || 'Ứng viên';
                document.getElementById('schedJobTitle').textContent = jobTitle || 'Vị trí';
                if (candidateBox) candidateBox.style.display = 'block';
                if (candidateSelectGroup) candidateSelectGroup.style.display = 'none';
            } else {
                document.getElementById('schedApplicationId').value = '';
                document.getElementById('schedCandidateName').textContent = '-';
                document.getElementById('schedJobTitle').textContent = '-';
                if (candidateBox) candidateBox.style.display = 'none';
                if (candidateSelectGroup) candidateSelectGroup.style.display = 'block';
                if (candidateSelect) candidateSelect.value = '';
            }

            if (roundNumber) {
                var roundSelect = document.getElementById('schedRoundNumber');
                if (roundSelect) {
                    roundSelect.value = String(roundNumber);
                    if (typeof onSchedRoundChange === 'function') {
                        onSchedRoundChange(roundNumber);
                    }
                }
            }

            // Set default date to tomorrow at 09:00 and min to now
            var now = new Date();
            var localNowIso = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
            var dateInput = document.getElementById('schedDate');
            dateInput.min = localNowIso;

            var tomorrow = new Date(now);
            tomorrow.setDate(tomorrow.getDate() + 1);
            tomorrow.setHours(9, 0, 0, 0);
            var localIso = new Date(tomorrow.getTime() - tomorrow.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
            dateInput.value = localIso;

            // Reset conflict alert state (SCRUM-53)
            if (window.interviewConflict) {
                window.interviewConflict.resetAlert();
            }

            // Clear errors
            document.getElementById('schedPastDateError')?.classList.add('d-none');
            document.getElementById('schedPanelistError')?.classList.add('d-none');
            dateInput.classList.remove('is-invalid');

            // Default location
            onHomeSchedTypeChange('ONLINE_MEET');

            // Load internal interviewers
            var select = document.getElementById('schedPanelists');
            select.innerHTML = '<option disabled>Đang tải danh sách nhân sự...</option>';

            try {
                var res = await fetch('/Workspace/GetInterviewers', {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                var data = await res.json();
                var list = data.interviewers || data.data || [];
                if (list.length > 0) {
                    select.innerHTML = list.map((u, idx) => {
                        var uId = u.id || u.Id;
                        var uName = u.fullName || u.name || u.FullName || 'Nhân sự';
                        var uEmail = u.email || u.Email || '';
                        var uRole = u.role || u.Role || 'Interviewer';
                        return `<option value="${uId}" ${idx === 0 ? 'selected' : ''}>${uName} (${uRole}) - ${uEmail}</option>`;
                    }).join('');
                } else {
                    select.innerHTML = '<option value="">(Chưa có người phỏng vấn khác trong CSDL)</option>';
                }
            } catch (e) {
                select.innerHTML = '<option value="">(Không thể tải danh sách)</option>';
            }

            // Gắn lắng nghe và kích hoạt kiểm tra xung đột thời gian thực ban đầu
            triggerHomeConflictCheck();

            var modal = new bootstrap.Modal(document.getElementById('scheduleInterviewModal'));
            modal.show();
        }

        async function handleScheduleInterviewSubmit(e) {
            e.preventDefault();

            var appId = document.getElementById('schedApplicationId')?.value;
            if (!appId || appId.trim() === '') {
                showToast('Vui lòng chọn ứng viên cần lên lịch phỏng vấn.', false);
                return;
            }

            if (!validateSchedDateTime()) {
                showToast('Không thể đặt lịch trong quá khứ. Vui lòng chọn ngày giờ trong tương lai.', false);
                return;
            }

            var select = document.getElementById('schedPanelists');
            var selectedPanelists = Array.from(select.selectedOptions).map(o => o.value).filter(v => v);

            if (selectedPanelists.length === 0) {
                document.getElementById('schedPanelistError')?.classList.remove('d-none');
                showToast('Vui lòng chọn ít nhất một người phỏng vấn.', false);
                return;
            }

            var btn = document.getElementById('btnSubmitSched');
            var spinner = document.getElementById('spinnerSched');
            btn.disabled = true;
            spinner.classList.remove('d-none');

            var schedDateVal = document.getElementById('schedDate').value;
            var roundNumVal = parseInt(document.getElementById('schedRoundNumber')?.value, 10) || 1;
            var roundTitleVal = document.getElementById('schedRoundTitle')?.value || 'Phỏng vấn chuyên môn';
            var durationVal = parseInt(document.getElementById('schedDuration')?.value, 10) || 60;
            var meetingRoomId = document.getElementById('schedMeetingRoomId')?.value || null;
            var isOverridden = document.getElementById('chkIsOverridden')?.checked || false;
            var overrideReason = document.getElementById('txtOverrideReason')?.value?.trim() || '';

            var payload = {
                applicationId: document.getElementById('schedApplicationId').value,
                roundNumber: roundNumVal,
                roundTitle: roundTitleVal,
                startTime: schedDateVal,
                scheduledDate: schedDateVal,
                durationMinutes: durationVal,
                interviewType: document.getElementById('schedType').value,
                locationOrLink: document.getElementById('schedLocation').value,
                meetingRoomId: (meetingRoomId && meetingRoomId !== '') ? meetingRoomId : null,
                isOverridden: isOverridden,
                overrideReason: overrideReason,
                notes: document.getElementById('schedNotes').value,
                note: document.getElementById('schedNotes').value,
                interviewerIds: selectedPanelists,
                panelistIds: selectedPanelists
            };

            try {
                var res = await fetch('/Workspace/ScheduleInterview', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getCsrfToken(),
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify(payload)
                });
                var data = await res.json();
                if (data.success) {
                    bootstrap.Modal.getInstance(document.getElementById('scheduleInterviewModal')).hide();
                    showToast(data.message || 'Lên lịch phỏng vấn thành công!', true);
                    setTimeout(() => window.location.reload(), 1200);
                } else {
                    if (data.isConflict) {
                        if (window.interviewConflict) {
                            window.interviewConflict.renderResult(data.data || data);
                        }
                        showToast(data.message || 'Phát hiện xung đột lịch phỏng vấn! Vui lòng kiểm tra danh sách hoặc xác nhận ghi đè.', false);
                    } else {
                        showToast(data.message || 'Lỗi khi lên lịch phỏng vấn', false);
                    }
                }
            } catch (err) {
                showToast('Lỗi kết nối: ' + err.message, false);
            } finally {
                btn.disabled = false;
                spinner.classList.add('d-none');
            }
        }

        // 8.4. Đề xuất Thư mời Offer
        function openCreateOfferModal(applicationId, candidateName, jobTitle) {
            document.getElementById('offerApplicationId').value = applicationId;
            document.getElementById('offerCandidateName').textContent = candidateName || 'Ứng viên';
            document.getElementById('offerJobTitle').textContent = jobTitle || 'Vị trí';

            var now = new Date();
            var join = new Date();
            join.setDate(now.getDate() + 14);
            var exp = new Date();
            exp.setDate(now.getDate() + 7);

            document.getElementById('offerJoinDate').value = join.toISOString().split('T')[0];
            document.getElementById('offerExpirationDate').value = exp.toISOString().split('T')[0];

            var modal = new bootstrap.Modal(document.getElementById('createOfferModal'));
            modal.show();
        }

