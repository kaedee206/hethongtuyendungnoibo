        function filterPipelineCandidates(stageOrder, btnElement) {
            window.currentPipelineStage = stageOrder || 'ALL';
            window.candCurrentPage = 1;
            const pills = document.querySelectorAll('#candidateStageFilterGroup .candidate-stage-pill');
            if (btnElement) {
                pills.forEach(b => b.classList.remove('active'));
                btnElement.classList.add('active');
            } else if (pills.length > 0) {
                pills.forEach(b => {
                    b.classList.remove('active');
                    const oc = b.getAttribute('onclick') || '';
                    if (stageOrder === 'ALL' && oc.includes("'ALL'")) {
                        b.classList.add('active');
                    } else if (stageOrder === 'REFERRAL' && oc.includes("'REFERRAL'")) {
                        b.classList.add('active');
                    } else if (stageOrder === 'DUPLICATE' && oc.includes("'DUPLICATE'")) {
                        b.classList.add('active');
                    } else if (stageOrder !== 'ALL' && stageOrder !== 'REFERRAL' && stageOrder !== 'DUPLICATE' && oc.includes("'" + stageOrder + "'")) {
                        b.classList.add('active');
                    }
                });
            }
            applyPipelineFilters(true, true);
