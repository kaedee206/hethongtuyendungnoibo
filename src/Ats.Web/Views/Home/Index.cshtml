@section Scripts {
    <script src="~/js/interview-conflict.js"></script>
    <script>
        function getCsrfToken() {
            var input = document.querySelector('input[name="__RequestVerificationToken"]');
            return input ? input.value : '';
        }



        // 1. Ứng tuyển nhanh Modal
        function openApplyJobModal(id, title, dept) {
            document.getElementById('modalJobId').value = id;
            document.getElementById('modalJobTitle').textContent = title;
            document.getElementById('modalJobDept').textContent = dept;
            var modal = new bootstrap.Modal(document.getElementById('applyJobModal'));
            modal.show();
        }

        async function submitQuickApply() {
            var jobId = document.getElementById('modalJobId').value;
            var coverLetter = document.getElementById('modalCoverLetter').value;
            var btn = document.getElementById('btnSubmitApply');
            var spinner = document.getElementById('spinnerApply');

            btn.disabled = true;
            spinner.classList.remove('d-none');

            var formData = new FormData();
            formData.append('jobId', jobId);
            formData.append('coverLetter', coverLetter);
            formData.append('__RequestVerificationToken', getCsrfToken());

            try {
                var res = await fetch('/Workspace/ApplyJob', {
                    method: 'POST',
                    body: formData
                });
                var data = await res.json();
                if (data.success) {
                    var modalEl = document.getElementById('applyJobModal');
                    bootstrap.Modal.getInstance(modalEl).hide();
                    showToast(data.message, true);
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    showToast(data.message || 'Lỗi khi ứng tuyển', false);
                }
            } catch (err) {
                showToast('Lỗi kết nối máy chủ: ' + err.message, false);
            } finally {
                btn.disabled = false;
                spinner.classList.add('d-none');
            }
        }

        // 2. Cập nhật CV Form
        async function handleCvSubmit(e) {
            e.preventDefault();
            var btn = document.getElementById('btnSubmitCv');
            var spinner = document.getElementById('spinnerCv');
            btn.disabled = true;
            spinner.classList.remove('d-none');

            var form = document.getElementById('cvUpdateForm');
            var formData = new FormData(form);
            formData.append('__RequestVerificationToken', getCsrfToken());

            try {
                var res = await fetch('/Workspace/UpdateCv', {
                    method: 'POST',
                    body: formData
                });
                var data = await res.json();
                if (data.success) {
                    var modalEl = document.getElementById('updateCvModal');
                    bootstrap.Modal.getInstance(modalEl).hide();
                    showToast(data.message, true);
                    if (data.fileName) {
                        var cvText = document.getElementById('cvStatusText');
                        if (cvText) cvText.textContent = data.fileName;
                    }
                    if (data.phone) {
                        var phoneText = document.getElementById('cvCandidatePhone');
                        if (phoneText) phoneText.textContent = data.phone;
                    }
                    if (data.fullName) {
                        var nameText = document.getElementById('cvCandidateName');
                        if (nameText) nameText.textContent = data.fullName;
                    }
                } else {
                    showToast(data.message || 'Lỗi khi cập nhật CV', false);
                }
            } catch (err) {
                showToast('Lỗi kết nối máy chủ: ' + err.message, false);
            } finally {
                btn.disabled = false;
                spinner.classList.add('d-none');
            }
        }

        // 3. Phê duyệt Offer thực tế
        async function approveSelectedOffer(offerId, name, pos, salary) {
            if (!confirm('Xác nhận PHÊ DUYỆT thư mời nhận việc (Offer Letter) cho ứng viên ' + name + ' với vị trí ' + pos + ' (Mức lương: ' + salary + ')?')) {
                return;
            }

            var formData = new FormData();
            formData.append('offerId', offerId);
            formData.append('candidateName', name);
            formData.append('__RequestVerificationToken', getCsrfToken());

            try {
                var res = await fetch('/Workspace/ApproveOffer', {
                    method: 'POST',
                    body: formData
                });
                var data = await res.json();
                if (data.success) {
                    showToast(data.message, true);
                    var kpiOffer = document.getElementById('kpiPendingOffers');
                    if (kpiOffer) {
                        var count = parseInt(kpiOffer.textContent || '1') - 1;
                        kpiOffer.textContent = Math.max(0, count);
                    }
                    var container = document.getElementById('approverActionContainer');
                    if (container) {
                        container.innerHTML = '<div class="p-3 text-center my-2" style="background:#F8FAFC; border:1px dashed #CBD5E1; border-radius:8px;"><i class="bi bi-check-circle-fill text-success fs-4 d-block mb-1"></i><div class="fw-semibold text-dark small">Đã duyệt Offer ' + name + '</div></div>';
                    }
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    showToast(data.message || 'Lỗi khi duyệt Offer', false);
                }
            } catch (err) {
                showToast('Lỗi kết nối: ' + err.message, false);
            }
        }

        // 4. Tạo tin tuyển dụng mới
        async function handleJobCreateSubmit(e) {
            e.preventDefault();
            var btn = document.getElementById('btnSubmitJobCreate');
            var spinner = document.getElementById('spinnerJobCreate');
            btn.disabled = true;
            spinner.classList.remove('d-none');

            var formData = new FormData();
            formData.append('title', document.getElementById('newJobTitle').value);
            formData.append('deptName', document.getElementById('newJobDept').value);
            formData.append('quantity', document.getElementById('newJobQuantity').value);
            formData.append('salaryDisplay', document.getElementById('newJobSalary').value);
            formData.append('expiredDate', document.getElementById('newJobExpiredDate').value);
            formData.append('description', document.getElementById('newJobDescription').value);
            formData.append('__RequestVerificationToken', getCsrfToken());

            try {
                var res = await fetch('/Workspace/CreateJobPosting', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': getCsrfToken()
                    },
                    body: formData
                });
                var data = {};
                try {
                    data = await res.json();
                } catch (jsonErr) {
                    data = { success: false, message: 'Phản hồi từ máy chủ không hợp lệ (Mã: ' + res.status + ')' };
                }
                if (data.success) {
                    var modalEl = document.getElementById('createJobModal');
                    if (modalEl) {
                        var modalInst = bootstrap.Modal.getInstance(modalEl);
                        if (modalInst) modalInst.hide();
                    }
                    showToast(data.message, true);
                    var kpiJobs = document.getElementById('kpiOpenJobs');
                    if (kpiJobs) {
                        kpiJobs.textContent = parseInt(kpiJobs.textContent || '0') + 1;
                    }
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    showToast(data.message || 'Lỗi tạo tin', false);
                }
            } catch (err) {
                showToast('Lỗi kết nối: ' + err.message, false);
            } finally {
                btn.disabled = false;
                spinner.classList.add('d-none');
            }
        }

        // 5. Khởi tạo đề xuất nhân sự (Đồng bộ chuẩn Module Requisitions EP-03)
        var reqOptionsLoaded = false;
        var reqPositionsData = [];

        function formatVndNumber(val) {
            if (!val && val !== 0) return '';
            var clean = val.toString().replace(/\D/g, '');
            if (!clean) return '';
            return new Intl.NumberFormat('vi-VN').format(clean);
        }

        function parseRawVnd(val) {
            if (!val) return 0;
            return parseInt(val.toString().replace(/\D/g, ''), 10) || 0;
        }

        async function loadRequisitionOptions() {
            if (reqOptionsLoaded) return;
            try {
                var res = await fetch('/yeu-cau-tuyen-dung/api/form-options');
                if (!res.ok) return;
                var data = await res.json();
                if (data.success) {
                    reqPositionsData = data.jobPositions || [];

                    var posSelect = document.getElementById('reqPositionId');
                    if (posSelect) {
                        posSelect.innerHTML = '<option value="">-- Chọn chức danh cần tuyển --</option>';
                        reqPositionsData.forEach(function (p) {
                            var opt = document.createElement('option');
                            opt.value = p.id;
                            opt.textContent = p.title + ' (' + p.code + ' - ' + p.jobLevel + ')';
                            opt.dataset.deptId = p.departmentId || '';
                            opt.dataset.deptName = p.departmentName || '';
                            opt.dataset.minSalary = p.standardMinSalary || 0;
                            opt.dataset.maxSalary = p.standardMaxSalary || 0;
                            posSelect.appendChild(opt);
                        });
                    }

                    var deptSelect = document.getElementById('reqDepartmentId');
                    if (deptSelect) {
                        deptSelect.innerHTML = '<option value="">-- Chọn phòng ban --</option>';
                        (data.departments || []).forEach(function (d) {
                            var opt = document.createElement('option');
                            opt.value = d.id;
                            opt.textContent = d.name + ' (' + d.code + ')';
                            deptSelect.appendChild(opt);
                        });

                        if (data.defaultDepartmentId) {
                            deptSelect.value = data.defaultDepartmentId;
                        }

                        if (!data.canChangeDepartment) {
                            deptSelect.classList.add('bg-light');
                            var deptNotice = document.getElementById('reqDeptNotice');
                            if (deptNotice) {
                                deptNotice.textContent = 'Phòng ban được cố định theo bộ phận quản lý của bạn';
                            }
                        }
                    }

                    reqOptionsLoaded = true;
                }
            } catch (err) {
                console.error('Lỗi nạp danh mục tuyển dụng:', err);
            }
        }

        function handleModalPositionChange() {
            var posSelect = document.getElementById('reqPositionId');
            if (!posSelect) return;
            var selectedOpt = posSelect.options[posSelect.selectedIndex];
            if (!selectedOpt || !selectedOpt.value) return;

            var deptId = selectedOpt.dataset.deptId;
            var deptSelect = document.getElementById('reqDepartmentId');
            if (deptId && deptSelect && !deptSelect.disabled) {
                deptSelect.value = deptId;
            }

            var min = parseRawVnd(selectedOpt.dataset.minSalary);
            var max = parseRawVnd(selectedOpt.dataset.maxSalary);
            if (min > 0) {
                document.getElementById('reqMinSalaryFormatted').value = formatVndNumber(min);
            }
            if (max > 0) {
                document.getElementById('reqMaxSalaryFormatted').value = formatVndNumber(max);
            }
        }

        function showReqModalAlert(msg) {
            var alertEl = document.getElementById('reqModalAlert');
            if (alertEl) {
                alertEl.textContent = msg;
                alertEl.classList.remove('d-none');
            } else {
                showToast(msg, false);
            }
        }

        async function handleReqSubmit(e) {
            e.preventDefault();
            var alertEl = document.getElementById('reqModalAlert');
            if (alertEl) {
                alertEl.classList.add('d-none');
                alertEl.textContent = '';
            }

            var positionId = document.getElementById('reqPositionId').value;
            var departmentId = document.getElementById('reqDepartmentId').value;
            var quantity = parseInt(document.getElementById('reqQuantity').value, 10);
            var headcountType = document.getElementById('reqHeadcountType').value;
            var targetDate = document.getElementById('reqDate').value;
            var minSalary = parseRawVnd(document.getElementById('reqMinSalaryFormatted').value);
            var maxSalary = parseRawVnd(document.getElementById('reqMaxSalaryFormatted').value);
            var reasonDesc = document.getElementById('reqDescription').value;

            if (!positionId) {
                showReqModalAlert('Vui lòng chọn chức danh cần tuyển dụng.');
                return;
            }
            if (!departmentId) {
                showReqModalAlert('Vui lòng chọn phòng ban đề xuất.');
                return;
            }
            if (!quantity || quantity < 1) {
                showReqModalAlert('Số lượng cần tuyển tối thiểu là 1 người.');
                return;
            }
            if (!targetDate) {
                showReqModalAlert('Vui lòng chọn ngày cần có nhân sự.');
                return;
            }
            var todayStr = new Date().toISOString().split('T')[0];
            if (targetDate < todayStr) {
                showReqModalAlert('Ngày cần có nhân sự không thể là ngày trong quá khứ.');
                return;
            }
            if (minSalary <= 0 || maxSalary <= 0) {
                showReqModalAlert('Vui lòng nhập dải lương đề xuất hợp lệ (lớn hơn 0).');
                return;
            }
            if (minSalary > maxSalary) {
                showReqModalAlert('Mức lương tối thiểu không được lớn hơn mức lương tối đa.');
                return;
            }

            var btn = document.getElementById('btnSubmitReq');
            var spinner = document.getElementById('spinnerReq');
            btn.disabled = true;
            spinner.classList.remove('d-none');

            var formData = new FormData();
            formData.append('JobPositionId', positionId);
            formData.append('DepartmentId', departmentId);
            formData.append('Quantity', quantity);
            formData.append('HeadcountType', headcountType);
            formData.append('MinSalary', minSalary);
            formData.append('MaxSalary', maxSalary);
            formData.append('TargetHireDate', targetDate);
            formData.append('ReasonDescription', reasonDesc);
            formData.append('__RequestVerificationToken', getCsrfToken());

            try {
                var res = await fetch('/yeu-cau-tuyen-dung/api/quick-create', {
                    method: 'POST',
                    body: formData
                });
                var data = await res.json();
                if (res.ok && data.success) {
                    var modalEl = document.getElementById('createRequisitionModal');
                    bootstrap.Modal.getInstance(modalEl).hide();
                    document.getElementById('reqForm').reset();
                    showToast(data.message, true);
                } else {
                    showReqModalAlert(data.message || 'Lỗi gửi đề xuất.');
                }
            } catch (err) {
                showReqModalAlert('Lỗi kết nối máy chủ: ' + err.message);
            } finally {
                btn.disabled = false;
                spinner.classList.add('d-none');
            }
        }

        // 6. Đánh giá phỏng vấn sau buổi phỏng vấn (Scrum - Số 57)
        let currentEvaluationSheetData = null;

        async function openEvaluationForInterview(interviewId, candidateName, jobTitle) {
            var select = document.getElementById('evalInterviewId');
            if (select && interviewId) {
                let exists = false;
                for (let i = 0; i < select.options.length; i++) {
                    if (select.options[i].value === interviewId) {
                        exists = true;
                        break;
                    }
                }
                if (!exists) {
                    let opt = document.createElement('option');
                    opt.value = interviewId;
                    opt.textContent = `${candidateName || 'Ứng viên'} - ${jobTitle || 'Vị trí'} (Vòng phỏng vấn)`;
                    select.appendChild(opt);
                }
                select.value = interviewId;
            }

            var modalEl = document.getElementById('interviewEvaluationModal');
            var modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
            modal.show();

            var activeInterviewId = interviewId || (select ? select.value : null);
            if (activeInterviewId) {
                await loadEvaluationSheet(activeInterviewId);
            }
        }

        async function onEvalInterviewChanged(interviewId) {
            if (!interviewId) return;
            await loadEvaluationSheet(interviewId);
        }

        async function loadEvaluationSheet(interviewId) {
            if (!interviewId) return;

            const loadingEl = document.getElementById('evalModalLoading');
            const alertEl = document.getElementById('evalModalAlert');
            const alertMsg = document.getElementById('evalModalAlertMsg');
            const lockBanner = document.getElementById('evalLockBanner');
            const reopenBanner = document.getElementById('evalReopenBanner');
            const notPanelistBanner = document.getElementById('evalNotPanelistBanner');
            const fieldsetEl = document.getElementById('evalFormFieldset');
            const submitBtn = document.getElementById('btnSubmitEval');
            const submitBtnText = document.getElementById('btnSubmitEvalText');
            const statusBadge = document.getElementById('evalStatusBadge');
            const footerInfo = document.getElementById('evalFooterInfo');

            // Reset trạng thái ban đầu
            loadingEl.classList.remove('d-none');
            alertEl.classList.add('d-none');
            lockBanner.classList.add('d-none');
            reopenBanner.classList.add('d-none');
            notPanelistBanner.classList.add('d-none');
            fieldsetEl.disabled = false;
            submitBtn.disabled = false;
            submitBtn.classList.remove('d-none');
            footerInfo.innerHTML = '';

            try {
                const response = await fetch(`/interviews/${interviewId}/evaluation`);
                const result = await response.json();

                if (!response.ok || !result.success) {
                    // Tiêu chí 1: Chỉ người phỏng vấn được mời mới mở được phiếu của buổi đó
                    loadingEl.classList.add('d-none');
                    alertEl.classList.remove('d-none');
                    alertMsg.textContent = result.message || 'Chỉ người phỏng vấn được mời mới mở được phiếu của buổi phỏng vấn này.';
                    fieldsetEl.disabled = true;
                    submitBtn.classList.add('d-none');
                    statusBadge.className = 'badge bg-danger-subtle text-danger small';
                    statusBadge.textContent = 'Không có quyền truy cập';
                    document.getElementById('panelEvaluationsContainer').innerHTML = `
                        <div class="alert alert-secondary text-muted small py-3 mb-0">
                            <i class="bi bi-shield-lock me-1"></i>Dữ liệu đánh giá chỉ hiển thị cho giám khảo được mời và ban tuyển dụng.
                        </div>`;
                    return;
                }

                const data = result.data;
                currentEvaluationSheetData = data;

                // Cập nhật thông tin phiên phỏng vấn
                document.getElementById('evalCandidateName').textContent = data.candidateName || '---';
                document.getElementById('evalJobTitle').textContent = data.jobTitle || '---';
                document.getElementById('evalTimeDisplay').textContent = `${data.interviewDateDisplay} (${data.timeDisplay})` || '---';
                document.getElementById('evalPanelists').textContent = data.panelistNames || '---';
                document.getElementById('evalCandidateSubtitle').textContent = `Vòng ${data.roundNumber}: ${data.roundTitle || 'Phỏng vấn chuyên môn'}`;

                // Điền dữ liệu phiếu của người dùng hiện tại
                if (data.overallScore) {
                    document.getElementById('evalScore').value = parseFloat(data.overallScore).toFixed(1);
                } else {
                    document.getElementById('evalScore').value = '4.0';
                }

                if (data.recommendation) {
                    document.getElementById('evalRecommendation').value = data.recommendation;
                } else {
                    document.getElementById('evalRecommendation').value = '';
                }

                document.getElementById('evalStrengths').value = data.strengths || '';
                document.getElementById('evalWeaknesses').value = data.weaknesses || '';
                document.getElementById('evalFeedback').value = data.detailedFeedback || '';

                // Tiêu chí 3: Đã nộp thì không sửa được, trừ khi recruiter mở lại trong 24 giờ
                if (!data.isInvitedPanelist && data.isStaffManager) {
                    // Quản trị viên / Recruiter xem
                    notPanelistBanner.classList.remove('d-none');
                    fieldsetEl.disabled = true;
                    submitBtn.classList.add('d-none');
                    statusBadge.className = 'badge bg-info-subtle text-info small';
                    statusBadge.textContent = 'Chế độ xem Quản trị';
                } else if (data.isSubmitted && !data.isReopened) {
                    // Đã nộp -> Khóa chỉnh sửa
                    lockBanner.classList.remove('d-none');
                    fieldsetEl.disabled = true;
                    submitBtn.disabled = true;
                    submitBtnText.textContent = 'Phiếu đã nộp (Đã khóa)';
                    statusBadge.className = 'badge bg-success-subtle text-success small';
                    statusBadge.innerHTML = `<i class="bi bi-lock-fill me-1"></i>Đã nộp (${data.submittedAtDisplay || ''})`;
                    footerInfo.innerHTML = `<i class="bi bi-info-circle me-1 text-primary"></i>Phiếu nộp lúc: <strong>${data.submittedAtDisplay || ''}</strong>. Muốn sửa cần liên hệ Recruiter mở lại trong 24h.`;
                } else if (data.isReopened) {
                    // Được Recruiter mở lại trong 24 giờ
                    reopenBanner.classList.remove('d-none');
                    document.getElementById('evalReopenReasonText').textContent = data.reopenReason || 'Recruiter yêu cầu bổ sung/sửa đổi nhận định';
                    fieldsetEl.disabled = false;
                    submitBtn.disabled = false;
                    submitBtnText.textContent = 'Cập nhật và nộp lại phiếu';
                    statusBadge.className = 'badge bg-warning-subtle text-warning small';
                    statusBadge.innerHTML = `<i class="bi bi-unlock-fill me-1"></i>Đã mở lại bởi ${data.reopenedByUserName || 'Recruiter'}`;
                    footerInfo.innerHTML = `<i class="bi bi-exclamation-triangle text-warning me-1"></i>Phiếu đang mở lại để chỉnh sửa. Vui lòng bấm Nộp lại sau khi cập nhật.`;
                } else {
                    // Chưa nộp
                    fieldsetEl.disabled = false;
                    submitBtn.disabled = false;
                    submitBtnText.textContent = 'Nộp phiếu đánh giá';
                    statusBadge.className = 'badge bg-secondary-subtle text-secondary small';
                    statusBadge.textContent = 'Chưa nộp';
                }

                // Tiêu chí 4: Không nhìn thấy đánh giá của người khác trước khi nộp phiếu của mình
                renderPanelEvaluations(data);

            } catch (err) {
                alertEl.classList.remove('d-none');
                alertMsg.textContent = 'Lỗi kết nối tải dữ liệu: ' + err.message;
                fieldsetEl.disabled = true;
                submitBtn.classList.add('d-none');
            } finally {
                loadingEl.classList.add('d-none');
            }
        }

        // Render danh sách đánh giá của Hội đồng theo Tiêu chí 4 (Blind Evaluation)
        function renderPanelEvaluations(data) {
            const container = document.getElementById('panelEvaluationsContainer');
            const countBadge = document.getElementById('panelEvaluationsBadge');

            if (!data.canViewOtherEvaluations) {
                // Đánh giá của người khác bị ẩn theo quy tắc Blind Review
                countBadge.textContent = 'Đang ẩn (Blind Evaluation)';
                countBadge.className = 'badge bg-warning-subtle text-warning border';
                container.innerHTML = `
                    <div class="card border border-warning-subtle bg-warning bg-opacity-10 p-3" style="border-radius: 8px;">
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-shield-lock-fill text-warning fs-5"></i>
                            <div>
                                <div class="fw-bold text-dark small">Bảo mật đánh giá độc lập (Blind Evaluation)</div>
                                <div class="text-muted small mt-1">
                                    ${data.blindReviewNotice || 'Bạn chưa nộp phiếu đánh giá của mình. Để đảm bảo tính khách quan và độc lập giữa các giám khảo, nhận định và điểm số của các giám khảo khác sẽ được hiển thị ngay sau khi bạn hoàn tất nộp phiếu.'}
                                </div>
                            </div>
                        </div>
                    </div>`;
                return;
            }

            // Đủ điều kiện xem đánh giá của người khác
            const list = data.panelEvaluations || [];
            countBadge.textContent = `${list.length} đánh giá từ Hội đồng`;
            countBadge.className = 'badge bg-success-subtle text-success border';

            if (list.length === 0) {
                container.innerHTML = `
                    <div class="text-muted small py-3 text-center border rounded-3 bg-light">
                        <i class="bi bi-info-circle me-1"></i>Chưa có giám khảo nào khác nộp phiếu đánh giá cho phiên phỏng vấn này.
                    </div>`;
                return;
            }

            let html = '<div class="d-flex flex-column gap-2">';
            list.forEach(p => {
                let recBadgeClass = 'bg-secondary';
                let recText = p.recommendationDisplay || 'Chưa kết luận';
                if (p.recommendation === 'HIRE' || recText === 'Nên tuyển') {
                    recBadgeClass = 'bg-success';
                } else if (p.recommendation === 'CONSIDER' || recText === 'Cân nhắc') {
                    recBadgeClass = 'bg-warning text-dark';
                } else if (p.recommendation === 'STRONG_NO_HIRE' || recText === 'Không nên tuyển') {
                    recBadgeClass = 'bg-danger';
                }

                let reopenBtn = '';
                if (p.canRecruiterReopen) {
                    reopenBtn = `
                        <button type="button" class="btn btn-sm btn-outline-warning py-1 px-2 ms-auto" style="font-size: 0.72rem; border-radius: 6px;"
                                onclick="promptReopenEvaluation('${p.evaluationId}', '${p.panelistName}')"
                                title="Mở lại phiếu trong 24 giờ cho giám khảo cập nhật lại">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Mở lại (${p.hoursRemainingToReopen.toFixed(1)}h)
                        </button>`;
                }

                html += `
                    <div class="card border p-3 shadow-none bg-white" style="border-radius: 8px;">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle d-flex align-items-center justify-content-center bg-primary-subtle text-primary fw-bold" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                    ${escapeHtml((p.panelistName || 'G').substring(0, 1).toUpperCase())}
                                </div>
                                <div>
                                    <div class="fw-bold text-dark small">${escapeHtml(p.panelistName)}</div>
                                    <div class="text-muted" style="font-size: 0.7rem;">${escapeHtml(p.roleTitle || 'Giám khảo')} • Nộp lúc: ${escapeHtml(p.submittedAtDisplay || 'Chưa ghi nhận')}</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge ${recBadgeClass}" style="font-size: 0.75rem;">${escapeHtml(recText)}</span>
                                <span class="badge bg-light text-dark border" style="font-size: 0.75rem;"><i class="bi bi-star-fill text-warning me-1"></i>${p.overallScore ? p.overallScore.toFixed(1) : '-'} / 5</span>
                                ${reopenBtn}
                            </div>
                        </div>
                        ${p.strengths ? `<div class="small text-muted mb-1"><strong>Điểm mạnh:</strong> ${escapeHtml(p.strengths)}</div>` : ''}
                        ${p.weaknesses ? `<div class="small text-muted mb-1"><strong>Điểm cải thiện:</strong> ${escapeHtml(p.weaknesses)}</div>` : ''}
                        ${p.detailedFeedback ? `<div class="small text-dark p-2 rounded bg-light border-start border-3 border-primary" style="font-size: 0.82rem;">${escapeHtml(p.detailedFeedback)}</div>` : ''}
                    </div>`;
            });
            html += '</div>';
            container.innerHTML = html;
        }

        // Xử lý nộp phiếu với Tiêu chí 2: Bắt buộc chọn kết luận (Nên tuyển, Cân nhắc, Không nên tuyển)
        async function handleEvalSubmit(e) {
            e.preventDefault();

            const recommendationSelect = document.getElementById('evalRecommendation');
            const recommendation = recommendationSelect.value;
            if (!recommendation) {
                recommendationSelect.classList.add('is-invalid');
                showToast('Bắt buộc chọn kết luận đánh giá: Nên tuyển, Cân nhắc hoặc Không nên tuyển.', false);
                recommendationSelect.focus();
                return;
            }
            recommendationSelect.classList.remove('is-invalid');

            const btn = document.getElementById('btnSubmitEval');
            const spinner = document.getElementById('spinnerEval');
            btn.disabled = true;
            spinner.classList.remove('d-none');

            const interviewId = document.getElementById('evalInterviewId').value;
            const formData = new FormData();
            formData.append('InterviewId', interviewId);
            formData.append('OverallScore', document.getElementById('evalScore').value);
            formData.append('Recommendation', recommendation);
            formData.append('Strengths', document.getElementById('evalStrengths').value);
            formData.append('Weaknesses', document.getElementById('evalWeaknesses').value);
            formData.append('DetailedFeedback', document.getElementById('evalFeedback').value);
            formData.append('__RequestVerificationToken', getCsrfToken());

            try {
                const res = await fetch('/interviews/evaluation/submit', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message || 'Nộp phiếu đánh giá thành công!', true);
                    // Tải lại phiếu ngay trong modal để hiển thị trạng thái đã khóa và mở ẩn đánh giá của giám khảo khác
                    await loadEvaluationSheet(interviewId);
                    setTimeout(() => {
                        window.location.reload();
                    }, 1500);
                } else {
                    showToast(data.message || 'Lỗi khi nộp phiếu đánh giá.', false);
                }
            } catch (err) {
                showToast('Lỗi kết nối máy chủ: ' + err.message, false);
            } finally {
                btn.disabled = false;
                spinner.classList.add('d-none');
            }
        }

        // Modal mở lại phiếu trong vòng 24 giờ của Recruiter (Tiêu chí 3)
        function promptReopenEvaluation(evaluationId, panelistName) {
            document.getElementById('reopenEvaluationId').value = evaluationId;
            document.getElementById('reopenPanelistName').textContent = panelistName || 'Giám khảo';
            document.getElementById('reopenReasonInput').value = '';

            const modalEl = document.getElementById('reopenEvaluationModal');
            const modal = new bootstrap.Modal(modalEl);
            modal.show();
        }

        async function handleReopenSubmit(e) {
            e.preventDefault();
            const evalId = document.getElementById('reopenEvaluationId').value;
            const reason = document.getElementById('reopenReasonInput').value;
            const btn = document.getElementById('btnConfirmReopen');
            const spinner = document.getElementById('spinnerReopen');

            btn.disabled = true;
            spinner.classList.remove('d-none');

            const formData = new FormData();
            formData.append('reason', reason);
            formData.append('__RequestVerificationToken', getCsrfToken());

            try {
                const res = await fetch(`/interviews/evaluations/${evalId}/reopen`, {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message || 'Đã mở lại phiếu đánh giá thành công.', true);
                    const modalEl = document.getElementById('reopenEvaluationModal');
                    bootstrap.Modal.getInstance(modalEl).hide();

                    if (currentEvaluationSheetData && currentEvaluationSheetData.interviewId) {
                        await loadEvaluationSheet(currentEvaluationSheetData.interviewId);
                    }
                } else {
                    showToast(data.message || 'Không thể mở lại phiếu.', false);
                }
            } catch (err) {
                showToast('Lỗi khi mở lại phiếu: ' + err.message, false);
            } finally {
                btn.disabled = false;
                spinner.classList.add('d-none');
            }
        }

        function showEvaluationDetails(resultText) {
            alert('Chi tiết đánh giá phỏng vấn:\n' + resultText);
        }

        document.addEventListener('DOMContentLoaded', function () {
            var evalModal = document.getElementById('interviewEvaluationModal');
            if (evalModal) {
                evalModal.addEventListener('shown.bs.modal', function () {
                    var select = document.getElementById('evalInterviewId');
                    if (select && select.value && (!currentEvaluationSheetData || currentEvaluationSheetData.interviewId !== select.value)) {
                        loadEvaluationSheet(select.value);
                    }
                });
            }
        });

        // 7. Lịch phỏng vấn ứng viên xác nhận / đổi lịch
        async function confirmCandidateInterview(interviewId) {
            var formData = new FormData();
            formData.append('interviewId', interviewId);
            formData.append('__RequestVerificationToken', getCsrfToken());

            try {
                var res = await fetch('/Workspace/ConfirmInterview', {
                    method: 'POST',
                    body: formData
                });
                var data = await res.json();
                if (data.success) {
                    showToast(data.message, true);
                    var stText = document.getElementById('candidateInterviewStatusText');
                    if (stText) stText.textContent = "Đã xác nhận tham gia";
                } else {
                    showToast(data.message, false);
                }
            } catch (err) {
                showToast('Lỗi: ' + err.message, false);
            }
        }

        async function requestReschedulePrompt(interviewId) {
            var reason = prompt('Vui lòng nhập lý do và thời gian bạn có thể tham gia phỏng vấn:');
            if (!reason) return;

            var formData = new FormData();
            formData.append('interviewId', interviewId);
            formData.append('reason', reason);
            formData.append('__RequestVerificationToken', getCsrfToken());

            try {
                var res = await fetch('/Workspace/RequestReschedule', {
                    method: 'POST',
                    body: formData
                });
                var data = await res.json();
                if (data.success) {
                    showToast(data.message, true);
                    var stText = document.getElementById('candidateInterviewStatusText');
                    if (stText) stText.textContent = "Đã gửi yêu cầu đổi lịch hẹn";
                } else {
                    showToast(data.message, false);
                }
            } catch (err) {
                showToast('Lỗi: ' + err.message, false);
            }
        }

        // Scrum - Số 54: Hiển thị modal xem lý do đổi lịch & Copy link mời
        var activeRescheduleData = null;
        function showCandidateRescheduleModal(candidateName, notes, interviewId, applicationId, jobTitle) {
            var nameEl = document.getElementById('modalRescheduleCandidateName');
            var noteEl = document.getElementById('modalRescheduleCandidateNotes');
            if (nameEl) nameEl.textContent = candidateName || 'Ứng viên';
            if (noteEl) noteEl.textContent = notes || 'Không có ghi chú thêm.';
            activeRescheduleData = {
                candidateName: candidateName,
                interviewId: interviewId,
                applicationId: applicationId,
                jobTitle: jobTitle
            };
            var modal = new bootstrap.Modal(document.getElementById('candidateRescheduleNoteModal'));
            modal.show();
        }

        function onCandidateRescheduleProceed() {
            var noteModal = bootstrap.Modal.getInstance(document.getElementById('candidateRescheduleNoteModal'));
            if (noteModal) noteModal.hide();
            if (activeRescheduleData && activeRescheduleData.applicationId) {
                openScheduleModal(activeRescheduleData.applicationId, activeRescheduleData.candidateName, activeRescheduleData.jobTitle);
            }
        }

        function copyCandidateInviteUrl(url) {
            if (!url) return;
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(url).then(function () {
                    showToast('Đã sao chép liên kết thư mời ứng viên!', true);
                }).catch(function () {
                    prompt('Sao chép liên kết mời ứng viên bên dưới:', url);
                });
            } else {
                prompt('Sao chép liên kết mời ứng viên bên dưới:', url);
            }
        }

        // 8. Lọc danh sách hồ sơ ứng viên
        function filterCandidates(stage) {
            var modal = new bootstrap.Modal(document.getElementById('candidateFilterModal'));
            modal.show();
            loadCandidatesByStage(stage);
        }

        window.lastFilteredStage = 'ALL';
        async function loadCandidatesByStage(stage, btnElement) {
            stage = stage || window.lastFilteredStage || 'ALL';
            window.lastFilteredStage = stage;

            if (btnElement) {
                var group = btnElement.parentElement.querySelectorAll('button');
                group.forEach(b => {
                    b.classList.remove('active');
                    b.classList.remove('btn-outline-success');
                    b.classList.add('btn-outline-secondary');
                });
                btnElement.classList.add('active');
                btnElement.classList.remove('btn-outline-secondary');
                btnElement.classList.add('btn-outline-success');
            }

            var tbody = document.getElementById('filteredCandidatesBody');
            tbody.innerHTML = '<tr><td colspan="4" class="text-center py-3 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Đang truy vấn CSDL...</td></tr>';

            var recSelect = document.getElementById('filterCandidateRecruiterSelect');
            var recId = recSelect ? recSelect.value : '';

            var url = '/Workspace/FilterCandidates?stage=' + encodeURIComponent(stage);
            if (recId) {
                url += '&recruiterId=' + encodeURIComponent(recId);
            }

            try {
                var res = await fetch(url);
                var data = await res.json();
                if (data.success && data.candidates.length > 0) {
                    tbody.innerHTML = data.candidates.map(c => `
                        <tr>
                            <td class="py-2.5">
                                <div class="fw-bold text-dark">${escapeHtml(c.candidateName)}</div>
                                <small class="text-muted" style="font-family:'JetBrains Mono',monospace;">${escapeHtml(c.candidateEmail)} · ${escapeHtml(c.candidatePhone)}</small>
                            </td>
                            <td class="py-2.5"><span class="fw-semibold text-dark">${escapeHtml(c.jobTitle)}</span></td>
                            <td class="py-2.5"><span class="badge" style="background:${escapeHtml(c.stageColor)};color:#fff;border-radius:6px;font-size:0.72rem;">${escapeHtml(c.stageName)}</span></td>
                            <td class="py-2.5 text-muted small">${escapeHtml(c.appliedDate)}</td>
                        </tr>
                    `).join('');
                } else {
                    tbody.innerHTML = '<tr><td colspan="4" class="text-center py-4 text-muted">Không tìm thấy hồ sơ nào trong giai đoạn này.</td></tr>';
                }
            } catch (err) {
                tbody.innerHTML = '<tr><td colspan="4" class="text-center py-3 text-danger">Lỗi khi tải dữ liệu: ' + err.message + '</td></tr>';
            }
        }

        // ==============================================================
        // SCRUM-319: KANBAN PIPELINE BOARD & DRAG-AND-DROP CONTROLLER
        // ==============================================================
        window.currentPipelineStage = 'ALL';
        window.currentPipelineJob = '@(Model.DefaultJobPostingId?.ToString() ?? "ALL")';
        window.pipelineViewMode = localStorage.getItem('ats_pipeline_view_mode') || 'kanban';
        window.candCurrentPage = 1;
        window.candPageSize = 10;

        let draggedApplicationId = null;
        let draggedCardElement = null;
        let originalStageOrder = null;

        function switchPipelineView(mode) {
            window.pipelineViewMode = mode;
            try { localStorage.setItem('ats_pipeline_view_mode', mode); } catch (_) {}

            const kanbanContainer = document.getElementById('candidateKanbanViewContainer');
            const tableContainer = document.getElementById('candidateTableViewContainer');
            const stageFilterGroup = document.getElementById('candidateStageFilterGroup');
            const btnKanban = document.getElementById('btnPipelineKanbanView');
            const btnTable = document.getElementById('btnPipelineTableView');

            const detailModeGroup = document.getElementById('kanbanDetailModeGroup');
            if (detailModeGroup) {
                if (mode === 'kanban') {
                    detailModeGroup.classList.remove('d-none');
                } else {
                    detailModeGroup.classList.add('d-none');
                }
            }

            if (mode === 'kanban') {
                if (kanbanContainer) kanbanContainer.classList.remove('d-none');
                if (tableContainer) tableContainer.classList.add('d-none');
                if (stageFilterGroup) stageFilterGroup.classList.add('d-none');
                if (btnKanban) {
                    btnKanban.classList.add('active');
                    btnKanban.classList.remove('btn-outline-success');
                    btnKanban.classList.add('btn-success', 'text-white');
                }
                if (btnTable) {
                    btnTable.classList.remove('active', 'btn-secondary', 'text-white');
                    btnTable.classList.add('btn-outline-secondary');
                }
                applyKanbanFilters();
            } else {
                if (kanbanContainer) kanbanContainer.classList.add('d-none');
                if (tableContainer) tableContainer.classList.remove('d-none');
                if (stageFilterGroup) stageFilterGroup.classList.remove('d-none');
                if (btnTable) {
                    btnTable.classList.add('active', 'btn-secondary', 'text-white');
                    btnTable.classList.remove('btn-outline-secondary');
                }
                if (btnKanban) {
                    btnKanban.classList.remove('active', 'btn-success', 'text-white');
                    btnKanban.classList.add('btn-outline-success');
                }
                applyPipelineFilters(true, false);
            }
        }

        // --- Chế độ xem thẻ Kanban: Thu gọn (Compact) vs Chi tiết (Detailed) ---
        function setKanbanCardDetailMode(mode) {
            const container = document.getElementById('candidateKanbanViewContainer');
            const btnCompact = document.getElementById('btnKanbanModeCompact');
            const btnDetailed = document.getElementById('btnKanbanModeDetailed');
            if (!container) return;

            if (mode === 'detailed') {
                container.classList.remove('kanban-mode-compact');
                container.classList.add('kanban-mode-detailed');
                if (btnDetailed) {
                    btnDetailed.classList.add('active', 'btn-secondary', 'text-white');
                    btnDetailed.classList.remove('btn-outline-secondary');
                }
                if (btnCompact) {
                    btnCompact.classList.remove('active', 'btn-secondary', 'text-white');
                    btnCompact.classList.add('btn-outline-secondary');
                }
            } else { // 'compact' mặc định
                container.classList.remove('kanban-mode-detailed');
                container.classList.add('kanban-mode-compact');
                if (btnCompact) {
                    btnCompact.classList.add('active', 'btn-secondary', 'text-white');
                    btnCompact.classList.remove('btn-outline-secondary');
                }
                if (btnDetailed) {
                    btnDetailed.classList.remove('active', 'btn-secondary', 'text-white');
                    btnDetailed.classList.add('btn-outline-secondary');
                }
            }
            try { localStorage.setItem('ats_kanban_card_mode', mode); } catch (_) {}
        }

        // Trạng thái đếm số lượng hồ sơ & cột phóng to tối đa
        window.kanbanStageCounts = { 1: 0, 2: 0, 3: 0, 5: 0, 6: 0, 7: 0 };
        window.maximizedKanbanStage = null;

        // Cập nhật phân bổ độ rộng các cột: Khi có cột Thu gọn thì các cột khác PHẢI PHÌNH (MỞ RỘNG TO RA)
        function updateKanbanColumnWidths() {
            const allStages = [1, 2, 3, 5, 6, 7];
            const cols = allStages.map(order => ({
                order: order,
                element: document.getElementById('kanbanCol-' + order),
                count: window.kanbanStageCounts ? (window.kanbanStageCounts[order] || 0) : 0
            })).filter(c => c.element !== null);

            const collapsedCols = cols.filter(c => c.element.classList.contains('kanban-column-collapsed'));
            const openCols = cols.filter(c => !c.element.classList.contains('kanban-column-collapsed'));

            // Cập nhật icon trên các nút Maximize
            cols.forEach(c => {
                const btn = document.getElementById('btnMaxCol-' + c.order);
                if (btn) {
                    if (window.maximizedKanbanStage === c.order) {
                        btn.innerHTML = '<i class="bi bi-arrows-angle-contract"></i>';
                        btn.classList.add('active');
                        btn.title = 'Thu nhỏ cột về độ rộng bình thường';
                    } else {
                        btn.innerHTML = '<i class="bi bi-arrows-angle-expand"></i>';
                        btn.classList.remove('active');
                        btn.title = 'Phóng to / Mở rộng tối đa cột này';
                    }
                }
            });

            // Nếu người dùng chủ động maximize 1 cột
            if (window.maximizedKanbanStage) {
                const targetCol = cols.find(c => c.order === window.maximizedKanbanStage);
                if (targetCol && !targetCol.element.classList.contains('kanban-column-collapsed')) {
                    openCols.forEach(c => {
                        if (c.order === window.maximizedKanbanStage) {
                            c.element.style.flex = '2.8 1 0%';
                            c.element.classList.add('kanban-column-maximized');
                        } else {
                            c.element.style.flex = '1 1 0%';
                            c.element.classList.remove('kanban-column-maximized');
                        }
                    });
                    return;
                }
            }

            // Xóa class maximized
            cols.forEach(c => c.element.classList.remove('kanban-column-maximized'));

            // Nếu KHÔNG có cột nào bị thu gọn: tất cả các cột mở đều có độ rộng đều nhau
            if (collapsedCols.length === 0) {
                openCols.forEach(c => {
                    c.element.style.flex = '1 1 0%';
                });
                return;
            }

            // KHI CÓ CỘT THU GỌN: CÁC CỘT CÒN LẠI PHẢI PHÌNH TO (MỞ RỘNG RA) RÕ RỆT
            // Cột có nhiều hồ sơ nhất nhận trọng số flex 2.2, cột có hồ sơ nhận flex 1.6, cột 0 hồ sơ nhận flex 1.1
            const sortedCounts = openCols.map(c => c.count).sort((a, b) => b - a);
            const highestCount = sortedCounts.length > 0 ? sortedCounts[0] : 0;

            openCols.forEach(c => {
                if (c.count === highestCount && highestCount > 0) {
                    // Cột có nhiều hồ sơ nhất PHÌNH TO GẤP ĐÔI!
                    c.element.style.flex = '2.2 1 0%';
                } else if (c.count > 0) {
                    // Cột có hồ sơ phình to vừa
                    c.element.style.flex = '1.6 1 0%';
                } else {
                    // Cột mở nhưng chưa có hồ sơ
                    c.element.style.flex = '1.1 1 0%';
                }
            });
        }

        // Bật / Tắt phóng to tối đa 1 cột
        function toggleKanbanColumnMaximize(stageOrder, event) {
            if (event) {
                event.stopPropagation();
                event.preventDefault();
            }
            if (window.maximizedKanbanStage === stageOrder) {
                window.maximizedKanbanStage = null;
            } else {
                const col = document.getElementById('kanbanCol-' + stageOrder);
                if (col && col.classList.contains('kanban-column-collapsed')) {
                    toggleKanbanColumnCollapse(stageOrder, event);
                }
                window.maximizedKanbanStage = stageOrder;
            }
            updateKanbanColumnWidths();
        }

        // --- BỘ LỌC CỘT KANBAN (Gộp thành 1 Dropdown duy nhất & Hiển thị tên cột đang chọn) ---
        function selectKanbanStageFilter(stageKey, stageLabel, event) {
            if (event) {
                event.stopPropagation();
                event.preventDefault();
            }
            window.currentPipelineStage = stageKey || 'ALL';

            const btn = document.getElementById('btnKanbanStageFilter');
            const label = document.getElementById('kanbanStageFilterLabel');
            const badge = document.getElementById('kanbanStageFilterBadge');
            const icon = document.getElementById('kanbanStageFilterIcon');
            const menuItems = document.querySelectorAll('.kanban-stage-menu-item');

            // Cập nhật trạng thái active trong menu
            menuItems.forEach(item => {
                const oc = item.getAttribute('onclick') || '';
                if (oc.includes(`'${stageKey}'`)) {
                    item.classList.add('active');
                } else {
                    item.classList.remove('active');
                }
            });

            // Màu sắc đại diện cho từng cột
            const stageStyleMap = {
                'ALL': { color: '#475569', bg: '#FFFFFF', border: '#CBD5E1', icon: 'bi-funnel text-muted', name: 'Tất cả cột' },
                '1': { color: '#1D4ED8', bg: '#EFF6FF', border: '#93C5FD', icon: 'bi-funnel-fill text-primary', name: 'Hồ sơ mới' },
                '2': { color: '#0369A1', bg: '#F0F9FF', border: '#7DD3FC', icon: 'bi-funnel-fill text-info', name: 'Sàng lọc' },
                '3': { color: '#6D28D9', bg: '#F5F3FF', border: '#C4B5FD', icon: 'bi-funnel-fill text-purple', name: 'Phỏng vấn' },
                '5': { color: '#B45309', bg: '#FFFBEB', border: '#FCD34D', icon: 'bi-funnel-fill text-warning', name: 'Offer' },
                '6': { color: '#047857', bg: '#ECFDF5', border: '#6EE7B7', icon: 'bi-funnel-fill text-success', name: 'Nhận việc' },
                '7': { color: '#BE123C', bg: '#FFF1F2', border: '#FDA4AF', icon: 'bi-funnel-fill text-danger', name: 'Loại' }
            };
            const style = stageStyleMap[stageKey] || stageStyleMap['ALL'];
            const displayName = stageLabel || style.name;

            // Đếm số lượng của cột đang chọn
            let currentCount = 0;
            if (stageKey === 'ALL') {
                currentCount = window.kanbanStageCounts ? Object.values(window.kanbanStageCounts).reduce((a, b) => a + b, 0) : 0;
            } else {
                currentCount = (window.kanbanStageCounts && window.kanbanStageCounts[parseInt(stageKey, 10)]) || 0;
            }

            // Cập nhật giao diện nút Dropdown: HIỂN THỊ TÊN CỘT ĐỂ NGƯỜI DÙNG BIẾT ĐÃ CHỌN LỌC
            if (stageKey === 'ALL') {
                if (label) label.textContent = 'Tất cả cột';
                if (btn) {
                    btn.style.background = '#FFFFFF';
                    btn.style.borderColor = '#CBD5E1';
                    btn.style.color = '#475569';
                }
                if (icon) icon.className = 'bi bi-funnel text-muted';
                if (badge) {
                    badge.className = 'badge bg-light text-dark border ms-1';
                    badge.style.background = '';
                    badge.style.color = '';
                    badge.style.borderColor = '';
                    badge.textContent = currentCount;
                }
            } else {
                if (label) label.innerHTML = `Cột: <b>${displayName}</b>`;
                if (btn) {
                    btn.style.background = style.bg;
                    btn.style.borderColor = style.border;
                    btn.style.color = style.color;
                }
                if (icon) icon.className = style.icon;
                if (badge) {
                    badge.className = 'badge border ms-1';
                    badge.style.background = '#FFFFFF';
                    badge.style.color = style.color;
                    badge.style.borderColor = style.border;
                    badge.textContent = currentCount;
                }
            }

            // 1. Điều khiển Bảng Kanban
            const allStages = [1, 2, 3, 5, 6, 7];
            if (stageKey === 'ALL') {
                // Khôi phục tất cả cột mở đều nhau
                window.maximizedKanbanStage = null;
                allStages.forEach(order => {
                    const col = document.getElementById('kanbanCol-' + order);
                    if (col) {
                        col.classList.remove('kanban-column-collapsed');
                        col.classList.remove('kanban-column-maximized');
                        col.style.display = '';
                    }
                });
                try { localStorage.removeItem('ats_kanban_collapsed_stages'); } catch (_) {}
                updateKanbanColumnWidths();
            } else {
                const selectedOrder = parseInt(stageKey, 10);
                if (allStages.includes(selectedOrder)) {
                    // Tập trung vào cột được chọn: Phóng to tối đa (Maximize) và thu gọn các cột khác
                    window.maximizedKanbanStage = selectedOrder;
                    allStages.forEach(order => {
                        const col = document.getElementById('kanbanCol-' + order);
                        if (col) {
                            if (order === selectedOrder) {
                                col.classList.remove('kanban-column-collapsed');
                            } else {
                                col.classList.add('kanban-column-collapsed');
                            }
                        }
                    });
                    updateKanbanColumnWidths();
                    scrollToKanbanColumn(selectedOrder);
                }
            }

            // 2. Điều khiển Bảng Table View (nếu đang ở Table)
            applyPipelineFilters(true, true);

            // Đóng menu Dropdown nếu đang mở
            try {
                const dropdownBtn = document.getElementById('btnKanbanStageFilter');
                if (dropdownBtn && window.bootstrap && window.bootstrap.Dropdown) {
                    const inst = window.bootstrap.Dropdown.getInstance(dropdownBtn);
                    if (inst) inst.hide();
                }
            } catch (_) {}
        }

        // --- Tính năng Thu gọn / Mở rộng Cột (Column Collapse/Expand) ---
        function toggleKanbanColumnCollapse(stageOrder, event) {
            if (event) {
                event.stopPropagation();
                event.preventDefault();
            }
            const col = document.getElementById('kanbanCol-' + stageOrder);
            if (!col) return;

            const isCollapsed = col.classList.toggle('kanban-column-collapsed');

            if (isCollapsed && window.maximizedKanbanStage === stageOrder) {
                window.maximizedKanbanStage = null;
            }

            try {
                let list = JSON.parse(localStorage.getItem('ats_kanban_collapsed_stages') || '[]');
                if (!Array.isArray(list)) list = [];
                if (isCollapsed) {
                    if (!list.includes(stageOrder)) list.push(stageOrder);
                } else {
                    list = list.filter(x => x !== stageOrder);
                }
                localStorage.setItem('ats_kanban_collapsed_stages', JSON.stringify(list));
            } catch (_) {}

            updateKanbanColumnWidths();
        }

        function handleKanbanColumnClick(stageOrder, event) {
            const col = document.getElementById('kanbanCol-' + stageOrder);
            if (col && col.classList.contains('kanban-column-collapsed')) {
                toggleKanbanColumnCollapse(stageOrder, event);
            }
        }

        function restoreKanbanPreferences() {
            // Khôi phục chế độ xem thẻ (Mặc định compact)
            const savedCardMode = localStorage.getItem('ats_kanban_card_mode') || 'compact';
            setKanbanCardDetailMode(savedCardMode);

            // Khôi phục các cột đã thu gọn
            try {
                const list = JSON.parse(localStorage.getItem('ats_kanban_collapsed_stages') || '[]');
                if (Array.isArray(list)) {
                    list.forEach(stageOrder => {
                        const col = document.getElementById('kanbanCol-' + stageOrder);
                        if (col) col.classList.add('kanban-column-collapsed');
                    });
                }
            } catch (_) {}

            updateKanbanColumnWidths();
        }

        // --- Hỗ trợ di động: Vuốt qua lại giữa các cột & Dots Indicator ---
        function scrollToKanbanColumn(stageOrder) {
            const col = document.getElementById('kanbanCol-' + stageOrder);
            if (col) {
                col.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
                updateMobileKanbanDots(stageOrder);
            }
        }

        function updateMobileKanbanDots(stageOrder) {
            const stageOrderList = [1, 2, 3, 5, 6, 7];
            const idx = stageOrderList.indexOf(stageOrder);
            const dots = document.querySelectorAll('.kanban-mobile-dot');
            if (dots && dots.length > 0 && idx !== -1) {
                dots.forEach((dot, i) => {
                    if (i === idx) dot.classList.add('active');
                    else dot.classList.remove('active');
                });
            }
        }

        function initMobileKanbanSwipeObserver() {
            const wrapper = document.getElementById('candidateKanbanViewContainer');
            if (!wrapper) return;

            let ticking = false;
            wrapper.addEventListener('scroll', () => {
                if (!ticking) {
                    window.requestAnimationFrame(() => {
                        if (window.innerWidth <= 768) {
                            const stageOrderList = [1, 2, 3, 5, 6, 7];
                            const wrapperCenter = wrapper.scrollLeft + wrapper.clientWidth / 2;
                            let closestStage = 1;
                            let minDistance = Infinity;

                            stageOrderList.forEach(order => {
                                const col = document.getElementById('kanbanCol-' + order);
                                if (col) {
                                    const colCenter = col.offsetLeft + col.clientWidth / 2;
                                    const dist = Math.abs(colCenter - wrapperCenter);
                                    if (dist < minDistance) {
                                        minDistance = dist;
                                        closestStage = order;
                                    }
                                }
                            });
                            updateMobileKanbanDots(closestStage);
                        }
                        ticking = false;
                    });
                    ticking = true;
                }
            }, { passive: true });
        }

        function onPipelineJobFilterChanged(jobId) {
            window.currentPipelineJob = jobId || 'ALL';
            applyKanbanFilters();
            applyPipelineFilters(true, true);
        }

        // SCRUM-327: Lọc Hồ sơ Quá hạn SLA
        window.filterSlaOverdueOnly = false;

        function toggleKanbanSlaOverdueFilter(e) {
            if (e) e.stopPropagation();
            window.filterSlaOverdueOnly = !window.filterSlaOverdueOnly;
            const btn = document.getElementById('btnFilterSlaOverdue');
            if (btn) {
                if (window.filterSlaOverdueOnly) {
                    btn.classList.remove('btn-outline-danger');
                    btn.classList.add('btn-danger', 'text-white', 'active');
                } else {
                    btn.classList.remove('btn-danger', 'text-white', 'active');
                    btn.classList.add('btn-outline-danger');
                }
            }
            applyKanbanFilters();
            applyPipelineFilters(true, true);
        }

        function applyKanbanFilters() {
            const selectedJob = window.currentPipelineJob || 'ALL';
            const searchInput = document.getElementById('candidateSearchInput');
            const query = (searchInput ? searchInput.value : '').trim().toLowerCase();

            const cards = Array.from(document.querySelectorAll('.kanban-candidate-card'));

            const counts = {
                1: 0, // Hồ sơ mới
                2: 0, // Sàng lọc
                3: 0, // Phỏng vấn (3 & 4)
                5: 0, // Đề xuất offer
                6: 0, // Nhận việc
                7: 0  // Loại
            };

            cards.forEach(card => {
                const cardJobId = card.getAttribute('data-job-id') || '';
                const cardStageOrder = parseInt(card.getAttribute('data-stage-order') || '1', 10);
                const cardStatus = card.getAttribute('data-status') || '';
                const name = card.getAttribute('data-name') || '';
                const email = card.getAttribute('data-email') || '';
                const job = card.getAttribute('data-job') || '';
                const isOverdue = card.getAttribute('data-is-overdue') === 'true';

                // Job match
                const jobMatch = (selectedJob === 'ALL' || cardJobId.toLowerCase() === selectedJob.toLowerCase());

                // SLA Overdue match
                const slaMatch = !window.filterSlaOverdueOnly || isOverdue;

                // Search match (từ 3 ký tự trở lên)
                const combined = `${name} ${email} ${job}`;
                const textMatch = !query || query.length < 3 || combined.includes(query);

                if (jobMatch && textMatch && slaMatch) {
                    card.style.display = '';
                    if (cardStatus === 'REJECTED' || cardStageOrder === 7) {
                        counts[7]++;
                    } else if (cardStageOrder === 1) {
                        counts[1]++;
                    } else if (cardStageOrder === 2) {
                        counts[2]++;
                    } else if (cardStageOrder === 3 || cardStageOrder === 4) {
                        counts[3]++;
                    } else if (cardStageOrder === 5) {
                        counts[5]++;
                    } else if (cardStageOrder === 6) {
                        counts[6]++;
                    }
                } else {
                    card.style.display = 'none';
                }
            });

            // Update column header badges (cả trạng thái mở rộng và thu gọn)
            const stageBadgeMap = {
                1: ['kanbanCountNew', 'kanbanCountNewCollapsed'],
                2: ['kanbanCountScreen', 'kanbanCountScreenCollapsed'],
                3: ['kanbanCountInterview', 'kanbanCountInterviewCollapsed'],
                5: ['kanbanCountOffer', 'kanbanCountOfferCollapsed'],
                6: ['kanbanCountHired', 'kanbanCountHiredCollapsed'],
                7: ['kanbanCountRejected', 'kanbanCountRejectedCollapsed']
            };
            Object.keys(stageBadgeMap).forEach(order => {
                stageBadgeMap[order].forEach(id => {
                    const el = document.getElementById(id);
                    if (el) el.textContent = counts[order];
                });
            });

            // Lưu đếm số lượng và cập nhật phình to các cột mở rộng
            window.kanbanStageCounts = counts;
            updateKanbanColumnWidths();

            // Đồng bộ số lượng hồ sơ vào Dropdown Menu bộ lọc cột
            const totalAll = Object.values(counts).reduce((a, b) => a + b, 0);
            const elAll = document.getElementById('stageMenuCount-ALL');
            if (elAll) elAll.textContent = totalAll;
            [1, 2, 3, 5, 6, 7].forEach(order => {
                const el = document.getElementById('stageMenuCount-' + order);
                if (el) el.textContent = counts[order] || 0;
            });

            // Cập nhật badge trên nút Dropdown chính
            const curStage = window.currentPipelineStage || 'ALL';
            const curBadge = document.getElementById('kanbanStageFilterBadge');
            if (curBadge) {
                if (curStage === 'ALL') {
                    curBadge.textContent = totalAll;
                } else {
                    curBadge.textContent = counts[parseInt(curStage, 10)] || 0;
                }
            }

            // Update empty placeholders
            [1, 2, 3, 5, 6, 7].forEach(order => {
                const zone = document.getElementById('kanbanDropZone-' + order);
                if (zone) {
                    const placeholder = zone.querySelector('.kanban-empty-placeholder');
                    if (placeholder) {
                        if (counts[order] === 0) {
                            placeholder.classList.remove('d-none');
                        } else {
                            placeholder.classList.add('d-none');
                        }
                    }
                }
            });
        }

        // --- Drag and Drop Handlers ---
        function onKanbanCardDragStart(e) {
            draggedCardElement = e.currentTarget;
            draggedApplicationId = draggedCardElement.getAttribute('data-application-id');
            originalStageOrder = parseInt(draggedCardElement.getAttribute('data-stage-order') || '1', 10);
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', draggedApplicationId);
            setTimeout(() => {
                if (draggedCardElement) draggedCardElement.classList.add('card-dragging');
            }, 0);
        }

        function onKanbanCardDragEnd(e) {
            if (draggedCardElement) {
                draggedCardElement.classList.remove('card-dragging');
            }
            document.querySelectorAll('.kanban-cards-container').forEach(zone => {
                zone.classList.remove('kanban-drop-zone-active');
            });
            draggedCardElement = null;
            draggedApplicationId = null;
        }

        function onKanbanContainerDragOver(e) {
            e.preventDefault();
            e.dataTransfer.dropEffect = 'move';
            const zone = e.currentTarget;
            if (!zone.classList.contains('kanban-drop-zone-active')) {
                zone.classList.add('kanban-drop-zone-active');
            }
        }

        function onKanbanContainerDragLeave(e) {
            const zone = e.currentTarget;
            if (!zone.contains(e.relatedTarget)) {
                zone.classList.remove('kanban-drop-zone-active');
            }
        }

        async function onKanbanContainerDrop(e, targetStageOrder) {
            e.preventDefault();
            const zone = e.currentTarget;
            zone.classList.remove('kanban-drop-zone-active');

            if (!draggedCardElement || !draggedApplicationId) return;

            const card = draggedCardElement;
            const currentStageOrder = parseInt(card.getAttribute('data-stage-order') || '1', 10);
            const currentStatus = card.getAttribute('data-status') || '';

            // If dropped into the same stage
            if ((targetStageOrder === 3 && (currentStageOrder === 3 || currentStageOrder === 4) && currentStatus !== 'REJECTED') ||
                (targetStageOrder === currentStageOrder && (targetStageOrder !== 7 || currentStatus === 'REJECTED'))) {
                return;
            }

            const candidateName = card.getAttribute('data-candidate-name') || 'Ứng viên';
            const originalParent = card.parentElement;

            // Optimistic move
            zone.appendChild(card);
            card.setAttribute('data-stage-order', targetStageOrder);
            if (targetStageOrder === 7) {
                card.setAttribute('data-status', 'REJECTED');
            } else if (targetStageOrder === 6) {
                card.setAttribute('data-status', 'HIRED');
            } else {
                card.setAttribute('data-status', 'IN_PROCESS');
            }
            applyKanbanFilters();

            // Call API
            const formData = new FormData();
            formData.append('applicationId', draggedApplicationId);
            formData.append('toStageOrder', targetStageOrder);
            formData.append('__RequestVerificationToken', getCsrfToken());

            try {
                const res = await fetch('/Workspace/AdvanceStage', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message, true);
                    const tableRow = document.getElementById('cand-row-' + draggedApplicationId);
                    if (tableRow) {
                        tableRow.setAttribute('data-stage-order', targetStageOrder);
                        if (data.status) tableRow.setAttribute('data-status', data.status);
                    }
                } else {
                    // Revert
                    originalParent.appendChild(card);
                    card.setAttribute('data-stage-order', originalStageOrder);
                    applyKanbanFilters();
                    showToast(data.message || 'Lỗi khi chuyển giai đoạn', false);
                }
            } catch (err) {
                originalParent.appendChild(card);
                card.setAttribute('data-stage-order', originalStageOrder);
                applyKanbanFilters();
                showToast('Lỗi kết nối máy chủ: ' + err.message, false);
            }
        }

        async function moveCandidateStageViaButton(applicationId, targetStageOrder, candidateName, stageName) {
            if (!confirm(`Xác nhận chuyển ứng viên ${candidateName} sang giai đoạn "${stageName}"?`)) return;

            const card = document.getElementById('kanban-card-' + applicationId);
            const targetZone = document.getElementById('kanbanDropZone-' + targetStageOrder);

            const formData = new FormData();
            formData.append('applicationId', applicationId);
            formData.append('toStageOrder', targetStageOrder);
            formData.append('__RequestVerificationToken', getCsrfToken());

            try {
                const res = await fetch('/Workspace/AdvanceStage', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message, true);
                    if (card && targetZone) {
                        targetZone.appendChild(card);
                        card.setAttribute('data-stage-order', targetStageOrder);
                        if (targetStageOrder === 7) card.setAttribute('data-status', 'REJECTED');
                        else if (targetStageOrder === 6) card.setAttribute('data-status', 'HIRED');
                        else card.setAttribute('data-status', 'IN_PROCESS');
                        applyKanbanFilters();
