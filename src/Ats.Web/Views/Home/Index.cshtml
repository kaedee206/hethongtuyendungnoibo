        // 8.5. Dừng tuyển & Từ chối hồ sơ ứng viên (Kết nối Danh Mục Chuẩn Hóa)
        var cachedRejectionReasons = null;
        async function loadRejectionReasons() {
            var sel = document.getElementById('rejectReason');
            if (!sel) return;
            if (cachedRejectionReasons && cachedRejectionReasons.length > 0) {
                renderRejectionReasonOptions(cachedRejectionReasons);
                return;
            }

            try {
                var res = await fetch('/recruitment-catalogs/api/by-type?type=REJECTION_REASON');
                if (res.ok) {
                    var items = await res.json();
                    if (Array.isArray(items) && items.length > 0) {
                        cachedRejectionReasons = items;
                        renderRejectionReasonOptions(items);
                        return;
                    }
                }
            } catch (err) {
                console.warn('Không thể nạp danh mục lý do từ chối từ API:', err);
            }

            // Fallback danh mục mặc định nếu API gặp sự cố
            sel.innerHTML = `
                <option value="Chuyên môn chưa phù hợp">Chuyên môn chưa phù hợp</option>
                <option value="Kinh nghiệm chưa tương xứng với yêu cầu vị trí">Kinh nghiệm chưa tương xứng với yêu cầu vị trí</option>
                <option value="Kỳ vọng lương vượt khung">Kỳ vọng lương vượt khung</option>
                <option value="Ứng viên từ chối Offer">Ứng viên từ chối Offer</option>
                <option value="Chưa tương thích văn hóa đội ngũ">Chưa tương thích văn hóa đội ngũ</option>
                <option value="Ứng viên không phản hồi">Ứng viên không phản hồi</option>
            `;
        }

        function renderRejectionReasonOptions(items) {
            var sel = document.getElementById('rejectReason');
            if (!sel) return;
            sel.innerHTML = items.map(function(item) {
                return '<option value="' + (item.name || '').replace(/"/g, '&quot;') + '" data-id="' + item.id + '">' + 
                       (item.name || '') + (item.description ? ' (' + item.description + ')' : '') + '</option>';
            }).join('');
        }

        function toggleRejectTalentPoolFields() {
            var chk = document.getElementById('rejectAddToTalentPool');
            var container = document.getElementById('rejectTalentPoolExtraFields');
            if (!chk || !container) return;
            if (chk.checked) {
                container.classList.remove('d-none');
            } else {
                container.classList.add('d-none');
            }
        }

        function openRejectModal(applicationId, candidateName, jobTitle) {
            if (window.CandidateStageManager && typeof window.CandidateStageManager.openRejectModal === 'function') {
                CandidateStageManager.openRejectModal(applicationId, candidateName, jobTitle);
                return;
            }

            document.getElementById('rejectApplicationId').value = applicationId;
            document.getElementById('rejectCandidateName').textContent = candidateName || 'Ứng viên';
            document.getElementById('rejectJobTitle').textContent = jobTitle || 'Vị trí';
            document.getElementById('rejectFeedbackNote').value = '';

            // Reset talent pool inputs
            var poolChk = document.getElementById('rejectAddToTalentPool');
            if (poolChk) {
                poolChk.checked = false;
                toggleRejectTalentPoolFields();
            }
            var targetTitleInput = document.getElementById('rejectTalentPoolTargetTitle');
            if (targetTitleInput) targetTitleInput.value = jobTitle || '';
            var poolReasonInput = document.getElementById('rejectTalentPoolReason');
            if (poolReasonInput) poolReasonInput.value = '';
            var poolSkillsInput = document.getElementById('rejectTalentPoolSkills');
            if (poolSkillsInput) poolSkillsInput.value = '';

            loadRejectionReasons();

            var modal = new bootstrap.Modal(document.getElementById('rejectCandidateModal'));
            modal.show();
        }

        async function handleRejectCandidateSubmit(e) {
            e.preventDefault();
            var btn = document.getElementById('btnSubmitReject');
            var spinner = document.getElementById('spinnerReject');
            btn.disabled = true;
            spinner.classList.remove('d-none');

            var sel = document.getElementById('rejectReason');
            var selectedOpt = sel.options[sel.selectedIndex];
            var reasonId = selectedOpt ? selectedOpt.getAttribute('data-id') : null;
            var reasonText = sel.value;
            var feedback = document.getElementById('rejectFeedbackNote').value;

            var poolChk = document.getElementById('rejectAddToTalentPool');
            var addToTalentPool = poolChk && poolChk.checked;

            if (addToTalentPool) {
                var poolReason = document.getElementById('rejectTalentPoolReason').value.trim();
                if (!poolReason) {
                    showToast('Vui lòng nhập lý do đưa vào Kho tiềm năng (bắt buộc theo Scrum 45).', false);
                    btn.disabled = false;
                    spinner.classList.add('d-none');
                    document.getElementById('rejectTalentPoolReason').focus();
                    return;
                }
            }

            var formData = new FormData();
            formData.append('applicationId', document.getElementById('rejectApplicationId').value);
            if (reasonId) {
                formData.append('rejectionReasonId', reasonId);
            }
            formData.append('reason', reasonText);
            formData.append('feedbackNote', feedback);
            formData.append('sendEmail', 'true');

            // Scrum 45 fields
            if (addToTalentPool) {
                formData.append('addToTalentPool', 'true');
                formData.append('talentPoolReason', document.getElementById('rejectTalentPoolReason').value.trim());
                formData.append('targetJobTitle', document.getElementById('rejectTalentPoolTargetTitle').value.trim());
                formData.append('talentPoolRating', document.getElementById('rejectTalentPoolRating').value);
                formData.append('talentPoolSkills', document.getElementById('rejectTalentPoolSkills').value.trim());
            } else {
                formData.append('addToTalentPool', 'false');
            }

            try {
                var res = await fetch('/Workspace/RejectApplication', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': getCsrfToken()
                    },
                    body: formData
                });
                var data = await res.json();
                if (data.success) {
                    bootstrap.Modal.getInstance(document.getElementById('rejectCandidateModal')).hide();
                    showToast(data.message, true);
                    setTimeout(() => window.location.reload(), 1200);
                } else {
                    showToast(data.message || 'Lỗi khi từ chối hồ sơ', false);
                }
            } catch (err) {
                showToast('Lỗi kết nối: ' + err.message, false);
            } finally {
                btn.disabled = false;
                spinner.classList.add('d-none');
            }
        }

