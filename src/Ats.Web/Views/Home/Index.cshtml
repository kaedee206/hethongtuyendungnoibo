        // 8.1. Lọc và tìm kiếm bảng ứng viên trực tiếp kèm Phân trang (Candidate Pipeline Board with Pagination & URL Sync)
        window.currentPipelineStage = 'ALL';
        window.candCurrentPage = 1;
        window.candPageSize = 10;

        function applyPipelineFilters(shouldSyncUrl = true, resetPage = false) {
            if (resetPage) {
                window.candCurrentPage = 1;
            }
            const input = document.getElementById('candidateSearchInput');
            const clearBtn = document.getElementById('candidateSearchClearBtn');
            const hint = document.getElementById('candSearchHint');
            const query = (input ? input.value : '').trim();
            const stageOrder = window.currentPipelineStage || 'ALL';

            if (clearBtn) {
                if (query.length > 0) clearBtn.classList.remove('d-none');
                else clearBtn.classList.add('d-none');
            }

            if (hint) {
                if (query.length > 0 && query.length < 3) hint.classList.remove('d-none');
                else hint.classList.add('d-none');
            }

            const rows = Array.from(document.querySelectorAll('.pipeline-candidate-row'));
            const matchedRows = [];

            rows.forEach(r => {
                const rowStage = r.getAttribute('data-stage-order') || '';
                const rowStatus = r.getAttribute('data-status') || '';
                const name = r.getAttribute('data-name') || '';
                const email = r.getAttribute('data-email') || '';
                const job = r.getAttribute('data-job') || '';

                // Stage match
                let stageMatch = false;
                if (stageOrder === 'ALL') {
                    stageMatch = true;
                } else if (stageOrder === 'REJECTED') {
                    stageMatch = (rowStatus === 'REJECTED');
                } else {
                    stageMatch = (rowStage === stageOrder && rowStatus !== 'REJECTED');
                }

                // Text search match: Chỉ lọc khi từ khóa có từ 3 ký tự trở lên (>= 3 chars)
                const combinedText = `${name} ${email} ${job}`;
                const textMatch = !query || query.length < 3 || (window.NoveraInstantSearch
                    ? window.NoveraInstantSearch.matchSearchTokens(combinedText, query)
                    : combinedText.toLowerCase().includes(query.toLowerCase()));

                if (stageMatch && textMatch) {
                    matchedRows.push(r);
                }
            });

            // Pagination calculation
            const totalRecords = matchedRows.length;
            const pageSize = window.candPageSize || 10;
            const totalPages = Math.max(1, Math.ceil(totalRecords / pageSize));
            if (window.candCurrentPage > totalPages) window.candCurrentPage = totalPages;
            if (window.candCurrentPage < 1) window.candCurrentPage = 1;

            const startIndex = (window.candCurrentPage - 1) * pageSize;
            const endIndex = Math.min(startIndex + pageSize, totalRecords);

            // Display / hide rows based on page slice
            rows.forEach(r => {
                const matchedIndex = matchedRows.indexOf(r);
                if (matchedIndex >= startIndex && matchedIndex < endIndex) {
                    r.style.display = '';
                } else {
                    r.style.display = 'none';
                }
            });

            // Empty state row in table
            const tbody = document.getElementById('candidatePipelineTableBody');
            let noResultsRow = document.getElementById('pipelineNoResultsRow');
            if (totalRecords === 0) {
                if (!noResultsRow && tbody) {
                    noResultsRow = document.createElement('tr');
                    noResultsRow.id = 'pipelineNoResultsRow';
                    noResultsRow.innerHTML = '<td colspan="5" class="text-center py-4 text-muted"><i class="bi bi-search me-1"></i> Không tìm thấy ứng viên nào phù hợp với bộ lọc hiện tại.</td>';
                    tbody.appendChild(noResultsRow);
                }
            } else if (noResultsRow) {
                noResultsRow.remove();
            }

            // Update pagination UI stats
            const pageStartEl = document.getElementById('candPageStart');
            const pageEndEl = document.getElementById('candPageEnd');
            const totalRecordsEl = document.getElementById('candTotalRecords');
            const paginationContainer = document.getElementById('candidatePaginationContainer');

            if (pageStartEl) pageStartEl.innerText = totalRecords > 0 ? (startIndex + 1) : 0;
            if (pageEndEl) pageEndEl.innerText = endIndex;
            if (totalRecordsEl) totalRecordsEl.innerText = totalRecords;
            if (paginationContainer) {
                paginationContainer.style.display = totalRecords > 0 ? 'flex' : 'none';
            }

            renderCandidatePagination(totalPages, window.candCurrentPage);

            // Sync URL query
            if (shouldSyncUrl && window.NoveraInstantSearch) {
                window.NoveraInstantSearch.syncUrlParams({
                    cand_search: query || null,
                    cand_stage: stageOrder !== 'ALL' ? stageOrder : null,
                    cand_page: window.candCurrentPage > 1 ? window.candCurrentPage : null
                });
            }
        }

        function renderCandidatePagination(totalPages, currentPage) {
            const ul = document.getElementById('candPaginationUl');
            if (!ul) return;
            ul.innerHTML = '';

            if (totalPages <= 1) return;

            // Previous Button
            const prevLi = document.createElement('li');
            prevLi.className = `page-item ${currentPage === 1 ? 'disabled' : ''}`;
            prevLi.innerHTML = `<button class="page-link text-dark" type="button" onclick="goToCandidatePage(${currentPage - 1})" style="border-radius: 6px; padding: 0.25rem 0.55rem; font-size: 0.8rem; border-color: #E2E8F0;" aria-label="Trang trước"><i class="bi bi-chevron-left"></i></button>`;
            ul.appendChild(prevLi);

            // Page numbers
            let startP = Math.max(1, currentPage - 2);
            let endP = Math.min(totalPages, currentPage + 2);
            if (startP > 1) {
                const li1 = document.createElement('li');
                li1.className = 'page-item';
                li1.innerHTML = `<button class="page-link text-dark" type="button" onclick="goToCandidatePage(1)" style="border-radius: 6px; padding: 0.25rem 0.6rem; font-size: 0.8rem; border-color: #E2E8F0;">1</button>`;
                ul.appendChild(li1);
                if (startP > 2) {
                    const dots = document.createElement('li');
                    dots.className = 'page-item disabled';
                    dots.innerHTML = `<span class="page-link text-muted" style="border-radius: 6px; padding: 0.25rem 0.4rem; font-size: 0.8rem; border-color: #E2E8F0;">...</span>`;
                    ul.appendChild(dots);
                }
            }

            for (let p = startP; p <= endP; p++) {
                const li = document.createElement('li');
                const isActive = (p === currentPage);
                li.className = `page-item ${isActive ? 'active' : ''}`;
                li.innerHTML = `<button class="page-link ${isActive ? 'text-white' : 'text-dark'}" type="button" onclick="goToCandidatePage(${p})" style="border-radius: 6px; padding: 0.25rem 0.6rem; font-size: 0.8rem; ${isActive ? 'background-color:#059669; border-color:#059669;' : 'border-color:#E2E8F0;'}">${p}</button>`;
                ul.appendChild(li);
            }

            if (endP < totalPages) {
                if (endP < totalPages - 1) {
                    const dots = document.createElement('li');
                    dots.className = 'page-item disabled';
                    dots.innerHTML = `<span class="page-link text-muted" style="border-radius: 6px; padding: 0.25rem 0.4rem; font-size: 0.8rem; border-color: #E2E8F0;">...</span>`;
                    ul.appendChild(dots);
                }
                const liLast = document.createElement('li');
                liLast.className = 'page-item';
                liLast.innerHTML = `<button class="page-link text-dark" type="button" onclick="goToCandidatePage(${totalPages})" style="border-radius: 6px; padding: 0.25rem 0.6rem; font-size: 0.8rem; border-color: #E2E8F0;">${totalPages}</button>`;
                ul.appendChild(liLast);
            }

            // Next Button
            const nextLi = document.createElement('li');
            nextLi.className = `page-item ${currentPage === totalPages ? 'disabled' : ''}`;
            nextLi.innerHTML = `<button class="page-link text-dark" type="button" onclick="goToCandidatePage(${currentPage + 1})" style="border-radius: 6px; padding: 0.25rem 0.55rem; font-size: 0.8rem; border-color: #E2E8F0;" aria-label="Trang sau"><i class="bi bi-chevron-right"></i></button>`;
            ul.appendChild(nextLi);
        }

        function goToCandidatePage(pageNumber) {
            window.candCurrentPage = pageNumber;
            applyPipelineFilters(true, false);
            const panel = document.getElementById('feature-section-staff-ung-vien');
            if (panel) {
                panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        }

        function changeCandidatePageSize(newSize) {
            window.candPageSize = parseInt(newSize, 10) || 10;
            window.candCurrentPage = 1;
            applyPipelineFilters(true, false);
        }

        function filterPipelineCandidates(stageOrder, btnElement) {
            window.currentPipelineStage = stageOrder || 'ALL';
            window.candCurrentPage = 1;
            const pills = document.querySelectorAll('#candidateStageFilterGroup .candidate-stage-pill');
            if (btnElement) {
                pills.forEach(b => b.classList.remove('active'));
                btnElement.classList.add('active');
            } else if (pills.length > 0) {
                pills.forEach(b => {
                    b.classList.remove('active');
                    const oc = b.getAttribute('onclick') || '';
                    if (stageOrder === 'ALL' && oc.includes("'ALL'")) {
                        b.classList.add('active');
                    } else if (stageOrder !== 'ALL' && oc.includes("'" + stageOrder + "'")) {
                        b.classList.add('active');
                    }
                });
            }
            applyPipelineFilters(true, true);
        }

        function searchPipelineCandidates(query) {
            applyPipelineFilters(true, true);
        }

        // Initialize candidate pipeline search events & URL hydration
        document.addEventListener('DOMContentLoaded', function () {
            const candInput = document.getElementById('candidateSearchInput');
            const candClearBtn = document.getElementById('candidateSearchClearBtn');

            if (candInput) {
                const debouncedSearch = window.NoveraInstantSearch
                    ? window.NoveraInstantSearch.debounce(() => applyPipelineFilters(true, true), 15)
                    : () => applyPipelineFilters(true, true);
                candInput.addEventListener('input', debouncedSearch);
                candInput.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') e.preventDefault();
                });
            }

            if (candClearBtn) {
                candClearBtn.addEventListener('click', function () {
                    if (candInput) {
                        candInput.value = '';
                        applyPipelineFilters(true, true);
                        candInput.focus();
                    }
                });
            }

            function hydrateCandidatePipelineFromUrl() {
                if (!window.NoveraInstantSearch) return;
                const params = window.NoveraInstantSearch.getUrlParams();
                if (candInput && params.cand_search !== undefined) {
                    candInput.value = params.cand_search;
                }
                if (params.cand_page !== undefined) {
                    window.candCurrentPage = parseInt(params.cand_page, 10) || 1;
                }
                if (params.cand_stage !== undefined) {
                    window.currentPipelineStage = params.cand_stage;
                    const stageButtons = document.querySelectorAll('#candidateStageFilterGroup .candidate-stage-pill');
                    stageButtons.forEach(btn => {
                        const onclickAttr = btn.getAttribute('onclick') || '';
                        if (onclickAttr.includes(`'${params.cand_stage}'`)) {
                            stageButtons.forEach(b => b.classList.remove('active'));
                            btn.classList.add('active');
                        }
                    });
                }
                applyPipelineFilters(false, false);
            }

            window.addEventListener('popstate', hydrateCandidatePipelineFromUrl);
            hydrateCandidatePipelineFromUrl();
        });

        // 8.2. Chuyển tiếp giai đoạn tuyển chọn nhanh (Advance Stage)
