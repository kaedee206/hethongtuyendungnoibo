            modal.show();
            var container = document.getElementById('candidateDetailContent');
            container.innerHTML = '<div class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Đang truy xuất hồ sơ và lịch sử...</div>';

            try {
                var res = await fetch('/Workspace/GetCandidateDetail?applicationId=' + encodeURIComponent(applicationId));
