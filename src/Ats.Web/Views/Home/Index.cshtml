                                            <th class="py-2.5 px-3 bg-light border-0 fw-semibold" style="width: 25%;">Vị trí ứng tuyển</th>
                                            <th class="py-2.5 px-3 bg-light border-0 fw-semibold" style="width: 20%;">Giai đoạn &amp; SLA</th>
                                            <th class="py-2.5 px-3 bg-light border-0 fw-semibold" style="width: 11%;">Ngày nộp</th>
                                            <th class="py-2.5 px-3 bg-light border-0 fw-semibold text-end" style="width: 12%; border-top-right-radius: 8px; border-bottom-right-radius: 8px;">Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody id="candidatePipelineTableBody">
                                        @if (Model.CandidatePipelineItems.Any())
                                        {
                                            @foreach (var cand in Model.CandidatePipelineItems)
                                            {
                                                <tr id="cand-row-@cand.ApplicationId" class="pipeline-candidate-row"
                                                    data-stage-order="@cand.CurrentStageOrder"
                                                    data-status="@cand.Status"
                                                    data-is-referral="@(cand.IsReferral ? "true" : "false")"
                                                    data-has-duplicate="@(cand.HasDuplicateWarning ? "true" : "false")"
                                                    data-job-id="@cand.JobPostingId"
                                                    data-job-code="@cand.JobCode"
                                                    data-name="@cand.CandidateName.ToLower()"
                                                    data-email="@cand.CandidateEmail.ToLower()"
                                                    data-job="@cand.JobTitle.ToLower()"
                                                    data-is-overdue="@(cand.IsOverdueSla ? "true" : "false")"
                                                    style="border-bottom: 1px solid #F1F5F9; transition: background .15s;"
                                                    onmouseover="this.style.background='#F8FAFC';" onmouseout="this.style.background='#FFFFFF';">
                                                    <td class="py-3 px-3">
                                                        <div class="d-flex align-items-center gap-2.5">
                                                            <div class="d-flex align-items-center justify-content-center fw-bold text-white rounded-circle flex-shrink-0"
                                                                 style="width: 36px; height: 36px; background: #0F172A; font-size: 0.85rem;">
                                                                @(string.IsNullOrEmpty(cand.CandidateName) ? "?" : cand.CandidateName.Substring(0, 1).ToUpper())
                                                            </div>
                                                            <div>
                                                                <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                                                    <span class="fw-bold text-dark" style="font-size: 0.9rem;">@cand.CandidateName</span>
                                                                    @if (cand.IsReferral)
                                                                    {
                                                                        <span class="badge" style="background:#FEF3C7; color:#92400E; border:1px solid #FCD34D; border-radius:6px; font-size:0.68rem; font-weight:600;" title="@(!string.IsNullOrWhiteSpace(cand.ReferralNote) ? $"Ghi chú: {cand.ReferralNote}" : "Hồ sơ được nhân sự nội bộ giới thiệu")">
                                                                            <i class="bi bi-person-heart me-1 text-warning"></i>Giới thiệu nội bộ@(string.IsNullOrWhiteSpace(cand.ReferrerName) ? "" : $" ({cand.ReferrerName})")
                                                                        </span>
                                                                    }
                                                                    @if (cand.HasDuplicateWarning)
                                                                    {
                                                                        <a href="/Workspace/CompareCandidates?primaryId=@cand.CandidateId@(cand.MatchedCandidateId.HasValue ? $"&secondaryId={cand.MatchedCandidateId}" : "")"
                                                                           class="badge text-decoration-none"
                                                                           style="background: #FEF3C7; color: #B45309; border: 1px solid #FCD34D; border-radius: 6px; font-size: 0.68rem; font-weight: 600;"
                                                                           title="@cand.DuplicateReason - Nhấn để so sánh và gộp hồ sơ">
                                                                            <i class="bi bi-exclamation-circle-fill me-1 text-warning"></i>Cảnh báo trùng
                                                                        </a>
                                                                    }
                                                                </div>
                                                                <div class="d-flex align-items-center gap-2" style="font-size: 0.75rem; color: #64748B;">
                                                                    <span style="font-family:'JetBrains Mono',monospace;">@cand.CandidateEmail</span>
                                                                    @if (!string.IsNullOrEmpty(cand.CandidatePhone))
                                                                    {
                                                                        <span>•</span>
                                                                        <span>@cand.CandidatePhone</span>
                                                                    }
                                                                    @if (!string.IsNullOrEmpty(cand.ResumeFilePath))
                                                                    {
                                                                        <a href="@cand.ResumeFilePath" target="_blank" class="candidate-cv-pill ms-1" title="Xem CV đính kèm">
                                                                            <i class="bi bi-file-earmark-pdf"></i> CV
                                                                        </a>
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="py-3 px-3">
                                                        <span class="fw-semibold text-dark">@cand.JobTitle</span>
                                                    </td>
                                                    <td class="py-3 px-3">
                                                        @if (cand.Status == "WITHDRAWN")
                                                        {
                                                            <span class="badge" style="background:#F1F5F9; color:#475569; border:1px solid #CBD5E1; border-radius:6px; font-size:0.75rem; font-weight:600;">
                                                                <i class="bi bi-person-x me-1"></i>Ứng viên rút
                                                            </span>
                                                        }
                                                        else if (cand.Status == "REJECTED")
                                                        {
                                                            <span class="badge" style="background:#FEE2E2; color:#DC2626; border:1px solid #FECACA; border-radius:6px; font-size:0.75rem; font-weight:600;">
                                                                <i class="bi bi-x-circle me-1"></i>Từ chối hồ sơ
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge" style="background:@(cand.StageColor)15; color:@cand.StageColor; border:1px solid @(cand.StageColor)40; border-radius:6px; font-size:0.75rem; font-weight:600;">
                                                                <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem; vertical-align: middle;"></i>@cand.CurrentStageName
                                                            </span>
                                                            @if (cand.IsOverdueSla)
                                                            {
                                                                <span class="badge ms-1" style="background:#FEF2F2; color:#DC2626; border:1px solid #FECACA; border-radius:6px; font-size:0.7rem; font-weight:700;" title="Quá hạn @cand.OverdueDays ngày (Ngưỡng quy định: @cand.SlaDays ngày)">
                                                                    <i class="bi bi-clock-history me-1"></i>+@cand.OverdueDays d
                                                                </span>
                                                            }
                                                        }
                                                    </td>
                                                    <td class="py-3 px-3 text-muted" style="font-size: 0.78rem; font-family:'JetBrains Mono',monospace;">
                                                        @cand.AppliedDateDisplay
