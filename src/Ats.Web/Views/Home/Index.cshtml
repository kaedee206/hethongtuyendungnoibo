                                        <i class="bi bi-grid-fill me-1"></i>Tất cả lịch (@Model.UpcomingInterviews.Count)
                                    </a>
                                    <a href="/dashboard/lich-phong-van?interviewScope=my" 
                                       class="btn @(Model.InterviewScope == "my" ? "btn-dark text-white fw-semibold" : "btn-outline-secondary") px-2.5 py-1" 
                                       style="border-radius: 0 8px 8px 0; font-size: 0.78rem;">
                                        <i class="bi bi-person-check-fill me-1"></i>Lịch của tôi (@Model.MyUpcomingInterviewsCount)
                                    </a>
