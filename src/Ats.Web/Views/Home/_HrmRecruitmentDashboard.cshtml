<section id="hrm-recruitment-dashboard" class="mb-4" data-api-url="/api/hrm/dashboard">
    <div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between gap-2 mb-3">
        <div>
            <h2 class="h5 fw-bold mb-1">Tổng quan hoạt động tuyển dụng</h2>
            <p class="text-muted small mb-0">Số liệu toàn tổ chức, theo giờ Việt Nam.</p>
        </div>
        <span id="hrm-dashboard-load-time" class="small text-muted" aria-live="polite"></span>
    </div>

    <div id="hrm-dashboard-error" class="alert alert-danger d-none" role="alert">
        <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2">
            <span>Không thể tải dữ liệu tổng quan. Vui lòng thử lại.</span>
            <button id="hrm-dashboard-retry" type="button" class="btn btn-sm btn-outline-danger">Thử lại</button>
        </div>
    </div>

    <div id="hrm-dashboard-content" aria-busy="true">
        <div class="row g-3 mb-4">
            <div class="col-6 col-xl-3">
                <a href="/Jobs/Manage?status=PUBLISHED" class="hrm-kpi-card text-decoration-none">
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="hrm-kpi-label">Vị trí đang mở</span>
                        <i class="bi bi-briefcase hrm-kpi-icon text-success"></i>
                    </div>
                    <span id="hrm-open-positions" class="hrm-kpi-value" aria-live="polite">Đang tải…</span>
                    <span class="hrm-kpi-link">Tin đang đăng tuyển <i class="bi bi-arrow-right"></i></span>
                </a>
            </div>
            <div class="col-6 col-xl-3">
                <a href="/dashboard/ung-vien" class="hrm-kpi-card text-decoration-none">
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="hrm-kpi-label">Hồ sơ mới trong tuần</span>
                        <i class="bi bi-file-earmark-person hrm-kpi-icon text-primary"></i>
                    </div>
                    <span id="hrm-new-applications" class="hrm-kpi-value" aria-live="polite">Đang tải…</span>
                    <span class="hrm-kpi-link">Từ thứ Hai, giờ Việt Nam <i class="bi bi-arrow-right"></i></span>
                </a>
            </div>
            <div class="col-6 col-xl-3">
                <a href="/dashboard/lich-phong-van" class="hrm-kpi-card text-decoration-none">
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="hrm-kpi-label">Phỏng vấn sắp tới</span>
                        <i class="bi bi-calendar2-event hrm-kpi-icon text-purple"></i>
                    </div>
                    <span id="hrm-upcoming-interviews" class="hrm-kpi-value" aria-live="polite">Đang tải…</span>
                    <span class="hrm-kpi-link">Chưa diễn ra, chưa hủy <i class="bi bi-arrow-right"></i></span>
                </a>
            </div>
            <div class="col-6 col-xl-3">
                <a href="/dashboard/ung-vien" class="hrm-kpi-card text-decoration-none">
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="hrm-kpi-label">Offer chờ phản hồi</span>
                        <i class="bi bi-envelope-paper hrm-kpi-icon text-warning"></i>
                    </div>
                    <span id="hrm-offers-awaiting-response" class="hrm-kpi-value" aria-live="polite">Đang tải…</span>
                    <span class="hrm-kpi-link">Đã gửi cho ứng viên <i class="bi bi-arrow-right"></i></span>
                </a>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-12 col-xl-6">
                <section class="hrm-panel h-100" aria-labelledby="hrm-applications-title">
                    <h3 id="hrm-applications-title" class="h6 fw-bold mb-1">Hồ sơ ứng tuyển theo tuần</h3>
                    <p class="small text-muted mb-2">12 tuần gần nhất, bao gồm tuần hiện tại.</p>
                    <div id="hrm-applications-chart" class="hrm-chart-container" aria-live="polite">
                        <span class="text-muted small">Đang tải biểu đồ…</span>
                    </div>
                </section>
            </div>
            <div class="col-12 col-xl-6">
                <section class="hrm-panel h-100" aria-labelledby="hrm-closed-positions-title">
                    <h3 id="hrm-closed-positions-title" class="h6 fw-bold mb-1">Vị trí đã đóng theo tháng</h3>
                    <p class="small text-muted mb-2">Dựa trên thời điểm đóng tin tuyển dụng.</p>
                    <div id="hrm-closed-positions-chart" class="hrm-chart-container" aria-live="polite">
                        <span class="text-muted small">Đang tải biểu đồ…</span>
                    </div>
                </section>
            </div>
        </div>

        <section class="hrm-panel" aria-labelledby="hrm-overdue-title">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-1 mb-3">
                <div>
                    <h3 id="hrm-overdue-title" class="h6 fw-bold mb-1">
                        <i class="bi bi-exclamation-triangle-fill text-danger me-1"></i>Vị trí tuyển dụng trễ hạn
                    </h3>
                    <p class="small text-muted mb-0">Ưu tiên vị trí trễ nhiều ngày nhất; ngày cần người đã qua và yêu cầu chưa hoàn tất.</p>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Vị trí</th>
                            <th scope="col">Phòng ban</th>
                            <th scope="col">Ngày cần người</th>
                            <th scope="col" class="text-end">Số ngày trễ</th>
                            <th scope="col">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody id="hrm-overdue-positions">
                        <tr><td colspan="5" class="text-center text-muted py-4">Đang tải danh sách…</td></tr>
                    </tbody>
                </table>
            </div>
            <p class="small text-muted mt-3 mb-0">
                Lưu ý: hệ thống hiện chưa có trường hoặc trạng thái hết hạn riêng cho offer; chỉ các offer ở trạng thái “Đã gửi ứng viên” được tính là đang chờ phản hồi.
            </p>
        </section>
    </div>
</section>

<style>
    #hrm-recruitment-dashboard .hrm-kpi-card,
    #hrm-recruitment-dashboard .hrm-panel {
        display: block;
        height: 100%;
        padding: 1rem;
        color: #0f172a;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-shadow: 0 1px 3px rgba(15, 23, 42, .05);
    }

    #hrm-recruitment-dashboard .hrm-kpi-card:hover {
        border-color: #a7f3d0;
        box-shadow: 0 8px 20px rgba(15, 23, 42, .08);
    }

    #hrm-recruitment-dashboard .hrm-kpi-label {
        color: #64748b;
        font-size: .75rem;
        font-weight: 700;
        letter-spacing: .035em;
        text-transform: uppercase;
    }

    #hrm-recruitment-dashboard .hrm-kpi-icon {
        font-size: 1.15rem;
    }

    #hrm-recruitment-dashboard .text-purple {
        color: #7c3aed;
    }

    #hrm-recruitment-dashboard .hrm-kpi-value {
        display: block;
        margin: .75rem 0 .5rem;
        font-size: 2rem;
        font-weight: 700;
        line-height: 1.1;
        font-variant-numeric: tabular-nums;
    }

    #hrm-recruitment-dashboard .hrm-kpi-link {
        color: #64748b;
        font-size: .75rem;
    }

    #hrm-recruitment-dashboard .hrm-chart-container {
        min-height: 220px;
        width: 100%;
    }

    #hrm-recruitment-dashboard .hrm-chart-container svg {
        display: block;
        width: 100%;
        height: auto;
    }

    #hrm-recruitment-dashboard .hrm-chart-grid {
        stroke: #e2e8f0;
        stroke-dasharray: 3 4;
    }

    #hrm-recruitment-dashboard .hrm-chart-label {
        fill: #64748b;
        font-size: 11px;
    }

    #hrm-recruitment-dashboard .hrm-overdue-days {
        color: #b91c1c;
        font-weight: 700;
        white-space: nowrap;
    }

    @@media (max-width: 575.98px) {
        #hrm-recruitment-dashboard .hrm-kpi-card,
        #hrm-recruitment-dashboard .hrm-panel {
            padding: .8rem;
        }

        #hrm-recruitment-dashboard .table {
            min-width: 620px;
            font-size: .85rem;
        }
    }
</style>
