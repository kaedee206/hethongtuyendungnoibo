@{
    ViewData["Title"] = "Cổng Tuyển Dụng NoveraTech - Career Portal";
}

<div class="container-fluid px-3 px-md-5 py-4">
    <!-- Hero Header Section -->
    <div class="text-center mx-auto mb-5 pt-3" style="max-width: 900px;">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill bg-primary bg-opacity-10 text-primary border border-primary border-opacity-20 mb-3 small fw-semibold">
            <i class="bi bi-stars text-warning"></i>
            <span>Hệ Thống Tuyển Dụng & Phát Triển Nhân Tài NoveraTech</span>
        </div>
        <h1 class="display-4 fw-bold text-dark mb-3 tracking-tight">
            Kiến Tạo Tương Lai Cùng <span class="text-primary">NoveraTech</span>
        </h1>
        <p class="lead text-muted mx-auto mb-4" style="max-width: 760px;">
            Nền tảng tuyển dụng số hóa toàn diện kết nối nhân tài công nghệ xuất sắc với các dự án đột phá, quy trình minh bạch, bảo mật đa lớp và phản hồi thần tốc.
        </p>
        <div class="d-flex flex-wrap justify-content-center gap-3">
            <a href="#open-jobs" class="btn btn-primary btn-lg px-4 py-2.5 rounded-pill fw-semibold shadow-sm text-white">
                <i class="bi bi-search me-1"></i> Khám phá vị trí đang mở
            </a>
            <a asp-controller="Account" asp-action="CandidateAuth" class="btn btn-outline-success btn-lg px-4 py-2.5 rounded-pill fw-semibold">
                <i class="bi bi-person-plus me-1"></i> Đăng ký Ứng viên
            </a>
            <a asp-controller="Account" asp-action="StaffLogin" class="btn btn-outline-secondary btn-lg px-4 py-2.5 rounded-pill fw-semibold">
                <i class="bi bi-shield-lock me-1"></i> Cổng Nội bộ
            </a>
        </div>
    </div>

    <!-- Dual Portal Gateway Cards -->
    <div class="row g-4 mb-5 justify-content-center">
        <!-- Portal 1: Candidate Careers Portal -->
        <div class="col-12 col-lg-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white position-relative overflow-hidden hover-shadow transition-all border-top border-4 border-success">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div class="bg-success bg-opacity-10 text-success p-3 rounded-4 d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                        <i class="bi bi-person-workspace fs-3"></i>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-1.5 small fw-semibold">
                        <i class="bi bi-briefcase me-1"></i> Dành cho Ứng viên
                    </span>
                </div>

                <h2 class="h3 fw-bold text-dark mb-2">Cổng Ứng Viên & Tuyển Dụng</h2>
                <p class="text-muted mb-4">
                    Tìm kiếm cơ hội nghề nghiệp, nộp CV trực tuyến, theo dõi tiến độ xét duyệt và nhận thư mời phỏng vấn một cách nhanh chóng, minh bạch.
                </p>

                <div class="bg-light rounded-3 p-3 mb-4 border border-light-subtle">
                    <div class="fw-semibold text-dark small mb-2 text-uppercase tracking-wider">Tiện ích ứng viên:</div>
                    <ul class="list-unstyled mb-0 small text-muted d-flex flex-column gap-2">
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill text-success fs-6"></i>
                            <span>Nộp hồ sơ ứng tuyển trực tuyến & cập nhật CV linh hoạt</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill text-success fs-6"></i>
                            <span>Tra cứu trạng thái hồ sơ theo thời gian thực (Sơ loại, Phỏng vấn, Offer)</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill text-success fs-6"></i>
                            <span>Tự do đăng ký với email cá nhân (Gmail, Outlook, Yahoo...)</span>
                        </li>
                    </ul>
                </div>

                <div class="mt-auto d-flex flex-column flex-sm-row gap-3">
                    <a asp-controller="Account" asp-action="CandidateAuth"
                       class="btn btn-success btn-lg px-4 py-2.5 rounded-3 fw-semibold shadow-sm text-white d-inline-flex align-items-center justify-content-center gap-2 flex-grow-1">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Vào Cổng Ứng Viên</span>
                    </a>
                    <a href="/Account/CandidateAuth#signup"
                       class="btn btn-outline-secondary btn-lg px-3 py-2.5 rounded-3 fw-medium d-inline-flex align-items-center justify-content-center gap-1">
                        <span>Tạo tài khoản mới</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Portal 2: Staff & Internal Portal -->
        <div class="col-12 col-lg-6">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white position-relative overflow-hidden hover-shadow transition-all border-top border-4 border-primary">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-4 d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                        <i class="bi bi-shield-lock-fill fs-3"></i>
                    </div>
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-1.5 small fw-semibold">
                        <i class="bi bi-building me-1"></i> Cán bộ Nhân viên
                    </span>
                </div>

                <h2 class="h3 fw-bold text-dark mb-2">Cổng Nhân Sự Nội Bộ</h2>
                <p class="text-muted mb-4">
                    Phân hệ quản trị quy trình tuyển dụng chuẩn mực dành riêng cho nhân sự NoveraTech với tên miền email bắt buộc <code class="text-primary fw-semibold">@@noveratech.digital</code>.
                </p>

                <div class="bg-light rounded-3 p-3 mb-4 border border-light-subtle">
                    <div class="fw-semibold text-dark small mb-2 text-uppercase tracking-wider">Phân quyền nghiệp vụ nội bộ:</div>
                    <ul class="list-unstyled mb-0 small text-muted d-flex flex-column gap-2">
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill text-primary fs-6"></i>
                            <span>Kiểm soát phân quyền 6 vai trò: Admin, HR Manager, Recruiter, Hiring Manager, Interviewer, Approver</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill text-primary fs-6"></i>
                            <span>Tạo và phê duyệt đề xuất tuyển dụng, quản trị chiến dịch tuyển dụng</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill text-primary fs-6"></i>
                            <span>Nhập phiếu phỏng vấn, đánh giá ứng viên, phê duyệt thư mời nhận việc</span>
                        </li>
                    </ul>
                </div>

                <div class="mt-auto d-flex flex-column flex-sm-row gap-3">
                    <a asp-controller="Account" asp-action="StaffLogin"
                       class="btn btn-primary btn-lg px-4 py-2.5 rounded-3 fw-semibold shadow-sm text-white d-inline-flex align-items-center justify-content-center gap-2 flex-grow-1">
                        <i class="bi bi-shield-lock"></i>
                        <span>Đăng Nhập Cổng Nội Bộ</span>
                    </a>
                    <span class="d-flex align-items-center justify-content-center text-muted small text-center px-2">
                        <i class="bi bi-envelope-at me-1"></i> Chỉ dùng email @@noveratech.digital
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Featured Open Positions Section -->
    <div id="open-jobs" class="mb-5 pt-3">
        <div class="text-center mb-4">
            <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1 small fw-semibold text-uppercase">Cơ Hội Nghề Nghiệp</span>
            <h2 class="h3 fw-bold text-dark mt-2 mb-1">Các Vị Trí Tuyển Dụng Đang Mở</h2>
            <p class="text-muted small">Khám phá các vị trí công việc hấp dẫn tại NoveraTech và gia nhập đội ngũ tinh hoa</p>
        </div>

        <div class="row g-4">
            <!-- Job 1 -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-white hover-shadow transition-all d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1 text-xs">Toàn thời gian</span>
                        <span class="text-success fw-bold small">35 - 50 Triệu</span>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">Senior Fullstack .NET / React</h5>
                    <p class="text-muted small mb-3"><i class="bi bi-geo-alt me-1"></i> Hà Nội (Hybrid)</p>
                    <p class="text-muted small flex-grow-1 mb-3">
                        Xây dựng và tối ưu hệ thống microservices .NET 8, kiến trúc Clean Architecture, cơ sở dữ liệu PostgreSQL và giao diện React hiện đại.
                    </p>
                    <div class="d-flex flex-wrap gap-1 mb-4">
                        <span class="badge bg-light text-secondary border">.NET 8</span>
                        <span class="badge bg-light text-secondary border">PostgreSQL</span>
                        <span class="badge bg-light text-secondary border">React</span>
                    </div>
                    <a asp-controller="Account" asp-action="CandidateAuth" class="btn btn-outline-primary rounded-pill w-100 fw-semibold">
                        Ứng tuyển ngay <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>

            <!-- Job 2 -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-white hover-shadow transition-all d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-3 py-1 text-xs">Hot Position</span>
                        <span class="text-success fw-bold small">40 - 65 Triệu</span>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">AI / LLM Application Engineer</h5>
                    <p class="text-muted small mb-3"><i class="bi bi-geo-alt me-1"></i> Hà Nội / TP.HCM</p>
                    <p class="text-muted small flex-grow-1 mb-3">
                        Phát triển các giải pháp RAG, Vector Search, và Agentic Workflow tự động hóa quy trình tuyển dụng và đánh giá nhân sự.
                    </p>
                    <div class="d-flex flex-wrap gap-1 mb-4">
                        <span class="badge bg-light text-secondary border">Python</span>
                        <span class="badge bg-light text-secondary border">LangChain</span>
                        <span class="badge bg-light text-secondary border">Vector DB</span>
                    </div>
                    <a asp-controller="Account" asp-action="CandidateAuth" class="btn btn-outline-primary rounded-pill w-100 fw-semibold">
                        Ứng tuyển ngay <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>

            <!-- Job 3 -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-white hover-shadow transition-all d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="badge bg-info-subtle text-info-emphasis rounded-pill px-3 py-1 text-xs">Tuyển gấp</span>
                        <span class="text-success fw-bold small">18 - 28 Triệu</span>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">Talent Acquisition Specialist</h5>
                    <p class="text-muted small mb-3"><i class="bi bi-geo-alt me-1"></i> Hà Nội (Văn phòng)</p>
                    <p class="text-muted small flex-grow-1 mb-3">
                        Tìm kiếm và kết nối nguồn nhân lực công nghệ cao (Tech Sourcing), điều phối lịch phỏng vấn và chăm sóc trải nghiệm ứng viên.
                    </p>
                    <div class="d-flex flex-wrap gap-1 mb-4">
                        <span class="badge bg-light text-secondary border">Tech Recruiter</span>
                        <span class="badge bg-light text-secondary border">Sourcing</span>
                    </div>
                    <a asp-controller="Account" asp-action="CandidateAuth" class="btn btn-outline-primary rounded-pill w-100 fw-semibold">
                        Ứng tuyển ngay <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>

            <!-- Job 4 -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-white hover-shadow transition-all d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1 text-xs">Toàn thời gian</span>
                        <span class="text-success fw-bold small">40 - 55 Triệu</span>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">Product Owner (Fintech / ATS)</h5>
                    <p class="text-muted small mb-3"><i class="bi bi-geo-alt me-1"></i> Hà Nội</p>
                    <p class="text-muted small flex-grow-1 mb-3">
                        Định hướng roadmap tính năng, quản trị Product Backlog, làm việc trực tiếp cùng Stakeholders và Tech Team theo quy trình Agile/Scrum.
                    </p>
                    <div class="d-flex flex-wrap gap-1 mb-4">
                        <span class="badge bg-light text-secondary border">Scrum</span>
                        <span class="badge bg-light text-secondary border">PRD</span>
                        <span class="badge bg-light text-secondary border">Roadmap</span>
                    </div>
                    <a asp-controller="Account" asp-action="CandidateAuth" class="btn btn-outline-primary rounded-pill w-100 fw-semibold">
                        Ứng tuyển ngay <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Recruitment Workflow Section -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white mb-5">
        <div class="text-center mb-4">
            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1 small fw-semibold text-uppercase">Quy trình tuyển chọn</span>
            <h3 class="h4 fw-bold text-dark mt-2 mb-1">4 Bước Gia Nhập NoveraTech</h3>
            <p class="text-muted small">Quy trình tuyển chọn minh bạch, chuyên nghiệp và bảo mật thông tin tối đa</p>
        </div>

        <div class="row g-4 text-center">
            <div class="col-6 col-md-3">
                <div class="p-3">
                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3 fs-5 fw-bold shadow-sm" style="width: 48px; height: 48px;">
                        1
                    </div>
                    <h5 class="fw-bold text-dark fs-6 mb-1">Nộp Hồ Sơ</h5>
                    <p class="text-muted small mb-0">Ứng viên đăng ký tài khoản & nộp CV trực tuyến qua Cổng Ứng Viên.</p>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="p-3">
                    <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3 fs-5 fw-bold shadow-sm" style="width: 48px; height: 48px;">
                        2
                    </div>
                    <h5 class="fw-bold text-dark fs-6 mb-1">Sơ Loại CV</h5>
                    <p class="text-muted small mb-0">Recruiter sàng lọc hồ sơ và gửi thông báo kết quả trong vòng 48h làm việc.</p>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="p-3">
                    <div class="bg-warning text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3 fs-5 fw-bold shadow-sm" style="width: 48px; height: 48px;">
                        3
                    </div>
                    <h5 class="fw-bold text-dark fs-6 mb-1">Phỏng Vấn</h5>
                    <p class="text-muted small mb-0">Interviewer phỏng vấn chuyên môn và đánh giá độ phù hợp văn hóa qua Google Meet.</p>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="p-3">
                    <div class="bg-info text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3 fs-5 fw-bold shadow-sm" style="width: 48px; height: 48px;">
                        4
                    </div>
                    <h5 class="fw-bold text-dark fs-6 mb-1">Offer & Onboard</h5>
                    <p class="text-muted small mb-0">Approver duyệt thư mời nhận việc và ban lãnh đạo chào đón thành viên mới.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Value Highlights & Trust Metrics -->
    <div class="row g-4 text-center mb-4">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <i class="bi bi-shield-check text-primary fs-1 mb-2"></i>
                <h5 class="fw-bold text-dark mb-1">Bảo Mật Chuẩn Doanh Nghiệp</h5>
                <p class="text-muted small mb-0">Mã hóa mật khẩu BCrypt, xác thực đa phiên, Rate Limit chống brute-force và audit log toàn diện.</p>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <i class="bi bi-lightning-charge text-warning fs-1 mb-2"></i>
                <h5 class="fw-bold text-dark mb-1">Tốc Độ & Minh Bạch</h5>
                <p class="text-muted small mb-0">Cập nhật trạng thái tự động theo thời gian thực giúp ứng viên luôn nắm rõ lộ trình xét duyệt.</p>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <i class="bi bi-people text-success fs-1 mb-2"></i>
                <h5 class="fw-bold text-dark mb-1">Quy Trình 6 Vai Trò Chuẩn Mực</h5>
                <p class="text-muted small mb-0">Phân định rõ ràng trách nhiệm giữa Admin, HR, Recruiter, Hiring Manager, Interviewer và Approver.</p>
            </div>
        </div>
    </div>
</div>
