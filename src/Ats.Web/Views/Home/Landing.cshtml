</section>

@* ══════════════════════════════════════════════════════════
   3. SECTION: PHÚC LỢI & ĐÃI NGỘ (BENEFITS & CULTURE)
   ══════════════════════════════════════════════════════════ *@
<section id="benefits" class="career-section">
    <div class="container-fluid px-4 px-md-5">
        <div class="text-center mb-5">
            <span class="career-section-label">ĐÃI NGỘ XỨNG TẦM · ĐỒNG HÀNH BỀN VỮNG</span>
            <h2 class="career-h2">Tại sao bạn sẽ yêu thích làm việc tại NoveraTech?</h2>
            <p class="text-muted mt-2" style="max-width: 600px; margin: 0.5rem auto 0; font-size: 0.95rem;">
                Chúng tôi hiểu rằng những kỹ sư giỏi nhất xứng đáng nhận được môi trường làm việc tốt nhất cùng chế độ đãi ngộ vượt trội.
            </p>
        </div>

        <div class="row g-4">
            @* Perk 1 *@
            <div class="col-12 col-md-6 col-lg-4">
                <div class="career-card">
                    <div class="d-flex align-items-center justify-content-center mb-3" style="width: 44px; height: 44px; background: #ECFDF5; color: #059669; border-radius: 10px;">
                        <i class="bi bi-cash-stack fs-5"></i>
                    </div>
