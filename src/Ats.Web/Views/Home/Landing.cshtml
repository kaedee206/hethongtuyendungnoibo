@{
    ViewData["Title"] = "NoveraTech Careers — Cơ Hội Nghề Nghiệp & Gia Nhập Đội Ngũ Công Nghệ";
    ViewData["BodyClass"] = "landing-page";
}

@* ══════════════════════════════════════════════════════════
   NOVERATECH CAREERS — LANDING PAGE
   Định vị: Website Tuyển Dụng Công Nghệ & Giới Thiệu Công Ty
   Tuân thủ nghiêm ngặt docs/RULE.md:
   - Nền trung tính: #F8FAFC, Card: #FFFFFF, Viền: #E2E8F0, Accent: #059669
   - Bo góc: 8px cho Button/Input, 12px cho Card/Modal, 6px cho Badge
   - Font: Inter (UI) & JetBrains Mono (Mức lương, số liệu thống kê)
   - Triệt tiêu hoàn toàn AI slop, đồ họa neon 3D, từ ngữ khoe tính năng ATS
   ══════════════════════════════════════════════════════════ *@

<style>
    /* ── Typography & Global Reset ─────────────────────── */
    body {
        background: #F8FAFC;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        color: #0F172A;
    }

    /* Dot-grid hero background */
    .career-hero {
        background-color: #F8FAFC;
        background-image: radial-gradient(circle, #CBD5E1 1px, transparent 1px);
        background-size: 32px 32px;
        min-height: 85vh;
        display: flex;
        align-items: center;
        border-bottom: 1px solid #E2E8F0;
        padding-top: 3.5rem;
        padding-bottom: 4rem;
    }

    /* Headings */
    .career-h1 {
        font-size: clamp(2.2rem, 4.5vw, 3.4rem);
        font-weight: 800;
        color: #0F172A;
        letter-spacing: -0.035em;
        line-height: 1.15;
    }

    .career-h2 {
        font-size: clamp(1.6rem, 3vw, 2.2rem);
        font-weight: 700;
        color: #0F172A;
        letter-spacing: -0.025em;
    }

    .career-lead {
        font-size: 1.05rem;
        color: #475569;
        line-height: 1.75;
    }

    .career-section-label {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #059669;
        display: inline-block;
        margin-bottom: 0.5rem;
    }

    /* Standard Buttons — 8px radius per RULE.MD */
    .btn-career-primary {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: #059669;
        color: #FFFFFF;
        border: none;
        border-radius: 8px;
        padding: 0.65rem 1.35rem;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        transition: all .2s ease;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }
    .btn-career-primary:hover {
        background: #047857;
        color: #FFFFFF;
        box-shadow: 0 4px 12px rgba(5, 150, 105, 0.25);
    }

    .btn-career-outline {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: #FFFFFF;
        color: #0F172A;
        border: 1.5px solid #CBD5E1;
        border-radius: 8px;
        padding: 0.65rem 1.35rem;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        transition: all .2s ease;
    }
    .btn-career-outline:hover {
        border-color: #059669;
        color: #059669;
        background: #ECFDF5;
    }

    /* Cards — 12px radius per RULE.MD */
    .career-card {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        padding: 1.75rem;
        transition: all .2s ease;
        height: 100%;
    }
    .career-card:hover {
        border-color: rgba(5, 150, 105, 0.4);
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
        transform: translateY(-2px);
    }

    /* Job Card Apply Button — 8px radius */
    .btn-job-apply {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        background: #F8FAFC;
        color: #059669;
        border: 1.5px solid #D1FAE5;
        border-radius: 8px;
        padding: 0.55rem 1rem;
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        transition: all .2s ease;
    }
    .btn-job-apply:hover {
        background: #059669;
        border-color: #059669;
        color: #FFFFFF;
    }

    /* Number metrics — JetBrains Mono per RULE.MD */
    .career-metric-val {
        font-size: 2rem;
        font-weight: 800;
        color: #0F172A;
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        line-height: 1;
    }
    .career-metric-label {
        font-size: 0.8rem;
        color: #64748B;
        margin-top: 0.35rem;
        font-weight: 500;
    }

    /* Stepper — 4 bước tuyển dụng */
    .career-stepper {
        display: flex;
        align-items: stretch;
        gap: 1.25rem;
    }
    .career-step-card {
        flex: 1;
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        padding: 1.5rem;
        position: relative;
    }
    .career-step-badge {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        background: #ECFDF5;
        color: #059669;
        border: 1.5px solid #D1FAE5;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: 'JetBrains Mono', monospace;
        font-weight: 700;
        font-size: 0.85rem;
        margin-bottom: 1rem;
    }

    /* Section padding */
    .career-section {
        padding: 5rem 0;
    }
    .career-section-alt {
        background: #F1F5F9;
        border-top: 1px solid #E2E8F0;
        border-bottom: 1px solid #E2E8F0;
    }

    /* Filter pills for job list */
    .job-filter-btn {
        background: #FFFFFF;
        color: #64748B;
        border: 1px solid #E2E8F0;
        border-radius: 8px;
        padding: 0.45rem 1rem;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        transition: all .2s ease;
    }
    .job-filter-btn:hover, .job-filter-btn.active {
        background: #0F172A;
        color: #FFFFFF;
        border-color: #0F172A;
    }

    @@media (max-width: 991px) {
        .career-stepper {
            flex-direction: column;
        }
    }
</style>

@* ══════════════════════════════════════════════════════════
   1. HERO SECTION: Giới thiệu NoveraTech & Lời mời ứng tuyển
   ══════════════════════════════════════════════════════════ *@
<section class="career-hero">
    <div class="container-fluid px-4 px-md-5">
        <div class="row align-items-center gy-5">
            @* Left Column: Copy & Search Bar *@
            <div class="col-12 col-lg-7">
                <span class="career-section-label">
                    <i class="bi bi-stars me-1"></i> NoveraTech Careers · Gia nhập đội ngũ công nghệ
                </span>
                <h1 class="career-h1 mb-4">
                    Cùng NoveraTech kiến tạo<br />
                    <span style="color: #059669;">tương lai công nghệ số</span>
                </h1>
                <p class="career-lead mb-4" style="max-width: 600px;">
                    NoveraTech là công ty công nghệ tiên phong phát triển các nền tảng số hóa, FinTech và hệ thống Enterprise AI thế hệ mới. Chúng tôi tìm kiếm những kỹ sư đam mê kiến trúc chuẩn mực, giải quyết bài toán triệu người dùng và cùng vươn tầm công nghệ Việt.
                </p>

                @* Job Quick Search Bar *@
                <div class="bg-white p-2 p-md-3 border rounded-3 shadow-xs mb-4" style="border-color: #E2E8F0 !important; border-radius: 12px; max-width: 640px;">
                    <form method="get" asp-controller="Jobs" asp-action="Index">
                        <div class="row g-2 align-items-center">
                            <div class="col-12 col-md-5">
                                <div class="position-relative">
                                    <i class="bi bi-search position-absolute" style="left: 12px; top: 50%; transform: translateY(-50%); color: #94A3B8;"></i>
                                    <input type="text" name="search" id="heroJobSearchInput"
                                           class="form-control"
                                           placeholder="Tìm vị trí: .NET, React, AI..."
                                           style="padding-left: 36px; height: 42px; border-radius: 8px; border: 1px solid #E2E8F0; font-size: 0.9rem;" />
                                </div>
                            </div>
                            <div class="col-6 col-md-4">
                                <select name="department" id="heroDeptSelect" class="form-select" style="height: 42px; border-radius: 8px; border: 1px solid #E2E8F0; font-size: 0.88rem; color: #475569;">
                                    <option value="all">Tất cả phòng ban</option>
                                    <option value="it">Công nghệ Thông tin</option>
                                    <option value="ai">AI / Data Lab</option>
                                    <option value="product">Khối Sản phẩm</option>
                                    <option value="hr">Nhân sự & Vận hành</option>
                                </select>
                            </div>
                            <div class="col-6 col-md-3">
                                <button type="submit" class="btn-career-primary w-100 justify-content-center" style="height: 42px; white-space: nowrap;">
                                    <i class="bi bi-search"></i> Tìm việc
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                @* Key Proof Numbers (RULE.MD: JetBrains Mono for metrics) *@
                <div class="d-flex align-items-center gap-3 gap-md-5 flex-wrap pt-2">
                    <div>
                        <div class="career-metric-val">500+</div>
                        <div class="career-metric-label">Kỹ sư & Chuyên gia</div>
                    </div>
                    <div style="width: 1px; height: 40px; background: #E2E8F0;"></div>
                    <div>
                        <div class="career-metric-val">14–16</div>
                        <div class="career-metric-label">Tháng lương/năm + ESOP</div>
                    </div>
                    <div style="width: 1px; height: 40px; background: #E2E8F0;"></div>
                    <div>
                        <div class="career-metric-val">Top 10</div>
                        <div class="career-metric-label">Môi trường IT lý tưởng</div>
                    </div>
                    <div style="width: 1px; height: 40px; background: #E2E8F0;"></div>
                    <div>
                        <div class="career-metric-val">48h</div>
                        <div class="career-metric-label">Phản hồi hồ sơ nhanh</div>
                    </div>
                </div>
            </div>

            @* Right Column: Tech & Culture Card Mockup *@
            <div class="col-12 col-lg-5">
                <div class="card bg-white p-4 shadow-sm" style="border: 1px solid #E2E8F0; border-radius: 12px;">
                    <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom">
                        <div class="d-flex align-items-center gap-2.5">
                            <img src="~/img/logo/logo-icon-dark-transparent.png" alt="NoveraTech" style="width: 32px; height: 32px; object-fit: contain;" asp-append-version="true" />
                            <div>
                                <div class="fw-bold text-dark" style="font-size: 0.95rem;">Môi trường Kỹ thuật NoveraTech</div>
                                <div class="text-muted" style="font-size: 0.75rem;">Engineering-First Culture</div>
                            </div>
                        </div>
                        <span class="badge bg-success-subtle text-success px-2 py-1" style="border-radius: 6px; font-size: 0.72rem; font-weight: 600;">
                            Tuyển dụng 2026
                        </span>
                    </div>

                    <div class="mb-3">
                        <div class="text-muted small fw-semibold text-uppercase mb-2" style="font-size: 0.72rem; letter-spacing: 0.05em;">Công nghệ chúng tôi sử dụng hàng ngày:</div>
                        <div class="d-flex flex-wrap gap-1.5">
                            <span class="badge bg-light text-dark border px-2.5 py-1.5" style="border-radius: 6px; font-weight: 500;">.NET 9 / C#</span>
                            <span class="badge bg-light text-dark border px-2.5 py-1.5" style="border-radius: 6px; font-weight: 500;">React 19 & TypeScript</span>
                            <span class="badge bg-light text-dark border px-2.5 py-1.5" style="border-radius: 6px; font-weight: 500;">Clean Architecture</span>
                            <span class="badge bg-light text-dark border px-2.5 py-1.5" style="border-radius: 6px; font-weight: 500;">PostgreSQL & Redis</span>
                            <span class="badge bg-light text-dark border px-2.5 py-1.5" style="border-radius: 6px; font-weight: 500;">LangChain & GenAI</span>
                            <span class="badge bg-light text-dark border px-2.5 py-1.5" style="border-radius: 6px; font-weight: 500;">Docker & K8s</span>
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-3 mb-3 border border-light-subtle" style="border-radius: 8px;">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="bi bi-laptop text-primary"></i>
                            <span class="fw-semibold text-dark" style="font-size: 0.85rem;">Trang bị 100% MacBook Pro M3/M4</span>
                        </div>
                        <div class="text-muted" style="font-size: 0.8rem; line-height: 1.5;">
                            Cấp máy xịn cấu hình tối đa + 2 màn hình 4K công thái học ngay ngày đầu nhận việc.
                        </div>
                    </div>

                    <div class="p-3 bg-success-subtle border border-success border-opacity-25 rounded-3 mb-4" style="border-radius: 8px;">
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="fw-semibold text-success-emphasis" style="font-size: 0.85rem;">
                                <i class="bi bi-clock-history me-1"></i> Cam kết phản hồi ứng viên:
                            </span>
                            <span class="fw-bold font-monospace text-success" style="font-size: 0.9rem;">Trong 48 giờ</span>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-controller="Jobs" asp-action="Index" class="btn-career-primary flex-grow-1 justify-content-center">
                            <i class="bi bi-briefcase"></i> Khám phá 12+ vị trí tuyển dụng
                        </a>
                        <a asp-controller="Account" asp-action="CandidateAuth" class="btn-career-outline">
                            Nộp CV ngay
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* ══════════════════════════════════════════════════════════
   2. SECTION: VỀ NOVERATECH (WHO WE ARE & TECH VISION)
   ══════════════════════════════════════════════════════════ *@
<section id="about" class="career-section career-section-alt">
    <div class="container-fluid px-4 px-md-5">
        <div class="row align-items-center gy-5">
            <div class="col-12 col-lg-5">
                <span class="career-section-label">Về NoveraTech · Chúng tôi là ai?</span>
                <h2 class="career-h2 mb-4">Nơi những ý tưởng công nghệ lớn thành hiện thực</h2>
                <p class="career-lead mb-4">
                    Thành lập với sứ mệnh định hình lại năng lực công nghệ doanh nghiệp, NoveraTech quy tụ các kỹ sư hàng đầu để giải quyết những bài toán kỹ thuật phức tạp nhất tại thị trường Việt Nam và khu vực.
                </p>
                <div class="d-flex flex-column gap-3 mb-4">
                    <div class="d-flex align-items-start gap-3">
                        <div class="d-flex align-items-center justify-content-center flex-shrink-0" style="width: 32px; height: 32px; background: #ECFDF5; color: #059669; border-radius: 8px;">
                            <i class="bi bi-check2"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark" style="font-size: 0.95rem;">Engineering-First, Zero Politics</div>
                            <div class="text-muted small">Tôn trọng tiếng nói kỹ thuật, đánh giá dựa trên năng lực và giải pháp thực chất.</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-3">
                        <div class="d-flex align-items-center justify-content-center flex-shrink-0" style="width: 32px; height: 32px; background: #ECFDF5; color: #059669; border-radius: 8px;">
                            <i class="bi bi-check2"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark" style="font-size: 0.95rem;">Làm chủ kiến trúc hiện đại</div>
                            <div class="text-muted small">Không bảo thủ với công nghệ cũ. Chúng tôi tiên phong ứng dụng .NET 9, Cloud-Native và GenAI.</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-3">
                        <div class="d-flex align-items-center justify-content-center flex-shrink-0" style="width: 32px; height: 32px; background: #ECFDF5; color: #059669; border-radius: 8px;">
                            <i class="bi bi-check2"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark" style="font-size: 0.95rem;">Cân bằng cuộc sống & Không OT</div>
                            <div class="text-muted small">Khuyến khích hiệu suất thông minh trong giờ làm việc, tôn trọng thời gian cá nhân và gia đình.</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-7">
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <div class="career-card">
                            <div class="d-flex align-items-center justify-content-center mb-3" style="width: 44px; height: 44px; background: #EFF6FF; color: #2563EB; border-radius: 10px;">
                                <i class="bi bi-layers-fill fs-5"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-2" style="font-size: 1.05rem;">Hệ thống chịu tải cao</h5>
