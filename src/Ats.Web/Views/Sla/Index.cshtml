@model List<Ats.Web.Models.DTOs.Sla.PipelineStageSlaDto>
@{
    ViewData["Title"] = "Cấu hình Ngưỡng SLA Tuyển dụng";
    Layout = "_Layout";
}

@Html.AntiForgeryToken()

<div class="container-fluid px-3 px-md-4 py-4" style="max-width: 1200px;">
    <!-- Breadcrumb -->
    <div class="mb-3">
        <a href="/dashboard/ung-vien" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 hover-text-primary">
            <i class="bi bi-arrow-left"></i> Quay lại Kanban Pipeline
        </a>
    </div>

    <!-- Header Banner -->
    <div class="card border-0 shadow-sm mb-4 overflow-hidden" style="border-radius: 14px; background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%); color: #F8FAFC;">
        <div class="card-body p-4 p-md-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge" style="background: rgba(16, 185, 129, 0.2); color: #6EE7B7; border: 1px solid rgba(16, 185, 129, 0.3); font-size: 0.72rem; letter-spacing: 0.05em; text-transform: uppercase;">
                            <i class="bi bi-stopwatch me-1"></i> SCRUM-327
                        </span>
                        <span class="text-white-50 small">·</span>
                        <span class="text-white-50 small">Cam kết chất lượng vận hành tuyển dụng (Service Level Agreement)</span>
                    </div>
                    <h2 class="fw-bold text-white mb-1" style="font-size: 1.45rem;">
                        Cấu hình Ngưỡng SLA cho Giai đoạn Tuyển dụng
                    </h2>
                    <p class="text-white-50 mb-0 small" style="max-width: 680px; line-height: 1.5;">
                        Thiết lập thời gian xử lý tối đa cho từng vòng ứng tuyển. Khi hồ sơ nằm im quá thời hạn cam kết, hệ thống sẽ tự động gắn cờ cảnh báo trên Kanban và gửi nhắc việc cho chuyên viên tuyển dụng mỗi ngày một lần.
                    </p>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <button type="button" class="btn btn-outline-danger d-inline-flex align-items-center gap-1.5 shadow-sm" id="btnScanNow" onclick="triggerScanSlaNow()" style="border-radius: 8px; font-size: 0.85rem;">
                        <i class="bi bi-lightning-charge-fill"></i> Quét quá hạn SLA ngay
                    </button>
                    <button type="button" class="btn btn-success d-inline-flex align-items-center gap-1.5 shadow-sm" id="btnSaveAll" onclick="saveAllSlaConfigs()" style="background: #059669; border-color: #059669; border-radius: 8px; font-size: 0.85rem;">
                        <i class="bi bi-check2-circle"></i> Lưu cấu hình
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Alert Note Box -->
    <div class="alert alert-info border-0 shadow-sm d-flex align-items-start gap-3 p-3.5 mb-4" style="background: #F0FDF4; border: 1px solid #BBF7D0 !important; border-radius: 12px;">
        <i class="bi bi-info-circle-fill text-success fs-5 flex-shrink-0 mt-0.5"></i>
        <div class="small text-dark" style="line-height: 1.6;">
            <strong>Quy tắc cảnh báo SLA tự động:</strong>
            <ul class="mb-0 ps-3 mt-1 text-muted">
                <li>Ví dụ: Hồ sơ mới ở giai đoạn <strong>Sàng lọc CV</strong> có ngưỡng <strong>3 ngày</strong>. Nếu sau 3 ngày kể từ khi ứng tuyển mà chưa chuyển vòng, hồ sơ sẽ được gắn cờ đỏ <code>Quá hạn SLA</code>.</li>
                <li><strong>Cơ chế chống làm phiền:</strong> Tác vụ nền quét định kỳ mỗi ngày 1 lần. Hồ sơ quá hạn chỉ gửi 1 thông báo và 1 email cho Recruiter phụ trách trong cùng ngày.</li>
                <li>Các giai đoạn kết thúc quy trình như <em>Tuyển dụng thành công</em> hoặc <em>Từ chối</em> được mặc định tắt SLA.</li>
            </ul>
        </div>
    </div>

    <!-- Main Configuration Card -->
    <div class="card border-0 shadow-sm bg-white overflow-hidden mb-4" style="border: 1px solid #E2E8F0 !important; border-radius: 14px;">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark" style="font-size: 1rem;">
                <i class="bi bi-sliders me-1.5 text-primary"></i> Danh sách Giai đoạn &amp; Ngưỡng xử lý
            </h5>
            <span class="badge bg-light text-muted border font-mono small">
                @Model.Count giai đoạn
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="slaTable">
                    <thead style="background: #F8FAFC; border-bottom: 1px solid #E2E8F0; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; color: #64748B;">
                        <tr>
                            <th class="ps-4 py-3" style="width: 80px;">Thứ tự</th>
                            <th class="py-3" style="min-width: 220px;">Tên giai đoạn</th>
                            <th class="py-3 text-center" style="width: 160px;">Theo dõi SLA</th>
                            <th class="py-3" style="min-width: 220px;">Ngưỡng cam kết (SLA)</th>
                            <th class="py-3 text-center" style="width: 140px;">Hồ sơ hiện tại</th>
                            <th class="pe-4 py-3 text-center" style="width: 150px;">Đang trễ hạn</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var stage in Model)
                        {
                            var isTerminal = stage.StageOrder == 6 || stage.StageOrder == 7;
                            <tr data-stage-id="@stage.Id" class="sla-row @(isTerminal ? "table-light text-muted" : "")">
                                <td class="ps-4 fw-bold font-mono text-secondary">
                                    #@stage.StageOrder
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="d-inline-block rounded-circle" style="width: 12px; height: 12px; background: @(stage.ColorCode ?? "#059669");"></span>
                                        <span class="fw-bold text-dark" style="font-size: 0.92rem;">@stage.Name</span>
                                        @if (stage.StageOrder == 1)
                                        {
                                            <span class="badge" style="background:#EFF6FF; color:#1D4ED8; font-size: 0.68rem; border: 1px solid #BFDBFE;">Tiếp nhận</span>
                                        }
                                        else if (isTerminal)
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary" style="font-size: 0.68rem;">Đóng luồng</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="form-check form-switch d-inline-block mb-0">
                                        <input class="form-check-input sla-toggle" type="checkbox" id="toggle-@stage.Id"
                                               @(stage.IsSlaEnabled ? "checked" : "")
                                               @(isTerminal ? "disabled" : "")
                                               onchange="onToggleSlaChange('@stage.Id')">
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2" style="max-width: 180px;">
                                        <input type="number" class="form-control form-control-sm text-center fw-bold font-mono sla-days-input"
                                               id="days-@stage.Id"
                                               value="@stage.SlaDays"
                                               min="1" max="90"
                                               @(stage.IsSlaEnabled ? "" : "disabled")
                                               @(isTerminal ? "disabled" : "")
                                               style="border-radius: 8px; border-color: #CBD5E1; font-size: 0.9rem;">
                                        <span class="text-muted small fw-semibold">ngày</span>
                                    </div>
                                </td>
                                <td class="text-center font-mono">
                                    <span class="badge bg-light text-dark border px-2.5 py-1.5" style="font-size: 0.8rem;">
                                        <i class="bi bi-people me-1 text-muted"></i>@stage.ActiveCandidateCount
                                    </span>
                                </td>
                                <td class="pe-4 text-center">
                                    @if (stage.OverdueCandidateCount > 0)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1.5" style="font-size: 0.8rem; font-weight: 700;">
                                            <i class="bi bi-flag-fill me-1"></i>@stage.OverdueCandidateCount hồ sơ
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size: 0.75rem;">
                                            <i class="bi bi-check-lg me-1"></i>Đúng hạn
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-light py-3 px-4 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <div class="text-muted small">
                <i class="bi bi-clock-history me-1"></i> Tác vụ quét nền chạy định kỳ mỗi 24 giờ. Bạn có thể nhấn <strong>Quét quá hạn SLA ngay</strong> để kiểm tra tức thì.
            </div>
            <div class="d-flex gap-2 w-100 w-sm-auto justify-content-end">
                <button type="button" class="btn btn-success fw-semibold px-4" onclick="saveAllSlaConfigs()" style="background: #059669; border-color: #059669; border-radius: 8px; font-size: 0.85rem;">
                    <i class="bi bi-check2-circle me-1"></i> Lưu cấu hình
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Báo cáo kết quả quét SLA -->
<div class="modal fade" id="scanResultModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 14px; overflow: hidden;">
            <div class="modal-header text-white p-3.5" style="background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-lightning-charge-fill text-warning fs-5"></i>
                    <h5 class="modal-title fw-bold text-white mb-0" style="font-size: 1.05rem;">Kết quả quét SLA Tuyển dụng</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="scanModalBody">
                <!-- Nội dung kết quả render bằng JS -->
            </div>
            <div class="modal-footer bg-light border-top p-3 d-flex justify-content-between">
                <a href="/dashboard/ung-vien" class="btn btn-outline-primary btn-sm fw-semibold" style="border-radius: 8px;">
                    <i class="bi bi-kanban me-1"></i> Mở Kanban Pipeline
                </a>
                <button type="button" class="btn btn-secondary btn-sm px-4" data-bs-dismiss="modal" style="border-radius: 8px;">
                    Đóng
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function onToggleSlaChange(stageId) {
            var toggle = document.getElementById('toggle-' + stageId);
            var daysInput = document.getElementById('days-' + stageId);
            if (toggle && daysInput) {
                daysInput.disabled = !toggle.checked;
                if (toggle.checked && (!daysInput.value || parseInt(daysInput.value) <= 0)) {
                    daysInput.value = 3;
                }
            }
        }

        async function saveAllSlaConfigs() {
            var btn = document.getElementById('btnSaveAll');
            var originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1.5" role="status"></span>Đang lưu...';

            var rows = document.querySelectorAll('.sla-row');
            var configs = [];

            rows.forEach(function (row) {
                var stageId = row.getAttribute('data-stage-id');
                var toggle = document.getElementById('toggle-' + stageId);
                var daysInput = document.getElementById('days-' + stageId);

                if (stageId && toggle && daysInput) {
                    configs.push({
                        id: stageId,
                        slaDays: parseInt(daysInput.value) || 0,
                        isSlaEnabled: toggle.checked
                    });
                }
            });

            try {
                var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                var token = tokenInput ? tokenInput.value : '';

                var response = await fetch('/api/sla/stages', {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(configs)
                });

                var res = await response.json();
                if (res.success) {
                    alert('✅ ' + (res.message || 'Lưu cấu hình SLA thành công!'));
                    window.location.reload();
                } else {
                    alert('❌ Lỗi: ' + (res.message || 'Không thể lưu cấu hình.'));
                }
            } catch (err) {
                alert('❌ Lỗi kết nối máy chủ: ' + err.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        }

        async function triggerScanSlaNow() {
            var btn = document.getElementById('btnScanNow');
            var originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1.5" role="status"></span>Đang quét SLA...';

            try {
                var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                var token = tokenInput ? tokenInput.value : '';

                var response = await fetch('/api/sla/scan-now', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    }
                });

                var res = await response.json();
                if (res.success && res.data) {
                    var data = res.data;
                    var body = document.getElementById('scanModalBody');

                    var itemsHtml = '';
                    if (data.overdueItems && data.overdueItems.length > 0) {
                        itemsHtml = `
                            <div class="table-responsive mt-3" style="max-height: 280px; overflow-y: auto;">
                                <table class="table table-sm table-bordered align-middle mb-0" style="font-size: 0.82rem;">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Ứng viên</th>
                                            <th>Vị trí</th>
                                            <th>Giai đoạn</th>
                                            <th>Đã ở</th>
                                            <th>Ngưỡng SLA</th>
                                            <th>Nhắc Recruiter</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        ${data.overdueItems.map(item => `
                                            <tr>
                                                <td class="fw-bold">${item.candidateName}<br><span class="text-muted small font-mono">${item.candidateEmail}</span></td>
                                                <td>${item.jobTitle}</td>
                                                <td><span class="badge bg-secondary-subtle text-secondary">${item.stageName}</span></td>
                                                <td class="text-danger fw-bold font-mono">${item.daysInStage} ngày</td>
                                                <td class="font-mono">${item.slaDays} ngày</td>
                                                <td>
                                                    ${item.isAlreadyAlertedToday 
                                                        ? '<span class="badge bg-light text-muted border">Đã nhắc hôm nay</span>' 
                                                        : '<span class="badge bg-success-subtle text-success border border-success-subtle">Đã tạo nhắc việc</span>'}
                                                </td>
                                            </tr>
                                        `).join('')}
                                    </tbody>
                                </table>
                            </div>
                        `;
                    } else {
                        itemsHtml = `
                            <div class="text-center py-4 text-success">
                                <i class="bi bi-shield-check fs-1 d-block mb-2"></i>
                                <div class="fw-bold">Tuyệt vời! Không có hồ sơ nào quá hạn SLA.</div>
                                <div class="text-muted small">Tất cả các hồ sơ đang được xử lý đúng theo tiến độ cam kết.</div>
                            </div>
                        `;
                    }

                    body.innerHTML = `
                        <div class="row g-3 text-center mb-3">
                            <div class="col-4">
                                <div class="p-3 bg-light rounded-3 border">
                                    <div class="text-muted small">Tổng đã quét</div>
                                    <div class="fs-4 fw-bold font-mono text-dark">${data.totalScanned}</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-3 bg-danger-subtle rounded-3 border border-danger-subtle">
                                    <div class="text-danger small fw-semibold">Quá hạn SLA</div>
                                    <div class="fs-4 fw-bold font-mono text-danger">${data.overdueCount}</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-3 bg-success-subtle rounded-3 border border-success-subtle">
                                    <div class="text-success small fw-semibold">Nhắc việc tạo mới</div>
                                    <div class="fs-4 fw-bold font-mono text-success">${data.notificationsCreated}</div>
                                </div>
                            </div>
                        </div>
                        <h6 class="fw-bold text-dark mt-3 mb-1" style="font-size: 0.9rem;">
                            <i class="bi bi-list-check me-1"></i> Danh sách chi tiết hồ sơ quá hạn:
                        </h6>
                        ${itemsHtml}
                    `;

                    var modal = new bootstrap.Modal(document.getElementById('scanResultModal'));
                    modal.show();
                } else {
                    alert('❌ ' + (res.message || 'Lỗi khi quét SLA.'));
                }
            } catch (err) {
                alert('❌ Lỗi kết nối máy chủ: ' + err.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        }
    </script>
}
